procedure TPCLexerTests.DoVocabCase(const ALabel: string; const APaskal: array of TPCTokenRow;
  const ACpp: array of TPCTokenRow; const AShared: array of TPCSharedRow;
  const AExpectedCode: string);
var
  LErrors: TErrors;
  LVocabulary: TPCVocabulary;
  LOk: Boolean;
begin
  LErrors := TErrors.Create();
  LVocabulary := TPCVocabulary.Create();
  try
    LErrors.SetMaxErrors(100);
    LVocabulary.SetErrors(LErrors);
    LOk := LVocabulary.BuildFrom(APaskal, ACpp, AShared);
    // Exactly one diagnostic: each case has one defect, so a second error
    // means one fault was reported twice
    Check((not LOk) and (LErrors.Count() = 1) and DoHasCode(LErrors, AExpectedCode), ALabel);
  finally
    LVocabulary.Free();
    LErrors.Free();
  end;
end;

procedure TPCLexerTests.DoTestVocabulary();
var
  LErrors: TErrors;
  LVocabulary: TPCVocabulary;
  LEntry: TPCVocabEntry;
begin
  LErrors := TErrors.Create();
  LVocabulary := TPCVocabulary.Create();
  try
    LErrors.SetMaxErrors(100);
    LVocabulary.SetErrors(LErrors);
    Check(LVocabulary.Build() and (LErrors.Count() = 0), 'vocab: real tables build clean');
    Check(LVocabulary.FindWord('if', LEntry) and (LEntry.Origin = toShared) and
      (LEntry.Kind = tkKwIf) and (LEntry.Category = tcKeyword) and
      (LEntry.Resolution = srPaskalWins),
      'vocab: if is shared, PaskalCPP kind and category');
    Check(LVocabulary.FindWord('class', LEntry) and (LEntry.Origin = toCpp) and
      (LEntry.Category = tcCppKeyword),
      'vocab: class is C++ only');
    Check(LVocabulary.FindWord('begin', LEntry) and (LEntry.Origin = toPaskal),
      'vocab: begin is PaskalCPP only');
    Check(LVocabulary.FindWord('unit', LEntry) and (LEntry.Kind = tkKwUnit) and
      (LEntry.Origin = toPaskal) and (LEntry.Category = tcKeyword),
      'vocab: unit is a PaskalCPP keyword');
    Check(LVocabulary.FindWord('initialize', LEntry) and (LEntry.Kind = tkKwInitialize) and
      (LEntry.Origin = toPaskal) and (LEntry.Category = tcKeyword),
      'vocab: initialize is a PaskalCPP keyword');
    Check(LVocabulary.FindWord('finalize', LEntry) and (LEntry.Kind = tkKwFinalize) and
      (LEntry.Origin = toPaskal) and (LEntry.Category = tcKeyword),
      'vocab: finalize is a PaskalCPP keyword');
    Check(not LVocabulary.FindWord('End', LEntry), 'vocab: End is a name (exact case)');
    Check(LVocabulary.FindOperator('<=>', LEntry) and (LEntry.Kind = tkLessEqualGreater) and
      (LEntry.Origin = toCpp),
      'vocab: <=> is C++ only');
    Check(not LVocabulary.FindOperator('^=', LEntry), 'vocab: ^= is not a token');
  finally
    LVocabulary.Free();
    LErrors.Free();
  end;

  DoVocabCase('vocab: both tables, not shared -> VC0001',
    TEST_VOC_PASKAL_IF_BEGIN, TEST_VOC_CPP_IF_BEGIN, TEST_VOC_SHARED_BEGIN, PC_ERR_VOC_001);
  DoVocabCase('vocab: stale shared entry -> VC0002',
    TEST_VOC_PASKAL_BEGIN, TEST_VOC_CPP_CLASS, TEST_VOC_SHARED_BEGIN, PC_ERR_VOC_002);
  DoVocabCase('vocab: kind mismatch -> VC0003',
    TEST_VOC_PASKAL_IF, TEST_VOC_CPP_IF_WRONG, TEST_VOC_SHARED_IF, PC_ERR_VOC_003);
  DoVocabCase('vocab: duplicate in a table -> VC0004',
    TEST_VOC_PASKAL_IF_TWICE, TEST_VOC_CPP_IF, TEST_VOC_SHARED_IF, PC_ERR_VOC_004);
end;

procedure TPCLexerTests.DoTestRoundTrip();
var
  LFiles: TArray<string>;
  LFile: string;
  LErrors: TErrors;
  LStream: TPCTokenStream;
  LExpected: string;
begin
  LFiles := TDirectory.GetFiles(DoLexDir(), '*.pcpp');
  Check(Length(LFiles) = 13, 'round trip: 13 fixtures found');
  for LFile in LFiles do
  begin
    LErrors := TErrors.Create();
    LStream := TPCTokenStream.Create();
    try
      LErrors.SetMaxErrors(100);
      DoLex(TPath.GetFileName(LFile), LErrors, LStream);
      LExpected := TEncoding.UTF8.GetString(TFile.ReadAllBytes(LFile));
      Check(LStream.ToSource() = LExpected, 'round trip: ' + TPath.GetFileName(LFile));
    finally
      LStream.Free();
      LErrors.Free();
    end;
  end;
end;

procedure TPCLexerTests.DoTestNumbers();
var
  LErrors: TErrors;
  LStream: TPCTokenStream;
begin
  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    DoLex('lx01_numbers.pcpp', LErrors, LStream);
    Check(LErrors.Count() = 0, 'numbers: no diagnostics');
    Check(DoTextsMatch(LStream,
      ['1.5f', '10ULL', '1''000', '0x1.8p3', '.5', '1.', '1', '..', '5', '10ms',
       '0b101', '0xFFu', '1e-3']),
      'numbers: one token each, 1..5 is three');
    Check((LStream.TokenAt(0).Kind = tkFloatLiteral) and LStream.TokenAt(0).HasValue and
      (Abs(LStream.TokenAt(0).FloatValue - 1.5) < 1e-12) and
      (LStream.TokenAt(0).Suffix = 'f') and (not LStream.TokenAt(0).IsUserDefined),
      'numbers: 1.5f');
    Check((LStream.TokenAt(1).Kind = tkIntLiteral) and (LStream.TokenAt(1).IntValue = 10) and
      (LStream.TokenAt(1).Suffix = 'ULL') and (not LStream.TokenAt(1).IsUserDefined),
      'numbers: 10ULL');
    Check(LStream.TokenAt(2).IntValue = 1000, 'numbers: 1''000 = 1000');
    Check((LStream.TokenAt(3).Kind = tkFloatLiteral) and (LStream.TokenAt(3).LiteralBase = lbHex) and
      LStream.TokenAt(3).HasValue and (LStream.TokenAt(3).FloatValue = 12.0),
      'numbers: hex float 0x1.8p3 = 12');
    Check(Abs(LStream.TokenAt(4).FloatValue - 0.5) < 1e-12, 'numbers: .5');
    Check((LStream.TokenAt(5).Kind = tkFloatLiteral) and
      (Abs(LStream.TokenAt(5).FloatValue - 1.0) < 1e-12),
      'numbers: 1.');
    Check(LStream.TokenAt(7).Kind = tkDotDot, 'numbers: .. range');
    Check((LStream.TokenAt(9).Kind = tkIntLiteral) and LStream.TokenAt(9).IsUserDefined and
      (LStream.TokenAt(9).Suffix = 'ms') and (not LStream.TokenAt(9).HasValue),
      'numbers: 10ms opaque UDL');
    Check((LStream.TokenAt(10).LiteralBase = lbBinary) and (LStream.TokenAt(10).IntValue = 5),
      'numbers: 0b101 = 5');
    Check((LStream.TokenAt(11).IntValue = 255) and (LStream.TokenAt(11).Suffix = 'u'),
      'numbers: 0xFFu = 255');
    Check(Abs(LStream.TokenAt(12).FloatValue - 0.001) < 1e-12, 'numbers: 1e-3');
  finally
    LStream.Free();
    LErrors.Free();
  end;
end;

