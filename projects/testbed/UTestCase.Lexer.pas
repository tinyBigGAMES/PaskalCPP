    Check(LErrors.Count() = 0, 'cppstart: no diagnostics');
    Check((LStream.Count() = 6) and
      (LStream.TokenAt(0).Kind = tkKwCppstart) and
      (LStream.TokenAt(1).Kind = tkIdentifier) and
      (LStream.TokenAt(2).Kind = tkRawBlock) and
      (LStream.TokenAt(3).Kind = tkKwCppend) and
      (LStream.TokenAt(4).Kind = tkSemicolon),
      'cppstart: kinds');
    LRaw := LStream.TokenAt(2);
    Check(LRaw.Text.Replace(#13, '') = #10'x = "cppend"; // cppend'#10,
      'cppstart: block untrimmed, string/comment cppend ignored');
    Check((LRaw.Range.StartByteOffset = LStream.TokenAt(1).Range.EndByteOffset) and
      (LStream.TokenAt(3).Range.StartByteOffset = LRaw.Range.EndByteOffset),
      'cppstart: block starts right after source, cppend right after it');
  finally
    LStream.Free();
    LErrors.Free();
  end;

  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    DoLex('lx10_cppmacro.pcpp', LErrors, LStream);
    Check((LErrors.Count() = 0) and (LStream.TokenAt(2).Kind = tkRawBlock) and
      (LStream.TokenAt(2).Text = ' $MACRO(@x) '),
      'cppstart: $ and @ accepted inside the block');
  finally
    LStream.Free();
    LErrors.Free();
  end;

  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    DoLex('lx11_cppeof.pcpp', LErrors, LStream);
    Check(DoHasCode(LErrors, PC_ERR_LEX_013) and
      (LErrors.GetItems()[0].Range.StartLine = 1) and
      (LErrors.GetItems()[0].Range.StartColumn = 1),
      'cppstart: EOF is LX0013 at the cppstart');
  finally
    LStream.Free();
    LErrors.Free();
  end;
end;

