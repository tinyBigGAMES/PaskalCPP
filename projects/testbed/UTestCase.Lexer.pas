procedure TPCLexerTests.DoTestTemplateSplit();
var
  LErrors: TErrors;
  LStream: TPCTokenStream;
  LBefore: TPCToken;
  LToken: TPCToken;
  LSaved: TPCStreamPosition;
begin
  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    DoLex('lx08_template.pcpp', LErrors, LStream);
    Check(DoTextsMatch(LStream,
      ['std', '::', 'vector', '<', 'std', '::', 'vector', '<', 'int32', '>>']),
      'template: >> is one token');
    Check(LStream.PeekToken(1).Kind = tkColonColon, 'template: peek');
    Check((not LStream.SplitCurrent()) and (LStream.CurrentToken().Text = 'std'),
      'split: an identifier does not split');

    while (not LStream.IsAtEnd()) and (LStream.CurrentToken().Kind <> tkGreaterGreater) do
      LStream.NextToken();
    LBefore := LStream.CurrentToken();
    LSaved := LStream.SavePosition();

    Check(LStream.SplitCurrent(), 'split: >> splits');
    LToken := LStream.CurrentToken();
    Check((LToken.Text = '>') and (LToken.Kind = tkGreater) and
      (LToken.Range.StartColumn = LBefore.Range.StartColumn) and
      (LToken.Range.EndByteOffset = LBefore.Range.StartByteOffset + 1),
      'split: first piece >');
    LStream.NextToken();
    LToken := LStream.CurrentToken();
    Check((LToken.Text = '>') and (LToken.Kind = tkGreater) and
      (LToken.Range.StartColumn = LBefore.Range.StartColumn + 1) and
      (LToken.TriviaStart = LToken.Range.StartByteOffset),
      'split: second piece >');
    LStream.NextToken();
    Check(LStream.IsAtEnd(), 'split: then EOF');

    LStream.RestorePosition(LSaved);
    Check(LStream.CurrentToken().Text = '>>', 'split: restore undoes the split');
  finally
    LStream.Free();
    LErrors.Free();
  end;
end;

procedure TPCLexerTests.DoTestCppstart();
