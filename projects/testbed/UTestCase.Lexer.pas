procedure TPCLexerTests.DoTestDigraphs();
var
  LErrors: TErrors;
  LVocabulary: TPCVocabulary;
  LEntry: TPCVocabEntry;
  LRow: TPCTokenRow;
begin
  // C++ digraphs lex as clang lexes them: every expected sequence below is the
  // bundled clang's own token dump (research\cppmix\digraphs\d1-clang.md; the
  // probe case is named in each label)
  LErrors := TErrors.Create();
  LVocabulary := TPCVocabulary.Create();
  try
    LErrors.SetMaxErrors(100);
    LVocabulary.SetErrors(LErrors);
    Check(LVocabulary.Build() and (LErrors.Count() = 0), 'digraphs: tables build clean');
    Check(LVocabulary.FindOperator('<:', LEntry) and (LEntry.Kind = tkLBracket) and
      (LEntry.Origin = toCpp) and (LEntry.Category = tcDelimiter), 'digraphs: <: is [, C++ only');
    Check(LVocabulary.FindOperator('%>', LEntry) and (LEntry.Kind = tkRBrace), 'digraphs: %> is }');
    Check(not LVocabulary.FindOperator('%:', LEntry), 'digraphs: %: is no operator row');
    Check(TPCVocabulary.FindKindRow(tkLBracket, LRow) and (LRow.Text = '['),
      'digraphs: [ still spells [');
    Check(TPCVocabulary.FindKindRow(tkRBracket, LRow) and (LRow.Text = ']'),
      'digraphs: ] still spells ]');
    Check(TPCVocabulary.FindKindRow(tkLBrace, LRow) and (LRow.Text = '{'),
      'digraphs: { still spells {');
    Check(TPCVocabulary.FindKindRow(tkRBrace, LRow) and (LRow.Text = '}'),
      'digraphs: } still spells }');
  finally
    LVocabulary.Free();
    LErrors.Free();
  end;

  DoCheckLexed('a<:0:>',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['a', '<:', '0', ':>']) and
        (AStream.TokenAt(1).Kind = tkLBracket) and (AStream.TokenAt(3).Kind = tkRBracket) and
        (AStream.TokenAt(1).Origin = toCpp), 'digraphs: <: :> are [ ] (c01)');
    end);
  DoCheckLexed('<%x%>',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['<%', 'x', '%>']) and
        (AStream.TokenAt(0).Kind = tkLBrace) and (AStream.TokenAt(2).Kind = tkRBrace),
        'digraphs: <% %> are { } (c02)');
    end);
  DoCheckLexed('A<::B>',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['A', '<', '::', 'B', '>']) and
        (AStream.TokenAt(1).Kind = tkLess) and (AStream.TokenAt(2).Kind = tkColonColon),
        'digraphs: <:: then B is < :: (c11)');
    end);
  DoCheckLexed('a<:::b:>',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['a', '<:', '::', 'b', ':>']) and
        (AStream.TokenAt(1).Kind = tkLBracket), 'digraphs: <::: is <: :: (c12)');
    end);
  DoCheckLexed('<::>',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['<:', ':>']),
        'digraphs: <::> is <: :> (c13)');
    end);
  DoCheckLexed('A<::'#10'B',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['A', '<', '::', 'B']),
        'digraphs: <:: then a newline is < :: (c13b)');
    end);
  DoCheckLexed('A<::',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['A', '<', '::']),
        'digraphs: <:: at end of file is < ::');
    end);
  DoCheckLexed('x<::\'#10'>y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['x', '<:', ':>', 'y']) and
        (AStream.TokenAt(2).Kind = tkRBracket) and (AStream.TokenAt(2).Text = ':\'#10'>'),
        'digraphs: the <:: test reads through a splice: <: :> (c13c)');
    end);
  DoCheckLexed('x<:\'#10':y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['x', '<', '::', 'y']) and
        (AStream.TokenAt(2).Text = ':\'#10':'),
        'digraphs: <: splice : y is < :: (c13d)');
    end);
  DoCheckLexed('<\'#10':',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.Count() = 2) and
        (AStream.TokenAt(0).Kind = tkLBracket) and (AStream.TokenAt(0).Spelling = '<:'),
        'digraphs: < splice : is one <: (c14)');
    end);
  DoCheckLexed('<:= %>= <<: ::> <%=',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and
        DoSpellingsMatch(AStream, ['<:', '=', '%>', '=', '<<', ':', '::', '>', '<%', '=']) and
        (AStream.TokenAt(0).Kind = tkLBracket) and (AStream.TokenAt(4).Kind = tkLessLess) and
        (AStream.TokenAt(6).Kind = tkColonColon) and (AStream.TokenAt(8).Kind = tkLBrace),
        'digraphs: longest match (c15)');
    end);
  DoCheckLexed('a %> b % c %= d',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['a', '%>', 'b', '%', 'c', '%=', 'd']) and
        (AStream.TokenAt(1).Kind = tkRBrace) and (AStream.TokenAt(3).Kind = tkPercent) and
        (AStream.TokenAt(5).Kind = tkPercentEqual),
        'digraphs: % without a colon stays an operator');
    end);
  DoCheckLexed('%:define X 1'#10'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['%:define X 1', 'x']) and
        (AStream.TokenAt(0).Kind = tkCppPreprocessor), 'digraphs: %: first on a line is a # line (c06)');
    end);
  DoCheckLexed('  /* c */ %:include <a>'#10'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['%:include <a>', 'x']) and
        (AStream.TokenAt(0).Kind = tkCppPreprocessor),
        'digraphs: blanks and a comment before %: keep it a # line (c06)');
    end);
  DoCheckLexed('%\'#10':define W 4'#10'w',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['%:define W 4', 'w']) and
        (AStream.TokenAt(0).Kind = tkCppPreprocessor) and
        (AStream.TokenAt(0).Range.StartLine = 1) and (AStream.TokenAt(0).Range.StartColumn = 1),
        'digraphs: % splice : starts a # line (c14b)');
    end);
  DoCheckLexed('%:%:'#10'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['%:%:', 'x']) and
        (AStream.TokenAt(0).Kind = tkCppPreprocessor), 'digraphs: %:%: first on a line is a # line');
    end);
  DoCheckLexed('x %: y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 1) and (DoCountCode(AErrors, PC_ERR_LEX_008) = 1) and
        DoTextsMatch(AStream, ['x', '%:', 'y']) and (AStream.TokenAt(1).Kind = tkUnknown) and
        AErrors.GetItems()[0].Message.Contains('''%:'''),
        'digraphs: %: mid-line is LX0008 naming %: (c17)');
    end);
  DoCheckLexed('x %:%: y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_ERR_LEX_008) = 2) and DoTextsMatch(AStream, ['x', '%:', '%:', 'y']),
        'digraphs: %:%: mid-line is two LX0008, as ## is');
    end);
  DoCheckLexed('x # y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 1) and (DoCountCode(AErrors, PC_ERR_LEX_008) = 1) and
        AErrors.GetItems()[0].Message.Contains('''#'''),
        'digraphs: # mid-line LX0008 names #');
    end);
end;

procedure TPCLexerTests.DoTestInline();
var
  LErrors: TErrors;
  LStream: TPCTokenStream;
begin
  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    // \ CR LF inside a string is a line splice (C++ phase 2), not its end
    DoLexBytes('"a\'#13#10'b" x', LErrors, LStream);
    Check((LErrors.Count() = 0) and DoTextsMatch(LStream, ['"a\'#10'b"', 'x']) and
      (LStream.TokenAt(0).Kind = tkStringLiteral),
      'inline: \ CRLF splice continues the literal');
    Check(LStream.TokenAt(0).Spelling = '"ab"', 'inline: its spelling has no splice');
  finally
    LStream.Free();
    LErrors.Free();
  end;

  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    // A 3-byte UTF-8 character where an operator could start: exactly one
    // LX0004, and the whole sequence is one unknown token
    DoLexBytes('x '#$20AC' y', LErrors, LStream);
    Check((LErrors.Count() = 1) and DoHasCode(LErrors, PC_ERR_LEX_004) and
      DoTextsMatch(LStream, ['x', #$20AC, 'y']) and
      (LStream.TokenAt(1).Kind = tkUnknown),
      'inline: non-ASCII character is one LX0004 token');
  finally
    LStream.Free();
    LErrors.Free();
  end;
end;

procedure TPCLexerTests.DoTestNewlines();
begin
  // LF, CR LF and a lone CR are newlines (clang); CR CR LF is two
  DoCheckLexed('a'#13'b',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(1).Spelling = 'b') and
        (AStream.TokenAt(1).Range.StartLine = 2) and (AStream.TokenAt(1).Range.StartColumn = 1),
        'newlines: lone CR starts line 2');
    end);
  DoCheckLexed('a'#13#13#10'b',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(AStream.TokenAt(1).Range.StartLine = 3, 'newlines: CR CR LF is two newlines');
    end);
  DoCheckLexed('a'#13#10'b',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(AStream.TokenAt(1).Range.StartLine = 2, 'newlines: CR LF is one newline');
    end);
  DoCheckLexed('// c'#13'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoSpellingsMatch(AStream, ['x']) and (AStream.TokenAt(0).Range.StartLine = 2),
        'newlines: lone CR ends a // comment');
    end);
  DoCheckLexed('x'#13'#define Y 1',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.TokenAt(1).Kind = tkCppPreprocessor) and
        (AStream.TokenAt(1).Text = '#define Y 1') and (AStream.TokenAt(1).Range.StartLine = 2) and
        (DoCountCode(AErrors, PC_ERR_LEX_008) = 0),
        'newlines: # after a lone CR starts a line');
    end);
  DoCheckLexed('#define Z 1'#13'y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.TokenAt(0).Text = '#define Z 1') and (AStream.TokenAt(1).Range.StartLine = 2),
        'newlines: lone CR ends a # line, CR not in it');
    end);
  DoCheckLexed('"ab'#13'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_ERR_LEX_001) = 1) and (AStream.TokenAt(1).Spelling = 'x') and
        (AStream.TokenAt(1).Range.StartLine = 2),
        'newlines: lone CR ends a string unterminated');
    end);
end;

procedure TPCLexerTests.DoTestSplices();
begin
  // A splice is removed everywhere, inside tokens too (clang phase 2); Text
  // and Range stay physical, Spelling is splice-free
  DoCheckLexed('ab\'#10'cd',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.Count() = 2) and
        (AStream.TokenAt(0).Kind = tkIdentifier) and (AStream.TokenAt(0).Text = 'ab\'#10'cd') and
        (AStream.TokenAt(0).Spelling = 'abcd') and (AStream.TokenAt(0).Range.StartLine = 1) and
        (AStream.TokenAt(0).Range.EndLine = 2),
        'splices: identifier joined, Text physical');
    end);
  DoCheckLexed('ab\'#13#10'cd',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(0).Spelling = 'abcd'),
        'splices: CR LF splice');
    end);
  DoCheckLexed('ab\'#13'cd',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(0).Spelling = 'abcd'),
        'splices: lone CR splice');
    end);
  DoCheckLexed('a\'#10'\'#10'b',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoSpellingsMatch(AStream, ['ab']), 'splices: two splices in a row');
    end);
  DoCheckLexed('con\'#10'stexpr',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(AStream.TokenAt(0).Kind = DoKindOf('constexpr'), 'splices: keyword by spelling');
    end);
  DoCheckLexed('1\'#10'2',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.TokenAt(0).Kind = tkIntLiteral) and AStream.TokenAt(0).HasValue and
        (AStream.TokenAt(0).IntValue = 12),
        'splices: number 1 splice 2 is 12');
    end);
  DoCheckLexed('<\'#10'<',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.Count() = 2) and (AStream.TokenAt(0).Kind = DoKindOf('<<')),
        'splices: operator joined');
    end);
  DoCheckLexed('/\'#10'/ c'#10'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoSpellingsMatch(AStream, ['x']), 'splices: // opener joined');
    end);
  DoCheckLexed('/\'#10'* c */ x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoSpellingsMatch(AStream, ['x']), 'splices: /* opener joined');
    end);
  DoCheckLexed('u\'#10'8"x"',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.TokenAt(0).Kind = tkStringLiteral) and
        (AStream.TokenAt(0).LiteralPrefix = lpU8) and (AStream.TokenAt(0).Spelling = 'u8"x"'),
        'splices: literal prefix joined');
    end);
  DoCheckLexed('R\'#10'"(a\'#10'b)"',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.TokenAt(0).Kind = tkStringLiteral) and AStream.TokenAt(0).IsRawString and
        (AStream.TokenAt(0).Spelling = 'R"(a\'#10'b)"'),
        'splices: raw prefix joined, raw body physical');
    end);
  DoCheckLexed('R"x\'#10'y(a)x\'#10'y"',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoCountCode(AErrors, PC_ERR_LEX_010) = 1, 'splices: raw delimiter never spliced');
    end);
  DoCheckLexed('\'#10'#define X 3',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(0).Kind = tkCppPreprocessor),
        'splices: # after a splice at line start');
    end);
  DoCheckLexed('#def\'#10'ine X 4',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.TokenAt(0).Kind = tkCppPreprocessor) and
        (AStream.TokenAt(0).Spelling = '#define X 4'),
        'splices: # line spelling');
    end);
  DoCheckLexed('"a\\'#10'";',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoCountCode(AErrors, PC_ERR_LEX_001) = 1, 'splices: escape takes the logical "');
    end);
  DoCheckLexed('"a\\'#10'\";',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(0).Kind = tkStringLiteral) and
        (AStream.TokenAt(0).Spelling = '"a\\"'),
        'splices: escape takes the logical \');
    end);
  DoCheckLexed('"a\'#10'b"',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(0).Spelling = '"ab"'),
        'splices: string continues');
    end);
  DoCheckLexed('"a\\'#10#10'";',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      // Probed (b_esc_newline): unterminated on line 1, a second literal on line 3
      Check((DoCountCode(AErrors, PC_ERR_LEX_001) = 2) and DoErrorAt(AErrors, PC_ERR_LEX_001, 1, 1) and
        DoErrorAt(AErrors, PC_ERR_LEX_001, 3, 1),
        'splices: an escape never takes a newline');
    end);
  DoCheckLexed('x\',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 1) and (DoCountCode(AErrors, PC_ERR_LEX_004) = 1),
        'splices: \ at end of input is a stray \');
    end);
  DoCheckLexed('x\  ',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 1) and (DoCountCode(AErrors, PC_ERR_LEX_004) = 1),
        'splices: \ spaces end of input is a stray \');
    end);
  DoCheckLexed('x\'#10,
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(AErrors.Count() = 0, 'splices: \ newline at end of input is a splice');
    end);
  DoCheckLexed('x \ y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_ERR_LEX_004) = 1) and DoSpellingsMatch(AStream, ['x', '\', 'y']),
        'splices: \ space code is a stray \');
    end);
  DoCheckLexed('int x; \'#10'#define Y',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoCountCode(AErrors, PC_ERR_LEX_008) = 1, 'splices: a splice is not a line start');
    end);
  DoCheckLexed('@if\'#10'def',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AStream.TokenAt(0).Kind = tkDirective) and (AStream.TokenAt(0).Spelling = '@ifdef'),
        'splices: @ directive joined');
    end);
  DoCheckLexed('cppstart source x cpp\'#10'end;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(2).Kind = tkRawBlock) and
        (AStream.TokenAt(2).Text = ' x ') and (AStream.TokenAt(3).Spelling = 'cppend') and
        (AStream.TokenAt(3).Kind = DoKindOf('cppend')),
        'splices: cppend by spelling ends the block');
    end);
end;

procedure TPCLexerTests.DoTestSpliceWarnings();
begin
  // LX0201-LX0203 at clang's positions; look-ahead never reports
  DoCheckLexed('ab\'#9' '#10'cd',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_WARN_LEX_001) = 1) and DoErrorAt(AErrors, PC_WARN_LEX_001, 1, 4) and
        (AStream.TokenAt(0).Spelling = 'abcd'),
        'splice warnings: token, at the first blank');
    end);
  DoCheckLexed('// a \ '#10'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_WARN_LEX_001) = 1) and DoErrorAt(AErrors, PC_WARN_LEX_001, 1, 6) and
        DoSpellingsMatch(AStream, []),
        'splice warnings: // comment, at the \');
    end);
  DoCheckLexed('"a\ '#10'b"',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_WARN_LEX_001) = 1) and DoErrorAt(AErrors, PC_WARN_LEX_001, 1, 4) and
        (AStream.TokenAt(0).Spelling = '"ab"'),
        'splice warnings: string');
    end);
  DoCheckLexed('/* a \  '#10' b */ x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and DoSpellingsMatch(AStream, ['x']),
        'splice warnings: none in a block comment body');
    end);
  DoCheckLexed('R"(a\ '#10'b)"',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(AErrors.Count() = 0, 'splice warnings: none in a raw body');
    end);
  DoCheckLexed('/* c *\'#10'/ x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 1) and (DoCountCode(AErrors, PC_WARN_LEX_002) = 1) and
        DoErrorAt(AErrors, PC_WARN_LEX_002, 1, 7) and DoSpellingsMatch(AStream, ['x']),
        'splice warnings: escaped */ at the \');
    end);
  DoCheckLexed('/* a *\ '#10'/ x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 2) and (DoCountCode(AErrors, PC_WARN_LEX_002) = 1) and
        DoErrorAt(AErrors, PC_WARN_LEX_002, 1, 7) and (DoCountCode(AErrors, PC_WARN_LEX_001) = 1) and
        DoErrorAt(AErrors, PC_WARN_LEX_001, 1, 8),
        'splice warnings: whitespace splice in */ warns twice');
    end);
  DoCheckLexed('/* a /* b */ x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_WARN_LEX_003) = 1) and DoErrorAt(AErrors, PC_WARN_LEX_003, 1, 6),
        'splice warnings: /* within block comment');
    end);
  DoCheckLexed('<\ '#10'<',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoCountCode(AErrors, PC_WARN_LEX_001) = 1, 'splice warnings: inside an operator, once');
    end);
  DoCheckLexed('a+\ '#10'b',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoCountCode(AErrors, PC_WARN_LEX_001) = 1, 'splice warnings: after an operator, once');
    end);
  DoCheckLexed('#define X 1 \ '#10'+ 2',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_WARN_LEX_001) = 1) and DoErrorAt(AErrors, PC_WARN_LEX_001, 1, 14) and
        (AStream.Count() = 2) and (AStream.TokenAt(0).Kind = tkCppPreprocessor),
        'splice warnings: # line');
    end);
end;

procedure TPCLexerTests.DoTestPpQuote();
begin
  // An unclosed quote on a # line runs to the newline: its /* is text
  DoCheckLexed('#define Q ''a /*'#10'x',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.Count() = 0) and (AStream.TokenAt(0).Text = '#define Q ''a /*') and
        (AStream.TokenAt(1).Spelling = 'x') and (AStream.TokenAt(1).Range.StartLine = 2),
        'pp quote: unclosed quote ends at the newline');
    end);
end;

procedure TPCLexerTests.DoTestSplitSplice();
begin
  // A spliced >> splits into two > pieces on logical bytes
  DoCheckLexed('>\'#10'>',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LToken: TPCToken;
    begin
      Check((AStream.Count() = 2) and (AStream.TokenAt(0).Kind = DoKindOf('>>')),
        'split splice: one >> token');
      Check(AStream.SplitCurrent(), 'split splice: it splits');
      LToken := AStream.CurrentToken();
      Check((LToken.Spelling = '>') and (LToken.Range.StartByteOffset = 0) and
        (LToken.Range.EndByteOffset = 1) and (LToken.Range.StartLine = 1),
        'split splice: first piece');
      AStream.NextToken();
      LToken := AStream.CurrentToken();
      Check((LToken.Spelling = '>') and (LToken.Kind = DoKindOf('>')) and
        (LToken.Range.StartByteOffset = 3) and (LToken.Range.StartLine = 2) and
        (LToken.Range.StartColumn = 1),
        'split splice: second piece after the splice');
    end);
end;

procedure TPCLexerTests.DoTestCppstartSplice();
begin
  // LX0014: no newline after the block's last splice before cppend
  DoCheckLexed('cppstart source #define M \'#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_ERR_LEX_014) = 1) and DoErrorAt(AErrors, PC_ERR_LEX_014, 1, 27) and
        (AStream.TokenAt(2).Kind = tkRawBlock) and (AStream.TokenAt(3).Spelling = 'cppend'),
        'cppstart splice: trailing splice is LX0014, block still emitted');
    end);
  DoCheckLexed('cppstart source #define M \'#10#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoCountCode(AErrors, PC_ERR_LEX_014) = 0, 'cppstart splice: an empty line ends it');
    end);
  DoCheckLexed('cppstart source #define M \'#10'  cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(DoCountCode(AErrors, PC_ERR_LEX_014) = 1, 'cppstart splice: blanks are no newline');
    end);
  DoCheckLexed('cppstart source // c \'#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_ERR_LEX_013) = 1) and (DoCountCode(AErrors, PC_ERR_LEX_014) = 0),
        'cppstart splice: a spliced // comment swallows cppend');
    end);
  DoCheckLexed('cppstart source x \ '#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((DoCountCode(AErrors, PC_ERR_LEX_014) = 1) and (DoCountCode(AErrors, PC_WARN_LEX_001) = 1),
        'cppstart splice: whitespace splice warns and is LX0014');
    end);
  DoCheckLexed('cppstart source x = ''a cppend;'#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      // Probed (b_code_quote): an unclosed quote runs to the end of its line
      Check((AErrors.Count() = 0) and (AStream.TokenAt(2).Kind = tkRawBlock) and
        (AStream.TokenAt(2).Text = ' x = ''a cppend;'#10) and (AStream.TokenAt(3).Range.StartLine = 2),
        'cppstart splice: an unclosed quote runs to the newline');
    end);
end;

procedure TPCLexerTests.DoTestFileError();
var
  LErrors: TErrors;
  LStream: TPCTokenStream;
  LOk: Boolean;
  LPaths: TArray<string>;
  LPath: string;
begin
  // A missing file and a name no file routine can take are both LX0012,
  // never a raise; the stream still ends with its one EOF (R18 G7)
  LPaths := [DoLexDir() + '\lx_missing_file.pcpp', DoLexDir() + '\a<b.pcpp'];
  for LPath in LPaths do
  begin
    LErrors := TErrors.Create();
    LStream := TPCTokenStream.Create();
    try
      LErrors.SetMaxErrors(100);
      LOk := DoLexPath(LPath, LErrors, LStream);
      Check((not LOk) and (LErrors.Count() = 1) and
        (DoCountCode(LErrors, PC_ERR_LEX_012) = 1) and (LStream.Count() = 1) and
        (LStream.TokenAt(0).Kind = tkEOF),
        'file error: LX0012 and a lone EOF for ' +
        LPath.Substring(LPath.LastIndexOf('\') + 1));
    finally
      LStream.Free();
      LErrors.Free();
    end;
  end;
end;

procedure TPCLexerTests.DoTestInsideLines();
begin
  // R23: a raw string, a block comment, a spliced name, a spliced // comment
  DoCheckLexed('a = R"(x' + #10 + 'y)";' + #10 + '/* p' + #10 + 'q */' + #10 + 'ab\' + #10 +
    'cd;' + #10 + '// r \' + #10 + 's' + #10 + 'e;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.ErrorCount() = 0) and
        (DoLineList(AStream.InsideLines(0, AStream.SourceText().ByteCount())) = '2,4,6,8'),
        'inside_lines: every line that starts inside a token or comment is marked');
    end);
  // A cppstart block is C++ text: only the lines inside the C++ it holds
  DoCheckLexed('cppstart source' + #10 + '/* m' + #10 + 'n */ x' + #10 + 'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check((AErrors.ErrorCount() = 0) and
        (DoLineList(AStream.InsideLines(0, AStream.SourceText().ByteCount())) = '3'),
        'inside_lines: a cppstart block marks only lines inside its C++ elements');
    end);
end;

procedure TPCLexerTests.DoTestComments();
begin
  // E2.9 k4: offsets (a cursor before byte P) counted by hand on
  // 'a // x' LF '/* y */ b;' LF '#define Z 1 // w' LF:
  // the // comment is [2, 6) and runs to its line's end (6 = the LF),
  // the block comment is [7, 14); the # line's // is C++ text (byte 31)
  DoCheckLexed('a // x' + #10 + '/* y */ b;' + #10 + '#define Z 1 // w' + #10,
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    begin
      Check(AErrors.ErrorCount() = 0, 'comments: lexes clean');
      Check(not AStream.InComment(2), 'comments: before // is outside');
      Check(AStream.InComment(3), 'comments: between the two / is inside');
      Check(AStream.InComment(6), 'comments: a // comment runs to its line''s end');
      Check(not AStream.InComment(7), 'comments: the next line''s start is outside');
      Check(AStream.InComment(8), 'comments: after /* is inside');
      Check(AStream.InComment(13), 'comments: before the closing / is inside');
      Check(not AStream.InComment(14), 'comments: after */ is outside');
      Check(not AStream.InComment(15), 'comments: code after a block comment is outside');
      Check(not AStream.InComment(33), 'comments: a # line''s // is its token''s text');
      Check(not AStream.InComment(0), 'comments: the first byte is outside');
    end);
end;

procedure TPCLexerTests.DoTestCommentsIn();
begin
  // E2.10 f1: the same buffer as DoTestComments, spans counted by hand:
  // the // comment [2, 6) (IsLine), the block comment [7, 14); the # line's
  // // is C++ text, never a span
  DoCheckLexed('a // x' + #10 + '/* y */ b;' + #10 + '#define Z 1 // w' + #10,
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LSpans: TArray<TPCCommentSpan>;
    begin
      Check(AErrors.ErrorCount() = 0, 'comments_in: lexes clean');
      LSpans := AStream.CommentsIn(0, 100);
      Check((Length(LSpans) = 2) and
        (LSpans[0].StartOffset = 2) and (LSpans[0].EndOffset = 6) and LSpans[0].IsLine and
        (LSpans[1].StartOffset = 7) and (LSpans[1].EndOffset = 14) and not LSpans[1].IsLine,
        'comments_in: the whole buffer holds both comments, in byte order');
      LSpans := AStream.CommentsIn(3, 100);
      Check((Length(LSpans) = 1) and (LSpans[0].StartOffset = 7),
        'comments_in: a comment starting before AFrom is not listed');
      LSpans := AStream.CommentsIn(2, 7);
      Check((Length(LSpans) = 1) and (LSpans[0].StartOffset = 2),
        'comments_in: AEnd is exclusive');
      LSpans := AStream.CommentsIn(14, 100);
      Check(Length(LSpans) = 0, 'comments_in: a # line''s // is no comment span');
    end);
end;

procedure TPCLexerTests.DoTestFloatValues();
var
  LPath: string;
  LLines: TArray<string>;
  LLine: string;
  LParts: TArray<string>;
  LFormat: TPCFloatFormat;
  LStatus: TPCFloatStatus;
  LValue: Double;
  LBits: UInt64;
  LGot: string;
  LCount: Integer;
begin
  // Each case's expected bit pattern is clang's own, the same on both
  // targets (scripts\zb_sem\gen_flt.py writes tests\probe\flt\flt_cases.txt)
  LPath := TPath.GetFullPath(TPath.Combine(TPath.GetDirectoryName(ParamStr(0)),
    '..\..\tests\probe\flt\flt_cases.txt'));
  Check(TFile.Exists(LPath), 'float_values: fixture flt_cases.txt exists');
  if not TFile.Exists(LPath) then
    Exit;
  LLines := TFile.ReadAllLines(LPath, TEncoding.UTF8);
  LCount := 0;
  for LLine in LLines do
  begin
    LParts := LLine.Trim().Split([' ']);
    if Length(LParts) <> 3 then
      Continue;
    if LParts[0] = 'f' then
      LFormat := ffBinary32
    else
      LFormat := ffBinary64;
    LStatus := TPCFloatDecoder.Decode(LParts[1], LFormat, LValue);
    if LStatus = fsOk then
    begin
      Move(LValue, LBits, SizeOf(LBits));
      LGot := IntToHex(LBits, 16);
    end
    else if LStatus = fsOverflow then
      LGot := 'OVERFLOW'
    else
      LGot := 'MALFORMED';
    Check(LGot = LParts[2], 'float_values: ' + LParts[0] + ' ' + LParts[1] +
      ' expected ' + LParts[2] + ', got ' + LGot);
    Inc(LCount);
  end;
  Check(LCount = 82, 'float_values: 82 cases, got ' + IntToStr(LCount));

  // Not a floating literal's numeric part: malformed, never a value
  Check(TPCFloatDecoder.Decode('0x1.8', ffBinary64, LValue) = fsMalformed,
    'float_values: hex without p is malformed');
  Check(TPCFloatDecoder.Decode('1e', ffBinary64, LValue) = fsMalformed,
    'float_values: exponent without digits is malformed');
  Check(TPCFloatDecoder.Decode('', ffBinary64, LValue) = fsMalformed,
    'float_values: empty text is malformed');
  Check(TPCFloatDecoder.Decode('1.2.3', ffBinary64, LValue) = fsMalformed,
    'float_values: two points are malformed');
  Check(TPCFloatDecoder.Decode('0xp1', ffBinary64, LValue) = fsMalformed,
    'float_values: hex without digits is malformed');
  Check(TPCFloatDecoder.Decode('1e5x', ffBinary64, LValue) = fsMalformed,
    'float_values: trailing text is malformed');
end;

procedure TPCLexerTests.DoTestFloatLexing();
begin
  // The lexer's wiring: a value in the suffix's format, LX0006 on overflow in
  // that format, no value for an opaque suffix or a UD literal
  DoCheckLexed('0x1.8p3 1e39f 0x1p128f 1.5l 0x1p-1f 1e999 ' +
    '1.00000005960464477539062501f 2.5_km 0x1.8p3f16',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LBits: UInt64;
      LValue: Double;
    begin
      Check((AStream.TokenAt(0).Kind = tkFloatLiteral) and AStream.TokenAt(0).HasValue and
        (AStream.TokenAt(0).FloatValue = 12.0),
        'float_lexing: 0x1.8p3 = 12');
      Check((AStream.TokenAt(1).Kind = tkUnknown) and (AStream.TokenAt(2).Kind = tkUnknown) and
        (AStream.TokenAt(5).Kind = tkUnknown),
        'float_lexing: 1e39f, 0x1p128f, 1e999 overflow their format');
      Check((DoCountCode(AErrors, PC_ERR_LEX_006) = 3) and (AErrors.Count() = 3),
        'float_lexing: exactly three LX0006, got ' + IntToStr(AErrors.Count()) + ' reports');
      Check((AStream.TokenAt(3).Kind = tkFloatLiteral) and (not AStream.TokenAt(3).HasValue) and
        (AStream.TokenAt(3).Suffix = 'l') and (not AStream.TokenAt(3).IsUserDefined),
        'float_lexing: 1.5l opaque, no value');
      Check(AStream.TokenAt(4).HasValue and (AStream.TokenAt(4).FloatValue = 0.5),
        'float_lexing: 0x1p-1f = 0.5');
      // Rounded once to binary32 (not to binary64, then binary32): 1 + 2^-23
      LValue := AStream.TokenAt(6).FloatValue;
      Move(LValue, LBits, SizeOf(LBits));
      Check(AStream.TokenAt(6).HasValue and (LBits = UInt64($3FF0000020000000)),
        'float_lexing: f literal rounded once to binary32, got ' + IntToHex(LBits, 16));
      Check(AStream.TokenAt(7).IsUserDefined and (not AStream.TokenAt(7).HasValue),
        'float_lexing: 2.5_km UD literal, no value');
      Check((AStream.TokenAt(8).Kind = tkFloatLiteral) and (not AStream.TokenAt(8).HasValue) and
        (AStream.TokenAt(8).Suffix = 'f16'),
        'float_lexing: 0x1.8p3f16 opaque, no value');
    end);
end;

procedure TPCLexerTests.DoTestIntBounds();
var
  LRows: TArray<TPCIntBoundRow>;
  LRow: TPCIntBoundRow;
  LErrors: TErrors;
  LStream: TPCTokenStream;
  LToken: TPCToken;
  LMessage: string;
  LOk: Boolean;
  LFailed: Integer;
  LFirst: string;
begin
  // F19, C++23 [lex.icon]: every standard suffix x base at INT64_MAX,
  // INT64_MAX + 1, UINT64_MAX, UINT64_MAX + 1. A decimal literal without u
  // must fit int64 (above: LX0006 naming the u spelling), every other one
  // uint64 (above: LX0006). Rows: scripts\zb_cmpl\f19\gen_bounds.py
  Check(DoIntBoundRows(LRows) and (Length(LRows) = TEST_IB_ROW_COUNT),
    Format('int_bounds: %d rows read (ib_rows.txt)', [TEST_IB_ROW_COUNT]));
  LFailed := 0;
  LFirst := '';
  for LRow in LRows do
  begin
    LErrors := TErrors.Create();
    LStream := TPCTokenStream.Create();
    try
      LErrors.SetMaxErrors(100);
      DoLexBytes(LRow.Literal, LErrors, LStream);
      LToken := LStream.TokenAt(0);
      LMessage := '';
      if DoErrorCount(LErrors) > 0 then
        LMessage := LErrors.GetItems()[0].Message;

      if LRow.Expect = 'ok' then
        LOk := (LToken.Kind = tkIntLiteral) and LToken.HasValue and
          (UIntToStr(LToken.IntValue) = LRow.Value) and (DoErrorCount(LErrors) = 0)
      else if LRow.Expect = 'signed' then
        LOk := (LToken.Kind = tkUnknown) and (DoErrorCount(LErrors) = 1) and
          (DoCountCode(LErrors, PC_ERR_LEX_006) = 1) and
          (LMessage = Format(RSLexNumberSignedOverflow, [LRow.Literal, LRow.Suggest]))
      else
        LOk := (LToken.Kind = tkUnknown) and (DoErrorCount(LErrors) = 1) and
          (DoCountCode(LErrors, PC_ERR_LEX_006) = 1) and
          (LMessage = Format(RSLexNumberOverflow, [LRow.Literal]));

      if not LOk then
      begin
        Inc(LFailed);
        if LFailed <= 5 then
          LFirst := LFirst + Format(' [%s expect %s: kind %d, %d errors, "%s"]',
            [LRow.Literal, LRow.Expect, Ord(LToken.Kind), DoErrorCount(LErrors), LMessage]);
      end;
    finally
      LStream.Free();
      LErrors.Free();
    end;
  end;
  Check(LFailed = 0, Format('int_bounds: every row as C++23 types it, %d failed%s',
    [LFailed, LFirst]));
end;

procedure TPCLexerTests.DoTestIntBoundsWitness();
var
  LRows: TArray<TPCIntBoundRow>;
  LRow: TPCIntBoundRow;
  LModel: TPCDataModelRow;
  LZig: string;
  LDir: string;
  LSource: string;
  LParams: string;
  LOutput: string;
  LExitCode: DWORD;
  LRaised: string;
  LText: string;
  LRest: string;
  LPos: Integer;
  LEnd: Integer;
  LLine: Integer;
  LMaxLine: Integer;
  LReported: TArray<Boolean>;
  LReportedCount: Integer;
  LForeign: Integer;
  LFailed: Integer;
  LFirst: string;
begin
  // The bundled clang is the witness of the rule int_bounds checks (as
  // Conditionals.datamodel_witness): on every supported target a row's literal
  // compiles with no report exactly when the row is ok, so a toolchain whose
  // literal typing moves fails here instead of changing PaskalCPP's
  LZig := TUtils.ResolvePath('$P:res\zig\zig.exe');
  LDir := TPath.Combine(DoLexDir(), TEST_IB_DIR);
  LSource := TPath.Combine(LDir, TEST_IB_SOURCE);
  Check(TFile.Exists(LZig) and TFile.Exists(LSource) and DoIntBoundRows(LRows) and
    (Length(LRows) = TEST_IB_ROW_COUNT),
    'int_bounds_witness: the bundled zig, ib_bounds.cpp and its rows exist');

  LMaxLine := 0;
  for LRow in LRows do
  begin
    if LRow.Line > LMaxLine then
      LMaxLine := LRow.Line;
  end;

  for LModel in PC_DATA_MODELS do
  begin
    LParams := 'c++ -target ' + LModel.Target + ' -std=c++23 -fsyntax-only -ferror-limit=0 ' +
      TUtils.QuoteCommandArg(LSource);
    LOutput := '';
    LExitCode := 0;
    LRaised := '';
    try
      TUtils.CaptureConsoleOutput('', PChar(LZig), PChar(LParams), LDir, LExitCode, nil,
        procedure(const ALine: string; const AData: Pointer)
        begin
          LOutput := LOutput + ALine + #10;
        end);
    except
      on E: Exception do
        LRaised := E.Message;
    end;
    // The overflow rows are errors: clang exits non-zero; it must have run
    Check((LRaised = '') and (LExitCode <> 0),
      Format('int_bounds_witness: clang ran for %s (exit %d%s)', [LModel.Target, LExitCode, LRaised]));

    // Every 'ib_bounds.cpp:<line>:' diagnostic marks its line
    SetLength(LReported, LMaxLine + 1);
    for LLine := 0 to LMaxLine do
      LReported[LLine] := False;
    LForeign := 0;
    for LText in LOutput.Split([#10]) do
    begin
      LPos := LText.IndexOf(TEST_IB_SOURCE + ':');
      if LPos < 0 then
        Continue;
      LRest := LText.Substring(LPos + Length(TEST_IB_SOURCE) + 1);
      LEnd := LRest.IndexOf(':');
      if (LEnd <= 0) or (not TryStrToInt(LRest.Substring(0, LEnd), LLine)) then
        Continue;
      if (LLine < 0) or (LLine > LMaxLine) then
        Inc(LForeign)
      else
        LReported[LLine] := True;
    end;

    LFailed := 0;
    LFirst := '';
    LReportedCount := 0;
    for LRow in LRows do
    begin
      if LReported[LRow.Line] then
        Inc(LReportedCount);
      if (LRow.Expect = 'ok') = LReported[LRow.Line] then
      begin
        Inc(LFailed);
        if LFailed <= 5 then
          LFirst := LFirst + Format(' [%s expect %s]', [LRow.Literal, LRow.Expect]);
      end;
    end;
    Check((LFailed = 0) and (LForeign = 0) and (LReportedCount = TEST_IB_REPORTED_COUNT),
      Format('int_bounds_witness: %s reports exactly the %d rows that are not ok (%d reported, ' +
        '%d disagree, %d off the rows)%s',
        [LModel.Target, TEST_IB_REPORTED_COUNT, LReportedCount, LFailed, LForeign, LFirst]));
  end;
end;

procedure TPCLexerTests.DoTestFloatSuffixes();
var
  LText: string;
  LSuffix: string;
  LTaken: Integer;
begin
  // F63: every standard floating suffix the bundled clang takes is a float
  // literal (never a user-defined one); every one it refuses is LX0005 at the
  // literal, one report each. Rows are the lexer's own tables, in order
  LText := '';
  for LSuffix in PC_FLOAT_SUFFIXES do
    LText := LText + '1.5' + LSuffix + ' ';
  for LSuffix in PC_FLOAT_SUFFIXES_REFUSED do
    LText := LText + '1.5' + LSuffix + ' ';
  LTaken := Length(PC_FLOAT_SUFFIXES);
  DoCheckLexed(LText,
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LI: Integer;
      LToken: TPCToken;
    begin
      for LI := 0 to LTaken - 1 do
      begin
        LToken := AStream.TokenAt(LI);
        Check((LToken.Kind = tkFloatLiteral) and (not LToken.IsUserDefined) and
          (LToken.Suffix = PC_FLOAT_SUFFIXES[LI]),
          'float_suffixes: 1.5' + PC_FLOAT_SUFFIXES[LI] + ' is a float literal');
      end;
      for LI := 0 to High(PC_FLOAT_SUFFIXES_REFUSED) do
      begin
        LToken := AStream.TokenAt(LTaken + LI);
        Check(LToken.Kind = tkUnknown,
          'float_suffixes: 1.5' + PC_FLOAT_SUFFIXES_REFUSED[LI] + ' is reported (tkUnknown)');
      end;
      Check((DoCountCode(AErrors, PC_ERR_LEX_005) = Length(PC_FLOAT_SUFFIXES_REFUSED)) and
        (AErrors.Count() = Length(PC_FLOAT_SUFFIXES_REFUSED)),
        Format('float_suffixes: exactly %d LX0005, got %d reports',
          [Length(PC_FLOAT_SUFFIXES_REFUSED), AErrors.Count()]));
    end);
end;

procedure TPCLexerTests.DoTestFloatSuffixWitness();
const
  { TEST_FS_SOURCE }
  TEST_FS_SOURCE = 'fs_suffixes.cpp';
var
  LLines: TArray<string>;
  LTaken: TArray<Boolean>;
  LReported: TArray<Boolean>;
  LCount: Integer;
  LI: Integer;
  LModel: TPCDataModelRow;
  LZig: string;
  LDir: string;
  LSource: string;
  LParams: string;
  LOutput: string;
  LExitCode: DWORD;
  LRaised: string;
  LText: string;
  LRest: string;
  LPos: Integer;
  LEnd: Integer;
  LLine: Integer;
  LForeign: Integer;
  LFailed: Integer;
  LFirst: string;
begin
  // The bundled clang is the witness of the two suffix tables (as
  // int_bounds_witness): line N of the source holds row N, and on every
  // supported target a row compiles with no report exactly when its table is
  // PC_FLOAT_SUFFIXES. The build's own -std flag (ZigBuild PC_CPP_STD_FLAG)
  LCount := Length(PC_FLOAT_SUFFIXES) + Length(PC_FLOAT_SUFFIXES_REFUSED);
  SetLength(LLines, LCount);
  SetLength(LTaken, LCount);
  for LI := 0 to High(PC_FLOAT_SUFFIXES) do
  begin
    LLines[LI] := Format('auto pcpp_v%d = 1.5%s;', [LI, PC_FLOAT_SUFFIXES[LI]]);
    LTaken[LI] := True;
  end;
  for LI := 0 to High(PC_FLOAT_SUFFIXES_REFUSED) do
  begin
    LLines[Length(PC_FLOAT_SUFFIXES) + LI] := Format('auto pcpp_v%d = 1.5%s;',
      [Length(PC_FLOAT_SUFFIXES) + LI, PC_FLOAT_SUFFIXES_REFUSED[LI]]);
    LTaken[Length(PC_FLOAT_SUFFIXES) + LI] := False;
  end;

  LZig := TUtils.ResolvePath('$P:res\zig\zig.exe');
  LDir := TPath.Combine(TPath.GetTempPath(), 'pcpp-float-suffix');
  LSource := TPath.Combine(LDir, TEST_FS_SOURCE);
  LRaised := '';
  try
    TDirectory.CreateDirectory(LDir);
    TFile.WriteAllLines(LSource, LLines, TEncoding.ASCII);
  except
    on E: Exception do
      LRaised := E.Message;
  end;
  Check((LRaised = '') and TFile.Exists(LZig) and TFile.Exists(LSource),
    'float_suffix_witness: the bundled zig and ' + TEST_FS_SOURCE + ' exist' + LRaised);

  for LModel in PC_DATA_MODELS do
  begin
    LParams := 'c++ -target ' + LModel.Target + ' ' + PC_CPP_STD_FLAG.DeQuotedString('"') +
      ' -fsyntax-only -ferror-limit=0 ' + TUtils.QuoteCommandArg(LSource);
    LOutput := '';
    LExitCode := 0;
    LRaised := '';
    try
      TUtils.CaptureConsoleOutput('', PChar(LZig), PChar(LParams), LDir, LExitCode, nil,
        procedure(const ALine: string; const AData: Pointer)
        begin
          LOutput := LOutput + ALine + #10;
        end);
    except
      on E: Exception do
        LRaised := E.Message;
    end;
    // The refused rows are errors: clang exits non-zero; it must have run
    Check((LRaised = '') and (LExitCode <> 0),
      Format('float_suffix_witness: clang ran for %s (exit %d%s)', [LModel.Target, LExitCode, LRaised]));

    // Every 'fs_suffixes.cpp:<line>:' diagnostic marks its row (line - 1)
    SetLength(LReported, LCount);
    for LI := 0 to LCount - 1 do
      LReported[LI] := False;
    LForeign := 0;
    for LText in LOutput.Split([#10]) do
    begin
      LPos := LText.IndexOf(TEST_FS_SOURCE + ':');
      if LPos < 0 then
        Continue;
      LRest := LText.Substring(LPos + Length(TEST_FS_SOURCE) + 1);
      LEnd := LRest.IndexOf(':');
      if (LEnd <= 0) or (not TryStrToInt(LRest.Substring(0, LEnd), LLine)) then
        Continue;
      if (LLine < 1) or (LLine > LCount) then
        Inc(LForeign)
      else
        LReported[LLine - 1] := True;
    end;

    LFailed := 0;
    LFirst := '';
    for LI := 0 to LCount - 1 do
    begin
      if LTaken[LI] = LReported[LI] then
      begin
        Inc(LFailed);
        LFirst := LFirst + ' [' + LLines[LI] + ']';
      end;
    end;
    Check((LFailed = 0) and (LForeign = 0),
      Format('float_suffix_witness: %s takes exactly PC_FLOAT_SUFFIXES (%d disagree, %d off the rows)%s',
        [LModel.Target, LFailed, LForeign, LFirst]));
  end;
end;

procedure TPCLexerTests.DoTestCppElements();
begin
  // The C++ elements DoCapture records for a cppstart block (O-S6b,
  // research\cppmix\sem\prereq-b\jump.md): tag, splice-free spelling ('' for a
  // literal), start line:column; blanks, comments and # lines are no elements.
  // Columns counted from the bytes (scripts\zb_sem\pb\r4g1_cols.py E1-E9)
  DoCheckLexed('cppstart source a::b : c cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LElements: TArray<TPCCppElement>;
      LText: string;
    begin
      LElements := DoBlockElements(AStream);
      LText := DoElementsText(LElements);
      Check((AErrors.Count() = 0) and (LText = 'w:a@1:17 p:::@1:18 w:b@1:20 p::@1:22 w:c@1:24') and
        (LElements[0].TokenKind = tkUnknown) and (LElements[1].TokenKind = tkColonColon) and
        (LElements[3].TokenKind = tkColon), 'cpp_elements: :: and : are two punctuators (got ' +
        LText + ')');
    end);
  DoCheckLexed('cppstart source a<:0:> cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LElements: TArray<TPCCppElement>;
      LText: string;
    begin
      LElements := DoBlockElements(AStream);
      LText := DoElementsText(LElements);
      Check((AErrors.Count() = 0) and (LText = 'w:a@1:17 p:<:@1:18 l:@1:20 p::>@1:21') and
        (LElements[1].TokenKind = tkLBracket) and (LElements[2].TokenKind = tkUnknown) and
        (LElements[3].TokenKind = tkRBracket),
        'cpp_elements: a digraph keeps its spelling and reads as [ ] by kind (got ' + LText + ')');
    end);
  DoCheckLexed('cppstart source x +\ '#10'= y'#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.ErrorCount() = 0) and (AErrors.Count() = 1) and
        (DoCountCode(AErrors, PC_WARN_LEX_001) = 1) and (LText = 'w:x@1:17 p:+=@1:19 w:y@2:3'),
        'cpp_elements: an operator across a whitespace splice is one element, LX0201 once (got ' +
        LText + ')');
    end);
  DoCheckLexed('cppstart source'#10'#define X 1'#10'y'#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.Count() = 0) and (LText = 'w:y@3:1'),
        'cpp_elements: a # line records nothing (got ' + LText + ')');
    end);
  // R4z1 (2026-10-07): the hash digraph. %: first on its line starts a # line;
  // anywhere else %: and # are one ceOther element each, as clang's hash token
  DoCheckLexed('cppstart source'#10'%:define X 1'#10'y'#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.Count() = 0) and (LText = 'w:y@3:1'),
        'cpp_elements: a %: line records nothing (got ' + LText + ')');
    end);
  DoCheckLexed('cppstart source a %: b # c cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.Count() = 0) and (LText = 'w:a@1:17 o:%:@1:19 w:b@1:22 o:#@1:24 w:c@1:26'),
        'cpp_elements: a mid-line %: or # is one element (got ' + LText + ')');
    end);
  DoCheckLexed('cppstart source'#10'#define X /*'#10'*/ 1'#10'z'#10'cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.Count() = 0) and (LText = 'w:z@4:1'),
        'cpp_elements: a block comment carries a # line over its newline (got ' + LText + ')');
    end);
  DoCheckLexed('cppstart source c = ''}''; cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.Count() = 0) and (LText = 'w:c@1:17 p:=@1:19 l:@1:21 p:;@1:24'),
        'cpp_elements: a char literal ''}'' is one literal (got ' + LText + ')');
    end);
  DoCheckLexed('cppstart source R"(a)" u8"b" cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.Count() = 0) and (LText = 'l:@1:17 w:u8@1:24 l:@1:26'),
        'cpp_elements: a raw string is one literal, u8 + a quote a word and a literal (got ' +
        LText + ')');
    end);
  DoCheckLexed('cppstart source '#$00E9' ` cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LText: string;
    begin
      LText := DoElementsText(DoBlockElements(AStream));
      Check((AErrors.Count() = 0) and (LText = 'o:'#$00E9'@1:17 o:`@1:20'),
        'cpp_elements: a byte no rule takes is ceOther, no error (got ' + LText + ')');
    end);
  DoCheckLexed('cppstart source :: { cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LElements: TArray<TPCCppElement>;
      LText: string;
    begin
      LElements := DoBlockElements(AStream);
      LText := DoElementsText(LElements);
      Check((AErrors.Count() = 0) and (LText = 'p:::@1:17 p:{@1:20') and
        (LElements[0].TokenKind = tkColonColon) and (LElements[1].TokenKind = tkLBrace),
        'cpp_elements: punctuators carry their vocabulary kind (got ' + LText + ')');
    end);
end;

procedure TPCLexerTests.DoTestCppElementSplices();
var
  LI: Integer;
  LCase: TPCSpliceCase;
  LLabel: string;
begin
  // F-L2: LX0014 for a splice anywhere in the block's bytes (raw bodies
  // excepted). A for-loop variable cannot be captured: the case and its label
  // are copied into locals first
  for LI := Low(TEST_CPP_SPLICE_CASES) to High(TEST_CPP_SPLICE_CASES) do
  begin
    LCase := TEST_CPP_SPLICE_CASES[LI];
    LLabel := 'cpp_element_splices case ' + IntToStr(LI);
    DoCheckLexed(LCase.Text,
      procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
      var
        LCount: Integer;
      begin
        LCount := DoCountCode(AErrors, PC_ERR_LEX_014);
        if LCase.Column = 0 then
          Check(LCount = 0, LLabel + ': a newline follows the last splice, no LX0014 (got ' +
            IntToStr(LCount) + ')')
        else
          Check((LCount = 1) and DoErrorAt(AErrors, PC_ERR_LEX_014, 1, LCase.Column),
            LLabel + ': one LX0014 at the last splice (got ' + IntToStr(LCount) + ')');
      end);
  end;
end;

procedure TPCLexerTests.DoTestCppElementsIn();
begin
  // TPCTokenStream.CppElementsIn (steps-tokenstream.md T4): the elements
  // STARTING in [AFrom, AEnd), ascending. Tokens: cppstart source <block>
  // cppend ; on each line, so the blocks are tokens 2 and 7
  DoCheckLexed('cppstart source a cppend;'#10'cppstart source b c cppend;',
    procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
    var
      LFirst: TPCToken;
      LSecond: TPCToken;
      LAll: TArray<TPCCppElement>;
      LFrom: Int64;
      LAtB: Int64;
    begin
      LFirst := AStream.TokenAt(2);
      LSecond := AStream.TokenAt(7);
      LAll := AStream.CppElementsIn(0, AStream.SourceText().ByteCount());
      if (AErrors.Count() <> 0) or (LFirst.Kind <> tkRawBlock) or (LSecond.Kind <> tkRawBlock) or
        (DoElementsText(LAll) <> 'w:a@1:17 w:b@2:17 w:c@2:19') then
      begin
        Check(False, 'cpp_elements_in: two blocks lex to a | b c (got ' + DoElementsText(LAll) + ')');
        Exit;
      end;
      LFrom := Int64(LSecond.Range.StartByteOffset);
      LAtB := Int64(LAll[1].Range.StartByteOffset);
      Check(DoElementsText(AStream.CppElementsIn(Int64(LFirst.Range.StartByteOffset),
        Int64(LFirst.Range.EndByteOffset))) = 'w:a@1:17',
        'cpp_elements_in: a block''s range answers exactly its elements');
      Check(Length(AStream.CppElementsIn(Int64(LFirst.Range.EndByteOffset), LFrom)) = 0,
        'cpp_elements_in: the bytes between two blocks hold none');
      Check(Length(AStream.CppElementsIn(LFrom, LAtB)) = 0,
        'cpp_elements_in: AEnd is exclusive (an element starting at AEnd is out)');
      Check(Length(AStream.CppElementsIn(LFrom, LAtB + 1)) = 1,
        'cpp_elements_in: one byte further it is in');
    end);
end;

procedure TPCLexerTests.DoTestContextWords();
var
  LWord: TPCContextWord;
  LRow: TPCContextWordRow;
begin
  // PLAN-OBJECT H1: every context word lexes as its row says (a plain word
  // as an identifier, never a reserved token; virtual / operator / default
  // as their C++ tokens) and its row matches that token; a different case
  // or a longer word is not the word
  for LWord := Low(TPCContextWord) to High(TPCContextWord) do
  begin
    LRow := PC_CONTEXT_WORDS[LWord];
    DoCheckLexed(LRow.WordText,
      procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
      begin
        Check((AErrors.Count() = 0) and (AStream.TokenAt(0).Kind = LRow.Kind) and
          LRow.Matches(AStream.TokenAt(0)),
          'context_words: ''' + LRow.WordText + ''' lexes as its row''s token and matches it');
      end);
    DoCheckLexed(LRow.WordText.ToUpper() + ' ' + LRow.WordText + 'x',
      procedure(const AErrors: TErrors; const AStream: TPCTokenStream)
      begin
        Check(not (LRow.Matches(AStream.TokenAt(0)) or LRow.Matches(AStream.TokenAt(1))),
          'context_words: ''' + LRow.WordText.ToUpper() + ''' and ''' + LRow.WordText +
          'x'' are not the word');
      end);
  end;
end;

end.
