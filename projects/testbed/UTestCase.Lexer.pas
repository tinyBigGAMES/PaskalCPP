    procedure DoTestVocabulary();
    procedure DoTestRoundTrip();
    procedure DoTestNumbers();
    procedure DoTestOctal();
    procedure DoTestStrings();
    procedure DoTestCommentAndPreproc();
    procedure DoTestUtf8Columns();
    procedure DoTestTemplateSplit();
    procedure DoTestCppstart();
    procedure DoTestHash();
    procedure DoTestInline();
    procedure DoTestNewlines();
    procedure DoTestSplices();
    procedure DoTestSpliceWarnings();
    procedure DoTestPpQuote();
    procedure DoTestSplitSplice();
    procedure DoTestCppstartSplice();
    procedure DoTestFileError();
    procedure DoTestInsideLines();
    procedure DoTestComments();
    procedure DoTestCommentsIn();
    procedure DoTestFloatValues();
