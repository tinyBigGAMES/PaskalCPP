const
  { TEST_VOC_PASKAL_IF }
  TEST_VOC_PASKAL_IF: array[0..0] of TPCTokenRow = (
    (Text: 'if'; Kind: tkKwIf; Category: tcKeyword)
  );
  { TEST_VOC_PASKAL_BEGIN }
  TEST_VOC_PASKAL_BEGIN: array[0..0] of TPCTokenRow = (
    (Text: 'begin'; Kind: tkKwBegin; Category: tcKeyword)
  );
  { TEST_VOC_CPP_IF }
  TEST_VOC_CPP_IF: array[0..0] of TPCTokenRow = (
    (Text: 'if'; Kind: tkKwIf; Category: tcCppKeyword)
  );
  { TEST_VOC_CPP_IF_WRONG }
  // Same spelling, different kind: must fail with VC0003
  TEST_VOC_CPP_IF_WRONG: array[0..0] of TPCTokenRow = (
    (Text: 'if'; Kind: tkKwElse; Category: tcCppKeyword)
  );
  { TEST_VOC_CPP_CLASS }
  TEST_VOC_CPP_CLASS: array[0..0] of TPCTokenRow = (
    (Text: 'class'; Kind: tkKwClass; Category: tcCppKeyword)
  );
  { TEST_VOC_SHARED_IF }
  TEST_VOC_SHARED_IF: array[0..0] of TPCSharedRow = (
    (Text: 'if'; Resolution: srPaskalWins)
  );
  { TEST_VOC_SHARED_BEGIN }
  TEST_VOC_SHARED_BEGIN: array[0..0] of TPCSharedRow = (
    (Text: 'begin'; Resolution: srSame)
  );
  { TEST_VOC_PASKAL_IF_BEGIN }
  TEST_VOC_PASKAL_IF_BEGIN: array[0..1] of TPCTokenRow = (
    (Text: 'if';    Kind: tkKwIf;    Category: tcKeyword),
    (Text: 'begin'; Kind: tkKwBegin; Category: tcKeyword)
  );
  { TEST_VOC_CPP_IF_BEGIN }
  // Both spellings in both tables; only begin is listed: if must fail VC0001
  TEST_VOC_CPP_IF_BEGIN: array[0..1] of TPCTokenRow = (
    (Text: 'if';    Kind: tkKwIf;    Category: tcCppKeyword),
    (Text: 'begin'; Kind: tkKwBegin; Category: tcCppKeyword)
  );
  { TEST_VOC_PASKAL_IF_TWICE }
  // The same spelling twice in one table: must fail with VC0004
  TEST_VOC_PASKAL_IF_TWICE: array[0..1] of TPCTokenRow = (
    (Text: 'if'; Kind: tkKwIf; Category: tcKeyword),
    (Text: 'if'; Kind: tkKwIf; Category: tcKeyword)
  );

type
  { TPCLexCheck }
  // The assertions of one literal-text case: run on its diagnostics and stream
  TPCLexCheck = reference to procedure(const AErrors: TErrors; const AStream: TPCTokenStream);

  { TPCSpliceCase }
  // One F-L2 case: a cppstart text and the line-1 column of the '\' where
  // LX0014 is expected (0 = no LX0014)
  TPCSpliceCase = record
    Text: string;
    Column: UInt64;
  end;

const
  { TEST_CPP_ELEMENT_TAGS }
  // DoElementsText's tag per element kind
  TEST_CPP_ELEMENT_TAGS: array[TPCCppElementKind] of string = ('w', 'l', 'p', 'o');
  { TEST_CPP_SPLICE_CASES }
  // F-L2 (steps-lexer.md L4): every splice in a block's bytes is an LX0014
  // candidate, raw bodies excepted: one report at the last splice's '\' when no
  // newline follows it before cppend (a splice inside an operator, a word, a
  // string, a number, a comment, between a raw prefix and its quote), none
  // when one does (an empty line, a newline inside the comment, a raw body's
  // '\'+newline is content). Columns: r4g1_cols.py Z1-Z6
  TEST_CPP_SPLICE_CASES: array[0..8] of TPCSpliceCase = (
    (Text: 'cppstart source x +\'#10'+ cppend;';         Column: 20),
    (Text: 'cppstart source ab\'#10'cd cppend;';         Column: 19),
    (Text: 'cppstart source "a\'#10'b" cppend;';         Column: 19),
    (Text: 'cppstart source 1\'#10'2 cppend;';           Column: 18),
    (Text: 'cppstart source /* \'#10'*/ cppend;';        Column: 20),
    (Text: 'cppstart source R\'#10'"(x)" cppend;';       Column: 18),
    (Text: 'cppstart source x +\'#10#10'cppend;';        Column: 0),
    (Text: 'cppstart source /* \'#10'x'#10'*/ cppend;';  Column: 0),
    (Text: 'cppstart source R"(a\'#10')" cppend;';       Column: 0)
  );

function DoLexDir(): string;
begin
  // The exe sits two levels below the project root (repo\bin)
  Result := TPath.GetFullPath(TPath.Combine(
    TPath.GetDirectoryName(ParamStr(0)), '..\..\tests\probe\lex'));
end;

procedure DoLex(const AName: string; const AErrors: TErrors; const AStream: TPCTokenStream);
var
  LLexer: TPCLexer;
begin
  LLexer := TPCLexer.Create();
  try
    LLexer.SetErrors(AErrors);
    LLexer.TokenizeFile(TPath.Combine(DoLexDir(), AName), AStream);
  finally
    LLexer.Free();
  end;
end;

procedure DoLexBytes(const AText: string; const AErrors: TErrors; const AStream: TPCTokenStream);
var
  LLexer: TPCLexer;
begin
  // Lex literal text (no fixture file), for inputs a text editor cannot pin
  // down, such as exact CR LF bytes
  LLexer := TPCLexer.Create();
  try
    LLexer.SetErrors(AErrors);
    LLexer.TokenizeBytes(TEncoding.UTF8.GetBytes(AText), 'inline.pcpp', AStream);
  finally
    LLexer.Free();
  end;
end;

function DoLexPath(const APath: string; const AErrors: TErrors;
  const AStream: TPCTokenStream): Boolean;
var
  LLexer: TPCLexer;
begin
  // TokenizeFile on a path given as is (no TPath.Combine: the path may
  // hold characters Combine itself rejects)
  LLexer := TPCLexer.Create();
  try
    LLexer.SetErrors(AErrors);
    Result := LLexer.TokenizeFile(APath, AStream);
  finally
    LLexer.Free();
  end;
end;

function DoHasCode(const AErrors: TErrors; const ACode: string): Boolean;
var
  LError: TError;
begin
  Result := False;
  for LError in AErrors.GetItems() do
  begin
    if LError.Code = ACode then
      Exit(True);
  end;
end;

function DoTextsMatch(const AStream: TPCTokenStream; const AExpected: array of string): Boolean;
var
  LI: Integer;
begin
  // Every token but the final EOF, in order; CR is stripped (CRLF fixtures)
  Result := AStream.Count() - 1 = Length(AExpected);
  if not Result then
    Exit;
  for LI := 0 to High(AExpected) do
  begin
    if AStream.TokenAt(LI).Text.Replace(#13, '') <> AExpected[LI] then
      Exit(False);
  end;
end;

function DoSpellingsMatch(const AStream: TPCTokenStream; const AExpected: array of string): Boolean;
var
  LI: Integer;
begin
  // Every token but the final EOF, in order; exact Spelling, nothing
  // stripped (a lone CR leaking into a token must fail)
  Result := AStream.Count() - 1 = Length(AExpected);
  if not Result then
    Exit;
  for LI := 0 to High(AExpected) do
  begin
    if AStream.TokenAt(LI).Spelling <> AExpected[LI] then
      Exit(False);
  end;
end;

function DoCountCode(const AErrors: TErrors; const ACode: string): Integer;
var
  LError: TError;
begin
  // Exact count of one diagnostic code (any severity)
  Result := 0;
  for LError in AErrors.GetItems() do
  begin
    if LError.Code = ACode then
      Inc(Result);
  end;
end;

function DoErrorAt(const AErrors: TErrors; const ACode: string; const ALine: UInt64;
  const AColumn: UInt64): Boolean;
var
  LError: TError;
begin
  // Some diagnostic with that code starts at that line:column
  Result := False;
  for LError in AErrors.GetItems() do
  begin
    if (LError.Code = ACode) and (LError.Range.StartLine = ALine) and
      (LError.Range.StartColumn = AColumn) then
      Exit(True);
  end;
end;

procedure DoCheckLexed(const AText: string; const ACheck: TPCLexCheck);
var
  LErrors: TErrors;
  LStream: TPCTokenStream;
begin
  // Lex literal text with a fresh budget and stream, then run the checks
  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    DoLexBytes(AText, LErrors, LStream);
    ACheck(LErrors, LStream);
  finally
    LStream.Free();
    LErrors.Free();
  end;
end;

function DoKindOf(const AText: string): TPCTokenKind;
var
  LErrors: TErrors;
  LStream: TPCTokenStream;
begin
  // The kind of the first token of a plain lex of AText, so tests compare
  // kinds without naming them
  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  try
    LErrors.SetMaxErrors(100);
    DoLexBytes(AText, LErrors, LStream);
    Result := LStream.TokenAt(0).Kind;
  finally
    LStream.Free();
    LErrors.Free();
  end;
end;

function DoLineList(const ALines: TArray<UInt64>): string;
var
  LLine: UInt64;
begin
  // '2,4': the lines in order, for one comparison
  Result := '';
  for LLine in ALines do
  begin
    if Result <> '' then
      Result := Result + ',';
    Result := Result + UIntToStr(LLine);
  end;
end;

function DoBlockElements(const AStream: TPCTokenStream): TArray<TPCCppElement>;
var
  LI: Integer;
  LToken: TPCToken;
begin
  // The C++ elements of the FIRST cppstart block in AStream (nil: none)
  Result := nil;
  for LI := 0 to AStream.Count() - 1 do
  begin
    LToken := AStream.TokenAt(LI);
    if LToken.Kind = tkRawBlock then
      Exit(AStream.CppElementsIn(Int64(LToken.Range.StartByteOffset),
        Int64(LToken.Range.EndByteOffset)));
  end;
end;

function DoElementsText(const AElements: TArray<TPCCppElement>): string;
var
  LElement: TPCCppElement;
begin
  // 'w:x@1:17 p:+=@1:19': kind tag, splice-free spelling ('' for a literal),
  // start line:column, space separated, for one comparison
  Result := '';
  for LElement in AElements do
  begin
    if Result <> '' then
      Result := Result + ' ';
    Result := Result + TEST_CPP_ELEMENT_TAGS[LElement.Kind] + ':' + LElement.Spelling + '@' +
      UIntToStr(LElement.Range.StartLine) + ':' + UIntToStr(LElement.Range.StartColumn);
  end;
end;

type
  { TPCIntBoundRow }
  // One row of tests\probe\lex\ib\ib_rows.txt (GENERATED by
  // scripts\zb_cmpl\f19\gen_bounds.py from C++23 [lex.icon], never from the lexer)
  TPCIntBoundRow = record
    Line: Integer;        // the literal's line in ib_bounds.cpp
    Literal: string;      // digits + suffix, as written
    Value: string;        // its decimal value; '-' above uint64
    Expect: string;       // ok | signed | overflow
    Suggest: string;      // the spelling the signed report proposes; else '-'
  end;

const
  { TEST_IB_DIR }
  TEST_IB_DIR = 'ib';
  { TEST_IB_ROWS }
  TEST_IB_ROWS = 'ib_rows.txt';
  { TEST_IB_SOURCE }
  TEST_IB_SOURCE = 'ib_bounds.cpp';
  { TEST_IB_ROW_COUNT }
  // 4 bases x 4 boundary values x 33 suffixes + 2 rows with digit separators
  TEST_IB_ROW_COUNT = 530;
  { TEST_IB_REPORTED_COUNT }
  // The rows that are not ok: 15 signed + 132 overflow
  TEST_IB_REPORTED_COUNT = 147;

function DoIntBoundRows(out ARows: TArray<TPCIntBoundRow>): Boolean;
var
  LLines: TArray<string>;
  LLine: string;
  LParts: TArray<string>;
  LRow: TPCIntBoundRow;
  LCount: Integer;
begin
  // The generated table; a line starting with '#' is its header
  Result := False;
  ARows := nil;
  try
    LLines := TFile.ReadAllLines(TPath.Combine(TPath.Combine(DoLexDir(), TEST_IB_DIR), TEST_IB_ROWS),
      TEncoding.UTF8);
  except
    // Unreadable: False, the caller's Check reports it
    Exit;
  end;
  SetLength(ARows, Length(LLines));
  LCount := 0;
  for LLine in LLines do
  begin
    if (LLine = '') or LLine.StartsWith('#') then
      Continue;
    LParts := LLine.Split([#9]);
    if (Length(LParts) <> 5) or (not TryStrToInt(LParts[0], LRow.Line)) then
      Exit;
    LRow.Literal := LParts[1];
    LRow.Value := LParts[2];
    LRow.Expect := LParts[3];
    LRow.Suggest := LParts[4];
    ARows[LCount] := LRow;
    Inc(LCount);
  end;
  SetLength(ARows, LCount);
  Result := True;
end;

function DoErrorCount(const AErrors: TErrors): Integer;
var
  LError: TError;
begin
  // Errors and fatals only (an octal literal also gets the LX hint)
  Result := 0;
  for LError in AErrors.GetItems() do
  begin
    if LError.Severity in [esError, esFatal] then
      Inc(Result);
  end;
end;

