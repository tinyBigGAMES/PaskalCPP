function DoCjDir(): string;
begin
  // The exe sits two levels below the project root (repo\bin)
  Result := TPath.GetFullPath(TPath.Combine(
    TPath.GetDirectoryName(ParamStr(0)), '..\..\tests\probe\par\jumps'));
end;

function DoJumpsText(const AJumps: TArray<TPCCppJump>): string;
var
  LJump: TPCCppJump;
begin
  // 'return@2:3 break@2:9': kind word, start line:column, space-separated,
  // in Find's order (source order); the AST dump's jumps=[...] spelling
  Result := '';
  for LJump in AJumps do
  begin
    if Result <> '' then
      Result := Result + ' ';
    Result := Result + TEST_CJ_KIND_TEXT[LJump.Kind] + '@' +
      UIntToStr(LJump.Range.StartLine) + ':' + UIntToStr(LJump.Range.StartColumn);
  end;
end;

function DoBlockJumps(const AStream: TPCTokenStream): TArray<TPCCppJump>;
var
  LI: Integer;
  LToken: TPCToken;
begin
  // The escaping jumps of the FIRST cppstart block in AStream (nil: none),
  // from its elements exactly as the parser passes them (DoParseCppBlock)
  Result := nil;
  for LI := 0 to AStream.Count() - 1 do
  begin
    LToken := AStream.TokenAt(LI);
    if LToken.Kind = tkRawBlock then
      Exit(TPCCppJumpFinder.Find(AStream.CppElementsIn(Int64(LToken.Range.StartByteOffset),
        Int64(LToken.Range.EndByteOffset))));
  end;
end;

function DoJumpsOf(const ABytes: TBytes; out AErrorCount: Integer): TArray<TPCCppJump>;
var
  LErrors: TErrors;
  LStream: TPCTokenStream;
  LLexer: TPCLexer;
begin
  // Lexes ABytes with the real lexer and walks its first cppstart block
  LErrors := TErrors.Create();
  LStream := TPCTokenStream.Create();
  LLexer := TPCLexer.Create();
  try
    LLexer.SetErrors(LErrors);
    LLexer.TokenizeBytes(ABytes, 'inline.pcpp', LStream);
    AErrorCount := LErrors.ErrorCount();
    Result := DoBlockJumps(LStream);
  finally
    LLexer.Free();
    LStream.Free();
    LErrors.Free();
  end;
end;

function DoRepeated(const AText: string; const ACount: Integer): string;
var
  LBuilder: TStringBuilder;
  LI: Integer;
begin
  // AText ACount times (the deep cases)
  LBuilder := TStringBuilder.Create();
  try
    for LI := 1 to ACount do
      LBuilder.Append(AText);
    Result := LBuilder.ToString();
  finally
    LBuilder.Free();
  end;
end;

{ TPCCppJumpsTests }

constructor TPCCppJumpsTests.Create();
begin
  inherited;

  Title := 'CppJumps';
  RegisterTest('probe_cases', DoTestProbeCases);
  RegisterTest('text_cases', DoTestTextCases);
  RegisterTest('deep', DoTestDeep);
  RegisterTest('empty', DoTestEmpty);
end;

procedure TPCCppJumpsTests.Run();
begin
  inherited;
end;

procedure TPCCppJumpsTests.DoTextCase(const ALabel: string; const ABody: string;
  const AJumps: string);
var
  LErrorCount: Integer;
  LText: string;
begin
  LText := DoJumpsText(DoJumpsOf(TEncoding.UTF8.GetBytes('cppstart source ' + ABody +
    ' cppend;'), LErrorCount));
  Check((LErrorCount = 0) and (LText = AJumps), '%s: %d errors, jumps [%s]',
    [ALabel, LErrorCount, LText]);
end;

procedure TPCCppJumpsTests.DoTestProbeCases();
var
  LCase: TPCCjCase;
  LPath: string;
  LErrorCount: Integer;
  LText: string;
begin
  // jump_probe.py's bodies, expected = its hand markers (clang agreed on
  // x86_64-windows-gnu and x86_64-linux-gnu, prereq-b\jump.md)
  for LCase in TEST_CJ_FIXTURES do
  begin
    LPath := TPath.Combine(DoCjDir(), LCase.FileName);
    if not TFile.Exists(LPath) then
    begin
      Check(False, '%s: fixture missing', [LCase.FileName]);
      Continue;
    end;
    LText := DoJumpsText(DoJumpsOf(TFile.ReadAllBytes(LPath), LErrorCount));
    Check((LErrorCount = 0) and (LText = LCase.Jumps), '%s: %d errors, jumps [%s]',
      [LCase.FileName, LErrorCount, LText]);
  end;
end;

procedure TPCCppJumpsTests.DoTestTextCases();
begin
  // Printed by scripts\zb_sem\pb\gen_jumps.py (expected = the reference walker).
  // The shapes walked on paper for the iterative walker (D-J6)
  DoTextCase('do while then return', 'do { if (x) break; } while (c); return;', 'return@1:49');
  DoTextCase('else chain', 'if (a) break; else if (b) continue; else return;', 'break@1:24 continue@1:43 return@1:58');
  DoTextCase('statement expression', 'x = ({ if (c) return 1; 2; });', 'return@1:31');
  DoTextCase('lambda in for init', 'for (auto f = [&]{ return 1; }; f(); ) break;', '');
  DoTextCase('local struct', 'struct L { int f() { return 0; } };', '');
  DoTextCase('switch case default', 'switch (x) { case 1: break; default: continue; }', 'continue@1:54');
  DoTextCase('stray closers', '} ) return;', 'return@1:21');
  // F-L3: digraph braces are braces (punctuators compared by kind)
  DoTextCase('digraph braces', '<% break; %>', 'break@1:20');
  // Broken blocks (clang's to report): the walk ends, nothing is reported
  DoTextCase('unclosed brace', '{ break;', 'break@1:19');
  DoTextCase('unclosed paren', 'g( return;', '');
  DoTextCase('unclosed bracket', '[ break; return;', '');
  DoTextCase('for paren at the end', 'continue; for (', 'continue@1:17');
  DoTextCase('lone case', 'case', '');
  DoTextCase('return then closers', 'return; } } } break;', 'return@1:17 break@1:31');
end;

procedure TPCCppJumpsTests.DoTestDeep();
begin
  // The walk keeps its frames on the heap (D-J5): depths clang accepts
  // (20000 brace-less ifs, 2048 brackets: steps-cppjumps.md probe) never
  // overflow the stack. 'cppstart source ' is 16 bytes, 'if (g) ' 7, '{ ' 2
  DoTextCase('5000 brace-less ifs', DoRepeated('if (g) ', 5000) + 'break;',
    Format('break@1:%d', [17 + (7 * 5000)]));
  DoTextCase('2000 nested braces', DoRepeated('{ ', 2000) + 'return; ' + DoRepeated('} ', 2000),
    Format('return@1:%d', [17 + (2 * 2000)]));
  DoTextCase('20000 brace-less ifs', DoRepeated('if (g) ', 20000) + 'return;',
    Format('return@1:%d', [17 + (7 * 20000)]));
end;

procedure TPCCppJumpsTests.DoTestEmpty();
begin
  Check(Length(TPCCppJumpFinder.Find(nil)) = 0, 'no elements: no jumps');
  DoTextCase('empty block', '', '');
end;

end.