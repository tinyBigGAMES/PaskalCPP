-------------------------------------------------------------------------------
  UTestCase.CppJumps - cppstart block escaping-jump finder tests

  TTestCase suite for TPCCppJumpFinder (PaskalCPP.CppJumps): which C++
  return / break / continue of a cppstart block leaves the block (O-S6b,
  research\cppmix\sem\prereq-b\jump.md). Every block is lexed by the real
  TPCLexer and the finder walks the block's C++ elements (CppElementsIn).
  The fixtures in tests\probe\par\jumps are jump_probe.py's 55 bodies with
  the probe's hand-marked jumps (clang agreed on both targets), written by
  scripts\zb_sem\pb\gen_jumps.py (never an editor), which also prints the
  table below and the text cases. Deep cases are built in the test: the
  walk keeps its frames on the heap.

  Dependencies: StdApp.TestCase, StdApp.Base, PaskalCPP.Common,
    PaskalCPP.TokenStream, PaskalCPP.Lexer, PaskalCPP.CppJumps
===============================================================================}

unit UTestCase.CppJumps;

interface

uses
  StdApp.TestCase;

type

  { TPCCppJumpsTests }
  TPCCppJumpsTests = class(TTestCase)
  private
    // One test per concern; Create registers each under its CLI name
    procedure DoTestProbeCases();
    procedure DoTestTextCases();
    procedure DoTestDeep();
    procedure DoTestEmpty();

    // Lexes 'cppstart source ' + ABody + ' cppend;' and checks its jumps
    // text (DoJumpsText) and that the lexer reported no error
    procedure DoTextCase(const ALabel: string; const ABody: string; const AJumps: string);
  protected
    procedure Run(); override;
  public
    constructor Create(); override;
  end;

implementation

uses
  System.SysUtils,
  System.IOUtils,
  StdApp.Base,
  PaskalCPP.Common,
  PaskalCPP.TokenStream,
  PaskalCPP.Lexer,
  PaskalCPP.CppJumps;

type

  { TPCCjCase }
  // One fixture and the jumps it must give ('kind@line:col', space-separated)
  TPCCjCase = record
    FileName: string;
    Jumps: string;
  end;

