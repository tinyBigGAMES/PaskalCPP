    (FileName: 'cj02_brk.pcpp'; Jumps: 'break@2:3'),
    (FileName: 'cj03_cont.pcpp'; Jumps: 'continue@2:3'),
    (FileName: 'cj04_for_brk.pcpp'; Jumps: ''),
    (FileName: 'cj05_for_cont.pcpp'; Jumps: ''),
    (FileName: 'cj06_while_block.pcpp'; Jumps: ''),
    (FileName: 'cj07_do_cont.pcpp'; Jumps: ''),
    (FileName: 'cj08_do_brace_less.pcpp'; Jumps: ''),
    (FileName: 'cj09_switch_brk.pcpp'; Jumps: ''),
    (FileName: 'cj10_switch_cont.pcpp'; Jumps: 'continue@2:24'),
    (FileName: 'cj11_range_for_if_else.pcpp'; Jumps: ''),
    (FileName: 'cj12_brace_less_if_else.pcpp'; Jumps: ''),
    (FileName: 'cj13_nested_brace_less.pcpp'; Jumps: 'break@2:28'),
