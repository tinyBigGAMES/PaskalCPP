    (FileName: 'cj18_lambda_template.pcpp'; Jumps: ''),
    (FileName: 'cj19_lambda_init_capture.pcpp'; Jumps: 'return@2:46'),
    (FileName: 'cj20_lambda_requires.pcpp'; Jumps: ''),
    (FileName: 'cj21_lambda_stmt_expr.pcpp'; Jumps: ''),
    (FileName: 'cj22_lambda_in_call.pcpp'; Jumps: 'return@2:27'),
    (FileName: 'cj23_lambda_in_cond.pcpp'; Jumps: ''),
    (FileName: 'cj24_lambda_in_for_cond.pcpp'; Jumps: ''),
    (FileName: 'cj25_attr_likely.pcpp'; Jumps: 'return@2:51'),
    (FileName: 'cj26_local_class.pcpp'; Jumps: ''),
    (FileName: 'cj27_local_class_base.pcpp'; Jumps: ''),
    (FileName: 'cj28_local_class_var.pcpp'; Jumps: ''),
