class function TPCUnicodeNames.DoLookupTable(const ACharName: string;
  out ACodePoint: Cardinal): Boolean;
var
  LLow: Integer;
  LHigh: Integer;
  LMid: Integer;
  LCompare: Integer;
begin
  Result := False;
  ACodePoint := 0;
  LLow := Low(PC_UNICODE_NAME_TABLE);
  LHigh := High(PC_UNICODE_NAME_TABLE);
  while LLow <= LHigh do
  begin
    LMid := LLow + ((LHigh - LLow) div 2);
    LCompare := CompareStr(PC_UNICODE_NAME_TABLE[LMid].CharName, ACharName);
    if LCompare = 0 then
    begin
      ACodePoint := PC_UNICODE_NAME_TABLE[LMid].CodePoint;
      Exit(True);
    end;
    if LCompare < 0 then
      LLow := LMid + 1
    else
      LHigh := LMid - 1;
  end;
end;

class function TPCUnicodeNames.DoParseHex(const AText: string; const AStart: Integer;
  out AValue: Cardinal): Boolean;
var
  LIndex: Integer;
  LChar: Char;
  LDigit: Cardinal;
begin
  Result := False;
  AValue := 0;

  // At least one digit (clang: an empty hex part is not a name)
  if AStart > Length(AText) then
    Exit;

  for LIndex := AStart to Length(AText) do
  begin
    LChar := AText[LIndex];
    // Uppercase hex only, as clang matches it
    if (LChar >= '0') and (LChar <= '9') then
      LDigit := Ord(LChar) - Ord('0')
    else if (LChar >= 'A') and (LChar <= 'F') then
      LDigit := Ord(LChar) - Ord('A') + 10
    else
      Exit;
    AValue := (AValue * 16) + LDigit;
    // Overflow guard: leading zeros keep the value small, but a value past
    // $10FFFF can never land in a range (clang never wraps, probed)
    if AValue > $10FFFF then
      Exit;
  end;

  Result := True;
end;

class function TPCUnicodeNames.DoLookupRanges(const ACharName: string;
  out ACodePoint: Cardinal): Boolean;
var
  LIndex: Integer;
  LValue: Cardinal;
begin
  Result := False;
  ACodePoint := 0;
  for LIndex := Low(PC_UNICODE_RANGES) to High(PC_UNICODE_RANGES) do
  begin
    // StartsWith without IgnoreCase is case-sensitive
    if not ACharName.StartsWith(PC_UNICODE_RANGES[LIndex].Prefix) then
      Continue;
    if not DoParseHex(ACharName, Length(PC_UNICODE_RANGES[LIndex].Prefix) + 1, LValue) then
      Continue;
    if (LValue >= PC_UNICODE_RANGES[LIndex].FirstCode) and
      (LValue <= PC_UNICODE_RANGES[LIndex].LastCode) then
    begin
      ACodePoint := LValue;
      Exit(True);
    end;
  end;
end;

class function TPCUnicodeNames.DoLookupHangul(const ACharName: string;
  out ACodePoint: Cardinal): Boolean;
var
  LSIndex: Integer;
  LLIndex: Integer;
  LVIndex: Integer;
  LTIndex: Integer;
  LCandidate: string;
begin
  Result := False;
  ACodePoint := 0;
  if not ACharName.StartsWith(PC_HANGUL_PREFIX) then
    Exit;

  // Unicode ch. 3.12: S = LIndex * NCount + VIndex * TCount + TIndex. The
  // short names are not prefix-free, so every syllable name is built and
  // compared instead of parsing the jamo greedily.
  for LSIndex := 0 to PC_HANGUL_COUNT - 1 do
  begin
    LLIndex := LSIndex div PC_HANGUL_NCOUNT;
    LVIndex := (LSIndex mod PC_HANGUL_NCOUNT) div PC_HANGUL_TCOUNT;
    LTIndex := LSIndex mod PC_HANGUL_TCOUNT;
    LCandidate := PC_HANGUL_PREFIX + PC_HANGUL_L[LLIndex] + PC_HANGUL_V[LVIndex] +
      PC_HANGUL_T[LTIndex];
    if LCandidate = ACharName then
    begin
      ACodePoint := Cardinal(PC_HANGUL_BASE + LSIndex);
      Exit(True);
    end;
  end;
end;

class function TPCUnicodeNames.Lookup(const ACharName: string;
  out ACodePoint: Cardinal): Boolean;
begin
  if DoLookupTable(ACharName, ACodePoint) then
    Exit(True);
  if DoLookupRanges(ACharName, ACodePoint) then
    Exit(True);
  Result := DoLookupHangul(ACharName, ACodePoint);
end;

end.
