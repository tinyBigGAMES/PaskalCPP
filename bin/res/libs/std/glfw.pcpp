-------------------------------------------------------------------------------
  glfw.pcpp - the GLFW unit: `import glfw;` uses GLFW (windows, OpenGL
  contexts, input) from PaskalCPP. A self-describing vendor module: it owns
  every include path, library path and link library it needs, per official
  target.
==============================================================================*/

module unit glfw;

// Self-describing vendor module: it owns every path it needs.

@addincludepath "$P:res/libs/vendor/glfw/include";

// GLFW's own link list (its glfw3.pc), plus OpenGL itself: glfw3.h includes
// GL/gl.h, so a program calls GL directly on every target. Windows has the
// header from mingw; Linux takes it, and libGL.so, from vendor/linux64.
@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/glfw/lib/x86_64-windows-gnu";
  @linklibrary "opengl32";
  @linklibrary "gdi32";
@elseif TARGET_X86_64_LINUX_GNU
  @addincludepath "$P:res/libs/vendor/linux64/include";
  @addlibrarypath "$P:res/libs/vendor/linux64/lib";
  @addlibrarypath "$P:res/libs/vendor/glfw/lib/x86_64-linux-gnu";
  @linklibrary "GL";
  @linklibrary "m";
  @linklibrary "pthread";
  @linklibrary "dl";
  @linklibrary "rt";
@else
  @message error "glfw_import: unsupported target";
@endif

@linklibrary "glfw3";

// The header goes to this unit's header, so every importer sees GLFW's API
cpp header;

#include <GLFW/glfw3.h>

end.
