-------------------------------------------------------------------------------
  stb_perlin.pcpp - the stb_perlin unit (stb, header-only): `import
  stb_perlin;` uses Perlin noise (2D / 3D, fractal, ridge, turbulence) from
  PaskalCPP. A self-describing vendor module: it owns every path it needs. The
  implementation is a static library of its own, libstb_perlin.a (one per
  target, built from its C source by PaskalCPP-Libs' build-stb.cmd), linked by
  @linklibrary: every module of the program shares the one copy, and a program
  links only the libraries it imports.

  Not yet usable together with raylib in one program: raylib carries its own
  public copy of stb_perlin, and stb_perlin has no switch to make a copy
  private (stb_perlin.h:80-85), so the link reports duplicate symbols. Use it
  on its own.
==============================================================================*/

module unit stb_perlin;

@addincludepath "$P:res/libs/vendor/stb/include";

// The library of each target
@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/stb/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/stb/lib/x86_64-linux-gnu";
@else
  @message error "stb_perlin: unsupported target";
@endif

@linklibrary "stb_perlin";

// The declarations go to this unit's header, so every importer sees the API
cpp header;

#include <stb_perlin.h>

end.
