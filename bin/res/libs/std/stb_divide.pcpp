-------------------------------------------------------------------------------
  stb_divide.pcpp - the stb_divide unit (stb, header-only): `import
  stb_divide;` uses integer division and modulus with defined rounding (floor,
  euclidean) from PaskalCPP. A self-describing vendor module: it owns every
  path it needs. The implementation is a static library of its own,
  libstb_divide.a (one per target, built from its C source by PaskalCPP-Libs'
  build-stb.cmd), linked by @linklibrary: every module of the program shares
  the one copy, and a program links only the libraries it imports.
==============================================================================*/

module unit stb_divide;

@addincludepath "$P:res/libs/vendor/stb/include";

// The library of each target
@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/stb/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/stb/lib/x86_64-linux-gnu";
@else
  @message error "stb_divide: unsupported target";
@endif

@linklibrary "stb_divide";

// The declarations go to this unit's header, so every importer sees the API
cpp header;

#include <stb_divide.h>

end.
