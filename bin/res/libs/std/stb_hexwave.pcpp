-------------------------------------------------------------------------------
  stb_hexwave.pcpp - the stb_hexwave unit (stb, header-only): `import
  stb_hexwave;` uses band-limited audio waveform synthesis from PaskalCPP. A
  self-describing vendor module: it owns every path it needs. The
  implementation is a static library of its own, libstb_hexwave.a (one per
  target, built from its C source by PaskalCPP-Libs' build-stb.cmd), linked by
  @linklibrary: every module of the program shares the one copy, and a program
  links only the libraries it imports.
==============================================================================*/

module unit stb_hexwave;

@addincludepath "$P:res/libs/vendor/stb/include";

// The library of each target; Windows needs only mingw's CRT (linked by
// default), Linux also links m.
@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/stb/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/stb/lib/x86_64-linux-gnu";
  @linklibrary "m";
@else
  @message error "stb_hexwave: unsupported target";
@endif

@linklibrary "stb_hexwave";

// The declarations go to this unit's header, so every importer sees the API
cpp header;

// The header declares no extern "C" for C++, and its implementation is C:
// the #include goes inside extern "C" (a C++ block: BNF sec 10)
cppstart header
extern "C" {
#include <stb_hexwave.h>
}
cppend;

end.
