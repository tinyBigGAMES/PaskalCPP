  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  minizip.pcpp - the minizip unit: `import minizip;` reads and writes .zip
  archives from PaskalCPP (zip.h: zipOpen64 / zipOpenNewFileInZip3_64 ...,
  unzip.h: unzOpen64 / unzOpenCurrentFilePassword ...), with the
  traditional PKWARE password encryption. Built on zlib, which it imports.
  Paths: zipOpen64 / unzOpen64 read a path in the ANSI code page on Windows;
  for a UTF-8 path (a PaskalCPP string) on every target open with
  zipOpen2_64 / unzOpen2_64 and the set fill_utf8_filefunc64 fills
  (ioutf8.h, PaskalCPP-Libs' addition: Windows through minizip's iowin32).
  A self-describing vendor module: it owns every include path, library
  path and link library it needs, per official target.
==============================================================================*/

module unit minizip;

// Self-describing vendor module: it owns every path it needs.

@addincludepath "$P:res/libs/vendor/minizip/include";

@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/minizip/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/minizip/lib/x86_64-linux-gnu";
@else
  @message error "minizip_import: unsupported target";
@endif

// minizip_utf8: PaskalCPP-Libs' ioutf8.h set (UTF-8 paths on every target)
@linklibrary "minizip_utf8";
@linklibrary "minizip";

// minizip's CMake gives its users _LARGEFILE64_SOURCE=1 on both targets and
// no USE_FILE32API (minizip-static.cmake INTERFACE_COMPILE_DEFINITIONS).
@cppdefine "_LARGEFILE64_SOURCE" "1";

// zip.h and unzip.h include zlib.h: zlib's include path, library and define
import zlib;

// The headers go to this unit's header, so every importer sees minizip's API
cpp header;

// ioapi.h defines glibc's internal __USE_FILE_OFFSET64 / __USE_LARGEFILE64
// when they are not set, after libc's headers were read; left set, a glibc
// header an importer reads later takes the 64-bit names (stat -> stat64).
// Each one ioapi.h defined is undefined again after minizip's headers.
#if !defined(__USE_FILE_OFFSET64)
#define PCPP_MINIZIP_UNDEF_FILE_OFFSET64
#endif
#if !defined(__USE_LARGEFILE64)
#define PCPP_MINIZIP_UNDEF_LARGEFILE64
#endif
#include "zip.h"
#include "unzip.h"
#include "ioutf8.h"
#if defined(PCPP_MINIZIP_UNDEF_FILE_OFFSET64)
#undef __USE_FILE_OFFSET64
#undef PCPP_MINIZIP_UNDEF_FILE_OFFSET64
#endif
#if defined(PCPP_MINIZIP_UNDEF_LARGEFILE64)
#undef __USE_LARGEFILE64
#undef PCPP_MINIZIP_UNDEF_LARGEFILE64
#endif

end.
