-------------------------------------------------------------------------------
  minizip.pcpp - the minizip unit: `import minizip;` reads and writes .zip
  archives from PaskalCPP (zip.h: zipOpen64 / zipOpenNewFileInZip3_64 ...,
  unzip.h: unzOpen64 / unzOpenCurrentFilePassword ...), with the
  traditional PKWARE password encryption. Built on zlib, which it imports.
  A self-describing vendor module: it owns every include path, library
  path and link library it needs, per official target.
==============================================================================*/

module unit minizip;

// Self-describing vendor module: it owns every path it needs.

@addincludepath "$P:res/libs/vendor/minizip/include";

@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/minizip/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/minizip/lib/x86_64-linux-gnu";
@else
  @message error "minizip_import: unsupported target";
@endif

@linklibrary "minizip";

// minizip's CMake gives its users _LARGEFILE64_SOURCE=1 on both targets and
// no USE_FILE32API (minizip-static.cmake INTERFACE_COMPILE_DEFINITIONS).
@cppdefine "_LARGEFILE64_SOURCE" "1";

// zip.h and unzip.h include zlib.h: zlib's include path, library and define
import zlib;

// The headers go to this unit's header, so every importer sees minizip's API
cpp header;

#include "zip.h"
#include "unzip.h"

end.
