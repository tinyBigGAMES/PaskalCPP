-------------------------------------------------------------------------------
  zlib.pcpp - the zlib unit: `import zlib;` uses zlib (deflate / inflate,
  compress / uncompress, gzip files) from PaskalCPP. A self-describing
  vendor module: it owns every include path, library path and link
  library it needs, per official target.
==============================================================================*/

module unit zlib;

// Self-describing vendor module: it owns every path it needs.

@addincludepath "$P:res/libs/vendor/zlib/include";

@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/zlib/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/zlib/lib/x86_64-linux-gnu";
@else
  @message error "zlib_import: unsupported target";
@endif

@linklibrary "z";

// zlib's CMake gives its users _LARGEFILE64_SOURCE=1 on both targets
// (ZLIB-static.cmake INTERFACE_COMPILE_DEFINITIONS): the 64-bit gz* names.
@cppdefine "_LARGEFILE64_SOURCE" "1";

// The header goes to this unit's header, so every importer sees zlib's API
cpp header;

#include "zlib.h"

end.
