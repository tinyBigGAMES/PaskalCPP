// glibc's underflow and overflow: what the inline getc_unlocked /
// putc_unlocked call once the FILE's get / put area is used up, and a HookIO
// handle's areas are always empty (HookIODoGlibcHead), so every inline read
// and write of one lands here. __uflow is getc on the handle. __overflow
// puts AChar; with EOF it writes out what is pending, as glibc's
// _IO_new_file_overflow does (0, or EOF on a failure).
extern "C" int __uflow(FILE* AFile)
{
  using TReal = int (*)(FILE*);
  int LResult;

  if (HookIODoGetc(AFile, LResult))
    return LResult;
  HOOKIO_DO_REAL(TReal, "__uflow");
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return EOF;
  }
  return LReal(AFile);
}

extern "C" int __overflow(FILE* AFile, int AChar)
{
  using TReal = int (*)(FILE*, int);
  int LResult;

  if (AChar == EOF)
  {
    if (HookIODoFlush(AFile, LResult))
      return LResult;
  }
  else if (HookIODoPutc(AChar, AFile, LResult))
    return LResult;
  HOOKIO_DO_REAL(TReal, "__overflow");
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return EOF;
  }
  return LReal(AFile, AChar);
}

// The stream lock glibc's *_unlocked callers take around their reads
// (lua's loader). A HookIO handle takes its own lock in every call (as
// _lock_file on Windows), so locking one is nothing and trying always
// succeeds (0); a real FILE goes to glibc.
extern "C" void flockfile(FILE* AFile)
{
  using TReal = void (*)(FILE*);

  if (HookIODoOwns(AFile))
    return;
  HOOKIO_DO_REAL(TReal, "flockfile");
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return;
  }
  LReal(AFile);
}

