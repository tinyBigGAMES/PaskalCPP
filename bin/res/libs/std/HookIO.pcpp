type
  FopenSFn = routine clink(const AFile: ptr to ptr to FILE; const APath: ptr to const char; const AMode: ptr to const char): int32;
  WfopenFn = routine clink(const APath: ptr to const wchar_t; const AMode: ptr to const wchar_t): ptr to FILE;

var
  GRealFopenS: ptr;
  GRealWfopen: ptr;

// The headers declare these dllimport: own definitions + own import slots,
// inside the scoped pragma pair
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Winconsistent-dllimport"

routine clink fopen_s(const AFile: ptr to ptr to FILE; const APath: ptr to const char; const AMode: ptr to const char): int32;
var
  LFile: ptr to FILE;
  LReal: FopenSFn;
begin
  // fopen_s's contract: the stream in AFile^, 0 or the error code returned.
  // A nil AFile is the real function's to refuse.
  if (AFile <> nil) and HookIODoOpen(APath, AMode, LFile) then
    AFile^ := LFile;
    if LFile = nil then
      return errno;
    end;
    return 0;
  end;
  LReal := reinterpret_cast<FopenSFn>(HookReal(GRealFopenS, "fopen_s"));
  if LReal = nil then
    if AFile <> nil then
      AFile^ := nil;
    end;
    errno := ENOSYS;
    return ENOSYS;
  end;
  return LReal(AFile, APath, AMode);
end;
HOOKABI_IMPORT_SLOT(fopen_s);

routine clink _wfopen(const APath: ptr to const wchar_t; const AMode: ptr to const wchar_t): ptr to FILE;
var
  LFile: ptr to FILE;
  LReal: WfopenFn;
begin
  if HookIODoOpenWide(APath, AMode, LFile) then
    return LFile;
  end;
  LReal := reinterpret_cast<WfopenFn>(HookReal(GRealWfopen, "_wfopen"));
  if LReal = nil then
    errno := ENOSYS;
    return nil;
  end;
  return LReal(APath, AMode);
end;
HOOKABI_IMPORT_SLOT(_wfopen);

// The stream names only ucrt has. fileno, fseeko64 and ftello64 are the
// import library's aliases of _fileno, _fseeki64 and _ftelli64: each name is
// hooked, the real function is the underscore one.
