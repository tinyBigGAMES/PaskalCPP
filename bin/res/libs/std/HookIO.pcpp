type
  FopenFn = routine clink(const APath: ptr to const char; const AMode: ptr to const char): ptr to FILE;
  FcloseFn = routine clink(const AFile: ptr to FILE): int32;

var
  // Each hook's slot for its real function (HookReal fills it once)
  GRealFopen: ptr;
  GRealFclose: ptr;

// The hooks: the C runtime's names and signatures, C linkage. A virtual path
// or a HookIO handle is answered here; anything else goes to the real
// function. With no real function (HookReal gives nil) a hook fails the call
// as the function fails (errno ENOSYS), never calls nil.
routine clink fopen(const APath: ptr to const char; const AMode: ptr to const char): ptr to FILE;
var
  LFile: ptr to FILE;
  LReal: FopenFn;
begin
  if HookIODoOpen(APath, AMode, LFile) then
    return LFile;
  end;
  LReal := reinterpret_cast<FopenFn>(HookReal(GRealFopen, "fopen"));
  if LReal = nil then
    errno := ENOSYS;
    return nil;
  end;
  return LReal(APath, AMode);
end;
HOOKABI_IMPORT_SLOT(fopen);

routine clink fclose(const AFile: ptr to FILE): int32;
var
  LResult: int32;
  LReal: FcloseFn;
begin
  if HookIODoClose(AFile, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<FcloseFn>(HookReal(GRealFclose, "fclose"));
  if LReal = nil then
    errno := ENOSYS;
    return EOF;
  end;
  return LReal(AFile);
end;
HOOKABI_IMPORT_SLOT(fclose);

type
  FreopenFn = routine clink(const APath: ptr to const char; const AMode: ptr to const char;
    const AFile: ptr to FILE): ptr to FILE;

var
  GRealFreopen: ptr;

// A HookIO handle is reopened in place (HookIODoReopen); a real FILE goes to
// the C runtime, whatever the path
routine clink freopen(const APath: ptr to const char; const AMode: ptr to const char;
  const AFile: ptr to FILE): ptr to FILE;
var
  LFile: ptr to FILE;
  LReal: FreopenFn;
begin
  if HookIODoReopen(APath, AMode, AFile, LFile) then
    return LFile;
  end;
  LReal := reinterpret_cast<FreopenFn>(HookReal(GRealFreopen, "freopen"));
  if LReal = nil then
    errno := ENOSYS;
    return nil;
  end;
  return LReal(APath, AMode, AFile);
end;
HOOKABI_IMPORT_SLOT(freopen);

// The stream family: every name C code can pass a handle to. A handle is
// answered by HookIO (HookIODoXxx true), a real FILE by the C runtime. Inside
// the scoped pragma pair: a header that declares one of these dllimport warns
// on the definition.
type
  FreadFn = routine clink(const ABuffer: ptr; const ASize: size_t; const ACount: size_t; const AFile: ptr to FILE): size_t;
  FwriteFn = routine clink(const ABuffer: ptr to const void; const ASize: size_t; const ACount: size_t; const AFile: ptr to FILE): size_t;
  FseekFn = routine clink(const AFile: ptr to FILE; const AOffset: long; const AOrigin: int32): int32;
  FtellFn = routine clink(const AFile: ptr to FILE): long;
  Fseek64Fn = routine clink(const AFile: ptr to FILE; const AOffset: int64; const AOrigin: int32): int32;
  Ftell64Fn = routine clink(const AFile: ptr to FILE): int64;
  StreamFn = routine clink(const AFile: ptr to FILE): int32;
  StreamVoidFn = routine clink(const AFile: ptr to FILE);
  FgetsFn = routine clink(const AText: ptr to char; const ACount: int32; const AFile: ptr to FILE): ptr to char;
  CharFn = routine clink(const AChar: int32; const AFile: ptr to FILE): int32;
  FputsFn = routine clink(const AText: ptr to const char; const AFile: ptr to FILE): int32;
  FputwsFn = routine clink(const AText: ptr to const wchar_t; const AFile: ptr to FILE): int32;
