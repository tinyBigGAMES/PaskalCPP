  SetbufFn = routine clink(const AFile: ptr to FILE; const ABuffer: ptr to char);
  SetvbufFn = routine clink(const AFile: ptr to FILE; const ABuffer: ptr to char; const AMode: int32; const ASize: size_t): int32;

