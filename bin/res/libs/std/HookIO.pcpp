// glibc's __fgetws_chk / __fgetws_unlocked_chk (AText holds ASize wide
// characters): ACount <= 0 nil; min(ACount - 1, ASize) characters read; a
// read that reached ASize leaves no room for the 0 and fails the check
// (__chk_fail once the stream lock is released); otherwise fgetws's rules
static wchar_t* HookIODoGetwsChk(wchar_t* AText, std::size_t ASize, int ACount, FILE* AFile,
  void*& ASlot, const char* AName)
{
  using TReal = wchar_t* (*)(wchar_t*, std::size_t, int, FILE*);
  TReal LReal;
  wchar_t* LResult = nullptr;
  std::int64_t LCount = 0;
  bool LCheckFailed = false;
  bool LOurs;

  LOurs = HookIODoWith(AFile, [&](HookIODoHandle& AHandle)
  {
    bool LOldError;
    std::int64_t LWant;
    if (ACount <= 0)
      return;
    LWant = static_cast<std::int64_t>(ACount) - 1;
    if (static_cast<std::uint64_t>(LWant) > ASize)
      LWant = static_cast<std::int64_t>(ASize);
    LOldError = AHandle.Failed;
    AHandle.Failed = false;
    LCount = HookIODoCrtWideLineLocked(AHandle, AText, LWant);
    if ((LCount == 0) || (AHandle.Failed && (errno != EAGAIN)))
      LResult = nullptr;
    else if (static_cast<std::uint64_t>(LCount) >= ASize)
      LCheckFailed = true;
    else
    {
      AText[LCount] = L'\0';
      LResult = AText;
    }
    AHandle.Failed = AHandle.Failed || LOldError;
  });
  if (LOurs)
  {
    if (LCheckFailed)
      __chk_fail();
    return LResult;
  }
  LReal = reinterpret_cast<TReal>(::pcpp_m_HookABI::HookReal(ASlot, AName));
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return nullptr;
  }
  return LReal(AText, ASize, ACount, AFile);
}

extern "C" wchar_t* __fgetws_chk(wchar_t* AText, std::size_t ASize, int ACount, FILE* AFile)
{
  static void* LSlot = nullptr;

  return HookIODoGetwsChk(AText, ASize, ACount, AFile, LSlot, "__fgetws_chk");
}

extern "C" wchar_t* __fgetws_unlocked_chk(wchar_t* AText, std::size_t ASize, int ACount,
  FILE* AFile)
{
  static void* LSlot = nullptr;

  return HookIODoGetwsChk(AText, ASize, ACount, AFile, LSlot, "__fgetws_unlocked_chk");
}
