// The wide printf / scanf family: a handle is formatted / scanned by the
// CRT's own rules (HookIODoWidePrint / HookIODoWideScanHandle), a real FILE
// goes to the real function
#if defined(_WIN32)
// What ucrt's fwprintf / vfwprintf and the headers' inline wide printf
// family call
extern "C" int __stdio_common_vfwprintf(unsigned __int64 AOptions, FILE* AFile,
  const wchar_t* AFormat, _locale_t ALocale, va_list AArgs)
{
  using TReal = int (*)(unsigned __int64, FILE*, const wchar_t*, _locale_t, va_list);
  int LResult;

  if (HookIODoWidePrint(AFile, AOptions, AFormat, ALocale, AArgs, LResult))
    return LResult;
  HOOKIO_DO_REAL(TReal, "__stdio_common_vfwprintf");
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return -1;
  }
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
}
HOOKABI_IMPORT_SLOT(__stdio_common_vfwprintf);

// What ucrt's fwscanf / vfwscanf and the headers' inline wide scan forms
// call
extern "C" int __stdio_common_vfwscanf(unsigned __int64 AOptions, FILE* AFile,
  const wchar_t* AFormat, _locale_t ALocale, va_list AArgs)
{
  using TReal = int (*)(unsigned __int64, FILE*, const wchar_t*, _locale_t, va_list);
  int LResult;

  HOOKIO_DO_REAL(TReal, "__stdio_common_vfwscanf");
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return EOF;
  }
  if (HookIODoWideScanHandle(AFile, LReal, AOptions, ALocale, AFormat, AArgs, LResult))
    return LResult;
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
}
HOOKABI_IMPORT_SLOT(__stdio_common_vfwscanf);
#else
extern "C" int vfwprintf(FILE* AFile, const wchar_t* AFormat, va_list AArgs)
{
  using TReal = int (*)(FILE*, const wchar_t*, va_list);
  int LResult;

  if (HookIODoWidePrint(AFile, AFormat, AArgs, LResult))
    return LResult;
  HOOKIO_DO_REAL(TReal, "vfwprintf");
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return -1;
  }
  return LReal(AFile, AFormat, AArgs);
}

extern "C" int fwprintf(FILE* AFile, const wchar_t* AFormat, ...)
{
  va_list LArgs;
  int LResult;

  va_start(LArgs, AFormat);
  LResult = vfwprintf(AFile, AFormat, LArgs);
  va_end(LArgs);
  return LResult;
}

// glibc's fortified wide printf: on a handle the plain path (glibc's
// fortify check for wide printf is %n in writable memory, which the format
// reaching vswprintf meets as glibc's own would not: the flag is passed on
// for a real FILE only)
extern "C" int __vfwprintf_chk(FILE* AFile, int AFlag, const wchar_t* AFormat, va_list AArgs)
{
  using TReal = int (*)(FILE*, int, const wchar_t*, va_list);
  int LResult;

  if (HookIODoWidePrint(AFile, AFormat, AArgs, LResult))
    return LResult;
  HOOKIO_DO_REAL(TReal, "__vfwprintf_chk");
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return -1;
  }
  return LReal(AFile, AFlag, AFormat, AArgs);
}

extern "C" int __fwprintf_chk(FILE* AFile, int AFlag, const wchar_t* AFormat, ...)
{
  va_list LArgs;
  int LResult;

  va_start(LArgs, AFormat);
  LResult = __vfwprintf_chk(AFile, AFlag, AFormat, LArgs);
  va_end(LArgs);
  return LResult;
}

// vfwscanf and the C99 name C callers bind to (glibc redirects fwscanf /
// vfwscanf to __isoc99_* under C99 rules): each defined under its own name
static int HookIODoWideVscan(FILE* AFile, void*& ASlot, const char* AName,
  const wchar_t* AFormat, va_list AArgs)
{
  HookIODoWideScanFn LReal;
  int LResult;

  LReal = reinterpret_cast<HookIODoWideScanFn>(::pcpp_m_HookABI::HookReal(ASlot, AName));
  if (LReal == nullptr)
  {
    errno = ENOSYS;
    return EOF;
  }
  if (HookIODoWideScanHandle(AFile, LReal, AFormat, AArgs, LResult))
    return LResult;
  return LReal(AFile, AFormat, AArgs);
}

extern "C" int HookIODoPlainVfwscanf(FILE* AFile, const wchar_t* AFormat, va_list AArgs)
  __asm__("vfwscanf");

extern "C" int HookIODoPlainVfwscanf(FILE* AFile, const wchar_t* AFormat, va_list AArgs)
{
  static void* LSlot = nullptr;

  return HookIODoWideVscan(AFile, LSlot, "vfwscanf", AFormat, AArgs);
}

extern "C" int HookIODoIsoVfwscanf(FILE* AFile, const wchar_t* AFormat, va_list AArgs)
  __asm__("__isoc99_vfwscanf");

extern "C" int HookIODoIsoVfwscanf(FILE* AFile, const wchar_t* AFormat, va_list AArgs)
{
  static void* LSlot = nullptr;

  return HookIODoWideVscan(AFile, LSlot, "__isoc99_vfwscanf", AFormat, AArgs);
}

extern "C" int HookIODoPlainFwscanf(FILE* AFile, const wchar_t* AFormat, ...)
  __asm__("fwscanf");

extern "C" int HookIODoPlainFwscanf(FILE* AFile, const wchar_t* AFormat, ...)
{
  va_list LArgs;
  int LResult;

  va_start(LArgs, AFormat);
  LResult = HookIODoPlainVfwscanf(AFile, AFormat, LArgs);
  va_end(LArgs);
  return LResult;
}

