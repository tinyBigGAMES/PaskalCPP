var
  LResult: int64;
  LReal: Ftell64Fn;
begin
  if HookIODoTell(AFile, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<Ftell64Fn>(HookReal(GRealFtelli64, "_ftelli64"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile);
end;
HOOKABI_IMPORT_SLOT(_ftelli64);

routine clink ftello64(const AFile: ptr to FILE): int64;
var
  LResult: int64;
  LReal: Ftell64Fn;
begin
  if HookIODoTell(AFile, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<Ftell64Fn>(HookReal(GRealFtelli64, "_ftelli64"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile);
end;
HOOKABI_IMPORT_SLOT(ftello64);

// A handle takes its stream lock in every call: locking it here is nothing
routine clink _lock_file(const AFile: ptr to FILE);
var
  LReal: LockFn;
begin
  if HookIODoOwns(AFile) then
    return;
  end;
  LReal := reinterpret_cast<LockFn>(HookReal(GRealLockFile, "_lock_file"));
  if LReal = nil then
    errno := ENOSYS;
    return;
  end;
  LReal(AFile);
end;
HOOKABI_IMPORT_SLOT(_lock_file);

routine clink _unlock_file(const AFile: ptr to FILE);
var
  LReal: LockFn;
begin
  if HookIODoOwns(AFile) then
    return;
  end;
  LReal := reinterpret_cast<LockFn>(HookReal(GRealUnlockFile, "_unlock_file"));
  if LReal = nil then
    errno := ENOSYS;
    return;
  end;
  LReal(AFile);
end;
HOOKABI_IMPORT_SLOT(_unlock_file);

var
  GRealPclose: ptr;

// A HookIO handle is never a pipe: ucrt's _pclose refuses a stream _popen
// did not open with -1 and EBADF, leaving it open (measured 2026-10-26,
// tests\probe\hookabi\pclose_plain.pcpp), and so does this hook
routine clink _pclose(const AFile: ptr to FILE): int32;
var
  LReal: StreamFn;
begin
  if HookIODoOwns(AFile) then
    errno := EBADF;
    return -1;
  end;
  LReal := reinterpret_cast<StreamFn>(HookReal(GRealPclose, "_pclose"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile);
end;
HOOKABI_IMPORT_SLOT(_pclose);

#pragma clang diagnostic pop

// The query family (HookIODoQuery), the names raylib reaches: FileExists
// (_access; C built without the dllimport declaration reaches the oldnames
// access), IsPathFile / GetFileModTime (stat64i32, mingw's stat), IsFileHidden
// and mingw's opendir (GetFileAttributesA). A real path goes to ucrt /
// kernel32.
type
  AccessFn = routine clink(const APath: ptr to const char; const AMode: int32): int32;
  Stat64i32Fn = routine clink(const APath: ptr to const char; const ABuf: ptr to struct _stat64i32): int32;
  GetFileAttributesAFn = routine clink(const APath: LPCSTR): DWORD;

var
  GRealAccess: ptr;
  GRealPlainAccess: ptr;
  GRealStat64i32: ptr;
  GRealGetFileAttributesA: ptr;

// Declared dllimport by the headers: own definitions + own import slots
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Winconsistent-dllimport"

routine clink _access(const APath: ptr to const char; const AMode: int32): int32;
var
  LResult: int32;
  LReal: AccessFn;
begin
  if HookIODoAccess(APath, AMode, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<AccessFn>(HookReal(GRealAccess, "_access"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(APath, AMode);
end;
HOOKABI_IMPORT_SLOT(_access);

routine clink GetFileAttributesA(const APath: LPCSTR): DWORD;
var
  LResult: DWORD;
  LReal: GetFileAttributesAFn;
begin
  if HookIODoAttributes(APath, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<GetFileAttributesAFn>(HookReal(GRealGetFileAttributesA, "kernel32.dll", "GetFileAttributesA"));
  if LReal = nil then
    SetLastError(ERROR_PROC_NOT_FOUND);
    return INVALID_FILE_ATTRIBUTES;
  end;
  return LReal(APath);
end;
HOOKABI_IMPORT_SLOT(GetFileAttributesA);

#pragma clang diagnostic pop

// mingw's oldnames access: the same answer, a real path to ucrt's _access
routine clink access(const APath: ptr to const char; const AMode: int32): int32;
var
  LResult: int32;
  LReal: AccessFn;
begin
  if HookIODoAccess(APath, AMode, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<AccessFn>(HookReal(GRealPlainAccess, "_access"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(APath, AMode);
end;

// mingw's stat (libmingwex's stat64i32, not an import): a real path to
// ucrt's _stat64i32
routine clink stat64i32(const APath: ptr to const char; const ABuf: ptr to struct _stat64i32): int32;
var
  LResult: int32;
  LReal: Stat64i32Fn;
begin
  if HookIODoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<Stat64i32Fn>(HookReal(GRealStat64i32, "_stat64i32"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(APath, ABuf);
end;

@else

var
  GRealFopen64: ptr;

routine clink fopen64(const APath: ptr to const char; const AMode: ptr to const char): ptr to FILE;
var
  LFile: ptr to FILE;
  LReal: FopenFn;
begin
  if HookIODoOpen(APath, AMode, LFile) then
    return LFile;
  end;
  LReal := reinterpret_cast<FopenFn>(HookReal(GRealFopen64, "fopen64"));
  if LReal = nil then
    errno := ENOSYS;
    return nil;
  end;
  return LReal(APath, AMode);
end;

var
  GRealFreopen64: ptr;

// freopen's large-file name (what lua's loader binds on Linux)
routine clink freopen64(const APath: ptr to const char; const AMode: ptr to const char;
  const AFile: ptr to FILE): ptr to FILE;
var
  LFile: ptr to FILE;
  LReal: FreopenFn;
begin
  if HookIODoReopen(APath, AMode, AFile, LFile) then
    return LFile;
  end;
  LReal := reinterpret_cast<FreopenFn>(HookReal(GRealFreopen64, "freopen64"));
  if LReal = nil then
    errno := ENOSYS;
    return nil;
  end;
  return LReal(APath, AMode, AFile);
end;

var
  GRealPclose: ptr;

// A HookIO handle is never a pipe: glibc's pclose closes a stream popen
// did not open as fclose does (0, errno untouched; measured 2026-10-26,
// tests\probe\hookabi\pclose_plain.pcpp), and so does this hook
routine clink pclose(const AFile: ptr to FILE): int32;
var
  LResult: int32;
  LReal: StreamFn;
begin
  if HookIODoClose(AFile, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<StreamFn>(HookReal(GRealPclose, "pclose"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile);
end;

// fwide reads and sets glibc's orientation (Windows' is mingw's own inline
// one that never reads the FILE: no hook there)
type
  FwideFn = routine clink(const AFile: ptr to FILE; const AMode: int32): int32;

var
  GRealFwide: ptr;

routine clink fwide(const AFile: ptr to FILE; const AMode: int32): int32;
var
  LResult: int32;
  LReal: FwideFn;
begin
  if HookIODoFwide(AFile, AMode, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<FwideFn>(HookReal(GRealFwide, "fwide"));
  if LReal = nil then
    errno := ENOSYS;
    return 0;
  end;
  return LReal(AFile, AMode);
end;

// The stream names glibc exports under their own names. fseeko / ftello
// (off_t: a long on x86_64) are what libc++'s filebuf calls.
var
  GRealFileno: ptr;
  GRealFseeko64: ptr;
  GRealFtello64: ptr;
  GRealFseeko: ptr;
  GRealFtello: ptr;

routine clink fseeko(const AFile: ptr to FILE; const AOffset: long; const AOrigin: int32): int32;
var
  LResult: int32;
  LReal: FseekFn;
begin
  if HookIODoSeek(AFile, AOffset, AOrigin, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<FseekFn>(HookReal(GRealFseeko, "fseeko"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile, AOffset, AOrigin);
end;

routine clink ftello(const AFile: ptr to FILE): long;
var
  LResult: int64;
  LReal: FtellFn;
begin
  if HookIODoTell(AFile, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<FtellFn>(HookReal(GRealFtello, "ftello"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile);
end;

routine clink fileno(const AFile: ptr to FILE): int32;
var
  LResult: int32;
  LReal: StreamFn;
begin
  if HookIODoFileno(AFile, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<StreamFn>(HookReal(GRealFileno, "fileno"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile);
end;

routine clink fseeko64(const AFile: ptr to FILE; const AOffset: int64; const AOrigin: int32): int32;
var
  LResult: int32;
  LReal: Fseek64Fn;
begin
  if HookIODoSeek(AFile, AOffset, AOrigin, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<Fseek64Fn>(HookReal(GRealFseeko64, "fseeko64"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile, AOffset, AOrigin);
end;

routine clink ftello64(const AFile: ptr to FILE): int64;
var
  LResult: int64;
  LReal: Ftell64Fn;
begin
  if HookIODoTell(AFile, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<Ftell64Fn>(HookReal(GRealFtello64, "ftello64"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(AFile);
end;

// The query family (HookIODoQuery), the names raylib reaches: FileExists
// (access) here; IsPathFile / GetFileModTime (stat) are C++ in the cpp
// source above (the headers name a C++ stat stat64 by asm label, so the
// plain stat symbol C calls needs a definition of its own)
type
  AccessFn = routine clink(const APath: ptr to const char; const AMode: int32): int32;

var
  GRealAccess: ptr;

routine clink access(const APath: ptr to const char; const AMode: int32): int32;
var
  LResult: int32;
  LReal: AccessFn;
begin
  if HookIODoAccess(APath, AMode, LResult) then
    return LResult;
  end;
  LReal := reinterpret_cast<AccessFn>(HookReal(GRealAccess, "access"));
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(APath, AMode);
end;

@endif

/// Registers an IO under a new prefix: from now on `fopen("<prefix>/<name>")`,
/// in the program or in any C library linked into it, opens it (see the unit
/// header for the modes). Every open gets its own handle with its own
/// position. The IO stays the caller's: the registry never closes it.
/// @param AIO the stream
/// @returns the prefix, `io://<n>`; "" when AIO is nil or out of memory
/// @example `LPrefix := RegisterIO(LMusic); LFile := fopen((LPrefix + "/song.ogg").c_str(), "rb");`
/// @see RegisterIOSource
/// @see UnregisterIO
/// @since 0.2
exported routine RegisterIO(const AIO: IO): string;
begin
  return HookIODoRegister(AIO, nil);
end;

/// Registers an IOSource under a new prefix: from now on
/// `fopen("<prefix>/<entry>")`, in the program or in any C library linked
/// into it, opens that entry of the source (IOSourceOpen). The source stays
/// the caller's: the registry never closes it.
/// @param ASource the source
/// @returns the prefix, `io://<n>`; "" when ASource is nil or out of memory
/// @example `LPrefix := RegisterIOSource(CreateZipIOSource("$P:assets.zip"));`
/// @see RegisterIO
/// @see UnregisterIO
/// @since 0.2
exported routine RegisterIOSource(const ASource: IOSource): string;
begin
  return HookIODoRegister(nil, ASource);
end;

/// Removes a prefix: opening a path under it fails as a missing file does
/// (ENOENT) from now on. Handles already open stay as they are; close them
/// before closing what was registered.
/// @param APrefix exactly what RegisterIO / RegisterIOSource returned
/// @returns true when APrefix was registered
/// @example `UnregisterIO(LPrefix); IOClose(LMusic);`
/// @see RegisterIO
/// @see RegisterIOSource
/// @since 0.2
exported routine UnregisterIO(const APrefix: string): bool;
begin
  return HookIODoUnregister(APrefix);
end;

/// The IO behind a handle that a hooked open returned: the registered IO, or
/// the entry's IO for a source. For a C runtime FILE, or nil, it is nil.
/// @param AFile the handle
/// @returns the IO, or nil when AFile is not a HookIO handle
/// @example `if FileIO(LFile) <> nil then ... end;`
/// @see RegisterIO
/// @since 0.2
exported routine FileIO(const AFile: ptr to FILE): IO;
begin
  return HookIODoStream(AFile);
end;

/// Makes an IOSource the path source: while it is set, a plain path (not
/// `io://`) that any hooked open or query names, in the program or in any C
/// library linked into it, is looked up in the source first, as an entry
/// name ('\' as '/', every leading "./" or '/' dropped). When the source has
/// that entry, the path opens or answers as `<prefix>/<entry>` would;
/// otherwise the path goes to the real file system untouched. While a hooked
/// open or query runs, the files a source opens itself (its real files, its
/// archive) reach the real file system. One setting for the whole program;
/// setting a source replaces the one before. The source stays the caller's:
/// unset it (nil) before closing it. CustomIO's file IO and folder source
/// always mean the disk: their own opens and queries are never looked up.
/// @param ASource the files, or nil to look up no plain path
/// @returns false when the source could not be registered (out of memory):
///   nothing changed
/// @example `SetIOPathSource(CreateZipIOSource("$P:assets.zip")); LFile := fopen("music/song.ogg", "rb");`
/// @see RegisterIOSource
/// @see SetIOThreadPathSource
/// @since 0.2
exported routine SetIOPathSource(const ASource: IOSource): bool;
begin
  return HookIODoSetPathSource(ASource);
end;

/// Makes an IOSource the calling thread's own path source: while it is set,
/// a plain path that a hooked open or query names on this thread is looked
/// up in it, as SetIOPathSource describes, instead of in the program's path
/// source; every other thread keeps the program's. A loader that pulls in
/// files by plain relative paths (a map's tilesets and images) sets one for
/// the load and unsets it after, without moving the program's path source
/// under another thread (a music stream reading through it). Set and unset
/// it on the same thread, unset it (nil) before the thread ends and before
/// closing the source. The source stays the caller's.
/// @param ASource the files, or nil: the program's path source applies to
///   this thread again
/// @returns false when the source could not be registered (out of memory):
///   nothing changed
/// @example `SetIOThreadPathSource(LZip); LOk := LMap.load("maps/level.tmx"); SetIOThreadPathSource(nil);`
/// @see SetIOPathSource
/// @see GetIOThreadPathSource
/// @since 0.3
exported routine SetIOThreadPathSource(const ASource: IOSource): bool;
begin
  return HookIODoSetThreadPathSource(ASource);
end;

/// The calling thread's own path source, as SetIOThreadPathSource last set
/// it on this thread, so a loader can set its own for a call and put the
/// caller's back after.
/// @returns the source; nil when none is set on this thread (the program's
///   path source, if any, applies)
/// @example `LBefore := GetIOThreadPathSource(); SetIOThreadPathSource(LZip); ... SetIOThreadPathSource(LBefore);`
/// @see SetIOThreadPathSource
/// @since 0.3
exported routine GetIOThreadPathSource(): IOSource;
begin
  return HookIODoThreadPathSource();
end;

end.
