// Both targets: through vfprintf (on Windows the headers' inline one, which
// calls __stdio_common_vfprintf above)
extern "C" int fprintf(FILE* AFile, const char* AFormat, ...)
{
  va_list LArgs;
  int LResult;

  va_start(LArgs, AFormat);
  LResult = vfprintf(AFile, AFormat, LArgs);
  va_end(LArgs);
  return LResult;
}

