-------------------------------------------------------------------------------
  stb_easy_font.pcpp - the stb_easy_font unit (stb, header-only): `import
  stb_easy_font;` uses quick-and-dirty bitmap text as quads (all static
  functions: nothing to compile) from PaskalCPP. A self-describing vendor
  module: it owns every path it needs. The library has no implementation to
  compile: the header is all of it.
==============================================================================*/

module unit stb_easy_font;

@addincludepath "$P:res/libs/vendor/stb/include";

@ifndef TARGET_X86_64_WINDOWS_GNU
  @ifndef TARGET_X86_64_LINUX_GNU
    @message error "stb_easy_font: unsupported target";
  @endif
@endif

// The declarations go to this unit's header, so every importer sees the API
cpp header;

#include <stb_easy_font.h>

end.
