-------------------------------------------------------------------------------
  box2d.pcpp - the Box2D unit: `import box2d;` uses Box2D (2D rigid body
  physics: worlds, bodies, shapes, joints) from PaskalCPP. A self-describing
  vendor module: it owns every include path, library path and link library
  it needs, per official target.
==============================================================================*/

module unit box2d;

// Self-describing vendor module: it owns every path it needs.

@addincludepath "$P:res/libs/vendor/box2d/include";

// Box2D needs only the C runtime: on Windows mingw's CRT (linked by default),
// on Linux libc and libm (sqrtf, remainderf).
@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/box2d/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/box2d/lib/x86_64-linux-gnu";
  @linklibrary "m";
@else
  @message error "box2d_import: unsupported target";
@endif

@linklibrary "box2d";

// The header goes to this unit's header, so every importer sees Box2D's API
cpp header;

#include <box2d/box2d.h>

end.
