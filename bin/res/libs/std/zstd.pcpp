-------------------------------------------------------------------------------
  zstd.pcpp - the zstd unit: `import zstd;` uses Zstandard
  (https://github.com/facebook/zstd: ZSTD_compress / ZSTD_decompress, the
  streaming and dictionary APIs) from PaskalCPP. A self-describing vendor
  module: it owns every include path, library path and link library it
  needs, per official target. The library is libzstd.a (one per target),
  built by PaskalCPP-Libs' build-zstd.cmd from zstd's own CMake project
  (static, multithreaded compression on, legacy formats readable), shipped
  under zstd's BSD license.
==============================================================================*/

module unit zstd;

// Self-describing vendor module: it owns every path it needs.

@addincludepath "$P:res/libs/vendor/zstd/include";

@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/zstd/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/zstd/lib/x86_64-linux-gnu";
@else
  @message error "zstd: unsupported target";
@endif

@linklibrary "zstd";

// The headers go to this unit's header, so every importer sees zstd's API
cpp header;

#include "zstd.h"
#include "zstd_errors.h"

end.
