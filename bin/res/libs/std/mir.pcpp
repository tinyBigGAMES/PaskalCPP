  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  mir.pcpp - the mir unit: `import mir;` uses MIR
  (https://github.com/vnmakarov/mir: a lightweight JIT compiler) from
  PaskalCPP: build functions through MIR's C API (mir.h), or compile C
  source with c2mir (c2mir/c2mir.h), then link them for lazy, lazy
  basic-block or eager native generation (mir-gen.h) and call them through
  their addresses.
  A self-describing vendor module: it owns every include path, library path
  and link library it needs, per official target. The libraries are
  libmir.a (MIR's core, interpreter and generator) and libc2mir.a (the C11
  frontend), one per target, built by PaskalCPP-Libs' build-mir.cmd with
  its src\mir\win64-lazy-wrapper.patch (both lazy interfaces on Win64; see
  that folder's FIXES.md), shipped under MIR's MIT license.

  Rules learned on both targets (research\mir\findings.md): no C++
  exception may unwind through a JIT'd frame (catch it in the host routine
  the JIT'd code calls); a longjmp over JIT'd frames on Win64 needs
  _setjmp(buf, NULL); MIR's error callback must not return; every import
  JIT'd code makes is resolved by the host (MIR_load_external), c2mir's
  memcpy / memset / memmove included.

  mir_ext (std\mir_ext.pcpp) puts MIR's C boundary behind PaskalCPP
  routines: contexts with recoverable errors, hosts, linking, calls by
  address, C from a string / file / zip entry and the binary form from a
  file / zip entry.
==============================================================================*/

module unit mir;

// Self-describing vendor module: it owns every path it needs.

@addincludepath "$P:res/libs/vendor/mir/include";

@ifdef TARGET_X86_64_WINDOWS_GNU
  @addlibrarypath "$P:res/libs/vendor/mir/lib/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
  @addlibrarypath "$P:res/libs/vendor/mir/lib/x86_64-linux-gnu";
@else
  @message error "mir: unsupported target";
@endif

// c2mir first: it calls into MIR's core
@linklibrary "c2mir";
@linklibrary "mir";

// The headers go to this unit's header, so every importer sees MIR's API
cpp header;

#include "mir.h"
#include "mir-gen.h"

// c2mir.h has no extern "C" guard of its own (mir.h and mir-gen.h do):
// without one its routines get C++ linkage and do not link against the C
// library (PaskalCPP-Libs src\mir\FIXES.md, C)
extern "C" {
#include "c2mir/c2mir.h"
}

end.
