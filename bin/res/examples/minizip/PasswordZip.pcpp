-------------------------------------------------------------------------------
  PasswordZip.pcpp - minizip example: writes secret.zip beside the program's
  executable (wherever it is started from) holding one text file encrypted
  with a password, then reads it back: with a wrong password the entry does
  not decrypt, with the right one the text comes back as it was written.
==============================================================================*/

module exe PasswordZip;

import
  minizip,
  path;

const
  CEntryName: ptr to const char = "hello.txt";
  CPassword: ptr to const char = "PaskalCPP";
  CWrongPassword: ptr to const char = "guess";

routine WriteZip(const AZipPath: string; const AText: string);
var
  LZip: zipFile;
  LInfo: zip_fileinfo;
  LCrc: uLong;
  LResult: int32;
begin
  // The traditional PKWARE encryption seeds its check byte with the entry's
  // crc32, so it is computed before the entry is opened
  LCrc := crc32(0, ptr to const uint8(AText.c_str()), uint32(len(AText)));

  // C gets the path's characters while AZipPath lives
  LZip := zipOpen64(AZipPath.c_str(), APPEND_STATUS_CREATE);
  if LZip = nil then
    raise("cannot create " + AZipPath);
  end;

  // deflate at the best level; -MAX_WBITS = raw deflate as zip stores it,
  // 8 = zip.c's DEF_MEM_LEVEL; the password turns encryption on
  LResult := zipOpenNewFileInZip3_64(LZip, CEntryName, address of LInfo,
    nil, 0, nil, 0, nil, Z_DEFLATED, Z_BEST_COMPRESSION, 0, -MAX_WBITS, 8,
    Z_DEFAULT_STRATEGY, CPassword, LCrc, 0);
  if LResult <> ZIP_OK then
    raisecode(LResult, "cannot add hello.txt");
  end;
  LResult := zipWriteInFileInZip(LZip, AText.c_str(), uint32(len(AText)));
  if LResult <> ZIP_OK then
    raisecode(LResult, "cannot write hello.txt");
  end;
  zipCloseFileInZip(LZip);
  zipClose(LZip, nil);
end;

// Reads hello.txt from the zip at AZipPath with APassword into AText. Returns
// UNZ_OK, or the error minizip reports: a wrong password shows as inflate's
// data error while reading, or as a crc32 mismatch when the entry is closed
routine ReadZip(const AZipPath: string; const APassword: ptr to const char;
  var AText: string): int32;
var
  LUnz: unzFile;
  LInfo: unz_file_info64;
  LRead: int32;
  LClose: int32;
begin
  LUnz := unzOpen64(AZipPath.c_str());
  if LUnz = nil then
    raise("cannot open " + AZipPath);
  end;
  if unzLocateFile(LUnz, CEntryName, 0) <> UNZ_OK then
    raise("secret.zip holds no hello.txt");
  end;
  unzGetCurrentFileInfo64(LUnz, address of LInfo, nil, 0, nil, 0, nil, 0);
  println("hello.txt: {} bytes, encrypted {}", LInfo.uncompressed_size,
    (LInfo.flag & 1) <> 0);

  unzOpenCurrentFilePassword(LUnz, APassword);
  setlength(AText, int64(LInfo.uncompressed_size));
  LRead := unzReadCurrentFile(LUnz, AText.data(), uint32(len(AText)));
  LClose := unzCloseCurrentFile(LUnz);
  unzClose(LUnz);

  if LRead < 0 then
    return LRead;
  end;
  return LClose;
end;

var
  LZipPath: string;
  LText: string;
  LBack: string;
  LResult: int32;

begin
  // $P: = the executable's folder, wherever the program was started from
  LZipPath := path.Resolve("$P:secret.zip");
  LText := "Hello from PaskalCPP, through zlib and minizip.";
  WriteZip(LZipPath, LText);
  println("wrote secret.zip beside the program");

  LResult := ReadZip(LZipPath, CWrongPassword, LBack);
  if LResult = UNZ_OK then
    raise("the wrong password was accepted");
  end;
  println("wrong password: rejected");

  LResult := ReadZip(LZipPath, CPassword, LBack);
  if LResult <> UNZ_OK then
    raisecode(LResult, "reading with the password failed");
  end;
  if LBack <> LText then
    raise("the text read back differs");
  end;
  println("right password: {}", LBack);
end.
