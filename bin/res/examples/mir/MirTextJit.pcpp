-------------------------------------------------------------------------------
  MirTextJit.pcpp - MIR example (import mir, mir_ext): a module written in
  MIR's text form, with a loop (sum), recursion (fib) and a call back into
  this program (host_scale, a `routine clink` registered with MirLoadHost),
  JIT'd three ways side by side: lazily (each function generated on its
  first call), eagerly (all at link) and lazily per basic block. Each run
  prints its results and how long the link and the calls took (a Stopwatch
  from the Diagnostics unit); the results are the same in every mode, the
  times show where each mode spends its work.
==============================================================================*/

module exe MirTextJit;

import
  mir,
  mir_ext,
  Diagnostics;

const
  CModule: string = R"(
m_demo:  module
         export sum, fib, scaled
p_host:  proto i64, i64:x
p_fib:   proto i64, i64:n
         import host_scale
sum:     func i64, i64:n
         local i64:i, i64:s
         mov i, 0; mov s, 0
loop:    bge done, i, n
         add s, s, i; add i, i, 1
         jmp loop
done:    ret s
         endfunc
fib:     func i64, i64:n
         local i64:a, i64:b, i64:t
         bge rec, n, 2
         ret n
rec:     sub t, n, 1
         call p_fib, fib, a, t
         sub t, n, 2
         call p_fib, fib, b, t
         add a, a, b
         ret a
         endfunc
scaled:  func i64, i64:x
         local i64:r
         call p_host, host_scale, r, x
         ret r
         endfunc
         endmodule
)";

// The host routine the module imports: JIT'd code calls back into the program
routine clink host_scale(AX: int64): int64;
begin
  return AX * 100;
end;

// One mode: a fresh context, the module, the host, the link and three calls
routine Run(const ALabel: string; const AMode: MirLinkMode);
var
  LCtx: MIR_context_t;
  LModule: MIR_module_t;
  LWatch: Stopwatch;
  LLinkMs: int64;
  LSum: int64;
  LFib: int64;
  LScaled: int64;
begin
  LCtx := MirNew();
  LModule := MirLoadModuleText(LCtx, CModule);
  if LModule = nil then
    println("{}: the module does not load: {}", ALabel, MirLastError());
    return;
  end;
  MirLoadHost(LCtx, "host_scale", host_scale);
  LWatch := StartNew();
  if not MirLink(LCtx, AMode) then
    println("{}: the link failed: {}", ALabel, MirLastError());
    return;
  end;
  LLinkMs := LWatch.ElapsedMilliseconds();
  LWatch.Restart();
  LSum := MirCall(MirFuncAddr(LCtx, LModule, "sum"), 10000000);
  LFib := MirCall(MirFuncAddr(LCtx, LModule, "fib"), 30);
  LScaled := MirCall(MirFuncAddr(LCtx, LModule, "scaled"), 42);
  println("{:<7} sum(10000000) = {}  fib(30) = {}  scaled(42) = {}", ALabel, LSum, LFib, LScaled);
  println("        link {} ms, calls {} ms", LLinkMs, LWatch.ElapsedMilliseconds());
  MirFree(LCtx);
end;

begin
  Run("lazy", MirLinkMode.Lazy);
  Run("eager", MirLinkMode.Eager);
  Run("lazy-bb", MirLinkMode.LazyBB);
end.
