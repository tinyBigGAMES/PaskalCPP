-------------------------------------------------------------------------------
  Window.pcpp - SDL3 example: opens a resizable window scaled to its
  monitor's DPI (and rescaled when it moves to a monitor with another one)
  and draws with SDL's 2D renderer at a logical resolution of 800 x 450,
  which SDL fits to the window. The background follows the mouse,
  a box tracks the cursor, every key press is printed, Escape or closing the
  window quits.
==============================================================================*/

module exe Window;

import
  sdl3;

const
  CWidth: int32  = 800;
  CHeight: int32 = 450;
  CBoxSize: float32 = 50.0;

var
  LWindow: ptr to SDL_Window;
  LRenderer: ptr to SDL_Renderer;
  LEvent: SDL_Event;
  LBox: SDL_FRect;
  LRunning: bool;
  LVersion: int32;
  LScale: float32;
  LNewScale: float32;
  LWidth: int32;
  LHeight: int32;
  LMouseX: float32;
  LMouseY: float32;

begin
  if not SDL_Init(SDL_INIT_VIDEO) then
    println("SDL_Init failed: {}", SDL_GetError());
    raise("SDL could not start");
  end;

  // DPI scaling, as SDL's README-highdpi describes it: HIGH_PIXEL_DENSITY for
  // all the pixels, then the WINDOW's display scale (1.5 on a 150% monitor)
  // says how much bigger things should be. The window opens hidden, is sized
  // to 800 x 450 times its scale, then shown, so it never appears at the
  // wrong size. When the scale changes (moved to another monitor, setting
  // changed) SDL sends SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED: see the loop.
  LWindow := SDL_CreateWindow("SDL3 Window", CWidth, CHeight,
    SDL_WINDOW_HIDDEN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY);
  if LWindow = nil then
    println("SDL_CreateWindow failed: {}", SDL_GetError());
    SDL_Quit();
    raise("SDL could not open a window");
  end;
  LScale := SDL_GetWindowDisplayScale(LWindow);
  if LScale <= 0.0 then
    LScale := 1.0;
  end;
  SDL_SetWindowSize(LWindow, int32(float32(CWidth) * LScale),
    int32(float32(CHeight) * LScale));
  SDL_ShowWindow(LWindow);
  // nil: SDL picks the best renderer the system has
  LRenderer := SDL_CreateRenderer(LWindow, nil);
  if LRenderer = nil then
    println("SDL_CreateRenderer failed: {}", SDL_GetError());
    SDL_DestroyWindow(LWindow);
    SDL_Quit();
    raise("SDL could not create a renderer");
  end;
  SDL_SetRenderVSync(LRenderer, 1);
  // Everything is drawn in 800 x 450; SDL scales it to the window at any size
  // and DPI, keeping the aspect ratio (bars fill the rest)
  SDL_SetRenderLogicalPresentation(LRenderer, CWidth, CHeight,
    SDL_LOGICAL_PRESENTATION_LETTERBOX);

  LVersion := SDL_GetVersion();
  println("SDL {}.{}.{}: move the mouse, press keys, Escape closes",
    SDL_VERSIONNUM_MAJOR(LVersion), SDL_VERSIONNUM_MINOR(LVersion),
    SDL_VERSIONNUM_MICRO(LVersion));
  println("video driver {}, renderer {}", SDL_GetCurrentVideoDriver(),
    SDL_GetRendererName(LRenderer));
  println("window display scale {}", LScale);

  LMouseX := float32(CWidth) / 2.0;
  LMouseY := float32(CHeight) / 2.0;
  LRunning := true;
  while LRunning do
    while SDL_PollEvent(address of LEvent) do
      // Mouse positions arrive in window coordinates: converted to the
      // logical 800 x 450 the drawing uses
      SDL_ConvertEventToRenderCoordinates(LRenderer, address of LEvent);
      if LEvent.type = SDL_EVENT_QUIT then
        LRunning := false;
      else
        if LEvent.type = SDL_EVENT_KEY_DOWN then
          println("key {} pressed", SDL_GetKeyName(LEvent.key.key));
          if LEvent.key.key = SDLK_ESCAPE then
            LRunning := false;
          end;
        else
          if LEvent.type = SDL_EVENT_MOUSE_MOTION then
            // Over the letterbox bars the position lies outside 800 x 450:
            // kept inside, so the colour below stays 0..255
            LMouseX := SDL_clamp(LEvent.motion.x, 0.0, float32(CWidth));
            LMouseY := SDL_clamp(LEvent.motion.y, 0.0, float32(CHeight));
          else
            if LEvent.type = SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED then
              // The window's scale changed: its size follows by new / old
              // scale, so a size the user dragged it to is kept in proportion
              LNewScale := SDL_GetWindowDisplayScale(LWindow);
              if (LNewScale > 0.0) and (LNewScale <> LScale) then
                SDL_GetWindowSize(LWindow, address of LWidth, address of LHeight);
                SDL_SetWindowSize(LWindow,
                  int32(float32(LWidth) * LNewScale / LScale),
                  int32(float32(LHeight) * LNewScale / LScale));
                println("window display scale {} -> {}", LScale, LNewScale);
                LScale := LNewScale;
              end;
            end;
          end;
        end;
      end;
    end;

    // SDL_RenderClear fills the WHOLE window, bars included: clear to black,
    // then fill only the logical 800 x 450 area with the mouse colour
    SDL_SetRenderDrawColor(LRenderer, 0, 0, 0, 255);
    SDL_RenderClear(LRenderer);
    LBox.x := 0.0;
    LBox.y := 0.0;
    LBox.w := float32(CWidth);
    LBox.h := float32(CHeight);
    SDL_SetRenderDrawColor(LRenderer,
      uint8(255.0 * LMouseX / float32(CWidth)),
      uint8(255.0 * LMouseY / float32(CHeight)), 64, 255);
    SDL_RenderFillRect(LRenderer, address of LBox);

    LBox.w := CBoxSize;
    LBox.h := CBoxSize;
    LBox.x := LMouseX - CBoxSize / 2.0;
    LBox.y := LMouseY - CBoxSize / 2.0;
    SDL_SetRenderDrawColor(LRenderer, 255, 255, 255, 255);
    SDL_RenderFillRect(LRenderer, address of LBox);
    SDL_RenderPresent(LRenderer);
  end;

  SDL_DestroyRenderer(LRenderer);
  SDL_DestroyWindow(LWindow);
  SDL_Quit();
end.
