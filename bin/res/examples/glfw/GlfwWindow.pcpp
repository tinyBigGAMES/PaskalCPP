-------------------------------------------------------------------------------
  GlfwWindow.pcpp - GLFW example: opens an 800 x 450 window with an OpenGL
  context, scaled to the monitor's DPI. The background follows the mouse
  (left button held = brighter), every key press is printed, Escape closes
  the window.
==============================================================================*/

module exe GlfwWindow;

import
  glfw;

const
  CWidth: int32  = 800;
  CHeight: int32 = 450;

// GLFW's key callback. Its parameters are plain values: GLFW calls it through
// a C function pointer, void (*)(GLFWwindow*, int, int, int, int).
routine KeyPressed(AWindow: ptr to GLFWwindow; AKey: int32; AScanCode: int32;
  AAction: int32; AMods: int32);
begin
  if AAction = GLFW_PRESS then
    println("key {} pressed (scancode {})", AKey, AScanCode);
    if AKey = GLFW_KEY_ESCAPE then
      glfwSetWindowShouldClose(AWindow, GLFW_TRUE);
    end;
  end;
end;

var
  LWindow: ptr to GLFWwindow;
  LWidth: int32;
  LHeight: int32;
  LFbWidth: int32;
  LFbHeight: int32;
  LScaleX: float32;
  LScaleY: float32;
  LMouseX: float64;
  LMouseY: float64;
  LShade: float32;

begin
  if glfwInit() = GLFW_FALSE then
    raise("GLFW could not start");
  end;

  // DPI scaling: the size asked for is multiplied by the monitor's content
  // scale (150% = 1200 x 675 pixels), and GLFW resizes the window when it
  // moves to a monitor with another scale
  glfwWindowHint(GLFW_SCALE_TO_MONITOR, GLFW_TRUE);
  LWindow := glfwCreateWindow(CWidth, CHeight, "GLFW Window", nil, nil);
  if LWindow = nil then
    glfwTerminate();
    raise("GLFW could not open a window");
  end;
  glfwMakeContextCurrent(LWindow);
  glfwSwapInterval(1);
  glfwSetKeyCallback(LWindow, KeyPressed);

  println("GLFW {}: move the mouse, press keys, Escape closes",
    glfwGetVersionString());
  // glGetString gives the text as const GLubyte*: printed as a C string
  println("OpenGL {}", ptr to const char(glGetString(GL_VERSION)));
  glfwGetWindowContentScale(LWindow, address of LScaleX, address of LScaleY);
  println("monitor content scale {} x {}", LScaleX, LScaleY);

  while glfwWindowShouldClose(LWindow) = GLFW_FALSE do
    // The window's size in cursor coordinates and the framebuffer's in
    // pixels, asked each frame: the scale or the user may have changed them
    glfwGetWindowSize(LWindow, address of LWidth, address of LHeight);
    glfwGetFramebufferSize(LWindow, address of LFbWidth, address of LFbHeight);
    glfwGetCursorPos(LWindow, address of LMouseX, address of LMouseY);
    LShade := 0.5;
    if glfwGetMouseButton(LWindow, GLFW_MOUSE_BUTTON_LEFT) = GLFW_PRESS then
      LShade := 1.0;
    end;

    glViewport(0, 0, LFbWidth, LFbHeight);
    if (LWidth > 0) and (LHeight > 0) then
      glClearColor(float32(LMouseX / LWidth) * LShade,
        float32(LMouseY / LHeight) * LShade, 0.25 * LShade, 1.0);
    end;
    glClear(GL_COLOR_BUFFER_BIT);

    glfwSwapBuffers(LWindow);
    glfwPollEvents();
  end;

  glfwDestroyWindow(LWindow);
  glfwTerminate();
end.
