-------------------------------------------------------------------------------
  Mojoal3DSound.pcpp - mojoAL example (import mojoal): OpenAL 3D sound. The
  engine loop res\assets\audio\sfx\engine_player.ogg (loaded with
  mojoal_ext's LoadSound, mixed down to mono: OpenAL places only mono sound
  in 3D) plays on a looping source that circles the listener once in six
  seconds: in front, to the right, behind, to the left. Listen with
  headphones: the output only prints where the source is each second.
  Mojoal3DSoundZip.pcpp plays the same sound from bin\assets.zip.
==============================================================================*/

module exe Mojoal3DSound;

import
  Math,
  SysUtils,
  mojoal,
  mojoal_ext;

const
  CSeconds: int32 = 6;
  CStepsPerSecond: int32 = 20;
  CRadius: float64 = 3.0;

var
  LDevice: ptr to ALCdevice;
  LContext: ptr to ALCcontext;
  LBuffer: ALuint;
  LSource: ALuint;
  LSize: ALint;
  LRate: ALint;
  LStep: int32;
  LAngle: float64;
  LX: float64;
  LZ: float64;

begin
  // nil = the default playback device
  LDevice := alcOpenDevice(nil);
  if LDevice = nil then
    println("no playback device could be opened");
    return;
  end;
  LContext := alcCreateContext(LDevice, nil);
  if (LContext = nil) or (alcMakeContextCurrent(LContext) <> ALC_TRUE) then
    println("no audio context could be made");
    alcCloseDevice(LDevice);
    return;
  end;
  println("OpenAL {} ({})", alGetString(AL_VERSION), alGetString(AL_RENDERER));

  // The sound as one channel, so OpenAL can place it
  LBuffer := LoadSound("$P:../../res/assets/audio/sfx/engine_player.ogg", true);
  if LBuffer = 0 then
    println("cannot load engine_player.ogg");
    alcMakeContextCurrent(nil);
    alcDestroyContext(LContext);
    alcCloseDevice(LDevice);
    return;
  end;
  alGetBufferi(LBuffer, AL_SIZE, address of LSize);
  alGetBufferi(LBuffer, AL_FREQUENCY, address of LRate);

  // The listener stays at the origin facing -Z (OpenAL's default); the
  // source loops on a circle around it
  alGenSources(1, address of LSource);
  alSourcei(LSource, AL_BUFFER, ALint(LBuffer));
  alSourcei(LSource, AL_LOOPING, AL_TRUE);
  alSource3f(LSource, AL_POSITION, 0.0, 0.0, float32(-CRadius));
  alSourcePlay(LSource);
  println("engine_player.ogg: {} samples at {} Hz, circling for {} seconds",
    LSize div 2, LRate, CSeconds);

  // Angle 0 is straight ahead (-Z), 90 degrees to the right (+X)
  for LStep := 0 to CSeconds * CStepsPerSecond do
    LAngle := 2.0 * Pi * float64(LStep) / float64(CSeconds * CStepsPerSecond);
    LX := CRadius * Sin(LAngle);
    LZ := -CRadius * Cos(LAngle);
    alSource3f(LSource, AL_POSITION, float32(LX), 0.0, float32(LZ));
    if LStep mod CStepsPerSecond = 0 then
      println("  {} s: x {:5.2f}  z {:5.2f}  ({:3.0f} degrees)",
        LStep div CStepsPerSecond, LX, LZ, LAngle * RadToDeg);
    end;
    Delay(1000 div CStepsPerSecond);
  end;

  // Teardown in reverse: alcCloseDevice refuses while a buffer or context is left
  alSourceStop(LSource);
  alDeleteSources(1, address of LSource);
  alDeleteBuffers(1, address of LBuffer);
  alcMakeContextCurrent(nil);
  alcDestroyContext(LContext);
  alcCloseDevice(LDevice);
  println("done");
end.
