-------------------------------------------------------------------------------
  BasicWindow.pcpp - raylib example: opens an 800 x 450 frame window
  (raylib_ext: sized for the monitor's DPI, the picture scaled and
  letterboxed on resize, F11 for fullscreen) and draws a line of text, with
  the raylib version in the bottom-left corner, until the window is closed.
==============================================================================*/

module exe BasicWindow;

import
  raylib,
  raylib_ext;

const
  CScreenWidth: int32  = 800;
  CScreenHeight: int32 = 450;

begin
  SetConfigFlags(FLAG_VSYNC_HINT | FLAG_MSAA_4X_HINT);
  // The frame window: the program draws in 800 x 450 units whatever the
  // window's real size
  if not InitFrameWindow(CScreenWidth, CScreenHeight, "Raylib Window") then
    return;
  end;
  SetTargetFPS(60);
  SetFrameColor(RAYWHITE);

  while not WindowShouldClose() do
    if IsKeyPressed(KEY_F11) then
      ToggleFrameFullscreen();
    end;

    BeginDrawing();
    BeginFrame();
    DrawText("Congrats! You created your first window!", 190, 200, 20,
      LIGHTGRAY);
    // RAYLIB_VERSION comes from raylib.h: the version this program was built with
    DrawText(TextFormat("raylib %s", RAYLIB_VERSION), 10, CScreenHeight - 30, 20,
      GRAY);
    EndFrame();
    EndDrawing();
  end;

  CloseWindow();
end.
