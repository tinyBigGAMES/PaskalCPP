-------------------------------------------------------------------------------
  TiledTown.pcpp - tmxlite + raylib example: a Tiled map you can walk
  around. res\assets\maps\overworld.tmx is a small town on Kenney's Tiny
  Town tiles (CC0, res\assets\tilesets\tinytown\License.txt); tmxlite_ext
  loads it with its tileset and image (LoadTiledMap) and draws it
  (DrawTiledMap), zoomed 2x by a raylib camera.

  The rest is tmxlite's own API on the loaded map: the map's "title"
  property, the "objects" layer's objects (the player's spawn point, the
  coins and their "value" property) and the tileset's "blocked" tile
  property, which stops the player at trees, houses and fences. The window
  is raylib_ext's frame window (960 x 544 units, sized for the monitor's
  DPI, scaled and letterboxed on resize), the map's camera composed with it
  (BeginFrameMode2D). Arrow keys or WASD walk; F11 toggles fullscreen;
  Escape or the close button ends it.
==============================================================================*/

module exe TiledTown;

import
  tmxlite,
  tmxlite_ext,
  raylib,
  raylib_ext,
  Math,
  SysUtils;

const
  CZoom: float32 = 2.0f;
  CSpeed: float32 = 80.0f;
  CPlayerSize: float32 = 10.0f;

type
  // A coin from the map's object layer
  Coin = record
    X: float32;
    Y: float32;
    Value: int32;
    Taken: bool;
  end;

var
  GWorld: TiledMap;
  GCoins: array of Coin;
  GPlayerX: float32;
  GPlayerY: float32;
  GScore: int32;
  GTitle: string;

// A raylib Vector2 from its two parts
routine Vec(const AX: float32; const AY: float32): ::Vector2;
var
  LResult: ::Vector2;
begin
  LResult.x := AX;
  LResult.y := AY;
  return LResult;
end;

// A raylib Rectangle from its place and size
routine Rect(const AX: float32; const AY: float32; const AWidth: float32; const AHeight: float32): Rectangle;
var
  LResult: Rectangle;
begin
  LResult.x := AX;
  LResult.y := AY;
  LResult.width := AWidth;
  LResult.height := AHeight;
  return LResult;
end;

// True when the tile at pixel (AX, AY) of the map is marked "blocked" in its
// tileset, on any tile layer, or the point is off the map
routine IsBlocked(const AX: float32; const AY: float32): bool;
var
  LCol: int32;
  LRow: int32;
  LLayer: int32;
  LSet: int32;
  LGid: uint32;
  LTile: ptr to const tmx::Tileset::Tile;
  LProp: int32;
  LWidth: int32;
begin
  LCol := int32(Floor(AX / float32(GWorld.Map.getTileSize().x)));
  LRow := int32(Floor(AY / float32(GWorld.Map.getTileSize().y)));
  LWidth := int32(GWorld.Map.getTileCount().x);
  if (LCol < 0) or (LRow < 0) or (LCol >= LWidth) or (LRow >= int32(GWorld.Map.getTileCount().y)) then
    return true;
  end;
  for LLayer := 0 to int32(GWorld.Map.getLayers().size()) - 1 do
    if GWorld.Map.getLayers()[LLayer].get()^.getType() = tmx::Layer::Type::Tile then
      LGid := GWorld.Map.getLayers()[LLayer].get()^.getLayerAs<tmx::TileLayer>().getTiles()[LRow * LWidth + LCol].ID;
      for LSet := 0 to int32(GWorld.Map.getTilesets().size()) - 1 do
        LTile := GWorld.Map.getTilesets()[LSet].getTile(LGid);
        if LTile <> nil then
          for LProp := 0 to int32(LTile^.properties.size()) - 1 do
            if (LTile^.properties[LProp].getName() = "blocked") and
              LTile^.properties[LProp].getBoolValue() then
              return true;
            end;
          end;
        end;
      end;
    end;
  end;
  return false;
end;

// True when the player's box at (AX, AY) (its centre) touches a blocked tile
routine PlayerBlocked(const AX: float32; const AY: float32): bool;
var
  LHalf: float32;
begin
  LHalf := CPlayerSize / 2.0f;
  return IsBlocked(AX - LHalf, AY - LHalf) or IsBlocked(AX + LHalf, AY - LHalf) or
    IsBlocked(AX - LHalf, AY + LHalf) or IsBlocked(AX + LHalf, AY + LHalf);
end;

// One object of the "objects" layer: the spawn point moves the player there,
// a coin is added with its "value" property
routine ReadObject(const AObject: tmx::Object);
var
  LCount: int32;
  LProp: int32;
begin
  if AObject.getName() = "spawn" then
    // Objects are placed by their top-left corner; the player by its centre
    GPlayerX := AObject.getPosition().x + AObject.getAABB().width / 2.0f;
    GPlayerY := AObject.getPosition().y + AObject.getAABB().height / 2.0f;
    return;
  end;
  if AObject.getName() <> "coin" then
    return;
  end;
  LCount := int32(len(GCoins));
  setlength(GCoins, LCount + 1);
  GCoins[LCount].X := AObject.getPosition().x + AObject.getAABB().width / 2.0f;
  GCoins[LCount].Y := AObject.getPosition().y + AObject.getAABB().height / 2.0f;
  GCoins[LCount].Value := 0;
  GCoins[LCount].Taken := false;
  for LProp := 0 to int32(AObject.getProperties().size()) - 1 do
    if AObject.getProperties()[LProp].getName() = "value" then
      GCoins[LCount].Value := AObject.getProperties()[LProp].getIntValue();
    end;
  end;
end;

// The map's title, the spawn point and the coins, from tmxlite's map
routine ReadMap();
var
  LIndex: int32;
  LLayer: int32;
  LObject: int32;
begin
  GTitle := "Tiled map";
  for LIndex := 0 to int32(GWorld.Map.getProperties().size()) - 1 do
    if GWorld.Map.getProperties()[LIndex].getName() = "title" then
      GTitle := GWorld.Map.getProperties()[LIndex].getStringValue();
    end;
  end;
  GPlayerX := 40.0f;
  GPlayerY := 136.0f;
  setlength(GCoins, 0);
  LLayer := GetTiledLayerIndex(GWorld, "objects");
  if LLayer < 0 then
    return;
  end;
  for LObject := 0 to int32(GWorld.Map.getLayers()[LLayer].get()^.getLayerAs<tmx::ObjectGroup>().getObjects().size()) - 1 do
    ReadObject(GWorld.Map.getLayers()[LLayer].get()^.getLayerAs<tmx::ObjectGroup>().getObjects()[LObject]);
  end;
end;

// The player moved by the keys for one frame, each axis on its own so it
// slides along a wall; coins it touches are taken
routine Update();
var
  LStep: float32;
  LDX: float32;
  LDY: float32;
  LIndex: int32;
begin
  LStep := CSpeed * GetFrameTime();
  LDX := 0.0f;
  LDY := 0.0f;
  if IsKeyDown(KEY_LEFT) or IsKeyDown(KEY_A) then
    LDX := LDX - LStep;
  end;
  if IsKeyDown(KEY_RIGHT) or IsKeyDown(KEY_D) then
    LDX := LDX + LStep;
  end;
  if IsKeyDown(KEY_UP) or IsKeyDown(KEY_W) then
    LDY := LDY - LStep;
  end;
  if IsKeyDown(KEY_DOWN) or IsKeyDown(KEY_S) then
    LDY := LDY + LStep;
  end;
  if not PlayerBlocked(GPlayerX + LDX, GPlayerY) then
    GPlayerX := GPlayerX + LDX;
  end;
  if not PlayerBlocked(GPlayerX, GPlayerY + LDY) then
    GPlayerY := GPlayerY + LDY;
  end;
  for LIndex := 0 to int32(len(GCoins)) - 1 do
    if (not GCoins[LIndex].Taken) and (Abs(GCoins[LIndex].X - GPlayerX) < 8.0f) and
      (Abs(GCoins[LIndex].Y - GPlayerY) < 8.0f) then
      GCoins[LIndex].Taken := true;
      GScore := GScore + GCoins[LIndex].Value;
    end;
  end;
end;

// The map, the coins left and the player, through the camera; the title and
// score on top
routine Draw(const ACamera: Camera2D);
var
  LIndex: int32;
  LLeft: int32;
begin
  BeginDrawing();
  BeginFrame();
  // The program's camera composed with the frame's (BeginMode2D would
  // replace the frame's scaling)
  BeginFrameMode2D(ACamera);
  DrawTiledMap(GWorld, 0.0f, 0.0f, WHITE);
  LLeft := 0;
  for LIndex := 0 to int32(len(GCoins)) - 1 do
    if not GCoins[LIndex].Taken then
      DrawCircleV(Vec(GCoins[LIndex].X, GCoins[LIndex].Y), 4.0f, GOLD);
      DrawCircleLinesV(Vec(GCoins[LIndex].X, GCoins[LIndex].Y), 4.0f, ORANGE);
      LLeft := LLeft + 1;
    end;
  end;
  DrawRectangleV(Vec(GPlayerX - CPlayerSize / 2.0f, GPlayerY - CPlayerSize / 2.0f),
    Vec(CPlayerSize, CPlayerSize), SKYBLUE);
  DrawRectangleLinesEx(Rect(GPlayerX - CPlayerSize / 2.0f, GPlayerY - CPlayerSize / 2.0f,
    CPlayerSize, CPlayerSize), 1.0f, DARKBLUE);
  EndFrameMode2D();
  DrawRectangle(0, 0, GetFrameWidth(), 28, Fade(BLACK, 0.6f));
  DrawText(TextFormat("%s   score %d   coins left %d   (arrows / WASD, F11 fullscreen)", GTitle.c_str(),
    GScore, LLeft), 10, 6, 20, RAYWHITE);
  EndFrame();
  EndDrawing();
end;

var
  LCamera: Camera2D;
  LSize: ::Vector2;

begin
  SetConfigFlags(FLAG_VSYNC_HINT);
  // The frame window: 960 x 544 units (the map's 480 x 272 pixels at CZoom),
  // sized for the monitor's DPI, scaled and letterboxed on resize. The map's
  // textures need the window, so the frame is opened before the map loads
  if not InitFrameWindow(960, 544, "PaskalCPP + tmxlite: Tiled Town") then
    println("the window did not open");
    return;
  end;
  SetTargetFPS(60);
  SetFrameColor(BLACK);
  if not LoadTiledMap("$P:../../res/assets/maps/overworld.tmx", GWorld) then
    println("the map could not be loaded");
    CloseWindow();
    return;
  end;
  ReadMap();
  GScore := 0;
  // The whole map fills the frame: CZoom, or less when the map is bigger
  LSize := GetTiledMapSize(GWorld);
  LCamera.offset := Vec(0.0f, 0.0f);
  LCamera.target := Vec(0.0f, 0.0f);
  LCamera.rotation := 0.0f;
  LCamera.zoom := CZoom;
  if (LSize.x > 0.0f) and (LSize.y > 0.0f) then
    LCamera.zoom := Min(CZoom, Min(float32(GetFrameWidth()) / LSize.x, float32(GetFrameHeight()) / LSize.y));
  end;
  while not WindowShouldClose() do
    if IsKeyPressed(KEY_F11) then
      ToggleFrameFullscreen();
    end;
    Update();
    Draw(LCamera);
  end;
  UnloadTiledMap(GWorld);
  CloseWindow();
end.
