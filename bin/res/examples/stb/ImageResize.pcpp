-------------------------------------------------------------------------------
  ImageResize.pcpp - stb example: loads res\assets\images\paskalcpp.png with
  stb_image, shrinks it to 64 x 64 with stb_image_resize2, writes the result
  beside the program with stb_image_write, and reads the new file back. No
  window: it prints the sizes and a checksum of the pixels, the same on
  every target.
==============================================================================*/

module exe ImageResize;

import
  SysUtils,
  stb_image,
  stb_image_resize2,
  stb_image_write;

const
  CSize: int32 = 64;
  CChannels: int32 = 4;

var
  LInPath: string;
  LOutPath: string;
  LPixels: ptr to uint8;
  LW: int32;
  LH: int32;
  LN: int32;
  LSmall: array of uint8;
  LSum: uint64;
  LI: int64;

begin
  LInPath := ResolvePath("$P:../../res/assets/images/paskalcpp.png");
  LOutPath := ResolvePath("$P:paskalcpp_64.png");

  // Load as RGBA whatever the file holds; LN is what the file holds
  LPixels := stbi_load(LInPath.c_str(), address of LW, address of LH, address of LN, CChannels);
  if LPixels = nil then
    println("cannot load paskalcpp.png: {}", stbi_failure_reason());
    return;
  end;
  println("loaded paskalcpp.png: {} x {}, {} channels in the file", LW, LH, LN);

  // Shrink to 64 x 64 into our own buffer (stride = width * 4 bytes)
  setlength(LSmall, int64(CSize * CSize * CChannels));
  stbir_resize_uint8_linear(LPixels, LW, LH, LW * CChannels,
    address of LSmall[0], CSize, CSize, CSize * CChannels, STBIR_RGBA);
  stbi_image_free(LPixels);

  LSum := 0;
  for LI := 0 to len(LSmall) - 1 do
    LSum := LSum + uint64(LSmall[LI]);
  end;
  println("resized to {} x {}, pixel checksum {}", CSize, CSize, LSum);

  // Write it beside the program, then ask stb_image what the new file holds
  if stbi_write_png(LOutPath.c_str(), CSize, CSize, CChannels, address of LSmall[0],
    CSize * CChannels) = 0 then
    println("cannot write paskalcpp_64.png");
    return;
  end;
  if stbi_info(LOutPath.c_str(), address of LW, address of LH, address of LN) = 0 then
    println("cannot read paskalcpp_64.png back: {}", stbi_failure_reason());
    return;
  end;
  println("wrote paskalcpp_64.png: {} x {}, {} channels", LW, LH, LN);
end.
