-------------------------------------------------------------------------------
  Simple.pcpp - rlImGui example (after rlImGui's examples/simple.cpp): Dear
  ImGui's demo window and a window of our own on a raylib window. ImGui's
  API is called as written in C++ (ImGui::Begin, ImGui::Text, ...): it is
  plain mixed C++ inside PaskalCPP code. The window shows a raylib texture
  through rlImGuiImage and a Font Awesome icon (the font rlImGui loads).
  It runs in raylib_ext's frame window (1280 x 800 units, sized for the
  monitor's DPI, scaled and letterboxed on resize), ImGui inside it through
  rlimgui_ext (BeginFrameImGui / EndFrameImGui): ImGui works in the same
  units, its text sharp at the frame's real size. F11 toggles fullscreen.
==============================================================================*/

module exe Simple;

import
  raylib,
  raylib_ext,
  rlimgui,
  rlimgui_ext;

const
  CScreenWidth: int32 = 1280;
  CScreenHeight: int32 = 800;

var
  LImage: Image;
  LTexture: Texture2D;
  LShowDemo: bool;
  LShowOwn: bool;
  LClicks: int32;

begin
  // The frame window: sized for the monitor's DPI (and follows it to another
  // monitor); the program and ImGui both work in its 1280 x 800 units
  SetConfigFlags(FLAG_MSAA_4X_HINT | FLAG_VSYNC_HINT);
  if not InitFrameWindow(CScreenWidth, CScreenHeight, "PaskalCPP - rlImGui simple") then
    println("the window did not open");
    return;
  end;
  SetTargetFPS(144);
  SetFrameColor(DARKGRAY);
  // true = the dark style
  rlImGuiSetup(true);

  // A texture made in code, so the example needs no file beside it
  LImage := GenImageChecked(128, 128, 16, 16, ORANGE, DARKBLUE);
  LTexture := LoadTextureFromImage(LImage);
  UnloadImage(LImage);

  LShowDemo := true;
  LShowOwn := true;
  LClicks := 0;

  while not WindowShouldClose() do
    if IsKeyPressed(KEY_F11) then
      ToggleFrameFullscreen();
    end;

    BeginDrawing();
    BeginFrame();

    BeginFrameImGui();

    if LShowDemo then
      ImGui::ShowDemoWindow(address of LShowDemo);
    end;

    if LShowOwn then
      if ImGui::Begin("PaskalCPP window", address of LShowOwn) then
        ImGui::TextUnformatted(ICON_FA_JEDI);
        ImGui::SameLine();
        ImGui::TextUnformatted("Dear ImGui from PaskalCPP");
        ImGui::Checkbox("Show the demo window", address of LShowDemo);
        if ImGui::Button("Click me") then
          LClicks := LClicks + 1;
        end;
        ImGui::SameLine();
        ImGui::Text("clicked %d times", LClicks);
        ImGui::Text("%.1f frames a second", float64(GetFPS()));
        rlImGuiImage(address of LTexture);
      end;
      ImGui::End();
    end;

    EndFrameImGui();

    // After ImGui, still in frame units
    if IsMouseButtonDown(MOUSE_BUTTON_LEFT) then
      DrawText("Down", 10, 10, 20, GREEN);
    end;
    if IsWindowFocused() then
      DrawText("Focused", 100, 10, 20, WHITE);
    end;

    EndFrame();
    EndDrawing();
  end;

  rlImGuiShutdown();
  UnloadTexture(LTexture);
  CloseWindow();
end.
