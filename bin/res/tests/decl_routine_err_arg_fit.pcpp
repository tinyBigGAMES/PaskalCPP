-------------------------------------------------------------------------------
  decl_routine_err_arg_fit.pcpp - break step of decl_routine.pcpp:
  a constant argument that does not fit its value parameter (300 into int8)

  How to check, from repo\bin:
    pcpp res\tests\decl_routine_err_arg_fit.pcpp
    pcpp res\tests\decl_routine_err_arg_fit.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_routine_err_arg_fit;

routine Small(AN: int8);
begin
  println("{}", AN);
end;

begin
  Small(300); // ERROR SM0404@9: 300 does not fit in 'int8' (-128..127)
end.
