  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  type_object_init.pcpp - Type compliance: init and done

  An object is built by an init and ended by its done (BNF.md sec 4 object
  type; they are their own member kinds, never methods). Shown here:
  - init(...) runs when an object is built; `LB: TBox(1, 3);` gives it its
    arguments, `LP: TPoint;` runs the init that takes none;
  - an init begins with parent.init(...) (TBox) and then self.F.init(...)
    for its object fields, in declaration order; a local of the init is
    there for the rest of its body;
  - an object is built parent first, then its fields, then its own body,
    and ends the other way round: its done, its fields', its parent's;
  - inits overload by parameter types (TPoint); an imported unit's object,
    qualified, is built the same way (type_object_init_unit.TCounter);
  - an init that raises: what it built ends (the field's done), its own
    done never runs: the object never existed;
  - a C/C++ type takes its constructor's arguments the same way: a field
    (self.Text.init("label")) and a variable (std::string("cpp")).

  How to check, from repo\bin:
    pcpp res\tests\type_object_init.pcpp -r
    pcpp res\tests\type_object_init.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    init shape 1
    init log box
    init box 3 9
    area 9
    done box 3
    done log box
    done shape 1
    point 1 2 / 5 6
    counter starts at 10
    counter 11
    counter ends at 11
    init log fails
    done log fails
    caught
    label cpp
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    type_object_init_err_two_done.pcpp  two dones in one object
    type_object_init_err_init_by_name.pcpp  init called by name in a method
    type_object_init_err_done_by_name.pcpp  done called by name in a method
    type_object_init_err_parent_init_late.pcpp  parent.init(...) after a field's init
    type_object_init_err_field_init_order.pcpp  field inits out of declaration order
    type_object_init_err_lead_arg_local.pcpp  parent.init(...) given a local of the init
    type_object_init_err_parent_needs_init.pcpp  an init that does not begin with parent.init(...)
    type_object_init_err_virtual_call.pcpp  a virtual method called in an init
    type_object_init_err_no_default.pcpp  a variable built without the arguments its type needs
    type_object_init_err_args_not_object.pcpp  init arguments on an int32 variable
    type_object_init_err_no_init_takes.pcpp  arguments no init takes
    type_object_init_err_ambiguous.pcpp  arguments two inits take alike
    type_object_init_err_same_params.pcpp  two inits with the same parameter types
    type_object_init_err_hidden_init.pcpp  hidden before an init
    type_object_init_err_init_result.pcpp  an init with a result type
    type_object_init_err_init_in_record.pcpp  an init in a record
*******************************************************************************/

module exe type_object_init;

import type_object_init_unit;

type
  TLog = object
    Name: string;
    init(const AName: string);
    begin
      self.Name := AName;
      println("init log {}", self.Name);
    end;
    done;
    begin
      println("done log {}", self.Name);
    end;
  end;
  TShape = object
    Tag: int32;
    init(const ATag: int32);
    begin
      self.Tag := ATag;
      println("init shape {}", self.Tag);
    end;
    done;
    begin
      println("done shape {}", self.Tag);
    end;
    virtual method Area(): int32;
    begin
      return 0;
    end;
  end;
  TBox = object(TShape)
    Side: int32;
    Log: TLog;
    init(const ATag: int32; const ASide: int32);
    var
      LArea: int32;
    begin
      parent.init(ATag);
      self.Log.init("box");
      self.Side := ASide;
      LArea := self.Side * self.Side;
      println("init box {} {}", self.Side, LArea);
    end;
    done;
    begin
      println("done box {}", self.Side);
    end;
    override method Area(): int32;
    begin
      return self.Side * self.Side;
    end;
  end;
  TPoint = object
    X: int32;
    Y: int32;
    init();
    begin
      self.X := 1;
      self.Y := 2;
    end;
    init(const AX: int32; const AY: int32);
    begin
      self.X := AX;
      self.Y := AY;
    end;
  end;
  TFails = object
    Log: TLog;
    init(const AFail: bool);
    begin
      self.Log.init("fails");
      if AFail then
        raise("init failed");
      end;
      println("init fails done");
    end;
    done;
    begin
      println("done fails");
    end;
  end;
  TLabel = object
    Text: std::string;
    init();
    begin
      self.Text.init("label");
    end;
  end;

routine UseCpp();
var
  LL: TLabel;
  LT: std::string("cpp");
begin
  println("{} {}", LL.Text, LT);
end;

routine UseBox();
var
  LB: TBox(1, 3);
begin
  println("area {}", LB.Area());
end;

routine UseCounter();
var
  LC: type_object_init_unit.TCounter(10);
begin
  LC.Step();
  println("counter {}", LC.Count);
end;

routine TryFails();
var
  LF: TFails(true);
begin
  println("never here {}", LF.Log.Name);
end;

var
  LP: TPoint;
  LQ: TPoint(5, 6);
begin
  UseBox();
  println("point {} {} / {} {}", LP.X, LP.Y, LQ.X, LQ.Y);
  UseCounter();
  guard
    TryFails();
  except
    println("caught");
  end;
  UseCpp();
end.
