-------------------------------------------------------------------------------
  mod_import_err_own_module.pcpp - break step of mod_import.pcpp: the
  module's own name as a qualifier (SM0007: a qualifier names an imported
  unit; the module's own declarations are reached without it)

  How to check, from repo\bin:
    pcpp res\tests\mod_import_err_own_module.pcpp
    pcpp res\tests\mod_import_err_own_module.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe mod_import_err_own_module;

const
  KCount: int32 = 3;

begin
  println("{}", mod_import_err_own_module.KCount); // ERROR SM0007@17: is this module's own name
end.
