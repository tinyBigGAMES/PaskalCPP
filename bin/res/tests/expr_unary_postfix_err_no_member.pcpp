-------------------------------------------------------------------------------
  expr_unary_postfix_err_no_member.pcpp - break step of expr_unary_postfix.pcpp:
  a member the record does not have (SM0009)

  How to check, from repo\bin:
    pcpp res\tests\expr_unary_postfix_err_no_member.pcpp
    pcpp res\tests\expr_unary_postfix_err_no_member.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_unary_postfix_err_no_member;

type
  TP = record
    X: int32;
  end;

var
  LR: TP;

begin
  LR.Z := 1; // ERROR SM0009@3: 'TP' has no member 'Z'
end.
