-------------------------------------------------------------------------------
  type_object_property_virtual_err_overrides_nothing.pcpp - break step of type_object_property_virtual.pcpp:
  override needs a virtual property above (SM0333)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_overrides_nothing.pcpp
    pcpp res\tests\type_object_property_virtual_err_overrides_nothing.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_overrides_nothing;

type
  TBase = object
    FA: int32;
  end;
  TKid = object(TBase)
    override property A: int32 read FA; // ERROR SM0333@5: 'A' overrides nothing
  end;

begin
end.
