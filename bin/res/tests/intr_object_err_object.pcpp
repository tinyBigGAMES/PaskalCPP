  intr_object_err_object.pcpp - break step of intr_object.pcpp:
  create of a pointer to an object (SM0361)

  How to check, from repo\bin:
    pcpp res\tests\intr_object_err_object.pcpp
    pcpp res\tests\intr_object_err_object.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_object_err_object;

type
  TThing = object
    N: int32;
  end;

var
  LT: ptr to TThing;

begin
  create(LT); // ERROR SM0361@10
end.
