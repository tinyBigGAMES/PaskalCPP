  type_object_operator_err_pair.pcpp - break step of type_object_operator.pcpp:
  = declared without <> (SM0386)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_pair.pcpp
    pcpp res\tests\type_object_operator_err_pair.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_pair;

type
  TVec = record
    X: int32;
    Y: int32;
    operator =(const A: TVec; const B: TVec): bool; // ERROR SM0386
    begin
      return A.X = B.X;
    end;
  end;

begin
end.
