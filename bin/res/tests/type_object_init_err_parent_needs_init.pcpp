-------------------------------------------------------------------------------
  type_object_init_err_parent_needs_init.pcpp - break step of type_object_init.pcpp:
  an init that does not begin with parent.init(...) when the parent's init takes arguments (SM0347)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_parent_needs_init.pcpp
    pcpp res\tests\type_object_init_err_parent_needs_init.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_parent_needs_init;

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;
  TB = object(TA)
    init(); // ERROR SM0347@5: 'TA' has no init without arguments: begin every init of 'TB' with parent.init(...)
    begin
    end;
  end;

begin
end.
