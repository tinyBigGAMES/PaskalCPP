  type_overlay_err_cpp_dtor.pcpp - break step of type_overlay.pcpp:
  nor one that cleans up after itself (a destructor), in a record's anonymous overlay too (SM0313, judged in the emitted C++)

  How to check, from repo\bin:
  (the compiler judges it in the emitted C++: the build runs, the program is
  never started)
    pcpp res\tests\type_overlay_err_cpp_dtor.pcpp
    pcpp res\tests\type_overlay_err_cpp_dtor.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_cpp_dtor;

struct CRes { ~CRes() {} int H; };

type
  TV = record
    K: int32;
    overlay
      I: int64;
      R: CRes; // ERROR SM0313@7: is not plain data
    end;
  end;

var
  V: TV;

begin
  V.K := 1;
end.
