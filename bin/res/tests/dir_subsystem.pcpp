-------------------------------------------------------------------------------
  dir_subsystem.pcpp - Directive compliance: @subsystem

  @subsystem console | gui; sets a Windows exe's subsystem, exact case
  (BNF.md sec 2; the default is console). gui applies only to an exe on a
  Windows target: elsewhere it is a warning and is not used. The program reads
  the subsystem field of its own PE header. A Linux executable is not a PE
  file and has no subsystem, so the targets print different lines.

  How to check, from repo\bin:
    pcpp res\tests\dir_subsystem.pcpp -r
    pcpp res\tests\dir_subsystem.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT windows:
    subsystem: console
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXPECT linux:
    subsystem: none (not a PE file)
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  The gui subsystem (Windows only, checked by a person: it shows a window):
  dir_subsystem_gui.pcpp, its header says what to look for.

  Break it: run each file below the same way; each reports exactly what the
  // ERROR / WARN / HINT comment on its marked line says, and nothing else:
    dir_subsystem_err_value.pcpp   a subsystem that does not exist
    dir_subsystem_err_linux.pcpp   gui on the Linux target (a warning; run it
                                   with -t x86_64-linux-gnu only)
    dir_subsystem_err_dll.pcpp     gui on a dll (a warning, both targets)
*******************************************************************************/

module exe dir_subsystem;
@subsystem console;

#ifdef _WIN32
#include <windows.h>
#endif

// The subsystem field of this program's own PE header
static const char* dir_subsystem_name()
{
#ifdef _WIN32
  const unsigned char* LBase = reinterpret_cast<const unsigned char*>(GetModuleHandleW(nullptr));
  const IMAGE_DOS_HEADER* LDos = reinterpret_cast<const IMAGE_DOS_HEADER*>(LBase);
  const IMAGE_NT_HEADERS* LNt = reinterpret_cast<const IMAGE_NT_HEADERS*>(LBase + LDos->e_lfanew);
  if (LNt->OptionalHeader.Subsystem == IMAGE_SUBSYSTEM_WINDOWS_CUI)
    return "console";
  if (LNt->OptionalHeader.Subsystem == IMAGE_SUBSYSTEM_WINDOWS_GUI)
    return "gui";
  return "other";
#else
  return "none (not a PE file)";
#endif
}

begin
  println("subsystem: {}", cpp("dir_subsystem_name()"));
end.
