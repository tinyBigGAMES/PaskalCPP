-------------------------------------------------------------------------------
  expr_primary.pcpp - Expression compliance: primary expressions

  true, false, nil, self and parent, literals and ( ) (BNF.md sec 6 primary
  expr). self is the object a method runs on, parent.<member> its parent's
  member; both exist only inside a method, parent only in an object with a
  parent.

  How to check, from repo\bin:
    pcpp res\tests\expr_primary.pcpp -r
    pcpp res\tests\expr_primary.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    bools true false
    nil true
    self parent true 105
    parens 20
    literals 42 2.5 text c
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_primary_err_self_main.pcpp
      self in the main block (SM0011)
    expr_primary_err_parent_none.pcpp
      parent in an object with no parent (SM0012)
*******************************************************************************/

module exe expr_primary;

type
  TBase = object
    N: int32;
    method Get(): int32;
    begin
      return self.N;
    end;
  end;
  TKid = object(TBase)
    method Get(): int32;
    begin
      return parent.Get() + 100;
    end;
    method Me(): bool;
    begin
      return self.N = 5;
    end;
  end;

var
  LK: TKid;
  LP: ptr to int32;

begin
  LK.N := 5;
  println("bools {} {}", true, false);
  println("nil {}", LP = nil);
  println("self parent {} {}", LK.Me(), LK.Get());
  println("parens {}", (2 + 3) * 4);
  println("literals {} {} {} {}", 42, 2.5, "text", 'c');
end.
