  decl_exported_err_cpp_hidden.pcpp - break step of decl_exported.pcpp:
  verbatim C++ naming GStep: not exported, so not in the unit's header (clang's error)

  How to check, from repo\bin:
    pcpp res\tests\decl_exported_err_cpp_hidden.pcpp
    pcpp res\tests\decl_exported_err_cpp_hidden.pcpp -t x86_64-linux-gnu
  The marked line reports that code (clang's, through the build);
  nothing else is reported.
*******************************************************************************/

module exe decl_exported_err_cpp_hidden;

import decl_exported_unit;

begin
  println("{}", cpp("::pcpp_m_decl_exported_unit::GStep")); // ERROR ZB0016@51
end.
