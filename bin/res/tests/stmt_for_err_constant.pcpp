  stmt_for_err_constant.pcpp - break step of stmt_for.pcpp:
  a constant as the iterator: for needs a variable (SM0600)

  How to check, from repo\bin:
    pcpp res\tests\stmt_for_err_constant.pcpp
    pcpp res\tests\stmt_for_err_constant.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_for_err_constant;

const
  KC: int32 = 1;

begin
  for KC := 1 to 3 do // ERROR SM0600@3: for needs a variable
  end;
end.
