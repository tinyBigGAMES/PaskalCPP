  lib_plain_host.pcpp - Build-kind compliance: a PaskalCPP program that links
  lib_plain (see lib_plain.pcpp)

  Links lib_plain from where lib_plain.pcpp's commands build it, by name
  (@linklibrary), from each target's folder (@addlibrarypath).

  How to check, from repo\bin (lib_plain.pcpp's two commands first):
    pcpp res\tests\lib_plain_host.pcpp -r
    pcpp res\tests\lib_plain_host.pcpp -r -t x86_64-linux-gnu
  EXPECT:
    lib_plain_add(2, 3) = 5
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run the file below the same way; it reports exactly what the
  // ERROR comment on its marked line says, and nothing else:
    lib_plain_host_err_nolink.pcpp   this program without its @linklibrary line
*******************************************************************************/

module exe lib_plain_host;
@addlibrarypath "$P:output/lib";
@linklibrary "lib_plain";

routine clink lib_plain_add(AA: int32; AB: int32): int32; external;

begin
  println("lib_plain_add(2, 3) = {}", lib_plain_add(2, 3));
end.
