-------------------------------------------------------------------------------
  decl_reserved.pcpp - Declaration: reserved names

  Names starting with pcpp_ belong to the compiler (the C++ it writes uses
  them), so no PaskalCPP declaration may take one: module, const, type,
  field, choice value, variable, routine, parameter, local (the break
  steps decl_reserved_err_*). The rule is case-sensitive, as C++ names are:
  Pcpp_G is free. A name in mixed C++ (struct pcpp_cthing) is C++'s and
  clang's to judge.
*******************************************************************************/

module exe decl_reserved;

/*
  @@test
    kind run
    expect
    | 1 2 3
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

struct pcpp_cthing { int v; };

type
  TOk = record
    Pcpp_Field: int32;
  end;

var
  Pcpp_G: int32;
  LC: pcpp_cthing;
  LR: TOk;

begin
  Pcpp_G := 1;
  LC.v := 2;
  LR.Pcpp_Field := 3;
  println("{} {} {}", Pcpp_G, LC.v, LR.Pcpp_Field);
end.
