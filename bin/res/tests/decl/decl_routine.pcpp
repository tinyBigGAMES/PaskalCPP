-------------------------------------------------------------------------------
  decl_routine.pcpp - Declaration: routines, parameters, bodies

  routine name [param list] [: type]; body (BNF.md sec 3). The param list is
  optional (NoParens has none; a call still writes ()). A parameter is a
  value (a copy: KeepCopy changes its own AN, not the caller's GCount), var
  (the caller's variable itself: Bump, Shift on a record field, SetText on a
  string) or const (read only: Twice, SetText's APart). A routine with a
  return type is a function and returns with return <value>; one without is
  a procedure, called as a statement. A routine body holds any number of
  type, const and var blocks, in any order, before its begin (Blocks: a
  local record type, two const blocks, two var blocks).
*******************************************************************************/

module exe decl_routine;

/*
  @@test
    kind run
    expect
    | Hello from a routine with no parameters
    | NoParens: a routine with no param list
    | Add(2, 3) = 5
    | GCount after two Bump = 3
    | Twice(21) = 42
    | KeepCopy(GCount) = 103, GCount = 3
    | GPoint.X = 5
    | GText = after
    | Blocks(5) = 17
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

type
  TPoint = record
    X: int32;
    Y: int32;
  end;

routine Hello();
begin
  println("Hello from a routine with no parameters");
end;

routine NoParens;
begin
  println("NoParens: a routine with no param list");
end;

routine Add(AA: int32; AB: int32): int32;
begin
  return AA + AB;
end;

routine Bump(var AN: int32);
begin
  AN := AN + 1;
end;

routine Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

routine KeepCopy(AN: int32): int32;
begin
  AN := AN + 100;
  return AN;
end;

routine Shift(var AP: TPoint; const ADX: int32);
begin
  AP.X := AP.X + ADX;
end;

routine SetText(const APart: string; var AOut: string);
begin
  AOut := APart;
end;

routine Blocks(AN: int32): int32;
type
  TPair = record
    A: int32;
    B: int32;
  end;
const
  CBase: int32 = 10;
var
  LPair: TPair;
const
  CStep: int32 = 2;
var
  LSum: int32;
begin
  LPair.A := AN;
  LPair.B := CBase;
  LSum := LPair.A + LPair.B + CStep;
  return LSum;
end;

var
  GCount: int32 = 1;
  GPoint: TPoint;
  GText: string = "before";

begin
  Hello();
  NoParens();
  println("Add(2, 3) = {}", Add(2, 3));
  Bump(GCount);
  Bump(GCount);
  println("GCount after two Bump = {}", GCount);
  println("Twice(21) = {}", Twice(21));
  println("KeepCopy(GCount) = {}, GCount = {}", KeepCopy(GCount), GCount);
  GPoint.X := 1;
  Shift(GPoint, 4);
  println("GPoint.X = {}", GPoint.X);
  SetText("after", GText);
  println("GText = {}", GText);
  println("Blocks(5) = {}", Blocks(5));
end.
