  decl_external_err_lib_name.pcpp - Decl: external, lib name

  Break step of decl_external: a const string that names a path, not a
  library (SM0327).
*******************************************************************************/

module exe decl_external_err_lib_name;

/*
  @@test
    kind error
  @@end
*/

const
  CLibFile: string = "libs/lib_plain.a";

routine clink lib_plain_add(AA: int32; AB: int32): int32; external CLibFile; // ERROR SM0327@68: 'libs/lib_plain.a' is not a library name

begin
  println("{}", lib_plain_add(2, 3));
end.
