module exe decl_variadic_err_overload;

/*
  @@test
    kind error
  @@end
*/

routine Show(...); // ERROR SM0330@1
begin
  println("{}", varargs.count);
end;

routine Show(AN: int32);
begin
  println("{}", AN);
end;

begin
end.
