  decl_overload_err_none.pcpp - Decl: overload, none

  Break step of decl_overload: a call no overload takes: an int32 is no bool
  and no string.
*******************************************************************************/

module exe decl_overload_err_none;

/*
  @@test
    kind error
  @@end
*/

routine Kind(AB: bool): string;
begin
  return "bool";
end;

routine Kind(AS: string): string;
begin
  return "string";
end;

var
  LN: int32 = 5;
  LS: string;

begin
  LS := Kind(LN); // ERROR SM0402@9: no overload of 'Kind' takes (int32)
end.
