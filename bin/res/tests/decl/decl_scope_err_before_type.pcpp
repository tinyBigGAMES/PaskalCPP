module exe decl_scope_err_before_type;

/*
  @@test
    kind error
  @@end
*/

type
  TFirst = TSecond; // ERROR SM0002@12
  TSecond = int32;

var
  GV: TFirst = 1;

begin
  println("{}", GV);
end.
