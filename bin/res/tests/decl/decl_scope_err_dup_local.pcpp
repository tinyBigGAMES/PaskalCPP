module exe decl_scope_err_dup_local;

/*
  @@test
    kind error
  @@end
*/

routine Use(AN: int32): int32;
var
  AN: int32 = 0; // ERROR SM0004@3
begin
  return AN;
end;

begin
  println("{}", Use(1));
end.
