module exe decl_forward_err_only;

/*
  @@test
    kind error
  @@end
*/

forward type TNode;

type
  TBox = record
    Item: TNode; // ERROR SM0300@11
  end;
  TNode = record
    Value: int32;
  end;

begin
end.
