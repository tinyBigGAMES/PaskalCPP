  decl_const_err_fit.pcpp - Decl: const, fit

  Break step of decl_const: a constant that does not fit its type (300 into
  int8).
*******************************************************************************/

module exe decl_const_err_fit;

/*
  @@test
    kind error
  @@end
*/

const
  CSmall: int8 = 300; // ERROR SM0200@18: 300 does not fit in 'int8' (-128..127)

begin
  println("{}", CSmall);
end.
