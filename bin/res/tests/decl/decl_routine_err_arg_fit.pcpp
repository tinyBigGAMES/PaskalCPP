  decl_routine_err_arg_fit.pcpp - Decl: routine, arg fit

  Break step of decl_routine: a constant argument that does not fit its value
  parameter (300 into int8).
*******************************************************************************/

module exe decl_routine_err_arg_fit;

/*
  @@test
    kind error
  @@end
*/

routine Small(AN: int8);
begin
  println("{}", AN);
end;

begin
  Small(300); // ERROR SM0404@9: 300 does not fit in 'int8' (-128..127)
end.
