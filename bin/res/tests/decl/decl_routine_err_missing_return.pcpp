  decl_routine_err_missing_return.pcpp - Decl: routine, missing return

  Break step of decl_routine: a function that can reach its end without
  returning (reported at its end).
*******************************************************************************/

module exe decl_routine_err_missing_return;

/*
  @@test
    kind error
  @@end
*/

routine Sign(AN: int32): int32;
begin
  if AN > 0 then
    return 1;
  end;
end; // ERROR SM0612@1

begin
  println("{}", Sign(1));
end.
