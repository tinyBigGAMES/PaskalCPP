module exe decl_const_err_call;

/*
  @@test
    kind error
  @@end
*/

routine Three(): int32;
begin
  return 3;
end;

const
  CBad: int32 = Three(); // ERROR SM0202@17

begin
  println("{}", CBad);
end.
