module exe decl_routine_err_novalue;

/*
  @@test
    kind error
  @@end
*/

routine Show();
begin
  println("shown");
end;

var
  GX: int32;

begin
  GX := Show(); // ERROR SM0406@9
  println("{}", GX);
end.
