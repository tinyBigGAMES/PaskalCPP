module exe decl_variadic_err_clink_count;

/*
  @@test
    kind error
  @@end
*/

routine clink CCount(AN: int32; ...): int32;
begin
  return varargs.count; // ERROR SM0418@10
end;

begin
  println("{}", CCount(1, 2));
end.
