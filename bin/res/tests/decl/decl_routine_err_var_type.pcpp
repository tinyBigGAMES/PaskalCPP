module exe decl_routine_err_var_type;

/*
  @@test
    kind error
  @@end
*/

routine Bump(var AN: int32);
begin
  AN := AN + 1;
end;

var
  GWide: int64 = 1;

begin
  Bump(GWide); // ERROR SM0405@8
  println("{}", GWide);
end.
