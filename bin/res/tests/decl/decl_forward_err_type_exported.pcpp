  decl_forward_err_type_exported.pcpp - Decl: forward, type exported

  Break step of decl_forward: an exported forward type whose full
  declaration is not exported (SM0306). A lib, where exported means
  something.
*******************************************************************************/

module lib decl_forward_err_type_exported;

/*
  @@test
    kind error
  @@end
*/

exported forward type TItem;

type
  TItem = record // ERROR SM0306@3: one is exported, the other is not
    Value: int32;
  end;

end.
