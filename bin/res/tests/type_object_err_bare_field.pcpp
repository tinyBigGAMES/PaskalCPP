-------------------------------------------------------------------------------
  type_object_err_bare_field.pcpp - break step of type_object.pcpp:
  a field named bare in a method: write self.N (SM0018)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_bare_field.pcpp
    pcpp res\tests\type_object_err_bare_field.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_bare_field;

type
  TA = object
    N: int32;
    method Get(): int32;
    begin
      return N; // ERROR SM0018@14: 'N' is a member of 'TA': write self.N
    end;
  end;

begin
end.
