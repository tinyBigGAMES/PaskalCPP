-------------------------------------------------------------------------------
  type_record_packed_err_upcast.pcpp - break step of type_record_packed.pcpp:
  a packed extension passed to a var parameter of its base: its int32 base part may be misaligned (SM0270)

  How to check, from repo\bin:
    pcpp res\tests\type_record_packed_err_upcast.pcpp
    pcpp res\tests\type_record_packed_err_upcast.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_packed_err_upcast;

type
  TBase = record
    X: int32;
  end;
  TPe = record(TBase) packed
    Y: int8;
  end;

routine Grow(var AB: TBase);
begin
  AB.X := AB.X + 1;
end;

var
  LE: TPe;

begin
  Grow(LE); // ERROR SM0270@8: it may be misaligned
end.
