-------------------------------------------------------------------------------
  type_object_own_err_upcast.pcpp - break step of type_object_own.pcpp:
  an own reaching an ancestor that is not polymorphic: it would free only that part (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_object_own_err_upcast.pcpp
    pcpp res\tests\type_object_own_err_upcast.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_own_err_upcast;

type
  TPlain = object
    X: int32;
  end;
  TKid = object(TPlain)
    Y: int32;
  end;

routine Use();
var
  LA: own TPlain;
begin
  LA := own TKid; // ERROR SM0200@9: 'own TKid' does not convert implicitly to 'own TPlain'
end;

begin
end.
