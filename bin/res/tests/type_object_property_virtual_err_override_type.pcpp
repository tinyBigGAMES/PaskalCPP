-------------------------------------------------------------------------------
  type_object_property_virtual_err_override_type.pcpp - break step of type_object_property_virtual.pcpp:
  an override has its base's type (SM0334)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_override_type.pcpp
    pcpp res\tests\type_object_property_virtual_err_override_type.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_override_type;

type
  TBase = object
    FA: int32;
    virtual property A: int32 read FA; write FA;
  end;
  TKid = object(TBase)
    FB: int64;
    override property A: int64 read FB; // ERROR SM0334@23: must have the type and index of 'TBase.A'
  end;

begin
end.
