-------------------------------------------------------------------------------
  type_set_err_literal_range.pcpp - break step of type_set.pcpp:
  a constant element lies inside the set's range (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_set_err_literal_range.pcpp
    pcpp res\tests\type_set_err_literal_range.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_set_err_literal_range;

type
  TS = set of 0..15;

var
  LS: TS;

begin
  LS := [1, 2];
  LS := [20]; // ERROR SM0200@9: does not convert implicitly to 'TS'
end.
