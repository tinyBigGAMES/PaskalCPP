-------------------------------------------------------------------------------
  type_object_iface_err_not_interface.pcpp - break step of type_object_iface.pcpp:
  an object named after implements: implements names interfaces (SM0362)

  How to check, from repo\bin:
    pcpp res\tests\type_object_iface_err_not_interface.pcpp
    pcpp res\tests\type_object_iface_err_not_interface.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_iface_err_not_interface;

type
  IShape = interface
    method Area(): int32;
  end;
  TPlain = object
    X: int32;
  end;
  TBox = object implements TPlain // ERROR SM0362@28: 'TPlain' is not an interface
  end;

begin
end.
