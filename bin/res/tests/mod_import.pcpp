-------------------------------------------------------------------------------
  mod_import.pcpp - Module compliance: the import clause

  import <unit>, <unit>; (BNF.md sec 1): one clause, right after the directive
  prologue, naming PaskalCPP units only. A unit is found as <name>.pcpp in the
  importing file's folder first (this file's units: mod_import_a.pcpp and
  mod_import_b.pcpp), then in the module paths (dir_addmodulepath.pcpp checks
  that part). An imported unit's exported names are reached qualified only
  (mod_import_a.Sum, mod_import_a.TPair); imports are not transitive. A unit
  imported twice (here mod_import_a, also imported by mod_import_b) is one
  unit. Every module name equals its file name, exact case.

  How to check, from repo\bin:
    pcpp res\tests\mod_import.pcpp -r
    pcpp res\tests\mod_import.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    mod_import_a.Sum(GPair) = 5
    mod_import_b.Triple(4) = 12
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run each file below the same way; each reports exactly what the
  // ERROR / WARN / HINT comment on its marked line says, and nothing else:
    mod_import_err_place.pcpp         an import after a declaration
    mod_import_err_cycle.pcpp         two units that import each other (the report
                                      is in mod_import_err_cycle_b.pcpp)
    mod_import_err_missing.pcpp       a unit no folder holds
    mod_import_err_kind.pcpp          importing a lib (mod_import_err_kind_lib.pcpp)
    mod_import_err_duplicate.pcpp     one unit named twice in the clause
    mod_import_err_noname.pcpp        a name the unit does not declare
    mod_import_err_notexported.pcpp   a name the unit declares but does not export
    mod_import_err_transitive.pcpp    a unit's own import used through it
    mod_import_err_case.pcpp          a module name spelled with other case than
                                      its file name
*******************************************************************************/

module exe mod_import;
import mod_import_b, mod_import_a;

var
  GPair: mod_import_a.TPair;

begin
  GPair.First := 2;
  GPair.Second := 3;
  println("mod_import_a.Sum(GPair) = {}", mod_import_a.Sum(GPair));
  println("mod_import_b.Triple(4) = {}", mod_import_b.Triple(4));
end.
