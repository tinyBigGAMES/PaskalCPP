  mod_import_err_notexported.pcpp - break step of mod_import.pcpp: a name the
  imported unit declares but does not export (mod_import_a's Add)

  How to check, from repo\bin:
    pcpp res\tests\mod_import_err_notexported.pcpp
    pcpp res\tests\mod_import_err_notexported.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe mod_import_err_notexported;
import mod_import_a;

begin
  println("{}", mod_import_a.Add(2, 3)); // ERROR SM0006@17
end.
