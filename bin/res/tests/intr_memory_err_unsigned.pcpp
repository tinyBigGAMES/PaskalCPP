-------------------------------------------------------------------------------
  intr_memory_err_unsigned.pcpp - break step of intr_memory.pcpp:
  getmem given a uint64 size (SM0409)

  How to check, from repo\bin:
    pcpp res\tests\intr_memory_err_unsigned.pcpp
    pcpp res\tests\intr_memory_err_unsigned.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_memory_err_unsigned;

var
  LQ: ptr;
  LN: uint64 = 16;

begin
  LQ := getmem(LN); // ERROR SM0409@16: 'getmem' takes (int64)
end.
