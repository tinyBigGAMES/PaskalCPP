-------------------------------------------------------------------------------
  expr_bitwise_err_bool_and.pcpp - break step of expr_bitwise.pcpp:
  & on two bools (SM0250): the symbols are bitwise and take integers; the
  logical words are and / or / not (xor takes two bools as well)

  How to check, from repo\bin:
    pcpp res\tests\expr_bitwise_err_bool_and.pcpp
    pcpp res\tests\expr_bitwise_err_bool_and.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_bitwise_err_bool_and;

var
  LB: bool = true;
  LC: bool = false;

begin
  LB := LB & LC; // ERROR SM0250@9: operator '&' does not take 'bool' and 'bool'
end.
