-------------------------------------------------------------------------------
  expr_bitwise_err_into_bool.pcpp - break step of expr_bitwise.pcpp:
  the int32 result of & stored into a bool (SM0200): & is bitwise, its
  result is a number; write (LN & 1) <> 0

  How to check, from repo\bin:
    pcpp res\tests\expr_bitwise_err_into_bool.pcpp
    pcpp res\tests\expr_bitwise_err_into_bool.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_bitwise_err_into_bool;

var
  LN: int32 = 5;
  LB: bool;

begin
  LB := LN & 1; // ERROR SM0200@9: 'int32' does not convert implicitly to 'bool'
end.
