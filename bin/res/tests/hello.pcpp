  hello.pcpp

  Hello world - first end-to-end compilation test.

  How to check, from repo\bin:
    pcpp res\tests\hello.pcpp -r
    pcpp res\tests\hello.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    Hello, PaskalCPP! 🚀🔥✨
  EXITCODE: 0
  Both targets print the same.
*******************************************************************************/

module exe hello;

@optimize small;

begin
  println("Hello, {}! 🚀🔥✨", "PaskalCPP");
end.
