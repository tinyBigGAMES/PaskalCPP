-------------------------------------------------------------------------------
  type_object_property_err_read_change.pcpp - break step of type_object_property.pcpp:
  a read changes nothing of self (SM0373)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_err_read_change.pcpp
    pcpp res\tests\type_object_property_err_read_change.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_err_read_change;

type
  TBox = object
    FN: int32;
    property N: int32 read
      begin
        self.FN := 1; // ERROR SM0373@9: the read of 'N' cannot change 'self.FN'
        return self.FN;
      end;
  end;

begin
end.
