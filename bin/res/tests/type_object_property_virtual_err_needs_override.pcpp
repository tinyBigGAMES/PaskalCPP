-------------------------------------------------------------------------------
  type_object_property_virtual_err_needs_override.pcpp - break step of type_object_property_virtual.pcpp:
  a parent's virtual property is continued by override (SM0332)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_needs_override.pcpp
    pcpp res\tests\type_object_property_virtual_err_needs_override.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_needs_override;

type
  TBase = object
    FA: int32;
    virtual property A: int32 read FA; write FA;
  end;
  TKid = object(TBase)
    property A: int32 read FA; // ERROR SM0332@14: 'A' is virtual in 'TBase': write 'override property A'
  end;

begin
end.
