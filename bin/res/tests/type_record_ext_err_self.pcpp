-------------------------------------------------------------------------------
  type_record_ext_err_self.pcpp - break step of type_record_ext.pcpp:
  TShape names itself in its own field with no forward: one report, the uses of the field report nothing more (SM0003)

  How to check, from repo\bin:
    pcpp res\tests\type_record_ext_err_self.pcpp
    pcpp res\tests\type_record_ext_err_self.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_ext_err_self;

type
  TShape = record
    Sides: int32;
    Area: routine(AS: ptr to TShape): int32; // ERROR SM0003@30: names itself
  end;

routine SquareArea(AS: ptr to TShape): int32;
begin
  return AS->Sides;
end;

var
  LS: TShape;

begin
  LS.Area := SquareArea;
  LS.Sides := LS.Area(address of LS);
end.
