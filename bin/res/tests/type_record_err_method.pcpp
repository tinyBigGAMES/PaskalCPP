-------------------------------------------------------------------------------
  type_record_err_method.pcpp - break step of type_record.pcpp:
  a record holds no methods; an object does (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_method.pcpp
    pcpp res\tests\type_record_err_method.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_method;

type
  TR = record
    B: int32;
    method M(); // ERROR PR0034@5: 'method' is not allowed in a record
    begin
    end;
  end;

begin
end.
