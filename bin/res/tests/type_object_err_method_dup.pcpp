-------------------------------------------------------------------------------
  type_object_err_method_dup.pcpp - break step of type_object.pcpp:
  two methods of one name in one object: methods do not overload within a type (SM0004)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_method_dup.pcpp
    pcpp res\tests\type_object_err_method_dup.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_method_dup;

type
  TA = object
    method Put(AN: int32);
    begin
    end;
    method Put(AS: string); // ERROR SM0004@5: 'Put' is already declared in this scope
    begin
    end;
  end;

begin
end.
