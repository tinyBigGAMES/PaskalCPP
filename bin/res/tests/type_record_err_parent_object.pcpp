-------------------------------------------------------------------------------
  type_record_err_parent_object.pcpp - break step of type_record.pcpp:
  an object as a record's parent (SM0308)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_parent_object.pcpp
    pcpp res\tests\type_record_err_parent_object.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_parent_object;

type
  TO = object
    A: int32;
  end;
  TR = record(TO) // ERROR SM0308@15: 'TO' cannot be the parent of a record
    B: int32;
  end;

begin
end.
