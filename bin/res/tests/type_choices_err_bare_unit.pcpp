module exe type_choices_err_bare_unit;

import type_choices_unit;

var
  LU: type_choices_unit.TMode;

begin
  LU := mFast; // ERROR SM0015@9: 'mFast' is a choice value: write type_choices_unit.TMode.mFast
end.
