-------------------------------------------------------------------------------
  type_routine_err_set.pcpp - break step of type_routine.pcpp:
  an overload set with no member of the routine type assigned to it (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_routine_err_set.pcpp
    pcpp res\tests\type_routine_err_set.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_routine_err_set;

routine Over(AN: int32): int32;
begin
  return AN;
end;

routine Over(const AS: string): int32;
begin
  return 0;
end;

var
  LF: routine(AN: float64): int32;

begin
  LF := Over; // ERROR SM0200@9: has no member of type
end.
