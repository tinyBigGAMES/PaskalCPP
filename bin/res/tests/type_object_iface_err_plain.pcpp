  type_object_iface_err_plain.pcpp - break step of type_object_iface.pcpp:
  a plain method fulfilling an interface method: write virtual (SM0365)

  How to check, from repo\bin:
    pcpp res\tests\type_object_iface_err_plain.pcpp
    pcpp res\tests\type_object_iface_err_plain.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_iface_err_plain;

type
  IShape = interface
    method Area(): int32;
  end;
  TBox = object implements IShape // ERROR SM0365@28: write 'virtual method Area'
    method Area(): int32;
    begin
      return 1;
    end;
  end;

begin
end.
