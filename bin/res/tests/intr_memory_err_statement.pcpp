-------------------------------------------------------------------------------
  intr_memory_err_statement.pcpp - break step of intr_memory.pcpp:
  freemem used as a value (SM0408)

  How to check, from repo\bin:
    pcpp res\tests\intr_memory_err_statement.pcpp
    pcpp res\tests\intr_memory_err_statement.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_memory_err_statement;

var
  LP: ptr;
  LQ: ptr;

begin
  LQ := getmem(4);
  LP := freemem(LQ); // ERROR SM0408@9: 'freemem' is a statement, not a value
end.
