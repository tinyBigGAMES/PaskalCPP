-------------------------------------------------------------------------------
  type_object_operator_err_compare.pcpp - break step of type_object_operator.pcpp:
  two objects compared by a type that declares no = (SM0252)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_compare.pcpp
    pcpp res\tests\type_object_operator_err_compare.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_compare;

type
  TTicket = object
    Seat: int32;
  end;

var
  LA: TTicket;
  LB: TTicket;
  LE: bool;
begin
  LE := LA = LB; // ERROR SM0252
end.
