  lex_integers_err_shape.pcpp - break step of lex_integers.pcpp:
  a binary literal with a 2 in it (LX0005)

  How to check, from repo\bin:
    pcpp res\tests\lex_integers_err_shape.pcpp
    pcpp res\tests\lex_integers_err_shape.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_integers_err_shape;

var
  LN: int64;

begin
  LN := 0;
  LN := 0b12; // ERROR LX0005@9: Malformed numeric literal: 0b12
end.
