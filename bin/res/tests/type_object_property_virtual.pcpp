-------------------------------------------------------------------------------
  type_object_property_virtual.pcpp - Type compliance: properties, dispatch and index

  A property takes a method's dispatch words (BNF.md sec 4 property decl):
  - virtual / override / final before property; an override may restate
    its read only (TSquare.Name: LQ.Name := runs TShape's write); read
    abstract; makes the object abstract (TAbs), an override fills it (TCon);
  - an interface holds properties (property X: T read; [write;]); the
    object implements one with a virtual property, its own (TShape) or an
    inherited one (TNamed: TBaseN.Name, forwarded);
  - one index, property Items[const AIndex: T]: U, read and written with
    LO.Items[i]; default makes LO[i] mean it; X OP= v works on both;
  - an embed's property is reached on its owner (LX.N is LX.C.N).

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual.pcpp -r
    pcpp res\tests\type_object_property_virtual.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    [sq] 16
    base 16
    named n!
    15 7
    abs 9
    4
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    type_object_property_virtual_err_needs_override.pcpp  a parent's virtual property redeclared without override
    type_object_property_virtual_err_overrides_nothing.pcpp  override of a property no level above has virtual
    type_object_property_virtual_err_override_final.pcpp  override of a final property
    type_object_property_virtual_err_override_type.pcpp  an override of another type
    type_object_property_virtual_err_override_write.pcpp  an override that adds a write the base has not
    type_object_property_virtual_err_final_plain.pcpp  final on a property that is not virtual
    type_object_property_virtual_err_abstract_plain.pcpp  an abstract accessor of a property that is not virtual
    type_object_property_virtual_err_abstract_value.pcpp  an object with an abstract accessor held by value
    type_object_property_virtual_err_iface_missing.pcpp  an interface property the object does not declare
    type_object_property_virtual_err_iface_plain.pcpp  an interface property implemented by a plain property
    type_object_property_virtual_err_iface_shape.pcpp  an interface property implemented without its write
    type_object_property_virtual_err_iface_hidden.pcpp  an interface property implemented by a hidden property
    type_object_property_virtual_err_iface_body.pcpp  an interface property accessor written abstract
    type_object_property_virtual_err_needs_index.pcpp  an indexed property read without its index
    type_object_property_virtual_err_default_plain.pcpp  default on a property with no index
    type_object_property_virtual_err_default_twice.pcpp  a second default property in one object
    type_object_property_virtual_err_index_binding.pcpp  an indexed property bound to a field
    type_object_property_virtual_err_index_shape.pcpp  an index of two parameters
    type_object_property_virtual_err_parent_name.pcpp  a property named as a field of the parent
*******************************************************************************/

module exe type_object_property_virtual;

type
  IShape = interface
    property Area: int32 read;
    property Name: string read; write;
  end;
  INamed = interface
    property Name: string read; write;
  end;
  TShape = object implements IShape
    FName: string;
    virtual property Area: int32 read
      begin
        return 0;
      end;
    virtual property Name: string read FName; write FName;
  end;
  TSquare = object(TShape)
    FSide: int32;
    override property Area: int32 read
      begin
        return self.FSide * self.FSide;
      end;
    override property Name: string read
      begin
        return "[" + self.FName + "]";
      end;
  end;
  TBaseN = object
    FN: string;
    virtual property Name: string read FN; write FN;
  end;
  TNamed = object(TBaseN) implements INamed
  end;
  TBag = object
    FItems: array[0..3] of int32;
    property Items[const AIndex: int32]: int32 read
      begin
        return self.FItems[AIndex];
      end;
      write(AValue)
      begin
        self.FItems[AIndex] := AValue;
      end;
      default;
  end;
  TAbs = object
    virtual property V: int32 read abstract;
  end;
  TCon = object(TAbs)
    override property V: int32 read
      begin
        return 9;
      end;
  end;
  TCounter = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;
  TBox = object
    embed C: TCounter;
  end;

routine Show(var AS: IShape);
begin
  println("{} {}", AS.Name, AS.Area);
end;

routine ShowBase(var AS: TShape);
begin
  println("base {}", AS.Area);
end;

routine ShowNamed(var AN: INamed);
begin
  AN.Name := AN.Name + "!";
  println("named {}", AN.Name);
end;

routine ShowAbs(var AA: TAbs);
begin
  println("abs {}", AA.V);
end;

var
  LQ: TSquare;
  LN: TNamed;
  LB: TBag;
  LC: TCon;
  LX: TBox;
begin
  LQ.FSide := 4;
  LQ.Name := "sq";
  Show(LQ);
  ShowBase(LQ);
  LN.Name := "n";
  ShowNamed(LN);
  LB[1] := 5;
  LB.Items[2] := 7;
  LB[1] += 10;
  println("{} {}", LB[1], LB.Items[2]);
  ShowAbs(LC);
  LX.N := 3;
  LX.N += 1;
  println("{}", LX.N);
end.
