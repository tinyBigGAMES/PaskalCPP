-------------------------------------------------------------------------------
  type_record_ext_err_value_down.pcpp - break step of type_record_ext.pcpp:
  a TBase value does not convert to its extension TExt (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_record_ext_err_value_down.pcpp
    pcpp res\tests\type_record_ext_err_value_down.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_ext_err_value_down;

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

var
  LB: TBase;
  LE: TExt;

begin
  LE := LB; // ERROR SM0200@9: does not convert implicitly
end.
