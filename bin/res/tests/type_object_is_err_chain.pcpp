-------------------------------------------------------------------------------
  type_object_is_err_chain.pcpp - break step of type_object_is.pcpp:
  is followed by a comparison (is does not chain) (PR0038)

  How to check, from repo\bin:
    pcpp res\tests\type_object_is_err_chain.pcpp
    pcpp res\tests\type_object_is_err_chain.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_is_err_chain;

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;

routine Check(const AShape: TShape; const AB: bool): bool;
begin
  return AShape is TCircle = AB; // ERROR PR0038
end;

begin
end.
