-------------------------------------------------------------------------------
  type_object_err_hidden_overload.pcpp - break step of type_object.pcpp:
  TB.Put(string) hides TA.Put(int32): GB.Put(5) finds only TB.Put, which takes no int32 (SM0404)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_hidden_overload.pcpp
    pcpp res\tests\type_object_err_hidden_overload.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_hidden_overload;

type
  TA = object
    method Put(AN: int32);
    begin
    end;
  end;
  TB = object(TA)
    method Put(AS: string);
    begin
    end;
  end;

var
  GB: TB;

begin
  GB.Put(5); // ERROR SM0404@10: 'int32' does not convert implicitly to 'string'
end.
