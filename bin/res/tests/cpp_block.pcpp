  cpp_block.pcpp - C++ integration compliance: cppstart ... cppend

  A cppstart block (BNF.md sec 10) is C++ PaskalCPP does not parse, copied
  as written: macro-driven code at module level (header or source), C++
  statements in a body (source only, in place). A cppend inside a C++
  string or comment does not end the block.

  How to check, from repo\bin:
    pcpp res\tests\cpp_block.pcpp -r
    pcpp res\tests\cpp_block.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    made 5
    counted 10
    text cppend stays
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    cpp_block_err_target.pcpp
      cppstart takes header or source (PR0015)
    cpp_block_err_header_body.pcpp
      cppstart header inside a body (PR0051)
    cpp_block_err_no_end.pcpp
      a cppstart block that never ends (LX0013)
*******************************************************************************/

module exe cpp_block;

cppstart header
#define MAKE_GETTER(N, V) inline int Get##N() { return V; }
cppend;

cppstart source
MAKE_GETTER(Five, 5)
cppend;

var
  LSum: int32;

begin
  println("made {}", GetFive());
  LSum := 0;
  cppstart source
  for (int LI = 1; LI <= 4; ++LI) { LSum += LI; } // cppend in a comment
  cppend;
  println("counted {}", LSum);
  cppstart source
  const char* LText = "cppend stays";
  cppend;
  println("text {}", cpp("LText"));
end.
