  type_array_err_single_bound.pcpp - break step of type_array.pcpp:
  a static array names both bounds: array[0..4], not array[5] (PR0001)

  How to check, from repo\bin:
    pcpp res\tests\type_array_err_single_bound.pcpp
    pcpp res\tests\type_array_err_single_bound.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_array_err_single_bound;

type
  TA = array[5] of int32; // ERROR PR0001@15: found ']'

begin
end.
