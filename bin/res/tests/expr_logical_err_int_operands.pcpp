  expr_logical_err_int_operands.pcpp - break step of expr_logical.pcpp:
  and on two int32 operands (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\expr_logical_err_int_operands.pcpp
    pcpp res\tests\expr_logical_err_int_operands.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_logical_err_int_operands;

var
  LN: int32;
  LM: int32;

begin
  LN := 1;
  LM := 2;
  if LN and LM then // ERROR SM0250@6: operator 'and' does not take
  end;
end.
