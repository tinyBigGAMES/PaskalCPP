  lex_floats_err_overflow.pcpp - break step of lex_floats.pcpp:
  a float no float64 holds (LX0006)

  How to check, from repo\bin:
    pcpp res\tests\lex_floats_err_overflow.pcpp
    pcpp res\tests\lex_floats_err_overflow.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_floats_err_overflow;

var
  LF: float64;

begin
  LF := 0.0;
  LF := 1e400; // ERROR LX0006@9: Numeric literal out of range: 1e400
end.
