-------------------------------------------------------------------------------
  intr_print_err_cpp_value.pcpp - break step of intr_print.pcpp:
  a C++ value with no formatter printed (SM0425, the emitted check)

  How to check, from repo\bin:
    pcpp res\tests\intr_print_err_cpp_value.pcpp
    pcpp res\tests\intr_print_err_cpp_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_print_err_cpp_value;

struct CNo {
  int x;
};

var
  LV: CNo;

begin
  println("{}", LV); // ERROR SM0425@17
end.
