-------------------------------------------------------------------------------
  type_object_init_err_field_init_order.pcpp - break step of type_object_init.pcpp:
  field inits out of declaration order: fields are built in declaration order (SM0345)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_field_init_order.pcpp
    pcpp res\tests\type_object_init_err_field_init_order.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_field_init_order;

type
  TC = object
    init();
    begin
    end;
  end;
  TB = object
    A: TC;
    B: TC;
    init();
    begin
      self.B.init();
      self.A.init(); // ERROR SM0345@7: self.A.init(...) comes after self.B.init(...)
    end;
  end;

begin
end.
