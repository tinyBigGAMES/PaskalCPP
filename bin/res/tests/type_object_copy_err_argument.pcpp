-------------------------------------------------------------------------------
  type_object_copy_err_argument.pcpp - break step of type_object_copy.pcpp:
  such an object passed by value: the argument would be copied (SM0427)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_argument.pcpp
    pcpp res\tests\type_object_copy_err_argument.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_argument;

type
  TRes = object
    Id: int32;
    done;
    begin
    end;
  end;

routine Take(AR: TRes);
begin
end;

routine Use();
var
  LA: TRes;
begin
  Take(LA); // ERROR SM0427@8: 'LA' would be copied here, and 'TRes' cannot be copied: pass it var / const, return it from a local
end;

begin
end.
