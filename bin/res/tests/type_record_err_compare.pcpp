-------------------------------------------------------------------------------
  type_record_err_compare.pcpp - break step of type_record.pcpp:
  a record has no comparison: compare its fields (SM0252)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_compare.pcpp
    pcpp res\tests\type_record_err_compare.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_compare;

type
  TPoint = record
    X: int32;
    Y: int32;
  end;

var
  LA: TPoint;
  LB: TPoint;
  LSame: bool;

begin
  LSame := LA = LB; // ERROR SM0252@12: cannot compare 'TPoint'
end.
