-------------------------------------------------------------------------------
  type_object_copy_err_slice.pcpp - break step of type_object_copy.pcpp:
  a polymorphic object passed by value as its parent: it would be cut down (SM0428)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_slice.pcpp
    pcpp res\tests\type_object_copy_err_slice.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_slice;

type
  TA = object
    virtual method M();
    begin
    end;
  end;
  TB = object(TA)
    override method M();
    begin
    end;
  end;

routine Take(AA: TA);
begin
end;

routine Use();
var
  LB: TB;
begin
  Take(LB); // ERROR SM0428@8: 'TB' would be cut down to its 'TA' part here
end;

begin
end.
