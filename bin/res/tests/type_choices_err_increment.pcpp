  type_choices_err_increment.pcpp - break step of type_choices.pcpp:
  nor ++ (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_increment.pcpp
    pcpp res\tests\type_choices_err_increment.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_increment;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC++; // ERROR SM0250@3: operator '++' does not take 'TColor'
end.
