  std_sysutils_format_err_const_count.pcpp - Std: sysutils format, const count

  Break step of std_sysutils_format: a string const as the format string, with
  more {} than arguments (SM0502 at the const's use, as for a literal).
*******************************************************************************/

module exe std_sysutils_format_err_const_count;

/*
  @@test
    kind error
  @@end
*/

import
  SysUtils;

const
  KFormat: string = "{} and {}";

var
  LText: string;

begin
  LText := FormatStr(KFormat, 1); // ERROR SM0502@22
  println("{}", LText);
end.
