import
  CustomIO,
  SysUtils;

cpp source;

#include <cstdint>
#include <filesystem>
#include <string>
#include <system_error>

// Removes a file the program wrote (APath already resolved); true when it
// was there and is gone. The UTF-8 path goes in as char8_t, never through
// the ANSI code page (SysUtils' rule); the same form as std_customio_seek's
bool TestDoRemove(const std::string& APath)
{
  std::error_code LError;
  if (APath.empty())
    return false;
  const std::filesystem::path LPath(std::u8string(APath.begin(), APath.end()));
  const bool LRemoved = std::filesystem::remove(LPath, LError);
  return LRemoved && !LError;
}

// Renames AFrom to ATo (both resolved, UTF-8 as above); true when it moved
bool TestDoRename(const std::string& AFrom, const std::string& ATo)
{
  std::error_code LError;
  if (AFrom.empty() || ATo.empty())
    return false;
  const std::filesystem::path LFrom(std::u8string(AFrom.begin(), AFrom.end()));
  const std::filesystem::path LTo(std::u8string(ATo.begin(), ATo.end()));
  std::filesystem::rename(LFrom, LTo, LError);
  return !LError;
}

// The size of the file at APath (resolved, UTF-8 as above) as the file
// system reports it; -1 when there is none
std::int64_t TestDoFileSize(const std::string& APath)
{
  std::error_code LError;
  if (APath.empty())
    return -1;
  const std::filesystem::path LPath(std::u8string(APath.begin(), APath.end()));
  const std::uintmax_t LSize = std::filesystem::file_size(LPath, LError);
  if (LError)
    return -1;
  return static_cast<std::int64_t>(LSize);
}

// AName in the system's temp folder, as UTF-8; "" when there is none. Only
// the Linux rename row uses it (user 2026-10-22): repo\bin\output is /mnt/c
// under WSL, whose DrvFs resizes an open file by its path (measured,
// tests\probe\customio\rename_trunc.c), so only a Linux file system can
// witness a resize through the open handle
std::string TestDoTempPath(const std::string& AName)
{
  std::error_code LError;
  const std::filesystem::path LFolder = std::filesystem::temp_directory_path(LError);
  if (LError)
    return std::string();
  const std::u8string LText = (LFolder / std::filesystem::path(std::u8string(AName.begin(), AName.end()))).u8string();
  return std::string(LText.begin(), LText.end());
}

type
  // A program-defined stream: the bytes 0, 1, 2 ... (mod 256), 300 of them
  CounterData = record
    Position: int64;
  end;

var
  GFails: int32;
  GClosed: int32;
  // What the program-defined source's callbacks last saw
  GSourcePath: string;
  GSourceCalls: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine CounterRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64; var AState: IOState): int64;
var
  LCounter: ptr to CounterData;
  LOut: ptr to uint8;
  LCount: int64;
  LI: int64;
begin
  LCounter := ptr to CounterData(AUserData);
  LOut := ptr to uint8(ABuffer);
  LCount := 300 - LCounter->Position;
  if LCount > ASize then
    LCount := ASize;
  end;
  LI := 0;
  while LI < LCount do
    LOut[LI] := uint8((LCounter->Position + LI) mod 256);
    LI := LI + 1;
  end;
  LCounter->Position := LCounter->Position + LCount;
  return LCount;
end;

routine CounterSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LCounter: ptr to CounterData;
  LTarget: int64;
begin
  LCounter := ptr to CounterData(AUserData);
  LTarget := AOffset;
  if AOrigin = SeekOrigin.FromCurrent then
    LTarget := LCounter->Position + AOffset;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LTarget := 300 + AOffset;
  end;
  if (LTarget < 0) or (LTarget > 300) then
    return -1;
  end;
  LCounter->Position := LTarget;
  return LTarget;
end;

routine CounterTell(const AUserData: ptr): int64;
begin
  return ptr to CounterData(AUserData)->Position;
end;

routine CounterSize(const AUserData: ptr): int64;
begin
  return 300;
end;

routine CounterClose(const AUserData: ptr): bool;
begin
  GClosed := GClosed + 1;
  return true;
end;

// The caller's memory, read / write within its 8 bytes
routine TestCallerMemory();
var
  LBuf: array[0..7] of uint8;
  LOut: array[0..15] of uint8;
  LIn: array[0..1] of uint8;
  LIO: IO;
  LI: int32;
begin
  for LI := 0 to 7 do
    LBuf[LI] := uint8(10 + LI);
  end;
  LIn[0] := 200;
  LIn[1] := 201;
  LIO := CreateMemoryIO(address of LBuf[0], 8);
  Check("mem create", LIO <> nil);
  Check("mem size", IOSize(LIO) = 8);
  Check("mem read 3", IORead(LIO, address of LOut[0], 3) = 3);
  Check("mem read bytes", (LOut[0] = 10) and (LOut[1] = 11) and (LOut[2] = 12));
  Check("mem tell 3", IOTell(LIO) = 3);
  Check("mem status ready", IOStatus(LIO) = IOState.Ready);
  Check("mem seek current", IOSeek(LIO, 2, SeekOrigin.FromCurrent) = 5);
  Check("mem short read", IORead(LIO, address of LOut[0], 10) = 3);
  Check("mem short read bytes", (LOut[0] = 15) and (LOut[2] = 17));
  Check("mem short read eof", IOStatus(LIO) = IOState.Eof);
  Check("mem read at end", IORead(LIO, address of LOut[0], 1) = 0);
  Check("mem read at end eof", IOStatus(LIO) = IOState.Eof);
  Check("mem seek end", IOSeek(LIO, -1, SeekOrigin.FromEnd) = 7);
  Check("mem seek clears eof", IOStatus(LIO) = IOState.Ready);
  Check("mem seek start", IOSeek(LIO, 0, SeekOrigin.FromStart) = 0);
  Check("mem write 2", IOWrite(LIO, address of LIn[0], 2) = 2);
  Check("mem write bytes", (LBuf[0] = 200) and (LBuf[1] = 201) and (LBuf[2] = 12));
  Check("mem write tell", IOTell(LIO) = 2);
  Check("mem seek before start", IOSeek(LIO, -1, SeekOrigin.FromStart) = -1);
  Check("mem seek before start error", IOStatus(LIO) = IOState.Error);
  Check("mem failed seek keeps position", IOTell(LIO) = 2);
  Check("mem seek past end", IOSeek(LIO, 9, SeekOrigin.FromStart) = -1);
  Check("mem seek back past start", IOSeek(LIO, -3, SeekOrigin.FromCurrent) = -1);
  Check("mem seek to end", IOSeek(LIO, 0, SeekOrigin.FromEnd) = 8);
  Check("mem write at end", IOWrite(LIO, address of LIn[0], 2) = 0);
  Check("mem write at end error", IOStatus(LIO) = IOState.Error);
  Check("mem write never grows", IOSize(LIO) = 8);
  Check("mem seek 7", IOSeek(LIO, 7, SeekOrigin.FromStart) = 7);
  Check("mem partial write", IOWrite(LIO, address of LIn[0], 2) = 1);
  Check("mem partial write error", IOStatus(LIO) = IOState.Error);
  Check("mem partial write byte", LBuf[7] = 200);
  Check("mem zero read", IORead(LIO, address of LOut[0], 0) = 0);
  Check("mem flush", IOFlush(LIO));
  Check("mem close", IOClose(LIO));
end;

// The caller's memory, read-only
routine TestReadOnlyMemory();
var
  LBuf: array[0..3] of uint8;
  LOut: array[0..3] of uint8;
  LIO: IO;
begin
  LBuf[0] := 1;
  LBuf[1] := 2;
  LBuf[2] := 3;
  LBuf[3] := 4;
  LIO := CreateMemoryIO(address of LBuf[0], 4, true);
  Check("ro create", LIO <> nil);
  Check("ro read", IORead(LIO, address of LOut[0], 2) = 2);
  Check("ro read bytes", (LOut[0] = 1) and (LOut[1] = 2));
  Check("ro write", IOWrite(LIO, address of LOut[0], 1) = 0);
  Check("ro write readonly", IOStatus(LIO) = IOState.ReadOnly);
  Check("ro memory unchanged", LBuf[2] = 3);
  Check("ro close", IOClose(LIO));
end;

// The IO's own buffer, growing as it is written
routine TestOwnedMemory();
var
  LChunk: array[0..99] of uint8;
  LBig: array[0..999] of uint8;
  LIO: IO;
  LI: int32;
  LPart: int32;
  LTotal: int64;
  LSame: bool;
begin
  LIO := CreateMemoryIO();
  Check("grow create", LIO <> nil);
  Check("grow empty size", IOSize(LIO) = 0);
  Check("grow empty read", IORead(LIO, address of LBig[0], 4) = 0);
  Check("grow empty eof", IOStatus(LIO) = IOState.Eof);
  LTotal := 0;
  for LPart := 0 to 9 do
    for LI := 0 to 99 do
      LChunk[LI] := uint8((LPart * 100 + LI) mod 251);
    end;
    LTotal := LTotal + IOWrite(LIO, address of LChunk[0], 100);
  end;
  Check("grow write 1000", LTotal = 1000);
  Check("grow size 1000", IOSize(LIO) = 1000);
  Check("grow tell 1000", IOTell(LIO) = 1000);
  Check("grow seek start", IOSeek(LIO, 0, SeekOrigin.FromStart) = 0);
  Check("grow read 1000", IORead(LIO, address of LBig[0], 1000) = 1000);
  LSame := true;
  for LI := 0 to 999 do
    if LBig[LI] <> uint8(LI mod 251) then
      LSame := false;
    end;
  end;
  Check("grow read bytes", LSame);
  for LI := 0 to 99 do
    LChunk[LI] := 7;
  end;
  Check("grow seek 500", IOSeek(LIO, 500, SeekOrigin.FromStart) = 500);
  Check("grow overwrite", IOWrite(LIO, address of LChunk[0], 100) = 100);
  Check("grow overwrite keeps size", IOSize(LIO) = 1000);
  Check("grow seek 499", IOSeek(LIO, 499, SeekOrigin.FromStart) = 499);
  Check("grow read across", IORead(LIO, address of LBig[0], 3) = 3);
  Check("grow read across bytes", (LBig[0] = uint8(499 mod 251)) and (LBig[1] = 7) and (LBig[2] = 7));
  Check("grow seek end", IOSeek(LIO, 0, SeekOrigin.FromEnd) = 1000);
  Check("grow append", IOWrite(LIO, address of LChunk[0], 1) = 1);
  Check("grow append size", IOSize(LIO) = 1001);
  Check("grow seek past end", IOSeek(LIO, 1, SeekOrigin.FromEnd) = -1);
  Check("grow close", IOClose(LIO));
end;

// A stream the program defines, and one with only a Read callback
routine TestUserIO();
var
  LCounter: CounterData;
  LCallbacks: IOInterface;
  LOut: array[0..31] of uint8;
  LIO: IO;
begin
  LCounter.Position := 0;
  LCallbacks.Read := CounterRead;
  LCallbacks.Write := nil;
  LCallbacks.Seek := CounterSeek;
  LCallbacks.Tell := CounterTell;
  LCallbacks.Size := CounterSize;
  LCallbacks.Flush := nil;
  LCallbacks.Close := CounterClose;
  GClosed := 0;
  LIO := CreateIO(LCallbacks, address of LCounter);
  Check("user create", LIO <> nil);
  Check("user read 4", IORead(LIO, address of LOut[0], 4) = 4);
  Check("user read bytes", (LOut[0] = 0) and (LOut[3] = 3));
  Check("user write", IOWrite(LIO, address of LOut[0], 1) = 0);
  Check("user write readonly", IOStatus(LIO) = IOState.ReadOnly);
  Check("user flush none", IOFlush(LIO));
  Check("user seek end", IOSeek(LIO, -10, SeekOrigin.FromEnd) = 290);
  Check("user short read", IORead(LIO, address of LOut[0], 20) = 10);
  Check("user short read bytes", (LOut[0] = uint8(290 mod 256)) and (LOut[9] = uint8(299 mod 256)));
  Check("user short read eof", IOStatus(LIO) = IOState.Eof);
  Check("user tell", IOTell(LIO) = 300);
  Check("user size", IOSize(LIO) = 300);
  Check("user close", IOClose(LIO));
  Check("user close called", GClosed = 1);

  LCallbacks.Seek := nil;
  LCallbacks.Tell := nil;
  LCallbacks.Size := nil;
  LCallbacks.Close := nil;
  LCounter.Position := 0;
  LIO := CreateIO(LCallbacks, address of LCounter);
  Check("bare read", IORead(LIO, address of LOut[0], 2) = 2);
  Check("bare seek", IOSeek(LIO, 0, SeekOrigin.FromStart) = -1);
  Check("bare seek error", IOStatus(LIO) = IOState.Error);
  Check("bare tell", IOTell(LIO) = -1);
  Check("bare size", IOSize(LIO) = -1);
  Check("bare close", IOClose(LIO));
  Check("bare close no callback", GClosed = 1);
end;

// The nil handle and invalid memory
routine TestNilAndInvalid();
var
  LBuf: array[0..3] of uint8;
  LIO: IO;
begin
  LIO := nil;
  Check("nil read", IORead(LIO, address of LBuf[0], 4) = 0);
  Check("nil write", IOWrite(LIO, address of LBuf[0], 4) = 0);
  Check("nil seek", IOSeek(LIO, 0, SeekOrigin.FromStart) = -1);
  Check("nil tell", IOTell(LIO) = -1);
  Check("nil size", IOSize(LIO) = -1);
  Check("nil flush", not IOFlush(LIO));
  Check("nil close", not IOClose(LIO));
  Check("nil status", IOStatus(LIO) = IOState.Error);
  Check("invalid nil data", CreateMemoryIO(nil, 4) = nil);
  Check("invalid negative size", CreateMemoryIO(address of LBuf[0], -1) = nil);
  LIO := CreateMemoryIO(nil, 0);
  Check("empty caller memory", LIO <> nil);
  Check("empty read", IORead(LIO, address of LBuf[0], 1) = 0);
  Check("empty read eof", IOStatus(LIO) = IOState.Eof);
  Check("empty close", IOClose(LIO));
end;

// A file IO in every mode, its name not ASCII, in repo\bin\output (the
// program runs from output\bin). The missing file is never created.
routine TestFileIO();
var
  LIn: array[0..7] of uint8;
  LNew: array[0..1] of uint8;
  LOut: array[0..15] of uint8;
  LIO: IO;
  LPath: string;
  LMissing: string;
  LI: int32;
begin
  LPath := "$P:../std_customio_file_ü€.dat";
  LMissing := "$P:../std_customio_missing_ü€.dat";
  for LI := 0 to 7 do
    LIn[LI] := uint8(40 + LI);
  end;
  LNew[0] := 90;
  LNew[1] := 91;

  // Write: created or emptied, write-only; a seek past the end leaves a gap
  LIO := CreateFileIO(LPath, FileMode.Write);
  Check("file write create", LIO <> nil);
  Check("file write 8", IOWrite(LIO, address of LIn[0], 8) = 8);
  Check("file write tell", IOTell(LIO) = 8);
  Check("file write size", IOSize(LIO) = 8);
  Check("file write read", IORead(LIO, address of LOut[0], 1) = 0);
  Check("file write read writeonly", IOStatus(LIO) = IOState.WriteOnly);
  Check("file write seek past end", IOSeek(LIO, 2, SeekOrigin.FromEnd) = 10);
  Check("file write after gap", IOWrite(LIO, address of LIn[0], 2) = 2);
  Check("file write gap size", IOSize(LIO) = 12);
  Check("file write flush", IOFlush(LIO));
  Check("file write close", IOClose(LIO));

  // Read: the bytes as written, the gap zero; read-only
  LIO := CreateFileIO(LPath, FileMode.Read);
  Check("file read create", LIO <> nil);
  Check("file read size", IOSize(LIO) = 12);
  Check("file read all", IORead(LIO, address of LOut[0], 16) = 12);
  Check("file read bytes", (LOut[0] = 40) and (LOut[7] = 47) and (LOut[8] = 0) and (LOut[9] = 0) and (LOut[10] = 40) and (LOut[11] = 41));
  Check("file read eof", IOStatus(LIO) = IOState.Eof);
  Check("file read seek end", IOSeek(LIO, -4, SeekOrigin.FromEnd) = 8);
  Check("file read seek clears eof", IOStatus(LIO) = IOState.Ready);
  Check("file read seek current", IOSeek(LIO, 2, SeekOrigin.FromCurrent) = 10);
  Check("file read after seek", IORead(LIO, address of LOut[0], 1) = 1);
  Check("file read after seek byte", LOut[0] = 40);
  Check("file read seek before start", IOSeek(LIO, -1, SeekOrigin.FromStart) = -1);
  Check("file read seek before start error", IOStatus(LIO) = IOState.Error);
  Check("file read failed seek keeps position", IOTell(LIO) = 11);
  Check("file read write", IOWrite(LIO, address of LIn[0], 1) = 0);
  Check("file read write readonly", IOStatus(LIO) = IOState.ReadOnly);
  Check("file read close", IOClose(LIO));

  // ReadWrite: the file kept; reads and writes turn without a seek between
  LIO := CreateFileIO(LPath, FileMode.ReadWrite);
  Check("file rw create", LIO <> nil);
  Check("file rw keeps size", IOSize(LIO) = 12);
  Check("file rw read 2", IORead(LIO, address of LOut[0], 2) = 2);
  Check("file rw write after read", IOWrite(LIO, address of LNew[0], 2) = 2);
  Check("file rw tell", IOTell(LIO) = 4);
  Check("file rw write 2", IOWrite(LIO, address of LNew[0], 1) = 1);
  Check("file rw read after write", IORead(LIO, address of LOut[0], 1) = 1);
  Check("file rw read after write byte", LOut[0] = 45);
  Check("file rw seek start", IOSeek(LIO, 0, SeekOrigin.FromStart) = 0);
  Check("file rw read 6", IORead(LIO, address of LOut[0], 6) = 6);
  Check("file rw bytes", (LOut[0] = 40) and (LOut[1] = 41) and (LOut[2] = 90) and (LOut[3] = 91) and (LOut[4] = 90) and (LOut[5] = 45));
  Check("file rw size", IOSize(LIO) = 12);
  Check("file rw close", IOClose(LIO));

  // Append: every write at the end whatever the position; write-only
  LIO := CreateFileIO(LPath, FileMode.Append);
  Check("file append create", LIO <> nil);
  Check("file append seek start", IOSeek(LIO, 0, SeekOrigin.FromStart) = 0);
  Check("file append write", IOWrite(LIO, address of LNew[0], 2) = 2);
  Check("file append tell", IOTell(LIO) = 14);
  Check("file append size", IOSize(LIO) = 14);
  Check("file append read", IORead(LIO, address of LOut[0], 1) = 0);
  Check("file append read writeonly", IOStatus(LIO) = IOState.WriteOnly);
  Check("file append close", IOClose(LIO));
  LIO := CreateFileIO(LPath, FileMode.Read);
  Check("file append reread", IORead(LIO, address of LOut[0], 16) = 14);
  Check("file append at end", (LOut[0] = 40) and (LOut[12] = 90) and (LOut[13] = 91));
  Check("file append reread close", IOClose(LIO));

  // No file to open: nil, no crash
  Check("file missing read", CreateFileIO(LMissing, FileMode.Read) = nil);
  Check("file missing readwrite", CreateFileIO(LMissing, FileMode.ReadWrite) = nil);
  Check("file folder", CreateFileIO("$P:..", FileMode.Read) = nil);
  Check("file folder write", CreateFileIO("$P:..", FileMode.Write) = nil);

  // The program wrote the file, so it removes it: nothing is left in
  // repo\bin\output and no later run reads an old copy
  Check("file removed", TestDoRemove(ResolvePath(LPath)));
  Check("file gone", not FileExists(LPath));
end;

// A Write callback that takes everything: an IO that writes but has no
// Truncate callback
routine SinkWrite(const AUserData: ptr; const ABuffer: ptr; const ASize: int64; var AState: IOState): int64;
begin
  return ASize;
end;

// IOTruncate: memory (owned, caller, read-only), an IO without the
// callback, nil, and a file IO (read-ahead and pending writes settled
// first, the position kept past a shorter end, zeros when it grows)
routine TestTruncate();
var
  LBuf: array[0..7] of uint8;
  LIn: array[0..9] of uint8;
  LNew: array[0..1] of uint8;
  LOut: array[0..15] of uint8;
  LCallbacks: IOInterface;
  LIO: IO;
  LOther: IO;
  LPath: string;
  LMoved: string;
  LI: int32;
begin
  for LI := 0 to 9 do
    LIn[LI] := uint8(40 + LI);
  end;
  LNew[0] := 90;
  LNew[1] := 91;

  // Owned memory: shorter moves the position back, longer reads as zeros
  LIO := CreateMemoryIO();
  Check("trunc mem write 10", IOWrite(LIO, address of LIn[0], 10) = 10);
  Check("trunc mem shrink", IOTruncate(LIO, 4));
  Check("trunc mem shrink size", IOSize(LIO) = 4);
  Check("trunc mem shrink tell", IOTell(LIO) = 4);
  Check("trunc mem grow", IOTruncate(LIO, 300));
  Check("trunc mem grow size", IOSize(LIO) = 300);
  Check("trunc mem grow tell", IOTell(LIO) = 4);
  Check("trunc mem grow read", IORead(LIO, address of LOut[0], 4) = 4);
  Check("trunc mem grow zeros", (LOut[0] = 0) and (LOut[3] = 0));
  Check("trunc mem seek start", IOSeek(LIO, 0, SeekOrigin.FromStart) = 0);
  Check("trunc mem kept bytes", (IORead(LIO, address of LOut[0], 5) = 5) and (LOut[0] = 40) and (LOut[3] = 43) and (LOut[4] = 0));
  Check("trunc mem negative", not IOTruncate(LIO, -1));
  Check("trunc mem negative error", IOStatus(LIO) = IOState.Error);
  Check("trunc mem negative keeps size", IOSize(LIO) = 300);
  Check("trunc mem empty", IOTruncate(LIO, 0) and (IOSize(LIO) = 0) and (IOTell(LIO) = 0));
  Check("trunc mem close", IOClose(LIO));

  // Caller memory: the size moves only within the caller's 8 bytes
  for LI := 0 to 7 do
    LBuf[LI] := uint8(10 + LI);
  end;
  LIO := CreateMemoryIO(address of LBuf[0], 8);
  Check("trunc caller shrink", IOTruncate(LIO, 3) and (IOSize(LIO) = 3));
  Check("trunc caller grow", IOTruncate(LIO, 8) and (IOSize(LIO) = 8));
  Check("trunc caller grow zeros", (LBuf[2] = 12) and (LBuf[3] = 0) and (LBuf[7] = 0));
  Check("trunc caller past block", not IOTruncate(LIO, 9));
  Check("trunc caller past block error", IOStatus(LIO) = IOState.Error);
  Check("trunc caller past block keeps size", IOSize(LIO) = 8);
  Check("trunc caller close", IOClose(LIO));

  // Read-only memory cannot change its size
  LIO := CreateMemoryIO(address of LBuf[0], 8, true);
  Check("trunc ro", not IOTruncate(LIO, 2));
  Check("trunc ro readonly", IOStatus(LIO) = IOState.ReadOnly);
  Check("trunc ro keeps size", IOSize(LIO) = 8);
  Check("trunc ro close", IOClose(LIO));

  // An IO that writes but has no Truncate callback
  LCallbacks.Write := SinkWrite;
  LIO := CreateIO(LCallbacks, nil);
  Check("trunc no callback", not IOTruncate(LIO, 0));
  Check("trunc no callback error", IOStatus(LIO) = IOState.Error);
  Check("trunc no callback close", IOClose(LIO));
  Check("trunc nil", not IOTruncate(nil, 0));

  // A file IO, its name not ASCII, in repo\bin\output
  LPath := "$P:../std_customio_trunc_ü€.dat";
  LIO := CreateFileIO(LPath, FileMode.Write);
  Check("trunc file write 8", IOWrite(LIO, address of LIn[0], 8) = 8);
  Check("trunc file write close", IOClose(LIO));
  LIO := CreateFileIO(LPath, FileMode.ReadWrite);
  Check("trunc file read 2", IORead(LIO, address of LOut[0], 2) = 2);
  // The 2-byte read buffered more: those bytes past the new end must go
  Check("trunc file shrink", IOTruncate(LIO, 5));
  Check("trunc file shrink tell", IOTell(LIO) = 2);
  Check("trunc file shrink size", IOSize(LIO) = 5);
  Check("trunc file read after shrink", IORead(LIO, address of LOut[0], 8) = 3);
  Check("trunc file read after shrink bytes", (LOut[0] = 42) and (LOut[2] = 44));
  Check("trunc file seek end", IOSeek(LIO, 0, SeekOrigin.FromEnd) = 5);
  // Buffered writes reach the file before the size changes
  Check("trunc file write 2", IOWrite(LIO, address of LNew[0], 2) = 2);
  Check("trunc file pending", IOTruncate(LIO, 6));
  Check("trunc file pending size", IOSize(LIO) = 6);
  Check("trunc file tell past end", IOTell(LIO) = 7);
  Check("trunc file grow", IOTruncate(LIO, 9));
  Check("trunc file grow size", IOSize(LIO) = 9);
  Check("trunc file seek start", IOSeek(LIO, 0, SeekOrigin.FromStart) = 0);
  Check("trunc file read all", IORead(LIO, address of LOut[0], 16) = 9);
  Check("trunc file bytes", (LOut[0] = 40) and (LOut[4] = 44) and (LOut[5] = 90) and (LOut[6] = 0) and (LOut[8] = 0));
  Check("trunc file negative", not IOTruncate(LIO, -1));
  Check("trunc file negative error", IOStatus(LIO) = IOState.Error);
  Check("trunc file close", IOClose(LIO));
  LIO := CreateFileIO(LPath, FileMode.Read);
  Check("trunc file ro", not IOTruncate(LIO, 0));
  Check("trunc file ro readonly", IOStatus(LIO) = IOState.ReadOnly);
  Check("trunc file ro keeps size", IOSize(LIO) = 9);
  Check("trunc file ro close", IOClose(LIO));
  Check("trunc file removed", TestDoRemove(ResolvePath(LPath)));

  // The resize goes through the open file, never by the path it was opened
  // by: renamed while open, another file put under the old name, the open
  // one is resized and the new one kept. Windows refuses the rename of a
  // file the CRT has open (no share-delete): the resize still reaches it.
  // Linux works in the system temp folder (TestDoTempPath says why).
@ifdef TARGET_X86_64_WINDOWS_GNU
  LPath := "$P:../std_customio_trunc_open.dat";
  LMoved := "$P:../std_customio_trunc_moved.dat";
@else
  LPath := TestDoTempPath("std_customio_trunc_open.dat");
  LMoved := TestDoTempPath("std_customio_trunc_moved.dat");
@endif
  LIO := CreateFileIO(LPath, FileMode.Write);
  Check("trunc renamed write 8", IOWrite(LIO, address of LIn[0], 8) = 8);
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("trunc renamed open refused", not TestDoRename(ResolvePath(LPath), ResolvePath(LMoved)));
  Check("trunc renamed shrink", IOTruncate(LIO, 3));
  Check("trunc renamed io size", IOSize(LIO) = 3);
  Check("trunc renamed close", IOClose(LIO));
  Check("trunc renamed file size", TestDoFileSize(ResolvePath(LPath)) = 3);
  Check("trunc renamed removed", TestDoRemove(ResolvePath(LPath)));
@else
  Check("trunc renamed open", TestDoRename(ResolvePath(LPath), ResolvePath(LMoved)));
  LOther := CreateFileIO(LPath, FileMode.Write);
  Check("trunc renamed other write 2", IOWrite(LOther, address of LNew[0], 2) = 2);
  Check("trunc renamed other write 2 more", IOWrite(LOther, address of LNew[0], 2) = 2);
  Check("trunc renamed other close", IOClose(LOther));
  Check("trunc renamed shrink", IOTruncate(LIO, 3));
  Check("trunc renamed io size", IOSize(LIO) = 3);
  Check("trunc renamed close", IOClose(LIO));
  Check("trunc renamed moved size", TestDoFileSize(ResolvePath(LMoved)) = 3);
  Check("trunc renamed other kept", TestDoFileSize(ResolvePath(LPath)) = 4);
  Check("trunc renamed moved removed", TestDoRemove(ResolvePath(LMoved)));
  Check("trunc renamed other removed", TestDoRemove(ResolvePath(LPath)));
@endif
end;

// A folder source over repo\bin: its entries are files under it, its
// subfolder output reached as "output/..."; a second source over
// repo\bin\output, where a `..` would reach repo\bin\res if it were let out
routine TestFolderSource();
var
  LIn: array[0..4] of uint8;
  LOut: array[0..7] of uint8;
  LSrc: IOSource;
  LOutput: IOSource;
  LIO: IO;
  LEntry: string;
  LRemoved: string;
  LI: int32;
begin
  LEntry := "output/std_customio_src_ü€.dat";
  for LI := 0 to 4 do
    LIn[LI] := uint8(60 + LI);
  end;

  LSrc := CreateFolderIOSource("$P:../..");
  Check("folder create", LSrc <> nil);

  // Write through the source, then read it back by other spellings
  LIO := IOSourceOpen(LSrc, LEntry, FileMode.Write);
  Check("folder write open", LIO <> nil);
  Check("folder write 5", IOWrite(LIO, address of LIn[0], 5) = 5);
  Check("folder write close", IOClose(LIO));
  Check("folder exists", IOSourceExists(LSrc, LEntry));
  Check("folder size", IOSourceSize(LSrc, LEntry) = 5);
  LIO := IOSourceOpen(LSrc, LEntry);
  Check("folder read open", LIO <> nil);
  Check("folder read 5", IORead(LIO, address of LOut[0], 8) = 5);
  Check("folder read bytes", (LOut[0] = 60) and (LOut[4] = 64));
  Check("folder read only", IOWrite(LIO, address of LIn[0], 1) = 0);
  Check("folder read only state", IOStatus(LIO) = IOState.ReadOnly);
  Check("folder read close", IOClose(LIO));
  LIO := IOSourceOpen(LSrc, "./output/none/../std_customio_src_ü€.dat");
  Check("folder dot segments open", LIO <> nil);
  Check("folder dot segments size", IOSize(LIO) = 5);
  Check("folder dot segments close", IOClose(LIO));
  LIO := IOSourceOpen(LSrc, LEntry, FileMode.Append);
  Check("folder append open", LIO <> nil);
  Check("folder append write", IOWrite(LIO, address of LIn[0], 1) = 1);
  Check("folder append close", IOClose(LIO));
  Check("folder append size", IOSourceSize(LSrc, LEntry) = 6);

  // A folder is not an entry; a missing entry is nil / false / -1
  Check("folder subfolder not entry", not IOSourceExists(LSrc, "output"));
  Check("folder subfolder no size", IOSourceSize(LSrc, "output") = -1);
  Check("folder subfolder no open", IOSourceOpen(LSrc, "output") = nil);
  Check("folder missing exists", not IOSourceExists(LSrc, "output/std_customio_src_missing.dat"));
  Check("folder missing size", IOSourceSize(LSrc, "output/std_customio_src_missing.dat") = -1);
  Check("folder missing open", IOSourceOpen(LSrc, "output/std_customio_src_missing.dat") = nil);
  Check("folder missing folder write", IOSourceOpen(LSrc, "output/none/x.dat", FileMode.Write) = nil);

  // Refused spellings, the same on both targets
  Check("folder refuse empty", IOSourceOpen(LSrc, "") = nil);
  Check("folder refuse root", IOSourceOpen(LSrc, ".") = nil);
  Check("folder refuse absolute", IOSourceOpen(LSrc, "/output/std_customio_src_ü€.dat") = nil);
  Check("folder refuse double slash", IOSourceOpen(LSrc, "output//std_customio_src_ü€.dat") = nil);
  Check("folder refuse trailing slash", IOSourceOpen(LSrc, "output/") = nil);
  Check("folder refuse backslash", IOSourceOpen(LSrc, "output\\std_customio_src_ü€.dat") = nil);
  Check("folder refuse colon", IOSourceExists(LSrc, "C:/Windows/win.ini") = false);
  Check("folder refuse wildcard", IOSourceExists(LSrc, "output/*.dat") = false);
  Check("folder refuse trailing dot", IOSourceOpen(LSrc, "output/std_customio_src_dot.", FileMode.Write) = nil);
  Check("folder refuse trailing space", IOSourceOpen(LSrc, "output/std_customio_src_sp ", FileMode.Write) = nil);
  Check("folder refuse device", IOSourceOpen(LSrc, "nul", FileMode.Write) = nil);
  Check("folder refuse device ext", IOSourceOpen(LSrc, "output/Com1.txt", FileMode.Write) = nil);

  // Remove: the entry's file goes; missing, a folder, a refused path: false
  LRemoved := "output/std_customio_src_rm.dat";
  Check("folder can remove", IOSourceCanRemove(LSrc));
  LIO := IOSourceOpen(LSrc, LRemoved, FileMode.Write);
  Check("folder remove made", (LIO <> nil) and (IOWrite(LIO, address of LIn[0], 5) = 5) and IOClose(LIO));
  Check("folder remove", IOSourceRemove(LSrc, "output/none/../std_customio_src_rm.dat"));
  Check("folder remove gone", not IOSourceExists(LSrc, LRemoved));
  Check("folder remove file gone", not FileExists("$P:../std_customio_src_rm.dat"));
  Check("folder remove again", not IOSourceRemove(LSrc, LRemoved));
  Check("folder remove subfolder", not IOSourceRemove(LSrc, "output"));
  Check("folder remove refused path", not IOSourceRemove(LSrc, "../x.dat"));
  Check("folder remove empty path", not IOSourceRemove(LSrc, ""));

  // Remove while an IO on the entry is open: Windows refuses (the file IO
  // does not share deletion), Linux unlinks and the IO reads on
  LIO := IOSourceOpen(LSrc, LRemoved, FileMode.Write);
  Check("folder remove open made", (LIO <> nil) and (IOWrite(LIO, address of LIn[0], 5) = 5) and IOClose(LIO));
  LIO := IOSourceOpen(LSrc, LRemoved);
  Check("folder remove open read", LIO <> nil);
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("folder remove open refused", not IOSourceRemove(LSrc, LRemoved));
  Check("folder remove open kept", IOSourceExists(LSrc, LRemoved));
@else
  Check("folder remove open removed", IOSourceRemove(LSrc, LRemoved));
  Check("folder remove open gone", not IOSourceExists(LSrc, LRemoved));
@endif
  Check("folder remove open reads on", (LIO <> nil) and (IORead(LIO, address of LOut[0], 8) = 5) and (LOut[0] = 60));
  Check("folder remove open close", (LIO <> nil) and IOClose(LIO));
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("folder remove after close", IOSourceRemove(LSrc, LRemoved));
@endif
  Check("folder remove open file gone", not FileExists("$P:../std_customio_src_rm.dat"));
  Check("folder close", IOSourceClose(LSrc));

  // `..` resolves inside the root, never above it
  LOutput := CreateFolderIOSource("$P:..");
  Check("folder output create", LOutput <> nil);
  Check("folder inner dotdot", IOSourceSize(LOutput, "bin/../std_customio_src_ü€.dat") = 6);
  Check("folder escape open", IOSourceOpen(LOutput, "../res/tests/std/std_customio.pcpp") = nil);
  Check("folder escape exists", not IOSourceExists(LOutput, "../res/tests/std/std_customio.pcpp"));
  Check("folder escape size", IOSourceSize(LOutput, "bin/../../res/tests/std/std_customio.pcpp") = -1);
  Check("folder output close", IOSourceClose(LOutput));

  // Not a folder: nil
  Check("folder missing root", CreateFolderIOSource("$P:../std_customio_src_none") = nil);
  Check("folder file root", CreateFolderIOSource("$P:../std_customio_src_ü€.dat") = nil);

  // The source wrote the entry, so the program removes it (after its last
  // use above, the file-root row): nothing is left in repo\bin\output
  Check("folder entry removed", TestDoRemove(ResolvePath("$P:../std_customio_src_ü€.dat")));
  Check("folder entry gone", not FileExists("$P:../std_customio_src_ü€.dat"));
end;

routine UserSourceExists(const AUserData: ptr; const APath: string): bool;
begin
  GSourcePath := APath;
  GSourceCalls := GSourceCalls + 1;
  return true;
end;

routine UserSourceSize(const AUserData: ptr; const APath: string): int64;
begin
  GSourcePath := APath;
  GSourceCalls := GSourceCalls + 1;
  return -7;
end;

routine UserSourceClose(const AUserData: ptr): bool;
begin
  GClosed := GClosed + 1;
  return false;
end;

routine UserSourceRemove(const AUserData: ptr; const APath: string): bool;
begin
  GSourcePath := APath;
  GSourceCalls := GSourceCalls + 1;
  return APath = "a/c.txt";
end;

// A source the program defines: the callbacks see the canonical path only,
// a refused path never reaches them, a nil callback is a clean failure
routine TestUserSource();
var
  LInterface: IOSourceInterface;
  LSrc: IOSource;
begin
  GSourcePath := "";
  GSourceCalls := 0;
  GClosed := 0;
  LInterface.Open := nil;
  LInterface.Exists := UserSourceExists;
  LInterface.Size := UserSourceSize;
  LInterface.Close := UserSourceClose;
  LSrc := CreateIOSource(LInterface, nil);
  Check("source user create", LSrc <> nil);
  Check("source user exists", IOSourceExists(LSrc, "a/./b/../c.txt"));
  Check("source user canonical", GSourcePath = "a/c.txt");
  Check("source user refused", not IOSourceExists(LSrc, "a/../../c.txt"));
  Check("source user refused not called", GSourceCalls = 1);
  Check("source user negative size", IOSourceSize(LSrc, "x") = -1);
  Check("source user size called", (GSourceCalls = 2) and (GSourcePath = "x"));
  Check("source user no open", IOSourceOpen(LSrc, "x") = nil);
  Check("source user no remove", (not IOSourceCanRemove(LSrc)) and (not IOSourceRemove(LSrc, "a/c.txt")));
  Check("source user no remove not called", GSourceCalls = 2);
  Check("source user close result", not IOSourceClose(LSrc));
  Check("source user close called", GClosed = 1);

  // A Remove callback: canonical path, its own result, refused path never sent
  LInterface.Remove := UserSourceRemove;
  LSrc := CreateIOSource(LInterface, nil);
  Check("source user can remove", IOSourceCanRemove(LSrc));
  Check("source user remove", IOSourceRemove(LSrc, "a/./b/../c.txt"));
  Check("source user remove canonical", (GSourceCalls = 3) and (GSourcePath = "a/c.txt"));
  Check("source user remove false", not IOSourceRemove(LSrc, "x"));
  Check("source user remove refused", not IOSourceRemove(LSrc, "/a/c.txt"));
  Check("source user remove refused not called", GSourceCalls = 4);
  Check("source user remove close", not IOSourceClose(LSrc));
  LInterface.Remove := nil;

  // Every callback nil, and the nil source
  LInterface.Exists := nil;
  LInterface.Size := nil;
  LInterface.Close := nil;
  LSrc := CreateIOSource(LInterface, nil);
  Check("source nil exists", not IOSourceExists(LSrc, "x"));
  Check("source nil size", IOSourceSize(LSrc, "x") = -1);
  Check("source nil remove", (not IOSourceCanRemove(LSrc)) and (not IOSourceRemove(LSrc, "x")));
  Check("source nil close", IOSourceClose(LSrc));
  Check("source none open", IOSourceOpen(nil, "x") = nil);
  Check("source none exists", not IOSourceExists(nil, "x"));
  Check("source none size", IOSourceSize(nil, "x") = -1);
  Check("source none remove", (not IOSourceCanRemove(nil)) and (not IOSourceRemove(nil, "x")));
  Check("source none close", not IOSourceClose(nil));
end;

// Reads AIO from where it stands to the end into AWhole (ASize bytes) in
// uneven chunks (1, 7, 4093, 65536 ... bytes: chunk ends land everywhere);
// true when every byte came with the state Ready and one more read reports
// the end (Eof)
routine ReadAll(const AIO: IO; const AWhole: ptr to uint8; const ASize: int64): bool;
var
  LOne: array[0..0] of uint8;
  LDone: int64;
  LAsk: int64;
  LRound: int64;
begin
  LDone := 0;
  LRound := 0;
  while LDone < ASize do
    LAsk := 65536;
    if LRound mod 4 = 0 then
      LAsk := 1;
    end;
    if LRound mod 4 = 1 then
      LAsk := 7;
    end;
    if LRound mod 4 = 2 then
      LAsk := 4093;
    end;
    if LAsk > ASize - LDone then
      LAsk := ASize - LDone;
    end;
    if IORead(AIO, AWhole + LDone, LAsk) <> LAsk then
      return false;
    end;
    if IOStatus(AIO) <> IOState.Ready then
      return false;
    end;
    LDone := LDone + LAsk;
    LRound := LRound + 1;
  end;
  if IORead(AIO, address of LOne[0], 1) <> 0 then
    return false;
  end;
  return IOStatus(AIO) = IOState.Eof;
end;

// Checks an entry IO against its whole content, then closes it: read from
// the start to the end (the CRC is checked there), 48 reads after seeks
// from every origin, forward and back in a fixed pseudo-random order, each
// compared with the whole; the very start and end, seeks out of range, no
// writing. One row per part, named after ALabel.
routine CheckIO(const AIO: IO; const ALabel: string; const ASize: int64);
var
  LWhole: ptr to uint8;
  LPiece: array[0..4095] of uint8;
  LSeed: int64;
  LRound: int32;
  LTarget: int64;
  LLength: int64;
  LAt: int64;
  LGot: int64;
  LI: int64;
  LBad: int32;
  LOk: bool;
begin
  Check(ALabel + " open", AIO <> nil);
  if AIO = nil then
    return;
  end;
  Check(ALabel + " size", IOSize(AIO) = ASize);
  LWhole := nil;
  if ASize > 0 then
    LWhole := ptr to uint8(getmem(ASize));
  end;
  LOk := ReadAll(AIO, LWhole, ASize);
  Check(ALabel + " read all", LOk and (IOTell(AIO) = ASize));
  // A linear congruential walk (no overflow in int64): target, length, origin
  LBad := 0;
  LSeed := 20261021;
  LRound := 0;
  while (LRound < 48) and (ASize > 0) do
    LSeed := (LSeed * 1103515245 + 12345) mod 2147483648;
    LTarget := LSeed mod ASize;
    LSeed := (LSeed * 1103515245 + 12345) mod 2147483648;
    LLength := 1 + LSeed mod 4096;
    if LLength > ASize - LTarget then
      LLength := ASize - LTarget;
    end;
    LAt := -1;
    if LRound mod 3 = 0 then
      LAt := IOSeek(AIO, LTarget, SeekOrigin.FromStart);
    end;
    if LRound mod 3 = 1 then
      LAt := IOSeek(AIO, LTarget - IOTell(AIO), SeekOrigin.FromCurrent);
    end;
    if LRound mod 3 = 2 then
      LAt := IOSeek(AIO, LTarget - ASize, SeekOrigin.FromEnd);
    end;
    LGot := IORead(AIO, address of LPiece[0], LLength);
    if (LAt <> LTarget) or (LGot <> LLength) then
      LBad := LBad + 1;
    end;
    LI := 0;
    while LI < LGot do
      if LPiece[LI] <> LWhole[LTarget + LI] then
        LBad := LBad + 1;
      end;
      LI := LI + 1;
    end;
    LRound := LRound + 1;
  end;
  Check(ALabel + " seeks", LBad = 0);
  // The first and last byte, the end, and seeks out of range (they fail and
  // leave the position)
  LOk := IOSeek(AIO, 0, SeekOrigin.FromStart) = 0;
  if ASize > 0 then
    LGot := IORead(AIO, address of LPiece[0], 1);
    LOk := LOk and (LGot = 1) and (LPiece[0] = LWhole[0]);
    LAt := IOSeek(AIO, -1, SeekOrigin.FromEnd);
    LGot := IORead(AIO, address of LPiece[0], 1);
    LOk := LOk and (LAt = ASize - 1) and (LGot = 1) and (LPiece[0] = LWhole[ASize - 1]);
  end;
  LAt := IOSeek(AIO, 0, SeekOrigin.FromEnd);
  LGot := IORead(AIO, address of LPiece[0], 1);
  LOk := LOk and (LAt = ASize) and (LGot = 0) and (IOStatus(AIO) = IOState.Eof);
  LAt := IOSeek(AIO, 1, SeekOrigin.FromEnd);
  LOk := LOk and (LAt = -1) and (IOStatus(AIO) = IOState.Error);
  LAt := IOSeek(AIO, -1, SeekOrigin.FromStart);
  LOk := LOk and (LAt = -1) and (IOTell(AIO) = ASize);
  Check(ALabel + " ends", LOk);
  LGot := IOWrite(AIO, address of LPiece[0], 1);
  Check(ALabel + " read only", (LGot = 0) and (IOStatus(AIO) = IOState.ReadOnly));
  if LWhole <> nil then
    freemem(LWhole);
  end;
  Check(ALabel + " close", IOClose(AIO));
end;

// CheckIO over the entry APath of ASource
routine CheckEntry(const ASource: IOSource; const APath: string; const ALabel: string; const ASize: int64);
begin
  CheckIO(IOSourceOpen(ASource, APath), ALabel, ASize);
end;

// Zip sources over the fixtures in repo\bin\res\tests (written by
// scripts\customio\gen_zips.py, never by hand): their directories, by path,
// by a caller's IO and from memory; broken archives give nil
routine TestZipSource();
var
  LChunk: array[0..255] of uint8;
  LZip: IOSource;
  LFile: IO;
  LMemory: IO;
  LNone: IO;
  LIO: IO;
  LGot: int64;
begin
  // Stored entries, every kind of name
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_stored.zip");
  Check("zip stored create", LZip <> nil);
  Check("zip stored exists", IOSourceExists(LZip, "hello.txt"));
  Check("zip stored size", IOSourceSize(LZip, "hello.txt") = 12);
  Check("zip stored nested size", IOSourceSize(LZip, "data/bytes.bin") = 256);
  Check("zip stored empty exists", IOSourceExists(LZip, "empty.txt"));
  Check("zip stored empty size", IOSourceSize(LZip, "empty.txt") = 0);
  Check("zip stored folder not entry", not IOSourceExists(LZip, "data"));
  Check("zip stored folder no size", IOSourceSize(LZip, "data") = -1);
  Check("zip stored utf8 name", IOSourceSize(LZip, "ü€.txt") = 10);
  Check("zip stored cp437 name", IOSourceSize(LZip, "cp437_ü.txt") = 6);
  Check("zip stored unicode path name", IOSourceSize(LZip, "upath_€.txt") = 6);
  Check("zip stored unicode path not raw", not IOSourceExists(LZip, "upath_¢.txt"));
  Check("zip stored stale unicode path", IOSourceSize(LZip, "stale_ü.txt") = 6);
  Check("zip stored stale name unused", not IOSourceExists(LZip, "stale_X.txt"));
  Check("zip stored dotdot unreachable", not IOSourceExists(LZip, "evil.txt"));
  Check("zip stored absolute unreachable", not IOSourceExists(LZip, "abs.txt"));
  Check("zip stored backslash unreachable", not IOSourceExists(LZip, "back/slash.txt"));
  Check("zip stored later duplicate", IOSourceSize(LZip, "dup.txt") = 6);
  Check("zip stored case exact", not IOSourceExists(LZip, "HELLO.TXT"));
  Check("zip stored dot segments", IOSourceSize(LZip, "data/../hello.txt") = 12);
  Check("zip stored missing exists", not IOSourceExists(LZip, "missing.txt"));
  Check("zip stored missing size", IOSourceSize(LZip, "missing.txt") = -1);
  Check("zip stored no remove", (not IOSourceCanRemove(LZip)) and (not IOSourceRemove(LZip, "hello.txt")));
  Check("zip stored remove kept", IOSourceSize(LZip, "hello.txt") = 12);
  Check("zip stored refused path", not IOSourceExists(LZip, "../hello.txt"));
  Check("zip stored close", IOSourceClose(LZip));

  // Deflated entries, the archive a file IO the caller keeps
  LFile := CreateFileIO("$P:../../res/tests/std/fixtures/std_customio_deflated.zip", FileMode.Read);
  Check("zip io file open", LFile <> nil);
  LZip := CreateZipIOSource(LFile);
  Check("zip io create", LZip <> nil);
  Check("zip io deflated text size", IOSourceSize(LZip, "text.txt") = 8200);
  Check("zip io deflated random size", IOSourceSize(LZip, "random.bin") = 3000);
  Check("zip io close", IOSourceClose(LZip));
  Check("zip io archive kept", IOSeek(LFile, 0, SeekOrigin.FromStart) = 0);
  Check("zip io archive close", IOClose(LFile));

  // The archive in memory: the nested fixture copied into a memory IO
  LFile := CreateFileIO("$P:../../res/tests/std/fixtures/std_customio_nested.zip", FileMode.Read);
  LMemory := CreateMemoryIO();
  LGot := IORead(LFile, address of LChunk[0], 256);
  while LGot > 0 do
    IOWrite(LMemory, address of LChunk[0], LGot);
    LGot := IORead(LFile, address of LChunk[0], 256);
  end;
  Check("zip memory copied", IOSize(LMemory) = IOSize(LFile));
  Check("zip memory file close", IOClose(LFile));
  LZip := CreateZipIOSource(LMemory);
  Check("zip memory create", LZip <> nil);
  Check("zip memory deep entry", IOSourceSize(LZip, "nested/a/b/c.txt") = 2);
  Check("zip memory entry", IOSourceSize(LZip, "nested/a/d.txt") = 2);
  Check("zip memory top entry", IOSourceSize(LZip, "top.txt") = 4);
  Check("zip memory folder not entry", not IOSourceExists(LZip, "nested/a/b"));
  Check("zip memory close", IOSourceClose(LZip));
  Check("zip memory archive close", IOClose(LMemory));

  // ZIP64 records, data before the archive, encrypted entries
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_zip64.zip");
  Check("zip zip64 create", LZip <> nil);
  Check("zip zip64 stored size", IOSourceSize(LZip, "z64/a.txt") = 13);
  Check("zip zip64 deflated size", IOSourceSize(LZip, "z64/b.bin") = 4096);
  Check("zip zip64 close", IOSourceClose(LZip));
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_prefixed.zip");
  Check("zip prefixed create", LZip <> nil);
  Check("zip prefixed deep entry", IOSourceSize(LZip, "nested/a/b/c.txt") = 2);
  Check("zip prefixed top entry", IOSourceSize(LZip, "top.txt") = 4);
  Check("zip prefixed close", IOSourceClose(LZip));
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_password.zip", "pcpp-secret");
  Check("zip password create", LZip <> nil);
  Check("zip password stored size", IOSourceSize(LZip, "secret.txt") = 11);
  Check("zip password deflated size", IOSourceSize(LZip, "secret_deflated.txt") = 1024);
  Check("zip password plain size", IOSourceSize(LZip, "plain.txt") = 11);
  CheckEntry(LZip, "secret.txt", "zip password read stored", 11);
  CheckEntry(LZip, "secret_deflated.txt", "zip password read deflated", 1024);
  CheckEntry(LZip, "plain.txt", "zip password read plain", 11);
  Check("zip password close", IOSourceClose(LZip));
  // A wrong password: the directory reads, the encrypted entries do not open
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_password.zip", "wrong-pass");
  Check("zip password wrong create", LZip <> nil);
  Check("zip password wrong stored", IOSourceOpen(LZip, "secret.txt") = nil);
  Check("zip password wrong deflated", IOSourceOpen(LZip, "secret_deflated.txt") = nil);
  LIO := IOSourceOpen(LZip, "plain.txt");
  Check("zip password wrong plain", LIO <> nil);
  Check("zip password wrong plain close", IOClose(LIO));
  Check("zip password wrong close", IOSourceClose(LZip));
  // No password: the same
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_password.zip");
  Check("zip password directory without it", IOSourceExists(LZip, "secret.txt"));
  Check("zip password none stored", IOSourceOpen(LZip, "secret.txt") = nil);
  Check("zip password none deflated", IOSourceOpen(LZip, "secret_deflated.txt") = nil);
  Check("zip password no password close", IOSourceClose(LZip));

  // Not a zip, or a broken one: nil
  Check("zip refuse truncated", CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_truncated.zip") = nil);
  Check("zip refuse bad signature", CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_badsig.zip") = nil);
  Check("zip refuse not zip", CreateZipIOSource("$P:../../res/tests/std/std_customio.pcpp") = nil);
  Check("zip refuse missing file", CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_none.zip") = nil);
  LNone := nil;
  Check("zip refuse nil io", CreateZipIOSource(LNone) = nil);
  Check("zip refuse nil io password", CreateZipIOSource(LNone, "x") = nil);
  LMemory := CreateMemoryIO();
  Check("zip refuse empty io", CreateZipIOSource(LMemory) = nil);
  Check("zip refuse empty io kept", IOClose(LMemory));
end;

// Zip entries as IOs: every kind of fixture entry read whole and by seeks
// (read whole on open, direct offsets, access points; ZipCrypto), two
// entries read in turns, an entry IO outliving its source, passwords wrong
// and missing on the large entries, CRCs that do not match, the large
// archive in memory behind data of its own, an empty archive, and one entry
// straight from an archive (CreateZipFileIO) with its content checked
routine TestZipEntries();
var
  LA: array[0..999] of uint8;
  LB: array[0..999] of uint8;
  LA2: array[0..999] of uint8;
  LB2: array[0..999] of uint8;
  LPiece: array[0..4095] of uint8;
  LZip: IOSource;
  LFile: IO;
  LMemory: IO;
  LNone: IO;
  LIO: IO;
  LIOB: IO;
  LIO2: IO;
  LIOB2: IO;
  LGot: int64;
  LTotal: int64;
  LI: int64;
  LJ: int64;
  LBad: int32;
  LSame: bool;
begin
  // Small entries: read whole when opened
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_stored.zip");
  CheckEntry(LZip, "hello.txt", "entry stored hello", 12);
  CheckEntry(LZip, "data/bytes.bin", "entry stored bytes", 256);
  CheckEntry(LZip, "empty.txt", "entry stored empty", 0);
  CheckEntry(LZip, "ü€.txt", "entry stored utf8", 10);
  Check("entry stored folder no open", IOSourceOpen(LZip, "data") = nil);
  Check("entry stored missing no open", IOSourceOpen(LZip, "missing.txt") = nil);
  Check("entry stored write refused", IOSourceOpen(LZip, "hello.txt", FileMode.Write) = nil);
  Check("entry stored close", IOSourceClose(LZip));
  LFile := CreateFileIO("$P:../../res/tests/std/fixtures/std_customio_deflated.zip", FileMode.Read);
  LZip := CreateZipIOSource(LFile);
  CheckEntry(LZip, "text.txt", "entry deflated text", 8200);
  CheckEntry(LZip, "random.bin", "entry deflated random", 3000);
  Check("entry deflated close", IOSourceClose(LZip));
  Check("entry deflated archive close", IOClose(LFile));
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_zip64.zip");
  CheckEntry(LZip, "z64/a.txt", "entry zip64 stored", 13);
  CheckEntry(LZip, "z64/b.bin", "entry zip64 deflated", 4096);
  Check("entry zip64 close", IOSourceClose(LZip));
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_prefixed.zip");
  CheckEntry(LZip, "nested/a/b/c.txt", "entry prefixed", 2);
  Check("entry prefixed close", IOSourceClose(LZip));

  // Past 256 KB: read in place (direct offsets, access points), encrypted too
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_large.zip", "pcpp-secret");
  Check("entry large create", LZip <> nil);
  CheckEntry(LZip, "big_stored.bin", "entry large stored", 262200);
  CheckEntry(LZip, "big_secret_stored.bin", "entry large secret stored", 262300);
  CheckEntry(LZip, "big_text.txt", "entry large deflated", 2400000);
  CheckEntry(LZip, "big_secret_text.txt", "entry large secret deflated", 2300000);
  Check("entry large write refused", IOSourceOpen(LZip, "big_text.txt", FileMode.Append) = nil);

  // Two entries read in turns, each against a second IO of its own entry
  // read alone: every read finds its own place in the shared archive
  LIO := IOSourceOpen(LZip, "big_text.txt");
  LIOB := IOSourceOpen(LZip, "big_secret_text.txt");
  LIO2 := IOSourceOpen(LZip, "big_text.txt");
  LIOB2 := IOSourceOpen(LZip, "big_secret_text.txt");
  Check("entry turns open", (LIO <> nil) and (LIOB <> nil) and (LIO2 <> nil) and (LIOB2 <> nil));
  LBad := 0;
  LI := 0;
  while LI < 8 do
    // A walks back from the end, B forward from the start
    IOSeek(LIO, 2399000 - LI * 300000, SeekOrigin.FromStart);
    IOSeek(LIOB, LI * 280000, SeekOrigin.FromStart);
    if IORead(LIO, address of LA[0], 1000) <> 1000 then
      LBad := LBad + 1;
    end;
    if IORead(LIOB, address of LB[0], 1000) <> 1000 then
      LBad := LBad + 1;
    end;
    IOSeek(LIO2, 2399000 - LI * 300000, SeekOrigin.FromStart);
    IOSeek(LIOB2, LI * 280000, SeekOrigin.FromStart);
    if IORead(LIO2, address of LA2[0], 1000) <> 1000 then
      LBad := LBad + 1;
    end;
    if IORead(LIOB2, address of LB2[0], 1000) <> 1000 then
      LBad := LBad + 1;
    end;
    LJ := 0;
    while LJ < 1000 do
      if (LA[LJ] <> LA2[LJ]) or (LB[LJ] <> LB2[LJ]) then
        LBad := LBad + 1;
      end;
      LJ := LJ + 1;
    end;
    LI := LI + 1;
  end;
  Check("entry turns", LBad = 0);
  LSame := IOClose(LIO);
  LSame := IOClose(LIOB) and LSame;
  LSame := IOClose(LIO2) and LSame;
  LSame := IOClose(LIOB2) and LSame;
  Check("entry turns close", LSame);

  // An entry IO keeps the archive open after its source is closed
  LIO := IOSourceOpen(LZip, "big_secret_text.txt");
  Check("entry large close", IOSourceClose(LZip));
  CheckIO(LIO, "entry outlives source", 2300000);

  // A wrong password: the encrypted large entries do not open
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_large.zip", "wrong-pass");
  Check("entry large wrong stored", IOSourceOpen(LZip, "big_secret_stored.bin") = nil);
  Check("entry large wrong deflated", IOSourceOpen(LZip, "big_secret_text.txt") = nil);
  LIO := IOSourceOpen(LZip, "big_stored.bin");
  Check("entry large wrong plain", LIO <> nil);
  Check("entry large wrong plain close", IOClose(LIO));
  Check("entry large wrong close", IOSourceClose(LZip));

  // CRCs that do not match: a small entry does not open; a large one
  // fails the read that reaches the end, and stays failed
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_badcrc.zip");
  Check("entry bad crc small", IOSourceOpen(LZip, "bad.txt") = nil);
  LIO := IOSourceOpen(LZip, "good.txt");
  Check("entry bad crc good", LIO <> nil);
  Check("entry bad crc good close", IOClose(LIO));
  LIO := IOSourceOpen(LZip, "big_bad.txt");
  Check("entry bad crc large open", LIO <> nil);
  LTotal := 0;
  LGot := IORead(LIO, address of LPiece[0], 4096);
  while LGot > 0 do
    LTotal := LTotal + LGot;
    LGot := IORead(LIO, address of LPiece[0], 4096);
  end;
  Check("entry bad crc large read", (LTotal = 300000) and (IOStatus(LIO) = IOState.Error));
  IOSeek(LIO, 0, SeekOrigin.FromStart);
  LGot := IORead(LIO, address of LPiece[0], 16);
  Check("entry bad crc large stays failed", (LGot = 0) and (IOStatus(LIO) = IOState.Error));
  Check("entry bad crc large close", IOClose(LIO));
  Check("entry bad crc close", IOSourceClose(LZip));

  // The large archive in memory behind 333 bytes of other data: the
  // in-place reading counts the data before the archive in
  LMemory := CreateMemoryIO();
  LI := 0;
  while LI < 333 do
    LPiece[LI] := 74;
    LI := LI + 1;
  end;
  IOWrite(LMemory, address of LPiece[0], 333);
  LFile := CreateFileIO("$P:../../res/tests/std/fixtures/std_customio_large.zip", FileMode.Read);
  LGot := IORead(LFile, address of LPiece[0], 4096);
  while LGot > 0 do
    IOWrite(LMemory, address of LPiece[0], LGot);
    LGot := IORead(LFile, address of LPiece[0], 4096);
  end;
  Check("entry memory copied", IOSize(LMemory) = IOSize(LFile) + 333);
  Check("entry memory file close", IOClose(LFile));
  LZip := CreateZipIOSource(LMemory, "pcpp-secret");
  Check("entry memory create", LZip <> nil);
  CheckEntry(LZip, "big_stored.bin", "entry memory large stored", 262200);
  CheckEntry(LZip, "big_secret_text.txt", "entry memory large secret deflated", 2300000);
  Check("entry memory close", IOSourceClose(LZip));
  Check("entry memory archive close", IOClose(LMemory));

  // An archive with no entries
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_empty.zip");
  Check("entry empty archive create", LZip <> nil);
  Check("entry empty archive no entry", not IOSourceExists(LZip, "x"));
  Check("entry empty archive no open", IOSourceOpen(LZip, "x") = nil);
  Check("entry empty archive close", IOSourceClose(LZip));

  // One entry straight from an archive, its content checked
  LIO := CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_stored.zip", "hello.txt");
  LGot := IORead(LIO, address of LPiece[0], 64);
  // "Hello, zip!\n"
  Check("file io hello", (LGot = 12) and (LPiece[0] = 72) and (LPiece[5] = 44) and (LPiece[11] = 10));
  Check("file io hello close", IOClose(LIO));
  LIO := CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_stored.zip", "data/bytes.bin");
  LGot := IORead(LIO, address of LPiece[0], 4096);
  LSame := LGot = 256;
  LI := 0;
  while LI < 256 do
    if LPiece[LI] <> uint8(LI) then
      LSame := false;
    end;
    LI := LI + 1;
  end;
  Check("file io bytes", LSame);
  Check("file io bytes close", IOClose(LIO));
  LIO := CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_password.zip", "secret.txt", "pcpp-secret");
  LGot := IORead(LIO, address of LPiece[0], 64);
  // "top secret\n"
  Check("file io secret", (LGot = 11) and (LPiece[0] = 116) and (LPiece[4] = 115) and (LPiece[10] = 10));
  Check("file io secret close", IOClose(LIO));
  LIO := CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_password.zip", "secret_deflated.txt", "pcpp-secret");
  LGot := IORead(LIO, address of LPiece[0], 4096);
  // "deflated secret " 64 times
  LSame := (LGot = 1024) and (LPiece[0] = 100) and (LPiece[15] = 32);
  LI := 16;
  while LI < 1024 do
    if LPiece[LI] <> LPiece[LI - 16] then
      LSame := false;
    end;
    LI := LI + 1;
  end;
  Check("file io secret deflated", LSame);
  Check("file io secret deflated close", IOClose(LIO));
  LFile := CreateFileIO("$P:../../res/tests/std/fixtures/std_customio_deflated.zip", FileMode.Read);
  CheckIO(CreateZipFileIO(LFile, "text.txt"), "file io by io", 8200);
  Check("file io by io archive kept", IOSeek(LFile, 0, SeekOrigin.FromStart) = 0);
  Check("file io by io archive close", IOClose(LFile));
  CheckIO(CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_large.zip", "big_text.txt"), "file io large", 2400000);
  Check("file io missing entry", CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_stored.zip", "missing.txt") = nil);
  Check("file io not zip", CreateZipFileIO("$P:../../res/tests/std/std_customio.pcpp", "hello.txt") = nil);
  Check("file io wrong password", CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_password.zip", "secret.txt", "wrong-pass") = nil);
  Check("file io no password", CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_password.zip", "secret.txt") = nil);
  LNone := nil;
  Check("file io nil archive", CreateZipFileIO(LNone, "hello.txt") = nil);
end;

begin
  GFails := 0;
  TestCallerMemory();
  TestReadOnlyMemory();
  TestOwnedMemory();
  TestUserIO();
  TestNilAndInvalid();
  TestFileIO();
  TestTruncate();
  TestFolderSource();
  TestUserSource();
  TestZipSource();
  TestZipEntries();
  println("done {}", GFails);
end.
