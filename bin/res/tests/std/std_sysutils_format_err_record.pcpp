-------------------------------------------------------------------------------
  std_sysutils_format_err_record.pcpp - Std: sysutils format, record

  Break step of std_sysutils_format: a record as an argument (SM0425 at the
  argument, as println reports it).
*******************************************************************************/

module exe std_sysutils_format_err_record;

/*
  @@test
    kind error
  @@end
*/

import
  SysUtils;

type
  TPoint = record
    X: int32;
    Y: int32;
  end;

var
  LPoint: TPoint;
  LText: string;

begin
  LPoint.X := 1;
  LPoint.Y := 2;
  LText := FormatStr("{}", LPoint); // ERROR SM0425@28
  println("{}", LText);
end.
