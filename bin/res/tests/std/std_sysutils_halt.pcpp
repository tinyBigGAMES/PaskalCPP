-------------------------------------------------------------------------------
  std_sysutils_halt.pcpp - Std: SysUtils Halt

  Halt(7) ends the program at once with exit code 7, from inside a routine
  two calls down: the lines printed before it are all out (the exit work
  flushes them, the heap report is printed), and nothing after the call
  runs (no "not reached" line, the main block's last line never prints).
*******************************************************************************/

module exe std_sysutils_halt;

/*
  @@test
    kind run
    exitcode 7
    expect
    | before halt
    | in leave
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

import SysUtils;

routine Leave();
begin
  println("in leave");
  Halt(7);
  println("not reached in leave");
end;

routine Outer();
begin
  Leave();
  println("not reached in outer");
end;

begin
  println("before halt");
  Outer();
  println("not reached in main");
end.
