-------------------------------------------------------------------------------
  std_hookabi_rt.pcpp - std compliance: HookABI's run-time level

  `import HookABI;` HookInstall puts a replacement into the import slot of a
  name in every loaded module, and into every module loaded later;
  HookUninstall gives each slot back exactly what it held. The name hooked
  is the C runtime's getenv: the replacement answers STD_HOOKABI_RT with
  "hooked" and passes every other name to the record's Original.

  Covered: the refusals (nil name, nil replacement, a name no module
  defines, the same record twice, a second record for the same name,
  uninstalling what is not installed); an install before the library
  std_hookabi_rt_dll is loaded (the load is patched as it happens), the
  program's own getenv call hooked too, the library's slot holding the
  replacement, then uninstalled: both calls real again; an install after
  the load, where the library's slot after the uninstall equals what it held
  before the install; and an install whose library is unloaded before the
  uninstall (nothing is written into the unloaded library; a new load is
  real). The library's slot is read by this program's own reader of the
  module's tables, apart from HookABI's.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.

  The Linux expectations: std_hookabi_rt_linux (the same program).
*******************************************************************************/

module exe std_hookabi_rt;

/*
  @@test
    kind run
    targets x86_64-windows-gnu
    deps std_hookabi_rt_dll
    expect
    | ok set real
    | ok refuse nil name
    | ok refuse empty name
    | ok refuse nil replacement
    | ok refuse unknown name
    | ok refuse uninstall not installed
    | ok install for twice
    | ok refuse same record twice
    | ok refuse second record same name
    | ok uninstall for twice
    | ok unloaded not loaded yet
    | ok unloaded install
    | ok unloaded library call hooked
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
    | ok unloaded unload
    | ok unloaded slot gone
    | ok unloaded uninstall
    | ok unloaded own call real
    | ok unloaded reload real
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
    | ok unloaded reload unload
    | ok before install
    | ok before original is the real getenv
    | ok before own call hooked
    | ok before load
    | ok before library call hooked
    | ok before library slot is the replacement
    | ok before uninstall
    | ok before library call real
    | ok before own call real
    | ok before library slot not the replacement
    | ok before uninstall twice refused
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
    | ok before unload
    | ok after load
    | ok after library call real first
    | ok after slot found
    | ok after install
    | ok after library slot is the replacement
    | ok after library call hooked
    | ok after uninstall
    | ok after library slot as before
    | ok after library call real
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
    | ok after unload
    | done 0
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

import
  HookABI;

#include <cerrno>
#include <cstdlib>
#include <cstring>
#include <string>
#include <thread>
#include <mutex>
#include <condition_variable>

@ifdef TARGET_X86_64_WINDOWS_GNU
#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <windows.h>

// The replacement's answer for STD_HOOKABI_RT
static char GStdHookabiRtHooked[] = "hooked";

// The real getenv, set from the record once installed
static void* GStdHookabiRtOriginal = nullptr;

// The replacement: getenv's C signature
extern "C" char* std_hookabi_rt_getenv(const char* AName)
{
  using TReal = char* (*)(const char*);
  if ((AName != nullptr) && (std::strcmp(AName, "STD_HOOKABI_RT") == 0))
    return GStdHookabiRtHooked;
  if (GStdHookabiRtOriginal == nullptr)
    return nullptr;
  return reinterpret_cast<TReal>(GStdHookabiRtOriginal)(AName);
}

static void* std_hookabi_rt_replacement()
{
  return reinterpret_cast<void*>(&std_hookabi_rt_getenv);
}

// The library's full path: beside this program
static std::string std_hookabi_rt_library()
{
  char LPath[MAX_PATH];
  const DWORD LLength = GetModuleFileNameA(nullptr, LPath, MAX_PATH);
  if ((LLength == 0) || (LLength == MAX_PATH))
    return "";
  const std::string LText(LPath, LLength);
  return LText.substr(0, LText.find_last_of("\\/") + 1) + "std_hookabi_rt_dll.dll";
}

static void* std_hookabi_rt_load()
{
  return reinterpret_cast<void*>(LoadLibraryA(std_hookabi_rt_library().c_str()));
}

static bool std_hookabi_rt_unload(void* AHandle)
{
  return (AHandle != nullptr) && (FreeLibrary(static_cast<HMODULE>(AHandle)) != 0);
}

// The library's STD_HOOKABI_RT through its own getenv slot: "" for nil, "?"
// when the library or its routine is missing
static std::string std_hookabi_rt_call(void* AHandle)
{
  using TEnv = const char* (*)();
  if (AHandle == nullptr)
    return "?";
  const TEnv LEnv = reinterpret_cast<TEnv>(reinterpret_cast<void*>(
    GetProcAddress(static_cast<HMODULE>(AHandle), "std_hookabi_rt_env")));
  if (LEnv == nullptr)
    return "?";
  const char* LValue = LEnv();
  return (LValue != nullptr) ? LValue : "";
}

// The program's own getenv call
static std::string std_hookabi_rt_own()
{
  const char* LValue = getenv("STD_HOOKABI_RT");
  return (LValue != nullptr) ? LValue : "";
}

// This program's own reader of the library's getenv import address table
// entry (apart from HookABI's): AOk false when the library is not loaded or
// imports no getenv by name
static void* std_hookabi_rt_slot(bool& AOk)
{
  const HMODULE LModule = GetModuleHandleA("std_hookabi_rt_dll.dll");
  const unsigned char* LBase = reinterpret_cast<const unsigned char*>(LModule);

  AOk = false;
  if (LBase == nullptr)
    return nullptr;
  const auto* LDos = reinterpret_cast<const IMAGE_DOS_HEADER*>(LBase);
  const auto* LNt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(LBase + LDos->e_lfanew);
  const IMAGE_DATA_DIRECTORY& LDirectory =
    LNt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
  if (LDirectory.VirtualAddress == 0)
    return nullptr;
  for (const auto* LImport = reinterpret_cast<const IMAGE_IMPORT_DESCRIPTOR*>(LBase +
    LDirectory.VirtualAddress); LImport->Name != 0; ++LImport)
  {
    if (LImport->OriginalFirstThunk == 0)
      continue;
    const auto* LNames = reinterpret_cast<const IMAGE_THUNK_DATA64*>(LBase + LImport->OriginalFirstThunk);
    const auto* LSlots = reinterpret_cast<const IMAGE_THUNK_DATA64*>(LBase + LImport->FirstThunk);
    for (; LNames->u1.AddressOfData != 0; ++LNames, ++LSlots)
    {
      if (IMAGE_SNAP_BY_ORDINAL64(LNames->u1.Ordinal))
        continue;
      const auto* LByName = reinterpret_cast<const IMAGE_IMPORT_BY_NAME*>(LBase + LNames->u1.AddressOfData);
      if (std::strcmp(reinterpret_cast<const char*>(LByName->Name), "getenv") != 0)
        continue;
      AOk = true;
      return reinterpret_cast<void*>(LSlots->u1.Function);
    }
  }
  return nullptr;
}

static void* std_hookabi_rt_slot_value()
{
  bool LOk;
  return std_hookabi_rt_slot(LOk);
}

static bool std_hookabi_rt_slot_found()
{
  bool LOk;
  std_hookabi_rt_slot(LOk);
  return LOk;
}

// AWork on a thread of its own, waited for (the same shape as the Linux
// branch; Windows unloads at the last FreeLibrary whichever thread ran it)
template <typename TWork>
static bool std_hookabi_rt_on_thread(TWork&& AWork)
{
  try
  {
    std::thread LThread(AWork);
    LThread.join();
    return true;
  }
  catch (...)
  {
    return false;
  }
}

static void* std_hookabi_rt_load_apart()
{
  void* LHandle = nullptr;
  std_hookabi_rt_on_thread([&]() { LHandle = std_hookabi_rt_load(); });
  return LHandle;
}

static std::string std_hookabi_rt_call_apart(void* AHandle)
{
  std::string LValue = "?";
  std_hookabi_rt_on_thread([&]() { LValue = std_hookabi_rt_call(AHandle); });
  return LValue;
}

static bool std_hookabi_rt_set_real()
{
  return _putenv_s("STD_HOOKABI_RT", "real") == 0;
}

// The C runtime's getenv, what the program's import slot reaches
static void* std_hookabi_rt_default()
{
  return reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(L"ucrtbase.dll"), "getenv"));
}
@else
#include <climits>
#include <dlfcn.h>
#include <link.h>
#include <unistd.h>

// The replacement's answer for STD_HOOKABI_RT
static char GStdHookabiRtHooked[] = "hooked";

// The real getenv, set from the record once installed
static void* GStdHookabiRtOriginal = nullptr;

// The replacement: getenv's C signature
extern "C" char* std_hookabi_rt_getenv(const char* AName)
{
  using TReal = char* (*)(const char*);
  if ((AName != nullptr) && (std::strcmp(AName, "STD_HOOKABI_RT") == 0))
    return GStdHookabiRtHooked;
  if (GStdHookabiRtOriginal == nullptr)
    return nullptr;
  return reinterpret_cast<TReal>(GStdHookabiRtOriginal)(AName);
}

static void* std_hookabi_rt_replacement()
{
  return reinterpret_cast<void*>(&std_hookabi_rt_getenv);
}

// The library's full path: beside this program
static std::string std_hookabi_rt_library()
{
  char LPath[PATH_MAX];
  const ssize_t LLength = readlink("/proc/self/exe", LPath, sizeof(LPath) - 1);
  if (LLength <= 0)
    return "";
  const std::string LText(LPath, static_cast<std::size_t>(LLength));
  return LText.substr(0, LText.find_last_of('/') + 1) + "libstd_hookabi_rt_dll.so";
}

static void* std_hookabi_rt_load()
{
  return dlopen(std_hookabi_rt_library().c_str(), RTLD_NOW);
}

static bool std_hookabi_rt_unload(void* AHandle)
{
  return (AHandle != nullptr) && (dlclose(AHandle) == 0);
}

// The library's STD_HOOKABI_RT through its own getenv slot: "" for nil, "?"
// when the library or its routine is missing
static std::string std_hookabi_rt_call(void* AHandle)
{
  using TEnv = const char* (*)();
  if (AHandle == nullptr)
    return "?";
  const TEnv LEnv = reinterpret_cast<TEnv>(dlsym(AHandle, "std_hookabi_rt_env"));
  if (LEnv == nullptr)
    return "?";
  const char* LValue = LEnv();
  return (LValue != nullptr) ? LValue : "";
}

// The program's own getenv call
static std::string std_hookabi_rt_own()
{
  const char* LValue = getenv("STD_HOOKABI_RT");
  return (LValue != nullptr) ? LValue : "";
}

// This program's own reader of a module's getenv slot (apart from HookABI's):
// the first JUMP_SLOT / GLOB_DAT relocation of getenv in the loaded module
// whose path ends with the library's file name
struct StdHookabiRtFind
{
  void* Value = nullptr;
  bool Found = false;
};

static std::uintptr_t std_hookabi_rt_address(const std::uintptr_t ABase, const ElfW(Addr) AValue)
{
  return (AValue < ABase) ? (ABase + AValue) : AValue;
}

static int std_hookabi_rt_visit(struct dl_phdr_info* AInfo, std::size_t, void* AData)
{
  StdHookabiRtFind& LFind = *static_cast<StdHookabiRtFind*>(AData);
  const std::string LName = (AInfo->dlpi_name != nullptr) ? AInfo->dlpi_name : "";
  const std::string LFile = "/libstd_hookabi_rt_dll.so";
  const ElfW(Dyn)* LDynamic = nullptr;
  const ElfW(Sym)* LSymbols = nullptr;
  const char* LStrings = nullptr;
  const ElfW(Rela)* LLists[2] = { nullptr, nullptr };
  std::size_t LSizes[2] = { 0, 0 };

  if ((LName.size() < LFile.size()) || (LName.compare(LName.size() - LFile.size(), LFile.size(), LFile) != 0))
    return 0;
  for (ElfW(Half) LI = 0; LI < AInfo->dlpi_phnum; ++LI)
  {
    if (AInfo->dlpi_phdr[LI].p_type == PT_DYNAMIC)
      LDynamic = reinterpret_cast<const ElfW(Dyn)*>(AInfo->dlpi_addr + AInfo->dlpi_phdr[LI].p_vaddr);
  }
  if (LDynamic == nullptr)
    return 1;
  for (const ElfW(Dyn)* LEntry = LDynamic; LEntry->d_tag != DT_NULL; ++LEntry)
  {
    if (LEntry->d_tag == DT_SYMTAB)
      LSymbols = reinterpret_cast<const ElfW(Sym)*>(std_hookabi_rt_address(AInfo->dlpi_addr, LEntry->d_un.d_ptr));
    else if (LEntry->d_tag == DT_STRTAB)
      LStrings = reinterpret_cast<const char*>(std_hookabi_rt_address(AInfo->dlpi_addr, LEntry->d_un.d_ptr));
    else if (LEntry->d_tag == DT_JMPREL)
      LLists[0] = reinterpret_cast<const ElfW(Rela)*>(std_hookabi_rt_address(AInfo->dlpi_addr, LEntry->d_un.d_ptr));
    else if (LEntry->d_tag == DT_PLTRELSZ)
      LSizes[0] = LEntry->d_un.d_val;
    else if (LEntry->d_tag == DT_RELA)
      LLists[1] = reinterpret_cast<const ElfW(Rela)*>(std_hookabi_rt_address(AInfo->dlpi_addr, LEntry->d_un.d_ptr));
    else if (LEntry->d_tag == DT_RELASZ)
      LSizes[1] = LEntry->d_un.d_val;
  }
  if ((LSymbols == nullptr) || (LStrings == nullptr))
    return 1;
  for (int LList = 0; LList < 2; ++LList)
  {
    for (std::size_t LI = 0; (LLists[LList] != nullptr) && (LI < (LSizes[LList] / sizeof(ElfW(Rela)))); ++LI)
    {
      const ElfW(Rela)& LEntry = LLists[LList][LI];
      const auto LType = ELF64_R_TYPE(LEntry.r_info);
      if ((LType != R_X86_64_JUMP_SLOT) && (LType != R_X86_64_GLOB_DAT))
        continue;
      if (std::strcmp(LStrings + LSymbols[ELF64_R_SYM(LEntry.r_info)].st_name, "getenv") != 0)
        continue;
      LFind.Value = *reinterpret_cast<void**>(AInfo->dlpi_addr + LEntry.r_offset);
      LFind.Found = true;
      return 1;
    }
  }
  return 1;
}

// The library's getenv slot value; ok false when the library or the slot is
// not found
static void* std_hookabi_rt_slot(bool& AOk)
{
  StdHookabiRtFind LFind;
  dl_iterate_phdr(std_hookabi_rt_visit, &LFind);
  AOk = LFind.Found;
  return LFind.Value;
}

static void* std_hookabi_rt_slot_value()
{
  bool LOk;
  return std_hookabi_rt_slot(LOk);
}

static bool std_hookabi_rt_slot_found()
{
  bool LOk;
  std_hookabi_rt_slot(LOk);
  return LOk;
}

// AWork on a thread of its own, waited for. glibc keeps a library loaded
// while a thread that ran its code holds one of its thread_local destructors
// (a PaskalCPP library registers some): a library loaded and called only on
// such a thread, which has exited, unloads at its last dlclose.
template <typename TWork>
static bool std_hookabi_rt_on_thread(TWork&& AWork)
{
  try
  {
    std::thread LThread(AWork);
    LThread.join();
    return true;
  }
  catch (...)
  {
    return false;
  }
}

static void* std_hookabi_rt_load_apart()
{
  void* LHandle = nullptr;
  std_hookabi_rt_on_thread([&]() { LHandle = std_hookabi_rt_load(); });
  return LHandle;
}

static std::string std_hookabi_rt_call_apart(void* AHandle)
{
  std::string LValue = "?";
  std_hookabi_rt_on_thread([&]() { LValue = std_hookabi_rt_call(AHandle); });
  return LValue;
}

static bool std_hookabi_rt_set_real()
{
  return setenv("STD_HOOKABI_RT", "real", 1) == 0;
}

static void* std_hookabi_rt_default()
{
  return dlsym(RTLD_DEFAULT, "getenv");
}

// True while the library is mapped (RTLD_NOLOAD loads nothing): after its
// last dlclose it must be gone, whichever threads ran its code
static bool std_hookabi_rt_loaded()
{
  void* LHandle = dlopen(std_hookabi_rt_library().c_str(), RTLD_NOW | RTLD_NOLOAD);

  if (LHandle == nullptr)
    return false;
  dlclose(LHandle);
  return true;
}

// A thread that calls the library, then stays alive until released: a
// live thread that ran the library's code must not keep it loaded
static std::mutex GStdHookabiRtHeldLock;
static std::condition_variable GStdHookabiRtHeldSignal;
static bool GStdHookabiRtHeldCalled = false;
static bool GStdHookabiRtHeldRelease = false;
static std::thread* GStdHookabiRtHeld = nullptr;

static std::string std_hookabi_rt_call_held(void* AHandle)
{
  std::string LValue = "?";

  try
  {
    GStdHookabiRtHeld = new std::thread([&LValue, AHandle]()
    {
      std::string LGot = std_hookabi_rt_call(AHandle);
      std::unique_lock<std::mutex> LLock(GStdHookabiRtHeldLock);
      LValue = LGot;
      GStdHookabiRtHeldCalled = true;
      GStdHookabiRtHeldSignal.notify_all();
      GStdHookabiRtHeldSignal.wait(LLock, []() { return GStdHookabiRtHeldRelease; });
    });
    std::unique_lock<std::mutex> LLock(GStdHookabiRtHeldLock);
    GStdHookabiRtHeldSignal.wait(LLock, []() { return GStdHookabiRtHeldCalled; });
    return LValue;
  }
  catch (...)
  {
    return "?";
  }
}

static bool std_hookabi_rt_release_held()
{
  if (GStdHookabiRtHeld == nullptr)
    return false;
  {
    std::lock_guard<std::mutex> LLock(GStdHookabiRtHeldLock);
    GStdHookabiRtHeldRelease = true;
  }
  GStdHookabiRtHeldSignal.notify_all();
  GStdHookabiRtHeld->join();
  delete GStdHookabiRtHeld;
  GStdHookabiRtHeld = nullptr;
  return true;
}
@endif

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Every refusal: nothing is installed by any of them
routine TestRefused();
var
  LHook: Hook;
  LOther: Hook;
  LError: int32;
begin
  // Both records start zeroed, as every PaskalCPP record variable does
  errno := 0;
  Check("refuse nil name", (not HookInstall(LHook, nil, std_hookabi_rt_replacement())) and (errno = EINVAL) and (LHook.State = nil));
  errno := 0;
  Check("refuse empty name", (not HookInstall(LHook, "", std_hookabi_rt_replacement())) and (errno = EINVAL));
  errno := 0;
  Check("refuse nil replacement", (not HookInstall(LHook, "getenv", nil)) and (errno = EINVAL));
  errno := 0;
  Check("refuse unknown name", (not HookInstall(LHook, "std_hookabi_rt_no_such_function", std_hookabi_rt_replacement())) and (errno = ENOENT) and (LHook.State = nil));
  errno := 0;
  Check("refuse uninstall not installed", (not HookUninstall(LHook)) and (errno = EINVAL));

  Check("install for twice", HookInstall(LHook, "getenv", std_hookabi_rt_replacement()));
  errno := 0;
  LError := 0;
  if not HookInstall(LHook, "getenv", std_hookabi_rt_replacement()) then
    LError := errno;
  end;
  Check("refuse same record twice", LError = EEXIST);
  errno := 0;
  Check("refuse second record same name", (not HookInstall(LOther, "getenv", std_hookabi_rt_replacement())) and (errno = EEXIST) and (LOther.State = nil));
  Check("uninstall for twice", HookUninstall(LHook) and (LHook.State = nil));
end;

// Installed before the library loads: the load is patched as it happens
routine TestBeforeLoad();
var
  LHook: Hook;
  LLibrary: ptr;
  LOriginal: ptr;
begin
  Check("before install", HookInstall(LHook, "getenv", std_hookabi_rt_replacement()) and (LHook.State <> nil));
  GStdHookabiRtOriginal := LHook.Original;
  Check("before original is the real getenv", (LHook.Original <> nil) and (LHook.Original = std_hookabi_rt_default()));
  Check("before own call hooked", std_hookabi_rt_own() = "hooked");
  LLibrary := std_hookabi_rt_load();
  Check("before load", LLibrary <> nil);
  Check("before library call hooked", std_hookabi_rt_call(LLibrary) = "hooked");
  Check("before library slot is the replacement", std_hookabi_rt_slot_found() and (std_hookabi_rt_slot_value() = std_hookabi_rt_replacement()));
  LOriginal := LHook.Original;
  Check("before uninstall", HookUninstall(LHook) and (LHook.State = nil) and (LHook.Original = LOriginal));
  Check("before library call real", std_hookabi_rt_call(LLibrary) = "real");
  Check("before own call real", std_hookabi_rt_own() = "real");
  Check("before library slot not the replacement", std_hookabi_rt_slot_found() and (std_hookabi_rt_slot_value() <> std_hookabi_rt_replacement()));
  errno := 0;
  Check("before uninstall twice refused", (not HookUninstall(LHook)) and (errno = EINVAL));
  Check("before unload", std_hookabi_rt_unload(LLibrary));
end;

// Installed after the load: the uninstall gives the library's slot back
// exactly what it held before the install
routine TestAfterLoad();
var
  LHook: Hook;
  LLibrary: ptr;
  LBefore: ptr;
begin
  LLibrary := std_hookabi_rt_load();
  Check("after load", LLibrary <> nil);
  Check("after library call real first", std_hookabi_rt_call(LLibrary) = "real");
  LBefore := std_hookabi_rt_slot_value();
  Check("after slot found", std_hookabi_rt_slot_found() and (LBefore <> nil));
  Check("after install", HookInstall(LHook, "getenv", std_hookabi_rt_replacement()));
  GStdHookabiRtOriginal := LHook.Original;
  Check("after library slot is the replacement", std_hookabi_rt_slot_value() = std_hookabi_rt_replacement());
  Check("after library call hooked", std_hookabi_rt_call(LLibrary) = "hooked");
  Check("after uninstall", HookUninstall(LHook));
  Check("after library slot as before", std_hookabi_rt_slot_value() = LBefore);
  Check("after library call real", std_hookabi_rt_call(LLibrary) = "real");
  Check("after unload", std_hookabi_rt_unload(LLibrary));
end;

// The library unloads while installed: the uninstall writes nothing into it.
// Loaded and called on threads of their own, so nothing keeps it loaded
// past its dlclose; it runs first, before the other tests load the library
// on this thread (which keeps it loaded from then on)
routine TestUnloaded();
var
  LHook: Hook;
  LLibrary: ptr;
begin
  Check("unloaded not loaded yet", not std_hookabi_rt_slot_found());
  LLibrary := std_hookabi_rt_load_apart();
  Check("unloaded install", (LLibrary <> nil) and HookInstall(LHook, "getenv", std_hookabi_rt_replacement()));
  GStdHookabiRtOriginal := LHook.Original;
  Check("unloaded library call hooked", std_hookabi_rt_call_apart(LLibrary) = "hooked");
  Check("unloaded unload", std_hookabi_rt_unload(LLibrary));
  Check("unloaded slot gone", not std_hookabi_rt_slot_found());
  Check("unloaded uninstall", HookUninstall(LHook) and (LHook.State = nil));
  Check("unloaded own call real", std_hookabi_rt_own() = "real");
  LLibrary := std_hookabi_rt_load_apart();
  Check("unloaded reload real", std_hookabi_rt_call_apart(LLibrary) = "real");
  Check("unloaded reload unload", std_hookabi_rt_unload(LLibrary));
end;

@ifndef TARGET_X86_64_WINDOWS_GNU
// Linux: a PaskalCPP shared library unloads at its last dlclose although
// this thread, another thread that has exited and a thread still alive
// all ran its code (its runtime registers no thread_local destructor with
// the C++ runtime, which would pin it: plans\PLAN-HOOKABI.md R7). Runs
// last, after every other test loaded and called it on this thread.
routine TestThreadUnload();
var
  LLibrary: ptr;
begin
  LLibrary := std_hookabi_rt_load();
  Check("thread unload loaded", (LLibrary <> nil) and std_hookabi_rt_loaded());
  Check("thread unload own thread call", std_hookabi_rt_call(LLibrary) <> "?");
  Check("thread unload exited thread call", std_hookabi_rt_call_apart(LLibrary) <> "?");
  Check("thread unload live thread call", std_hookabi_rt_call_held(LLibrary) <> "?");
  Check("thread unload unload", std_hookabi_rt_unload(LLibrary));
  Check("thread unload gone at dlclose", not std_hookabi_rt_loaded());
  Check("thread unload live thread released", std_hookabi_rt_release_held());
end;
@endif

begin
  GFails := 0;
  Check("set real", std_hookabi_rt_set_real());
  TestRefused();
  TestUnloaded();
  TestBeforeLoad();
  TestAfterLoad();
@ifndef TARGET_X86_64_WINDOWS_GNU
  TestThreadUnload();
@endif
  println("done {}", GFails);
end.
