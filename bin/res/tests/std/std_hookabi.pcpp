-------------------------------------------------------------------------------
  std_hookabi.pcpp - std compliance: the HookABI unit, link-time hooks

  `import HookABI;` A link-time hook is a plain `routine clink` with the
  hooked function's C name and signature. Its definition is in the final
  link, so it binds every call to that name: the program's own calls and
  the calls inside std_hookabi_lib, a static C library (std_hookabi_c.c).
  Each hook counts its entries, then calls the real function through
  HookReal, which resolves it once into the hook's slot. When there is no
  real function (HookReal gives nil), the hook never calls it: it fails the
  call the way the hooked function fails (errno ENOSYS).

  Both targets hook fopen and stat. glibc declares stat noexcept (__THROW):
  the plain definition compiles clean. On Linux the stat hook's real
  function is __xstat, called with HookStatVersion first, as zig's glibc
  stub does (only glibc 2.33 and later exports stat). The mingw headers
  map stat onto the asm name stat64i32 (a libmingwex wrapper, not an
  import), so on Windows the hook is stat64i32 and its real function the
  CRT's _stat64i32; the same `stat(...)` calls reach it. Windows also
  hooks fopen_s and _access, which the headers declare dllimport: the C
  library reaches them through their import slots (HOOKABI_IMPORT_SLOT
  after each hook), and their hooks sit between the scoped
  -Winconsistent-dllimport pragma pair, so the build prints no warning.
  fopen gets a slot too (any object compiled against a dllimport fopen
  would reference it); on Linux the slot line is inert.

  Each STEP line is one call site: hooked = how many times the hook ran for
  that one call (1 = the hook bound it), ok = the real function did its job
  (the program file opened / stat gave its size / the path exists). Then:
  every slot holds its real function after the first call and keeps it, a
  name with no real definition gives nil and leaves the slot nil, the
  three-argument HookReal finds the same fopen in the C runtime library by
  name, and a library that is not loaded gives nil (it is never loaded).

  The Linux expectations: std_hookabi_linux (the same program).
*******************************************************************************/

module exe std_hookabi;

/*
  @@test
    kind run
    targets x86_64-windows-gnu
    deps std_hookabi_lib
    expect
    | STEP fopen from PaskalCPP: hooked=1 ok=true
    | STEP stat from PaskalCPP: hooked=1 ok=true
    | STEP fopen from C library: hooked=1 ok=true
    | STEP stat from C library: hooked=1 ok=true
    | STEP fopen_s from PaskalCPP: hooked=1 ok=true
    | STEP fopen_s from C library: hooked=1 ok=true
    | STEP _access from PaskalCPP: hooked=1 ok=true
    | STEP _access from C library: hooked=1 ok=true
    | STEP real fopen resolved: true
    | STEP real stat resolved: true
    | STEP real fopen_s resolved: true
    | STEP real _access resolved: true
    | STEP slot kept after a second call: true
    | STEP missing name: nil=true slot nil=true
    | STEP real fopen by library: true
    | STEP library not loaded: nil=true slot nil=true
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addlibrarypath "$P:output/lib";

import HookABI;

#include <cerrno>
#include <cstdio>
#include <sys/stat.h>
@ifdef TARGET_X86_64_WINDOWS_GNU
#include <io.h>
@endif

type
  FopenFn = routine clink(const APath: ptr to const char; const AMode: ptr to const char): ptr to FILE;

var
  // Each hook's slot for its real function (HookReal fills it once)
  GRealFopen: ptr;
  GRealStat: ptr;
  // How many times each hook has run
  GFopenHits: int32;
  GStatHits: int32;

// The hooks: same C names and signatures as the CRT's, C linkage
routine clink fopen(const APath: ptr to const char; const AMode: ptr to const char): ptr to FILE;
var
  LReal: FopenFn;
begin
  GFopenHits += 1;
  LReal := reinterpret_cast<FopenFn>(HookReal(GRealFopen, "fopen"));
  // No real function: fail the call as fopen fails, never call nil
  if LReal = nil then
    errno := ENOSYS;
    return nil;
  end;
  return LReal(APath, AMode);
end;
HOOKABI_IMPORT_SLOT(fopen);

@ifdef TARGET_X86_64_WINDOWS_GNU

type
  FopenSFn = routine clink(const AFile: ptr to ptr to FILE; const APath: ptr to const char; const AMode: ptr to const char): int32;
  AccessFn = routine clink(const APath: ptr to const char; const AMode: int32): int32;
  StatFn = routine clink(const APath: ptr to const char; const ABuf: ptr to struct _stat64i32): int32;

var
  GRealFopenS: ptr;
  GRealAccess: ptr;
  GFopenSHits: int32;
  GAccessHits: int32;

// The headers declare these two dllimport: own definitions + own import
// slots, inside the scoped pragma pair
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Winconsistent-dllimport"

routine clink fopen_s(const AFile: ptr to ptr to FILE; const APath: ptr to const char; const AMode: ptr to const char): int32;
var
  LReal: FopenSFn;
begin
  GFopenSHits += 1;
  LReal := reinterpret_cast<FopenSFn>(HookReal(GRealFopenS, "fopen_s"));
  // No real function: fail the call as fopen_s fails (no stream, the error
  // code returned), never call nil
  if LReal = nil then
    if AFile <> nil then
      AFile^ := nil;
    end;
    errno := ENOSYS;
    return ENOSYS;
  end;
  return LReal(AFile, APath, AMode);
end;
HOOKABI_IMPORT_SLOT(fopen_s);

routine clink _access(const APath: ptr to const char; const AMode: int32): int32;
var
  LReal: AccessFn;
begin
  GAccessHits += 1;
  LReal := reinterpret_cast<AccessFn>(HookReal(GRealAccess, "_access"));
  // No real function: fail the call as _access fails, never call nil
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(APath, AMode);
end;
HOOKABI_IMPORT_SLOT(_access);

#pragma clang diagnostic pop

// stat is the asm name stat64i32 (libmingwex, not an import): no slot; the
// real function is the CRT export it wraps
routine clink stat64i32(const APath: ptr to const char; const ABuf: ptr to struct _stat64i32): int32;
var
  LReal: StatFn;
begin
  GStatHits += 1;
  LReal := reinterpret_cast<StatFn>(HookReal(GRealStat, "_stat64i32"));
  // No real function: fail the call as stat fails, never call nil
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(APath, ABuf);
end;

@else

// The real function is __xstat, not stat: zig's glibc stub defines stat in
// libc_nonshared as a call of __xstat, and only glibc 2.33 and later
// exports stat (HookABI, "Finding the real function")
type
  XstatFn = routine clink(const AVersion: int32; const APath: ptr to const char; const ABuf: ptr to struct stat): int32;

routine clink stat(const APath: ptr to const char; const ABuf: ptr to struct stat): int32;
var
  LReal: XstatFn;
begin
  GStatHits += 1;
  LReal := reinterpret_cast<XstatFn>(HookReal(GRealStat, "__xstat"));
  // No real function: fail the call as stat fails, never call nil
  if LReal = nil then
    errno := ENOSYS;
    return -1;
  end;
  return LReal(HookStatVersion, APath, ABuf);
end;

@endif

// The static C library's callers (std_hookabi_c.c)
routine clink std_hookabi_c_fopen(const APath: ptr to const char): int32; external "std_hookabi_lib";
routine clink std_hookabi_c_stat(const APath: ptr to const char): int32; external "std_hookabi_lib";

routine Step(const AWhat: string; const ABefore: int32; const AAfter: int32; const AOk: bool);
begin
  println("STEP {}: hooked={} ok={}", AWhat, AAfter - ABefore, AOk);
end;

@ifdef TARGET_X86_64_WINDOWS_GNU

routine clink std_hookabi_c_fopen_s(const APath: ptr to const char): int32; external "std_hookabi_lib";
routine clink std_hookabi_c_access(const APath: ptr to const char): int32; external "std_hookabi_lib";

// The Windows-only call sites: fopen_s and _access, from PaskalCPP and from C
routine RunTargetCalls(const APath: string);
var
  LBefore: int32;
  LFile: ptr to FILE;
  LOk: bool;
begin
  LBefore := GFopenSHits;
  LFile := nil;
  LOk := (fopen_s(address of LFile, APath.c_str(), "rb") = 0) and (LFile <> nil);
  if LFile <> nil then
    fclose(LFile);
  end;
  Step("fopen_s from PaskalCPP", LBefore, GFopenSHits, LOk);

  LBefore := GFopenSHits;
  LOk := std_hookabi_c_fopen_s(APath.c_str()) = 1;
  Step("fopen_s from C library", LBefore, GFopenSHits, LOk);

  // Mode 0: the path exists
  LBefore := GAccessHits;
  LOk := _access(APath.c_str(), 0) = 0;
  Step("_access from PaskalCPP", LBefore, GAccessHits, LOk);

  LBefore := GAccessHits;
  LOk := std_hookabi_c_access(APath.c_str()) = 1;
  Step("_access from C library", LBefore, GAccessHits, LOk);
end;

routine RunTargetResolved();
begin
  println("STEP real fopen_s resolved: {}", GRealFopenS <> nil);
  println("STEP real _access resolved: {}", GRealAccess <> nil);
end;

// The C runtime library by name, and one that is never loaded
routine RealFopenByLibrary(var ASlot: ptr): ptr;
begin
  return HookReal(ASlot, "ucrtbase.dll", "fopen");
end;

routine RealFromMissingLibrary(var ASlot: ptr): ptr;
begin
  return HookReal(ASlot, "std_hookabi_no_such_library.dll", "fopen");
end;

@else

routine RunTargetCalls(const APath: string);
begin
end;

routine RunTargetResolved();
begin
end;

routine RealFopenByLibrary(var ASlot: ptr): ptr;
begin
  return HookReal(ASlot, "libc.so.6", "fopen");
end;

routine RealFromMissingLibrary(var ASlot: ptr): ptr;
begin
  return HookReal(ASlot, "std_hookabi_no_such_library.so", "fopen");
end;

@endif

routine Run();
var
  LPath: string;
  LBefore: int32;
  LFile: ptr to FILE;
  LInfo: struct stat;
  LOk: bool;
  LKept: ptr;
  LMissingSlot: ptr;
  LMissing: ptr;
  LByLibrarySlot: ptr;
  LByLibrary: ptr;
begin
  // The program's own file exists on every target
  LPath := paramstr(0);

  LBefore := GFopenHits;
  LFile := fopen(LPath.c_str(), "rb");
  LOk := LFile <> nil;
  if LOk then
    fclose(LFile);
  end;
  Step("fopen from PaskalCPP", LBefore, GFopenHits, LOk);

  LBefore := GStatHits;
  LOk := (stat(LPath.c_str(), address of LInfo) = 0) and (LInfo.st_size > 0);
  Step("stat from PaskalCPP", LBefore, GStatHits, LOk);

  LBefore := GFopenHits;
  LOk := std_hookabi_c_fopen(LPath.c_str()) = 1;
  Step("fopen from C library", LBefore, GFopenHits, LOk);

  LBefore := GStatHits;
  LOk := std_hookabi_c_stat(LPath.c_str()) = 1;
  Step("stat from C library", LBefore, GStatHits, LOk);

  RunTargetCalls(LPath);

  println("STEP real fopen resolved: {}", GRealFopen <> nil);
  println("STEP real stat resolved: {}", GRealStat <> nil);
  RunTargetResolved();

  // A second call reads the slot: it must still hold the same function
  LKept := GRealFopen;
  LFile := fopen(LPath.c_str(), "rb");
  if LFile <> nil then
    fclose(LFile);
  end;
  println("STEP slot kept after a second call: {}", (GRealFopen = LKept) and (LKept <> nil));

  // No definition of this name anywhere: nil, and the slot stays nil
  LMissingSlot := nil;
  LMissing := HookReal(LMissingSlot, "std_hookabi_no_such_function");
  println("STEP missing name: nil={} slot nil={}", LMissing = nil, LMissingSlot = nil);

  // The C runtime library by name gives the same fopen as the C runtime form
  LByLibrarySlot := nil;
  LByLibrary := RealFopenByLibrary(LByLibrarySlot);
  println("STEP real fopen by library: {}", (LByLibrary <> nil) and (LByLibrary = GRealFopen));

  // A library that is not loaded: nil, the slot stays nil, nothing is loaded
  LByLibrarySlot := nil;
  LByLibrary := RealFromMissingLibrary(LByLibrarySlot);
  println("STEP library not loaded: nil={} slot nil={}", LByLibrary = nil, LByLibrarySlot = nil);
end;

begin
  Run();
end.
