  std_hookabi_rt_dll.pcpp - std compliance: the library std_hookabi_rt loads

  A shared library (Windows std_hookabi_rt_dll.dll, Linux
  libstd_hookabi_rt_dll.so) whose one routine reads the environment variable
  STD_HOOKABI_RT with the C runtime's getenv, through the library's own
  import slot for it. std_hookabi_rt loads it at run time (never linked)
  and hooks that slot with HookInstall. Built first, into repo\bin\output.
*******************************************************************************/

module dll std_hookabi_rt_dll;

/*
  @@test
    kind dep
  @@end
*/

#include <cstdlib>

// STD_HOOKABI_RT as this library's getenv gives it: nil when it is not set
exported routine clink std_hookabi_rt_env(): ptr to const char;
begin
  return getenv("STD_HOOKABI_RT");
end;

end.
