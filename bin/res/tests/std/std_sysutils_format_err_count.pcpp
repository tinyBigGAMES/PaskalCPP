  std_sysutils_format_err_count.pcpp - Std: sysutils format, count

  Break step of std_sysutils_format: a format string with more {} than
  arguments (SM0502).
*******************************************************************************/

module exe std_sysutils_format_err_count;

/*
  @@test
    kind error
  @@end
*/

import
  SysUtils;

var
  LText: string;

begin
  LText := FormatStr("{} {}", 1); // ERROR SM0502@22
  println("{}", LText);
end.
