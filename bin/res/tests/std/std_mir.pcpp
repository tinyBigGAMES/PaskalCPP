-------------------------------------------------------------------------------
  std_mir.pcpp - Std library compliance: the mir vendor unit
  (res\libs\std\mir.pcpp)

  MIR used from PaskalCPP: a module written in MIR's text form
  (MIR_scan_string) with a loop (sum), recursion (fib) and a call to a
  `routine clink` of this program (std_mir_mul, registered with
  MirLoadHost), JIT'd lazily, eagerly and lazily per basic block
  (MirLinkMode.LazyBB, its Win64 fixes: PaskalCPP-Libs
  src\mir\FIXES.md, 3 + 4); and c2mir compiling a
  C function fed through a `routine clink` reader (std_mir_getc), JIT'd.
  Hand-computed: sum(1000) = 499500, callmul(7) = 7 * 6 = 42,
  fib(25) = 75025, square(9) = 81.

  MIR's C boundary (a routine handed over as a void *, the last module, a
  function by name, a call through a code address, the link modes) is the
  mir_ext unit's (MirLoadHost, MirLoadModuleText, MirFuncAddr, MirCall,
  MirLink): the program holds no C++ of its own. c2mir's reader is used
  directly here (the mir unit's own API); C2MirCompileString wraps it.
*******************************************************************************/

module exe std_mir;

/*
  @@test
    kind run
    expect
    | lazy sum 499500 mul 42 fib 75025
    | eager sum 499500 mul 42 fib 75025
    | lazybb sum 499500 mul 42 fib 75025
    | c2mir compiled true square 81
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

import
  mir,
  mir_ext;

const
  // MIR's text form: one module exporting sum, fib and callmul
  CSource: string = R"(
m_std:   module
         export sum, fib, callmul
p_mul:   proto i64, i64:a, i64:b
p_fib:   proto i64, i64:n
         import std_mir_mul
sum:     func i64, i64:n
         local i64:i, i64:s
         mov i, 0; mov s, 0
loop:    bge done, i, n
         add s, s, i; add i, i, 1
         jmp loop
done:    ret s
         endfunc
fib:     func i64, i64:n
         local i64:a, i64:b, i64:t
         bge rec, n, 2
         ret n
rec:     sub t, n, 1
         call p_fib, fib, a, t
         sub t, n, 2
         call p_fib, fib, b, t
         add a, a, b
         ret a
         endfunc
callmul: func i64, i64:x
         local i64:r
         call p_mul, std_mir_mul, r, x, 6
         ret r
         endfunc
         endmodule
)";

  // C for c2mir (long is 32-bit on Win64: long long throughout)
  CSquare: string = "long long square (long long x) { return x * x; }";

var
  GSource: string;
  GPos: int64;
  GOptions: c2mir_options;

// The host routine the MIR module imports
routine clink std_mir_mul(AA: int64; AB: int64): int64;
begin
  return AA * AB;
end;

// c2mir's reader: the next byte of GSource, -1 at the end (EOF)
routine clink std_mir_getc(AData: ptr): int32;
begin
  if GPos >= int64(GSource.size()) then
    return -1;
  end;
  GPos := GPos + 1;
  return int32(GSource.at(GPos - 1));
end;

// Scans the MIR module into a fresh context, links it the way AMode names
// and prints the three results
routine RunText(const ALabel: string; const AMode: MirLinkMode);
var
  LCtx: MIR_context_t;
  LModule: MIR_module_t;
begin
  LCtx := MirNew();
  LModule := MirLoadModuleText(LCtx, CSource);
  MirLoadHost(LCtx, "std_mir_mul", std_mir_mul);
  MirLink(LCtx, AMode);
  println("{} sum {} mul {} fib {}", ALabel,
    MirCall(MirFuncAddr(LCtx, LModule, "sum"), 1000),
    MirCall(MirFuncAddr(LCtx, LModule, "callmul"), 7),
    MirCall(MirFuncAddr(LCtx, LModule, "fib"), 25));
  MirFree(LCtx);
end;

// c2mir compiles CSquare through its own reader; square is JIT'd lazily and called
routine RunC();
var
  LCtx: MIR_context_t;
  LModule: MIR_module_t;
  LOk: int32;
begin
  LCtx := MirNew();
  GSource := CSquare;
  GPos := 0;
  c2mir_init(LCtx);
  LOk := c2mir_compile(LCtx, address of GOptions, std_mir_getc, nil, "square.c", nil);
  c2mir_finish(LCtx);
  LModule := MirLastModule(LCtx);
  MIR_load_module(LCtx, LModule);
  MirLink(LCtx, MirLinkMode.Lazy);
  println("c2mir compiled {} square {}", LOk <> 0,
    MirCall(MirFuncAddr(LCtx, LModule, "square"), 9));
  MirFree(LCtx);
end;

begin
  RunText("lazy", MirLinkMode.Lazy);
  RunText("eager", MirLinkMode.Eager);
  RunText("lazybb", MirLinkMode.LazyBB);
  RunC();
end.
