  std_sysutils_format_err_cpp_value.pcpp - Std: sysutils format, cpp value

  Break step of std_sysutils_format: a C++ value with no std::formatter as an
  argument (SM0425 at the argument).
*******************************************************************************/

module exe std_sysutils_format_err_cpp_value;

/*
  @@test
    kind error
  @@end
*/

import
  SysUtils;

struct CNo {
  int x;
};

var
  LValue: CNo;
  LText: string;

begin
  LValue.x := 1;
  LText := FormatStr("{}", LValue); // ERROR SM0425@28
  println("{}", LText);
end.
