-------------------------------------------------------------------------------
  std_sysutils_format_err_not_literal.pcpp - Std: sysutils format, not literal

  Break step of std_sysutils_format: a string variable as the format string
  (SM0500: a format string is checked when the program is built, so it is
  written as a string literal).
*******************************************************************************/

module exe std_sysutils_format_err_not_literal;

/*
  @@test
    kind error
  @@end
*/

import
  SysUtils;

var
  LFormat: string;
  LText: string;

begin
  LFormat := "{}";
  LText := FormatStr(LFormat, 1); // ERROR SM0500@22
  println("{}", LText);
end.
