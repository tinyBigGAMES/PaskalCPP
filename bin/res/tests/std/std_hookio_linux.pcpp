@ifdef TARGET_X86_64_WINDOWS_GNU
// _wfopen takes UTF-16: the test's paths and modes are ASCII, widened as they
// are
std::FILE* std_hookio_wfopen(const std::string& APath, const std::string& AMode)
{
  const std::wstring LPath(APath.begin(), APath.end());
  const std::wstring LMode(AMode.begin(), AMode.end());
  return _wfopen(LPath.c_str(), LMode.c_str());
}
@endif

// The printf family from the program's own C++ (mixed code as a user writes
// it): whatever <cstdio>'s fprintf / vfprintf reach on this target must be
// hooked too
#include <cstdarg>
#include <cstdio>

static int std_hookio_cpp_vprintf_args(std::FILE* AFile, const char* AFormat, ...)
{
  va_list LArgs;
  int LResult;

  va_start(LArgs, AFormat);
  LResult = std::vfprintf(AFile, AFormat, LArgs);
  va_end(LArgs);
  return LResult;
}

// Writes "d4|" with fprintf; its count
int std_hookio_cpp_fprintf(std::FILE* AFile)
{
  return std::fprintf(AFile, "d%d|", 4);
}

// Writes "ey|" with vfprintf; its count
int std_hookio_cpp_vfprintf(std::FILE* AFile)
{
  return std_hookio_cpp_vprintf_args(AFile, "e%s|", "y");
}

type
  // A stream past 4 GiB that stores nothing: it reports CBigSize and makes
  // each byte from its place (BigByte)
  BigData = record
    Position: int64;
  end;

  // A writable stream that keeps nothing and counts what reaches it: the
  // bytes written and its Flush calls
  CountData = record
    Position: int64;
    Written: int64;
    Flushes: int32;
  end;

  // A read / write stream that cannot change its size: every call goes to
  // Inner (a memory IO), and it has no Truncate callback
  NoTruncData = record
    Inner: IO;
  end;

const
  // 5 GiB + 32: past what a 32-bit long or a 32-bit unsigned reaches
  CBigSize: int64 = 5368709152;
  // 4 GiB + 7: where the C fixture seeks first
  CBigOffset: int64 = 4294967303;

var
  GFails: int32;
  // What the exit rows leave registered and open until the exit check's
  // release (std_hookio_exitrelease) closes them
  GExitMemory: IO;
  GExitPrefix: string;
  GExitSource: IOSource;
  GExitSourcePrefix: string;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the first ACount bytes at AFirst and ASecond are equal
routine SameBytes(const AFirst: ptr; const ASecond: ptr; const ACount: int64): bool;
begin
  return memcmp(AFirst, ASecond, ACount) = 0;
end;

// A failed open: nil, and errno is AError (errno cleared before the call by
// the caller, so the value is the call's own). A stream that opened anyway
// is closed (the row fails, the run goes on).
routine Failed(const AFile: ptr to FILE; const AErrno: int32; const AError: int32): bool;
begin
  if AFile <> nil then
    fclose(AFile);
    return false;
  end;
  return AErrno = AError;
end;

// A registered memory IO: two handles of their own on one stream, the name
// after the prefix optional, the bytes the caller's, w on the read-only IO
// refused (EACCES), the IO kept
// open by closing its handles
routine TestMemory();
var
  LData: array[0..7] of uint8;
  LCopy: array[0..7] of uint8;
  LMemory: IO;
  LPrefix: string;
  LFile: ptr to FILE;
  LSecond: ptr to FILE;
  LBare: ptr to FILE;
  LError: int32;
  LI: int32;
begin
  for LI := 0 to 7 do
    LData[LI] := uint8(40 + LI);
  end;
  LMemory := CreateMemoryIO(address of LData[0], 8, true);
  LPrefix := RegisterIO(LMemory);
  Check("register io", LPrefix <> "");
  Check("register io prefix form", LPrefix.starts_with("io://"));

  LFile := fopen((LPrefix + "/song.ogg").c_str(), "rb");
  Check("memory open ours", (LFile <> nil) and (FileIO(LFile) = LMemory));
  LSecond := fopen((LPrefix + "/song.ogg").c_str(), "rb");
  Check("memory second open own handle", (LSecond <> nil) and (LSecond <> LFile) and (FileIO(LSecond) = LMemory));
  LBare := fopen(LPrefix.c_str(), "r");
  Check("memory name optional", FileIO(LBare) = LMemory);

  Check("memory bytes through handle", (FileIO(LFile) <> nil) and (IOSeek(FileIO(LFile), 0, SeekOrigin.FromStart) = 0) and (IORead(FileIO(LFile), address of LCopy[0], 8) = 8) and SameBytes(address of LCopy[0], address of LData[0], 8));
  Check("memory first close", (LFile <> nil) and (fclose(LFile) = 0));

  // A read-only IO cannot be emptied: refused as a read-only file is
  errno := 0;
  LFile := fopen((LPrefix + "/song.ogg").c_str(), "wb");
  LError := errno;
  Check("memory write on read-only refused", Failed(LFile, LError, EACCES));

  Check("memory close", (LSecond <> nil) and (fclose(LSecond) = 0));
  Check("memory bare close", (LBare <> nil) and (fclose(LBare) = 0));
  LFile := fopen((LPrefix + "/song.ogg").c_str(), "rb");
  Check("memory close keeps io", (LFile <> nil) and (fclose(LFile) = 0) and (IOSize(LMemory) = 8));

  Check("memory unregister", UnregisterIO(LPrefix));
  Check("memory io close", IOClose(LMemory));
end;

// A registered file IO over the program's own file, beside the C runtime's
// own open of the same path
routine TestFile();
var
  LSelf: IO;
  LPrefix: string;
  LFile: ptr to FILE;
  LReal: ptr to FILE;
  LVirtual: array[0..3] of uint8;
  LBytes: array[0..3] of uint8;
begin
  LSelf := CreateFileIO(paramstr(0), FileMode.Read);
  LPrefix := RegisterIO(LSelf);
  Check("file register", (LSelf <> nil) and (LPrefix <> ""));

  LFile := fopen((LPrefix + "/self.bin").c_str(), "rb");
  Check("file open ours", FileIO(LFile) = LSelf);
  LReal := fopen(paramstr(0).c_str(), "rb");
  Check("real path not ours", (LReal <> nil) and (FileIO(LReal) = nil));

  Check("file bytes equal real", (FileIO(LFile) <> nil) and (LReal <> nil) and (IOSeek(FileIO(LFile), 0, SeekOrigin.FromStart) = 0) and (IORead(FileIO(LFile), address of LVirtual[0], 4) = 4) and (fread(address of LBytes[0], 1, 4, LReal) = 4) and SameBytes(address of LVirtual[0], address of LBytes[0], 4));

  Check("file close", (LFile <> nil) and (fclose(LFile) = 0));
  Check("real close", (LReal <> nil) and (fclose(LReal) = 0));
  Check("file unregister", UnregisterIO(LPrefix));
  Check("file io close", IOClose(LSelf));
end;

// A registered zip IOSource: entries opened through it (the handle owns the
// entry's IO), bytes equal CreateZipFileIO's, every refusal of an entry
routine TestZip();
var
  LZip: IOSource;
  LPrefix: string;
  LFile: ptr to FILE;
  LDirect: IO;
  LVirtual: array[0..11] of uint8;
  LBytes: array[0..11] of uint8;
  LError: int32;
begin
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_stored.zip");
  LPrefix := RegisterIOSource(LZip);
  Check("zip register", (LZip <> nil) and (LPrefix <> ""));

  LFile := fopen((LPrefix + "/hello.txt").c_str(), "rb");
  Check("zip open ours", FileIO(LFile) <> nil);
  Check("zip entry size", (FileIO(LFile) <> nil) and (IOSize(FileIO(LFile)) = 12));
  LDirect := CreateZipFileIO("$P:../../res/tests/std/fixtures/std_customio_stored.zip", "hello.txt");
  Check("zip entry bytes", (FileIO(LFile) <> nil) and (LDirect <> nil) and (IORead(FileIO(LFile), address of LVirtual[0], 12) = 12) and (IORead(LDirect, address of LBytes[0], 12) = 12) and SameBytes(address of LVirtual[0], address of LBytes[0], 12));
  Check("zip direct close", (LDirect <> nil) and IOClose(LDirect));
  Check("zip close", (LFile <> nil) and (fclose(LFile) = 0));

  LFile := fopen((LPrefix + "/data/bytes.bin").c_str(), "rb");
  Check("zip nested entry", (FileIO(LFile) <> nil) and (IOSize(FileIO(LFile)) = 256));
  Check("zip nested close", (LFile <> nil) and (fclose(LFile) = 0));

  errno := 0;
  LFile := fopen((LPrefix + "/missing.txt").c_str(), "rb");
  LError := errno;
  Check("zip missing entry", Failed(LFile, LError, ENOENT));

  errno := 0;
  LFile := fopen((LPrefix + "/hello.txt").c_str(), "r+b");
  LError := errno;
  Check("zip mode not offered", Failed(LFile, LError, EACCES));

  errno := 0;
  LFile := fopen((LPrefix + "/../hello.txt").c_str(), "rb");
  LError := errno;
  Check("zip refused path", Failed(LFile, LError, ENOENT));

  Check("zip unregister", UnregisterIO(LPrefix));
  errno := 0;
  LFile := fopen((LPrefix + "/hello.txt").c_str(), "rb");
  LError := errno;
  Check("zip open after unregister", Failed(LFile, LError, ENOENT));
  Check("zip source close", IOSourceClose(LZip));
end;

// Paths and modes refused before any stream is asked, and the registry's own
// refusals
routine TestRefused();
var
  LData: array[0..3] of uint8;
  LMemory: IO;
  LPrefix: string;
  LFile: ptr to FILE;
  LError: int32;
begin
  LData[0] := 1;
  LData[1] := 2;
  LData[2] := 3;
  LData[3] := 4;
  LMemory := CreateMemoryIO(address of LData[0], 4, true);
  LPrefix := RegisterIO(LMemory);

  errno := 0;
  LFile := fopen("io://999999/x.bin", "rb");
  LError := errno;
  Check("unregistered prefix", Failed(LFile, LError, ENOENT));

  errno := 0;
  LFile := fopen("io://0/x.bin", "rb");
  LError := errno;
  Check("prefix zero", Failed(LFile, LError, ENOENT));

  errno := 0;
  LFile := fopen(("io://0" + LPrefix.substr(5) + "/x.bin").c_str(), "rb");
  LError := errno;
  Check("prefix leading zero", Failed(LFile, LError, ENOENT));

  errno := 0;
  LFile := fopen("io://abc/x.bin", "rb");
  LError := errno;
  Check("prefix not a number", Failed(LFile, LError, ENOENT));

  // A leading "./", once or more, names the same path (a C library joining
  // a folder with no root and a name writes it so: raylib's textures)
  LFile := fopen(("./" + LPrefix + "/x.bin").c_str(), "rb");
  Check("prefix behind ./", (LFile <> nil) and (fgetc(LFile) = 1));
  if LFile <> nil then
    fclose(LFile);
  end;
  LFile := fopen(("././" + LPrefix + "/x.bin").c_str(), "rb");
  Check("prefix behind ././", (LFile <> nil) and (fgetc(LFile) = 1));
  if LFile <> nil then
    fclose(LFile);
  end;
@ifdef TARGET_X86_64_WINDOWS_GNU
  // On Windows ".\" is the same step
  LFile := fopen((".\\" + LPrefix + "/x.bin").c_str(), "rb");
  Check("prefix behind .\\", (LFile <> nil) and (fgetc(LFile) = 1));
  if LFile <> nil then
    fclose(LFile);
  end;
@endif
  // Anything else before the scheme is a plain path: the C runtime's (its
  // errno is the platform's: ENOENT on Linux, a ':' in a folder on Windows)
  LFile := fopen(("x/" + LPrefix + "/x.bin").c_str(), "rb");
  Check("prefix behind a folder is plain", LFile = nil);
  if LFile <> nil then
    fclose(LFile);
  end;

  // w+ empties: on a read-only IO refused as on a read-only file, kept
  errno := 0;
  LFile := fopen((LPrefix + "/x.bin").c_str(), "w+b");
  LError := errno;
  Check("mode w+ read-only EACCES", Failed(LFile, LError, EACCES)
    and (IOSize(LMemory) = 4) and (LData[3] = 4));

@ifdef TARGET_X86_64_WINDOWS_GNU
  // ucrt refuses an unknown letter; glibc ignores it (TestModes checks "rq"
  // against a real fopen on both targets)
  errno := 0;
  LFile := fopen((LPrefix + "/x.bin").c_str(), "rq");
  LError := errno;
  Check("mode unknown letter refused", Failed(LFile, LError, EINVAL));
@endif

  Check("register nil io", RegisterIO(nil) = "");
  Check("register nil source", RegisterIOSource(nil) = "");

  Check("unregister", UnregisterIO(LPrefix));
  Check("unregister twice", not UnregisterIO(LPrefix));
  Check("unregister not a prefix", not UnregisterIO(LPrefix + "/x.bin"));
  Check("refused io close", IOClose(LMemory));
end;

@ifdef TARGET_X86_64_WINDOWS_GNU

// fopen_s and _wfopen: a virtual path, a missing one, a real one
routine TestTargetNames(const APrefix: string; const AMemory: IO);
var
  LFile: ptr to FILE;
  LCode: int32;
  LError: int32;
begin
  LFile := nil;
  LCode := fopen_s(address of LFile, (APrefix + "/a.bin").c_str(), "rb");
  Check("fopen_s ours", (LCode = 0) and (FileIO(LFile) = AMemory));
  Check("fopen_s close", (LFile <> nil) and (fclose(LFile) = 0));

  LFile := nil;
  LCode := fopen_s(address of LFile, "io://999999/a.bin", "rb");
  Check("fopen_s missing", Failed(LFile, LCode, ENOENT));

  LFile := std_hookio_wfopen(APrefix + "/a.bin", "rb");
  Check("_wfopen ours", FileIO(LFile) = AMemory);
  Check("_wfopen close", (LFile <> nil) and (fclose(LFile) = 0));

  // Behind ".\" and "./" the wide path is ours too
  LFile := std_hookio_wfopen(".\\./" + APrefix + "/a.bin", "rb");
  Check("_wfopen behind .\\./", FileIO(LFile) = AMemory);
  Check("_wfopen behind close", (LFile <> nil) and (fclose(LFile) = 0));

  errno := 0;
  LFile := std_hookio_wfopen("io://999999/a.bin", "rb");
  LError := errno;
  Check("_wfopen missing", Failed(LFile, LError, ENOENT));

  LFile := std_hookio_wfopen(paramstr(0), "rb");
  Check("_wfopen real path", (LFile <> nil) and (FileIO(LFile) = nil));
  Check("_wfopen real close", (LFile <> nil) and (fclose(LFile) = 0));
end;

@else

// fopen64: a virtual path, a missing one, a real one
routine TestTargetNames(const APrefix: string; const AMemory: IO);
var
  LFile: ptr to FILE;
  LError: int32;
begin
  LFile := fopen64((APrefix + "/a.bin").c_str(), "rb");
  Check("fopen64 ours", FileIO(LFile) = AMemory);
  Check("fopen64 close", (LFile <> nil) and (fclose(LFile) = 0));

  errno := 0;
  LFile := fopen64("io://999999/a.bin", "rb");
  LError := errno;
  Check("fopen64 missing", Failed(LFile, LError, ENOENT));

  LFile := fopen64(paramstr(0).c_str(), "rb");
  Check("fopen64 real path", (LFile <> nil) and (FileIO(LFile) = nil));
  Check("fopen64 real close", (LFile <> nil) and (fclose(LFile) = 0));
end;

@endif

// The stream family from C (std_hookio_c.c), through the archive's own
// references: a virtual file and a real file read with the same calls give
// the same bytes and the same ftell size; a C write to a virtual file lands
// in the IO.
routine TestStreamC();
var
  LSource: array[0..63] of uint8;
  LVirtual: array[0..63] of uint8;
  LReal: array[0..63] of uint8;
  LMemory: IO;
  LPrefix: string;
  LReadPath: string;
  LVirtualCount: long;
  LRealCount: long;
  LVirtualSize: long;
  LRealSize: long;
  LTarget: IO;
  LWritePrefix: string;
  LWritten: long;
  LCheck: array[0..39] of uint8;
  LText: string;
  LTextOut: array[0..63] of char;
  LLines: long;
  LI: int32;
begin
  // A memory IO of known bytes, a NUL among them (binary data)
  for LI := 0 to 63 do
    LSource[LI] := uint8(65 + (LI mod 26));
  end;
  LSource[4] := uint8(0);
  LMemory := CreateMemoryIO(address of LSource[0], 64, true);
  LPrefix := RegisterIO(LMemory);
  Check("stream C register", LPrefix <> "");

  // The C fixture reads the virtual file, then the program's own real file;
  // both run fseek / ftell / rewind / fgetc / ungetc / fread / ferror / feof
  LReadPath := LPrefix + "/data.bin";
  LVirtualCount := std_hookio_c_read(LReadPath.c_str(), address of LVirtual[0], 64, address of LVirtualSize);
  Check("stream C read virtual", LVirtualCount = 64);
  Check("stream C ftell size virtual", LVirtualSize = 64);
  Check("stream C virtual bytes", (LVirtualCount = 64) and SameBytes(address of LVirtual[0], address of LSource[0], 64));

  LRealCount := std_hookio_c_read(paramstr(0).c_str(), address of LReal[0], 64, address of LRealSize);
  Check("stream C read real", LRealCount = 64);
  // The real file's first 64 bytes, read through CustomIO, must equal the C
  // fixture's read of it (same calls, a real FILE this time)
  LTarget := CreateFileIO(paramstr(0), FileMode.Read);
  Check("stream C real bytes", (LRealCount = 64) and (LTarget <> nil) and (IORead(LTarget, address of LSource[0], 64) = 64) and SameBytes(address of LReal[0], address of LSource[0], 64));
  Check("stream C real size", (LTarget <> nil) and (LRealSize = IOSize(LTarget)));
  if LTarget <> nil then
    IOClose(LTarget);
  end;

  Check("stream C unregister", UnregisterIO(LPrefix));
  Check("stream C io close", IOClose(LMemory));

  // fgets from C over a virtual text file: a 6-byte buffer splits the long
  // line, so "ab\n" "cdefg" "hij\n" "k" are 4 reads, joined back unchanged
  LText := "ab\ncdefghij\nk";
  LMemory := CreateMemoryIO(LText.data(), int64(LText.size()), true);
  LPrefix := RegisterIO(LMemory);
  LLines := std_hookio_c_readtext((LPrefix + "/t.txt").c_str(), address of LTextOut[0], 64);
  Check("stream C fgets lines", LLines = 4);
  Check("stream C fgets text", (LLines = 4) and (strcmp(address of LTextOut[0], LText.c_str()) = 0));
  Check("stream C text unregister", UnregisterIO(LPrefix));
  Check("stream C text io close", IOClose(LMemory));

  // C writes 40 bytes to a writable memory IO through fwrite / fputc / fflush
  LTarget := CreateMemoryIO();
  LWritePrefix := RegisterIO(LTarget);
  LWritten := std_hookio_c_write((LWritePrefix + "/out.bin").c_str(), 88, 40);
  Check("stream C write count", LWritten = 40);
  Check("stream C write landed", (IOSeek(LTarget, 0, SeekOrigin.FromStart) = 0) and (IORead(LTarget, address of LCheck[0], 40) = 40));
  LVirtualCount := 0;
  for LI := 0 to 39 do
    if LCheck[LI] = uint8(88) then
      LVirtualCount := LVirtualCount + 1;
    end;
  end;
  Check("stream C write bytes", LVirtualCount = 40);
  Check("stream C write unregister", UnregisterIO(LWritePrefix));
  Check("stream C write io close", IOClose(LTarget));
end;

// The stream family from PaskalCPP, each edge the C fixture does not reach:
// the seek origins and bounds, ftell, ungetc order, feof / ferror, a write
// and a read on the wrong mode, fileno, setvbuf.
routine TestStreamDirect();
var
  LData: array[0..9] of uint8;
  LMemory: IO;
  LPrefix: string;
  LFile: ptr to FILE;
  LByte: array[0..9] of uint8;
  LI: int32;
begin
  for LI := 0 to 9 do
    LData[LI] := uint8(48 + LI);
  end;
  LMemory := CreateMemoryIO(address of LData[0], 10, true);
  LPrefix := RegisterIO(LMemory);

  LFile := fopen((LPrefix + "/x.bin").c_str(), "rb");
  Check("direct open", (LFile <> nil) and (FileIO(LFile) = LMemory));
  // Every row below takes the handle: without one (a broken build) they are
  // not run, so the run fails as rows instead of crashing in the C runtime
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("direct handle rows", false);
    UnregisterIO(LPrefix);
    IOClose(LMemory);
    return;
  end;

  // Seek to the end, ftell is the size; seek within; before the start fails
  Check("direct seek end", fseek(LFile, 0, SEEK_END) = 0);
  Check("direct ftell at end", ftell(LFile) = 10);
  Check("direct seek set", fseek(LFile, 3, SEEK_SET) = 0);
  Check("direct ftell after set", ftell(LFile) = 3);
  Check("direct seek cur", fseek(LFile, 2, SEEK_CUR) = 0);
  Check("direct ftell after cur", ftell(LFile) = 5);
  errno := 0;
  Check("direct seek before start", (fseek(LFile, -1, SEEK_SET) = -1) and (errno = EINVAL));
  // That failed seek left the place where it was
  Check("direct place after failed seek", ftell(LFile) = 5);
  // A read-only fixed IO refuses a target past its end (EINVAL): HookIO
  // reports what the IO allows, it does not invent room
  errno := 0;
  Check("direct seek past end refused", (fseek(LFile, 20, SEEK_SET) = -1) and (errno = EINVAL));

  // fgetc then ungetc: the byte comes back next, and ungetc moves ftell back
  rewind(LFile);
  Check("direct fgetc", fgetc(LFile) = int32('0'));
  Check("direct ftell after getc", ftell(LFile) = 1);
  Check("direct ungetc", ungetc(int32('0'), LFile) = int32('0'));
  Check("direct ftell after ungetc", ftell(LFile) = 0);
  Check("direct fgetc after ungetc", fgetc(LFile) = int32('0'));

  // Read the next 3 bytes (place 1 -> 4); feof not set until a read stops short
  Check("direct fread 3", fread(address of LByte[0], 1, 3, LFile) = 3);
  Check("direct bytes 1..3", (LByte[0] = uint8('1')) and (LByte[1] = uint8('2')) and (LByte[2] = uint8('3')));
  Check("direct not eof yet", feof(LFile) = 0);
  // 6 bytes left (place 4 -> 10): ask for 8, get 6, feof set
  Check("direct fread to end", fread(address of LByte[0], 1, 8, LFile) = 6);
  Check("direct eof set", feof(LFile) <> 0);
  // A read fully at the end gives 0
  Check("direct fread at end", fread(address of LByte[0], 1, 4, LFile) = 0);
  Check("direct no error", ferror(LFile) = 0);
  clearerr(LFile);
  Check("direct clearerr", feof(LFile) = 0);

  // A write on a read-only handle fails with EBADF, ferror set
  errno := 0;
  Check("direct write refused", (fwrite(address of LData[0], 1, 1, LFile) = 0) and (errno = EBADF));
  Check("direct error after bad write", ferror(LFile) <> 0);

  // fileno has no descriptor
  errno := 0;
  Check("direct fileno", (fileno(LFile) = -1) and (errno = EBADF));
  // setvbuf takes a valid mode and nothing else: ucrt -1 with EINVAL,
  // glibc EOF with errno untouched (measured on a real FILE)
  Check("direct setvbuf", setvbuf(LFile, nil, _IONBF, 0) = 0);
  errno := 0;
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("direct setvbuf bad mode", (setvbuf(LFile, nil, 99, 0) = -1) and (errno = EINVAL));
@else
  Check("direct setvbuf bad mode", (setvbuf(LFile, nil, 99, 0) = EOF) and (errno = 0));
@endif

  Check("direct close", fclose(LFile) = 0);
  Check("direct unregister", UnregisterIO(LPrefix));
  Check("direct io close", IOClose(LMemory));

  // A writable handle: a fresh growable IO opened "ab" (a registered IO
  // refuses "wb"). fputc / fputs write, a read on it fails EBADF.
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  LFile := fopen((LPrefix + "/w.bin").c_str(), "ab");
  Check("direct write open", (LFile <> nil) and (FileIO(LFile) = LMemory));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("direct write handle rows", false);
    UnregisterIO(LPrefix);
    IOClose(LMemory);
    return;
  end;
  Check("direct fputc", fputc(int32('Z'), LFile) = int32('Z'));
  Check("direct fputs", fputs("ab", LFile) >= 0);
  errno := 0;
  // Written bytes are in the buffer. glibc flushes them, then its underflow
  // refuses (EBADF); a real ucrt FILE would hand back a stale buffer byte,
  // the handle refuses as ucrt's _filbuf does (ferror, errno untouched)
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("direct read refused", (fread(address of LByte[0], 1, 1, LFile) = 0) and (errno = 0) and (ferror(LFile) <> 0));
@else
  Check("direct read refused", (fread(address of LByte[0], 1, 1, LFile) = 0) and (errno = EBADF));
@endif
  Check("direct write close", fclose(LFile) = 0);
  Check("direct wrote bytes", (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0) and (IORead(LMemory, address of LByte[0], 3) = 3) and (LByte[0] = uint8('Z')) and (LByte[1] = uint8('a')) and (LByte[2] = uint8('b')));

  Check("direct write unregister", UnregisterIO(LPrefix));
  Check("direct write io close", IOClose(LMemory));
end;

// The byte the big stream holds at APlace
routine BigByte(const APlace: int64): uint8;
begin
  return uint8(APlace mod 251);
end;

routine BigRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64; var AState: IOState): int64;
var
  LBig: ptr to BigData;
  LOut: ptr to uint8;
  LCount: int64;
  LI: int64;
begin
  LBig := ptr to BigData(AUserData);
  LOut := ptr to uint8(ABuffer);
  LCount := CBigSize - LBig->Position;
  if LCount > ASize then
    LCount := ASize;
  end;
  if LCount < 0 then
    LCount := 0;
  end;
  LI := 0;
  while LI < LCount do
    LOut[LI] := BigByte(LBig->Position + LI);
    LI := LI + 1;
  end;
  LBig->Position := LBig->Position + LCount;
  if LCount < ASize then
    AState := IOState.Eof;
  end;
  return LCount;
end;

routine BigSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LBig: ptr to BigData;
  LTarget: int64;
begin
  LBig := ptr to BigData(AUserData);
  LTarget := AOffset;
  if AOrigin = SeekOrigin.FromCurrent then
    LTarget := LBig->Position + AOffset;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LTarget := CBigSize + AOffset;
  end;
  if (LTarget < 0) or (LTarget > CBigSize) then
    return -1;
  end;
  LBig->Position := LTarget;
  return LTarget;
end;

routine BigTell(const AUserData: ptr): int64;
begin
  return ptr to BigData(AUserData)->Position;
end;

routine BigSize(const AUserData: ptr): int64;
begin
  return CBigSize;
end;

routine CountWrite(const AUserData: ptr; const ABuffer: ptr; const ASize: int64; var AState: IOState): int64;
var
  LCount: ptr to CountData;
begin
  LCount := ptr to CountData(AUserData);
  LCount->Position := LCount->Position + ASize;
  if LCount->Position > LCount->Written then
    LCount->Written := LCount->Position;
  end;
  return ASize;
end;

routine CountSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LCount: ptr to CountData;
  LTarget: int64;
begin
  LCount := ptr to CountData(AUserData);
  LTarget := AOffset;
  if AOrigin = SeekOrigin.FromCurrent then
    LTarget := LCount->Position + AOffset;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LTarget := LCount->Written + AOffset;
  end;
  if (LTarget < 0) or (LTarget > LCount->Written) then
    return -1;
  end;
  LCount->Position := LTarget;
  return LTarget;
end;

routine CountTell(const AUserData: ptr): int64;
begin
  return ptr to CountData(AUserData)->Position;
end;

routine CountSize(const AUserData: ptr): int64;
begin
  return ptr to CountData(AUserData)->Written;
end;

routine CountFlush(const AUserData: ptr; var AState: IOState): bool;
var
  LCount: ptr to CountData;
begin
  LCount := ptr to CountData(AUserData);
  LCount->Flushes := LCount->Flushes + 1;
  return true;
end;

// The 64-bit forms from C over a stream past 4 GiB (CreateIO, nothing
// stored): a seek from the start, the end and the current place by the
// target's 64-bit names, the bytes there, and ftell's long at a place past
// 4 GiB (32 bits on Windows: -1, EINVAL as ucrt's), also against a real file
// (the program itself) seeked to the same place
routine TestStreamBig();
var
  LBig: BigData;
  LCallbacks: IOInterface;
  LStream: IO;
  LPrefix: string;
  LResults: array[0..6] of int64;
  LTellVirtual: array[0..2] of int64;
  LTellReal: array[0..2] of int64;
begin
  LBig.Position := 0;
  LCallbacks.Read := BigRead;
  LCallbacks.Write := nil;
  LCallbacks.Seek := BigSeek;
  LCallbacks.Tell := BigTell;
  LCallbacks.Size := BigSize;
  LCallbacks.Flush := nil;
  LCallbacks.Close := nil;
  LStream := CreateIO(LCallbacks, address of LBig);
  LPrefix := RegisterIO(LStream);
  Check("big register", LPrefix <> "");

  std_hookio_c_big((LPrefix + "/big.bin").c_str(), CBigOffset, address of LResults[0]);
  Check("big seek from start past 4 GiB", LResults[0] = CBigOffset);
  Check("big fgetc past 4 GiB", LResults[1] = int64(BigByte(CBigOffset)));
@ifdef TARGET_X86_64_WINDOWS_GNU
  // long is 32 bits: the place does not fit
  Check("big ftell overflow", (LResults[2] = -1) and (LResults[3] = EINVAL));
@else
  // long is 64 bits: ftell holds it (one past, after the fgetc)
  Check("big ftell long", (LResults[2] = CBigOffset + 1) and (LResults[3] = 0));
@endif

  // ftell's long past 4 GiB, every slot as the CRT gives it on a real file
  // (the program itself, seeked past its end to the same place)
  std_hookio_c_tellpast((LPrefix + "/big.bin").c_str(), CBigOffset, address of LTellVirtual[0]);
  std_hookio_c_tellpast(paramstr(0).c_str(), CBigOffset, address of LTellReal[0]);
  Check("big ftell long as real file", (LTellVirtual[0] = LTellReal[0]) and (LTellVirtual[1] = LTellReal[1]) and (LTellVirtual[2] = LTellReal[2]));
  Check("big seek from end 64", LResults[4] = CBigSize - 16);
  Check("big seek from current 64", LResults[5] = CBigSize - 11);
  Check("big getc near end", LResults[6] = int64(BigByte(CBigSize - 11)));

  Check("big unregister", UnregisterIO(LPrefix));
  Check("big io close", IOClose(LStream));
end;

// The printf family from C (fprintf, vfprintf, Windows __mingw_fprintf) and
// from the program's C++ (<cstdio>'s fprintf / vfprintf) onto one virtual
// file: the text lands in the IO
routine TestStreamText();
var
  LTarget: IO;
  LPrefix: string;
  LFile: ptr to FILE;
  LPrint: array[0..3] of int64;
  LText: array[0..15] of uint8;
  LExpect: string;
begin
  LTarget := CreateMemoryIO();
  LPrefix := RegisterIO(LTarget);
  std_hookio_c_print((LPrefix + "/log.txt").c_str(), address of LPrint[0]);
  Check("print C fprintf", LPrint[0] = 3);
  Check("print C vfprintf", LPrint[1] = 3);
  Check("print C third form", LPrint[2] = 3);
  Check("print C close", LPrint[3] = 0);

  LFile := fopen((LPrefix + "/log.txt").c_str(), "ab");
  Check("print open", (LFile <> nil) and (FileIO(LFile) = LTarget));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("print handle rows", false);
  else
    Check("print C++ fprintf", std_hookio_cpp_fprintf(LFile) = 3);
    Check("print C++ vfprintf", std_hookio_cpp_vfprintf(LFile) = 3);
    Check("print close", fclose(LFile) = 0);
  end;
  LExpect := "a1|bx|c3|d4|ey|";
  Check("print text", (IOSize(LTarget) = 15) and (IOSeek(LTarget, 0, SeekOrigin.FromStart) = 0) and (IORead(LTarget, address of LText[0], 15) = 15) and SameBytes(address of LText[0], LExpect.data(), 15));
  Check("print unregister", UnregisterIO(LPrefix));
  Check("print io close", IOClose(LTarget));
end;

// fflush(nil) reaches a HookIO handle (its IO's Flush runs), getc / putc from
// PaskalCPP, and on Windows _lock_file / _unlock_file do nothing on ours
routine TestStreamFlush();
var
  LCount: CountData;
  LCallbacks: IOInterface;
  LStream: IO;
  LPrefix: string;
  LFile: ptr to FILE;
  LData: array[0..3] of uint8;
  LMemory: IO;
  LFlushes: int32;
begin
  LCount.Position := 0;
  LCount.Written := 0;
  LCount.Flushes := 0;
  LCallbacks.Read := nil;
  LCallbacks.Write := CountWrite;
  LCallbacks.Seek := CountSeek;
  LCallbacks.Tell := CountTell;
  LCallbacks.Size := CountSize;
  LCallbacks.Flush := CountFlush;
  LCallbacks.Close := nil;
  LStream := CreateIO(LCallbacks, address of LCount);
  LPrefix := RegisterIO(LStream);
  LFile := fopen((LPrefix + "/count.bin").c_str(), "ab");
  Check("flush open", (LFile <> nil) and (FileIO(LFile) = LStream));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("flush handle rows", false);
  else
    Check("flush putc", putc(int32('q'), LFile) = int32('q'));
    LFlushes := LCount.Flushes;
    Check("flush all", fflush(nil) = 0);
    Check("flush all reached handle", LCount.Flushes = LFlushes + 1);
    Check("flush one", (fflush(LFile) = 0) and (LCount.Flushes = LFlushes + 2));
@ifdef TARGET_X86_64_WINDOWS_GNU
    _lock_file(LFile);
    Check("lock file no-op", fputc(int32('r'), LFile) = int32('r'));
    _unlock_file(LFile);
    Check("unlock file no-op", fputc(int32('s'), LFile) = int32('s'));
@endif
    Check("flush close", fclose(LFile) = 0);
  end;
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("flush wrote", LCount.Written = 3);
@else
  Check("flush wrote", LCount.Written = 1);
@endif
  Check("flush unregister", UnregisterIO(LPrefix));
  Check("flush io close", IOClose(LStream));

  // getc from PaskalCPP on a read handle
  LData[0] := 7;
  LData[1] := 9;
  LData[2] := 0;
  LData[3] := 0;
  LMemory := CreateMemoryIO(address of LData[0], 2, true);
  LPrefix := RegisterIO(LMemory);
  LFile := fopen((LPrefix + "/g.bin").c_str(), "rb");
  Check("getc open", (LFile <> nil) and (FileIO(LFile) = LMemory));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("getc handle rows", false);
  else
    Check("getc first", getc(LFile) = 7);
    Check("getc second", getc(LFile) = 9);
    Check("getc at end", (getc(LFile) = EOF) and (feof(LFile) <> 0));
    Check("getc close", fclose(LFile) = 0);
  end;
  Check("getc unregister", UnregisterIO(LPrefix));
  Check("getc io close", IOClose(LMemory));
end;

// AText into a new real file at APath (the C runtime's own FILE)
routine WriteRealFile(const APath: string; const AText: string): bool;
var
  LFile: ptr to FILE;
  LWritten: bool;
begin
  LFile := fopen(APath.c_str(), "wb");
  if LFile = nil then
    return false;
  end;
  LWritten := fwrite(AText.data(), 1, AText.size(), LFile) = AText.size();
  return (fclose(LFile) = 0) and LWritten;
end;

// One variant of std_hookio_c_scan over "12 34 56;x" on the virtual file and
// on the real one: the known values, then every slot against the real file's
routine CheckScan(const AName: string; const AVirtualPath: string; const ARealPath: string; const AVariant: int32);
var
  LVirtual: array[0..12] of int64;
  LReal: array[0..12] of int64;
  LSame: bool;
  LI: int32;
begin
  std_hookio_c_scan(AVirtualPath.c_str(), AVariant, address of LVirtual[0]);
  std_hookio_c_scan(ARealPath.c_str(), AVariant, address of LReal[0]);
  Check(AName + " counts", (LVirtual[0] = 2) and (LVirtual[5] = 1) and (LVirtual[9] = 1));
  Check(AName + " values", (LVirtual[1] = 12) and (LVirtual[2] = 34) and (LVirtual[6] = 56) and (LVirtual[10] = int64('x')));
  Check(AName + " places", (LVirtual[3] = 5) and (LVirtual[7] = 8) and (LVirtual[8] = int64(';')) and (LVirtual[12] = 10));
  Check(AName + " feof", (LVirtual[4] = 0) and (LVirtual[11] = 1));
  LSame := true;
  for LI := 0 to 12 do
    if LVirtual[LI] <> LReal[LI] then
      LSame := false;
    end;
  end;
  Check(AName + " as real file", LSame);
end;

// fscanf from C on a virtual text file and on a real file of the same text,
// by every scan name the target has: the numbers, and the place and feof
// after each scan are what the real file gives. Then one scan past more
// whitespace than one stand-in window holds (Windows: the window grows).
routine TestStreamScan();
var
  LText: string;
  LLong: string;
  LMemory: IO;
  LLongMemory: IO;
  LPrefix: string;
  LLongPrefix: string;
  LRealPath: string;
  LLongRealPath: string;
  LVirtual: array[0..4] of int64;
  LReal: array[0..4] of int64;
  LSame: bool;
  LI: int32;
begin
  LText := "12 34 56;x";
  LMemory := CreateMemoryIO(LText.data(), int64(LText.size()), true);
  LPrefix := RegisterIO(LMemory);
  LRealPath := paramstr(0) + ".scan.txt";
  Check("scan real file", WriteRealFile(LRealPath, LText));
@ifdef TARGET_X86_64_WINDOWS_GNU
  CheckScan("scan mingw", LPrefix + "/n.txt", LRealPath, 0);
  CheckScan("scan vfscanf", LPrefix + "/n.txt", LRealPath, 1);
  CheckScan("scan fscanf_s", LPrefix + "/n.txt", LRealPath, 2);
@else
  CheckScan("scan plain", LPrefix + "/n.txt", LRealPath, 0);
  CheckScan("scan vfscanf", LPrefix + "/n.txt", LRealPath, 1);
  CheckScan("scan plain vfscanf", LPrefix + "/n.txt", LRealPath, 2);
@endif
  Check("scan real removed", remove(LRealPath.c_str()) = 0);
  Check("scan unregister", UnregisterIO(LPrefix));
  Check("scan io close", IOClose(LMemory));

  LLong := "";
  for LI := 1 to 10000 do
    LLong := LLong + " ";
  end;
  LLong := LLong + "77!";
  LLongMemory := CreateMemoryIO(LLong.data(), int64(LLong.size()), true);
  LLongPrefix := RegisterIO(LLongMemory);
  LLongRealPath := paramstr(0) + ".scanlong.txt";
  Check("scan long real file", WriteRealFile(LLongRealPath, LLong));
  std_hookio_c_scanlong((LLongPrefix + "/s.txt").c_str(), address of LVirtual[0]);
  std_hookio_c_scanlong(LLongRealPath.c_str(), address of LReal[0]);
  Check("scan long value", (LVirtual[0] = 1) and (LVirtual[1] = 77));
  Check("scan long place", (LVirtual[2] = 10002) and (LVirtual[3] = 0) and (LVirtual[4] = int64('!')));
  LSame := true;
  for LI := 0 to 4 do
    if LVirtual[LI] <> LReal[LI] then
      LSame := false;
    end;
  end;
  Check("scan long as real file", LSame);
  Check("scan long real removed", remove(LLongRealPath.c_str()) = 0);
  Check("scan long unregister", UnregisterIO(LLongPrefix));
  Check("scan long io close", IOClose(LLongMemory));
end;

@ifndef TARGET_X86_64_WINDOWS_GNU
// glibc's fortified names from C (what -D_FORTIFY_SOURCE code calls) on a
// virtual file and on a real file of the same bytes: the reads give the
// known values, every slot equals the real file's (including the cases where
// glibc's _chk rules differ from the plain names: n past the buffer on a
// short line, n of 0 and 1); the printf pair writes the same text into a
// virtual file as into a real one
routine TestStreamFortify();
var
  LText: string;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..13] of int64;
  LReal: array[0..13] of int64;
  LPrint: array[0..2] of int64;
  LRealPrint: array[0..2] of int64;
  LBytes: array[0..15] of uint8;
  LExpect: string;
  LFile: ptr to FILE;
  LSame: bool;
  LI: int32;
begin
  LText := "abc\nde\nfghijklmnop";
  LMemory := CreateMemoryIO(LText.data(), int64(LText.size()), true);
  LPrefix := RegisterIO(LMemory);
  LRealPath := paramstr(0) + ".chk.txt";
  Check("chk real file", WriteRealFile(LRealPath, LText));
  std_hookio_c_chkread((LPrefix + "/c.txt").c_str(), address of LVirtual[0]);
  std_hookio_c_chkread(LRealPath.c_str(), address of LReal[0]);
  Check("chk fgets", (LVirtual[0] = 1) and (LVirtual[1] = 4));
  Check("chk fgets_unlocked n past buffer", (LVirtual[2] = 1) and (LVirtual[3] = 3));
  Check("chk fread", (LVirtual[4] = 5) and (LVirtual[5] = int64('f')));
  Check("chk fread_unlocked", (LVirtual[6] = 3) and (LVirtual[7] = 1));
  Check("chk fgets at end", (LVirtual[8] = 1) and (LVirtual[9] = 18));
  Check("chk fgets n 0", (LVirtual[10] = 1) and (LVirtual[11] = 0));
  Check("chk fgets n 1", (LVirtual[12] = 1) and (LVirtual[13] = 0));
  LSame := true;
  for LI := 0 to 13 do
    if LVirtual[LI] <> LReal[LI] then
      LSame := false;
    end;
  end;
  Check("chk read as real file", LSame);
  Check("chk real removed", remove(LRealPath.c_str()) = 0);
  Check("chk unregister", UnregisterIO(LPrefix));
  Check("chk io close", IOClose(LMemory));

  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  LRealPath := paramstr(0) + ".chkprint.txt";
  std_hookio_c_chkprint((LPrefix + "/p.txt").c_str(), address of LPrint[0]);
  std_hookio_c_chkprint(LRealPath.c_str(), address of LRealPrint[0]);
  Check("chk fprintf", LPrint[0] = 3);
  Check("chk vfprintf", LPrint[1] = 3);
  Check("chk print close", LPrint[2] = 0);
  Check("chk print counts as real file", (LPrint[0] = LRealPrint[0]) and (LPrint[1] = LRealPrint[1]) and (LPrint[2] = LRealPrint[2]));
  LExpect := "p7|qz|";
  Check("chk print text", (IOSize(LMemory) = 6) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0) and (IORead(LMemory, address of LBytes[0], 6) = 6) and SameBytes(address of LBytes[0], LExpect.data(), 6));
  // The real file holds the same bytes (read back through the real FILE)
  LFile := fopen(LRealPath.c_str(), "rb");
  Check("chk print real text", (LFile <> nil) and (fread(address of LBytes[0], 1, 16, LFile) = 6) and SameBytes(address of LBytes[0], LExpect.data(), 6));
  if LFile <> nil then
    fclose(LFile);
  end;
  Check("chk print real removed", remove(LRealPath.c_str()) = 0);
  Check("chk print unregister", UnregisterIO(LPrefix));
  Check("chk print io close", IOClose(LMemory));
end;
@endif

// A read mode by index: "rt", "r" (text unless the program's _fmode is
// binary), "rb"
routine TextReadMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "rt";
  end;
  if AIndex = 1 then
    return "r";
  end;
  return "rb";
end;

// An append mode by index: "at", "a", "ab"
routine TextWriteMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "at";
  end;
  if AIndex = 1 then
    return "a";
  end;
  return "ab";
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the
// first differing slot is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64; const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// True when AIO's bytes equal the real file at APath's (read "rb" by C)
routine SameAsRealFile(const AIO: IO; const APath: string): bool;
var
  LVirtual: array[0..63] of uint8;
  LReal: array[0..63] of uint8;
  LRealSize: long;
  LReport: long;
  LSize: int64;
begin
  LRealSize := std_hookio_c_read(APath.c_str(), address of LReal[0], 64, address of LReport);
  LSize := IOSize(AIO);
  if (LRealSize < 0) or (LSize <> int64(LRealSize)) or (LSize > 64) then
    return false;
  end;
  if IOSeek(AIO, 0, SeekOrigin.FromStart) <> 0 then
    return false;
  end;
  if IORead(AIO, address of LVirtual[0], LSize) <> LSize then
    return false;
  end;
  return SameBytes(address of LVirtual[0], address of LReal[0], LSize);
end;

// Text mode from C on a virtual file and on a real file of the same bytes
// (Windows: ucrt's text mode; Linux has none, every mode reads and writes
// the bytes as they are). Every sample through "rt", "r" and "rb": every
// read slot equals the real file's. The write forms through "at", "a" and
// "ab": the same slots, and the IO holds the real file's bytes. "r+t"
// writing at the end of a text that ends in a Ctrl-Z: the same.
routine TestStreamTextMode();
var
  LSample: array[0..63] of uint8;
  LLength: long;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..121] of int64;
  LReal: array[0..121] of int64;
  LIndex: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".textmode.txt";
  for LIndex := 0 to std_hookio_c_textcount() - 1 do
    LLength := std_hookio_c_textsample(LIndex, address of LSample[0], 64);
    Check("text sample " + std::to_string(LIndex), LLength > 0);
    LMemory := CreateMemoryIO(address of LSample[0], int64(LLength), true);
    LPrefix := RegisterIO(LMemory);
    Check("text real file " + std::to_string(LIndex), std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
    for LMode := 0 to 2 do
      LName := "text " + std::to_string(LIndex) + " " + TextReadMode(LMode);
      std_hookio_c_textread((LPrefix + "/t.txt").c_str(), TextReadMode(LMode).c_str(), address of LVirtual[0]);
      std_hookio_c_textread(LRealPath.c_str(), TextReadMode(LMode).c_str(), address of LReal[0]);
      Check(LName + " closed", LVirtual[121] = 0);
      Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 122));
      if (LIndex = 0) and (LMode = 0) then
        // "12\r\n34\rx\r\r\ny", Ctrl-Z, "z\r\n": translated up to the Ctrl-Z
        // on Windows, as it is on Linux
@ifdef TARGET_X86_64_WINDOWS_GNU
        Check(LName + " translated", (LVirtual[0] = 10) and (LVirtual[5] = 10) and (LVirtual[8] = 13) and (LVirtual[12] = int64('y')));
@else
        Check(LName + " as it is", (LVirtual[0] = 16) and (LVirtual[5] = 13) and (LVirtual[6] = 10));
@endif
      end;
    end;
    Check("text unregister " + std::to_string(LIndex), UnregisterIO(LPrefix));
    Check("text io close " + std::to_string(LIndex), IOClose(LMemory));
  end;

  for LMode := 0 to 2 do
    LName := "text write " + TextWriteMode(LMode);
    LMemory := CreateMemoryIO();
    LPrefix := RegisterIO(LMemory);
    // A fresh real file for the append: it may not exist yet
    remove(LRealPath.c_str());
    std_hookio_c_textwrite((LPrefix + "/w.txt").c_str(), TextWriteMode(LMode).c_str(), address of LVirtual[0]);
    std_hookio_c_textwrite(LRealPath.c_str(), TextWriteMode(LMode).c_str(), address of LReal[0]);
    Check(LName + " closed", LVirtual[6] = 0);
    Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 7));
    Check(LName + " bytes as real file", SameAsRealFile(LMemory, LRealPath));
    if LMode = 0 then
      // "a\nb\r\n" "\n" "c\n" "9\n": text mode writes each '\n' as "\r\n" and
      // keeps the '\r' before one ("a\r\nb\r\r\n\r\nc\r\n9\r\n", 15 bytes)
@ifdef TARGET_X86_64_WINDOWS_GNU
      Check(LName + " size", IOSize(LMemory) = 15);
@else
      Check(LName + " size", IOSize(LMemory) = 10);
@endif
    end;
    Check(LName + " unregister", UnregisterIO(LPrefix));
    Check(LName + " io close", IOClose(LMemory));
  end;

  // "xy" and a Ctrl-Z (the last sample), updated at its end
  LLength := std_hookio_c_textsample(std_hookio_c_textcount() - 1, address of LSample[0], 64);
  LMemory := CreateMemoryIO();
  Check("text update io", (IOWrite(LMemory, address of LSample[0], int64(LLength)) = int64(LLength)) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0));
  LPrefix := RegisterIO(LMemory);
  Check("text update real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
  std_hookio_c_textupdate((LPrefix + "/u.txt").c_str(), address of LVirtual[0]);
  std_hookio_c_textupdate(LRealPath.c_str(), address of LReal[0]);
  Check("text update closed", LVirtual[3] = 0);
  Check("text update as real file", SameSlots(address of LVirtual[0], address of LReal[0], 4));
  Check("text update bytes as real file", SameAsRealFile(LMemory, LRealPath));
  Check("text update unregister", UnregisterIO(LPrefix));
  Check("text update io close", IOClose(LMemory));
  Check("text real removed", remove(LRealPath.c_str()) = 0);
end;

routine NoTruncRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64; var AState: IOState): int64;
var
  LInner: IO;
  LCount: int64;
begin
  LInner := ptr to NoTruncData(AUserData)->Inner;
  LCount := IORead(LInner, ABuffer, ASize);
  if LCount < ASize then
    AState := IOStatus(LInner);
  end;
  return LCount;
end;

routine NoTruncWrite(const AUserData: ptr; const ABuffer: ptr; const ASize: int64; var AState: IOState): int64;
var
  LInner: IO;
  LCount: int64;
begin
  LInner := ptr to NoTruncData(AUserData)->Inner;
  LCount := IOWrite(LInner, ABuffer, ASize);
  if LCount < ASize then
    AState := IOStatus(LInner);
  end;
  return LCount;
end;

routine NoTruncSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
begin
  return IOSeek(ptr to NoTruncData(AUserData)->Inner, AOffset, AOrigin);
end;

routine NoTruncTell(const AUserData: ptr): int64;
begin
  return IOTell(ptr to NoTruncData(AUserData)->Inner);
end;

routine NoTruncSize(const AUserData: ptr): int64;
begin
  return IOSize(ptr to NoTruncData(AUserData)->Inner);
end;

// Opens that change a registered IO's size (PLAN-HOOKABI 9f ii). "w"
// empties the IO as the C runtime's open truncates a file: a handle opened
// before reads what the "w" handle wrote, against a real file. An IO that
// cannot change its size (no Truncate): a text "+" open over a trailing
// Ctrl-Z opens with the byte kept and errno EACCES (Windows, against a real
// file a second handle maps, so it cannot shrink; Linux: "r+", against a
// real file, nothing to drop), and "w" is refused (Windows: against the
// mapped real file, EINVAL; Linux: EPERM, measured on an append-only file
// by tests\probe\hookabi\trunc_refuse.c, which needs root to make).
routine TestRegisteredWrite();
var
  LSample: array[0..7] of uint8;
  LMemory: IO;
  LNoTrunc: NoTruncData;
  LCallbacks: IOInterface;
  LStream: IO;
  LPrefix: string;
  LRealPath: string;
  LUpdateMode: string;
  LVirtual: array[0..7] of int64;
  LReal: array[0..7] of int64;
  LMapped: int32;
  LI: int32;
begin
  LRealPath := paramstr(0) + ".wover.txt";
  for LI := 0 to 7 do
    LSample[LI] := uint8(97 + LI);
  end;

  // "w" over a registered IO holding "abcdefgh"
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  Check("registered w io", (LPrefix <> "") and (IOWrite(LMemory, address of LSample[0], 8) = 8));
  Check("registered w real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], 8) = 0);
  std_hookio_c_wover((LPrefix + "/w.txt").c_str(), address of LVirtual[0]);
  std_hookio_c_wover(LRealPath.c_str(), address of LReal[0]);
  Check("registered w opened", (LVirtual[0] = 1) and (LVirtual[3] = 2));
  Check("registered w as real file", SameSlots(address of LVirtual[0], address of LReal[0], 8));
  Check("registered w bytes as real file", SameAsRealFile(LMemory, LRealPath));
  Check("registered w unregister", UnregisterIO(LPrefix));
  Check("registered w io close", IOClose(LMemory));

  // "xy" and a Ctrl-Z in an IO that cannot change its size
  LSample[0] := uint8('x');
  LSample[1] := uint8('y');
  LSample[2] := 26;
  LMemory := CreateMemoryIO();
  Check("noshorten inner", IOWrite(LMemory, address of LSample[0], 3) = 3);
  LNoTrunc.Inner := LMemory;
  LCallbacks.Read := NoTruncRead;
  LCallbacks.Write := NoTruncWrite;
  LCallbacks.Seek := NoTruncSeek;
  LCallbacks.Tell := NoTruncTell;
  LCallbacks.Size := NoTruncSize;
  LCallbacks.Flush := nil;
  LCallbacks.Close := nil;
  LCallbacks.Truncate := nil;
  LStream := CreateIO(LCallbacks, address of LNoTrunc);
  LPrefix := RegisterIO(LStream);
  Check("noshorten register", LPrefix <> "");

@ifdef TARGET_X86_64_WINDOWS_GNU
  LUpdateMode := "r+t";
@else
  LUpdateMode := "r+";
@endif
  Check("noshorten update real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], 3) = 0);
  std_hookio_c_noshorten((LPrefix + "/z.txt").c_str(), LUpdateMode.c_str(), address of LVirtual[0]);
  LMapped := std_hookio_c_noshorten(LRealPath.c_str(), LUpdateMode.c_str(), address of LReal[0]);
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("noshorten update real mapped", LMapped = 1);
  Check("noshorten update kept, EACCES", (LVirtual[0] = 1) and (LVirtual[1] = EACCES) and (LVirtual[2] = 3));
@else
  Check("noshorten update opened", (LVirtual[0] = 1) and (LVirtual[1] = 0) and (LVirtual[2] = 3));
@endif
  Check("noshorten update as real file", SameSlots(address of LVirtual[0], address of LReal[0], 5));
  Check("noshorten update byte kept", IOSize(LMemory) = 3);

  std_hookio_c_noshorten((LPrefix + "/z.txt").c_str(), "w", address of LVirtual[0]);
@ifdef TARGET_X86_64_WINDOWS_GNU
  LMapped := std_hookio_c_noshorten(LRealPath.c_str(), "w", address of LReal[0]);
  Check("noshorten w real mapped", LMapped = 1);
  Check("noshorten w refused EINVAL", (LVirtual[0] = 0) and (LVirtual[1] = EINVAL));
  Check("noshorten w as real file", SameSlots(address of LVirtual[0], address of LReal[0], 5));
@else
  Check("noshorten w refused EPERM", (LVirtual[0] = 0) and (LVirtual[1] = EPERM));
@endif
  Check("noshorten w kept", IOSize(LMemory) = 3);

  Check("noshorten unregister", UnregisterIO(LPrefix));
  Check("noshorten io close", IOClose(LStream));
  Check("noshorten inner close", IOClose(LMemory));
  Check("noshorten real removed", remove(LRealPath.c_str()) = 0);
end;

// One mode-string row: fopen in AMode from C on a folder-source entry
// (APrefix + "/mode.v", the file AFolder/mode.v) and on a real file beside it
// (AFolder/mode.r), first with both holding "a\r\nb" and a Ctrl-Z (a text
// open with + drops it on Windows), then with both missing: every slot
// (opened, errno, read, ftell, fputc, ferror, fclose) and the bytes left
// behind equal the real file's.
routine CheckMode(const APrefix: string; const AFolder: string; const AMode: string);
var
  LSample: array[0..4] of uint8;
  LVirtualFile: string;
  LRealFile: string;
  LName: string;
  LVirtual: array[0..8] of int64;
  LReal: array[0..8] of int64;
  LPass: int32;
begin
  LSample[0] := uint8('a');
  LSample[1] := 13;
  LSample[2] := 10;
  LSample[3] := uint8('b');
  LSample[4] := 26;
  LVirtualFile := AFolder + "/mode.v";
  LRealFile := AFolder + "/mode.r";
  for LPass := 0 to 1 do
    remove(LVirtualFile.c_str());
    remove(LRealFile.c_str());
    if LPass = 0 then
      LName := "mode '" + AMode + "' present";
      Check(LName + " files", (std_hookio_c_writeraw(LVirtualFile.c_str(), address of LSample[0], 5) = 0)
        and (std_hookio_c_writeraw(LRealFile.c_str(), address of LSample[0], 5) = 0));
    else
      LName := "mode '" + AMode + "' missing";
    end;
    std_hookio_c_mode((APrefix + "/mode.v").c_str(), AMode.c_str(), address of LVirtual[0]);
    std_hookio_c_mode(LRealFile.c_str(), AMode.c_str(), address of LReal[0]);
    Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 9));
    Check(LName + " bytes as real file", std_hookio_c_samebytes(LVirtualFile.c_str(), LRealFile.c_str()) = 1);
  end;
  remove(LVirtualFile.c_str());
  remove(LRealFile.c_str());
end;

// One ccs= row (PLAN-HOOKABI W3): fopen in AMode from C on a folder-source
// entry (APrefix + "/ccs.v", the file AFolder/ccs.v) and on a real file
// beside it (AFolder/ccs.r), both holding std_hookio_c_ccssample(ASample)
// first (ASample -1: both missing), then the wide reads / writes the mode
// allows (std_hookio_c_ccs): every slot (fopen's errno, each step's value,
// errno, ferror, fwide, ftell, fclose) and the bytes left behind equal the
// real file's.
routine CheckCcs(const APrefix: string; const AFolder: string; const AMode: string; const ASample: int32);
var
  LSample: array[0..31] of uint8;
  LLength: long;
  LVirtualFile: string;
  LRealFile: string;
  LName: string;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
begin
  LVirtualFile := AFolder + "/ccs.v";
  LRealFile := AFolder + "/ccs.r";
  remove(LVirtualFile.c_str());
  remove(LRealFile.c_str());
  LName := "ccs '" + AMode + "' sample " + std::to_string(ASample);
  if ASample >= 0 then
    LLength := std_hookio_c_ccssample(ASample, address of LSample[0], 32);
    Check(LName + " files", (LLength >= 0)
      and (std_hookio_c_writeraw(LVirtualFile.c_str(), address of LSample[0], LLength) = 0)
      and (std_hookio_c_writeraw(LRealFile.c_str(), address of LSample[0], LLength) = 0));
  end;
  std_hookio_c_ccs((APrefix + "/ccs.v").c_str(), AMode.c_str(), address of LVirtual[0]);
  std_hookio_c_ccs(LRealFile.c_str(), AMode.c_str(), address of LReal[0]);
  Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 141));
  Check(LName + " bytes as real file", std_hookio_c_samebytes(LVirtualFile.c_str(), LRealFile.c_str()) = 1);
  remove(LVirtualFile.c_str());
  remove(LRealFile.c_str());
end;

// The ccs= mode strings each CRT opens wide-oriented with a conversion
// (Windows ucrt: UTF-8 / UTF-16LE / UNICODE, its BOM rules; Linux glibc:
// any charset its converters know), and the ones it refuses, each over
// every sample and a missing file
routine CcsModeCount(): int32;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return 17;
@else
  return 9;
@endif
end;

routine CcsMode(const AIndex: int32): string;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  if AIndex = 0 then return "r,ccs=UTF-8"; end;
  if AIndex = 1 then return "r,ccs=UTF-16LE"; end;
  if AIndex = 2 then return "r,ccs=UNICODE"; end;
  if AIndex = 3 then return "rb,ccs=UTF-8"; end;
  if AIndex = 4 then return "w,ccs=UTF-8"; end;
  if AIndex = 5 then return "w,ccs=UTF-16LE"; end;
  if AIndex = 6 then return "w,ccs=UNICODE"; end;
  if AIndex = 7 then return "a,ccs=UTF-8"; end;
  if AIndex = 8 then return "a,ccs=UTF-16LE"; end;
  if AIndex = 9 then return "a,ccs=UNICODE"; end;
  if AIndex = 10 then return "r+,ccs=UTF-8"; end;
  if AIndex = 11 then return "r+,ccs=UNICODE"; end;
  if AIndex = 12 then return "w+,ccs=UTF-16LE"; end;
  if AIndex = 13 then return "a+,ccs=UTF-8"; end;
  if AIndex = 14 then return "a+,ccs=UNICODE"; end;
  if AIndex = 15 then return "r, ccs = utf-16le "; end;
  return "r,ccs=bogus";
@else
  if AIndex = 0 then return "r,ccs=UTF-8"; end;
  if AIndex = 1 then return "r,ccs=UTF-16LE"; end;
  if AIndex = 2 then return "w,ccs=UTF-8"; end;
  if AIndex = 3 then return "w,ccs=UTF-16LE"; end;
  if AIndex = 4 then return "a,ccs=UTF-8"; end;
  if AIndex = 5 then return "r+,ccs=UTF-8"; end;
  if AIndex = 6 then return "w+,ccs=ISO-8859-1"; end;
  if AIndex = 7 then return "r,ccs=UTF-7"; end;
  return "r,ccs=bogus";
@endif
end;

// Mode strings as each CRT's fopen parses them (Windows: ucrt's rules;
// Linux: glibc's, see HookIO's unit header), every one against a real fopen
// of the same string on a file of the same bytes in the same folder: the
// accepted forms, the refused ones (EINVAL), x (EEXIST when the file is
// there), spaces, hints and the characters glibc ignores. Then x on a
// registered IO (always there: EEXIST), then the ccs= opens.
routine TestModes();
var
  LExe: string;
  LFolder: string;
  LLength: long;
  LSource: IOSource;
  LPrefix: string;
  LMemory: IO;
  LMemoryPrefix: string;
  LVirtual: array[0..8] of int64;
  LCcs: int32;
  LSampleIndex: int32;
begin
  LExe := paramstr(0);
  LLength := std_hookio_c_dirlen(LExe.c_str());
  Check("modes folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := LExe.substr(0, LLength);
  LSource := CreateFolderIOSource(LFolder);
  LPrefix := RegisterIOSource(LSource);
  Check("modes source", (LSource <> nil) and (LPrefix <> ""));

  // Both targets
  CheckMode(LPrefix, LFolder, "r");
  CheckMode(LPrefix, LFolder, "rb");
  CheckMode(LPrefix, LFolder, "rt");
  CheckMode(LPrefix, LFolder, "r+");
  CheckMode(LPrefix, LFolder, "r+b");
  CheckMode(LPrefix, LFolder, "rb+");
  CheckMode(LPrefix, LFolder, "w+");
  CheckMode(LPrefix, LFolder, "w+b");
  CheckMode(LPrefix, LFolder, "wb+");
  CheckMode(LPrefix, LFolder, "a+");
  CheckMode(LPrefix, LFolder, "a+b");
  CheckMode(LPrefix, LFolder, "ab+");
  CheckMode(LPrefix, LFolder, "w+x");
  CheckMode(LPrefix, LFolder, "a+x");
  CheckMode(LPrefix, LFolder, "w");
  CheckMode(LPrefix, LFolder, "wb");
  CheckMode(LPrefix, LFolder, "a");
  CheckMode(LPrefix, LFolder, "ab");
  CheckMode(LPrefix, LFolder, "wx");
  CheckMode(LPrefix, LFolder, "wbx");
  CheckMode(LPrefix, LFolder, "ax");
  CheckMode(LPrefix, LFolder, "rx");
  CheckMode(LPrefix, LFolder, "r+x");
  CheckMode(LPrefix, LFolder, " r");
  CheckMode(LPrefix, LFolder, "rq");
  CheckMode(LPrefix, LFolder, "r++");
  CheckMode(LPrefix, LFolder, "rtb");
  CheckMode(LPrefix, LFolder, "R");
  CheckMode(LPrefix, LFolder, "x");
  CheckMode(LPrefix, LFolder, "");
@ifdef TARGET_X86_64_WINDOWS_GNU
  // ucrt: text forms, spaces, each flag's once-only rule, the hints, x only
  // with w, the encoding part's own refusals
  CheckMode(LPrefix, LFolder, "r+t");
  CheckMode(LPrefix, LFolder, "rt+");
  CheckMode(LPrefix, LFolder, "w+t");
  CheckMode(LPrefix, LFolder, "wt+");
  CheckMode(LPrefix, LFolder, "a+t");
  CheckMode(LPrefix, LFolder, "at+");
  CheckMode(LPrefix, LFolder, "wt");
  CheckMode(LPrefix, LFolder, "at");
  CheckMode(LPrefix, LFolder, "wxb");
  CheckMode(LPrefix, LFolder, "wtx");
  CheckMode(LPrefix, LFolder, "  rb");
  CheckMode(LPrefix, LFolder, "r b");
  CheckMode(LPrefix, LFolder, "rb ");
  CheckMode(LPrefix, LFolder, "r b ");
  CheckMode(LPrefix, LFolder, "rbt");
  CheckMode(LPrefix, LFolder, "rbb");
  CheckMode(LPrefix, LFolder, "rtt");
  CheckMode(LPrefix, LFolder, "rc");
  CheckMode(LPrefix, LFolder, "rn");
  CheckMode(LPrefix, LFolder, "rcn");
  CheckMode(LPrefix, LFolder, "rcc");
  CheckMode(LPrefix, LFolder, "rS");
  CheckMode(LPrefix, LFolder, "rR");
  CheckMode(LPrefix, LFolder, "rSR");
  CheckMode(LPrefix, LFolder, "rRR");
  CheckMode(LPrefix, LFolder, "rT");
  CheckMode(LPrefix, LFolder, "rTT");
  CheckMode(LPrefix, LFolder, "rN");
  CheckMode(LPrefix, LFolder, "rNN");
  CheckMode(LPrefix, LFolder, "rbcSTN");
  CheckMode(LPrefix, LFolder, "rDD");
  // D: the file is gone after the close, present or created
  CheckMode(LPrefix, LFolder, "rD");
  CheckMode(LPrefix, LFolder, "rbD");
  CheckMode(LPrefix, LFolder, "rtD");
  CheckMode(LPrefix, LFolder, "r+D");
  CheckMode(LPrefix, LFolder, "wD");
  CheckMode(LPrefix, LFolder, "wbD");
  CheckMode(LPrefix, LFolder, "w+D");
  CheckMode(LPrefix, LFolder, "w+tD");
  CheckMode(LPrefix, LFolder, "aD");
  CheckMode(LPrefix, LFolder, "a+D");
  CheckMode(LPrefix, LFolder, "wxD");
  CheckMode(LPrefix, LFolder, "r,");
  CheckMode(LPrefix, LFolder, "r,ccs");
  CheckMode(LPrefix, LFolder, "r, ccs = FOO");
  CheckMode(LPrefix, LFolder, "r,ccx=UTF-8");
  CheckMode(LPrefix, LFolder, "r,CCS=UTF-8");
  CheckMode(LPrefix, LFolder, "r,ccs=UTF-8x");
@else
  // glibc: no text mode, at most six characters after the first, a comma
  // ends them, every other character ignored
  CheckMode(LPrefix, LFolder, "r q+");
  CheckMode(LPrefix, LFolder, "rbbbbb+");
  CheckMode(LPrefix, LFolder, "rbbbbbb+");
  CheckMode(LPrefix, LFolder, "wbbbbbx");
  CheckMode(LPrefix, LFolder, "wbbbbbbx");
  CheckMode(LPrefix, LFolder, "rme");
  CheckMode(LPrefix, LFolder, "rD");
  CheckMode(LPrefix, LFolder, "r ");
  CheckMode(LPrefix, LFolder, "r,foo");
  CheckMode(LPrefix, LFolder, "r,+");
@endif

  // x on a registered IO: the IO is always there
  LMemory := CreateMemoryIO();
  LMemoryPrefix := RegisterIO(LMemory);
  std_hookio_c_mode((LMemoryPrefix + "/x.txt").c_str(), "wx", address of LVirtual[0]);
  Check("mode 'wx' registered EEXIST", (LVirtual[0] = 0) and (LVirtual[1] = EEXIST));
  Check("modes memory unregister", UnregisterIO(LMemoryPrefix));
  Check("modes memory close", IOClose(LMemory));

  // ccs= opens: the narrow names on them (CheckMode), then the wide ones
  // over every sample and a missing file (CheckCcs)
  for LCcs := 0 to CcsModeCount() - 1 do
    CheckMode(LPrefix, LFolder, CcsMode(LCcs));
    for LSampleIndex := -1 to std_hookio_c_ccscount() - 1 do
      CheckCcs(LPrefix, LFolder, CcsMode(LCcs), LSampleIndex);
    end;
  end;

  Check("modes unregister", UnregisterIO(LPrefix));
  Check("modes source close", IOSourceClose(LSource));
end;

@ifdef TARGET_X86_64_WINDOWS_GNU
// Two handles on a folder-source entry (APrefix + "/temp.v", the file
// AFolder/temp.v) and on a real file beside it (temp.r), both holding "abc"
// first: every slot of std_hookio_c_temppair and what is left behind equal
// the real file's (ucrt's D: the file goes at its last D close; a D handle
// and a plain one refuse each other)
routine CheckTempPair(const APrefix: string; const AFolder: string; const AFirst: string; const ASecond: string);
var
  LSample: array[0..2] of uint8;
  LVirtualFile: string;
  LRealFile: string;
  LName: string;
  LVirtual: array[0..7] of int64;
  LReal: array[0..7] of int64;
begin
  LSample[0] := uint8('a');
  LSample[1] := uint8('b');
  LSample[2] := uint8('c');
  LVirtualFile := AFolder + "/temp.v";
  LRealFile := AFolder + "/temp.r";
  LName := "temp '" + AFirst + "' then '" + ASecond + "'";
  Check(LName + " files", (std_hookio_c_writeraw(LVirtualFile.c_str(), address of LSample[0], 3) = 0)
    and (std_hookio_c_writeraw(LRealFile.c_str(), address of LSample[0], 3) = 0));
  std_hookio_c_temppair((APrefix + "/temp.v").c_str(), AFirst.c_str(), ASecond.c_str(), address of LVirtual[0]);
  std_hookio_c_temppair(LRealFile.c_str(), AFirst.c_str(), ASecond.c_str(), address of LReal[0]);
  Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 8));
  Check(LName + " left as real file", std_hookio_c_samebytes(LVirtualFile.c_str(), LRealFile.c_str()) = 1);
  remove(LVirtualFile.c_str());
  remove(LRealFile.c_str());
end;

// ucrt's D beyond the mode rows: the share rules between handles, a
// read-only file (D asks DELETE access), a source that cannot remove (a
// zip), and a registered IO (no file behind it: nothing removed)
routine TestTemporary();
var
  LExe: string;
  LFolder: string;
  LLength: long;
  LSource: IOSource;
  LPrefix: string;
  LSample: array[0..2] of uint8;
  LVirtualFile: string;
  LRealFile: string;
  LVirtual: array[0..8] of int64;
  LReal: array[0..8] of int64;
  LZip: IOSource;
  LZipPrefix: string;
  LMemory: IO;
  LMemoryPrefix: string;
  LFile: ptr to FILE;
  LSecond: ptr to FILE;
  LError: int32;
begin
  LExe := paramstr(0);
  LLength := std_hookio_c_dirlen(LExe.c_str());
  Check("temp folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := LExe.substr(0, LLength);
  LSource := CreateFolderIOSource(LFolder);
  LPrefix := RegisterIOSource(LSource);
  Check("temp source", (LSource <> nil) and (LPrefix <> ""));

  CheckTempPair(LPrefix, LFolder, "rD", "rD");
  CheckTempPair(LPrefix, LFolder, "rD", "rbD");
  CheckTempPair(LPrefix, LFolder, "r+D", "rD");
  CheckTempPair(LPrefix, LFolder, "wD", "r+D");
  CheckTempPair(LPrefix, LFolder, "rD", "r");
  CheckTempPair(LPrefix, LFolder, "rD", "w");
  CheckTempPair(LPrefix, LFolder, "r", "rD");
  CheckTempPair(LPrefix, LFolder, "r+", "wD");
  CheckTempPair(LPrefix, LFolder, "r", "r");

  // A read-only file: D asks DELETE access
  LSample[0] := uint8('a');
  LSample[1] := uint8('b');
  LSample[2] := uint8('c');
  LVirtualFile := LFolder + "/temp.v";
  LRealFile := LFolder + "/temp.r";
  Check("temp read-only files", (std_hookio_c_writeraw(LVirtualFile.c_str(), address of LSample[0], 3) = 0)
    and (std_hookio_c_writeraw(LRealFile.c_str(), address of LSample[0], 3) = 0)
    and (std_hookio_c_readonly(LVirtualFile.c_str(), 1) = 0) and (std_hookio_c_readonly(LRealFile.c_str(), 1) = 0));
  std_hookio_c_mode((LPrefix + "/temp.v").c_str(), "rD", address of LVirtual[0]);
  std_hookio_c_mode(LRealFile.c_str(), "rD", address of LReal[0]);
  Check("temp read-only as real file", SameSlots(address of LVirtual[0], address of LReal[0], 9));
  Check("temp read-only writable again", (std_hookio_c_readonly(LVirtualFile.c_str(), 0) = 0)
    and (std_hookio_c_readonly(LRealFile.c_str(), 0) = 0));
  Check("temp read-only left as real file", std_hookio_c_samebytes(LVirtualFile.c_str(), LRealFile.c_str()) = 1);
  remove(LVirtualFile.c_str());
  remove(LRealFile.c_str());

  Check("temp unregister", UnregisterIO(LPrefix));
  Check("temp source close", IOSourceClose(LSource));

  // A source that cannot remove an entry: refused as a file ucrt cannot
  // delete (EACCES); a missing entry is still missing (ENOENT)
  LZip := CreateZipIOSource("$P:../../res/tests/std/fixtures/std_customio_stored.zip");
  LZipPrefix := RegisterIOSource(LZip);
  Check("temp zip register", (LZip <> nil) and (LZipPrefix <> ""));
  errno := 0;
  LFile := fopen((LZipPrefix + "/hello.txt").c_str(), "rD");
  LError := errno;
  Check("temp zip refused", Failed(LFile, LError, EACCES));
  errno := 0;
  LFile := fopen((LZipPrefix + "/missing.txt").c_str(), "rD");
  LError := errno;
  Check("temp zip missing", Failed(LFile, LError, ENOENT));
  LFile := fopen((LZipPrefix + "/hello.txt").c_str(), "rb");
  Check("temp zip entry kept", (FileIO(LFile) <> nil) and (fclose(LFile) = 0));
  Check("temp zip unregister", UnregisterIO(LZipPrefix));
  Check("temp zip close", IOSourceClose(LZip));

  // A registered IO: nothing is removed, a plain handle and a D one coexist
  LMemory := CreateMemoryIO();
  Check("temp memory io", IOWrite(LMemory, address of LSample[0], 3) = 3);
  LMemoryPrefix := RegisterIO(LMemory);
  LFile := fopen((LMemoryPrefix + "/m.txt").c_str(), "rD");
  LSecond := fopen((LMemoryPrefix + "/m.txt").c_str(), "rb");
  Check("temp memory opened", (FileIO(LFile) = LMemory) and (FileIO(LSecond) = LMemory));
  Check("temp memory closed", (LFile <> nil) and (fclose(LFile) = 0) and (LSecond <> nil) and (fclose(LSecond) = 0));
  Check("temp memory kept", IOSize(LMemory) = 3);
  LFile := fopen((LMemoryPrefix + "/m.txt").c_str(), "rb");
  Check("temp memory still registered", (FileIO(LFile) = LMemory) and (fclose(LFile) = 0));
  Check("temp memory unregister", UnregisterIO(LMemoryPrefix));
  Check("temp memory close", IOClose(LMemory));
end;
@endif

// The long text samples from C on a virtual file and on a real file of the
// same bytes (Windows: ucrt's buffer, its 4096-byte fills and the 512-byte
// fill after an fseek, a '\r' or a lone '\n' at a fill boundary, a Ctrl-Z
// after one, reads past a Ctrl-Z after ftell; Linux: the bytes as they are),
// through "rt", "r" and "rb": every slot equals the real file's. Then a
// failed fseek after a read to the end: feof as the real file has it.
routine TestStreamTextLong();
var
  LSample: array[0..8191] of uint8;
  LLength: long;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..94] of int64;
  LReal: array[0..94] of int64;
  LFail: array[0..5] of int64;
  LRealFail: array[0..5] of int64;
  LIndex: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".textlong.txt";
  for LIndex := 0 to std_hookio_c_longcount() - 1 do
    LLength := std_hookio_c_longsample(LIndex, address of LSample[0], 8192);
    Check("long sample " + std::to_string(LIndex), LLength > 0);
    LMemory := CreateMemoryIO(address of LSample[0], int64(LLength), true);
    LPrefix := RegisterIO(LMemory);
    Check("long real file " + std::to_string(LIndex), std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
    for LMode := 0 to 2 do
      LName := "long " + std::to_string(LIndex) + " " + TextReadMode(LMode);
      std_hookio_c_textlong((LPrefix + "/l.txt").c_str(), TextReadMode(LMode).c_str(), address of LVirtual[0]);
      std_hookio_c_textlong(LRealPath.c_str(), TextReadMode(LMode).c_str(), address of LReal[0]);
      Check(LName + " closed", LVirtual[94] = 0);
      Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 95));
      if (LIndex = 0) and (LMode = 0) then
        // 600 bytes, 150 of them "\r\n": one fread gives 450 translated
        // bytes on Windows, all 600 on Linux
@ifdef TARGET_X86_64_WINDOWS_GNU
        Check(LName + " translated", (LVirtual[0] = 450) and (LVirtual[1] = 1));
@else
        Check(LName + " as it is", (LVirtual[0] = 600) and (LVirtual[1] = 1));
@endif
      end;
      std_hookio_c_seekfail((LPrefix + "/l.txt").c_str(), TextReadMode(LMode).c_str(), address of LFail[0]);
      std_hookio_c_seekfail(LRealPath.c_str(), TextReadMode(LMode).c_str(), address of LRealFail[0]);
      Check(LName + " seek fail closed", LFail[5] = 0);
      Check(LName + " seek fail as real file", SameSlots(address of LFail[0], address of LRealFail[0], 6));
    end;
    Check("long unregister " + std::to_string(LIndex), UnregisterIO(LPrefix));
    Check("long io close " + std::to_string(LIndex), IOClose(LMemory));
  end;
  Check("long real removed", remove(LRealPath.c_str()) = 0);
end;

// ungetc and scans from C on a virtual file and on a real file of the same
// bytes, every short and long sample through "rt", "r" and "rb": every slot
// equals the real file's (Windows text mode: ungetc into ucrt's buffer, a
// second one refused at its front, a scan's look-ahead that refills it).
routine TestStreamTextUnget();
var
  LSample: array[0..8191] of uint8;
  LLength: long;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..52] of int64;
  LReal: array[0..52] of int64;
  LIndex: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".textunget.txt";
  for LIndex := 0 to std_hookio_c_textcount() + std_hookio_c_longcount() - 1 do
    if LIndex < std_hookio_c_textcount() then
      LLength := std_hookio_c_textsample(LIndex, address of LSample[0], 8192);
      LName := "unget " + std::to_string(LIndex);
    else
      LLength := std_hookio_c_longsample(LIndex - std_hookio_c_textcount(), address of LSample[0], 8192);
      LName := "unget long " + std::to_string(LIndex - std_hookio_c_textcount());
    end;
    Check(LName + " sample", LLength > 0);
    LMemory := CreateMemoryIO(address of LSample[0], int64(LLength), true);
    LPrefix := RegisterIO(LMemory);
    Check(LName + " real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
    for LMode := 0 to 2 do
      std_hookio_c_textunget((LPrefix + "/g.txt").c_str(), TextReadMode(LMode).c_str(), address of LVirtual[0]);
      std_hookio_c_textunget(LRealPath.c_str(), TextReadMode(LMode).c_str(), address of LReal[0]);
      Check(LName + " " + TextReadMode(LMode) + " closed", LVirtual[52] = 0);
      Check(LName + " " + TextReadMode(LMode) + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 53));
    end;
    if LIndex = std_hookio_c_textcount() + std_hookio_c_longcount() - 1 then
      // The number that ends the first big fill: both values scanned
      Check(LName + " scanned", (LVirtual[42] = 2) and (LVirtual[43] = 12345) and (LVirtual[44] = 67));
    end;
    Check(LName + " unregister", UnregisterIO(LPrefix));
    Check(LName + " io close", IOClose(LMemory));
  end;
  Check("unget real removed", remove(LRealPath.c_str()) = 0);
end;

// setvbuf / setbuf from C on a virtual file and on a real file of the same
// 10000 bytes, every variant (std_hookio_c_svset: unbuffered, sizes with
// and without the caller's array, bad mode and size, setbuf, mid-read,
// after an ungetc) through "rt", "r" and "rb": every slot equals the real
// file's, the caller's array included (what the CRT filled it with shows
// each fill's size). Variant 23 on Linux (setvbuf while glibc reads ungot
// bytes from its backup area) has no real twin: glibc reads freed memory
// there and aborts at fclose; the handle keeps the stream where the caller
// stands (the ungot byte, then the file from the caller's place). Then
// fflush on a reading handle (glibc's sync, ucrt's nothing) against a real
// file, and glibc's stdout flush before a line-buffered fill.
routine TestStreamSetvbuf();
var
  LSample: array[0..9999] of uint8;
  LLength: long;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..36] of int64;
  LReal: array[0..36] of int64;
  LOut: array[0..2] of int64;
  LRealOut: array[0..2] of int64;
  LFlush: array[0..13] of int64;
  LRealFlush: array[0..13] of int64;
  LVariant: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".setvbuf.txt";
  LLength := std_hookio_c_svsample(address of LSample[0], 10000);
  Check("setvbuf sample", LLength = 10000);
  LMemory := CreateMemoryIO(address of LSample[0], int64(LLength), true);
  LPrefix := RegisterIO(LMemory);
  Check("setvbuf real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
  for LVariant := 0 to std_hookio_c_svcount() - 1 do
    for LMode := 0 to 2 do
      LName := "setvbuf " + std::to_string(LVariant) + " " + TextReadMode(LMode);
      std_hookio_c_setvbuf((LPrefix + "/v.txt").c_str(), TextReadMode(LMode).c_str(), LVariant, address of LVirtual[0]);
      Check(LName + " closed", LVirtual[36] = 0);
@ifndef TARGET_X86_64_WINDOWS_GNU
      if LVariant = 23 then
        // The stream stays where the caller stands: the ungot 'Z' first
        // (ftell 2 after it), then the file from byte 2 (fread's first
        // byte), and an fseek lands on its byte
        Check(LName + " keeps the stream", (LVirtual[0] = 0) and (LVirtual[3] = 90) and (LVirtual[4] = 2) and (LVirtual[6] = 250) and (LVirtual[8] = 252) and (LVirtual[20] = int64(LSample[7001])));
      else
        std_hookio_c_setvbuf(LRealPath.c_str(), TextReadMode(LMode).c_str(), LVariant, address of LReal[0]);
        Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 37));
      end;
@else
      std_hookio_c_setvbuf(LRealPath.c_str(), TextReadMode(LMode).c_str(), LVariant, address of LReal[0]);
      Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 37));
@endif
    end;
  end;
  for LVariant := 0 to std_hookio_c_frcount() - 1 do
    for LMode := 0 to 2 do
      LName := "fflush read " + std::to_string(LVariant) + " " + TextReadMode(LMode);
      std_hookio_c_fflushread((LPrefix + "/v.txt").c_str(), TextReadMode(LMode).c_str(), LVariant, address of LFlush[0]);
      std_hookio_c_fflushread(LRealPath.c_str(), TextReadMode(LMode).c_str(), LVariant, address of LRealFlush[0]);
      Check(LName + " closed", LFlush[13] = 0);
      Check(LName + " as real file", SameSlots(address of LFlush[0], address of LRealFlush[0], 14));
    end;
  end;
  std_hookio_c_svstdout((LPrefix + "/v.txt").c_str(), address of LOut[0]);
  std_hookio_c_svstdout(LRealPath.c_str(), address of LRealOut[0]);
  Check("setvbuf stdout as real file", SameSlots(address of LOut[0], address of LRealOut[0], 3));
@ifndef TARGET_X86_64_WINDOWS_GNU
  Check("setvbuf stdout flushed", (LOut[0] = 1) and (LOut[1] = 1) and (LOut[2] = int64(LSample[0])));
@endif
  Check("setvbuf unregister", UnregisterIO(LPrefix));
  Check("setvbuf io close", IOClose(LMemory));
  Check("setvbuf real removed", remove(LRealPath.c_str()) = 0);
end;

// The number of write modes WriteMode names
const
  CWriteModes: int32 = 12;

// A write mode by index: "r+t", "r+", "r+b" (update), "at", "a", "ab"
// (write only), "w+t", "w+", "w+b", "a+t", "a+", "a+b" (update)
routine WriteMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "r+t";
  end;
  if AIndex = 1 then
    return "r+";
  end;
  if AIndex = 2 then
    return "r+b";
  end;
  if AIndex = 3 then
    return "at";
  end;
  if AIndex = 4 then
    return "a";
  end;
  if AIndex = 5 then
    return "ab";
  end;
  if AIndex = 6 then
    return "w+t";
  end;
  if AIndex = 7 then
    return "w+";
  end;
  if AIndex = 8 then
    return "w+b";
  end;
  if AIndex = 9 then
    return "a+t";
  end;
  if AIndex = 10 then
    return "a+";
  end;
  return "a+b";
end;

// True when WriteMode(AIndex) reads as well as writes (a + mode)
routine WriteModeUpdates(const AIndex: int32): bool;
begin
  return (AIndex < 3) or (AIndex >= 6);
end;

// The write side from C on a virtual file and on a real file of the same
// bytes (std_hookio_c_writes, every variant: buffered fputc / fwrite /
// fputs / fprintf and their flushes, the caller's setvbuf array, _IONBF,
// _IOLBF, read / write turns, ftell with bytes pending, fclose with no
// fflush, and what another reader sees after each step) through every
// write mode: every slot equals the real file's. A variant C leaves
// undefined (a write right after a read, a read or ungetc right after a
// write) runs on the update modes only, twice: the handle with the
// undefined sequence, then with the call C requires made, each against
// the real file with that call made.
routine TestStreamWrites();
var
  LSample: array[0..5999] of uint8;
  LLength: long;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..47] of int64;
  LReal: array[0..47] of int64;
  LVariant: int32;
  LMode: int32;
  LForm: int32;
  LForms: int32;
  LDefined: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".writes.txt";
  LLength := std_hookio_c_wsample(address of LSample[0], 6000);
  Check("writes sample", LLength = 6000);
  for LVariant := 0 to std_hookio_c_wcount() - 1 do
    LDefined := std_hookio_c_wundefined(LVariant);
    LForms := LDefined + 1;
    for LMode := 0 to CWriteModes - 1 do
      if (LDefined = 0) or WriteModeUpdates(LMode) then
        for LForm := 0 to LForms - 1 do
          LName := "writes " + std::to_string(LVariant) + " " + WriteMode(LMode);
          if LDefined <> 0 then
            if LForm = 0 then
              LName := LName + " undefined";
            else
              LName := LName + " defined";
            end;
          end;
          LMemory := CreateMemoryIO();
          Check(LName + " io", (IOWrite(LMemory, address of LSample[0], int64(LLength)) = int64(LLength)) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0));
          LPrefix := RegisterIO(LMemory);
          Check(LName + " real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
          std_hookio_c_writes((LPrefix + "/w.txt").c_str(), WriteMode(LMode).c_str(), LVariant, LForm, address of LVirtual[0]);
          std_hookio_c_writes(LRealPath.c_str(), WriteMode(LMode).c_str(), LVariant, LDefined, address of LReal[0]);
          Check(LName + " closed", LVirtual[45] = 0);
          Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 48));
          Check(LName + " unregister", UnregisterIO(LPrefix));
          Check(LName + " io close", IOClose(LMemory));
        end;
      end;
    end;
  end;
  Check("writes real removed", remove(LRealPath.c_str()) = 0);
end;

// Reads on a write-only stream (at / a / ab) and fread / fwrite counts whose
// product overflows size_t, from C on a virtual file and on a real file:
// every slot equals the real file's (ucrt: fgetc refused by _filbuf, errno
// untouched; fread past a buffer EBADF from lowio; the overflow EINVAL,
// no ferror; glibc: EBADF from underflow / read(2), an ungot byte read
// back, the product wrapped to 0). Then a read with a written byte in the
// buffer: Linux as the real file (glibc flushes, then refuses); Windows,
// where a real ucrt FILE hands back whatever its buffer holds, refused as
// _filbuf refuses (EOF, ferror).
routine TestStreamWriteOnly();
var
  LSample: array[0..5999] of uint8;
  LLength: long;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..19] of int64;
  LReal: array[0..19] of int64;
  LMode: int32;
  LStale: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".wronly.txt";
  LLength := std_hookio_c_wsample(address of LSample[0], 6000);
  for LMode := 3 to 5 do
    for LStale := 0 to 1 do
      LName := "write only " + WriteMode(LMode) + " stale " + std::to_string(LStale);
      LMemory := CreateMemoryIO();
      Check(LName + " io", (IOWrite(LMemory, address of LSample[0], int64(LLength)) = int64(LLength)) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0));
      LPrefix := RegisterIO(LMemory);
      Check(LName + " real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
      std_hookio_c_wronly((LPrefix + "/o.txt").c_str(), WriteMode(LMode).c_str(), LStale, address of LVirtual[0]);
      Check(LName + " closed", LVirtual[16] = 0);
@ifdef TARGET_X86_64_WINDOWS_GNU
      std_hookio_c_wronly(LRealPath.c_str(), WriteMode(LMode).c_str(), 0, address of LReal[0]);
      Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 17));
      if LStale = 1 then
        Check(LName + " refused", (LVirtual[17] = int64('w')) and (LVirtual[18] = -1) and (LVirtual[19] = 1));
      end;
@else
      std_hookio_c_wronly(LRealPath.c_str(), WriteMode(LMode).c_str(), LStale, address of LReal[0]);
      Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 20));
@endif
      Check(LName + " unregister", UnregisterIO(LPrefix));
      Check(LName + " io close", IOClose(LMemory));
    end;
    // fscanf on the write-only stream, then over an ungot byte
    LName := "write only scan " + WriteMode(LMode);
    LMemory := CreateMemoryIO();
    Check(LName + " io", (IOWrite(LMemory, address of LSample[0], int64(LLength)) = int64(LLength)) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0));
    LPrefix := RegisterIO(LMemory);
    Check(LName + " real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
    std_hookio_c_wscan((LPrefix + "/s.txt").c_str(), WriteMode(LMode).c_str(), address of LVirtual[0]);
    std_hookio_c_wscan(LRealPath.c_str(), WriteMode(LMode).c_str(), address of LReal[0]);
    Check(LName + " closed", LVirtual[10] = 0);
    Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 11));
    Check(LName + " unregister", UnregisterIO(LPrefix));
    Check(LName + " io close", IOClose(LMemory));
  end;
  Check("write only real removed", remove(LRealPath.c_str()) = 0);
end;

// The locales the wide rows run under: "C" and the target's UTF-8 one
routine WideLocale(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "C";
  end;
@ifdef TARGET_X86_64_WINDOWS_GNU
  return ".UTF8";
@else
  return "C.UTF-8";
@endif
end;

// How many modes each wide variant runs in: Windows text by default, b and
// t; Linux has no text mode
routine WideModeCount(): int32;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return 3;
@else
  return 1;
@endif
end;

// The mode of wide variant AVariant, number AIndex: w (variant 8: w+, so
// its fseek block reads; variant 9: a), then with b and t on Windows
routine WideMode(const AVariant: int32; const AIndex: int32): string;
var
  LBase: string;
begin
  LBase := "w";
  if AVariant = 8 then
    LBase := "w+";
  end;
  if AVariant = 9 then
    LBase := "a";
  end;
  if AIndex = 1 then
    return LBase + "b";
  end;
  if AIndex = 2 then
    return LBase + "t";
  end;
  return LBase;
end;

// The wide names (std_hookio_c_widewrite's 12 variants) under each locale
// and mode, on a handle over a memory IO and on a real file: every step's
// value, errno, ferror, fwide and ftell, fclose and the bytes that landed
// equal the real file's
routine TestStreamWide();
var
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
  LVariant: int32;
  LLocale: int32;
  LMode: int32;
  LModeText: string;
  LName: string;
begin
  LRealPath := paramstr(0) + ".wide.txt";
  for LVariant := 0 to 11 do
    for LLocale := 0 to 1 do
      for LMode := 0 to WideModeCount() - 1 do
        LModeText := WideMode(LVariant, LMode);
        LName := "wide " + std::to_string(LVariant) + " " + WideLocale(LLocale) + " " + LModeText;
        LMemory := CreateMemoryIO();
        LPrefix := RegisterIO(LMemory);
        remove(LRealPath.c_str());
        std_hookio_c_widewrite((LPrefix + "/w.txt").c_str(), LModeText.c_str(), WideLocale(LLocale).c_str(), LVariant, address of LVirtual[0]);
        std_hookio_c_widewrite(LRealPath.c_str(), LModeText.c_str(), WideLocale(LLocale).c_str(), LVariant, address of LReal[0]);
        Check(LName + " ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and (LReal[73] = 1));
        Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 141));
        Check(LName + " unregister", UnregisterIO(LPrefix));
        Check(LName + " io close", IOClose(LMemory));
      end;
    end;
  end;
  Check("wide real removed", remove(LRealPath.c_str()) = 0);
end;

// The read modes the wide input rows run in: Windows text by default, b
// and t; Linux r and r+
routine WideReadModeCount(): int32;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return 3;
@else
  return 2;
@endif
end;

routine WideReadMode(const AIndex: int32): string;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  if AIndex = 1 then
    return "rb";
  end;
  if AIndex = 2 then
    return "rt";
  end;
  return "r";
@else
  if AIndex = 1 then
    return "r+";
  end;
  return "r";
@endif
end;

// The wide input names (std_hookio_c_wideread's 12 variants: fgetwc,
// getwc, fgetws, ungetwc, orientation, long reads, unmappable and cut-off
// bytes, seeks, CR runs, Ctrl-Z) under each locale and read mode, on a
// handle over a memory IO holding the variant's sample and on a real file
// of the same bytes: every step's value, errno, ferror, fwide and ftell
// equal the real file's
routine TestStreamWideRead();
var
  LSample: array[0..5999] of uint8;
  LLength: long;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
  LVariant: int32;
  LLocale: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".wread.txt";
  for LVariant := 0 to 11 do
    LLength := std_hookio_c_wrsample(LVariant, address of LSample[0], 6000);
    Check("wide read sample " + std::to_string(LVariant), LLength > 0);
    for LLocale := 0 to 1 do
      for LMode := 0 to WideReadModeCount() - 1 do
        LName := "wide read " + std::to_string(LVariant) + " " + WideLocale(LLocale) + " " + WideReadMode(LMode);
        LMemory := CreateMemoryIO();
        Check(LName + " io", (IOWrite(LMemory, address of LSample[0], int64(LLength)) = int64(LLength)) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0));
        LPrefix := RegisterIO(LMemory);
        Check(LName + " real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], LLength) = 0);
        std_hookio_c_wideread((LPrefix + "/r.txt").c_str(), WideReadMode(LMode).c_str(), WideLocale(LLocale).c_str(), LVariant, address of LVirtual[0]);
        std_hookio_c_wideread(LRealPath.c_str(), WideReadMode(LMode).c_str(), WideLocale(LLocale).c_str(), LVariant, address of LReal[0]);
        Check(LName + " ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and (LReal[73] = 1));
        Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 75));
@ifndef TARGET_X86_64_WINDOWS_GNU
        // Variant 8's fseek from the current place over an ungot wide
        // character (step 4, slot 18): glibc aborts it, and so must the handle
        if LVariant = 8 then
          Check(LName + " seek cur aborts", (LVirtual[18] = 1000) and (LReal[18] = 1000));
        end;
@endif
        Check(LName + " unregister", UnregisterIO(LPrefix));
        Check(LName + " io close", IOClose(LMemory));
      end;
    end;
  end;
  Check("wide read real removed", remove(LRealPath.c_str()) = 0);
end;

// The update modes the wide printf / scanf and lock-free rows run in
routine UpdateModeCount(): int32;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return 3;
@else
  return 1;
@endif
end;

routine UpdateMode(const AIndex: int32): string;
begin
  if AIndex = 1 then
    return "w+b";
  end;
  if AIndex = 2 then
    return "w+t";
  end;
  return "w+";
end;

// fwprintf / vfwprintf (Linux also __fwprintf_chk), then fwscanf /
// vfwscanf (Linux also the plain symbols) on what they wrote, under each
// locale and update mode, on a handle over a memory IO and on a real file:
// every step and the bytes written equal the real file's
routine TestStreamWideFormat();
var
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
  LLocale: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".wformat.txt";
  for LLocale := 0 to 1 do
    for LMode := 0 to UpdateModeCount() - 1 do
      LName := "wide format " + WideLocale(LLocale) + " " + UpdateMode(LMode);
      LMemory := CreateMemoryIO();
      LPrefix := RegisterIO(LMemory);
      remove(LRealPath.c_str());
      std_hookio_c_wformat((LPrefix + "/f.txt").c_str(), UpdateMode(LMode).c_str(), WideLocale(LLocale).c_str(), address of LVirtual[0]);
      std_hookio_c_wformat(LRealPath.c_str(), UpdateMode(LMode).c_str(), WideLocale(LLocale).c_str(), address of LReal[0]);
      Check(LName + " ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and (LReal[73] = 1));
      Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 141));
      Check(LName + " unregister", UnregisterIO(LPrefix));
      Check(LName + " io close", IOClose(LMemory));
    end;
  end;
  Check("wide format real removed", remove(LRealPath.c_str()) = 0);
end;

// The CRT-lock-free names from C (Windows _nolock, Linux *_unlocked and
// __fgetws_chk / __fgetws_unlocked_chk), the byte variant and the wide
// one, under each locale and update mode, on a handle over a memory IO and
// on a real file: every step and the bytes written equal the real file's
routine TestStreamNoLock();
var
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
  LVariant: int32;
  LLocale: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".nolock.txt";
  for LVariant := 0 to 1 do
    for LLocale := 0 to 1 do
      for LMode := 0 to UpdateModeCount() - 1 do
        LName := "nolock " + std::to_string(LVariant) + " " + WideLocale(LLocale) + " " + UpdateMode(LMode);
        LMemory := CreateMemoryIO();
        LPrefix := RegisterIO(LMemory);
        remove(LRealPath.c_str());
        std_hookio_c_nolock((LPrefix + "/n.txt").c_str(), UpdateMode(LMode).c_str(), WideLocale(LLocale).c_str(), LVariant, address of LVirtual[0]);
        std_hookio_c_nolock(LRealPath.c_str(), UpdateMode(LMode).c_str(), WideLocale(LLocale).c_str(), LVariant, address of LReal[0]);
        Check(LName + " ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and (LReal[73] = 1));
        Check(LName + " as real file", SameSlots(address of LVirtual[0], address of LReal[0], 141));
        Check(LName + " unregister", UnregisterIO(LPrefix));
        Check(LName + " io close", IOClose(LMemory));
      end;
    end;
  end;
  Check("nolock real removed", remove(LRealPath.c_str()) = 0);
end;

// The path source (SetIOPathSource): a folder source over the program's
// own folder holds ps_entry.txt ("ENTRY"). While it is set, a plain path
// naming that entry ("ps_entry.txt", "./ps_entry.txt", "/ps_entry.txt",
// ".\ps_entry.txt") opens the entry; a plain path the source has no entry
// for (the real file's full path) opens the real file; a name neither has
// fails as a missing file; the source's own open of its entry and
// CustomIO's file IO of the plain name mean the disk (the file IO finds no
// file unless the current folder is the program's). nil unsets it: the
// plain names open nothing (or the current folder's file).
routine TestPathSource();
var
  LExe: string;
  LFolder: string;
  LLength: long;
  LSource: IOSource;
  LSample: array[0..4] of uint8;
  LBuffer: array[0..63] of uint8;
  LSize: long;
  LCount: long;
  LInCurrent: bool;
  LEntryIO: IO;
  LFileIO: IO;
  LRealPath: string;
begin
  LExe := paramstr(0);
  LLength := std_hookio_c_dirlen(LExe.c_str());
  Check("path source folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := LExe.substr(0, LLength);
  LSample[0] := uint8('E');
  LSample[1] := uint8('N');
  LSample[2] := uint8('T');
  LSample[3] := uint8('R');
  LSample[4] := uint8('Y');
  Check("path source entry file", std_hookio_c_writeraw((LFolder + "/ps_entry.txt").c_str(), address of LSample[0], 5) = 0);
  LRealPath := LExe + ".psreal.txt";
  Check("path source real file", std_hookio_c_writeraw(LRealPath.c_str(), address of LSample[0], 3) = 0);
  // A plain relative name reaches the real file too when the current folder
  // is the program's: the rows that tell the two apart need it not to be
  LInCurrent := std_hookio_c_read("ps_entry.txt", address of LBuffer[0], 64, address of LSize) = 5;
  LSource := CreateFolderIOSource(LFolder);
  Check("path source made", LSource <> nil);
  Check("path source set", SetIOPathSource(LSource));

  LCount := std_hookio_c_read("ps_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("path source plain name", (LCount = 5) and (LBuffer[0] = uint8('E')) and (LBuffer[4] = uint8('Y')));
  LCount := std_hookio_c_read("./ps_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("path source dot name", LCount = 5);
  LCount := std_hookio_c_read("/ps_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("path source rooted name", LCount = 5);
  LCount := std_hookio_c_read(".\\ps_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("path source backslash name", LCount = 5);
  LCount := std_hookio_c_read(LRealPath.c_str(), address of LBuffer[0], 64, address of LSize);
  Check("path source missing entry -> real", (LCount = 3) and (LBuffer[0] = uint8('E')) and (LBuffer[2] = uint8('T')));
  LCount := std_hookio_c_read("ps_nowhere.txt", address of LBuffer[0], 64, address of LSize);
  Check("path source neither -> missing", LCount = -1);

  // The source's own open of its entry: the disk, no recursion
  LEntryIO := IOSourceOpen(LSource, "ps_entry.txt");
  Check("path source own open", (LEntryIO <> nil) and (IOSize(LEntryIO) = 5));
  if LEntryIO <> nil then
    Check("path source own close", IOClose(LEntryIO));
  end;
  // CustomIO's file IO of the plain name: the disk, never the entry
  LFileIO := CreateFileIO("ps_entry.txt", FileMode.Read);
  if LInCurrent then
    Check("path source file IO disk (current folder)", LFileIO <> nil);
  else
    Check("path source file IO disk", LFileIO = nil);
  end;
  if LFileIO <> nil then
    IOClose(LFileIO);
  end;

  Check("path source unset", SetIOPathSource(nil));
  LCount := std_hookio_c_read("/ps_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("path source unset rooted name", LCount = -1);
  if not LInCurrent then
    LCount := std_hookio_c_read("ps_entry.txt", address of LBuffer[0], 64, address of LSize);
    Check("path source unset plain name", LCount = -1);
  end;
  Check("path source close", IOSourceClose(LSource));
  Check("path source entry removed", remove((LFolder + "/ps_entry.txt").c_str()) = 0);
  Check("path source real removed", remove(LRealPath.c_str()) = 0);
end;

#include <thread>

// A hooked read of APath on a thread of its own, waited for: the count
// std_hookio_c_read gives (-1 also when the thread cannot start), the first
// byte read in AFirst
static std::int64_t std_hookio_read_apart(const char* APath, std::uint8_t* AFirst)
{
  std::int64_t LCount = -1;

  try
  {
    std::thread LThread([&]()
    {
      std::uint8_t LBuffer[64];
      long LSize = 0;
      LCount = std_hookio_c_read(APath, LBuffer, 64, &LSize);
      if (LCount > 0)
        *AFirst = LBuffer[0];
    });
    LThread.join();
  }
  catch (...)
  {
    LCount = -1;
  }
  return LCount;
}

// The thread path source (SetIOThreadPathSource): tp_entry.txt in the
// program's folder holds "PROG", in its parent "THRD"; the program's path
// source is a folder source over the first, the thread's one over the
// second. "/tp_entry.txt" is the name read (a plain path whose real file,
// at the root, is not there). While the thread's source is set this thread
// reads "THRD" and another thread still "PROG"; nil gives this thread the
// program's again; with no program path source the thread's still answers
// here and another thread finds nothing; setting one replaces the one
// before.
routine TestThreadPathSource();
var
  LExe: string;
  LFolder: string;
  LParent: string;
  LLength: long;
  LProgramSource: IOSource;
  LThreadSource: IOSource;
  LProgramBytes: array[0..3] of uint8;
  LThreadBytes: array[0..3] of uint8;
  LBuffer: array[0..63] of uint8;
  LSize: long;
  LCount: long;
  LFirst: uint8;
begin
  LExe := paramstr(0);
  LLength := std_hookio_c_dirlen(LExe.c_str());
  Check("thread source folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := LExe.substr(0, LLength);
  LLength := std_hookio_c_dirlen(LFolder.c_str());
  Check("thread source parent", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LParent := LFolder.substr(0, LLength);
  LProgramBytes[0] := uint8('P');
  LProgramBytes[1] := uint8('R');
  LProgramBytes[2] := uint8('O');
  LProgramBytes[3] := uint8('G');
  LThreadBytes[0] := uint8('T');
  LThreadBytes[1] := uint8('H');
  LThreadBytes[2] := uint8('R');
  LThreadBytes[3] := uint8('D');
  Check("thread source program file", std_hookio_c_writeraw((LFolder + "/tp_entry.txt").c_str(), address of LProgramBytes[0], 4) = 0);
  Check("thread source thread file", std_hookio_c_writeraw((LParent + "/tp_entry.txt").c_str(), address of LThreadBytes[0], 4) = 0);
  LProgramSource := CreateFolderIOSource(LFolder);
  LThreadSource := CreateFolderIOSource(LParent);
  Check("thread source made", (LProgramSource <> nil) and (LThreadSource <> nil));
  if (LProgramSource = nil) or (LThreadSource = nil) then
    return;
  end;

  Check("thread source program set", SetIOPathSource(LProgramSource));
  LCount := std_hookio_c_read("/tp_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("thread source none -> program", (LCount = 4) and (LBuffer[0] = uint8('P')));

  Check("thread source get none", GetIOThreadPathSource() = nil);
  Check("thread source set", SetIOThreadPathSource(LThreadSource));
  Check("thread source get", GetIOThreadPathSource() = LThreadSource);
  LCount := std_hookio_c_read("/tp_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("thread source this thread", (LCount = 4) and (LBuffer[0] = uint8('T')) and (LBuffer[3] = uint8('D')));
  LFirst := 0;
  LCount := std_hookio_read_apart("/tp_entry.txt", address of LFirst);
  Check("thread source other thread -> program", (LCount = 4) and (LFirst = uint8('P')));

  Check("thread source unset", SetIOThreadPathSource(nil));
  Check("thread source get unset", GetIOThreadPathSource() = nil);
  LCount := std_hookio_c_read("/tp_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("thread source unset -> program", (LCount = 4) and (LBuffer[0] = uint8('P')));

  Check("thread source program unset", SetIOPathSource(nil));
  Check("thread source alone set", SetIOThreadPathSource(LThreadSource));
  LCount := std_hookio_c_read("/tp_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("thread source alone this thread", (LCount = 4) and (LBuffer[0] = uint8('T')));
  LFirst := 0;
  LCount := std_hookio_read_apart("/tp_entry.txt", address of LFirst);
  Check("thread source alone other thread -> missing", LCount = -1);

  // A second set replaces the first: the program's folder, then the parent
  Check("thread source replace first", SetIOThreadPathSource(LProgramSource));
  LCount := std_hookio_c_read("/tp_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("thread source replaced -> program folder", (LCount = 4) and (LBuffer[0] = uint8('P')));
  Check("thread source replace second", SetIOThreadPathSource(LThreadSource));
  LCount := std_hookio_c_read("/tp_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("thread source replaced -> parent", (LCount = 4) and (LBuffer[0] = uint8('T')));

  Check("thread source last unset", SetIOThreadPathSource(nil));
  LCount := std_hookio_c_read("/tp_entry.txt", address of LBuffer[0], 64, address of LSize);
  Check("thread source none -> missing", LCount = -1);

  Check("thread source program close", IOSourceClose(LProgramSource));
  Check("thread source thread close", IOSourceClose(LThreadSource));
  Check("thread source program removed", remove((LFolder + "/tp_entry.txt").c_str()) = 0);
  Check("thread source thread removed", remove((LParent + "/tp_entry.txt").c_str()) = 0);
end;

// The exit flush: a handle on a memory IO over C's own array is left open
// with "EXITFLUSH" still in the CRT's buffer, and its IO stays registered.
// The check std_hookio_c_exitarm registered runs after the exit flush and
// ends the program with exit code 97 when the bytes did not land. Windows:
// a D handle on a folder-source entry is left open too; the check ends the
// program with exit code 96 when its file was not removed at exit. Both are
// kept in globals: once the check passed, its release closes them.
routine TestExitFlush();
@ifdef TARGET_X86_64_WINDOWS_GNU
var
  LExe: string;
  LLength: long;
  LFolder: string;
  LSample: array[0..2] of uint8;
@endif
begin
  // Read / write over C's array (it never grows: 16 bytes hold the 9)
  GExitMemory := CreateMemoryIO(std_hookio_c_exitarray(), 16);
  GExitPrefix := RegisterIO(GExitMemory);
  Check("exit flush left open", std_hookio_c_exitleave((GExitPrefix + "/x.bin").c_str()) = 0);
@ifdef TARGET_X86_64_WINDOWS_GNU
  LExe := paramstr(0);
  LLength := std_hookio_c_dirlen(LExe.c_str());
  Check("exit temp folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := LExe.substr(0, LLength);
  GExitSource := CreateFolderIOSource(LFolder);
  GExitSourcePrefix := RegisterIOSource(GExitSource);
  LSample[0] := uint8('a');
  LSample[1] := uint8('b');
  LSample[2] := uint8('c');
  Check("exit temp file", std_hookio_c_writeraw((LFolder + "/exit.tmp").c_str(), address of LSample[0], 3) = 0);
  Check("exit temp left open", std_hookio_c_exittemp((GExitSourcePrefix + "/exit.tmp").c_str(), (LFolder + "/exit.tmp").c_str()) = 0);
@endif
end;

// The exit check's release, run after it passed: unregisters and closes what
// the exit rows left open (the exit flush already ran on their handles), so
// the heap report at exit counts none of it
routine clink std_hookio_exitrelease();
begin
  if GExitPrefix <> "" then
    UnregisterIO(GExitPrefix);
  end;
  if GExitMemory <> nil then
    IOClose(GExitMemory);
    GExitMemory := nil;
  end;
  if GExitSourcePrefix <> "" then
    UnregisterIO(GExitSourcePrefix);
  end;
  if GExitSource <> nil then
    IOSourceClose(GExitSource);
    GExitSource := nil;
  end;
end;

// The target's own open names over one registered memory IO
routine TestTarget();
var
  LData: array[0..3] of uint8;
  LMemory: IO;
  LPrefix: string;
begin
  LData[0] := 5;
  LData[1] := 6;
  LData[2] := 7;
  LData[3] := 8;
  LMemory := CreateMemoryIO(address of LData[0], 4, true);
  LPrefix := RegisterIO(LMemory);
  TestTargetNames(LPrefix, LMemory);
  Check("target unregister", UnregisterIO(LPrefix));
  Check("target io close", IOClose(LMemory));
end;

begin
  GFails := 0;
  // Before any HookIO open: the exit check must run after the exit flush
  GExitMemory := nil;
  GExitPrefix := "";
  GExitSource := nil;
  GExitSourcePrefix := "";
  Check("exit flush armed", std_hookio_c_exitarm(std_hookio_exitrelease) = 0);
  TestMemory();
  TestFile();
  TestZip();
  TestRefused();
  TestStreamC();
  TestStreamDirect();
  TestStreamBig();
  TestStreamText();
  TestStreamWide();
  TestStreamWideRead();
  TestStreamWideFormat();
  TestStreamNoLock();
  TestStreamFlush();
  TestStreamScan();
@ifndef TARGET_X86_64_WINDOWS_GNU
  TestStreamFortify();
@endif
  TestStreamTextMode();
  TestRegisteredWrite();
  TestModes();
@ifdef TARGET_X86_64_WINDOWS_GNU
  TestTemporary();
@endif
  TestStreamTextLong();
  TestStreamTextUnget();
  TestStreamSetvbuf();
  TestStreamWrites();
  TestStreamWriteOnly();
  TestPathSource();
  TestThreadPathSource();
  TestTarget();
  TestExitFlush();
  println("done {}", GFails);
end.
