@addlibrarypath "$P:output/lib";

import
  CustomIO,
  HookIO;

// std_hookio_c.c: C that reads / writes a path through the stdio stream
// family. The hooks must bind these calls inside the archive.
routine clink std_hookio_c_read(const APath: ptr to const char; const ABuffer: ptr to uint8; const ACap: long; const AReportSize: ptr to long): long; external "std_hookio_lib";
routine clink std_hookio_c_readtext(const APath: ptr to const char; const AText: ptr to char; const ACap: long): long; external "std_hookio_lib";
routine clink std_hookio_c_write(const APath: ptr to const char; const AByte: int32; const ACount: long): long; external "std_hookio_lib";
// The 64-bit forms, the printf family, the wide names; each fills a results
// array (std_hookio_c.c documents its slots; -2 = a slot never reached)
routine clink std_hookio_c_big(const APath: ptr to const char; const AOffset: int64; const AResults: ptr to int64); external "std_hookio_lib";
routine clink std_hookio_c_tellpast(const APath: ptr to const char; const AOffset: int64; const AResults: ptr to int64); external "std_hookio_lib";
routine clink std_hookio_c_print(const APath: ptr to const char; const AResults: ptr to int64); external "std_hookio_lib";
routine clink std_hookio_c_widewrite(const APath: ptr to const char; const AMode: ptr to const char; const ALocale: ptr to const char; const AVariant: int32; const AResults: ptr to int64); external "std_hookio_lib";
// fscanf from C, then the target's other scan names by AVariant; one scan
// past more whitespace than one stand-in window holds
routine clink std_hookio_c_scan(const APath: ptr to const char; const AVariant: int32; const AResults: ptr to int64); external "std_hookio_lib";
routine clink std_hookio_c_scanlong(const APath: ptr to const char; const AResults: ptr to int64); external "std_hookio_lib";
