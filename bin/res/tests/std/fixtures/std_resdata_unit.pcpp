module unit std_resdata_unit;
@addresdata "unit" "$P:res/tests/std/fixtures/std_resdata_unit.txt";

import ResData;

// The unit's own key, read from inside the unit
exported routine UnitSize(): int64;
begin
  return FindResData("unit").Size;
end;

end.
