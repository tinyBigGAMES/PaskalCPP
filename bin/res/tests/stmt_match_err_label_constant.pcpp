-------------------------------------------------------------------------------
  stmt_match_err_label_constant.pcpp - break step of stmt_match.pcpp:
  a variable as a label: a label is a constant (SM0202)

  How to check, from repo\bin:
    pcpp res\tests\stmt_match_err_label_constant.pcpp
    pcpp res\tests\stmt_match_err_label_constant.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_match_err_label_constant;

var
  LN: int32;
  LM: int32;

begin
  LN := 1;
  LM := 2;
  match LN of
    1: println("a");
    LM: println("b"); // ERROR SM0202@5: a match label must be a constant
  end;
end.
