-------------------------------------------------------------------------------
  type_pointer_err_const_write.pcpp - break step of type_pointer.pcpp:
  a ptr to const writes nothing through it (SM0255)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_const_write.pcpp
    pcpp res\tests\type_pointer_err_const_write.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_const_write;

var
  LA: int32;
  LC: ptr to const int32;

begin
  LC := address of LA;
  LC^ := 1; // ERROR SM0255@3: 'LC^' cannot be assigned
end.
