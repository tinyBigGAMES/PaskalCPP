-------------------------------------------------------------------------------
  stmt_match_err_label_range.pcpp - break step of stmt_match.pcpp:
  a label outside the subject's type: it never matches (SM0604)

  How to check, from repo\bin:
    pcpp res\tests\stmt_match_err_label_range.pcpp
    pcpp res\tests\stmt_match_err_label_range.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_match_err_label_range;

var
  LB: int8;

begin
  LB := 1;
  match LB of
    300: println("big"); // ERROR SM0604@5: is outside
  end;
end.
