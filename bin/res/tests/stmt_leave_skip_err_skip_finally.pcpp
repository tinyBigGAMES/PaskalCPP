  stmt_leave_skip_err_skip_finally.pcpp - break step of stmt_leave_skip.pcpp:
  skip inside finally (SM0609)

  How to check, from repo\bin:
    pcpp res\tests\stmt_leave_skip_err_skip_finally.pcpp
    pcpp res\tests\stmt_leave_skip_err_skip_finally.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_leave_skip_err_skip_finally;

begin
  while true do
    guard
      println("body");
    finally
      skip; // ERROR SM0609@7: skip cannot jump out of finally
    end;
  end;
end.
