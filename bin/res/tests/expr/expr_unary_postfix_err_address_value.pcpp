module exe expr_unary_postfix_err_address_value;

/*
  @@test
    kind error
  @@end
*/

routine Five(): int32;
begin
  return 5;
end;

var
  LP: ptr to int32;

begin
  LP := address of Five(); // ERROR SM0254@20: 'Five()' has no address
end.
