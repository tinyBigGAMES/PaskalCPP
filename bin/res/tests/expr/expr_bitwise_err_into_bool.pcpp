-------------------------------------------------------------------------------
  expr_bitwise_err_into_bool.pcpp - Expr: bitwise, into bool

  Break step of expr_bitwise: the int32 result of & stored into a bool
  (SM0200): & is bitwise, its result is a number; write (LN & 1) <> 0.
*******************************************************************************/

module exe expr_bitwise_err_into_bool;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32 = 5;
  LB: bool;

begin
  LB := LN & 1; // ERROR SM0200@9: 'int32' does not convert implicitly to 'bool'
end.
