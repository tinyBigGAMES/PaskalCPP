-------------------------------------------------------------------------------
  expr_arithmetic_err_compound.pcpp - Expr: arithmetic, compound

  Break step of expr_arithmetic: an int32 added into an int8 with += (SM0200
  at the value): a compound assignment stores in the target's type, so its
  value converts to it; write LN += int8(LA).
*******************************************************************************/

module exe expr_arithmetic_err_compound;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int8 = 1;
  LA: int32 = 300;

begin
  LN += LA; // ERROR SM0200@9: 'int32' does not convert implicitly to 'int8'
end.
