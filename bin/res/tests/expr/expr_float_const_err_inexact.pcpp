-------------------------------------------------------------------------------
  expr_float_const_err_inexact.pcpp - Expr: float const, inexact

  Break step of expr_float_const: the constant 1.0 / 3.0 stored into a float32
  (SM0200): float32 cannot hold one third exactly; write float32(1.0 / 3.0).
*******************************************************************************/

module exe expr_float_const_err_inexact;

/*
  @@test
    kind error
  @@end
*/

var
  LF: float32;

begin
  LF := 1.0 / 3.0; // ERROR SM0200@9: 'float64' does not convert implicitly to 'float32'
end.
