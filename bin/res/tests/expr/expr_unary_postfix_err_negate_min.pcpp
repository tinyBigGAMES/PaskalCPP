  expr_unary_postfix_err_negate_min.pcpp - Expr: unary postfix, negate min

  Break step of expr_unary_postfix: negating the minimum int32 constant
  (SM0256).
*******************************************************************************/

module exe expr_unary_postfix_err_negate_min;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := -(-2147483647 - 1); // ERROR SM0256@9: constant overflows 'int32'
end.
