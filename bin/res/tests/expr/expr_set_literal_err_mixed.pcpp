-------------------------------------------------------------------------------
  expr_set_literal_err_mixed.pcpp - Expr: set literal, mixed

  Break step of expr_set_literal: an int32 and a char element in one literal
  (SM0266).
*******************************************************************************/

module exe expr_set_literal_err_mixed;

/*
  @@test
    kind error
  @@end
*/

type
  TDigits = set of 0..9;

var
  LD: TDigits;

begin
  LD := [1, 'a']; // ERROR SM0266@13: set literal elements are of different ordinal types
end.
