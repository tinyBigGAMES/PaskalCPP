-------------------------------------------------------------------------------
  expr_set_literal_err_low_high.pcpp - Expr: set literal, low high

  Break step of expr_set_literal: a range whose low bound exceeds its high
  bound (SM0267).
*******************************************************************************/

module exe expr_set_literal_err_low_high;

/*
  @@test
    kind error
  @@end
*/

type
  TDigits = set of 0..9;

var
  LD: TDigits;

begin
  LD := [5..1]; // ERROR SM0267@10: low bound 5 exceeds high bound 1
end.
