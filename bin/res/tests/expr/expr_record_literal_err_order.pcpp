-------------------------------------------------------------------------------
  expr_record_literal_err_order.pcpp - Expr: record literal, order

  Break step of expr_record_literal: fields out of declaration order (SM0416).
*******************************************************************************/

module exe expr_record_literal_err_order;

/*
  @@test
    kind error
  @@end
*/

type
  TP = record
    X: int32;
    Y: int32;
  end;

var
  LP: TP;

begin
  LP := TP(Y: 1, X: 2); // ERROR SM0416@18: 'X' comes before 'Y' in 'TP'
end.
