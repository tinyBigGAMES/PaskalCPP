-------------------------------------------------------------------------------
  expr_bitwise_err_bool_and.pcpp - Expr: bitwise, bool and

  Break step of expr_bitwise: & on two bools (SM0250): the symbols are bitwise
  and take integers; the logical words are and / or / not (xor takes two bools
  as well).
*******************************************************************************/

module exe expr_bitwise_err_bool_and;

/*
  @@test
    kind error
  @@end
*/

var
  LB: bool = true;
  LC: bool = false;

begin
  LB := LB & LC; // ERROR SM0250@9: operator '&' does not take 'bool' and 'bool'
end.
