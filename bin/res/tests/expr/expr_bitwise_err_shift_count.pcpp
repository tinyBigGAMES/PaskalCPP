-------------------------------------------------------------------------------
  expr_bitwise_err_shift_count.pcpp - Expr: bitwise, shift count

  Break step of expr_bitwise: a constant shift count of 32 on an int32
  (SM0259).
*******************************************************************************/

module exe expr_bitwise_err_shift_count;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 1 shl 32; // ERROR SM0259@15: shift count 32 outside 0..31
end.
