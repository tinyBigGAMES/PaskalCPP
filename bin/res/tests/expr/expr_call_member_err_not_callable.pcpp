module exe expr_call_member_err_not_callable;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;
  LM: int32;

begin
  LM := 1;
  LN := LM(1); // ERROR SM0400@9: 'LM' is not callable
end.
