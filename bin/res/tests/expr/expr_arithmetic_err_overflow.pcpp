-------------------------------------------------------------------------------
  expr_arithmetic_err_overflow.pcpp - Expr: arithmetic, overflow

  Break step of expr_arithmetic: a constant that overflows int32 (SM0256).
*******************************************************************************/

module exe expr_arithmetic_err_overflow;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 2147483647 + 1; // ERROR SM0256@9: constant overflows 'int32'
end.
