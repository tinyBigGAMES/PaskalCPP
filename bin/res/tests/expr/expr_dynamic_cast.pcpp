-------------------------------------------------------------------------------
  expr_dynamic_cast.pcpp - Expression: the C++ named cast dynamic_cast

  dynamic_cast is the fourth cpp named cast (BNF.md sec 6): its template
  argument and its ( expression ) are an expression PaskalCPP writes, the
  cast itself is C++'s. On a polymorphic class it gives the derived pointer
  when the object is one, and nullptr when it is not.
*******************************************************************************/

module exe expr_dynamic_cast;

/*
  @@test
    kind run
    expect
    | dynamic_cast 7 -1
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

struct TBase { virtual ~TBase() = default; };
struct TDerived : TBase { int Value = 7; };

static TDerived GDerived;
static TBase GBase;

TBase* PickBase(bool AWantDerived) { return AWantDerived ? static_cast<TBase*>(&GDerived) : &GBase; }
int ValueOf(TDerived* AObject) { return AObject ? AObject->Value : -1; }

begin
  println("dynamic_cast {} {}", ValueOf(dynamic_cast<TDerived*>(PickBase(true))),
    ValueOf(dynamic_cast<TDerived*>(PickBase(false))));
end.
