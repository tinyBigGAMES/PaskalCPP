module exe expr_varargs_err_local_count_call;

/*
  @@test
    kind error
  @@end
*/

routine V(...);
var
  LCopy: varargs;
begin
  LCopy := varargs.copy();
  println("{}", LCopy.count()); // ERROR SM0424@17: is a value, not a call
end;

begin
  V(1);
end.
