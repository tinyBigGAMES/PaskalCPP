-------------------------------------------------------------------------------
  expr_arithmetic_err_div_int64.pcpp - Expr: arithmetic, div int64

  Break step of expr_arithmetic: an int64 divided with / (SM0200): / is real
  division in float64, which cannot hold every int64; write float64(LBig) / 2
  or LBig div 2.
*******************************************************************************/

module exe expr_arithmetic_err_div_int64;

/*
  @@test
    kind error
  @@end
*/

var
  LBig: int64 = 9;
  LR: float64;

begin
  LR := LBig / 2; // ERROR SM0200@9: 'int64' does not convert implicitly to 'float64'
end.
