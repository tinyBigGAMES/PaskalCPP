-------------------------------------------------------------------------------
  expr_assign.pcpp - Expression: assignment

  Assignment is an expression (BNF.md sec 6 assign expr): := and the nine
  compound forms += -= *= /= %= &= |= <<= >>=, right associative, so
  LA := LB := 4 sets both. An expression statement whose operator is = is a
  comparison that assigns nothing (the break steps).
*******************************************************************************/

module exe expr_assign;

/*
  @@test
    kind run
    expect
    | plus 15
    | minus 12
    | times 24
    | mod 3
    | shl 12
    | shr 6
    | and 2
    | or 10
    | divide 0.25
    | chain 4 4
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

var
  LN: int32;
  LA: int32;
  LB: int32;
  LF: float64;

begin
  LN := 10;
  LN += 5;
  println("plus {}", LN);
  LN -= 3;
  println("minus {}", LN);
  LN *= 2;
  println("times {}", LN);
  LN %= 7;
  println("mod {}", LN);
  LN <<= 2;
  println("shl {}", LN);
  LN >>= 1;
  println("shr {}", LN);
  LN &= 3;
  println("and {}", LN);
  LN |= 8;
  println("or {}", LN);
  LF := 1.0;
  LF /= 4.0;
  println("divide {}", LF);
  LA := LB := 4;
  println("chain {} {}", LA, LB);
end.
