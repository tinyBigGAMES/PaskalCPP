module exe expr_call_member_err_no_member;

/*
  @@test
    kind error
  @@end
*/

type
  TQ = record
    N: int32;
  end;

var
  LQ: TQ;

begin
  LQ.Z := 1; // ERROR SM0009@3: 'TQ' has no member 'Z'
end.
