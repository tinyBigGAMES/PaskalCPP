-------------------------------------------------------------------------------
  expr_arithmetic_err_char.pcpp - Expr: arithmetic, char

  Break step of expr_arithmetic: a char plus an int32 (SM0250): a char, a
  wchar and a bool are no numbers (a wchar's width differs per target); write
  int32(LC) + 1.
*******************************************************************************/

module exe expr_arithmetic_err_char;

/*
  @@test
    kind error
  @@end
*/

var
  LC: char = 'a';
  LN: int32;

begin
  LN := LC + 1; // ERROR SM0250@9: operator '+' does not take 'char' and 'int32'
end.
