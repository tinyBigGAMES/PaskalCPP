module exe expr_record_literal_err_cpp_parent;

/*
  @@test
    kind error
  @@end
*/

struct CPoint {
  int x;
};

type
  TC = record(CPoint)
    Y: int32;
  end;

var
  LC: TC;

begin
  LC := TC(Y: 1); // ERROR SM0413@9: 'TC' is not one
end.
