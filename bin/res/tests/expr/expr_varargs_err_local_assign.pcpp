  expr_varargs_err_local_assign.pcpp - Expr: varargs, local assign

  Break step of expr_varargs: a varargs local set from something else than
  copy() (SM0422).
*******************************************************************************/

module exe expr_varargs_err_local_assign;

/*
  @@test
    kind error
  @@end
*/

routine V(...);
var
  LCopy: varargs;
begin
  LCopy := varargs.count; // ERROR SM0422@12: set from a copy()
end;

begin
  V(1);
end.
