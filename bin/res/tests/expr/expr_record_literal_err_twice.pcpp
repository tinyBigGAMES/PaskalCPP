-------------------------------------------------------------------------------
  expr_record_literal_err_twice.pcpp - Expr: record literal, twice

  Break step of expr_record_literal: a field given twice (SM0415).
*******************************************************************************/

module exe expr_record_literal_err_twice;

/*
  @@test
    kind error
  @@end
*/

type
  TP = record
    X: int32;
  end;

var
  LP: TP;

begin
  LP := TP(X: 1, X: 2); // ERROR SM0415@18: field 'X' is given twice
end.
