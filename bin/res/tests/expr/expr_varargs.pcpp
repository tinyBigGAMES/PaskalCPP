-------------------------------------------------------------------------------
  expr_varargs.pcpp - Expression: varargs

  varargs.count, next(T), get(I, T), reset() and copy() read the extra
  arguments of a cpplink variadic (BNF.md sec 6 varargs expr); a varargs
  local holds a copy with the same members (count is a value, not a call).
  Every argument travels with its type, checked at run time: a next / get
  of another type raises code 8, an index past the arguments code 9.
  Literals pack as int32 (int64 when larger), float64 and string.
*******************************************************************************/

module exe expr_varargs;

/*
  @@test
    kind run
    expect
    | count 2
    | local count 2
    | next 7
    | next seven
    | local next 7
    | local get seven
    | local after reset 7
    | wrong type code 8
    | bad index code 9
    | int32 1
    | int64 5000000000
    | float64 0.5
    | string s
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

routine Show(...);
var
  LCopy: varargs;
begin
  println("count {}", varargs.count);
  LCopy := varargs.copy();
  println("local count {}", LCopy.count);
  println("next {}", varargs.next(int32));
  println("next {}", varargs.next(string));
  println("local next {}", LCopy.next(int32));
  println("local get {}", LCopy.get(1, string));
  LCopy.reset();
  println("local after reset {}", LCopy.next(int32));
  guard
    varargs.reset();
    println("never {}", varargs.next(string));
  except
    println("wrong type code {}", exccode());
  end;
  guard
    println("never {}", varargs.get(5, int32));
  except
    println("bad index code {}", exccode());
  end;
end;

routine Literals(...);
begin
  println("int32 {}", varargs.next(int32));
  println("int64 {}", varargs.next(int64));
  println("float64 {}", varargs.next(float64));
  println("string {}", varargs.next(string));
end;

begin
  Show(7, "seven");
  Literals(1, 5000000000, 0.5, "s");
end.
