-------------------------------------------------------------------------------
  expr_float_const_err_to_int.pcpp - Expr: float const, to int

  Break step of expr_float_const: the constant NaN cast to an int32 (SM0200):
  an integer holds no NaN, no infinity and no value past its range, so such a
  cast of a constant is an error, never C++'s undefined conversion.
*******************************************************************************/

module exe expr_float_const_err_to_int;

/*
  @@test
    kind error
  @@end
*/

const
  KNaN: float64 = 0.0 / 0.0;

var
  LI: int32;

begin
  LI := int32(KNaN); // ERROR SM0200@9: nan does not fit in 'int32' (-2147483648..2147483647)
end.
