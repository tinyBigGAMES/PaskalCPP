-------------------------------------------------------------------------------
  expr_record_literal_err_no_field.pcpp - Expr: record literal, no field

  Break step of expr_record_literal: a field the record does not have
  (SM0414).
*******************************************************************************/

module exe expr_record_literal_err_no_field;

/*
  @@test
    kind error
  @@end
*/

type
  TP = record
    X: int32;
  end;

var
  LP: TP;

begin
  LP := TP(X: 1, Z: 2); // ERROR SM0414@18: 'TP' has no field 'Z'
end.
