-------------------------------------------------------------------------------
  expr_set_literal.pcpp - Expression: set literals

  [e, a..b, ...] (BNF.md sec 6 set literal): elements and ranges of one
  ordinal type (integers of any width are one family); [] is the empty set;
  x in S tests membership, of a set variable or of a literal written in
  place (its elements may be variables). A folded range runs low to high.
*******************************************************************************/

module exe expr_set_literal;

/*
  @@test
    kind run
    expect
    | in true false true
    | chars true false
    | empty false
    | literal true false
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

type
  TDigits = set of 0..9;
  TLetters = set of 'a'..'z';

var
  LD: TDigits;
  LL: TLetters;
  LN: int32 = 4;

begin
  LD := [1, 3..5, 8];
  println("in {} {} {}", 4 in LD, 6 in LD, LN in LD);
  LL := ['a', 'x'..'z'];
  println("chars {} {}", 'y' in LL, 'b' in LL);
  LD := [];
  println("empty {}", 1 in LD);
  println("literal {} {}", LN in [2..6], 9 in [LN, 5]);
end.
