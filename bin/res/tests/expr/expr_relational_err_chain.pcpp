module exe expr_relational_err_chain;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;
  LM: int32;

begin
  LN := 1;
  LM := 2;
  if LN < LM < 3 then // ERROR PR0038@14: comparisons do not chain
  end;
end.
