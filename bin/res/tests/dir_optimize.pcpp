-------------------------------------------------------------------------------
  dir_optimize.pcpp - Directive compliance: @optimize

  @optimize <level>; sets the build's optimize level, one of debug, safe,
  fast, small, exact case (BNF.md sec 2; the default is debug). Each level is
  its own file, because a module gives @optimize once: this one is small, the
  three below are the others. Each file prints the macros clang sees, which
  tell the levels apart (probed on both targets): debug defines PCPP_DEBUG
  (the runtime's heap report), safe __OPTIMIZE__, fast __OPTIMIZE__ and
  NDEBUG, small __OPTIMIZE__, __OPTIMIZE_SIZE__ and NDEBUG.

  How to check, from repo\bin:
    pcpp res\tests\dir_optimize.pcpp -r
    pcpp res\tests\dir_optimize.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    clang sees: __OPTIMIZE__ __OPTIMIZE_SIZE__ NDEBUG
  EXITCODE: 0
  Both targets print the same; a release build prints no [Heap] line.
  CHECK: output\build.zig holds "std.lang.Optimize = .small"

  The other levels: run each file below the same way; each header says what
  it prints:
    dir_optimize_debug.pcpp          @optimize debug
    dir_optimize_safe.pcpp           @optimize safe
    dir_optimize_fast.pcpp           @optimize fast

  Break it: run each file below the same way; each reports exactly what the
  // ERROR / WARN / HINT comment on its marked line says, and nothing else:
    dir_optimize_err_value.pcpp      a level that does not exist
    dir_optimize_err_case.pcpp       a level in the wrong case (Debug)
    dir_optimize_err_retired.pcpp    a retired spelling (release_fast)
  The prologue rules (once, main module only, a word not a string) are
  dir_prologue.pcpp's break steps.
*******************************************************************************/

module exe dir_optimize;
@optimize small;

// The macros clang defines at this level, in a fixed order
static const char* dir_optimize_flags()
{
  return ""
#ifdef __OPTIMIZE__
  " __OPTIMIZE__"
#endif
#ifdef __OPTIMIZE_SIZE__
  " __OPTIMIZE_SIZE__"
#endif
#ifdef NDEBUG
  " NDEBUG"
#endif
#ifdef PCPP_DEBUG
  " PCPP_DEBUG"
#endif
  ;
}

begin
  println("clang sees:{}", cpp("dir_optimize_flags()"));
end.
