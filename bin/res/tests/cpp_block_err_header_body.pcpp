  cpp_block_err_header_body.pcpp - break step of cpp_block.pcpp:
  cppstart header inside a body (PR0051)

  How to check, from repo\bin:
    pcpp res\tests\cpp_block_err_header_body.pcpp
    pcpp res\tests\cpp_block_err_header_body.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe cpp_block_err_header_body;

begin
  cppstart header // ERROR PR0051@12: write 'cppstart source'
  int LX = 1;
  cppend;
end.
