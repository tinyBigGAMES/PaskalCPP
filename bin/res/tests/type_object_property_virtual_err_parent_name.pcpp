-------------------------------------------------------------------------------
  type_object_property_virtual_err_parent_name.pcpp - break step of type_object_property_virtual.pcpp:
  a property is named as no field of the parent (SM0309)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_parent_name.pcpp
    pcpp res\tests\type_object_property_virtual_err_parent_name.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_parent_name;

type
  TBase = object
    A: int32;
  end;
  TKid = object(TBase)
    FB: int32;
    property A: int32 read FB; // ERROR SM0309@5: reuses a name of the parent chain
  end;

begin
end.
