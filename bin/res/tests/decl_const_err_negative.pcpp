  decl_const_err_negative.pcpp - break step of decl_const.pcpp:
  a negative constant for an unsigned type (-1 into uint8)

  How to check, from repo\bin:
    pcpp res\tests\decl_const_err_negative.pcpp
    pcpp res\tests\decl_const_err_negative.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_const_err_negative;

const
  CLow: uint8 = -1; // ERROR SM0200@17: -1 does not fit in 'uint8' (0..255)

begin
  println("{}", CLow);
end.
