-------------------------------------------------------------------------------
  stmt_for_err_float.pcpp - break step of stmt_for.pcpp:
  a float64 iterator: an integer, char, wchar or choice (SM0601)

  How to check, from repo\bin:
    pcpp res\tests\stmt_for_err_float.pcpp
    pcpp res\tests\stmt_for_err_float.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_for_err_float;

var
  LF: float64;

begin
  for LF := 1 to 3 do // ERROR SM0601@3: a for iterator is an integer
  end;
end.
