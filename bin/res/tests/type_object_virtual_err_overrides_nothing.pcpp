-------------------------------------------------------------------------------
  type_object_virtual_err_overrides_nothing.pcpp - break step of type_object_virtual.pcpp:
  override of a plain method: only a virtual one is overridden (SM0333)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_overrides_nothing.pcpp
    pcpp res\tests\type_object_virtual_err_overrides_nothing.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_overrides_nothing;

type
  TA = object
    method M();
    begin
    end;
  end;
  TB = object(TA)
    override method M(); // ERROR SM0333@5: 'M' overrides nothing
    begin
    end;
  end;

begin
end.
