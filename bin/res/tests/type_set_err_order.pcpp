  type_set_err_order.pcpp - break step of type_set.pcpp:
  the low bound is not above the high bound (SM0328)

  How to check, from repo\bin:
    pcpp res\tests\type_set_err_order.pcpp
    pcpp res\tests\type_set_err_order.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_set_err_order;

type
  TA = set of 9..1; // ERROR SM0328@15: low bound 9 is above high bound 1

begin
end.
