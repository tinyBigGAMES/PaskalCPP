-------------------------------------------------------------------------------
  type_object_operator_err_anonymous.pcpp - break step of type_object_operator.pcpp:
  a record holding an operator written as a variable's type, not in a type block: reported once, nothing inside it is judged (PR0026)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_anonymous.pcpp
    pcpp res\tests\type_object_operator_err_anonymous.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_anonymous;

var
  GV: record // ERROR PR0026
    X: int32;
    operator +(const A: int32; const B: int32): int32;
    begin
      return A + B;
    end;
  end;

begin
end.
