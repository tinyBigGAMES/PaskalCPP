  lex_integers_err_octal.pcpp - break step of lex_integers.pcpp:
  an 8 in an octal literal (LX0007)

  How to check, from repo\bin:
    pcpp res\tests\lex_integers_err_octal.pcpp
    pcpp res\tests\lex_integers_err_octal.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_integers_err_octal;

var
  LN: int64;

begin
  LN := 0;
  LN := 08; // ERROR LX0007@9: Invalid digit in octal literal: 08
end.
