-------------------------------------------------------------------------------
  decl_routine_err_missing_return.pcpp - break step of decl_routine.pcpp:
  a function that can reach its end without returning (reported at its end)

  How to check, from repo\bin:
    pcpp res\tests\decl_routine_err_missing_return.pcpp
    pcpp res\tests\decl_routine_err_missing_return.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_routine_err_missing_return;

routine Sign(AN: int32): int32;
begin
  if AN > 0 then
    return 1;
  end;
end; // ERROR SM0612@1

begin
  println("{}", Sign(1));
end.
