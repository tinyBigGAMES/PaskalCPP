  expr_arithmetic_err_overflow.pcpp - break step of expr_arithmetic.pcpp:
  a constant that overflows int32 (SM0256)

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_overflow.pcpp
    pcpp res\tests\expr_arithmetic_err_overflow.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_overflow;

var
  LN: int32;

begin
  LN := 2147483647 + 1; // ERROR SM0256@9: constant overflows 'int32'
end.
