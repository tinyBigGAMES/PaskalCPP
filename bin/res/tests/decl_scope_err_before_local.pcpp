  decl_scope_err_before_local.pcpp - break step of decl_scope.pcpp:
  a body var used before its own line

  How to check, from repo\bin:
    pcpp res\tests\decl_scope_err_before_local.pcpp
    pcpp res\tests\decl_scope_err_before_local.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_scope_err_before_local;

routine Use(): int32;
begin
  var LFirst: int32 = LSecond; // ERROR SM0002@23
  var LSecond: int32 = 1;
  return LFirst + LSecond;
end;

begin
  println("{}", Use());
end.
