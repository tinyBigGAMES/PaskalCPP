  type_array_err_index_float.pcpp - break step of type_array.pcpp:
  an index is an integer (SM0261)

  How to check, from repo\bin:
    pcpp res\tests\type_array_err_index_float.pcpp
    pcpp res\tests\type_array_err_index_float.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_array_err_index_float;

var
  LA: array[0..3] of int32;
  LI: int32;

begin
  LI := LA[1.5]; // ERROR SM0261@12: an index is an integer, got 'float64'
end.
