  intr_exceptions_err_wide.pcpp - break step of intr_exceptions.pcpp:
  raisecode given an int64 code (SM0409)

  How to check, from repo\bin:
    pcpp res\tests\intr_exceptions_err_wide.pcpp
    pcpp res\tests\intr_exceptions_err_wide.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_exceptions_err_wide;

var
  LN: int64 = 4294967297;

begin
  raisecode(LN, "x"); // ERROR SM0409@13: 'raisecode' takes (int32, string)
end.
