-------------------------------------------------------------------------------
  type_object_virtual_err_needs_override.pcpp - break step of type_object_virtual.pcpp:
  a method named like an ancestor's virtual method without override (SM0332)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_needs_override.pcpp
    pcpp res\tests\type_object_virtual_err_needs_override.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_needs_override;

type
  TA = object
    virtual method M();
    begin
    end;
  end;
  TB = object(TA)
    method M(); // ERROR SM0332@12: 'M' is virtual in 'TA': write 'override method M'
    begin
    end;
  end;

begin
end.
