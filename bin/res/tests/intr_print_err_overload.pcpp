  intr_print_err_overload.pcpp - break step of intr_print.pcpp:
  an overload set's name printed (SM0425)

  How to check, from repo\bin:
    pcpp res\tests\intr_print_err_overload.pcpp
    pcpp res\tests\intr_print_err_overload.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_print_err_overload;

routine F(AN: int32): int32;
begin
  return AN;
end;

routine F(AS: string): int32;
begin
  return 0;
end;

begin
  println("{}", F); // ERROR SM0425@17: has no single address
end.
