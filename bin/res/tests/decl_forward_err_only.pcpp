  decl_forward_err_only.pcpp - break step of decl_forward.pcpp:
  a forward type used by value before its full declaration (only ptr to may name it)

  How to check, from repo\bin:
    pcpp res\tests\decl_forward_err_only.pcpp
    pcpp res\tests\decl_forward_err_only.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_forward_err_only;

forward type TNode;

type
  TBox = record
    Item: TNode; // ERROR SM0300@11
  end;
  TNode = record
    Value: int32;
  end;

begin
end.
