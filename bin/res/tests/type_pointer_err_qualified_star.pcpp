module exe type_pointer_err_qualified_star;

import type_alias_unit;

var
  LP: type_alias_unit.TKind*; // ERROR PR0028@28: 'type_alias_unit.TKind' is a qualified PaskalCPP name and takes no C++ '*'; write ptr to type_alias_unit.TKind

begin
end.
