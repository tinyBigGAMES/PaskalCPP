  expr_arithmetic_err_div_zero.pcpp - break step of expr_arithmetic.pcpp:
  div by a zero constant (SM0257)

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_div_zero.pcpp
    pcpp res\tests\expr_arithmetic_err_div_zero.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_div_zero;

var
  LN: int32;

begin
  LN := 5 div 0; // ERROR SM0257@15: by zero
end.
