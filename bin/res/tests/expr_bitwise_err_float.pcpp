  expr_bitwise_err_float.pcpp - break step of expr_bitwise.pcpp:
  a float64 shifted (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\expr_bitwise_err_float.pcpp
    pcpp res\tests\expr_bitwise_err_float.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_bitwise_err_float;

var
  LF: float64;

begin
  LF := 1.5;
  LF := LF shl 1; // ERROR SM0250@9: operator 'shl' does not take
end.
