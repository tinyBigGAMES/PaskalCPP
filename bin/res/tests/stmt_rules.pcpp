-------------------------------------------------------------------------------
  stmt_rules.pcpp - Statement compliance: the statement rules

  Every statement ends in ; (BNF.md sec 5), so two expressions in a row
  are a syntax error, never two statements, and there is no empty
  statement. A begin ... end; block is a statement; an expression
  statement is any expression with an effect: an assignment (:= and the
  compound forms), a call, a C++ expression (LV.push_back(1)). C++
  statements have PaskalCPP forms (switch = match, try = guard, throw =
  raise); one that has none goes in cppstart source ... cppend;.

  How to check, from repo\bin:
    pcpp res\tests\stmt_rules.pcpp -r
    pcpp res\tests\stmt_rules.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    block 1
    assign 7 14
    call 3
    cpp 2
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    stmt_rules_err_cpp_switch.pcpp
      a C++ switch statement in a body: write match (PR0049)
    stmt_rules_err_semicolon.pcpp
      two expressions in a row with no ; between them (PR0001)
    stmt_rules_err_no_effect.pcpp
      an expression statement that has no effect (SM0613)
*******************************************************************************/

module exe stmt_rules;

#include <vector>

routine Three(): int32;
begin
  return 3;
end;

routine Note(AN: int32);
begin
  println("call {}", AN);
end;

var
  LN: int32;
  LV: std::vector<int>;

begin
  begin
    LN := 1;
    println("block {}", LN);
  end;
  LN := 7;
  print("assign {} ", LN);
  LN *= 2;
  println("{}", LN);
  Note(Three());
  LV.push_back(1);
  LV.push_back(2);
  println("cpp {}", LV.size());
end.
