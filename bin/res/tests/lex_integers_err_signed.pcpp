-------------------------------------------------------------------------------
  lex_integers_err_signed.pcpp - break step of lex_integers.pcpp:
  a decimal literal above int64 without u (LX0006, the hint names the u)

  How to check, from repo\bin:
    pcpp res\tests\lex_integers_err_signed.pcpp
    pcpp res\tests\lex_integers_err_signed.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_integers_err_signed;

var
  LN: int64;

begin
  LN := 0;
  LN := 9223372036854775808; // ERROR LX0006@9: write 9223372036854775808u
end.
