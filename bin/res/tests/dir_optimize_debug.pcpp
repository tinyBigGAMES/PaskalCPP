-------------------------------------------------------------------------------
  dir_optimize_debug.pcpp - Directive compliance: @optimize debug (a level of
  dir_optimize.pcpp)

  The debug level: no optimization; the compiler defines PCPP_DEBUG, so the
  runtime prints its heap report at shutdown (the [Heap] line).

  How to check, from repo\bin:
    pcpp res\tests\dir_optimize_debug.pcpp -r
    pcpp res\tests\dir_optimize_debug.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    clang sees: PCPP_DEBUG
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same.
  CHECK: output\build.zig holds "std.builtin.OptimizeMode = .Debug"
*******************************************************************************/

module exe dir_optimize_debug;
@optimize debug;

// The macros clang defines at this level, in a fixed order
static const char* dir_optimize_flags()
{
  return ""
#ifdef __OPTIMIZE__
  " __OPTIMIZE__"
#endif
#ifdef __OPTIMIZE_SIZE__
  " __OPTIMIZE_SIZE__"
#endif
#ifdef NDEBUG
  " NDEBUG"
#endif
#ifdef PCPP_DEBUG
  " PCPP_DEBUG"
#endif
  ;
}

begin
  println("clang sees:{}", cpp("dir_optimize_flags()"));
end.
