-------------------------------------------------------------------------------
  type_object_embed_err_record.pcpp - break step of type_object_embed.pcpp:
  an embed in a record: a record is plain data, an object embeds (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_object_embed_err_record.pcpp
    pcpp res\tests\type_object_embed_err_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_embed_err_record;

type
  TInner = record
    X: int32;
  end;
  TRec = record
    embed I: TInner; // ERROR PR0034@5: 'embed' is not allowed in a record
  end;

begin
end.
