-------------------------------------------------------------------------------
  type_object_init_err_two_done.pcpp - break step of type_object_init.pcpp:
  two dones in one object: an object has one done (SM0341)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_two_done.pcpp
    pcpp res\tests\type_object_init_err_two_done.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_two_done;

type
  TA = object
    done;
    begin
    end;
    done; // ERROR SM0341@5: 'TA' declares done twice
    begin
    end;
  end;

begin
end.
