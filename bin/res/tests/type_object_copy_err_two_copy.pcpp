-------------------------------------------------------------------------------
  type_object_copy_err_two_copy.pcpp - break step of type_object_copy.pcpp:
  two copies in one object: an object has one copy (SM0354)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_two_copy.pcpp
    pcpp res\tests\type_object_copy_err_two_copy.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_two_copy;

type
  TA = object
    copy(const ASource: TA);
    begin
    end;
    copy(const ASource: TA); // ERROR SM0354@5: 'TA' declares copy twice
    begin
    end;
  end;

begin
end.
