-------------------------------------------------------------------------------
  type_choices_err_int_to_choices.pcpp - break step of type_choices.pcpp:
  a number does not convert to a value implicitly: write (TColor)1 (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_int_to_choices.pcpp
    pcpp res\tests\type_choices_err_int_to_choices.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_int_to_choices;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC := 1; // ERROR SM0200@9: does not convert implicitly to 'TColor'
end.
