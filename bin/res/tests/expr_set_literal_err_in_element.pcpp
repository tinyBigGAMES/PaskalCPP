-------------------------------------------------------------------------------
  expr_set_literal_err_in_element.pcpp - break step of expr_set_literal.pcpp:
  in with a char against a set of integers (SM0268)

  How to check, from repo\bin:
    pcpp res\tests\expr_set_literal_err_in_element.pcpp
    pcpp res\tests\expr_set_literal_err_in_element.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_set_literal_err_in_element;

type
  TDigits = set of 0..9;

var
  LD: TDigits;
  LB: bool;

begin
  LB := 'a' in LD; // ERROR SM0268@9: is not the element type of
end.
