-------------------------------------------------------------------------------
  type_object_copy_err_record.pcpp - break step of type_object_copy.pcpp:
  a record holding an object: a record is plain data (SM0357)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_record.pcpp
    pcpp res\tests\type_object_copy_err_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_record;

type
  TA = object
    N: int32;
  end;
  TR = record
    A: TA; // ERROR SM0357@8: field 'A': a record or an overlay holds no object
  end;

begin
end.
