-------------------------------------------------------------------------------
  type_object_init_err_virtual_call.pcpp - break step of type_object_init.pcpp:
  a virtual method called in an init: the object is not its own type yet (SM0348)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_virtual_call.pcpp
    pcpp res\tests\type_object_init_err_virtual_call.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_virtual_call;

type
  TA = object
    N: int32;
    init();
    begin
      self.N := self.Size(); // ERROR SM0348@17: 'Size' is virtual
    end;
    virtual method Size(): int32;
    begin
      return 1;
    end;
  end;

begin
end.
