-------------------------------------------------------------------------------
  intr_shadow.pcpp - Intrinsic compliance: the system scope

  The intrinsic names live in an outer system scope, not as keywords (BNF.md
  sec 7): a declaration shadows one (a routine print, a local len), and a C
  function named like one (size) is still called through its C++ name
  (::size). Where nothing shadows it, the intrinsic answers.

  How to check, from repo\bin:
    pcpp res\tests\intr_shadow.pcpp -r
    pcpp res\tests\intr_shadow.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    my print: hello
    C size 42
    local named len 3
    intrinsic size still 4
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    intr_shadow_err_type_arg.pcpp
      a routine named size called with a type (SM0411)
*******************************************************************************/

module exe intr_shadow;

int size(int x) { return x * 2; }

routine print(AS: string);
begin
  println("my print: {}", AS);
end;

routine Measure(): int64;
var
  len: int64;
begin
  len := 3;
  return len;
end;

begin
  print("hello");
  println("C size {}", ::size(21));
  println("local named len {}", Measure());
  println("intrinsic size still {}", size(int32));
end.
