-------------------------------------------------------------------------------
  type_pointer_err_dot_pointer.pcpp - break step of type_pointer.pcpp:
  . on a pointer reaches no field: write LP^.X or LP->X (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_dot_pointer.pcpp
    pcpp res\tests\type_pointer_err_dot_pointer.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_dot_pointer;

type
  TPoint = record
    X: int32;
  end;

var
  LP: ptr to TPoint;
  LX: int32;

begin
  LX := LP.X; // ERROR SM0250@9: operator '.' does not take 'ptr to TPoint'
end.
