-------------------------------------------------------------------------------
  intr_weak.pcpp - Intrinsic compliance: alive and lock

  A weak T watches the object a ref T holds without keeping it: alive(W) is
  true while the object exists, lock(W) gives a ref T holding it, nil once
  it is gone (BNF.md sec 7). Their argument is a weak.

  How to check, from repo\bin:
    pcpp res\tests\intr_weak.pcpp -r
    pcpp res\tests\intr_weak.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    alive true
    lock 4
    alive after false
    lock nil true
    [Heap] Allocs: 1, Frees: 1, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    intr_weak_err_ref.pcpp
      alive of a ref, not a weak (SM0409)
*******************************************************************************/

module exe intr_weak;

type
  TThing = object
    N: int32;
  end;

var
  LR: ref TThing;
  LW: weak TThing;
  LL: ref TThing;

begin
  LR := ref TThing;
  LR.N := 4;
  LW := LR;
  println("alive {}", alive(LW));
  LL := lock(LW);
  println("lock {}", LL.N);
  LL := nil;
  LR := nil;
  println("alive after {}", alive(LW));
  LL := lock(LW);
  println("lock nil {}", LL = nil);
end.
