-------------------------------------------------------------------------------
  type_pointer.pcpp - Type compliance: pointer types

  A pointer type (BNF.md sec 4: pointer type) is ptr to T, ptr to const T
  (what it points to is read only through it) or the untyped ptr. Every
  part of the production is used here and what it does is printed:
  - address of gives a pointer to a variable, ^ reads and writes what it
    points to; Swap takes two pointers and writes through both;
  - a ptr to T converts to a ptr to const T and to the untyped ptr; a
    pointer cast, ptr to T(x), goes back from ptr, from an integer of
    pointer width (uint64) and to one (uint64(P)); a typed pointer is cast
    to another typed pointer, by ptr to T(x) and through a pointer type's
    name (TByteRef(LP)): both read LA's first byte (7, both targets are
    little-endian);
  - a ptr to ptr to int32 (LPP^^), a ptr to an array (LAQ^[3]), a ptr to a
    record (LR^.X and LR->Y), a pointer alias (TPointRef) returned by a
    routine, nil compared;
  - a typed pointer is indexed (AP[LI], LE[1]) and moved by + (Advance,
    through a var parameter); a ptr to const int32 parameter reads only;
  - a ptr to const char holds a string literal and prints its text (one
    is also cast to it: ptr to const char("cast"));
  - size gives a pointer's bytes.

  How to check, from repo\bin:
    pcpp res\tests\type_pointer.pcpp -r
    pcpp res\tests\type_pointer.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    deref 10 10
    swap 2 10
    const 2
    untyped same true
    ptr to ptr 7 7
    array total 10
    array next 2 3 step 4
    round trip 2 same true
    ptr to array 4 4
    record 5 6 11
    nil true false
    text pointer cast
    cast back 7
    bytes 7 7
    size 8 8
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    type_pointer_err_no_target.pcpp      ptr to names the type it points to
    type_pointer_err_deref_value.pcpp    ^ reads through a pointer, an int32
                                         is none
    type_pointer_err_arrow_value.pcpp    -> reaches a field through a pointer,
                                         a record is none
    type_pointer_err_arrow_untyped.pcpp  nor is the untyped ptr: it points
                                         at no record
    type_pointer_err_dot_pointer.pcpp    . on a pointer: write P^.X or P->X
    type_pointer_err_const_write.pcpp    a ptr to const writes nothing
    type_pointer_err_const_drop.pcpp     nor does it become a ptr to T
    type_pointer_err_target.pcpp         a ptr to int32 is no ptr to int64:
                                         cast it
    type_pointer_err_untyped.pcpp        nor is the untyped ptr a ptr to T
    type_pointer_err_integer.pcpp        0 is no pointer: write nil
    type_pointer_err_to_integer.pcpp     a pointer is no integer: cast it
    type_pointer_err_cast_no_to.pcpp     a pointer cast is ptr to T(x)
    type_pointer_err_cast_no_paren.pcpp  its value is in parentheses
    type_pointer_err_cast_const.pcpp     a pointer cast keeps const,
    type_pointer_err_cast_float.pcpp     takes a pointer or an integer,
    type_pointer_err_cast_narrow.pcpp    an integer of pointer width
    type_pointer_err_cast_nil.pcpp       and never nil (it needs no cast)
    type_pointer_err_untyped_deref.pcpp  the untyped ptr points at no type:
                                         ^ reads through a typed pointer,
    type_pointer_err_untyped_index.pcpp  and so does [i]
    type_pointer_err_qualified_star.pcpp  M.T* is C++'s spelling: write
                                         ptr to M.T
  A forward type behind ptr to is decl_forward.pcpp's; a record extension's
  pointer converting to its base's, type_record_ext.pcpp's; int32* (a builtin
  with C++'s *), type_builtin_err_star.pcpp's.
*******************************************************************************/

module exe type_pointer;

type
  TPoint = record
    X: int32;
    Y: int32;
  end;
  TPointRef = ptr to TPoint;
  TByteRef = ptr to uint8;
  TQuad = array[0..3] of int32;

routine Swap(AA: ptr to int32; AB: ptr to int32);
var
  LT: int32;
begin
  LT := AA^;
  AA^ := AB^;
  AB^ := LT;
end;

routine Total(AP: ptr to const int32; const AN: int32): int32;
var
  LI: int32;
  LS: int32 = 0;
begin
  for LI := 0 to AN - 1 do
    LS := LS + AP[LI];
  end;
  return LS;
end;

routine Advance(var AP: ptr to int32);
begin
  AP := AP + 1;
end;

routine Origin(): TPointRef;
begin
  return nil;
end;

var
  LA: int32 = 1;
  LB: int32 = 2;
  LP: ptr to int32;
  LC: ptr to const int32;
  LU: ptr;
  LPP: ptr to ptr to int32;
  LQ: TQuad;
  LE: ptr to int32;
  LAddr: uint64;
  LBack: ptr to int32;
  LAQ: ptr to TQuad;
  LPt: TPoint;
  LR: TPointRef;
  LText: ptr to const char;
  LBytes: ptr to uint8;
  LByteRef: TByteRef;

begin
  LP := address of LA;
  LP^ := 10;
  println("deref {} {}", LP^, LA);
  Swap(address of LA, address of LB);
  println("swap {} {}", LA, LB);
  LC := LP;
  println("const {}", LC^);
  LU := LP;
  println("untyped same {}", LU = LP);
  LPP := address of LP;
  LPP^^ := 7;
  println("ptr to ptr {} {}", LPP^^, LA);
  LQ[0] := 1;
  LQ[1] := 2;
  LQ[2] := 3;
  LQ[3] := 4;
  LE := address of LQ[0];
  println("array total {}", Total(LE, 4));
  Advance(LE);
  println("array next {} {} step {}", LE^, LE[1], uint64(LE) - uint64(address of LQ[0]));
  LAddr := uint64(LE);
  LBack := ptr to int32(LAddr);
  println("round trip {} same {}", LBack^, LBack = LE);
  LAQ := address of LQ;
  println("ptr to array {} {}", LAQ^[3], len(LAQ^));
  LPt.X := 3;
  LPt.Y := 4;
  LR := address of LPt;
  LR^.X := 5;
  LR->Y := 6;
  println("record {} {} {}", LPt.X, LPt.Y, LR^.X + LR->Y);
  LR := Origin();
  println("nil {} {}", LR = nil, LR <> nil);
  LText := "pointer";
  println("text {} {}", LText, ptr to const char("cast"));
  LP := ptr to int32(LU);
  println("cast back {}", LP^);
  // A typed pointer to another typed pointer, by either spelling of the cast
  LBytes := ptr to uint8(LP);
  LByteRef := TByteRef(LP);
  println("bytes {} {}", LBytes^, LByteRef^);
  println("size {} {}", size(ptr to int32), size(ptr));
end.
