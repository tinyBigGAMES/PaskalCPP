-------------------------------------------------------------------------------
  lex_identifiers.pcpp - Lexical compliance: identifiers

  An identifier (BNF.md sec 9) is a letter or _ then letters, digits and _;
  PaskalCPP is case-sensitive: LValue, lvalue and LVALUE are three names,
  and Begin is a name because the keyword is begin, lowercase.

  How to check, from repo\bin:
    pcpp res\tests\lex_identifiers.pcpp -r
    pcpp res\tests\lex_identifiers.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    1 2 3
    4 5 6
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    lex_identifiers_err_char.pcpp
      a character no token starts with (LX0004)
    lex_identifiers_err_utf8.pcpp
      a byte that is not UTF-8 (LX0011)
    lex_identifiers_err_at.pcpp
      an @ with no directive name after it (LX0009)
*******************************************************************************/

module exe lex_identifiers;

var
  LValue: int32 = 1;
  lvalue: int32 = 2;
  LVALUE: int32 = 3;
  _hidden: int32 = 4;
  a_1_b: int32 = 5;
  Begin: int32 = 6;

begin
  println("{} {} {}", LValue, lvalue, LVALUE);
  println("{} {} {}", _hidden, a_1_b, Begin);
end.
