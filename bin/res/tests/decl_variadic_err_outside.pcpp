  decl_variadic_err_outside.pcpp - break step of decl_variadic.pcpp:
  varargs read in a routine that is not variadic

  How to check, from repo\bin:
    pcpp res\tests\decl_variadic_err_outside.pcpp
    pcpp res\tests\decl_variadic_err_outside.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_variadic_err_outside;

routine Count(AN: int32): int32;
begin
  return varargs.count; // ERROR SM0417@10
end;

begin
  println("{}", Count(1));
end.
