-------------------------------------------------------------------------------
  type_overlay_err_anon_wstring.pcpp - break step of type_overlay.pcpp:
  an anonymous record in an overlay shares the overlay's storage: it holds no wstring (SM0313)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_anon_wstring.pcpp
    pcpp res\tests\type_overlay_err_anon_wstring.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_anon_wstring;

type
  TV = overlay
    A: int32;
    record
      W: wstring; // ERROR SM0313@7: cannot share an overlay's storage
      N: int16;
    end;
  end;

begin
end.
