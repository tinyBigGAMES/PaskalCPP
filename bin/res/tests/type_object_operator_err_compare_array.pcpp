-------------------------------------------------------------------------------
  type_object_operator_err_compare_array.pcpp - break step of type_object_operator.pcpp:
  two arrays of objects whose type declares no <> (SM0252)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_compare_array.pcpp
    pcpp res\tests\type_object_operator_err_compare_array.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_compare_array;

type
  TTicket = object
    Seat: int32;
  end;

var
  LA: array[0..1] of TTicket;
  LB: array[0..1] of TTicket;
  LE: bool;
begin
  LE := LA <> LB; // ERROR SM0252
end.
