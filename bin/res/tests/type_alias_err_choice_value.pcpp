-------------------------------------------------------------------------------
  type_alias_err_choice_value.pcpp - break step of type_alias.pcpp:
  an alias of a choice value: cRed is a value of TColor, not a type (SM0013), and a visible choice value is never taken as a C/C++ name

  How to check, from repo\bin:
    pcpp res\tests\type_alias_err_choice_value.pcpp
    pcpp res\tests\type_alias_err_choice_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_alias_err_choice_value;

type
  TColor = choices(cRed, cGreen);
  TA = cRed; // ERROR SM0013@8: 'cRed' is not a type

begin
end.
