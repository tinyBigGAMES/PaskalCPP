-------------------------------------------------------------------------------
  intr_setlength_err_value.pcpp - break step of intr_setlength.pcpp:
  setlength used as a value (SM0408)

  How to check, from repo\bin:
    pcpp res\tests\intr_setlength_err_value.pcpp
    pcpp res\tests\intr_setlength_err_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_setlength_err_value;

var
  LA: array of int32;
  LN: int32;

begin
  LN := setlength(LA, 3); // ERROR SM0408@9: is a statement, not a value
end.
