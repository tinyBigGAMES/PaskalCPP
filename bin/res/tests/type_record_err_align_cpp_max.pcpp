-------------------------------------------------------------------------------
  type_record_err_align_cpp_max.pcpp - break step of type_record.pcpp:
  align(cpp("16384")): at most 8192 on every target, a C++ value too (SM0312)

  How to check, from repo\bin:
  (the compiler judges it in the emitted C++: the build runs, the program is
  never started)
    pcpp res\tests\type_record_err_align_cpp_max.pcpp
    pcpp res\tests\type_record_err_align_cpp_max.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_align_cpp_max;

type
  TR = record align(cpp("16384")) // ERROR SM0312@21: align 16384 exceeds 8192
    G: int32;
  end;

var
  V: TR;

begin
  V.G := 1;
end.
