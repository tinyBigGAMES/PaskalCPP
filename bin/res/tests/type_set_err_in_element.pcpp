-------------------------------------------------------------------------------
  type_set_err_in_element.pcpp - break step of type_set.pcpp:
  in takes a value of the set's element type (SM0268)

  How to check, from repo\bin:
    pcpp res\tests\type_set_err_in_element.pcpp
    pcpp res\tests\type_set_err_in_element.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_set_err_in_element;

type
  TColor = choices(cRed, cGreen, cBlue);
  TS = set of 0..15;
  TColors = set of TColor;

var
  LS: TS;
  LC: TColors;
  LB: bool;

begin
  LS := [1];
  LC := [TColor.cRed];
  LB := TColor.cRed in LS; // ERROR SM0268@9: 'in': 'TColor' is not the element type of 'TS'
end.
