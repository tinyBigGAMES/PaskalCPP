-------------------------------------------------------------------------------
  stmt_guard_err_cpp_jump_except.pcpp - break step of stmt_guard.pcpp:
  a C++ break inside the except body of a guard with finally (SM0614)

  How to check, from repo\bin:
    pcpp res\tests\stmt_guard_err_cpp_jump_except.pcpp
    pcpp res\tests\stmt_guard_err_cpp_jump_except.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_guard_err_cpp_jump_except;

var
  LN: int32;

begin
  LN := 0;
  while LN < 3 do
    guard
      raise("x");
    except
      cppstart source
      break; // ERROR SM0614@7: leaves only the except
      cppend;
    finally
      LN += 1;
    end;
  end;
end.
