-------------------------------------------------------------------------------
  type_object_iface.pcpp - Type compliance: interfaces and implements

  An interface is a set of methods an object promises to have (BNF.md
  sec 4 interface type, object type). Shown here:
  - an interface lists methods with no body; it may name one parent
    interface (IShape and IPrintable both extend INamed);
  - object ... implements I1, I2 promises every method of those
    interfaces and their parents; each is a virtual method of the object
    or of a level above it, with the same parameters and result
    (TSquare gets Name and Area from TBase's implements, Show is its own);
  - an inherited method fulfils it too: TBorrow names IPrintable, TPlain
    (its parent, which names no interface) has Show and Name; TMore
    overrides Show, and a call through the interface runs TMore's;
  - an interface is reached through var, const, ptr to, own or ref, never
    held by value: Report / Named / Print take var, LP is a ptr to IShape,
    LR a ref IShape holding a TSquare (freed at exit: Leaked 0);
  - a pointer cast to an interface, from it back to the object and across to
    another interface lands on the right address, both spellings (ptr to
    IShape(x) and the pointer type's name PShape(x)): an interface is a
    virtual base, so the address moves.

  How to check, from repo\bin:
    pcpp res\tests\type_object_iface.pcpp -r
    pcpp res\tests\type_object_iface.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    base 1
    square 16
    named square
    ptr 16
    show i 4
    got 4
    plain i 3
    got 3
    named plain
    more i
    got 7
    ref square
    cast 16 16 true true
    back 4
    show x 4
    cross 4
    [Heap] Allocs: 1, Frees: 1, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    type_object_iface_err_field.pcpp  a field in an interface
    type_object_iface_err_body.pcpp  an interface method with a body
    type_object_iface_err_word.pcpp  a dispatch word in an interface
    type_object_iface_err_value.pcpp  a variable of an interface type
    type_object_iface_err_parent.pcpp  an interface as an object's parent
    type_object_iface_err_not_interface.pcpp  an object named after implements
    type_object_iface_err_twice.pcpp  an interface named twice after implements
    type_object_iface_err_missing.pcpp  an interface method the object does not have
    type_object_iface_err_plain.pcpp  a plain method fulfilling an interface method
    type_object_iface_err_signature.pcpp  a method whose result differs from the interface's
    type_object_iface_err_hidden.pcpp  a hidden method fulfilling an interface method
    type_object_iface_err_repeat.pcpp  an interface repeating its parent's method
*******************************************************************************/

module exe type_object_iface;

type
  INamed = interface
    method Name(): string;
  end;
  IShape = interface(INamed)
    method Area(): int32;
  end;
  IPrintable = interface(INamed)
    method Show(const ATag: string): int32;
  end;
  TBase = object implements IShape
    virtual method Name(): string;
    begin
      return "base";
    end;
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;
  TSquare = object(TBase) implements IPrintable
    S: int32;
    override method Name(): string;
    begin
      return "square";
    end;
    override method Area(): int32;
    begin
      return self.S * self.S;
    end;
    virtual method Show(const ATag: string): int32;
    begin
      println("show {} {}", ATag, self.S);
      return self.S;
    end;
  end;
  TPlain = object
    N: int32;
    virtual method Show(const ATag: string): int32;
    begin
      println("plain {} {}", ATag, self.N);
      return self.N;
    end;
    virtual method Name(): string;
    begin
      return "plain";
    end;
  end;
  TBorrow = object(TPlain) implements IPrintable
  end;
  TMore = object(TBorrow)
    override method Show(const ATag: string): int32;
    begin
      println("more {}", ATag);
      return 7;
    end;
  end;
  PShape = ptr to IShape;

routine Report(var AShape: IShape);
begin
  println("{} {}", AShape.Name(), AShape.Area());
end;

routine Named(var AName: INamed);
begin
  println("named {}", AName.Name());
end;

routine Print(var AP: IPrintable);
begin
  println("got {}", AP.Show("i"));
end;

var
  LSq: TSquare;
  LB: TBase;
  LBorrow: TBorrow;
  LMore: TMore;
  LP: ptr to IShape;
  LR: ref IShape;
  LSqP: ptr to TSquare;
  LC: ptr to IShape;
  LQ: PShape;
  LPr: ptr to IPrintable;
begin
  LSq.S := 4;
  Report(LB);
  Report(LSq);
  Named(LSq);
  LP := address of LSq;
  println("ptr {}", LP^.Area());
  Print(LSq);
  LBorrow.N := 3;
  Print(LBorrow);
  Named(LBorrow);
  Print(LMore);
  LR := ref TSquare();
  println("ref {}", LR.Name());
  LSqP := address of LSq;
  LC := ptr to IShape(LSqP);
  LQ := PShape(LSqP);
  println("cast {} {} {} {}", LC^.Area(), LQ^.Area(), LC = LP, LQ = LP);
  LSqP := ptr to TSquare(LC);
  println("back {}", LSqP^.S);
  LPr := ptr to IPrintable(LC);
  println("cross {}", LPr^.Show("x"));
end.
