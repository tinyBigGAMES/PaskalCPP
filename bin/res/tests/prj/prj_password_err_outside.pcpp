-------------------------------------------------------------------------------
  prj_password_err_outside.pcpp - Projects: ProjectPassword() outside a project

  Break step of the project password: ProjectPassword() is project.toml's
  pack password, so only a project build has it (the main module of a
  project.toml and the units it imports). No project.toml is above this
  file: a plain build, SM0433 at the call (prj_inside reads it in a project,
  prj_inside_err_password in a project file that is not its main module).
*******************************************************************************/

module exe prj_password_err_outside;

/*
  @@test
    kind error
  @@end
*/

var
  LPassword: string;

begin
  LPassword := ProjectPassword(); // ERROR SM0433@16: is only in a project build
  println("{}", len(LPassword));
end.
