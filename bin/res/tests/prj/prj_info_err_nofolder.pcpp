-------------------------------------------------------------------------------
  prj_info_err_nofolder.pcpp - Projects: pcpp --project-info with no folder

  The folder is required (no current-folder default: the editor always
  names one): a bad argument, exit 2, no JSON, no banner. A cli test (pcpp
  itself, in the suite's output root); this file itself is never compiled.
*******************************************************************************/

module exe prj_info_err_nofolder;

/*
  @@test
    kind cli
    args "--project-info"
    exitcode 2
    expect
    | Error: --project-info takes one folder and no other argument
    |
    | Run pcpp -h to see available options
  @@end
*/

begin
end.
