-------------------------------------------------------------------------------
  prj_init_err_option.pcpp - Projects: pcpp init with a build option

  init builds nothing: a build option on its line is a bad argument (exit
  2) and nothing is written. A cli test (pcpp itself, in the suite's output
  root); this file itself is never compiled.
*******************************************************************************/

module exe prj_init_err_option;

/*
  @@test
    kind cli
    args "--no-banner init prj_cli_option exe -r"
    exitcode 2
    expect
    | Error: init takes no -r
    |
    | Run pcpp -h to see available options
  @@end
*/

begin
end.
