-------------------------------------------------------------------------------
  prj_info_none.pcpp - Projects: pcpp --project-info on a plain folder

  A folder with no project.toml of its own is no project (never searched for
  above it): "project" and "valid" false, only the root, no reports, exit 0
  (fixtures\root has src\ and units\ but no project.toml). The editor opens
  it as a plain folder. A cli test (pcpp itself, in the suite's output root);
  this file itself is never compiled.
*******************************************************************************/

module exe prj_info_none;

/*
  @@test
    kind cli
    args "--project-info <DIR>/fixtures/root"
    exitcode 0
    expect
    | {"format":1,"project":false,"valid":false,"root":"<DIR>/fixtures/root","reports":[]}
  @@end
*/

begin
end.
