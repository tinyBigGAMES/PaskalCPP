-------------------------------------------------------------------------------
  prj_init_err_name.pcpp - Projects: pcpp init with a name that cannot be one

  The name follows the project's rule (an identifier, no reserved word, no
  device name): PJ0005 before any file is written, exit 1. A cli test (pcpp
  itself, in the suite's output root); this file itself is never compiled.
*******************************************************************************/

module exe prj_init_err_name;

/*
  @@test
    kind cli
    args "--no-banner init my-game exe"
    exitcode 1
    expect
    | [ERROR] PJ0005: The project name 'my-game' is not valid: it must start with a letter or _ and hold only letters, digits and _
    | Failed.
  @@end
*/

begin
end.
