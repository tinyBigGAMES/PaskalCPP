  prj_build_err_noproject.pcpp - Projects: pcpp build on a folder with no
  project.toml

  The folder named is the project (never searched above): this area's own
  folder holds no project.toml, a bad argument (exit 2). A cli test (pcpp
  itself, in the suite's output root); this file itself is never compiled.
*******************************************************************************/

module exe prj_build_err_noproject;

/*
  @@test
    kind cli
    args "--no-banner build <DIR>"
    exitcode 2
    expect
    | Error: No project.toml in <DIR>
  @@end
*/

begin
end.
