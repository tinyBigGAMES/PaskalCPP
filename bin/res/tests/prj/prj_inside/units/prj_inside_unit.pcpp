-------------------------------------------------------------------------------
  prj_inside_unit.pcpp - Project test support: the unit prj_inside finds
  through @addmodulepath "$R:units" (only this project's units\ holds it).
  A unit a project's main module imports is part of the project build, so
  ProjectPassword() is there for it too (Secret).
*******************************************************************************/

module unit prj_inside_unit;

exported routine Value(): int32;
begin
  return 7;
end;

// The project's password as this unit reads it
exported routine Secret(): string;
begin
  return ProjectPassword();
end;

end.
