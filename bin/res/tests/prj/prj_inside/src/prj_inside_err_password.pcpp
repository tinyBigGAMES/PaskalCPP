-------------------------------------------------------------------------------
  prj_inside_err_password.pcpp - Projects: ProjectPassword() in a project file
  that is not its main module

  Break step of prj_inside: this file sits beside the project's main module,
  but project.toml names prj_inside.pcpp as main, so this one builds as a
  plain file (user 2026-10-29) and has no project password: SM0433 at the
  call, as anywhere outside a project.
*******************************************************************************/

module exe prj_inside_err_password;

/*
  @@test
    kind error
  @@end
*/

begin
  println("{}", len(ProjectPassword())); // ERROR SM0433@21: is only in a project build
end.
