-------------------------------------------------------------------------------
  prj_build_err_option.pcpp - Projects: pcpp build with --clean

  build takes the build options only; --clean is the clean line's own: a bad
  argument (exit 2), nothing read or built. A cli test (pcpp itself, in the
  suite's output root); this file itself is never compiled.
*******************************************************************************/

module exe prj_build_err_option;

/*
  @@test
    kind cli
    args "--no-banner build <DIR> --clean"
    exitcode 2
    expect
    | Error: build takes no --clean
    |
    | Run pcpp -h to see available options
  @@end
*/

begin
end.
