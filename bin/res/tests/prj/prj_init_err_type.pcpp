-------------------------------------------------------------------------------
  prj_init_err_type.pcpp - Projects: pcpp init with a type that is not one

  The type is exe, dll or lib, exactly: anything else is a bad argument
  (exit 2) and nothing is written. A cli test (pcpp itself, in the suite's
  output root); this file itself is never compiled.
*******************************************************************************/

module exe prj_init_err_type;

/*
  @@test
    kind cli
    args "--no-banner init prj_cli_type app"
    exitcode 2
    expect
    | Error: Unknown project type: app (use exe, dll or lib)
  @@end
*/

begin
end.
