-------------------------------------------------------------------------------
  prj_build_err_cwd.pcpp - Projects: pcpp build with no folder, outside a
  project

  No folder = the current one: the suite's output root holds no
  project.toml, a bad argument (exit 2). A cli test (pcpp itself, in the
  suite's output root); this file itself is never compiled.
*******************************************************************************/

module exe prj_build_err_cwd;

/*
  @@test
    kind cli
    args "--no-banner build"
    exitcode 2
    expect
    | Error: No project.toml in <OUT>
  @@end
*/

begin
end.
