-------------------------------------------------------------------------------
  prj_info_missing.pcpp - Projects: pcpp --project-info on a folder that is
  not there

  A folder that does not exist holds no project.toml: no project, no
  reports, exit 0 (the editor asks about folders it was handed, one may be
  gone by then). A cli test (pcpp itself, in the suite's output root); this
  file itself is never compiled.
*******************************************************************************/

module exe prj_info_missing;

/*
  @@test
    kind cli
    args "--project-info <DIR>/fixtures/no_such_folder"
    exitcode 0
    expect
    | {"format":1,"project":false,"valid":false,"root":"<DIR>/fixtures/no_such_folder","reports":[]}
  @@end
*/

begin
end.
