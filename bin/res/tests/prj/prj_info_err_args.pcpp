-------------------------------------------------------------------------------
  prj_info_err_args.pcpp - Projects: pcpp --project-info with another
  argument

  --project-info takes one folder and nothing else (stdout is the JSON, so
  not even --no-banner): a bad argument, exit 2, no JSON, no banner. The
  missing folder is the same line problem (prj_info_err_nofolder). A cli
  test (pcpp itself, in the suite's output root); this file itself is never
  compiled.
*******************************************************************************/

module exe prj_info_err_args;

/*
  @@test
    kind cli
    args "--project-info <DIR>/fixtures/ok extra"
    exitcode 2
    expect
    | Error: --project-info takes one folder and no other argument
    |
    | Run pcpp -h to see available options
  @@end
*/

begin
end.
