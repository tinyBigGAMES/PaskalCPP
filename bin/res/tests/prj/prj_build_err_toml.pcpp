-------------------------------------------------------------------------------
  prj_build_err_toml.pcpp - Projects: pcpp build on a project.toml that does
  not parse

  The project file is read before anything is built: its PJ report, exit 1,
  nothing built (fixtures\bad_parse). A cli test (pcpp itself, in the suite's
  output root); this file itself is never compiled.
*******************************************************************************/

module exe prj_build_err_toml;

/*
  @@test
    kind cli
    args "--no-banner build <DIR>/fixtures/bad_parse"
    exitcode 1
    expect
    | [ERROR] PJ0001: Cannot read the project file '<DIR>/fixtures/bad_parse/project.toml': Failed to parse TOML: Expected ']' at line 4, column 9
    | Failed.
  @@end
*/

begin
end.
