-------------------------------------------------------------------------------
  type_object_err_parent_value.pcpp - break step of type_object.pcpp:
  parent as a value: parent only reaches the parent's members, write parent.<member> (SM0016)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_parent_value.pcpp
    pcpp res\tests\type_object_err_parent_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_parent_value;

type
  TA = object
    Z: int32;
  end;
  TB = object(TA)
    method Copy(): TA;
    begin
      return parent; // ERROR SM0016@14: 'parent' reaches the parent's members
    end;
  end;

begin
end.
