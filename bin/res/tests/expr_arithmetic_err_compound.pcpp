-------------------------------------------------------------------------------
  expr_arithmetic_err_compound.pcpp - break step of expr_arithmetic.pcpp:
  an int32 added into an int8 with += (SM0200 at the value): a compound
  assignment stores in the target's type, so its value converts to it;
  write LN += int8(LA)

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_compound.pcpp
    pcpp res\tests\expr_arithmetic_err_compound.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_compound;

var
  LN: int8 = 1;
  LA: int32 = 300;

begin
  LN += LA; // ERROR SM0200@9: 'int32' does not convert implicitly to 'int8'
end.
