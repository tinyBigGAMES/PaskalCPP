-------------------------------------------------------------------------------
  type_record_ext_err_unrelated.pcpp - break step of type_record_ext.pcpp:
  a record with the same fields is not an extension: records are named types (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_record_ext_err_unrelated.pcpp
    pcpp res\tests\type_record_ext_err_unrelated.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_ext_err_unrelated;

type
  TBase = record
    A: int32;
  end;
  TOther = record
    A: int32;
  end;

var
  LO: TOther;
  LPB: ptr to TBase;

begin
  LPB := address of LO; // ERROR SM0200@10: does not convert implicitly
end.
