-------------------------------------------------------------------------------
  intr_object.pcpp - Intrinsic compliance: create and destroy, own and ref

  create(P) builds a zeroed record, overlay or C/C++ value behind P,
  destroy(P) frees it and sets P to nil (BNF.md sec 7). An object is never
  built so: an own / ref holds it on the heap and frees it (own T, ref T;
  sec 6 owner new); the debug build counts each create and destroy and each
  of those objects.

  How to check, from repo\bin:
    pcpp res\tests\intr_object.pcpp -r
    pcpp res\tests\intr_object.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    zeroed 0 0
    set 3
    nil after destroy true
    overlay 0
    cpp text
    own 5
    ref 6
    [Heap] Allocs: 5, Frees: 5, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    intr_object_err_int.pcpp
      create of an int32 variable (SM0409)
    intr_object_err_object.pcpp
      create of a pointer to an object (SM0361)
*******************************************************************************/

module exe intr_object;

#include <string>

type
  TPoint = record
    X: int32;
    Y: int32;
  end;
  TBox = overlay
    I: int32;
    F: float32;
  end;
  TThing = object
    N: int32;
  end;

var
  LP: ptr to TPoint;
  LB: ptr to TBox;
  LS: ptr to std::string;
  LO: own TThing;
  LR: ref TThing;

begin
  create(LP);
  println("zeroed {} {}", LP^.X, LP^.Y);
  LP^.X := 3;
  println("set {}", LP^.X);
  destroy(LP);
  println("nil after destroy {}", LP = nil);
  create(LB);
  println("overlay {}", LB^.I);
  destroy(LB);
  create(LS);
  LS^ := "text";
  println("cpp {}", LS^);
  destroy(LS);
  LO := own TThing;
  LO.N := 5;
  println("own {}", LO.N);
  LR := ref TThing;
  LR.N := 6;
  println("ref {}", LR.N);
end.
