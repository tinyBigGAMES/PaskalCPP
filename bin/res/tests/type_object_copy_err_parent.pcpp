-------------------------------------------------------------------------------
  type_object_copy_err_parent.pcpp - break step of type_object_copy.pcpp:
  an object whose parent cannot be copied, assigned: it cannot be copied either (SM0427)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_parent.pcpp
    pcpp res\tests\type_object_copy_err_parent.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_parent;

type
  TRes = object
    Id: int32;
    done;
    begin
    end;
  end;
  TKid = object(TRes)
    K: int32;
  end;

routine Use();
var
  LA: TKid;
  LB: TKid;
begin
  LA := LB; // ERROR SM0427@9: 'LB' would be copied here, and 'TKid' cannot be copied: pass it var / const, return it from a local
end;

begin
end.
