-------------------------------------------------------------------------------
  std_sysutils_format_err_not_literal.pcpp - break step of
  std_sysutils_format.pcpp: a string variable as the format string (SM0500:
  a format string is checked when the program is built, so it is written as
  a string literal)

  How to check, from repo\bin:
    pcpp res\tests\std_sysutils_format_err_not_literal.pcpp
    pcpp res\tests\std_sysutils_format_err_not_literal.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe std_sysutils_format_err_not_literal;

import
  SysUtils;

var
  LFormat: string;
  LText: string;

begin
  LFormat := "{}";
  LText := FormatStr(LFormat, 1); // ERROR SM0500@22
  println("{}", LText);
end.
