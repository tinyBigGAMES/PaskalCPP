-------------------------------------------------------------------------------
  type_object_own_err_weak_member.pcpp - break step of type_object_own.pcpp:
  a member read through a weak: read it through lock(W) (SM0360)

  How to check, from repo\bin:
    pcpp res\tests\type_object_own_err_weak_member.pcpp
    pcpp res\tests\type_object_own_err_weak_member.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_own_err_weak_member;

type
  TPlain = object
    X: int32;
  end;

routine Use(const AW: weak TPlain): int32;
begin
  return AW.X; // ERROR SM0360@10: read it through lock(AW)
end;

begin
end.
