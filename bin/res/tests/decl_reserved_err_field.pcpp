  decl_reserved_err_field.pcpp - break step of decl_reserved.pcpp:
  a record field named pcpp_f (SM0017)

  How to check, from repo\bin:
    pcpp res\tests\decl_reserved_err_field.pcpp
    pcpp res\tests\decl_reserved_err_field.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_reserved_err_field;

type
  TR = record
    pcpp_f: int32; // ERROR SM0017@5: are reserved for the compiler
  end;

begin
end.
