  decl_routine_err_var_literal.pcpp - break step of decl_routine.pcpp:
  a literal for a var parameter: a var parameter needs a variable

  How to check, from repo\bin:
    pcpp res\tests\decl_routine_err_var_literal.pcpp
    pcpp res\tests\decl_routine_err_var_literal.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_routine_err_var_literal;

routine Bump(var AN: int32);
begin
  AN := AN + 1;
end;

begin
  Bump(5); // ERROR SM0405@8
end.
