-------------------------------------------------------------------------------
  type_object_cpp_err_poly_is.pcpp - break step of type_object_cpp.pcpp:
  is on an object whose C++ base has no virtual method (SM0271)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_poly_is.pcpp
    pcpp res\tests\type_object_cpp_err_poly_is.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_poly_is;

struct CPlain {
  int tag = 5;
};

type
  TA = object(CPlain)
    N: int32;
  end;
  TB = object(TA)
    M: int32;
  end;

routine Check(const AA: TA): bool;
begin
  return AA is TB; // ERROR SM0271
end;

var
  LB: TB;
begin
  println("{}", Check(LB));
end.
