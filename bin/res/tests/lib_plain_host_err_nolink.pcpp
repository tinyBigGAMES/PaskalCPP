-------------------------------------------------------------------------------
  lib_plain_host_err_nolink.pcpp - break step of lib_plain_host.pcpp: the
  program without its @linklibrary line, so the linker finds no lib_plain_add
  (the linker's error, at the line that calls it)

  How to check, from repo\bin (lib_plain.pcpp's two commands first):
    pcpp res\tests\lib_plain_host_err_nolink.pcpp
    pcpp res\tests\lib_plain_host_err_nolink.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lib_plain_host_err_nolink;
@ifdef TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:output/lib_plain_linux/lib";
@else
@addlibrarypath "$P:output/lib_plain/lib";
@endif

routine clink lib_plain_add(AA: int32; AB: int32): int32; external;

begin
  println("lib_plain_add(2, 3) = {}", lib_plain_add(2, 3)); // ERROR ZB0016
end.
