-------------------------------------------------------------------------------
  intr_object.pcpp - Intrinsic: create and destroy, own and ref

  create(P) builds a zeroed record, overlay or C/C++ value behind P,
  destroy(P) frees it and sets P to nil (BNF.md sec 7). An object is never
  built so: an own / ref holds it on the heap and frees it (own T, ref T;
  sec 6 owner new); the debug build counts each create and destroy and each
  of those objects.
*******************************************************************************/

module exe intr_object;

/*
  @@test
    kind run
    expect
    | zeroed 0 0
    | set 3
    | nil after destroy true
    | overlay 0
    | cpp text
    | own 5
    | ref 6
    | [Heap] Allocs: 5, Frees: 5, Leaked: 0
  @@end
*/

#include <string>

type
  TPoint = record
    X: int32;
    Y: int32;
  end;
  TBox = overlay
    I: int32;
    F: float32;
  end;
  TThing = object
    N: int32;
  end;

var
  LP: ptr to TPoint;
  LB: ptr to TBox;
  LS: ptr to std::string;
  LO: own TThing;
  LR: ref TThing;

begin
  create(LP);
  println("zeroed {} {}", LP^.X, LP^.Y);
  LP^.X := 3;
  println("set {}", LP^.X);
  destroy(LP);
  println("nil after destroy {}", LP = nil);
  create(LB);
  println("overlay {}", LB^.I);
  destroy(LB);
  create(LS);
  LS^ := "text";
  println("cpp {}", LS^);
  destroy(LS);
  LO := own TThing;
  LO.N := 5;
  println("own {}", LO.N);
  LR := ref TThing;
  LR.N := 6;
  println("ref {}", LR.N);
end.
