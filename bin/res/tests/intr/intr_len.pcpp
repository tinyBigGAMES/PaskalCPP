-------------------------------------------------------------------------------
  intr_len.pcpp - Intrinsic: len

  len(x) (BNF.md sec 7) is the length of a string, a wstring, a string
  literal or an array (dynamic or static) as an int64: bytes for a string,
  wide characters for a wstring (a wchar is the target's wchar_t), elements
  for an array. A literal counts its characters, never a terminator: an
  escape is one, joined literals are one text.
*******************************************************************************/

module exe intr_len;

/*
  @@test
    kind run
    expect
    | string 5
    | wstring 4
    | dynamic array 3
    | static array 4
    | literal 4
    | empty 0
    | escape 3
    | joined 4
    | wide literal 4
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

var
  LS: string = "hello";
  LW: wstring = L"wide";
  LA: array of int32;
  LF: array[0..3] of int32;

begin
  setlength(LA, 3);
  println("string {}", len(LS));
  println("wstring {}", len(LW));
  println("dynamic array {}", len(LA));
  println("static array {}", len(LF));
  println("literal {}", len("four"));
  println("empty {}", len(""));
  println("escape {}", len("a\tb"));
  println("joined {}", len("ab" "cd"));
  println("wide literal {}", len(L"wide"));
end.
