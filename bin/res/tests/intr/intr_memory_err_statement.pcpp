  intr_memory_err_statement.pcpp - Intr: memory, statement

  Break step of intr_memory: freemem used as a value (SM0408).
*******************************************************************************/

module exe intr_memory_err_statement;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr;
  LQ: ptr;

begin
  LQ := getmem(4);
  LP := freemem(LQ); // ERROR SM0408@9: 'freemem' is a statement, not a value
end.
