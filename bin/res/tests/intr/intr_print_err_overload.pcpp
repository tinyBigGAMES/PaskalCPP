module exe intr_print_err_overload;

/*
  @@test
    kind error
  @@end
*/

routine F(AN: int32): int32;
begin
  return AN;
end;

routine F(AS: string): int32;
begin
  return 0;
end;

begin
  println("{}", F); // ERROR SM0425@17: has no single address
end.
