-------------------------------------------------------------------------------
  intr_print_err_format_not_literal.pcpp - Intr: print, format not literal

  Break step of intr_print: a string variable as the format string (SM0500).
*******************************************************************************/

module exe intr_print_err_format_not_literal;

/*
  @@test
    kind error
  @@end
*/

var
  LFormat: string;
  LN: int32;

begin
  LFormat := "{}";
  LN := 1;
  println(LFormat, LN); // ERROR SM0500@11
end.
