module exe intr_setlength_err_unsigned;

/*
  @@test
    kind error
  @@end
*/

var
  LA: array of int32;
  LN: uint64 = 3;

begin
  setlength(LA, LN); // ERROR SM0409@17: 'setlength' takes (dynamic array or string variable, int64)
end.
