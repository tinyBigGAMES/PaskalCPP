-------------------------------------------------------------------------------
  dir_optimize_release_fast.pcpp - Directive compliance: @optimize release_fast
  (a level of dir_optimize.pcpp)

  The release_fast level: optimized for speed, asserts off (NDEBUG), no heap
  report.

  How to check, from repo\bin:
    pcpp res\tests\dir_optimize_release_fast.pcpp -r
    pcpp res\tests\dir_optimize_release_fast.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    clang sees: __OPTIMIZE__ NDEBUG
  EXITCODE: 0
  Both targets print the same.
  CHECK: output\build.zig holds "std.builtin.OptimizeMode = .ReleaseFast"
*******************************************************************************/

module exe dir_optimize_release_fast;
@optimize release_fast;

// The macros clang defines at this level, in a fixed order
static const char* dir_optimize_flags()
{
  return ""
#ifdef __OPTIMIZE__
  " __OPTIMIZE__"
#endif
#ifdef __OPTIMIZE_SIZE__
  " __OPTIMIZE_SIZE__"
#endif
#ifdef NDEBUG
  " NDEBUG"
#endif
#ifdef PCPP_DEBUG
  " PCPP_DEBUG"
#endif
  ;
}

begin
  println("clang sees:{}", cpp("dir_optimize_flags()"));
end.
