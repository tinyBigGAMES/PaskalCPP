  dir_addsourcefile_err_clang.pcpp - break step of dir_addsourcefile.pcpp: a
  C++ file with a syntax error. The error is clang's, reported at the C++
  file's own line and column, not this file's.

  How to check, from repo\bin:
    pcpp res\tests\dir_addsourcefile_err_clang.pcpp
    pcpp res\tests\dir_addsourcefile_err_clang.pcpp -t x86_64-linux-gnu
  The marked line of dir_addsourcefile_err_clang_cpp.C reports that code;
  nothing else is reported.
*******************************************************************************/

module exe dir_addsourcefile_err_clang;
@addsourcefile "$P:res/tests/dir_addsourcefile_err_clang_cpp.C";

begin
end.
