-------------------------------------------------------------------------------
  intr_exceptions.pcpp - Intrinsic compliance: raise, raisecode, exccode and excmsg

  raise(M) raises code 1 with text M, raisecode(C, M) code C (BNF.md sec 7);
  a guard's except reads them with exccode() and excmsg(), and nowhere else.
  A raise reaches the nearest guard through routine calls; code 0 is still
  caught. An unguarded raise ends the program: intr_exceptions_unhandled.

  How to check, from repo\bin:
    pcpp res\tests\intr_exceptions.pcpp -r
    pcpp res\tests\intr_exceptions.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    raise 1 plain
    raisecode 42 answer
    from a routine 5 too big
    code zero still caught 0
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    intr_exceptions_err_outside.pcpp
      excmsg outside an except body (SM0615)
    intr_exceptions_err_int.pcpp
      raise given an int32 (SM0409)
    intr_exceptions_err_wide.pcpp
      raisecode given an int64 code (SM0409)
*******************************************************************************/

module exe intr_exceptions;

routine Fail(AN: int32);
begin
  if AN > 1 then
    raisecode(AN, "too big");
  end;
end;

begin
  guard
    raise("plain");
  except
    println("raise {} {}", exccode(), excmsg());
  end;
  guard
    raisecode(42, "answer");
  except
    println("raisecode {} {}", exccode(), excmsg());
  end;
  guard
    Fail(1);
    Fail(5);
  except
    println("from a routine {} {}", exccode(), excmsg());
  end;
  guard
    raisecode(0, "zero");
  except
    println("code zero still caught {}", exccode());
  end;
end.
