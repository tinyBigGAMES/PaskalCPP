-------------------------------------------------------------------------------
  stmt_return_err_missing.pcpp - break step of stmt_return.pcpp:
  a function whose body can reach its end without a return (SM0612)

  How to check, from repo\bin:
    pcpp res\tests\stmt_return_err_missing.pcpp
    pcpp res\tests\stmt_return_err_missing.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_return_err_missing;

routine F(AN: int32): int32;
begin
  if AN > 0 then
    return 1;
  end;
end; // ERROR SM0612@1: missing return

begin
end.
