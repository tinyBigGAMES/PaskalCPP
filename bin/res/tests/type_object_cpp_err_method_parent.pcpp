-------------------------------------------------------------------------------
  type_object_cpp_err_method_parent.pcpp - break step of type_object_cpp.pcpp:
  parent.M of a method named as a value (SM0432)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_method_parent.pcpp
    pcpp res\tests\type_object_cpp_err_method_parent.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_method_parent;

type
  TFn = routine(): int32;
  TBase = object
    virtual method Get(): int32;
    begin
      return 1;
    end;
  end;
  TDerived = object(TBase)
    override method Get(): int32;
    var
      LF: TFn;
    begin
      LF := parent.Get; // ERROR SM0432
      return 2;
    end;
  end;

begin
end.
