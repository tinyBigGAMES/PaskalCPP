-------------------------------------------------------------------------------
  stmt_rules_err_cpp_switch.pcpp - break step of stmt_rules.pcpp:
  a C++ switch statement in a body: write match (PR0049)

  How to check, from repo\bin:
    pcpp res\tests\stmt_rules_err_cpp_switch.pcpp
    pcpp res\tests\stmt_rules_err_cpp_switch.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_rules_err_cpp_switch;

var
  LN: int32;

begin
  switch (LN) { default: break; } // ERROR PR0049@3: is a C++ statement
end.
