-------------------------------------------------------------------------------
  expr_conversion_err_narrow.pcpp - break step of expr_conversion.pcpp:
  an int32 variable into an int8 (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\expr_conversion_err_narrow.pcpp
    pcpp res\tests\expr_conversion_err_narrow.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_conversion_err_narrow;

var
  LI8: int8;
  LBig: int32;

begin
  LBig := 1000;
  LI8 := LBig; // ERROR SM0200@10: does not convert implicitly to 'int8'
end.
