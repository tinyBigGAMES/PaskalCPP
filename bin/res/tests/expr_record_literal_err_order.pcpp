-------------------------------------------------------------------------------
  expr_record_literal_err_order.pcpp - break step of expr_record_literal.pcpp:
  fields out of declaration order (SM0416)

  How to check, from repo\bin:
    pcpp res\tests\expr_record_literal_err_order.pcpp
    pcpp res\tests\expr_record_literal_err_order.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_record_literal_err_order;

type
  TP = record
    X: int32;
    Y: int32;
  end;

var
  LP: TP;

begin
  LP := TP(Y: 1, X: 2); // ERROR SM0416@18: 'X' comes before 'Y' in 'TP'
end.
