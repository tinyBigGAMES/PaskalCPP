  type_object_cpp_unit.pcpp - a unit type_object_cpp.pcpp imports: an
  exported object TAnimal with an init taking an argument and a virtual
  method, which the importer's C++ derives from.

  Nothing to check here: type_object_cpp.pcpp checks it.
*******************************************************************************/

module unit type_object_cpp_unit;

exported type
  TAnimal = object
    Legs: int32;
    init(const ALegs: int32);
    begin
      self.Legs := ALegs;
    end;
    virtual method Sound(): string;
    begin
      return "...";
    end;
  end;

end.
