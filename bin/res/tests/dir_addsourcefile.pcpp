-------------------------------------------------------------------------------
  dir_addsourcefile.pcpp - Directive compliance: @addsourcefile

  @addsourcefile "<path>"; builds a C / C++ / assembly / LLVM IR file into
  the program beside the emitted C++ (BNF.md sec 2). The extension, exact
  case, picks the language the way clang reads it:
  dir_addsourcefile_c.c is C, dir_addsourcefile_cpp.C (a capital C) is C++.
  The two files below are called through clink `external` routines.

  How to check, from repo\bin:
    pcpp res\tests\dir_addsourcefile.pcpp -r
    pcpp res\tests\dir_addsourcefile.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    from C: 2 + 3 = 5
    from C++: twice 4 = 8
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run each file below the same way; each reports exactly what the
  // ERROR / WARN / HINT comment on its marked line says, and nothing else:
    dir_addsourcefile_err_language.pcpp   a .h: not a file the toolchain compiles
    dir_addsourcefile_err_missing.pcpp    a file that does not exist (a relative
                                          path resolves against the current folder)
    dir_addsourcefile_err_clang.pcpp      a C++ file with a syntax error: clang's
                                          error, at the C++ file's own line and column
*******************************************************************************/

module exe dir_addsourcefile;
@addsourcefile "$P:res/tests/dir_addsourcefile_c.c";
@addsourcefile "$P:res/tests/dir_addsourcefile_cpp.C";

routine clink dir_asf_add(AA: int32; AB: int32): int32; external;
routine clink dir_asf_twice(AA: int32): int32; external;

begin
  println("from C: 2 + 3 = {}", dir_asf_add(2, 3));
  println("from C++: twice 4 = {}", dir_asf_twice(4));
end.
