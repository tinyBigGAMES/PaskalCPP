-------------------------------------------------------------------------------
  type_object_err_bare_method.pcpp - break step of type_object.pcpp:
  a method called bare in a method: write self.Show() (SM0018)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_bare_method.pcpp
    pcpp res\tests\type_object_err_bare_method.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_bare_method;

type
  TA = object
    method Show();
    begin
    end;
    method Twice();
    begin
      Show(); // ERROR SM0018@7: 'Show' is a member of 'TA': write self.Show
    end;
  end;

begin
end.
