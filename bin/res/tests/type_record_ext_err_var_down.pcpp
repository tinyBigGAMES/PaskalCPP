-------------------------------------------------------------------------------
  type_record_ext_err_var_down.pcpp - break step of type_record_ext.pcpp:
  a var TExt parameter takes no TBase variable: only an extension passes to its base (SM0405)

  How to check, from repo\bin:
    pcpp res\tests\type_record_ext_err_var_down.pcpp
    pcpp res\tests\type_record_ext_err_var_down.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_ext_err_var_down;

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

routine SetB(var AE: TExt);
begin
  AE.B := 1;
end;

var
  LB: TBase;

begin
  SetB(LB); // ERROR SM0405@8
end.
