-------------------------------------------------------------------------------
  dir_addlibrarypath.pcpp - Directive compliance: @addlibrarypath

  @addlibrarypath "<folder>"; adds a folder the linker searches for the
  libraries @linklibrary names (BNF.md sec 2). The folder must exist. The
  directive may be given more than once: the folders accumulate, and one
  folder named again (in any spelling) is the same folder. An imported unit's
  @addlibrarypath adds to the one build (dir_linklibrary_unit.pcpp shows it).

  This program adds two folders, lib_plain's and lib_runtime's (built by
  lib_plain.pcpp and lib_runtime.pcpp), lib_plain's twice in two spellings,
  links both libraries by name and calls one routine from each. Without the
  folders the linker finds neither library.

  How to check, from repo\bin (the build commands of lib_plain.pcpp and
  lib_runtime.pcpp first):
    pcpp res\tests\dir_addlibrarypath.pcpp -r
    pcpp res\tests\dir_addlibrarypath.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    lib_plain_add(2, 3) = 5
    lib_rt_div(7, 2) = 3
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR / WARN / HINT comment on its marked line says,
  and nothing else:
    dir_addlibrarypath_err_missing.pcpp   a folder that does not exist
    dir_addlibrarypath_err_file.pcpp      a file, not a folder
    dir_addlibrarypath_err_path.pcpp      a path no file routine can take
    dir_addlibrarypath_err_nopath.pcpp    lib_plain without @addlibrarypath
*******************************************************************************/

module exe dir_addlibrarypath;
@ifdef TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:output/lib_plain_linux/lib";
@addlibrarypath "$P:output\\lib_plain_linux\\lib";
@addlibrarypath "$P:output/lib_runtime_linux/lib";
@else
@addlibrarypath "$P:output/lib_plain/lib";
@addlibrarypath "$P:output\\lib_plain\\lib";
@addlibrarypath "$P:output/lib_runtime/lib";
@endif
@linklibrary "lib_plain";
@linklibrary "lib_runtime";

routine clink lib_plain_add(AA: int32; AB: int32): int32; external;
routine clink lib_rt_div(AA: int32; AB: int32): int32; external;

begin
  println("lib_plain_add(2, 3) = {}", lib_plain_add(2, 3));
  println("lib_rt_div(7, 2) = {}", lib_rt_div(7, 2));
end.
