-------------------------------------------------------------------------------
  type_array_err_too_large_range.pcpp - break step of type_array.pcpp:
  a full int64 range holds 2^64 elements, not 0 (SM0277)

  How to check, from repo\bin:
    pcpp res\tests\type_array_err_too_large_range.pcpp
    pcpp res\tests\type_array_err_too_large_range.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_array_err_too_large_range;

type
  TA = array[-9223372036854775807 - 1..9223372036854775807] of uint8; // ERROR SM0277@8: 'array[-9223372036854775808..9223372036854775807] of uint8' is too large: a type holds at most 1152921504606846975 bytes

begin
end.
