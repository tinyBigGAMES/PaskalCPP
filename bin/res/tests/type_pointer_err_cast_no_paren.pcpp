  type_pointer_err_cast_no_paren.pcpp - break step of type_pointer.pcpp:
  a pointer cast takes its value in parentheses (PR0001)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_cast_no_paren.pcpp
    pcpp res\tests\type_pointer_err_cast_no_paren.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_cast_no_paren;

var
  LP: ptr to int32;
  LU: ptr;

begin
  LU := nil;
  LP := ptr to int32 LU; // ERROR PR0001@22: expected '(', found 'LU'
end.
