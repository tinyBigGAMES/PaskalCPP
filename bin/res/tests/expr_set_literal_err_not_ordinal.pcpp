-------------------------------------------------------------------------------
  expr_set_literal_err_not_ordinal.pcpp - break step of expr_set_literal.pcpp:
  a float64 element (SM0266)

  How to check, from repo\bin:
    pcpp res\tests\expr_set_literal_err_not_ordinal.pcpp
    pcpp res\tests\expr_set_literal_err_not_ordinal.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_set_literal_err_not_ordinal;

type
  TDigits = set of 0..9;

var
  LD: TDigits;

begin
  LD := [1.5]; // ERROR SM0266@10: 'float64' is not an ordinal type
end.
