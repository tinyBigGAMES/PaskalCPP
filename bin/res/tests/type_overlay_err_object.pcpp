-------------------------------------------------------------------------------
  type_overlay_err_object.pcpp - break step of type_overlay.pcpp:
  an overlay is plain data: it holds no object (SM0357)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_object.pcpp
    pcpp res\tests\type_overlay_err_object.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_object;

type
  TO = object
    N: int32;
  end;
  TV = overlay
    A: int32;
    O: TO; // ERROR SM0357@8: a record or an overlay holds no object
  end;

begin
end.
