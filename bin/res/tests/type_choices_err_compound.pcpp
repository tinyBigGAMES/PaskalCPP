-------------------------------------------------------------------------------
  type_choices_err_compound.pcpp - break step of type_choices.pcpp:
  a choice value has no arithmetic: no compound assignment takes one (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_compound.pcpp
    pcpp res\tests\type_choices_err_compound.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_compound;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC += 1; // ERROR SM0250@3: operator '+=' does not take 'TColor' and 'int32'
end.
