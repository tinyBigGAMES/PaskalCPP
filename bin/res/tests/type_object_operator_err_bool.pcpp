  type_object_operator_err_bool.pcpp - break step of type_object_operator.pcpp:
  a comparison operator that does not give a bool (SM0382)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_bool.pcpp
    pcpp res\tests\type_object_operator_err_bool.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_bool;

type
  TVec = record
    X: int32;
    Y: int32;
    operator <(const A: TVec; const B: TVec): int32; // ERROR SM0382
    begin
      return A.X - B.X;
    end;
  end;

begin
end.
