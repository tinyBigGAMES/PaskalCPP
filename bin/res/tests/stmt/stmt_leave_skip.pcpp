-------------------------------------------------------------------------------
  stmt_leave_skip.pcpp - Statement: leave and skip

  leave; ends the innermost loop or match, skip; goes to the next pass of
  the innermost loop (BNF.md sec 5), in while, for and repeat; a leave in
  a match inside a loop ends the match only. Neither jumps out of finally.
*******************************************************************************/

module exe stmt_leave_skip;

/*
  @@test
    kind run
    expect
    | for leave 1 2
    | for skip 1 3 5
    | repeat leave 3
    | match in loop 1 2 3
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

var
  LI: int32;

begin
  print("for leave");
  for LI := 1 to 5 do
    if LI = 3 then
      leave;
    end;
    print(" {}", LI);
  end;
  println("");
  print("for skip");
  for LI := 1 to 5 do
    if LI mod 2 = 0 then
      skip;
    end;
    print(" {}", LI);
  end;
  println("");
  LI := 0;
  repeat
    LI += 1;
    if LI = 3 then
      leave;
    end;
  until false;
  println("repeat leave {}", LI);
  print("match in loop");
  for LI := 1 to 3 do
    match LI of
      2:
        print(" 2");
        leave;
    else
      print(" {}", LI);
    end;
  end;
  println("");
end.
