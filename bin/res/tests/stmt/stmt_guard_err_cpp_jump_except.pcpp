-------------------------------------------------------------------------------
  stmt_guard_err_cpp_jump_except.pcpp - Stmt: guard, cpp jump except

  Break step of stmt_guard: a C++ break inside the except body of a guard with
  finally (SM0614).
*******************************************************************************/

module exe stmt_guard_err_cpp_jump_except;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 0;
  while LN < 3 do
    guard
      raise("x");
    except
      cppstart source
      break; // ERROR SM0614@7: leaves only the except
      cppend;
    finally
      LN += 1;
    end;
  end;
end.
