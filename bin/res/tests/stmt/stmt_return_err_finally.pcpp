module exe stmt_return_err_finally;

/*
  @@test
    kind error
  @@end
*/

routine F(): int32;
begin
  guard
    println("body");
  finally
    return 1; // ERROR SM0609@5: return cannot jump out of finally
  end;
  return 0;
end;

begin
end.
