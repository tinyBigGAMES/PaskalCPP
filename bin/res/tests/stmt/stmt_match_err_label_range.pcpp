-------------------------------------------------------------------------------
  stmt_match_err_label_range.pcpp - Stmt: match, label range

  Break step of stmt_match: a label outside the subject's type: it never
  matches (SM0604).
*******************************************************************************/

module exe stmt_match_err_label_range;

/*
  @@test
    kind error
  @@end
*/

var
  LB: int8;

begin
  LB := 1;
  match LB of
    300: println("big"); // ERROR SM0604@5: is outside
  end;
end.
