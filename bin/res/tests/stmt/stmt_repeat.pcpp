-------------------------------------------------------------------------------
  stmt_repeat.pcpp - Statement: repeat

  repeat ... until C; (BNF.md sec 5): the body runs first and the loop
  ends when the bool C is true, so the body runs at least once.
*******************************************************************************/

module exe stmt_repeat;

/*
  @@test
    kind run
    expect
    | count 4
    | once 1
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

var
  LI: int32;

begin
  LI := 0;
  repeat
    LI += 1;
  until LI = 4;
  println("count {}", LI);
  LI := 0;
  repeat
    LI += 1;
  until true;
  println("once {}", LI);
end.
