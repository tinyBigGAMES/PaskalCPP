  stmt_rules_err_no_effect.pcpp - Stmt: rules, no effect

  Break step of stmt_rules: an expression statement that has no effect
  (SM0613).
*******************************************************************************/

module exe stmt_rules_err_no_effect;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 1;
  LN + 1; // ERROR SM0613@3: has no effect
end.
