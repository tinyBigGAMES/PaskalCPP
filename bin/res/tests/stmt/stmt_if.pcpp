-------------------------------------------------------------------------------
  stmt_if.pcpp - Statement: if

  if ... then ... [else ...] end; (BNF.md sec 5): the condition is bool,
  each branch a statement list, a chain of tests nests an if in the else.
*******************************************************************************/

module exe stmt_if;

/*
  @@test
    kind run
    expect
    | positive
    | zero
    | negative
    | nested yes
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

routine Sign(AN: int32);
begin
  if AN > 0 then
    println("positive");
  else
    if AN = 0 then
      println("zero");
    else
      println("negative");
    end;
  end;
end;

var
  LA: bool = true;
  LB: bool = true;

begin
  Sign(5);
  Sign(0);
  Sign(-5);
  if LA then
    if LB and LA then
      println("nested yes");
    end;
  end;
  if not LA then
    println("never");
  end;
end.
