-------------------------------------------------------------------------------
  stmt_guard_err_cpp_jump.pcpp - Stmt: guard, cpp jump

  Break step of stmt_guard: a C++ break inside a guard body leaves only its
  hidden function (SM0614).
*******************************************************************************/

module exe stmt_guard_err_cpp_jump;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 0;
  while LN < 3 do
    guard
      cppstart source
      break; // ERROR SM0614@7: leaves only the guard
      cppend;
    except
      LN := 9;
    end;
    LN += 1;
  end;
end.
