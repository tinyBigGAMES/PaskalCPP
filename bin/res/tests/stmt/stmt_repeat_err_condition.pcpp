-------------------------------------------------------------------------------
  stmt_repeat_err_condition.pcpp - Stmt: repeat, condition

  Break step of stmt_repeat: an int32 until condition: a condition is bool
  (SM0263).
*******************************************************************************/

module exe stmt_repeat_err_condition;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 1;
  repeat
    LN := 0;
  until LN; // ERROR SM0263@9: a condition is bool
end.
