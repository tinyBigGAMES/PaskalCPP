-------------------------------------------------------------------------------
  stmt_match_err_label_reversed.pcpp - Stmt: match, label reversed

  Break step of stmt_match: a range label whose low bound exceeds its high
  bound (SM0267).
*******************************************************************************/

module exe stmt_match_err_label_reversed;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 1;
  match LN of
    1: println("a");
    5..2: println("b"); // ERROR SM0267@5: low bound 5 exceeds high bound 2
  end;
end.
