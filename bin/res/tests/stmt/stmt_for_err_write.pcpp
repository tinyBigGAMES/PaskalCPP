  stmt_for_err_write.pcpp - Stmt: for, write

  Break step of stmt_for: the body writes the iterator (SM0602).
*******************************************************************************/

module exe stmt_for_err_write;

/*
  @@test
    kind error
  @@end
*/

var
  LI: int32;

begin
  for LI := 1 to 3 do
    LI := 5; // ERROR SM0602@5: the loop body cannot write it
  end;
end.
