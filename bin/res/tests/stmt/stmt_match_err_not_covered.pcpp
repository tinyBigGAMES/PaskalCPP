module exe stmt_match_err_not_covered;

/*
  @@test
    kind build
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LK: TColor;

begin
  LK := TColor.cRed;
  match LK of // WARN SM0606@3: does not cover
    TColor.cRed: println("red");
    TColor.cGreen: println("green");
  end;
end.
