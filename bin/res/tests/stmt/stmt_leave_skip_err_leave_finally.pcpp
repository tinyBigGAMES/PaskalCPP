  stmt_leave_skip_err_leave_finally.pcpp - Stmt: leave skip, leave finally

  Break step of stmt_leave_skip: leave inside finally (SM0609).
*******************************************************************************/

module exe stmt_leave_skip_err_leave_finally;

/*
  @@test
    kind error
  @@end
*/

begin
  while true do
    guard
      println("body");
    finally
      leave; // ERROR SM0609@7: leave cannot jump out of finally
    end;
  end;
end.
