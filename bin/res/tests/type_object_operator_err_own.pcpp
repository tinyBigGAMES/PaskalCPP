  type_object_operator_err_own.pcpp - break step of type_object_operator.pcpp:
  an operator none of whose operands is the declaring type (SM0381)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_own.pcpp
    pcpp res\tests\type_object_operator_err_own.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_own;

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: int32; const B: int32): int32; // ERROR SM0381
    begin
      return A;
    end;
  end;

begin
end.
