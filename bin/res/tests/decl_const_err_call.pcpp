-------------------------------------------------------------------------------
  decl_const_err_call.pcpp - break step of decl_const.pcpp:
  a const whose value is a routine call

  How to check, from repo\bin:
    pcpp res\tests\decl_const_err_call.pcpp
    pcpp res\tests\decl_const_err_call.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_const_err_call;

routine Three(): int32;
begin
  return 3;
end;

const
  CBad: int32 = Three(); // ERROR SM0202@17

begin
  println("{}", CBad);
end.
