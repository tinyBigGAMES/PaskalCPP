-------------------------------------------------------------------------------
  type_record_err_align_below.pcpp - break step of type_record.pcpp:
  align(2) on an int32 field: below the natural alignment 4; every field is a PaskalCPP type, so PaskalCPP knows the layout (SM0311, at the align value)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_align_below.pcpp
    pcpp res\tests\type_record_err_align_below.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_align_below;

type
  TR = record align(2) // ERROR SM0311@21: align 2 is below the natural alignment 4 of 'TR', lower it with packed
    B: int32;
  end;

begin
end.
