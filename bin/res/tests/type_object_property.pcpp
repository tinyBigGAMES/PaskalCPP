-------------------------------------------------------------------------------
  type_object_property.pcpp - Type compliance: properties

  property X: T read ...; [[hidden] write ...;] in an object is a value
  read and written through accessors, never storage (BNF.md sec 4
  property decl). Shown here:
  - a read or a write bound to a field (Celsius: zero cost, the field
    itself), or written with a body (Fahrenheit: read returns a value,
    write(AValue) takes one of the property's type);
  - a hidden write: Log is read anywhere, written only in the methods of
    TTemp and its descendants (Note);
  - parent.Celsius in a descendant, an own's object (LO.Celsius), an
    element of an array; a read through a const object (Show: a read
    changes nothing);
  - X OP= v reads, operates and writes; the object, then the value, are
    evaluated once each, in that order (index before value).

  How to check, from repo\bin:
    pcpp res\tests\type_object_property.pcpp -r
    pcpp res\tests\type_object_property.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    100 212
    0
    value 7
    12
    const 12 53
    ab
    6
    index
    value 5
    index
    value 1
    6
    [Heap] Allocs: 1, Frees: 1, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report (LO is one allocation).

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    type_object_property_err_no_read.pcpp  a property whose accessors do not start with read
    type_object_property_err_write_shape.pcpp  a write with a value name and no body
    type_object_property_err_no_field.pcpp  a read bound to a name that is no field
    type_object_property_err_field_type.pcpp  a read bound to a field of another type
    type_object_property_err_read_change.pcpp  a read that assigns a field of self
    type_object_property_err_read_call.pcpp  a read that calls a method through self
    type_object_property_err_read_increment.pcpp  a read that increments a field of self
    type_object_property_err_own_read.pcpp  a read that reads its own property through self
    type_object_property_err_own_write.pcpp  a write that assigns its own property through self
    type_object_property_err_no_write.pcpp  a read-only property assigned
    type_object_property_err_hidden_write.pcpp  a hidden write assigned from outside the object's methods
    type_object_property_err_const.pcpp  a property assigned through a const object
    type_object_property_err_value.pcpp  a property assignment used as a value
    type_object_property_err_address.pcpp  the address of a property
    type_object_property_err_increment.pcpp  a property incremented in place
    type_object_property_err_var_arg.pcpp  a property passed to a var parameter
    type_object_property_err_bare.pcpp  a property named without self. in a method
    type_object_property_err_record.pcpp  a property in a record
*******************************************************************************/

module exe type_object_property;

type
  TTemp = object
    FC: int32;
    FLog: string;
    property Celsius: int32 read FC; write FC;
    property Fahrenheit: int32 read
      begin
        return self.FC * 9 div 5 + 32;
      end;
      write(AValue)
      begin
        self.FC := (AValue - 32) * 5 div 9;
      end;
    property Log: string read FLog; hidden write FLog;
    method Note(const AText: string);
    begin
      self.Log := self.Log + AText;
    end;
  end;
  TChild = object(TTemp)
    method Warm();
    begin
      parent.Celsius += 5;
    end;
  end;

routine Pick(const AValue: int32): int32;
begin
  println("value {}", AValue);
  return AValue;
end;

routine Idx(): int32;
begin
  println("index");
  return 1;
end;

routine Show(const AT: TTemp);
begin
  println("const {} {}", AT.Celsius, AT.Fahrenheit);
end;

var
  LT: TChild;
  LO: own TTemp;
  LA: array[0..1] of TTemp;
begin
  LT.Celsius := 100;
  println("{} {}", LT.Celsius, LT.Fahrenheit);
  LT.Fahrenheit := 32;
  println("{}", LT.Celsius);
  LT.Celsius += Pick(7);
  LT.Warm();
  println("{}", LT.Celsius);
  Show(LT);
  LT.Note("a");
  LT.Note("b");
  println("{}", LT.Log);
  LO := own TTemp;
  LO.Celsius := 3;
  LO.Celsius *= 2;
  println("{}", LO.Celsius);
  LA[Idx()].Celsius := Pick(5);
  LA[Idx()].Celsius += Pick(1);
  println("{}", LA[1].Celsius);
end.
