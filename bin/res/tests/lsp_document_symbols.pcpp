-------------------------------------------------------------------------------
  lsp_document_symbols.pcpp - LSP compliance: outline, breadcrumbs, Ctrl+Shift+O

  The editor lists this file's declarations as a tree: the outline view,
  the breadcrumbs above the text and Ctrl+Shift+O all show it. Clicking an
  entry selects its NAME.

  How to check: press Ctrl+Shift+O and compare the list with the tree
  below (indented = a child; [kind] = the icon; then the grey detail):

    lsp_unit                       [module]
    KMax                           [constant]  int32
    TRec                           [struct]
      A                            [field]     int32
      B                            [field]     int32   (from the overlay)
      C                            [field]     uint8   (from the overlay)
    TObj                           [class]
      F                            [field]     int32
      Put                          [method]    (const AV: int32)
    TCol                           [enum]
      cRed                         [enum member]
      cGreen                       [enum member]
    TAlias                         [type]
    Fw                             [function]  (const AA: int32): int32
    Outer                          [function]  (): int32
      TLoc                         [type]      (a local type; local vars
                                                are not listed)
    Fw                             [function]  (const AA: int32): int32
    GV                             [variable]  int32
    initialize                     [function]  ()
    first                          [event]     (a test block)

  Needs lsp_unit.pcpp in the same folder.
*******************************************************************************/

module exe lsp_document_symbols;

import
  lsp_unit;

const
  KMax: int32 = 10;

type
  TRec = record
    A: int32;
    overlay
      B: int32;
      C: uint8;
    end;
  end;
  TObj = object
    F: int32;
    method Put(const AV: int32);
    begin
    end;
  end;
  TCol = choices(cRed, cGreen);
  TAlias = int32;

forward routine Fw(const AA: int32): int32;

routine Outer(): int32;
var
  LX: int32;
type
  TLoc = int32;
begin
  LX := 0;
  return LX;
end;

routine Fw(const AA: int32): int32;
begin
  return AA;
end;

var
  GV: int32;

initialize
begin
end;

begin
  GV := Fw(KMax);
end.

test "first"
begin
end;
