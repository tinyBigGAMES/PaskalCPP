-------------------------------------------------------------------------------
  std_sysutils_format_err_count.pcpp - break step of std_sysutils_format.pcpp:
  a format string with more {} than arguments (SM0502)

  How to check, from repo\bin:
    pcpp res\tests\std_sysutils_format_err_count.pcpp
    pcpp res\tests\std_sysutils_format_err_count.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe std_sysutils_format_err_count;

import
  SysUtils;

var
  LText: string;

begin
  LText := FormatStr("{} {}", 1); // ERROR SM0502@22
  println("{}", LText);
end.
