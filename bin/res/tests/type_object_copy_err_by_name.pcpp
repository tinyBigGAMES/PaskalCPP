-------------------------------------------------------------------------------
  type_object_copy_err_by_name.pcpp - break step of type_object_copy.pcpp:
  copy called by name: it runs when an object is copied (SM0342)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_by_name.pcpp
    pcpp res\tests\type_object_copy_err_by_name.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_by_name;

type
  TA = object
    N: int32;
    method Again();
    begin
      self.copy(); // ERROR SM0342@12: copy runs when an object is copied
    end;
  end;

begin
end.
