-------------------------------------------------------------------------------
  decl_routine_err_return_value.pcpp - break step of decl_routine.pcpp:
  return with no value in a function: a function returns a value

  How to check, from repo\bin:
    pcpp res\tests\decl_routine_err_return_value.pcpp
    pcpp res\tests\decl_routine_err_return_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_routine_err_return_value;

routine Three(): int32;
begin
  return; // ERROR SM0610@3
end;

begin
  println("{}", Three());
end.
