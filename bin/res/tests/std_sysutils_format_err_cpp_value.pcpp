-------------------------------------------------------------------------------
  std_sysutils_format_err_cpp_value.pcpp - break step of
  std_sysutils_format.pcpp: a C++ value with no std::formatter as an argument
  (SM0425 at the argument)

  How to check, from repo\bin:
    pcpp res\tests\std_sysutils_format_err_cpp_value.pcpp
    pcpp res\tests\std_sysutils_format_err_cpp_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe std_sysutils_format_err_cpp_value;

import
  SysUtils;

struct CNo {
  int x;
};

var
  LValue: CNo;
  LText: string;

begin
  LValue.x := 1;
  LText := FormatStr("{}", LValue); // ERROR SM0425@28
  println("{}", LText);
end.
