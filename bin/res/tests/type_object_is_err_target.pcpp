  type_object_is_err_target.pcpp - break step of type_object_is.pcpp:
  as naming a type that is not an object (SM0272)

  How to check, from repo\bin:
    pcpp res\tests\type_object_is_err_target.pcpp
    pcpp res\tests\type_object_is_err_target.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_is_err_target;

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;

routine Check(const AShape: TShape): int32;
begin
  return AShape as int32; // ERROR SM0272
end;

begin
end.
