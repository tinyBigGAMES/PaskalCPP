-------------------------------------------------------------------------------
  stmt_guard_err_cpp_jump.pcpp - break step of stmt_guard.pcpp:
  a C++ break inside a guard body leaves only its hidden function (SM0614)

  How to check, from repo\bin:
    pcpp res\tests\stmt_guard_err_cpp_jump.pcpp
    pcpp res\tests\stmt_guard_err_cpp_jump.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_guard_err_cpp_jump;

var
  LN: int32;

begin
  LN := 0;
  while LN < 3 do
    guard
      cppstart source
      break; // ERROR SM0614@7: leaves only the guard
      cppend;
    except
      LN := 9;
    end;
    LN += 1;
  end;
end.
