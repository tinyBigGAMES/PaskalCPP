  type_record_err_bit_type.pcpp - break step of type_record.pcpp:
  a float32 bitfield (SM0314)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_bit_type.pcpp
    pcpp res\tests\type_record_err_bit_type.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_bit_type;

type
  TR = record
    B: float32 : 3; // ERROR SM0314@5: a bitfield is an integer, bool, char, wchar or choices field
  end;

begin
end.
