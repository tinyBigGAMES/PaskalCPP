  type_alias_err_const.pcpp - break step of type_alias.pcpp:
  an alias of a constant: K is not a type (SM0013)

  How to check, from repo\bin:
    pcpp res\tests\type_alias_err_const.pcpp
    pcpp res\tests\type_alias_err_const.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_alias_err_const;

const
  K: int32 = 3;

type
  TA = K; // ERROR SM0013@8: 'K' is not a type

begin
end.
