-------------------------------------------------------------------------------
  type_object_virtual_err_abstract_not_virtual.pcpp - break step of type_object_virtual.pcpp:
  abstract on a plain method: an abstract method is virtual (SM0337)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_abstract_not_virtual.pcpp
    pcpp res\tests\type_object_virtual_err_abstract_not_virtual.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_abstract_not_virtual;

type
  TA = object
    method M(); abstract; // ERROR SM0337@17: an abstract method is virtual: write 'virtual method M'
  end;

begin
end.
