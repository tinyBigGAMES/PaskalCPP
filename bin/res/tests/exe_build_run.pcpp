-------------------------------------------------------------------------------
  exe_build_run.pcpp - Build-kind compliance: an exe, built and run

  module exe builds an executable (BNF.md sec 1): its initialize section
  runs, then its begin body, then finalize; the program exits with 0.
  pcpp -r builds it and runs it in its own folder.

  How to check, from repo\bin:
    pcpp res\tests\exe_build_run.pcpp -r
    pcpp res\tests\exe_build_run.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    init
    body 7
    final
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.
*******************************************************************************/

module exe exe_build_run;

var
  GBase: int32 = 3;

routine Add(AA: int32; AB: int32): int32;
begin
  return AA + AB;
end;

initialize
begin
  println("init");
end;

finalize
begin
  println("final");
end;

begin
  println("body {}", Add(GBase, 4));
end.
