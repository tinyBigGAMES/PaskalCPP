-------------------------------------------------------------------------------
  dbg_watch.pcpp - Debugger: watch and hover

  What a WATCH row, a hover and the REPL's p show for an expression: a field,
  an element, a deref, '->', a nested field, and the message for an
  expression the debugger does not evaluate.

  How to check, from repo\bin:
    REPL:   pcpp res\tests\dbg\dbg_watch.pcpp -d   then type each step's words
    Editor: open res\tests\dbg\dbg_watch.pcpp, F5, then each step's keys
  Each step: what to type, then "->" what both front-ends show.

  Keys (REPL word = editor key):
    c = F5 (continue)   n = F10 (over)   s = F11 (into)
    finish = Shift+F11 (out)   q = Shift+F5 (stop)
    b N = click the gutter left of line N
    bt = the CALL STACK   f N = click CALL STACK row N (0 = top)
    locals = the VARIABLES pane   p X = a WATCH row for X (hover is the same)
    the program's output and keyboard = the console the REPL runs in /
    the editor's TERMINAL tab

  Steps:
   1. (start)          -> stops at 86 in Look (breakpoint)
   2. p LPair.A        -> 3
      p LNums[2]       -> 22
      p LPtr^          -> 7
      p LPairPtr^.B    -> 4
      p LPairPtr->B    -> 4
      p LBox.Pair.B    -> 8
      p LInt + 1       -> a message: the expression is not evaluated
      p LNope          -> a message: no such name
   3. q                -> the program is stopped
*******************************************************************************/

module exe dbg_watch;

/*
  @@test
    kind manual
    targets x86_64-windows-gnu
  @@end
*/

type
  TPair = record
    A: int32;
    B: int32;
  end;
  TBox = object
    W: int32;
    Pair: TPair;
  end;

routine Look();
var
  LPair: TPair;
  LNums: array[0..3] of int32;
  LInt: int32;
  LPtr: ptr to int32;
  LPairPtr: ptr to TPair;
  LBox: TBox;
begin
  LPair.A := 3;
  LPair.B := 4;
  LNums[2] := 22;
  LInt := 7;
  LPtr := address of LInt;
  LPairPtr := address of LPair;
  LBox.W := 9;
  LBox.Pair.B := 8;
  @breakpoint;
  println("{}", LInt);
end;

begin
  Look();
end.
