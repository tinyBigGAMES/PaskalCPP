-------------------------------------------------------------------------------
  dbg_variables.pcpp - Debugger: variables

  What the VARIABLES pane (REPL: locals) shows: Params, Locals and Globals of
  the selected frame, every kind of PaskalCPP value, a var parameter, and the
  module body (Globals only).

  How to check, from repo\bin:
    REPL:   pcpp res\tests\dbg\dbg_variables.pcpp -d   then type each step's words
    Editor: open res\tests\dbg\dbg_variables.pcpp, F5, then each step's keys
  Each step: what to type, then "->" what both front-ends show.

  Keys (REPL word = editor key):
    c = F5 (continue)   n = F10 (over)   s = F11 (into)
    finish = Shift+F11 (out)   q = Shift+F5 (stop)
    b N = click the gutter left of line N
    bt = the CALL STACK   f N = click CALL STACK row N (0 = top)
    locals = the VARIABLES pane   p X = a WATCH row for X (hover is the same)
    the program's output and keyboard = the console the REPL runs in /
    the editor's TERMINAL tab

  Steps:
   1. (start)          -> stops at 139 (breakpoint)
      locals           -> Globals only: GTotal = 10, GName = "globals"
   2. c                -> stops at 132 in Show (breakpoint)
      locals           -> Params: ASeed = 2, ATotal = 52 (a var parameter:
                          the caller's GTotal)
                          Locals: LInt = 42, LBool = true, LFloat = 2.5,
                          LShort = "hi", LLong = its whole text, LWide = L"wide",
                          LPair {A = 7, B = 9}, LPoint {Z = 8 (TBase), X = 4,
                          Y = 6}, LCol = cBlue, LSet = [cRed, cBlue],
                          LNums [1, 2, 11, 4], LDyn [0, 5, 0], LPtr = an
                          address (LInt's value under it), LFlags {A = 5,
                          B = -3, C = true, D = cBlue}
                          Globals: GTotal = 52, GName = "globals"
   3. f 1              -> frame 1: dbg_variables at 139
      locals           -> Globals only: GTotal = 52
   4. c                -> prints "42 52", the program ends
*******************************************************************************/

module exe dbg_variables;

/*
  @@test
    kind manual
    targets x86_64-windows-gnu
  @@end
*/

type
  TPair = record
    A: int32;
    B: int64;
  end;
  TCol = choices(cRed, cGreen = 5, cBlue);
  TColSet = set of TCol;
  TFlags = record
    A: uint8 : 3;
    B: int8 : 4;
    C: bool : 1;
    D: TCol : 4;
  end;
  TBase = object
    Z: int32;
  end;
  TPoint = object(TBase)
    X: int32;
    Y: int32;
  end;

var
  GTotal: int32;
  GName: string;

routine Show(const ASeed: int32; var ATotal: int32);
var
  LInt: int32;
  LBool: bool;
  LFloat: float64;
  LShort: string;
  LLong: string;
  LWide: wstring;
  LPair: TPair;
  LPoint: TPoint;
  LCol: TCol;
  LSet: TColSet;
  LNums: array[0..3] of int32;
  LDyn: array of int32;
  LPtr: ptr to int32;
  LFlags: TFlags;
begin
  LInt := ASeed + 40;
  LBool := true;
  LFloat := 2.5;
  LShort := "hi";
  LLong := "a string longer than twenty-two chars";
  LWide := L"wide";
  LPair.A := 7;
  LPair.B := 9;
  LPoint.Z := 8;
  LPoint.X := 4;
  LPoint.Y := 6;
  LCol := TCol.cBlue;
  LSet := [TCol.cRed, TCol.cBlue];
  LNums[0] := 1;
  LNums[1] := 2;
  LNums[2] := 11;
  LNums[3] := 4;
  setlength(LDyn, 3);
  LDyn[1] := 5;
  LPtr := address of LInt;
  LFlags.A := 5;
  LFlags.B := -3;
  LFlags.C := true;
  LFlags.D := TCol.cBlue;
  ATotal := ATotal + LInt;
  @breakpoint;
  println("{} {}", LInt, ATotal);
end;

begin
  GTotal := 10;
  GName := "globals";
  @breakpoint;
  Show(2, GTotal);
  println("{}", GTotal);
end.
