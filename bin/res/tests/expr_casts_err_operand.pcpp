  expr_casts_err_operand.pcpp - break step of expr_casts.pcpp:
  a C-style cast with no operand (PR0047)

  How to check, from repo\bin:
    pcpp res\tests\expr_casts_err_operand.pcpp
    pcpp res\tests\expr_casts_err_operand.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_casts_err_operand;

var
  LN: int32;

begin
  LN := (int); // ERROR PR0047@14: expected an expression after the cast
end.
