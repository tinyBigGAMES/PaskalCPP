-------------------------------------------------------------------------------
  type_object_err_field_field.pcpp - break step of type_object.pcpp:
  a field named like a parent field (SM0309)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_field_field.pcpp
    pcpp res\tests\type_object_err_field_field.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_field_field;

type
  TA = object
    X: int32;
  end;
  TB = object(TA)
    X: int32; // ERROR SM0309@5: 'X' reuses a name of the parent chain
  end;

begin
end.
