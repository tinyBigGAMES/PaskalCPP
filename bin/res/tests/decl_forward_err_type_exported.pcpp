-------------------------------------------------------------------------------
  decl_forward_err_type_exported.pcpp - break step of decl_forward.pcpp:
  an exported forward type whose full declaration is not exported

  How to check, from repo\bin:
    pcpp res\tests\decl_forward_err_type_exported.pcpp
    pcpp res\tests\decl_forward_err_type_exported.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module lib decl_forward_err_type_exported;

exported forward type TItem;

type
  TItem = record // ERROR SM0306@3: one is exported, the other is not
    Value: int32;
  end;

end.
