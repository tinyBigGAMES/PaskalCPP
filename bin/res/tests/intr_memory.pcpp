-------------------------------------------------------------------------------
  intr_memory.pcpp - Intrinsic compliance: getmem, resizemem and freemem

  getmem(N) gives N bytes (nil for 0), resizemem(P, N) resizes a block and
  keeps its bytes (from nil it allocates, to 0 it frees), freemem(P) frees
  it (BNF.md sec 7); getmem and resizemem are expressions and statements. The
  debug build counts each block the heap gives and takes back.

  How to check, from repo\bin:
    pcpp res\tests\intr_memory.pcpp -r
    pcpp res\tests\intr_memory.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    resized keeps 7
    zero bytes nil true
    from nil true
    done
    [Heap] Allocs: 2, Frees: 2, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    intr_memory_err_statement.pcpp
      freemem used as a value (SM0408)
    intr_memory_err_string.pcpp
      getmem given a string (SM0409)
    intr_memory_err_unsigned.pcpp
      getmem given a uint64 size (SM0409)
*******************************************************************************/

module exe intr_memory;

var
  LP: ptr to int32;
  LQ: ptr;
  LN: ptr;

begin
  LP := ptr to int32(getmem(16));
  LP^ := 7;
  LP := ptr to int32(resizemem(LP, 64));
  println("resized keeps {}", LP^);
  freemem(LP);
  LN := getmem(0);
  println("zero bytes nil {}", LN = nil);
  LQ := resizemem(nil, 8);
  println("from nil {}", LQ <> nil);
  resizemem(LQ, 0);
  println("done");
end.
