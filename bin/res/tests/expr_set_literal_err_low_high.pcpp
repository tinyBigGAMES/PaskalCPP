-------------------------------------------------------------------------------
  expr_set_literal_err_low_high.pcpp - break step of expr_set_literal.pcpp:
  a range whose low bound exceeds its high bound (SM0267)

  How to check, from repo\bin:
    pcpp res\tests\expr_set_literal_err_low_high.pcpp
    pcpp res\tests\expr_set_literal_err_low_high.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_set_literal_err_low_high;

type
  TDigits = set of 0..9;

var
  LD: TDigits;

begin
  LD := [5..1]; // ERROR SM0267@10: low bound 5 exceeds high bound 1
end.
