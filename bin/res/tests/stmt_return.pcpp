-------------------------------------------------------------------------------
  stmt_return.pcpp - Statement compliance: return

  return [V]; (BNF.md sec 5): a function returns a value of its return type
  and every path of its body ends in a return; a procedure returns none, and
  return leaves it early, from inside loops and matches too.

  How to check, from repo\bin:
    pcpp res\tests\stmt_return.pcpp -r
    pcpp res\tests\stmt_return.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    value 42
    first even 4
    early yes
    arm two
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    stmt_return_err_needs_value.pcpp
      return with no value in a function (SM0610)
    stmt_return_err_value.pcpp
      return with a value in a procedure (SM0611)
    stmt_return_err_missing.pcpp
      a function whose body can reach its end without a return (SM0612)
    stmt_return_err_finally.pcpp
      return inside finally (SM0609)
*******************************************************************************/

module exe stmt_return;

routine Answer(): int32;
begin
  return 42;
end;

routine FirstEven(AFrom: int32): int32;
var
  LI: int32;
begin
  for LI := AFrom to 100 do
    if LI mod 2 = 0 then
      return LI;
    end;
  end;
  return -1;
end;

routine Early(AQuit: bool);
begin
  if AQuit then
    println("early yes");
    return;
  end;
  println("never");
end;

routine Arm(AN: int32): string;
begin
  match AN of
    2: return "two";
  end;
  return "other";
end;

begin
  println("value {}", Answer());
  println("first even {}", FirstEven(3));
  Early(true);
  println("arm {}", Arm(2));
end.
