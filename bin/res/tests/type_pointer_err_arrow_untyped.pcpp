-------------------------------------------------------------------------------
  type_pointer_err_arrow_untyped.pcpp - break step of type_pointer.pcpp:
  nor is the untyped ptr: it points at no record (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_arrow_untyped.pcpp
    pcpp res\tests\type_pointer_err_arrow_untyped.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_arrow_untyped;

var
  LU: ptr;
  LX: int32;

begin
  LX := LU->X; // ERROR SM0250@9: operator '->' does not take 'ptr'
end.
