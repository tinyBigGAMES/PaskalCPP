-------------------------------------------------------------------------------
  type_array_err_not_indexable.pcpp - break step of type_array.pcpp:
  only an array, a string or a typed pointer is indexed (SM0260)

  How to check, from repo\bin:
    pcpp res\tests\type_array_err_not_indexable.pcpp
    pcpp res\tests\type_array_err_not_indexable.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_array_err_not_indexable;

var
  LN: int32;
  LI: int32;

begin
  LI := LN[0]; // ERROR SM0260@9: 'int32' cannot be indexed
end.
