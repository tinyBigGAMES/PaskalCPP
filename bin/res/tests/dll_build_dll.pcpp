  dll_build_dll.pcpp - the dll dll_build.pcpp links: one exported clink routine.
  @outputpath puts each target's build where dll_build.pcpp looks for it
  ($P: = the folder pcpp.exe is in), from the CLI and the editor alike.

  How to build, from repo\bin:
    pcpp res\tests\dll_build_dll.pcpp
    pcpp res\tests\dll_build_dll.pcpp -t x86_64-linux-gnu

  Nothing to check here: dll_build.pcpp checks it.
*******************************************************************************/

module dll dll_build_dll;

exported routine clink dll_build_twice(AN: int32): int32;
begin
  return AN * 2;
end;

end.
