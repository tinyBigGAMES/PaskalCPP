-------------------------------------------------------------------------------
  type_object_iface_err_repeat.pcpp - break step of type_object_iface.pcpp:
  an interface repeating its parent's method (SM0368)

  How to check, from repo\bin:
    pcpp res\tests\type_object_iface_err_repeat.pcpp
    pcpp res\tests\type_object_iface_err_repeat.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_iface_err_repeat;

type
  IShape = interface
    method Area(): int32;
  end;
  IShape2 = interface(IShape)
    method Area(): int32; // ERROR SM0368@12: method 'Area' of interface 'IShape2' is already declared by its parent 'IShape'
  end;

begin
end.
