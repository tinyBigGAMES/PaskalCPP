-------------------------------------------------------------------------------
  type_record_ext_err_downcast.pcpp - break step of type_record_ext.pcpp:
  a ptr to TBase does not become a ptr to TExt by itself: a downcast is written ptr to TExt(P) (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_record_ext_err_downcast.pcpp
    pcpp res\tests\type_record_ext_err_downcast.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_ext_err_downcast;

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

var
  LB: TBase;
  LPB: ptr to TBase;
  LPE: ptr to TExt;

begin
  LPB := address of LB;
  LPE := LPB; // ERROR SM0200@10: does not convert implicitly
end.
