-------------------------------------------------------------------------------
  type_routine_err_argument.pcpp - break step of type_routine.pcpp:
  a routine with the wrong signature as an argument for a routine-typed parameter (SM0404)

  How to check, from repo\bin:
    pcpp res\tests\type_routine_err_argument.pcpp
    pcpp res\tests\type_routine_err_argument.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_routine_err_argument;

type
  TOps = record
    F: routine(AN: int32): int32;
  end;

routine Double(AN: int32): int32;
begin
  return AN * 2;
end;

routine Wrong(AN: int64): int32;
begin
  return 0;
end;

routine Apply(AF: routine(AN: int32): int32; AN: int32): int32;
begin
  return AF(AN);
end;

var
  LN: int32;

begin
  LN := Apply(Wrong, 1); // ERROR SM0404@15
end.
