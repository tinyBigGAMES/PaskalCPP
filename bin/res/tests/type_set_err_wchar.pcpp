  type_set_err_wchar.pcpp - break step of type_set.pcpp:
  set of wchar: its size differs by target, its range is written (SM0319)

  How to check, from repo\bin:
    pcpp res\tests\type_set_err_wchar.pcpp
    pcpp res\tests\type_set_err_wchar.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_set_err_wchar;

type
  TA = set of wchar; // ERROR SM0319@15: set of wchar: its size differs by target: write set of 0..65535

begin
end.
