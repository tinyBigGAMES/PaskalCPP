  expr_primary_err_parent_none.pcpp - break step of expr_primary.pcpp:
  parent in an object with no parent (SM0012)

  How to check, from repo\bin:
    pcpp res\tests\expr_primary_err_parent_none.pcpp
    pcpp res\tests\expr_primary_err_parent_none.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_primary_err_parent_none;

type
  TBase = object
    N: int32;
    method Get(): int32;
    begin
      return parent.N; // ERROR SM0012@14: parent: 'TBase' has no parent type
    end;
  end;

begin
end.
