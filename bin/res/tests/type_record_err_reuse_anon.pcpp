-------------------------------------------------------------------------------
  type_record_err_reuse_anon.pcpp - break step of type_record.pcpp:
  a field of an anonymous overlay reuses a grandparent's field name (SM0309)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_reuse_anon.pcpp
    pcpp res\tests\type_record_err_reuse_anon.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_reuse_anon;

type
  TBase = record
    A: int32;
  end;
  TMid = record(TBase)
    B: int32;
  end;
  TR = record(TMid)
    overlay
      A: int32; // ERROR SM0309@7: 'A' reuses a name of the parent chain
      F: float32;
    end;
  end;

begin
end.
