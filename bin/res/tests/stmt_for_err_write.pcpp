-------------------------------------------------------------------------------
  stmt_for_err_write.pcpp - break step of stmt_for.pcpp:
  the body writes the iterator (SM0602)

  How to check, from repo\bin:
    pcpp res\tests\stmt_for_err_write.pcpp
    pcpp res\tests\stmt_for_err_write.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_for_err_write;

var
  LI: int32;

begin
  for LI := 1 to 3 do
    LI := 5; // ERROR SM0602@5: the loop body cannot write it
  end;
end.
