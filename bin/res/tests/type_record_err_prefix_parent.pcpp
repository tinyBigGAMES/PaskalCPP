-------------------------------------------------------------------------------
  type_record_err_prefix_parent.pcpp - break step of type_record.pcpp:
  record packed (TBase): the prefixes are (parent), packed, align(...), in that order (PR0032)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_prefix_parent.pcpp
    pcpp res\tests\type_record_err_prefix_parent.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_prefix_parent;

type
  TBase = record
    A: int32;
  end;
  TR = record packed (TBase) // ERROR PR0032@22: '(' is out of order
    B: int32;
  end;

begin
end.
