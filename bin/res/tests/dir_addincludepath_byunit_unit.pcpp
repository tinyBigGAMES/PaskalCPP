  dir_addincludepath_byunit_unit.pcpp - a unit dir_addincludepath_byunit.pcpp
  imports; its @addincludepath adds res\tests\libs to the one build, and it
  includes dir_addincludepath.h in its own translation unit.

  Nothing to check here: dir_addincludepath_byunit.pcpp checks it.
*******************************************************************************/

module unit dir_addincludepath_byunit_unit;
@addincludepath "$P:res/tests/libs";

#include "dir_addincludepath.h"

exported routine FromUnit(): int32;
begin
  return cpp("dir_addincludepath_value() + 1");
end;

end.
