  type_object_err_hidden_record.pcpp - break step of type_object.pcpp:
  hidden in a record: only an object's members are hidden (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_hidden_record.pcpp
    pcpp res\tests\type_object_err_hidden_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_hidden_record;

type
  TR = record
    hidden N: int32; // ERROR PR0034@5: 'hidden' is not allowed in a record
  end;

begin
end.
