module exe decl_external_err_lib_const;

const
  CNotText: int32 = 7;

routine clink lib_plain_add(AA: int32; AB: int32): int32;
  external CNotText; // ERROR SM0326@12

begin
  println("{}", lib_plain_add(2, 3));
end.
