-------------------------------------------------------------------------------
  lex_integers_err_signed_l.pcpp - break step of lex_integers.pcpp:
  the same with the signed suffix l (LX0006; L, ll and LL are the same rows)

  How to check, from repo\bin:
    pcpp res\tests\lex_integers_err_signed_l.pcpp
    pcpp res\tests\lex_integers_err_signed_l.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_integers_err_signed_l;

var
  LN: int64;

begin
  LN := 0;
  LN := 9223372036854775808l; // ERROR LX0006@9: write 9223372036854775808ul
end.
