-------------------------------------------------------------------------------
  type_object_virtual_err_final_not_virtual.pcpp - break step of type_object_virtual.pcpp:
  final on a plain method: final closes a virtual one (SM0336)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_final_not_virtual.pcpp
    pcpp res\tests\type_object_virtual_err_final_not_virtual.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_final_not_virtual;

type
  TA = object
    final method M(); // ERROR SM0336@5: 'final' closes a virtual method
    begin
    end;
  end;

begin
end.
