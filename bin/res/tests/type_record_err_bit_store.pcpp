-------------------------------------------------------------------------------
  type_record_err_bit_store.pcpp - break step of type_record.pcpp:
  a constant stored into a bitfield is held by its width: int32 : 3 holds -4 .. 3 (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_bit_store.pcpp
    pcpp res\tests\type_record_err_bit_store.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_bit_store;

type
  TR = record
    B: int32 : 3;
    U: uint8 : 2;
  end;

var
  LR: TR;

begin
  LR.B := 100; // ERROR SM0200@11: 100 does not fit in 'int32 : 3' (-4..3)
end.
