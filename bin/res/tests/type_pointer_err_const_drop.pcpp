-------------------------------------------------------------------------------
  type_pointer_err_const_drop.pcpp - break step of type_pointer.pcpp:
  nor does a ptr to const become a ptr to T: no cast drops const (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_const_drop.pcpp
    pcpp res\tests\type_pointer_err_const_drop.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_const_drop;

var
  LP: ptr to int32;
  LC: ptr to const int32;

begin
  LC := nil;
  LP := LC; // ERROR SM0200@9: 'ptr to const int32' does not convert implicitly to 'ptr to int32'
end.
