  dll_dotted.Core.pcpp - Build kind: a PaskalCPP dll with a dotted name (dep)

  The whole dotted name is the library's: dll_dotted.Core.dll (import library
  dll_dotted.Core.lib) on Windows, libdll_dotted.Core.so on Linux. dll_dotted
  links it by that name.
*******************************************************************************/

module dll dll_dotted.Core;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink dll_dotted_twice(AN: int32): int32;
begin
  return AN * 2;
end;

end.
