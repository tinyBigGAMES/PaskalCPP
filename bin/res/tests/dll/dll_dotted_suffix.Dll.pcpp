-------------------------------------------------------------------------------
  dll_dotted_suffix.Dll.pcpp - Build kind: a PaskalCPP dll whose dotted name
  ends in a library file's suffix (dep)

  The whole dotted name is the library's, its last part Dll included (a part
  spelled dll is the module-kind keyword, never a name part):
  dll_dotted_suffix.Dll.dll (import library dll_dotted_suffix.Dll.lib) on
  Windows, libdll_dotted_suffix.Dll.so on Linux. dll_dotted_suffix links it
  by that name.
*******************************************************************************/

module dll dll_dotted_suffix.Dll;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink dll_dotted_suffix_twice(AN: int32): int32;
begin
  return AN * 2;
end;

end.
