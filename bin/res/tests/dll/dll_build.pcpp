-------------------------------------------------------------------------------
  dll_build.pcpp - Build kind: an exe that links a PaskalCPP dll

  module dll builds a shared library (BNF.md sec 1). This exe links its dep
  dll_build_dll at build time (@linklibrary, from the folder its build put
  it in: the import library on Windows, the .so on Linux), declares its
  routine external, and @copydll puts the library beside the exe so it is
  found at run time. Two [Heap] lines: the program's and the debug dll's
  own.
*******************************************************************************/

module exe dll_build;

/*
  @@test
    kind run
    deps dll_build_dll
    expect
    | twice 42
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@ifdef TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:output/bin";
@copydll "$P:output/bin/libdll_build_dll.so";
@else
@addlibrarypath "$P:output/lib";
@copydll "$P:output/bin/dll_build_dll.dll";
@endif
@linklibrary "dll_build_dll";

routine clink dll_build_twice(AN: int32): int32; external;

begin
  println("twice {}", dll_build_twice(21));
end.
