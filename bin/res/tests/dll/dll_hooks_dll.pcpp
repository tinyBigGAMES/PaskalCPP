  dll_hooks_dll.pcpp - Build kind: a dll with initialize / finalize (dep)

  The dll dll_hooks links: its initialize runs when the library is loaded,
  its finalize when it is unloaded.
*******************************************************************************/

module dll dll_hooks_dll;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink dll_hooks_value(): int32;
begin
  return 7;
end;

initialize
begin
  println("dll initialize");
end;

finalize
begin
  println("dll finalize");
end;

end.
