  dll_build_dll.pcpp - Build kind: a PaskalCPP dll (dep)

  The dll dll_build links: one exported clink routine. Its build puts the
  shared library in output\bin (with its import library in output\lib on
  Windows), where dll_build looks for it.
*******************************************************************************/

module dll dll_build_dll;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink dll_build_twice(AN: int32): int32;
begin
  return AN * 2;
end;

end.
