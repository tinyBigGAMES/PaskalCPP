-------------------------------------------------------------------------------
  dll_raise.pcpp - Build kind: a raise that leaves a dll

  A raise inside the dep dll_raise_dll, not guarded there, reaches the
  program's guard across the library boundary.
*******************************************************************************/

module exe dll_raise;

/*
  @@test
    kind run
    deps dll_raise_dll
    expect
    | caught: raised inside the dll
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@ifdef TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:output/bin";
@copydll "$P:output/bin/libdll_raise_dll.so";
@else
@addlibrarypath "$P:output/lib";
@copydll "$P:output/bin/dll_raise_dll.dll";
@endif
@linklibrary "dll_raise_dll";

routine clink dll_raise_fail(); external;

begin
  guard
    dll_raise_fail();
  except
    println("caught: {}", excmsg());
  end;
end.
