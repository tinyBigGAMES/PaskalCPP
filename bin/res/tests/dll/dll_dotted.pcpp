-------------------------------------------------------------------------------
  dll_dotted.pcpp - Build kind: an exe that links a dll with a dotted name

  Links its dep dll_dotted.Core by its whole dotted name (@linklibrary: the
  import library on Windows, libdll_dotted.Core.so found by DoFindLinkFile
  on Linux) and copies it beside the exe: no part of the name is taken for
  an extension. Two [Heap] lines: the program's and the debug dll's own.
*******************************************************************************/

module exe dll_dotted;

/*
  @@test
    kind run
    deps dll_dotted.Core
    expect
    | twice 42
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@ifdef TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:output/bin";
@copydll "$P:output/bin/libdll_dotted.Core.so";
@else
@addlibrarypath "$P:output/lib";
@copydll "$P:output/bin/dll_dotted.Core.dll";
@endif
@linklibrary "dll_dotted.Core";

routine clink dll_dotted_twice(AN: int32): int32; external;

begin
  println("twice {}", dll_dotted_twice(21));
end.
