-------------------------------------------------------------------------------
  expr_bitwise.pcpp - Expression compliance: bitwise operators

  shl shr << >> | & xor ~ on integers (BNF.md sec 6). | and & sit with + and
  * (Pascal placement), so FLAG_A | FLAG_B = LMask means (FLAG_A | FLAG_B) =
  LMask; ^ is the deref, never xor. A constant shift count lies in
  0 .. bits - 1. The symbols take integers only (and / or / not are the
  logical words, xor takes two bools too), and their result is a number:
  a bool from it is written with a comparison. xor of two bools is
  logical and its result a bool.

  How to check, from repo\bin:
    pcpp res\tests\expr_bitwise.pcpp -r
    pcpp res\tests\expr_bitwise.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    shifts 16 64 8 4
    or and xor 7 2 6
    xor bools true false
    not -6
    placement true
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_bitwise_err_float.pcpp
      a float64 shifted (SM0250)
    expr_bitwise_err_shift_count.pcpp
      a constant shift count of 32 on an int32 (SM0259)
    expr_bitwise_err_cpp_word.pcpp
      the C++ word operator compl (PR0040)
    expr_bitwise_err_into_bool.pcpp
      the int32 result of & stored into a bool (SM0200)
    expr_bitwise_err_bool_and.pcpp
      & on two bools (SM0250)
*******************************************************************************/

module exe expr_bitwise;

var
  LA: int32 = 1;
  LB: int32 = 2;
  LN: int32 = 5;
  LT: bool = true;
  LF: bool = false;

begin
  println("shifts {} {} {} {}", 1 shl 4, 256 shr 2, 1 << 3, 16 >> 2);
  println("or and xor {} {} {}", 6 | 1, 6 & 3, 5 xor 3);
  println("xor bools {} {}", LT xor LF, LT xor LT);
  println("not {}", ~LN);
  println("placement {}", LA | LB = 3);
end.
