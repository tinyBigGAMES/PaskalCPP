-------------------------------------------------------------------------------
  cpp_expression_err_line_break.pcpp - break step of cpp_expression.pcpp:
  a line break in a plain cpp("...") (PR0046)

  How to check, from repo\bin:
    pcpp res\tests\cpp_expression_err_line_break.pcpp
    pcpp res\tests\cpp_expression_err_line_break.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe cpp_expression_err_line_break;

var
  LN: int32;

begin
  LN := cpp("1\n+ 2"); // ERROR PR0046@13: use a raw string
end.
