-------------------------------------------------------------------------------
  std_raylib_ext_noicon.pcpp - std compliance: raylib_ext's window icon,
  the build with no @exeicon

  `import raylib_ext;` gives a raylib window the program's icon with no call
  of the program's (std_raylib_ext.pcpp checks it, built with @exeicon).
  This program has no @exeicon: its hidden window keeps the platform's
  default, no icon set. Windows: WM_GETICON gives none, big or small;
  Linux: the window has no _NET_WM_ICON property.

  How to check, from repo\bin, on each target:
    pcpp res\tests\std_raylib_ext_noicon.pcpp -r -t x86_64-windows-gnu
    pcpp res\tests\std_raylib_ext_noicon.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  The build output shows no warning on either target.
  EXPECT windows:
    ok window
    ok no big icon
    ok no small icon
    done 0
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXPECT linux:
    ok window
    ok x11 loaded
    ok no net_wm_icon
    done 0
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
*******************************************************************************/

module exe std_raylib_ext_noicon;

import
  raylib,
  raylib_ext;

// The window's icon as the window manager sees it, read with no windows.h /
// Xlib.h (their names collide with raylib's): Windows WM_GETICON of AWhich
// (1 big, 0 small); Linux whether _NET_WM_ICON is set
@ifdef TARGET_X86_64_WINDOWS_GNU
#include <cstdint>
extern "C" __declspec(dllimport) intptr_t __stdcall SendMessageW(void* AWindow, unsigned int AMessage,
  uintptr_t AW, intptr_t AL);

static bool std_raylib_ext_noicon_set(const int AWhich)
{
  return SendMessageW(GetWindowHandle(), 0x007F, static_cast<uintptr_t>(AWhich), 0) != 0;
}
@else
#include <dlfcn.h>
extern "C" void* glfwGetCurrentContext(void);
extern "C" void* glfwGetX11Display(void);
extern "C" unsigned long glfwGetX11Window(void* AWindow);

static bool std_raylib_ext_noicon_set(const int)
{
  using TInternAtom = unsigned long (*)(void*, const char*, int);
  using TGetProperty = int (*)(void*, unsigned long, unsigned long, long, long, int, unsigned long,
    unsigned long*, int*, unsigned long*, unsigned long*, unsigned char**);
  using TFree = int (*)(void*);
  void* LX11 = dlopen("libX11.so.6", RTLD_NOW | RTLD_NOLOAD);
  bool LSet = false;

  if (LX11 == nullptr)
    return false;
  const auto LIntern = reinterpret_cast<TInternAtom>(dlsym(LX11, "XInternAtom"));
  const auto LGet = reinterpret_cast<TGetProperty>(dlsym(LX11, "XGetWindowProperty"));
  const auto LFree = reinterpret_cast<TFree>(dlsym(LX11, "XFree"));
  void* LDisplay = glfwGetX11Display();
  void* LContext = glfwGetCurrentContext();
  if ((LIntern != nullptr) && (LGet != nullptr) && (LFree != nullptr) && (LDisplay != nullptr) &&
    (LContext != nullptr))
  {
    unsigned long LType = 0;
    int LFormat = 0;
    unsigned long LCount = 0;
    unsigned long LAfter = 0;
    unsigned char* LData = nullptr;
    if ((LGet(LDisplay, glfwGetX11Window(LContext), LIntern(LDisplay, "_NET_WM_ICON", 0), 0, 2, 0, 0,
      &LType, &LFormat, &LCount, &LAfter, &LData) == 0) && (LData != nullptr))
    {
      LSet = LCount > 0;
      LFree(LData);
    }
  }
  dlclose(LX11);
  return LSet;
}

// libX11 is loaded (GLFW dlopens it): the Linux check would pass on a
// window it could not read without this
static bool std_raylib_ext_noicon_x11()
{
  void* LX11 = dlopen("libX11.so.6", RTLD_NOW | RTLD_NOLOAD);

  if (LX11 == nullptr)
    return false;
  dlclose(LX11);
  return true;
}
@endif

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

begin
  GFails := 0;
  SetTraceLogLevel(LOG_NONE);
  SetConfigFlags(FLAG_WINDOW_HIDDEN);
  InitWindow(64, 64, "std_raylib_ext_noicon");
  Check("window", IsWindowReady());
  if IsWindowReady() then
@ifdef TARGET_X86_64_WINDOWS_GNU
    Check("no big icon", not std_raylib_ext_noicon_set(1));
    Check("no small icon", not std_raylib_ext_noicon_set(0));
@else
    Check("x11 loaded", std_raylib_ext_noicon_x11());
    Check("no net_wm_icon", not std_raylib_ext_noicon_set(0));
@endif
    CloseWindow();
  end;
  println("done {}", GFails);
end.
