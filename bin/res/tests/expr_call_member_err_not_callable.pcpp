  expr_call_member_err_not_callable.pcpp - break step of expr_call_member.pcpp:
  an int32 variable called (SM0400)

  How to check, from repo\bin:
    pcpp res\tests\expr_call_member_err_not_callable.pcpp
    pcpp res\tests\expr_call_member_err_not_callable.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_call_member_err_not_callable;

var
  LN: int32;
  LM: int32;

begin
  LM := 1;
  LN := LM(1); // ERROR SM0400@9: 'LM' is not callable
end.
