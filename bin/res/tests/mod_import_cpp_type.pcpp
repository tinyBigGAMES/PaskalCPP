-------------------------------------------------------------------------------
  mod_import_cpp_type.pcpp - Module compliance: a C type spelled as the
  imported unit that declares it (stb_vorbis's `stb_vorbis` type). A unit's
  name is a unit only before '.'; in a type position the name is the C/C++
  type, as a value or as a pointer target. mod_import_cpp_type_u.pcpp beside
  it is the unit: nothing to check there.

  How to check, from repo\bin:
    pcpp res\tests\mod_import_cpp_type.pcpp -r
    pcpp res\tests\mod_import_cpp_type.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    value 5
    through a pointer 7
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
*******************************************************************************/

module exe mod_import_cpp_type;

import
  mod_import_cpp_type_u;

var
  LValue: mod_import_cpp_type_u;
  LPtr: ptr to mod_import_cpp_type_u;

begin
  LValue.count := 5;
  println("value {}", LValue.count);
  LPtr := address of LValue;
  LPtr^.count := 7;
  println("through a pointer {}", LValue.count);
end.
