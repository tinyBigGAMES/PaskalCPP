-------------------------------------------------------------------------------
  dir_verinfo_err_lib.pcpp - break step of dir_verinfo.pcpp: @addverinfo on
  in a lib (a static library takes no resources: a warning, not used; the
  @vimajor after it is not reported a second time)

  How to check, from repo\bin:
    pcpp res\tests\dir_verinfo_err_lib.pcpp
    pcpp res\tests\dir_verinfo_err_lib.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module lib dir_verinfo_err_lib;
@addverinfo on; // WARN SM0103@1: does not apply to
@vimajor 1;

end.
