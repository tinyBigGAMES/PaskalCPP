  mod_import_err_cycle.pcpp - break step of mod_import.pcpp: an import cycle.
  This exe imports mod_import_err_cycle_a.pcpp, which imports
  mod_import_err_cycle_b.pcpp, which imports mod_import_err_cycle_a again.

  How to check, from repo\bin:
    pcpp res\tests\mod_import_err_cycle.pcpp
    pcpp res\tests\mod_import_err_cycle.pcpp -t x86_64-linux-gnu
  The marked line in mod_import_err_cycle_b.pcpp reports that code; nothing
  else is reported.
*******************************************************************************/

module exe mod_import_err_cycle;
import mod_import_err_cycle_a;

begin
end.
