-------------------------------------------------------------------------------
  stmt_match_err_label_reversed.pcpp - break step of stmt_match.pcpp:
  a range label whose low bound exceeds its high bound (SM0267)

  How to check, from repo\bin:
    pcpp res\tests\stmt_match_err_label_reversed.pcpp
    pcpp res\tests\stmt_match_err_label_reversed.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_match_err_label_reversed;

var
  LN: int32;

begin
  LN := 1;
  match LN of
    1: println("a");
    5..2: println("b"); // ERROR SM0267@5: low bound 5 exceeds high bound 2
  end;
end.
