-------------------------------------------------------------------------------
  type_overlay_err_record_overlay.pcpp - break step of type_overlay.pcpp:
  a record's anonymous overlay is an overlay too: its fields hold no string (SM0313)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_record_overlay.pcpp
    pcpp res\tests\type_overlay_err_record_overlay.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_record_overlay;

type
  TR = record
    K: int32;
    overlay
      I: int64;
      S: string; // ERROR SM0313@7: cannot share an overlay's storage
    end;
  end;

begin
end.
