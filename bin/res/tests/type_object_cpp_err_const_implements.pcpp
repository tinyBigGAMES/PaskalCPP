-------------------------------------------------------------------------------
  type_object_cpp_err_const_implements.pcpp - break step of type_object_cpp.pcpp:
  a method implementing an interface's const method without const (SM0389)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_const_implements.pcpp
    pcpp res\tests\type_object_cpp_err_const_implements.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_const_implements;

type
  IMeasure = interface
    const method Size(): int32;
  end;
  TRuler = object implements IMeasure
    virtual method Size(): int32; // ERROR SM0389
    begin
      return 1;
    end;
  end;

begin
end.
