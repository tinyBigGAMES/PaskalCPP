-------------------------------------------------------------------------------
  type_record_packed_err_dynarray.pcpp - break step of type_record_packed.pcpp:
  a dynamic array field in a packed record (SM0331)

  How to check, from repo\bin:
    pcpp res\tests\type_record_packed_err_dynarray.pcpp
    pcpp res\tests\type_record_packed_err_dynarray.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_packed_err_dynarray;

type
  TP = record packed
    C: int8;
    D: array of int32; // ERROR SM0331@5: holds a string or dynamic array
  end;

begin
end.
