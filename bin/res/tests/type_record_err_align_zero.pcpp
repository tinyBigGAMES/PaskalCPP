-------------------------------------------------------------------------------
  type_record_err_align_zero.pcpp - break step of type_record.pcpp:
  align(0): 0 is no power of two (SM0310)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_align_zero.pcpp
    pcpp res\tests\type_record_err_align_zero.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_align_zero;

type
  TR = record align(0) // ERROR SM0310@21: align 0 is not a power of two
    B: int32;
  end;

begin
end.
