-------------------------------------------------------------------------------
  type_overlay_err_nested_record.pcpp - break step of type_overlay.pcpp:
  an anonymous record goes inside an overlay, not inside an anonymous record (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_nested_record.pcpp
    pcpp res\tests\type_overlay_err_nested_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_nested_record;

type
  TV = overlay
    A: int32;
    record
      B: int32;
      record // ERROR PR0034@7: 'record' is not allowed in an anonymous record
        C: int32;
      end;
    end;
  end;

begin
end.
