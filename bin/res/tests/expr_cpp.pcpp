-------------------------------------------------------------------------------
  expr_cpp.pcpp - Expression compliance: C++ in expressions

  C++ names (qualified, with template arguments), new / delete, nullptr,
  this, sizeof and the other opaque groups, braced init and lambdas, written
  in a PaskalCPP expression as in C++ (BNF.md sec 6 cpp name, cpp special,
  opaque group, braced init, cpp lambda). Template arguments after a
  qualified name are taken unless an operand follows the >; the one token <>
  is an empty list only before ( { :: > , ) ; ]. [ ... ] is a lambda when (
  or { follows its ], else a set literal. A C++ mistake is clang's.

  How to check, from repo\bin:
    pcpp res\tests\expr_cpp.pcpp -r
    pcpp res\tests\expr_cpp.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    qualified 9
    variable template true
    empty list true
    new 5
    nullptr true
    sizeof 8
    braced 3 1
    lambda 42
    lambda call 5
    set literal true
    this 2
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_cpp_err_sizeof_open.pcpp
      an unclosed sizeof( group (PR0063)
    expr_cpp_err_lambda_open.pcpp
      an unclosed lambda body (PR0063)
    expr_cpp_err_lambda_body.pcpp
      a lambda with no { } body (PR0044)
    expr_cpp_err_sizeof_parens.pcpp
      sizeof without parentheses (PR0045)
    expr_cpp_err_cast_open.pcpp
      a named cast's < > not closed (PR0031)
    expr_cpp_err_new_primitive.pcpp
      new of a PaskalCPP type (PR0027)
    expr_cpp_err_clang.pcpp
      a C++ call no overload takes: clang reports it (ZB0016)
*******************************************************************************/

module exe expr_cpp;

#include <algorithm>
#include <functional>
#include <numbers>
#include <string>
#include <vector>

type
  TCounter = object
    N: int32;
    method Bump(): int32;
    begin
      return this->N + 1;
    end;
  end;

var
  LV: std::vector<int>;
  LP: int*;
  LF: std::function<int(int)>;
  LK: TCounter;

begin
  println("qualified {}", std::max<int>(3, 9));
  println("variable template {}", std::numbers::pi_v<float64> > 3.0);
  println("empty list {}", std::less<>()(1, 2));
  LP := new int(5);
  println("new {}", *LP);
  delete LP;
  LP := nullptr;
  println("nullptr {}", LP = nullptr);
  println("sizeof {}", sizeof(double));
  LV.push_back(3);
  LV.insert(LV.begin(), {1, 2});
  println("braced {} {}", LV.size(), LV[0]);
  LF := [](int a) { return a * 2; };
  println("lambda {}", LF(21));
  println("lambda call {}", [](int a, int b) { return a + b; }(2, 3));
  println("set literal {}", 2 in [1, 2, 3]);
  LK.N := 1;
  println("this {}", LK.Bump());
end.
