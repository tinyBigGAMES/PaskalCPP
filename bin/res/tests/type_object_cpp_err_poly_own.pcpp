-------------------------------------------------------------------------------
  type_object_cpp_err_poly_own.pcpp - break step of type_object_cpp.pcpp:
  an own of an ancestor whose C++ base has no virtual method (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_poly_own.pcpp
    pcpp res\tests\type_object_cpp_err_poly_own.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_poly_own;

struct CPlain {
  int tag = 5;
};

type
  TA = object(CPlain)
    N: int32;
  end;
  TB = object(TA)
    M: int32;
  end;

var
  LO: own TA;
begin
  LO := own TB; // ERROR SM0200
  println("{}", LO.N);
end.
