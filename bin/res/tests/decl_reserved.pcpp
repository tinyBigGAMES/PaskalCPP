  decl_reserved.pcpp - Declaration compliance: reserved names (PLAN-RECORDS M11)

  Names starting with pcpp_ belong to the compiler (the C++ it writes uses
  them), so no PaskalCPP declaration may take one: module, const, type,
  field, choice value, variable, routine, parameter, local (the break
  steps). The rule is case-sensitive, as C++ names are: Pcpp_G is free. A
  name in mixed C++ (struct pcpp_cthing) is C++'s and clang's to judge.

  How to check, from repo\bin:
    pcpp res\tests\decl_reserved.pcpp -r
    pcpp res\tests\decl_reserved.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    1 2 3
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    decl_reserved_err_const.pcpp
      a const named pcpp_k (SM0017)
    decl_reserved_err_type.pcpp
      a type named pcpp_t (SM0017)
    decl_reserved_err_field.pcpp
      a record field named pcpp_f (SM0017)
    decl_reserved_err_choice.pcpp
      a choice value named pcpp_c (SM0017)
    decl_reserved_err_var.pcpp
      a variable named pcpp_v (SM0017)
    decl_reserved_err_routine.pcpp
      a routine named pcpp_r (SM0017)
    decl_reserved_err_param.pcpp
      a parameter named pcpp_p (SM0017)
    decl_reserved_err_local.pcpp
      a local variable named pcpp_l (SM0017)
*******************************************************************************/

module exe decl_reserved;

struct pcpp_cthing { int v; };

type
  TOk = record
    Pcpp_Field: int32;
  end;

var
  Pcpp_G: int32;
  LC: pcpp_cthing;
  LR: TOk;

begin
  Pcpp_G := 1;
  LC.v := 2;
  LR.Pcpp_Field := 3;
  println("{} {} {}", Pcpp_G, LC.v, LR.Pcpp_Field);
end.
