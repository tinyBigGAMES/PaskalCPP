-------------------------------------------------------------------------------
  lex_strings_err_delimiter.pcpp - break step of lex_strings.pcpp:
  a raw string delimiter longer than 16 characters (LX0010)

  How to check, from repo\bin:
    pcpp res\tests\lex_strings_err_delimiter.pcpp
    pcpp res\tests\lex_strings_err_delimiter.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_strings_err_delimiter;

begin
  println(R"abcdefghijklmnopq(x)abcdefghijklmnopq"); // ERROR LX0010@11: Invalid raw string delimiter
end.
