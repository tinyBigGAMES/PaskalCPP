-------------------------------------------------------------------------------
  intr_shadow_err_type_arg.pcpp - break step of intr_shadow.pcpp:
  a routine named size called with a type (SM0411)

  How to check, from repo\bin:
    pcpp res\tests\intr_shadow_err_type_arg.pcpp
    pcpp res\tests\intr_shadow_err_type_arg.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_shadow_err_type_arg;

routine size(AN: int32): int32;
begin
  return AN;
end;

var
  LN: int32;

begin
  LN := size(int32); // ERROR SM0411@14: 'size' takes no type argument
end.
