-------------------------------------------------------------------------------
  type_pointer_err_deref_value.pcpp - break step of type_pointer.pcpp:
  ^ reads through a pointer: an int32 is none (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_deref_value.pcpp
    pcpp res\tests\type_pointer_err_deref_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_deref_value;

var
  LV: int32;
  LX: int32;

begin
  LX := LV^; // ERROR SM0250@9: operator '^' does not take 'int32'
end.
