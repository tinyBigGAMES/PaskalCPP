-------------------------------------------------------------------------------
  expr_arithmetic_err_into_narrow.pcpp - break step of expr_arithmetic.pcpp:
  the int32 sum of two int8 values stored into an int8 (SM0200): the sum
  is computed in int32 and may not fit; write int8(LA + LB)

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_into_narrow.pcpp
    pcpp res\tests\expr_arithmetic_err_into_narrow.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_into_narrow;

var
  LA: int8 = 1;
  LB: int8 = 2;
  LN: int8;

begin
  LN := LA + LB; // ERROR SM0200@9: 'int32' does not convert implicitly to 'int8'
end.
