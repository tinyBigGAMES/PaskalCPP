-------------------------------------------------------------------------------
  expr_record_literal_err_cpp_parent.pcpp - break step of expr_record_literal.pcpp:
  a record literal of a record with a C++ parent (SM0413)

  How to check, from repo\bin:
    pcpp res\tests\expr_record_literal_err_cpp_parent.pcpp
    pcpp res\tests\expr_record_literal_err_cpp_parent.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_record_literal_err_cpp_parent;

struct CPoint {
  int x;
};

type
  TC = record(CPoint)
    Y: int32;
  end;

var
  LC: TC;

begin
  LC := TC(Y: 1); // ERROR SM0413@9: 'TC' is not one
end.
