-------------------------------------------------------------------------------
  type_object_copy_err_slice_copy_as.pcpp - break step of type_object_copy.pcpp:
  the object an as gives copied by value: it may be a descendant of the target (SM0428)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_slice_copy_as.pcpp
    pcpp res\tests\type_object_copy_err_slice_copy_as.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_slice_copy_as;

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
  end;
  TB = object(TA)
  end;

routine Keep(var AA: TA);
var
  LB: TB;
begin
  LB := AA as TB; // ERROR SM0428@9: 'AA as TB' may hold a descendant of 'TB' (it is polymorphic): a copy keeps only its 'TB' part
end;

begin
end.
