-------------------------------------------------------------------------------
  type_record_err_bit_store_unsigned.pcpp - break step of type_record.pcpp:
  uint8 : 2 holds 0 .. 3 (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_bit_store_unsigned.pcpp
    pcpp res\tests\type_record_err_bit_store_unsigned.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_bit_store_unsigned;

type
  TR = record
    B: int32 : 3;
    U: uint8 : 2;
  end;

var
  LR: TR;

begin
  LR.U := 5; // ERROR SM0200@11: 5 does not fit in 'uint8 : 2' (0..3)
end.
