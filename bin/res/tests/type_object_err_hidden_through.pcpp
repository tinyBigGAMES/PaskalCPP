-------------------------------------------------------------------------------
  type_object_err_hidden_through.pcpp - break step of type_object.pcpp:
  a descendant reads a hidden field through a value of the parent type: only self, parent. or its own type reach it (SM0019)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_hidden_through.pcpp
    pcpp res\tests\type_object_err_hidden_through.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_hidden_through;

type
  TA = object
    hidden N: int32;
  end;
  TB = object(TA)
    method Peek(const AA: TA): int32;
    begin
      return AA.N; // ERROR SM0019@17: 'N' is hidden in 'TA': a method of 'TB' reaches it only through self or a 'TB' value
    end;
  end;

begin
end.
