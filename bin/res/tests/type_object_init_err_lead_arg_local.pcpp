-------------------------------------------------------------------------------
  type_object_init_err_lead_arg_local.pcpp - break step of type_object_init.pcpp:
  parent.init(...) given a local of the init: it runs before the locals exist (SM0346)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_lead_arg_local.pcpp
    pcpp res\tests\type_object_init_err_lead_arg_local.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_lead_arg_local;

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;
  TB = object(TA)
    init();
    var
      LN: int32;
    begin
      parent.init(LN); // ERROR SM0346@19: 'LN' does not exist yet
    end;
  end;

begin
end.
