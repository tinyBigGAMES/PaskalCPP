-------------------------------------------------------------------------------
  type_object_copy_err_copy_parent.pcpp - break step of type_object_copy.pcpp:
  a copy whose parent cannot be copied: the parent part is copied by the parent's copy (SM0355)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_copy_parent.pcpp
    pcpp res\tests\type_object_copy_err_copy_parent.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_copy_parent;

type
  TRes = object
    Id: int32;
    done;
    begin
    end;
  end;
  TKid = object(TRes) // ERROR SM0355@17: 'TKid' cannot copy its parent part: 'TRes' cannot be copied
    copy(const ASource: TKid);
    begin
    end;
  end;

begin
end.
