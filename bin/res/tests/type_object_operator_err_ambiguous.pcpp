-------------------------------------------------------------------------------
  type_object_operator_err_ambiguous.pcpp - break step of type_object_operator.pcpp:
  operands two declared operators take alike (SM0431)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_ambiguous.pcpp
    pcpp res\tests\type_object_operator_err_ambiguous.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_ambiguous;

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: TVec; const AN: int16): TVec;
    begin
      return A;
    end;
    operator +(const A: TVec; const AN: int32): TVec;
    begin
      return A;
    end;
  end;

var
  LA: TVec;
  LN: int8;
begin
  LA := LA + LN; // ERROR SM0431
end.
