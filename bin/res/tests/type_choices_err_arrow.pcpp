-------------------------------------------------------------------------------
  type_choices_err_arrow.pcpp - break step of type_choices.pcpp:
  a type reaches its values with '.', not '->' (SM0014)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_arrow.pcpp
    pcpp res\tests\type_choices_err_arrow.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_arrow;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC := TColor->cRed; // ERROR SM0014@9: 'TColor' is a module or a type: reach its names with '.'
end.
