  intr_print_err_value.pcpp - break step of intr_print.pcpp:
  println used as a value (SM0408)

  How to check, from repo\bin:
    pcpp res\tests\intr_print_err_value.pcpp
    pcpp res\tests\intr_print_err_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_print_err_value;

var
  LN: int32;

begin
  LN := println("x"); // ERROR SM0408@9: is a statement, not a value
end.
