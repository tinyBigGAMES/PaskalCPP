  expr_casts_err_alias_args.pcpp - break step of expr_casts.pcpp:
  an alias cast with two arguments (SM0412)

  How to check, from repo\bin:
    pcpp res\tests\expr_casts_err_alias_args.pcpp
    pcpp res\tests\expr_casts_err_alias_args.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_casts_err_alias_args;

type
  TSmall = int16;

var
  LN: int32;

begin
  LN := TSmall(1, 2); // ERROR SM0412@9: takes exactly one argument, given 2
end.
