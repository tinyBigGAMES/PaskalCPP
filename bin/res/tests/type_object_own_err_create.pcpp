  type_object_own_err_create.pcpp - break step of type_object_own.pcpp:
  create on an object: own / ref build it (SM0361)

  How to check, from repo\bin:
    pcpp res\tests\type_object_own_err_create.pcpp
    pcpp res\tests\type_object_own_err_create.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_own_err_create;

type
  TPlain = object
    X: int32;
  end;

routine Use();
var
  LP: ptr to TPlain;
begin
  create(LP); // ERROR SM0361@10: create does not build an object
end;

begin
end.
