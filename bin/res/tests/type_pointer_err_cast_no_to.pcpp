-------------------------------------------------------------------------------
  type_pointer_err_cast_no_to.pcpp - break step of type_pointer.pcpp:
  a pointer cast is ptr to T(x): ptr(x) names no type (PR0001)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_cast_no_to.pcpp
    pcpp res\tests\type_pointer_err_cast_no_to.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_cast_no_to;

var
  LP: ptr to int32;
  LU: ptr;

begin
  LU := nil;
  LP := ptr(LU); // ERROR PR0001@12: found '('
end.
