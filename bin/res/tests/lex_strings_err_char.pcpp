  lex_strings_err_char.pcpp - break step of lex_strings.pcpp:
  an empty character literal (PR0054)

  How to check, from repo\bin:
    pcpp res\tests\lex_strings_err_char.pcpp
    pcpp res\tests\lex_strings_err_char.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_strings_err_char;

var
  LC: char;

begin
  LC := 'a';
  LC := ''; // ERROR PR0054@9: invalid character literal: empty character constant
end.
