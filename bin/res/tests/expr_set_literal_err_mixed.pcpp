-------------------------------------------------------------------------------
  expr_set_literal_err_mixed.pcpp - break step of expr_set_literal.pcpp:
  an int32 and a char element in one literal (SM0266)

  How to check, from repo\bin:
    pcpp res\tests\expr_set_literal_err_mixed.pcpp
    pcpp res\tests\expr_set_literal_err_mixed.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_set_literal_err_mixed;

type
  TDigits = set of 0..9;

var
  LD: TDigits;

begin
  LD := [1, 'a']; // ERROR SM0266@13: set literal elements are of different ordinal types
end.
