-------------------------------------------------------------------------------
  type_object_property_err_own_write.pcpp - break step of type_object_property.pcpp:
  a write assigns its field, never its own property (SM0374)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_err_own_write.pcpp
    pcpp res\tests\type_object_property_err_own_write.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_err_own_write;

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write(AValue)
      begin
        self.N := AValue; // ERROR SM0374@14: the write of 'N' assigns the property again, forever
      end;
  end;

begin
end.
