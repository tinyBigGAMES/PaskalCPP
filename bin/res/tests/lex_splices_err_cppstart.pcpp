-------------------------------------------------------------------------------
  lex_splices_err_cppstart.pcpp - break step of lex_splices.pcpp:
  a cppstart block whose last line ends in a splice (LX0014)

  How to check, from repo\bin:
    pcpp res\tests\lex_splices_err_cppstart.pcpp
    pcpp res\tests\lex_splices_err_cppstart.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_splices_err_cppstart;

cppstart source
int GX = 1; /* // ERROR LX0014@41 // */ \
cppend;

begin
  println("{}", 1);
end.
