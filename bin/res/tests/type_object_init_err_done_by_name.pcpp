-------------------------------------------------------------------------------
  type_object_init_err_done_by_name.pcpp - break step of type_object_init.pcpp:
  done called by name: it runs when an object ends (SM0343)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_done_by_name.pcpp
    pcpp res\tests\type_object_init_err_done_by_name.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_done_by_name;

type
  TA = object
    N: int32;
    method Reset();
    begin
      self.done(); // ERROR SM0343@12: done runs when an object ends: it is never called
    end;
  end;

begin
end.
