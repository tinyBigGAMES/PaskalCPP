-------------------------------------------------------------------------------
  type_record_ext_err_literal_field.pcpp - break step of type_record_ext.pcpp:
  a record literal on an extension names the fields of its chain only (SM0414)

  How to check, from repo\bin:
    pcpp res\tests\type_record_ext_err_literal_field.pcpp
    pcpp res\tests\type_record_ext_err_literal_field.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_ext_err_literal_field;

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

var
  LE: TExt;

begin
  LE := TExt(A: 1, C: 2); // ERROR SM0414@20
end.
