  decl_var_err_fit.pcpp - break step of decl_var.pcpp:
  a local's constant initializer that does not fit its type

  How to check, from repo\bin:
    pcpp res\tests\decl_var_err_fit.pcpp
    pcpp res\tests\decl_var_err_fit.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_var_err_fit;

routine Use(): int32;
var
  LByte: uint8 = 256; // ERROR SM0200@18
begin
  return LByte;
end;

begin
  println("{}", Use());
end.
