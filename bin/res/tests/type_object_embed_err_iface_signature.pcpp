-------------------------------------------------------------------------------
  type_object_embed_err_iface_signature.pcpp - break step of type_object_embed.pcpp:
  an embedded method whose result differs from the interface's (SM0366)

  How to check, from repo\bin:
    pcpp res\tests\type_object_embed_err_iface_signature.pcpp
    pcpp res\tests\type_object_embed_err_iface_signature.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_embed_err_iface_signature;

type
  INamed = interface
    method Name(): string;
  end;
  TA = object
    method Name(): int32;
    begin
      return 1;
    end;
  end;
  TBox = object implements INamed // ERROR SM0366@28: 'TBox.A.Name' does not implement 'INamed.Name'
    embed A: TA;
  end;

begin
end.
