-------------------------------------------------------------------------------
  type_object_copy_err_parent_init.pcpp - break step of type_object_copy.pcpp:
  parent.init(...) in a copy: the parent part is copied by the parent's copy (SM0356)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_parent_init.pcpp
    pcpp res\tests\type_object_copy_err_parent_init.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_parent_init;

type
  TA = object
    N: int32;
  end;
  TB = object(TA)
    copy(const ASource: TB);
    begin
      parent.init(); // ERROR SM0356@7: parent.init(...) is not written in a copy
    end;
  end;

begin
end.
