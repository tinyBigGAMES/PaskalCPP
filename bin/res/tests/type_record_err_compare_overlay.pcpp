-------------------------------------------------------------------------------
  type_record_err_compare_overlay.pcpp - break step of type_record.pcpp:
  an overlay has no comparison either (SM0252)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_compare_overlay.pcpp
    pcpp res\tests\type_record_err_compare_overlay.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_compare_overlay;

type
  TBits = overlay
    Whole: uint32;
    Low: uint16;
  end;

var
  LA: TBits;
  LB: TBits;

begin
  if LA <> LB then // ERROR SM0252@6: cannot compare 'TBits'
  end;
end.
