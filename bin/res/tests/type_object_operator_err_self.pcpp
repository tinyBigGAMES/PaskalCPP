  type_object_operator_err_self.pcpp - break step of type_object_operator.pcpp:
  self in an operator (it has no object) (SM0011)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_self.pcpp
    pcpp res\tests\type_object_operator_err_self.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_self;

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: TVec; const B: TVec): TVec;
    begin
      return self; // ERROR SM0011
    end;
  end;

begin
end.
