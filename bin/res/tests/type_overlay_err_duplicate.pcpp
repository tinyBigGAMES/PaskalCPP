-------------------------------------------------------------------------------
  type_overlay_err_duplicate.pcpp - break step of type_overlay.pcpp:
  an anonymous record's field reuses a name of the overlay: its fields are the overlay's own (SM0004)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_duplicate.pcpp
    pcpp res\tests\type_overlay_err_duplicate.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_duplicate;

type
  TV = overlay
    A: int32;
    record
      A: int16; // ERROR SM0004@7: 'A' is already declared in this scope
      B: int16;
    end;
  end;

begin
end.
