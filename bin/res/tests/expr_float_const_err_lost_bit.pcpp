-------------------------------------------------------------------------------
  expr_float_const_err_lost_bit.pcpp - break step of expr_float_const.pcpp:
  the constant 16777216.0 + 1.0 (= 16777217, computed in float64) stored
  into a float32 (SM0200): float32 holds 24 bits, so 16777217 does not fit;
  write float32(16777216.0 + 1.0)

  How to check, from repo\bin:
    pcpp res\tests\expr_float_const_err_lost_bit.pcpp
    pcpp res\tests\expr_float_const_err_lost_bit.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_float_const_err_lost_bit;

var
  LF: float32;

begin
  LF := 16777216.0 + 1.0; // ERROR SM0200@9: 'float64' does not convert implicitly to 'float32'
end.
