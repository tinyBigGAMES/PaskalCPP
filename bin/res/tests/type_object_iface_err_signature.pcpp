-------------------------------------------------------------------------------
  type_object_iface_err_signature.pcpp - break step of type_object_iface.pcpp:
  a method whose result differs from the interface's (SM0366)

  How to check, from repo\bin:
    pcpp res\tests\type_object_iface_err_signature.pcpp
    pcpp res\tests\type_object_iface_err_signature.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_iface_err_signature;

type
  IShape = interface
    method Area(): int32;
  end;
  TBox = object implements IShape // ERROR SM0366@28: 'TBox.Area' does not implement 'IShape.Area'
    virtual method Area(): int64;
    begin
      return 1;
    end;
  end;

begin
end.
