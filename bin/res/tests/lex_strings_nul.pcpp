-------------------------------------------------------------------------------
  lex_strings_nul.pcpp - Lexical compliance: a string literal holding \0

  A string or wstring made from a literal holds the literal's whole text,
  a \0 element included, wherever the literal becomes one: a const, a var's
  initializer, :=, a const or value parameter (of an overload set too), a
  return, + and a comparison beside a string. len counts every element
  (the literal's own len is the same, BNF sec 7). A ptr to const char is a
  C string: it ends at the \0.

  How to check, from repo\bin:
    pcpp res\tests\lex_strings_nul.pcpp -r
    pcpp res\tests\lex_strings_nul.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    literal 3
    const 3
    var init 3
    assign 3
    param const 3 value 3
    return 3
    overload 3
    concat 6
    compare true false
    wide 3
    ptr a
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.
*******************************************************************************/

module exe lex_strings_nul;

const
  KN: string = "a\0b";

var
  LV: string = "a\0b";
  LA: string;
  LW: wstring;
  LP: ptr to const char;

routine TakeConst(const AS: string): int64;
begin
  return len(AS);
end;

routine TakeValue(AS: string): int64;
begin
  return len(AS);
end;

routine Give(): string;
begin
  return "a\0b";
end;

// Two members both take the literal as a string: C++ ranks them (int32 wins)
routine Over(AS: string; AN: int32): int64;
begin
  return len(AS);
end;

routine Over(AS: string; AN: int64): int64;
begin
  return len(AS) + 100;
end;

begin
  LA := "a\0b";
  LW := L"w\0x";
  LP := "a\0b";
  println("literal {}", len("a\0b"));
  println("const {}", len(KN));
  println("var init {}", len(LV));
  println("assign {}", len(LA));
  println("param const {} value {}", TakeConst("a\0b"), TakeValue("a\0b"));
  println("return {}", len(Give()));
  println("overload {}", Over("a\0b", 1));
  println("concat {}", len(LA + "a\0b"));
  println("compare {} {}", LA = "a\0b", LA = "a");
  println("wide {}", len(LW));
  println("ptr {}", LP);
end.
