  decl_routine_err_novalue.pcpp - break step of decl_routine.pcpp:
  a procedure call used as a value: a procedure has no value

  How to check, from repo\bin:
    pcpp res\tests\decl_routine_err_novalue.pcpp
    pcpp res\tests\decl_routine_err_novalue.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_routine_err_novalue;

routine Show();
begin
  println("shown");
end;

var
  GX: int32;

begin
  GX := Show(); // ERROR SM0406@9
  println("{}", GX);
end.
