-------------------------------------------------------------------------------
  type_object_property_virtual_err_iface_hidden.pcpp - break step of type_object_property_virtual.pcpp:
  an interface property is never hidden (SM0367)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_iface_hidden.pcpp
    pcpp res\tests\type_object_property_virtual_err_iface_hidden.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_iface_hidden;

type
  IA = interface
    property A: int32 read; write;
  end;
  TBox = object implements IA // ERROR SM0367@28: an interface member is never hidden
    FA: int32;
    hidden virtual property A: int32 read FA; write FA;
  end;

begin
end.
