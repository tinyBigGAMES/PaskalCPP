-------------------------------------------------------------------------------
  type_overlay_err_anon_overlay.pcpp - break step of type_overlay.pcpp:
  an anonymous overlay goes inside an anonymous record, not straight in an overlay (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_anon_overlay.pcpp
    pcpp res\tests\type_overlay_err_anon_overlay.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_anon_overlay;

type
  TV = overlay
    A: int32;
    overlay // ERROR PR0034@5: 'overlay' is not allowed in an overlay
      B: int32;
      F: float32;
    end;
  end;

begin
end.
