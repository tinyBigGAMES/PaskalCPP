-------------------------------------------------------------------------------
  type_object_operator_err_none.pcpp - break step of type_object_operator.pcpp:
  operands no declared operator takes (SM0430)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_none.pcpp
    pcpp res\tests\type_object_operator_err_none.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_none;

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: TVec; const B: TVec): TVec;
    begin
      return A;
    end;
  end;

var
  LA: TVec;
  LB: TVec;
begin
  LB := LA + 1; // ERROR SM0430
end.
