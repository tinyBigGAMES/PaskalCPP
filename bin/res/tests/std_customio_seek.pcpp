-------------------------------------------------------------------------------
  std_customio_seek.pcpp - Std compliance: CustomIO zip entry seek efficiency

  A large deflated zip entry seeks from its access points, not from the
  start. The program builds its own fixture at run time: 32 MiB of lines of
  pseudo-random words (every 1 MB compresses about the same), deflated with
  zlib into a one-entry zip, seek.txt, written to repo\bin\output and
  removed again at the end (never committed, never left behind). It reads
  the archive through an IO of its own that counts the archive bytes each
  seek pulls in, so the cost of a seek is measured in compressed bytes,
  not in time (time is recorded in research\customio\seek.md, not checked
  here).

  A first seek to near the end inflates from 0 (the restart cost, what a
  zip stream without access points pays on every backward seek) and leaves
  the access points behind it. After that, a backward seek, 200 seeks in a
  random order and a seek from the end each pull in at most one interval of
  compressed bytes (CustomIO keeps a point about every 1 MiB of output and
  reads 16 KiB chunks: the bound is twice the interval's share of the
  archive plus two chunks), never more than restarting from 0 would, and
  every byte read equals the fixture.

  How to check, from repo\bin:
    pcpp res\tests\std_customio_seek.pcpp -r
    pcpp res\tests\std_customio_seek.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    ok seek fixture built
    ok seek zip create
    ok seek zip written
    ok seek zip close
    ok seek zip open
    ok seek source
    ok seek entry
    ok seek entry size
    ok seek restart reads
    ok seek restart pulls the whole stream
    ok seek back reads
    ok seek back within one interval
    ok seek back cheaper than restart
    ok seek random reads
    ok seek random each within one interval
    ok seek random cheaper than restart
    ok seek from end
    ok seek from end within one interval
    ok seek entry close
    ok seek source close
    ok seek archive close
    ok seek zip removed
    ok seek zip gone
    done 0
    [Heap] Allocs: 5, Frees: 5, Leaked: 0
  EXITCODE: 0
*******************************************************************************/

module exe std_customio_seek;

import
  CustomIO,
  SysUtils,
  zlib;

// The fixture, built once by SeekDoBuild: SeekDoText is the entry's text,
// SeekDoZip the archive holding it deflated as seek.txt
cpp source;

// SEEK BUILDER BEGIN (scripts\customio\seek_bench.pcpp carries a copy:
// python scripts\customio\sync_bench.py copies it, --check compares)
#include <cstdint>
#include <cstring>
#include <filesystem>
#include <string>
#include <system_error>
#include <vector>

static std::vector<std::uint8_t> SeekDoText;
static std::vector<std::uint8_t> SeekDoZip;
static std::uint64_t SeekDoState = 20261021;

static void SeekDoPut16(std::vector<std::uint8_t>& AOut, const std::uint32_t AValue)
{
  AOut.push_back(static_cast<std::uint8_t>(AValue & 0xFF));
  AOut.push_back(static_cast<std::uint8_t>((AValue >> 8) & 0xFF));
}

static void SeekDoPut32(std::vector<std::uint8_t>& AOut, const std::uint32_t AValue)
{
  SeekDoPut16(AOut, AValue & 0xFFFF);
  SeekDoPut16(AOut, AValue >> 16);
}

// The next pseudo-random number below ALimit (a 64-bit LCG, high bits)
std::int64_t SeekDoNext(const std::int64_t ALimit)
{
  SeekDoState = SeekDoState * 6364136223846793005ULL + 1442695040888963407ULL;
  return static_cast<std::int64_t>((SeekDoState >> 33) % static_cast<std::uint64_t>(ALimit));
}

// The fields the local header and the central header share
static void SeekDoHeader(std::vector<std::uint8_t>& AOut, const std::uint32_t ACrc,
  const std::uint32_t APacked, const std::uint32_t ASize, const std::string& AName)
{
  SeekDoPut16(AOut, 20);           // version needed
  SeekDoPut16(AOut, 0);            // flags
  SeekDoPut16(AOut, 8);            // deflated
  SeekDoPut16(AOut, 0);            // time
  SeekDoPut16(AOut, 0x5D55);       // date 2026-10-21
  SeekDoPut32(AOut, ACrc);
  SeekDoPut32(AOut, APacked);
  SeekDoPut32(AOut, ASize);
  SeekDoPut16(AOut, static_cast<std::uint32_t>(AName.size()));
  SeekDoPut16(AOut, 0);            // extra length
}

// ASize bytes of numbered lines of words, deflated (raw, level 6) into a
// one-entry zip; false when zlib fails
bool SeekDoBuild(const std::int64_t ASize)
{
  static const char* const CWords[] = {
    "alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf", "hotel",
    "india", "juliet", "kilo", "lima", "mike", "november", "oscar", "papa",
    "quebec", "romeo", "sierra", "tango", "uniform", "victor", "whiskey", "xray",
    "yankee", "zulu", "paskal", "stream", "seek", "point", "window", "inflate"};
  const std::string LName = "seek.txt";
  SeekDoText.clear();
  SeekDoText.reserve(static_cast<std::size_t>(ASize) + 128);
  std::int64_t LLine = 0;
  while (static_cast<std::int64_t>(SeekDoText.size()) < ASize)
  {
    const std::string LNumber = std::to_string(LLine) + ":";
    SeekDoText.insert(SeekDoText.end(), LNumber.begin(), LNumber.end());
    for (int LI = 0; LI < 8; LI++)
    {
      const char* LWord = CWords[SeekDoNext(32)];
      SeekDoText.push_back(' ');
      SeekDoText.insert(SeekDoText.end(), LWord, LWord + std::strlen(LWord));
    }
    SeekDoText.push_back('\n');
    LLine++;
  }
  SeekDoText.resize(static_cast<std::size_t>(ASize));

  z_stream LStream{};
  if (deflateInit2(&LStream, 6, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK)
    return false;
  std::vector<std::uint8_t> LPacked(deflateBound(&LStream, static_cast<uLong>(ASize)));
  LStream.next_in = SeekDoText.data();
  LStream.avail_in = static_cast<uInt>(ASize);
  LStream.next_out = LPacked.data();
  LStream.avail_out = static_cast<uInt>(LPacked.size());
  const int LResult = deflate(&LStream, Z_FINISH);
  LPacked.resize(LStream.total_out);
  deflateEnd(&LStream);
  if (LResult != Z_STREAM_END)
    return false;
  const std::uint32_t LCrc = static_cast<std::uint32_t>(
    crc32(0L, SeekDoText.data(), static_cast<uInt>(ASize)));
  const std::uint32_t LPackedSize = static_cast<std::uint32_t>(LPacked.size());
  const std::uint32_t LSize = static_cast<std::uint32_t>(ASize);

  // Local header, name, data
  SeekDoZip.clear();
  SeekDoPut32(SeekDoZip, 0x04034B50);
  SeekDoHeader(SeekDoZip, LCrc, LPackedSize, LSize, LName);
  SeekDoZip.insert(SeekDoZip.end(), LName.begin(), LName.end());
  SeekDoZip.insert(SeekDoZip.end(), LPacked.begin(), LPacked.end());
  // Central directory: one header
  const std::uint32_t LCentralAt = static_cast<std::uint32_t>(SeekDoZip.size());
  SeekDoPut32(SeekDoZip, 0x02014B50);
  SeekDoPut16(SeekDoZip, 20);      // version made by
  SeekDoHeader(SeekDoZip, LCrc, LPackedSize, LSize, LName);
  SeekDoPut16(SeekDoZip, 0);       // comment length
  SeekDoPut16(SeekDoZip, 0);       // disk
  SeekDoPut16(SeekDoZip, 0);       // internal attributes
  SeekDoPut32(SeekDoZip, 0);       // external attributes
  SeekDoPut32(SeekDoZip, 0);       // local header offset
  SeekDoZip.insert(SeekDoZip.end(), LName.begin(), LName.end());
  const std::uint32_t LCentralSize = static_cast<std::uint32_t>(SeekDoZip.size()) - LCentralAt;
  // End of central directory
  SeekDoPut32(SeekDoZip, 0x06054B50);
  SeekDoPut16(SeekDoZip, 0);
  SeekDoPut16(SeekDoZip, 0);
  SeekDoPut16(SeekDoZip, 1);
  SeekDoPut16(SeekDoZip, 1);
  SeekDoPut32(SeekDoZip, LCentralSize);
  SeekDoPut32(SeekDoZip, LCentralAt);
  SeekDoPut16(SeekDoZip, 0);
  return true;
}

void* SeekDoZipData() { return SeekDoZip.data(); }

std::int64_t SeekDoZipSize() { return static_cast<std::int64_t>(SeekDoZip.size()); }

// Whether ACount bytes at ABytes equal the text at AAt
bool SeekDoSame(const std::int64_t AAt, const void* ABytes, const std::int64_t ACount)
{
  if ((AAt < 0) || (AAt + ACount > static_cast<std::int64_t>(SeekDoText.size())))
    return false;
  return std::memcmp(SeekDoText.data() + AAt, ABytes, static_cast<std::size_t>(ACount)) == 0;
}

void SeekDoFree()
{
  std::vector<std::uint8_t>().swap(SeekDoText);
  std::vector<std::uint8_t>().swap(SeekDoZip);
}

// Removes the archive file the program wrote (APath already resolved);
// true when it was there and is gone. The UTF-8 path goes in as char8_t,
// never through the ANSI code page (SysUtils' rule)
bool SeekDoRemove(const std::string& APath)
{
  std::error_code LError;
  if (APath.empty())
    return false;
  const std::filesystem::path LPath(std::u8string(APath.begin(), APath.end()));
  const bool LRemoved = std::filesystem::remove(LPath, LError);
  return LRemoved && !LError;
}
// SEEK BUILDER END

const
  // The entry's size: 32 intervals
  CSize: int64 = 33554432;
  // CustomIO's access-point interval (output bytes) and read chunk
  CSpan: int64 = 1048576;
  CChunk: int64 = 16384;
  // Bytes read after each seek
  CRead: int64 = 64;
  CSeeks: int32 = 200;

type
  // An IO over another IO that counts the bytes read through it
  CountData = record
    Inner: IO;
    Bytes: int64;
  end;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine CountRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64; var AState: IOState): int64;
var
  LCount: ptr to CountData;
  LGot: int64;
begin
  LCount := ptr to CountData(AUserData);
  LGot := IORead(LCount->Inner, ABuffer, ASize);
  LCount->Bytes := LCount->Bytes + LGot;
  if LGot < ASize then
    AState := IOStatus(LCount->Inner);
  end;
  return LGot;
end;

routine CountSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
begin
  return IOSeek(ptr to CountData(AUserData)->Inner, AOffset, AOrigin);
end;

routine CountTell(const AUserData: ptr): int64;
begin
  return IOTell(ptr to CountData(AUserData)->Inner);
end;

routine CountSize(const AUserData: ptr): int64;
begin
  return IOSize(ptr to CountData(AUserData)->Inner);
end;

routine CountClose(const AUserData: ptr): bool;
begin
  return IOClose(ptr to CountData(AUserData)->Inner);
end;

// What restarting from 0 costs to reach AAt: the archive's share of the
// output up to AAt, from the restart run's own count
routine RestartCost(const ARestart: int64; const AAt: int64): int64;
begin
  // At most a few MiB times 32 MiB: well inside int64
  return (ARestart * AAt) div CSize;
end;

// Seeks the entry to AAt, reads CRead bytes there and checks them; the
// archive bytes the seek and the read pulled in, -1 when they failed
routine SeekCost(const AEntry: IO; const ACount: ptr to CountData; const AAt: int64): int64;
var
  LBytes: array[0..63] of uint8;
begin
  ACount->Bytes := 0;
  if IOSeek(AEntry, AAt, SeekOrigin.FromStart) <> AAt then
    return -1;
  end;
  if IORead(AEntry, address of LBytes[0], CRead) <> CRead then
    return -1;
  end;
  if not SeekDoSame(AAt, address of LBytes[0], CRead) then
    return -1;
  end;
  return ACount->Bytes;
end;

routine TestSeek();
var
  LPath: string;
  LFile: IO;
  LCallbacks: IOInterface;
  LCount: CountData;
  LArchive: IO;
  LZip: IOSource;
  LEntry: IO;
  LLimit: int64;
  LRestart: int64;
  LTarget: int64;
  LCost: int64;
  LWorst: int64;
  LTotal: int64;
  LRestartTotal: int64;
  LPrevious: int64;
  LAllRead: bool;
  LI: int32;
begin
  LPath := "$P:../std_customio_seek.zip";
  Check("seek fixture built", SeekDoBuild(CSize));
  LFile := CreateFileIO(LPath, FileMode.Write);
  Check("seek zip create", LFile <> nil);
  Check("seek zip written", IOWrite(LFile, SeekDoZipData(), SeekDoZipSize()) = SeekDoZipSize());
  Check("seek zip close", IOClose(LFile));

  LCount.Inner := CreateFileIO(LPath, FileMode.Read);
  Check("seek zip open", LCount.Inner <> nil);
  LCount.Bytes := 0;
  LCallbacks.Read := CountRead;
  LCallbacks.Write := nil;
  LCallbacks.Seek := CountSeek;
  LCallbacks.Tell := CountTell;
  LCallbacks.Size := CountSize;
  LCallbacks.Flush := nil;
  LCallbacks.Close := CountClose;
  LArchive := CreateIO(LCallbacks, address of LCount);
  LZip := CreateZipIOSource(LArchive);
  Check("seek source", LZip <> nil);
  LEntry := IOSourceOpen(LZip, "seek.txt");
  Check("seek entry", LEntry <> nil);
  Check("seek entry size", IOSize(LEntry) = CSize);
  // One interval's share of the archive, twice, plus two chunks
  LLimit := 2 * (SeekDoZipSize() div (CSize div CSpan)) + 2 * CChunk;

  // Restarting from 0: the first seek has no points past the start yet
  LRestart := SeekCost(LEntry, ptr to CountData(address of LCount), CSize - CRead);
  Check("seek restart reads", LRestart > 0);
  Check("seek restart pulls the whole stream", LRestart >= (SeekDoZipSize() div 10) * 9);

  // Back to a third: from the nearest point, not from 0
  LTarget := CSize div 3 + 12345;
  LCost := SeekCost(LEntry, ptr to CountData(address of LCount), LTarget);
  Check("seek back reads", LCost > 0);
  Check("seek back within one interval", LCost <= LLimit);
  Check("seek back cheaper than restart", LCost < RestartCost(LRestart, LTarget));

  // Random order: every seek within one interval, the whole run cheaper
  // than a restart for each backward seek (forward: from where it stood)
  LAllRead := true;
  LWorst := 0;
  LTotal := 0;
  LRestartTotal := 0;
  LPrevious := LTarget + CRead;
  for LI := 1 to CSeeks do
    LTarget := SeekDoNext(CSize - CRead);
    LCost := SeekCost(LEntry, ptr to CountData(address of LCount), LTarget);
    if LCost < 0 then
      LAllRead := false;
    end;
    if LCost > LWorst then
      LWorst := LCost;
    end;
    LTotal := LTotal + LCost;
    if LTarget < LPrevious then
      LRestartTotal := LRestartTotal + RestartCost(LRestart, LTarget);
    else
      LRestartTotal := LRestartTotal + RestartCost(LRestart, LTarget - LPrevious);
    end;
    LPrevious := LTarget + CRead;
  end;
  Check("seek random reads", LAllRead);
  Check("seek random each within one interval", LWorst <= LLimit);
  Check("seek random cheaper than restart", LTotal < LRestartTotal);

  // From the end
  LCount.Bytes := 0;
  Check("seek from end", IOSeek(LEntry, -CRead, SeekOrigin.FromEnd) = CSize - CRead);
  LCost := SeekCost(LEntry, ptr to CountData(address of LCount), CSize - CRead);
  Check("seek from end within one interval", (LCost > 0) and (LCost <= LLimit));

  Check("seek entry close", IOClose(LEntry));
  Check("seek source close", IOSourceClose(LZip));
  Check("seek archive close", IOClose(LArchive));
  // The program wrote the archive, so it removes it: nothing is left in
  // repo\bin\output and no later run depends on an old copy
  Check("seek zip removed", SeekDoRemove(ResolvePath(LPath)));
  Check("seek zip gone", not FileExists(LPath));
  SeekDoFree();
end;

begin
  GFails := 0;
  TestSeek();
  println("done {}", GFails);
end.
