  type_object_operator_err_overlay.pcpp - break step of type_object_operator.pcpp:
  an operator in an overlay (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_overlay.pcpp
    pcpp res\tests\type_object_operator_err_overlay.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_overlay;

type
  TOv = overlay
    X: int32;
    operator +(const A: TOv; const B: TOv): TOv; // ERROR PR0034
    begin
      return A;
    end;
  end;

begin
end.
