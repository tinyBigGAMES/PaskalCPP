-------------------------------------------------------------------------------
  expr_arithmetic_err_div_int64.pcpp - break step of expr_arithmetic.pcpp:
  an int64 divided with / (SM0200): / is real division in float64, which
  cannot hold every int64; write float64(LBig) / 2 or LBig div 2

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_div_int64.pcpp
    pcpp res\tests\expr_arithmetic_err_div_int64.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_div_int64;

var
  LBig: int64 = 9;
  LR: float64;

begin
  LR := LBig / 2; // ERROR SM0200@9: 'int64' does not convert implicitly to 'float64'
end.
