-------------------------------------------------------------------------------
  type_object_operator_err_twice.pcpp - break step of type_object_operator.pcpp:
  one symbol declared twice with the same operand types (SM0383)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_twice.pcpp
    pcpp res\tests\type_object_operator_err_twice.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_twice;

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: TVec; const B: TVec): TVec;
    begin
      return A;
    end;
    operator +(const A: TVec; const B: TVec): TVec; // ERROR SM0383
    begin
      return B;
    end;
  end;

begin
end.
