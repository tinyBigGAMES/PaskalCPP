  type_object_err_parent_int.pcpp - break step of type_object.pcpp:
  an alias of int32 as an object's parent (SM0308)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_parent_int.pcpp
    pcpp res\tests\type_object_err_parent_int.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_parent_int;

type
  TCount = int32;
  TO = object(TCount) // ERROR SM0308@15: 'TCount' cannot be the parent of an object
    X: int32;
  end;

begin
end.
