-------------------------------------------------------------------------------
  type_object_init_err_no_default.pcpp - break step of type_object_init.pcpp:
  a variable built without the arguments its type's init needs (SM0349)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_no_default.pcpp
    pcpp res\tests\type_object_init_err_no_default.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_no_default;

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;

var
  GA: TA; // ERROR SM0349@7: 'TA' has no init without arguments: build it with arguments, TA(...)

begin
end.
