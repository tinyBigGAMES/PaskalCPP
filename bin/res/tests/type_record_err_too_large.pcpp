-------------------------------------------------------------------------------
  type_record_err_too_large.pcpp - break step of type_record.pcpp:
  no type holds more than 1152921504606846975 bytes: two fields of 2^59 bytes are 2^60 (SM0277, at the record's name)

  How to check, from repo\bin:
  (the compiler judges it in the emitted C++: the build runs, the program is
  never started)
    pcpp res\tests\type_record_err_too_large.pcpp
    pcpp res\tests\type_record_err_too_large.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_too_large;

type
  TBig = record // ERROR SM0277@3: 'TBig' is too large: a type holds at most 1152921504606846975 bytes
    A: array[0..576460752303423487] of uint8;
    B: array[0..576460752303423487] of uint8;
  end;

var
  LB: TBig;

begin
end.
