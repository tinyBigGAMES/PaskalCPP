-------------------------------------------------------------------------------
  dir_conditional.pcpp - Directive compliance: the conditional directives
  @define @undef @ifdef @ifndef @elseif @else @endif

  BNF.md sec 2: PaskalCPP's own conditional symbols, evaluated by the PaskalCPP
  compiler; they may stand anywhere (prologue, module level, inside a
  statement) and nest. @elseif X is "else, if X is defined". C/C++ #ifdef does
  not see a PaskalCPP symbol, and @ifdef does not see a C macro set by
  @cppdefine. Every line below names the branch it comes from.

  How to check, from repo\bin:
    pcpp res\tests\dir_conditional.pcpp -r
    pcpp res\tests\dir_conditional.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    module level: GWhich = 1
    @ifdef DIR_CND_ON: taken
    @ifndef DIR_CND_GONE: taken (@undef removed it)
    @elseif DIR_CND_ON: taken
    @else: taken
    nested @else inside a taken @ifdef: taken
    inside one statement: 10
    #ifdef DIR_CND_ON: not seen by C/C++
    @ifdef DIR_CND_C: a @cppdefine macro is not seen by PaskalCPP
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run each file below the same way; each reports exactly what the
  // ERROR / WARN / HINT comment on its marked line says, and nothing else:
    dir_conditional_err_symbol.pcpp       @define without an identifier
    dir_conditional_err_noopener.pcpp     @endif with no @ifdef / @ifndef open
    dir_conditional_err_afterelse.pcpp    a second @else in one @ifdef
    dir_conditional_err_unclosed.pcpp     an @ifdef never closed by @endif
*******************************************************************************/

module exe dir_conditional;
@cppdefine "DIR_CND_C";

@define DIR_CND_ON
@define DIR_CND_GONE
@undef DIR_CND_GONE

@ifdef DIR_CND_ON
const
  GWhich: int32 = 1;
@else
const
  GWhich: int32 = 2;
@endif

begin
  println("module level: GWhich = {}", GWhich);
@ifdef DIR_CND_ON
  println("@ifdef DIR_CND_ON: taken");
@else
  println("wrong branch: @ifdef DIR_CND_ON not taken");
@endif
@ifndef DIR_CND_GONE
  println("@ifndef DIR_CND_GONE: taken (@undef removed it)");
@endif
@ifdef DIR_CND_NONE
  println("wrong branch: @ifdef DIR_CND_NONE");
@elseif DIR_CND_ON
  println("@elseif DIR_CND_ON: taken");
@else
  println("wrong branch: @else after a taken @elseif");
@endif
@ifdef DIR_CND_NONE
  println("wrong branch: @ifdef DIR_CND_NONE");
@elseif DIR_CND_NONE_EITHER
  println("wrong branch: @elseif DIR_CND_NONE_EITHER");
@else
  println("@else: taken");
@endif
@ifdef DIR_CND_ON
@ifdef DIR_CND_NONE
  println("wrong branch: nested @ifdef DIR_CND_NONE");
@else
  println("nested @else inside a taken @ifdef: taken");
@endif
@endif
  println("inside one statement: {}",
@ifdef DIR_CND_ON
    10
@else
    20
@endif
  );
#ifdef DIR_CND_ON
  println("wrong branch: #ifdef DIR_CND_ON seen by C/C++");
#else
  println("#ifdef DIR_CND_ON: not seen by C/C++");
#endif
@ifdef DIR_CND_C
  println("wrong branch: @ifdef DIR_CND_C seen by PaskalCPP");
@else
  println("@ifdef DIR_CND_C: a @cppdefine macro is not seen by PaskalCPP");
@endif
end.
