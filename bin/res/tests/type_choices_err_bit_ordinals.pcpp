-------------------------------------------------------------------------------
  type_choices_err_bit_ordinals.pcpp - break step of type_choices.pcpp:
  a choices bitfield holds every number as a signed value: 2 bits hold -2 .. 1, cBlue is 2 (SM0316)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_bit_ordinals.pcpp
    pcpp res\tests\type_choices_err_bit_ordinals.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_bit_ordinals;

type
  TColor = choices(cRed, cGreen, cBlue);

  TS = record
    Col: TColor : 2; // ERROR SM0316@19: does not hold the ordinals of 'TColor' as signed values
  end;

begin
end.
