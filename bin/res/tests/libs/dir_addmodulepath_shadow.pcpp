-------------------------------------------------------------------------------
  dir_addmodulepath_shadow.pcpp - the res\tests\libs copy of a unit that also
  sits beside dir_addmodulepath.pcpp: the importer's own folder is searched
  first, so this copy is never found (Folder() = 2 would show it was).

  Nothing to check here: dir_addmodulepath.pcpp checks it.
*******************************************************************************/

module unit dir_addmodulepath_shadow;

exported routine Folder(): int32;
begin
  return 2;
end;

end.
