  cpp_include_unit.pcpp - part of cpp_include_quoted.pcpp: a unit in another
  folder (res\tests\libs) that quotes the header beside it after cpp header;
  (in its header: compiled by every importer's TU too).

  Nothing to check here: cpp_include_quoted.pcpp checks it.
*******************************************************************************/

module unit cpp_include_unit;

cpp header;
#include "cpp_include_unit.h"
cpp source;

// The unit's own TU finds the header beside its .pcpp
exported routine UnitValue(): int32;
begin
  return cpp("cpp_include_unit_value()");
end;

end.
