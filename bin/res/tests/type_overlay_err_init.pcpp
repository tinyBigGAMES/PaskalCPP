  type_overlay_err_init.pcpp - break step of type_overlay.pcpp:
  an overlay has no init; an object does (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_init.pcpp
    pcpp res\tests\type_overlay_err_init.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_init;

type
  TV = overlay
    A: int32;
    init(); // ERROR PR0034@5: 'init' is not allowed in an overlay
    begin
    end;
  end;

begin
end.
