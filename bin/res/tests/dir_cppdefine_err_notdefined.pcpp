-------------------------------------------------------------------------------
  dir_cppdefine_err_notdefined.pcpp - break step of dir_cppdefine.pcpp:
  DIR_CPPDEF_ON is not set, so its C file's #error fires (clang's error, at
  the C file's own line and column)

  How to check, from repo\bin:
    pcpp res\tests\dir_cppdefine_err_notdefined.pcpp
    pcpp res\tests\dir_cppdefine_err_notdefined.pcpp -t x86_64-linux-gnu
  The marked line of dir_cppdefine_err_notdefined_c.c reports that code;
  nothing else is reported.
*******************************************************************************/

module exe dir_cppdefine_err_notdefined;
@cppdefine "DIR_CPPDEF_V" "7";
@addsourcefile "$P:res/tests/dir_cppdefine_err_notdefined_c.c";

begin
end.
