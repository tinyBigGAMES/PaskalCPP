  cpp_namespace.pcpp - C++ integration compliance: the module namespace

  A module's declarations live in the C++ namespace pcpp_m_<module>, so a
  PaskalCPP name may be spelled like a C global (index, time: glibc
  declares both) on every target, and mixed C++ names a declaration of
  the module as pcpp_m_cpp_namespace::<name> (BNF.md sec 10).
*******************************************************************************/

module exe cpp_namespace;

/*
  @@test
    kind run
    expect
    | index 3
    | time 4
    | from C++ 8
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

var
  index: int32 = 3;

routine time(): int32;
begin
  return 4;
end;

routine Twice(AN: int32): int32;
begin
  return AN * 2;
end;

int FromCpp() { return pcpp_m_cpp_namespace::Twice(4); }

begin
  println("index {}", index);
  println("time {}", time());
  println("from C++ {}", FromCpp());
end.
