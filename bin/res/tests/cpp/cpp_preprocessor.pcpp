-------------------------------------------------------------------------------
  cpp_preprocessor.pcpp - C++ integration compliance: preprocessor lines

  A line whose first token is # (or its digraph %:) is a C++ preprocessor
  line (BNF.md sec 10), copied as written. At module level it goes where
  cpp header; / cpp source; puts the plain C++ around it: the module's
  source by default, so a unit's own #define stays private to it, and its
  header after cpp header;, so every module importing the unit sees it
  (cpp_preprocessor_unit.pcpp has one of each). One in the source is seen by
  what the source holds after it (bodies, private items), not by the
  module's own header, which the source includes first. In a body it stays
  in place. A splice continues it on the next line.
*******************************************************************************/

module exe cpp_preprocessor;

/*
  @@test
    kind run
    expect
    | two 2
    | joined 12
    | digraph 7
    | in place 6
    | shared by the unit 2
    | private to the unit 0
    | the unit's own 1
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/cpp/fixtures";

import cpp_preprocessor_unit;

// What the unit's #define lines reach here: only the one after its cpp header;
#ifdef CPP_PRE_SHARED
static const int cpp_pre_shared = CPP_PRE_SHARED;
#else
static const int cpp_pre_shared = 0;
#endif
#ifdef CPP_PRE_PRIVATE
static const int cpp_pre_private = CPP_PRE_PRIVATE;
#else
static const int cpp_pre_private = 0;
#endif

#include <cstdlib>
#define KTWO 2
#define KJOINED \
  12
%:define KDIGRAPH 7

begin
  println("two {}", KTWO);
  println("joined {}", KJOINED);
  println("digraph {}", KDIGRAPH);
#define KLOCAL 6
  println("in place {}", KLOCAL);
  println("shared by the unit {}", cpp_pre_shared);
  println("private to the unit {}", cpp_pre_private);
  println("the unit's own {}", cpp_preprocessor_unit.PrivateValue());
end.
