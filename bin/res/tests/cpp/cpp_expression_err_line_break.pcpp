  cpp_expression_err_line_break.pcpp - Cpp: expression, line break

  Break step of cpp_expression: a line break in a plain cpp("...") (PR0046).
*******************************************************************************/

module exe cpp_expression_err_line_break;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := cpp("1\n+ 2"); // ERROR PR0046@13: use a raw string
end.
