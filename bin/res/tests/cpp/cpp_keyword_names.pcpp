-------------------------------------------------------------------------------
  cpp_keyword_names.pcpp - C++ integration compliance: C++ names spelled like
  PaskalCPP keywords

  A C/C++ name spelled like a PaskalCPP keyword (match, until) is reached
  with :: before it (BNF.md sec 10): ::match(4) calls the C++ function.
*******************************************************************************/

module exe cpp_keyword_names;

/*
  @@test
    kind run
    expect
    | match 5
    | until 9
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

int match(int AValue) { return AValue + 1; }
int until(int AValue) { return AValue * 3; }

begin
  println("match {}", ::match(4));
  println("until {}", ::until(3));
end.
