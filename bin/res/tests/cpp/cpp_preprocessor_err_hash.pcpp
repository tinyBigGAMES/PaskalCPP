  cpp_preprocessor_err_hash.pcpp - Cpp: preprocessor, hash

  Break step of cpp_preprocessor: a # that is not first on its line (LX0008).
*******************************************************************************/

module exe cpp_preprocessor_err_hash;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 1;
  LN := 2; # // ERROR LX0008@12: '#' must be the first token on its line
end.
