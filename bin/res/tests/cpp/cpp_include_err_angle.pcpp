-------------------------------------------------------------------------------
  cpp_include_err_angle.pcpp - Cpp: include, angle

  Break step of cpp_include_quoted: #include <...> does not search the
  .pcpp's own folder, as in a C++ file. cpp_include_quoted.h sits beside
  this file, and its angle #include is clang's fatal error (ZB0016 "file
  not found") at the .pcpp line of the #include.
*******************************************************************************/

module exe cpp_include_err_angle;

/*
  @@test
    kind error
  @@end
*/

#include <cpp_include_quoted.h> /* // ERROR ZB0016@10: 'cpp_include_quoted.h' file not found */

begin
  println("unreachable");
end.
