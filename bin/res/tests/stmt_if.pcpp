-------------------------------------------------------------------------------
  stmt_if.pcpp - Statement compliance: if

  if ... then ... [else ...] end; (BNF.md sec 5): the condition is bool,
  each branch a statement list, a chain of tests nests an if in the else.

  How to check, from repo\bin:
    pcpp res\tests\stmt_if.pcpp -r
    pcpp res\tests\stmt_if.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    positive
    zero
    negative
    nested yes
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    stmt_if_err_condition.pcpp
      an int32 condition: a condition is bool (SM0263)
*******************************************************************************/

module exe stmt_if;

routine Sign(AN: int32);
begin
  if AN > 0 then
    println("positive");
  else
    if AN = 0 then
      println("zero");
    else
      println("negative");
    end;
  end;
end;

var
  LA: bool = true;
  LB: bool = true;

begin
  Sign(5);
  Sign(0);
  Sign(-5);
  if LA then
    if LB and LA then
      println("nested yes");
    end;
  end;
  if not LA then
    println("never");
  end;
end.
