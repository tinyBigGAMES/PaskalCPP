-------------------------------------------------------------------------------
  dir_target_unit.pcpp - the unit dir_target.pcpp imports: it names the main
  module's target in three parts (the same target as the main module's four:
  accepted), and prints the target its own code is built for.

  Nothing to check here: dir_target.pcpp checks it.
*******************************************************************************/

module unit dir_target_unit;
@target "x86_64-windows-gnu";

exported routine ShowTarget();
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  println("in the unit: x86_64-windows-gnu");
@endif
@ifdef TARGET_X86_64_LINUX_GNU
  println("in the unit: x86_64-linux-gnu");
@endif
end;

end.
