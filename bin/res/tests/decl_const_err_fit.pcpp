-------------------------------------------------------------------------------
  decl_const_err_fit.pcpp - break step of decl_const.pcpp:
  a constant that does not fit its type (300 into int8)

  How to check, from repo\bin:
    pcpp res\tests\decl_const_err_fit.pcpp
    pcpp res\tests\decl_const_err_fit.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_const_err_fit;

const
  CSmall: int8 = 300; // ERROR SM0200@18: 300 does not fit in 'int8' (-128..127)

begin
  println("{}", CSmall);
end.
