-------------------------------------------------------------------------------
  lex_digraphs_err_hash.pcpp - break step of lex_digraphs.pcpp:
  a %: that is not first on its line (LX0008)

  How to check, from repo\bin:
    pcpp res\tests\lex_digraphs_err_hash.pcpp
    pcpp res\tests\lex_digraphs_err_hash.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_digraphs_err_hash;

var
  LN: int32;

begin
  LN := 1;
  LN := 2; %: // ERROR LX0008@12: '%:' must be the first token on its line
end.
