-------------------------------------------------------------------------------
  mod_import_b.pcpp - a unit mod_import.pcpp imports; it imports mod_import_a
  itself (so mod_import.pcpp reaches mod_import_a twice: one unit).

  Nothing to check here: mod_import.pcpp and its break steps check it.
*******************************************************************************/

module unit mod_import_b;
import mod_import_a;

exported routine Triple(const AX: int32): int32;
var
  LPair: mod_import_a.TPair;
begin
  LPair.First := AX;
  LPair.Second := AX * 2;
  return mod_import_a.Sum(LPair);
end;

end.
