-------------------------------------------------------------------------------
  lex_integers_err_overflow.pcpp - break step of lex_integers.pcpp:
  a literal above uint64, even with a u suffix (LX0006)

  How to check, from repo\bin:
    pcpp res\tests\lex_integers_err_overflow.pcpp
    pcpp res\tests\lex_integers_err_overflow.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_integers_err_overflow;

var
  LN: int64;

begin
  LN := 0;
  LN := 18446744073709551616u; // ERROR LX0006@9: Numeric literal out of range: 18446744073709551616u
end.
