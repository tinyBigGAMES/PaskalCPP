-------------------------------------------------------------------------------
  stmt_return_err_finally.pcpp - break step of stmt_return.pcpp:
  return inside finally (SM0609)

  How to check, from repo\bin:
    pcpp res\tests\stmt_return_err_finally.pcpp
    pcpp res\tests\stmt_return_err_finally.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_return_err_finally;

routine F(): int32;
begin
  guard
    println("body");
  finally
    return 1; // ERROR SM0609@5: return cannot jump out of finally
  end;
  return 0;
end;

begin
end.
