-------------------------------------------------------------------------------
  dir_addincludepath_err_missing.pcpp - break step of dir_addincludepath.pcpp:
  a folder that does not exist (the report names the resolved path)

  How to check, from repo\bin:
    pcpp res\tests\dir_addincludepath_err_missing.pcpp
    pcpp res\tests\dir_addincludepath_err_missing.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe dir_addincludepath_err_missing;
@addincludepath "$P:res/tests/no_such_folder"; // ERROR SM0106@17: is not an existing directory

begin
end.
