-------------------------------------------------------------------------------
  type_choices_err_arithmetic.pcpp - break step of type_choices.pcpp:
  nor + : only a comparison or in takes a choice value (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_arithmetic.pcpp
    pcpp res\tests\type_choices_err_arithmetic.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_arithmetic;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LI: int32;

begin
  LI := TColor.cRed + 1; // ERROR SM0250@9: operator '+' does not take 'TColor' and 'int32'
end.
