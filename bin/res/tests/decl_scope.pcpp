-------------------------------------------------------------------------------
  decl_scope.pcpp - Declaration compliance: declare before use

  Everything is explicit (BNF.md sec 3): a name is visible only after its
  declaration, at every level - module, routine, body, nested block. Mutual
  recursion and self-referencing pointer types use forward (decl_forward).

  This program shows each level: module variables, a constant and a type
  used by later declarations; a routine called from its own body and from a
  later routine; a routine's parameters and earlier locals in later locals;
  a body var visible from its own line on, in an inner block too; a module
  variable declared after the routines, used only in the main block. A
  declaration in an inner scope shadows an outer one of the same name: the
  routine's GCount hides the module's, an if block's GCount hides the
  routine's, and neither changes the module's GCount.

  How to check, from repo\bin:
    pcpp res\tests\decl_scope.pcpp -r
    pcpp res\tests\decl_scope.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    GCount = 1, GNext = 2, CBase = 10
    GPair.A + GPair.B = 12
    Fact(5) = 120
    Twice(3) = 12
    Locals(4) = 16
    inner GCount = 200
    Shadow() = 100
    GCount after Shadow() = 1
    GLate = 5
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    decl_scope_err_own.pcpp             a variable used in its own initializer
    decl_scope_err_before_var.pcpp      a module variable used before its declaration
    decl_scope_err_before_type.pcpp     a type used before its declaration
    decl_scope_err_before_routine.pcpp  a routine called before its declaration
    decl_scope_err_before_local.pcpp    a body var used before its own line
    decl_scope_err_dup_module.pcpp      two module variables with one name
    decl_scope_err_dup_param.pcpp       two parameters with one name
    decl_scope_err_dup_local.pcpp       a routine's var with its parameter's name
    decl_scope_err_dup_body.pcpp        a body var with a name the routine's var block has
*******************************************************************************/

module exe decl_scope;

var
  GCount: int32 = 1;
  GNext: int32 = GCount + 1;

const
  CBase: int32 = 10;

type
  TPair = record
    A: int32;
    B: int32;
  end;

var
  GPair: TPair;

routine Fact(AN: int32): int32;
begin
  // A routine is visible in its own body
  if AN <= 1 then
    return 1;
  end;
  return AN * Fact(AN - 1);
end;

routine Twice(AN: int32): int32;
begin
  return Fact(AN) * 2;
end;

routine Locals(AX: int32): int32;
const
  CStep: int32 = 3;
var
  LSum: int32 = AX + CStep;
begin
  var LMore: int32 = LSum + 1;
  if LMore > 0 then
    var LInner: int32 = LMore * 2;
    LSum := LInner;
  end;
  return LSum;
end;

routine Shadow(): int32;
var
  GCount: int32 = 100;
begin
  if GCount > 0 then
    var GCount: int32 = 200;
    println("inner GCount = {}", GCount);
  end;
  return GCount;
end;

var
  GLate: int32 = 5;

begin
  println("GCount = {}, GNext = {}, CBase = {}", GCount, GNext, CBase);
  GPair.A := CBase;
  GPair.B := GNext;
  println("GPair.A + GPair.B = {}", GPair.A + GPair.B);
  println("Fact(5) = {}", Fact(5));
  println("Twice(3) = {}", Twice(3));
  println("Locals(4) = {}", Locals(4));
  var LShadow: int32 = Shadow();
  println("Shadow() = {}", LShadow);
  println("GCount after Shadow() = {}", GCount);
  println("GLate = {}", GLate);
end.
