-------------------------------------------------------------------------------
  type_routine_err_linkage.pcpp - break step of type_routine.pcpp:
  a cpplink routine into a routine clink variable: clink is its own type (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_routine_err_linkage.pcpp
    pcpp res\tests\type_routine_err_linkage.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_routine_err_linkage;

type
  TOps = record
    F: routine(AN: int32): int32;
  end;

routine Double(AN: int32): int32;
begin
  return AN * 2;
end;

routine Wrong(AN: int64): int32;
begin
  return 0;
end;

var
  LC: routine clink(AN: int32): int32;

begin
  LC := Double; // ERROR SM0200@9: does not convert implicitly
end.
