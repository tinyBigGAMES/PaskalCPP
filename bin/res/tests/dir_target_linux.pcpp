-------------------------------------------------------------------------------
  dir_target_linux.pcpp - Directive compliance: @target, the Linux form

  The rules are in dir_target.pcpp. This file names Linux in three parts
  (arch-os-env: the vendor is LLVM's for Linux, unknown) and imports a unit
  with no @target, which builds for the main module's target.

  How to check, from repo\bin (no -t: the file names its own target; it runs
  in WSL):
    pcpp res\tests\dir_target_linux.pcpp -r
  EXPECT:
    PaskalCPP builds for: x86_64-linux-gnu
    clang compiles for: __linux__
    in the unit: x86_64-linux-gnu
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The break steps are dir_target.pcpp's.
*******************************************************************************/

module exe dir_target_linux;
@target "x86_64-linux-gnu";
import dir_target_linux_unit;

// The OS macro clang defines for the target it compiles for
static const char* dir_target_linux_os()
{
  return ""
#ifdef _WIN32
  " _WIN32"
#endif
#ifdef __linux__
  " __linux__"
#endif
  ;
}

begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  println("PaskalCPP builds for: x86_64-windows-gnu");
@endif
@ifdef TARGET_X86_64_LINUX_GNU
  println("PaskalCPP builds for: x86_64-linux-gnu");
@endif
  println("clang compiles for:{}", cpp("dir_target_linux_os()"));
  dir_target_linux_unit.ShowTarget();
end.
