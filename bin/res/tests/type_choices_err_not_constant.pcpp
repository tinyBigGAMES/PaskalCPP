  type_choices_err_not_constant.pcpp - break step of type_choices.pcpp:
  a value's number is a constant (SM0202)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_not_constant.pcpp
    pcpp res\tests\type_choices_err_not_constant.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_not_constant;

var
  LV: int32;

type
  TC = choices(cA = LV); // ERROR SM0202@21: a choice value must be a constant

begin
end.
