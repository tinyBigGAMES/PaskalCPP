-------------------------------------------------------------------------------
  type_pointer_err_untyped.pcpp - break step of type_pointer.pcpp:
  nor is the untyped ptr a ptr to T: cast it (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_untyped.pcpp
    pcpp res\tests\type_pointer_err_untyped.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_untyped;

var
  LP: ptr to int32;
  LU: ptr;

begin
  LU := nil;
  LP := LU; // ERROR SM0200@9: 'ptr' does not convert implicitly to 'ptr to int32'; write ptr to int32(LU)
end.
