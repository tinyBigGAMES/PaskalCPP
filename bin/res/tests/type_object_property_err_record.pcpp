-------------------------------------------------------------------------------
  type_object_property_err_record.pcpp - break step of type_object_property.pcpp:
  a property in a record: a record is plain data (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_err_record.pcpp
    pcpp res\tests\type_object_property_err_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_err_record;

type
  TRec = record
    FN: int32;
    property N: int32 read FN; // ERROR PR0034@5: 'property' is not allowed in a record
  end;

begin
end.
