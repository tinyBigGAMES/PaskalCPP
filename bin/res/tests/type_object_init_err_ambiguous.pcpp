-------------------------------------------------------------------------------
  type_object_init_err_ambiguous.pcpp - break step of type_object_init.pcpp:
  arguments two inits take alike: neither has their exact types (SM0352)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_ambiguous.pcpp
    pcpp res\tests\type_object_init_err_ambiguous.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_ambiguous;

type
  TA = object
    K: int64;
    init(const AX: int64);
    begin
      self.K := AX;
    end;
    init(const AY: int32);
    begin
      self.K := AY;
    end;
  end;

var
  GS: int16 = 1;
  GA: TA(GS); // ERROR SM0352@9: fit more than one init of 'TA'

begin
end.
