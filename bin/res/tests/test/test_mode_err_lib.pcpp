  test_mode_err_lib.pcpp - Test: mode, lib

  Break step of test_mode: @unitTestMode in a lib module, where no program
  runs its tests (SM0110).
*******************************************************************************/

module lib test_mode_err_lib;

/*
  @@test
    kind error
  @@end
*/

@unitTestMode on; // ERROR SM0110@1: @unitTestMode in a dll or lib module

end.
