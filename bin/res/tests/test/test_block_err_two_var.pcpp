module exe test_block_err_two_var;

/*
  @@test
    kind error
  @@end
*/

begin
end.

test "two var blocks"
var
  LA: int32;
var // ERROR PR0025@1: found 'var'
  LB: int32;
begin
  LA := 1;
  LB := 2;
  testAssertEqualInt(3, LA + LB);
end;
