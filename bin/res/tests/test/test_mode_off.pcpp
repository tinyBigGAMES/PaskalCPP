-------------------------------------------------------------------------------
  test_mode_off.pcpp - Unit testing compliance: @unitTestMode off

  With @unitTestMode off, or without the directive, test blocks are checked
  but not compiled in: the body runs and no test does (this one would fail).
  The break step test_asserts_err_type shows a test is still checked.
*******************************************************************************/

module exe test_mode_off;

/*
  @@test
    kind run
    expect
    | the body runs
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@unitTestMode off;

begin
  println("the body runs");
end.

test "would fail"
begin
  testFail("never runs");
end;
