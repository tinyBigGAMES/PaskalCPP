  test_mode_unit.pcpp - Fixture: a unit test_mode.pcpp imports: an exported
  routine, initialize and finalize sections that print, and a test block of
  its own.

  Nothing to check here: test_mode.pcpp checks it.
*******************************************************************************/

module unit test_mode_unit;

exported routine Add(AA: int32; AB: int32): int32;
begin
  return AA + AB;
end;

initialize
begin
  println("unit init");
end;

finalize
begin
  println("unit final");
end;

end.

test "unit adds"
begin
  testAssertEqualInt(5, Add(2, 3));
end;
