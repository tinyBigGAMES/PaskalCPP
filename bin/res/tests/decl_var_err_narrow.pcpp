-------------------------------------------------------------------------------
  decl_var_err_narrow.pcpp - break step of decl_var.pcpp:
  an initializer that can lose a value (int32 into int8)

  How to check, from repo\bin:
    pcpp res\tests\decl_var_err_narrow.pcpp
    pcpp res\tests\decl_var_err_narrow.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_var_err_narrow;

var
  GBig: int32 = 1000;
  GSmall: int8 = GBig; // ERROR SM0200@18

begin
  println("{}", GSmall);
end.
