-------------------------------------------------------------------------------
  suite_dep_lib.pcpp - Test suite: a dependency (static library)

  kind dep: a lib or dll another test needs. It is never a result of its
  own: the suite builds it first, in the consumer's cell, every time a test
  that names it in `deps` runs (here suite_dep). A dep no test names is
  reported at discovery.
*******************************************************************************/

module lib suite_dep_lib;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink suite_dep_lib_scale(AValue: int32; AFactor: int32): int32;
begin
  return AValue * AFactor;
end;

end.
