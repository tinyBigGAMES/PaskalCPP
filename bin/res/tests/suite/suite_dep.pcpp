-------------------------------------------------------------------------------
  suite_dep.pcpp - Test suite: a run test with a dependency

  deps names the stems of the dep tests this test needs (suite_dep_lib). The
  suite builds them first, in this test's own cell, so the library this
  program links is always the one built for the target being tested.
  Selecting this test alone pulls its deps in.
*******************************************************************************/

module exe suite_dep;

/*
  @@test
    kind run
    deps suite_dep_lib
    expect
    | 6 x 7 = 42
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addlibrarypath "$P:output/lib";
@linklibrary "suite_dep_lib";

routine clink suite_dep_lib_scale(AValue: int32; AFactor: int32): int32; external;

begin
  println("6 x 7 = {}", suite_dep_lib_scale(6, 7));
end.
