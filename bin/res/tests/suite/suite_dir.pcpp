-------------------------------------------------------------------------------
  suite_dir.pcpp - Test suite: <DIR> in expect lines

  A program can print a path that depends on where the suite sits: here the
  source path the emitter writes into every #line (absolute, '/' form),
  which C++'s __FILE__ reports. In expect lines <DIR> stands for the test
  file's folder in '/' form, so the expectation holds on every machine.
*******************************************************************************/

module exe suite_dir;

/*
  @@test
    kind run
    expect
    | <DIR>/suite_dir.pcpp
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

begin
  println("{}", cpp("__FILE__"));
end.
