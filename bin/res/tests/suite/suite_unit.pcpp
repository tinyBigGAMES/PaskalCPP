-------------------------------------------------------------------------------
  suite_unit.pcpp - Test suite: a unit test (analyzed only)

  kind unit: a module unit has no program of its own, so it is only analyzed
  (parsed and checked) in every cell and must report nothing. A unit that is
  also used by a program gets a run test of that program as well.
*******************************************************************************/

module unit suite_unit;

/*
  @@test
    kind unit
  @@end
*/

exported routine SuiteUnitMax(const AA: int32; const AB: int32): int32;
begin
  if AA > AB then
    return AA;
  end;
  return AB;
end;

end.
