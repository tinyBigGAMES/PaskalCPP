-------------------------------------------------------------------------------
  type_object_property_virtual_err_iface_missing.pcpp - break step of type_object_property_virtual.pcpp:
  the object declares the interface property (SM0364)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_iface_missing.pcpp
    pcpp res\tests\type_object_property_virtual_err_iface_missing.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_iface_missing;

type
  IA = interface
    property A: int32 read; write;
  end;
  TBox = object implements IA // ERROR SM0364@28: 'TBox' does not implement 'IA.A'
  end;

begin
end.
