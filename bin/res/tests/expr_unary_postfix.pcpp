-------------------------------------------------------------------------------
  expr_unary_postfix.pcpp - Expression compliance: prefix and postfix operators

  Prefix not - + address of and the C++ forms ! ~ * & ++ -- (BNF.md sec 6
  prefix op), postfix ^ (the deref) ++ -- and member access through a
  deref or ->; prefix operators chain (not not LB, **LPP, LPP^^). The
  address of a value that is not stored (a call result, a sum) does not
  exist: only a variable, a field, an element or a deref has one.

  How to check, from repo\bin:
    pcpp res\tests\expr_unary_postfix.pcpp -r
    pcpp res\tests\expr_unary_postfix.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    not false true
    minus plus -5 5
    deref 5
    through 6
    chain 6 6
    cpp forms 6 false
    compl -7
    inc 8
    dec 6
    member 5
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_unary_postfix_err_no_member.pcpp
      a member the record does not have (SM0009)
    expr_unary_postfix_err_not_int.pcpp
      not on an int32 (SM0250)
    expr_unary_postfix_err_negate_string.pcpp
      unary minus on a string (SM0250)
    expr_unary_postfix_err_negate_min.pcpp
      negating the minimum int32 constant (SM0256)
    expr_unary_postfix_err_address_value.pcpp
      the address of a call result (SM0254)
*******************************************************************************/

module exe expr_unary_postfix;

type
  TP = record
    X: int32;
  end;

var
  LN: int32 = 5;
  LB: bool = true;
  LP: ptr to int32;
  LPP: ptr to ptr to int32;
  LR: TP;
  LQ: ptr to TP;

begin
  println("not {} {}", not LB, not not LB);
  println("minus plus {} {}", -LN, +LN);
  LP := address of LN;
  println("deref {}", LP^);
  LP^ := 6;
  println("through {}", LN);
  LPP := address of LP;
  println("chain {} {}", LPP^^, **LPP);
  LP := &LN;
  println("cpp forms {} {}", *LP, !LB);
  println("compl {}", ~LN);
  ++LN;
  LN++;
  println("inc {}", LN);
  --LN;
  LN--;
  println("dec {}", LN);
  LR.X := 3;
  LQ := address of LR;
  LQ^.X += 1;
  LQ->X += 1;
  println("member {}", LR.X);
end.
