-------------------------------------------------------------------------------
  lex_strings_err_raw.pcpp - break step of lex_strings.pcpp:
  a raw string with no closing )" (LX0002)

  How to check, from repo\bin:
    pcpp res\tests\lex_strings_err_raw.pcpp
    pcpp res\tests\lex_strings_err_raw.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_strings_err_raw;

begin
  println(R"(never closed); // ERROR LX0002@11: Unterminated raw string literal
end.
