  decl_scope_err_before_type.pcpp - break step of decl_scope.pcpp:
  a type used before its declaration

  How to check, from repo\bin:
    pcpp res\tests\decl_scope_err_before_type.pcpp
    pcpp res\tests\decl_scope_err_before_type.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_scope_err_before_type;

type
  TFirst = TSecond; // ERROR SM0002@12
  TSecond = int32;

var
  GV: TFirst = 1;

begin
  println("{}", GV);
end.
