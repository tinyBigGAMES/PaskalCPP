-------------------------------------------------------------------------------
  expr_relational.pcpp - Expression compliance: relational operators

  = <> < > <= >= <=> and in (BNF.md sec 6) give bool (<=> gives C++'s
  ordering, compared with 0); they do not chain, and C++'s == and != are
  errors with the PaskalCPP form. Integers, floats, chars and strings compare;
  in tests a set's element; a record compares only through an operator it
  declares (type_object_operator).

  How to check, from repo\bin:
    pcpp res\tests\expr_relational.pcpp -r
    pcpp res\tests\expr_relational.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    ints false true true false true true
    float true
    chars true
    strings true false
    spaceship true
    in true false
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_relational_err_chain.pcpp
      a < b < c: comparisons do not chain (PR0038)
    expr_relational_err_cpp_equal.pcpp
      C++ == (PR0039)
    expr_relational_err_operands.pcpp
      a string compared with an int32 (SM0250)
    expr_relational_err_record.pcpp
      two records compared (SM0252)
    expr_relational_err_mixed_sign.pcpp
      an int32 compared with a uint32 (SM0200)
*******************************************************************************/

module exe expr_relational;

var
  LA: int32 = 1;
  LB: int32 = 2;
  LS: string = "abc";

begin
  println("ints {} {} {} {} {} {}", LA = LB, LA <> LB, LA < LB, LA > LB, LA <= LB, LB >= LA);
  println("float {}", 1.5 < 2.5);
  println("chars {}", 'a' < 'b');
  println("strings {} {}", LS < "abd", LS = "abd");
  println("spaceship {}", (LA <=> LB) < 0);
  println("in {} {}", 3 in [1, 2, 3], 4 in [1, 2, 3]);
end.
