-------------------------------------------------------------------------------
  expr_arithmetic_err_div_assign.pcpp - break step of expr_arithmetic.pcpp:
  /= on an int32 (SM0250): / is real division, and its float64 result never
  goes back into an integer; write LA := LA div 2

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_div_assign.pcpp
    pcpp res\tests\expr_arithmetic_err_div_assign.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_div_assign;

var
  LA: int32 = 7;

begin
  LA /= 2; // ERROR SM0250@3: operator '/=' does not take 'int32' and 'int32'
end.
