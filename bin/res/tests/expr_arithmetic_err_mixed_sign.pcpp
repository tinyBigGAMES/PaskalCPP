-------------------------------------------------------------------------------
  expr_arithmetic_err_mixed_sign.pcpp - break step of expr_arithmetic.pcpp:
  an int32 added to a uint32 (SM0200 at the int32): the sum is computed in
  uint32, so -1 would become 4294967295; write int64(LA) + LU or
  uint32(LA) + LU

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_mixed_sign.pcpp
    pcpp res\tests\expr_arithmetic_err_mixed_sign.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_mixed_sign;

var
  LA: int32 = -1;
  LU: uint32 = 1;
  LR: int64;

begin
  LR := LA + LU; // ERROR SM0200@9: 'int32' does not convert implicitly to 'uint32'
end.
