-------------------------------------------------------------------------------
  type_object_init_err_same_params.pcpp - break step of type_object_init.pcpp:
  two inits with the same parameter types: inits overload by parameter types (SM0324)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_same_params.pcpp
    pcpp res\tests\type_object_init_err_same_params.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_same_params;

type
  TA = object
    N: int32;
    init(const AX: int32);
    begin
    end;
    init(AY: int32); // ERROR SM0324@5: 'init' is already declared with these parameter types
    begin
    end;
  end;

begin
end.
