-------------------------------------------------------------------------------
  type_object_own_err_weak_to_ref.pcpp - break step of type_object_own.pcpp:
  a weak given to a ref without lock: the object may be gone (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_object_own_err_weak_to_ref.pcpp
    pcpp res\tests\type_object_own_err_weak_to_ref.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_own_err_weak_to_ref;

type
  TPlain = object
    X: int32;
  end;

routine Use(const AW: weak TPlain);
var
  LR: ref TPlain;
begin
  LR := AW; // ERROR SM0200@9: 'weak TPlain' does not convert implicitly to 'ref TPlain'
end;

begin
end.
