-------------------------------------------------------------------------------
  type_array_err_index_choices.pcpp - break step of type_array.pcpp:
  an array bounded by choice values is indexed by a value of that type (SM0261)

  How to check, from repo\bin:
    pcpp res\tests\type_array_err_index_choices.pcpp
    pcpp res\tests\type_array_err_index_choices.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_array_err_index_choices;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LA: array[TColor.cRed..TColor.cBlue] of int32;
  LI: int32;

begin
  LI := LA[1]; // ERROR SM0261@12: an index of 'array[TColor.cRed..TColor.cBlue] of int32' is a 'TColor' value, got 'int32'
end.
