  type_overlay_err_dynarray.pcpp - break step of type_overlay.pcpp:
  nor a dynamic array (it owns its elements; SM0313)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_dynarray.pcpp
    pcpp res\tests\type_overlay_err_dynarray.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_dynarray;

type
  TV = overlay
    A: int32;
    D: array of int32; // ERROR SM0313@5: cannot share an overlay's storage
  end;

begin
end.
