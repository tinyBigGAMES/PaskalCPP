-------------------------------------------------------------------------------
  type_object_virtual_err_override_final.pcpp - break step of type_object_virtual.pcpp:
  override of a final method (SM0335)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_override_final.pcpp
    pcpp res\tests\type_object_virtual_err_override_final.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_override_final;

type
  TA = object
    virtual final method M();
    begin
    end;
  end;
  TB = object(TA)
    override method M(); // ERROR SM0335@5: 'TA.M' is final: it cannot be overridden
    begin
    end;
  end;

begin
end.
