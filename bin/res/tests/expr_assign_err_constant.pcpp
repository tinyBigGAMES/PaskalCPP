  expr_assign_err_constant.pcpp - break step of expr_assign.pcpp:
  an assignment to a constant (SM0255)

  How to check, from repo\bin:
    pcpp res\tests\expr_assign_err_constant.pcpp
    pcpp res\tests\expr_assign_err_constant.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_assign_err_constant;

const
  KC: int32 = 1;

begin
  KC := 2; // ERROR SM0255@3: cannot be assigned
end.
