-------------------------------------------------------------------------------
  type_object_copy.pcpp - Type compliance: copy, move and slicing

  An object is a value (BNF.md sec 4 object type, copy decl). Shown here:
  - an object with a done and no copy cannot be copied (TRes): it moves.
    A local returned from a routine moves out (its done does not run);
    `LA := Make(4)` takes the new value and the old one ends then
    (close 3); a call result passed by value ends after the call;
  - copy(const ASource: T) makes it copyable (TCp): it builds the copy
    as an init builds an object (the fields start empty, its body fills
    them); `LB := LA` copies, and the old value of LB ends (end 8);
  - values end at the end of their scope, in reverse order;
  - a descendant that is not polymorphic converts to its parent by value
    (TDer to TBase); a polymorphic one only through var / const or a
    pointer. A polymorphic object reached through a var parameter, a
    pointer or self may be a descendant, so it is never assigned whole.
  Every value with a done ends exactly once.

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy.pcpp -r
    pcpp res\tests\type_object_copy.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    open 1
    open 2
    scope
    close 2
    close 1
    open 3
    open 4
    close 3
    show 4
    open 5
    take 5
    close 5
    close 4
    copy 7 -> 107
    end 8
    lb 107
    end 107
    end 7
    base 1
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    type_object_copy_err_assign.pcpp  an object with a done and no copy initialized from a variable
    type_object_copy_err_argument.pcpp  such an object passed by value
    type_object_copy_err_array.pcpp  an array of such objects assigned
    type_object_copy_err_parent.pcpp  an object whose parent cannot be copied, assigned
    type_object_copy_err_return_var.pcpp  a var parameter returned by value
    type_object_copy_err_shape.pcpp  a copy that takes a var parameter
    type_object_copy_err_two_copy.pcpp  two copies in one object
    type_object_copy_err_copy_parent.pcpp  a copy whose parent cannot be copied
    type_object_copy_err_parent_init.pcpp  parent.init(...) in a copy
    type_object_copy_err_by_name.pcpp  copy called by name
    type_object_copy_err_result.pcpp  a copy with a result type
    type_object_copy_err_slice.pcpp  a polymorphic object passed by value as its parent
    type_object_copy_err_slice_var.pcpp  a polymorphic object assigned through a var parameter
    type_object_copy_err_slice_deref.pcpp  a polymorphic object assigned through a pointer
    type_object_copy_err_slice_self.pcpp  self of a polymorphic object assigned
    type_object_copy_err_slice_copy_param.pcpp  a const parameter of a polymorphic object returned by value
    type_object_copy_err_slice_copy_deref.pcpp  a polymorphic object copied out of a pointer
    type_object_copy_err_slice_copy_as.pcpp  the object an as gives copied by value
    type_object_copy_err_record.pcpp  a record holding an object
    type_object_copy_err_overlay.pcpp  an overlay holding an array of objects
*******************************************************************************/

module exe type_object_copy;

type
  TRes = object
    Id: int32;
    init(const AId: int32);
    begin
      self.Id := AId;
      println("open {}", self.Id);
    end;
    done;
    begin
      println("close {}", self.Id);
    end;
  end;
  TCp = object
    Id: int32;
    init(const AId: int32);
    begin
      self.Id := AId;
    end;
    copy(const ASource: TCp);
    begin
      self.Id := ASource.Id + 100;
      println("copy {} -> {}", ASource.Id, self.Id);
    end;
    done;
    begin
      println("end {}", self.Id);
    end;
  end;
  TBase = object
    B: int32;
  end;
  TDer = object(TBase)
    D: int32;
  end;

routine Make(const AId: int32): TRes;
var
  LR: TRes(AId);
begin
  return LR;
end;

routine Show(const AR: TRes);
begin
  println("show {}", AR.Id);
end;

routine Take(AR: TRes);
begin
  println("take {}", AR.Id);
end;

routine Scope();
var
  LA: TRes(1);
  LB: TRes(2);
begin
  println("scope");
end;

routine Moves();
var
  LA: TRes(3);
begin
  LA := Make(4);
  Show(LA);
  Take(Make(5));
end;

routine Copies();
var
  LA: TCp(7);
  LB: TCp(8);
begin
  LB := LA;
  println("lb {}", LB.Id);
end;

routine Upcast();
var
  LD: TDer;
  LB: TBase;
begin
  LD.B := 1;
  LD.D := 2;
  LB := LD;
  println("base {}", LB.B);
end;

begin
  Scope();
  Moves();
  Copies();
  Upcast();
end.
