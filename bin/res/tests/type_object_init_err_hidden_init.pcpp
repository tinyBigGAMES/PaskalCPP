-------------------------------------------------------------------------------
  type_object_init_err_hidden_init.pcpp - break step of type_object_init.pcpp:
  hidden before an init: an init is never hidden (PR0058)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_hidden_init.pcpp
    pcpp res\tests\type_object_init_err_hidden_init.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_hidden_init;

type
  TA = object
    hidden init(); // ERROR PR0058@5: 'hidden' does not go before init, copy or done
    begin
    end;
  end;

begin
end.
