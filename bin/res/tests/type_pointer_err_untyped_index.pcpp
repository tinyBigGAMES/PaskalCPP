-------------------------------------------------------------------------------
  type_pointer_err_untyped_index.pcpp - break step of type_pointer.pcpp:
  nor is it indexed (SM0253)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_untyped_index.pcpp
    pcpp res\tests\type_pointer_err_untyped_index.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_untyped_index;

var
  LU: ptr;
  LX: int32;

begin
  LU := nil;
  LX := LU[0]; // ERROR SM0253@9: 'LU' is an untyped ptr and points at no type: cast it to a typed pointer first (ptr to T(LU))
end.
