-------------------------------------------------------------------------------
  type_record_err_align_below_cpp_field.pcpp - break step of type_record.pcpp:
  align(4) on a field of a C++ struct holding a double: below its natural alignment 8 (SM0311, at the align value; the C++ layout is judged in the emitted C++)

  How to check, from repo\bin:
  (the compiler judges it in the emitted C++: the build runs, the program is
  never started)
    pcpp res\tests\type_record_err_align_below_cpp_field.pcpp
    pcpp res\tests\type_record_err_align_below_cpp_field.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_align_below_cpp_field;

struct CPoint { double X; };

type
  TR = record align(4) // ERROR SM0311@21: align 4 is below the natural alignment 8 of 'TR', lower it with packed
    P: CPoint;
  end;

var
  V: TR;

begin
  V.P.X := 1.0;
end.
