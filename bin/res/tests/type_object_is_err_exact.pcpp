-------------------------------------------------------------------------------
  type_object_is_err_exact.pcpp - break step of type_object_is.pcpp:
  is on a variable, which holds exactly its type (SM0274)

  How to check, from repo\bin:
    pcpp res\tests\type_object_is_err_exact.pcpp
    pcpp res\tests\type_object_is_err_exact.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_is_err_exact;

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;

var
  LShape: TShape;
begin
  println("{}", LShape is TCircle); // ERROR SM0274
end.
