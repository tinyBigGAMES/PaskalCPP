-------------------------------------------------------------------------------
  mod_import_a.pcpp - a unit mod_import.pcpp and mod_import_b.pcpp import: an
  exported type and routine, and one routine it does not export (Add).

  Nothing to check here: mod_import.pcpp and its break steps check it.
*******************************************************************************/

module unit mod_import_a;

exported type
  TPair = record
    First: int32;
    Second: int32;
  end;

// Not exported: only this unit calls it (mod_import_err_notexported.pcpp tries)
routine Add(const AX: int32; const AY: int32): int32;
begin
  return AX + AY;
end;

exported routine Sum(const APair: TPair): int32;
begin
  return Add(APair.First, APair.Second);
end;

end.
