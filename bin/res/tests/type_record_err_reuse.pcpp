-------------------------------------------------------------------------------
  type_record_err_reuse.pcpp - break step of type_record.pcpp:
  a field reuses its parent's field name (SM0309)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_reuse.pcpp
    pcpp res\tests\type_record_err_reuse.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_reuse;

type
  TBase = record
    A: int32;
  end;
  TR = record(TBase)
    A: int32; // ERROR SM0309@5: 'A' reuses a name of the parent chain
  end;

begin
end.
