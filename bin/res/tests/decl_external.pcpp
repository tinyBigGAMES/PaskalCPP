-------------------------------------------------------------------------------
  decl_external.pcpp - Declaration compliance: the external clause

  routine ...; external [ "library" | name ]; (BNF.md sec 3). external
  replaces a routine's body: the routine is bound to a symbol linked from
  elsewhere. With no library, the symbol is in this build (decl_external_c.c
  defines decl_external_mul). A library is named as @linklibrary names one,
  never a file or a path: as a string ("lib_plain"), or as a const string
  (CRuntimeLib = "lib_runtime"); the clause may stand on a line of its own.
  The library is linked because the clause names it: this program has no
  @linklibrary, only the folders the libraries are built in.

  How to check, from repo\bin (the build commands of lib_plain.pcpp and
  lib_runtime.pcpp first):
    pcpp res\tests\decl_external.pcpp -r
    pcpp res\tests\decl_external.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    decl_external_mul(6, 7) = 42
    lib_plain_add(2, 3) = 5
    lib_rt_div(7, 2) = 3
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    decl_external_err_lib_file.pcpp     a file name as the library
    decl_external_err_lib_const.pcpp    a const that is no string as the library
    decl_external_err_lib_name.pcpp     a const string that names a path
    decl_external_err_lib_unknown.pcpp  a name nothing declares as the library
    decl_external_err_nolib.pcpp        a library the linker cannot find
*******************************************************************************/

module exe decl_external;
@addsourcefile "$P:res/tests/decl_external_c.c";
@addlibrarypath "$P:output/lib";

const
  CRuntimeLib: string = "lib_runtime";

routine clink decl_external_mul(AA: int32; AB: int32): int32; external;
routine clink lib_plain_add(AA: int32; AB: int32): int32; external "lib_plain";
routine clink lib_rt_div(AA: int32; AB: int32): int32;
  external CRuntimeLib;

begin
  println("decl_external_mul(6, 7) = {}", decl_external_mul(6, 7));
  println("lib_plain_add(2, 3) = {}", lib_plain_add(2, 3));
  println("lib_rt_div(7, 2) = {}", lib_rt_div(7, 2));
end.
