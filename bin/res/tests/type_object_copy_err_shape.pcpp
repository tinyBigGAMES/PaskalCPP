-------------------------------------------------------------------------------
  type_object_copy_err_shape.pcpp - break step of type_object_copy.pcpp:
  a copy that takes a var parameter: copy takes one const parameter of its own type (SM0353)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_shape.pcpp
    pcpp res\tests\type_object_copy_err_shape.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_shape;

type
  TA = object
    N: int32;
    copy(var ASource: TA); // ERROR SM0353@10: copy takes one const parameter of its own type
    begin
    end;
  end;

begin
end.
