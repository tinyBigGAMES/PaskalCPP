-------------------------------------------------------------------------------
  type_routine_err_count.pcpp - break step of type_routine.pcpp:
  a routine value called with more arguments than its type takes (SM0401, F51)

  How to check, from repo\bin:
    pcpp res\tests\type_routine_err_count.pcpp
    pcpp res\tests\type_routine_err_count.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_routine_err_count;

var
  LF: routine(AN: int32): int32;
  LN: int32;

begin
  LF := nil;
  LN := LF(1, 2); // ERROR SM0401@9: takes 1 argument(s), 2 given
end.
