-------------------------------------------------------------------------------
  type_record_err_parent_choices.pcpp - break step of type_record.pcpp:
  a choices type as a record's parent (SM0308)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_parent_choices.pcpp
    pcpp res\tests\type_record_err_parent_choices.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_parent_choices;

type
  TC = choices(cA, cB);
  TR = record(TC) // ERROR SM0308@15: 'TC' cannot be the parent of a record
    B: int32;
  end;

begin
end.
