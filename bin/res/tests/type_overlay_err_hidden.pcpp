-------------------------------------------------------------------------------
  type_overlay_err_hidden.pcpp - break step of type_overlay.pcpp:
  an overlay is plain data: no hidden members (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_hidden.pcpp
    pcpp res\tests\type_overlay_err_hidden.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_hidden;

type
  TV = overlay
    hidden A: int32; // ERROR PR0034@5: 'hidden' is not allowed in an overlay
    B: float32;
  end;

begin
end.
