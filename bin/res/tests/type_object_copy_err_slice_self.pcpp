-------------------------------------------------------------------------------
  type_object_copy_err_slice_self.pcpp - break step of type_object_copy.pcpp:
  self of a polymorphic object assigned: a method runs on a descendant too (SM0429)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_slice_self.pcpp
    pcpp res\tests\type_object_copy_err_slice_self.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_slice_self;

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
    method Reset();
    var
      LB: TA;
    begin
      self := LB; // ERROR SM0429@7: 'self' may hold a descendant of 'TA' (it is polymorphic)
    end;
  end;

begin
end.
