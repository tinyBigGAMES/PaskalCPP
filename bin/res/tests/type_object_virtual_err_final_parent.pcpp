-------------------------------------------------------------------------------
  type_object_virtual_err_final_parent.pcpp - break step of type_object_virtual.pcpp:
  a final object as a parent (SM0339)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_final_parent.pcpp
    pcpp res\tests\type_object_virtual_err_final_parent.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_final_parent;

type
  TA = final object
    N: int32;
  end;
  TB = object(TA) // ERROR SM0339@15: 'TA' is final: no type may extend it
  end;

begin
end.
