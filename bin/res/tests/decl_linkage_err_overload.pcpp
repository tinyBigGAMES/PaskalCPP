-------------------------------------------------------------------------------
  decl_linkage_err_overload.pcpp - break step of decl_linkage.pcpp:
  two exported clink routines of one name: C has no overloads

  How to check, from repo\bin:
    pcpp res\tests\decl_linkage_err_overload.pcpp
    pcpp res\tests\decl_linkage_err_overload.pcpp -t x86_64-linux-gnu
  Each marked line reports that warning; nothing else is reported. The
  build succeeds: both routines get C++ linkage, so their two exported
  definitions do not clash as two C functions of one name would.
*******************************************************************************/

module exe decl_linkage_err_overload;

exported routine clink decl_linkage_show(AN: int32); // WARN SM0323@10: is overloaded: C linkage dropped
begin
  println("int32 {}", AN);
end;

exported routine clink decl_linkage_show(AS: string); // WARN SM0323@10: is overloaded: C linkage dropped
begin
  println("string {}", AS);
end;

begin
  decl_linkage_show(1);
  decl_linkage_show("one");
end.
