-------------------------------------------------------------------------------
  type_object_is_err_operand.pcpp - break step of type_object_is.pcpp:
  is on an object with no virtual method (SM0271)

  How to check, from repo\bin:
    pcpp res\tests\type_object_is_err_operand.pcpp
    pcpp res\tests\type_object_is_err_operand.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_is_err_operand;

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;
  TPlain = object
    N: int32;
  end;

routine Check(const AP: TPlain): bool;
begin
  return AP is TPlain; // ERROR SM0271
end;

begin
end.
