-------------------------------------------------------------------------------
  expr_set_literal.pcpp - Expression compliance: set literals

  [e, a..b, ...] (BNF.md sec 6 set literal): elements and ranges of one
  ordinal type (integers of any width are one family); [] is the empty set;
  x in S tests membership, of a set variable or of a literal written in
  place (its elements may be variables). A folded range runs low to high.

  How to check, from repo\bin:
    pcpp res\tests\expr_set_literal.pcpp -r
    pcpp res\tests\expr_set_literal.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    in true false true
    chars true false
    empty false
    literal true false
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_set_literal_err_not_ordinal.pcpp
      a float64 element (SM0266)
    expr_set_literal_err_mixed.pcpp
      an int32 and a char element in one literal (SM0266)
    expr_set_literal_err_low_high.pcpp
      a range whose low bound exceeds its high bound (SM0267)
    expr_set_literal_err_in_element.pcpp
      in with a char against a set of integers (SM0268)
*******************************************************************************/

module exe expr_set_literal;

type
  TDigits = set of 0..9;
  TLetters = set of 'a'..'z';

var
  LD: TDigits;
  LL: TLetters;
  LN: int32 = 4;

begin
  LD := [1, 3..5, 8];
  println("in {} {} {}", 4 in LD, 6 in LD, LN in LD);
  LL := ['a', 'x'..'z'];
  println("chars {} {}", 'y' in LL, 'b' in LL);
  LD := [];
  println("empty {}", 1 in LD);
  println("literal {} {}", LN in [2..6], 9 in [LN, 5]);
end.
