  type_object_init_err_init_in_record.pcpp - break step of type_object_init.pcpp:
  an init in a record: a record is plain data (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_init_in_record.pcpp
    pcpp res\tests\type_object_init_err_init_in_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_init_in_record;

type
  TR = record
    X: int32;
    init(); // ERROR PR0034@5: 'init' is not allowed in a record
    begin
    end;
  end;

begin
end.
