-------------------------------------------------------------------------------
  type_record_err_bit_width.pcpp - break step of type_record.pcpp:
  int32 : 33: a width is 1 .. the type's bits (SM0315)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_bit_width.pcpp
    pcpp res\tests\type_record_err_bit_width.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_bit_width;

type
  TR = record
    B: int32 : 33; // ERROR SM0315@16: bitfield width 33 outside 1..32
  end;

begin
end.
