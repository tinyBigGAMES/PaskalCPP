-------------------------------------------------------------------------------
  intr_print_err_format.pcpp - break step of intr_print.pcpp:
  a format string with more {} than arguments: clang reports it (ZB0016)

  How to check, from repo\bin:
    pcpp res\tests\intr_print_err_format.pcpp
    pcpp res\tests\intr_print_err_format.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_print_err_format;

var
  LN: int32;

begin
  LN := 1;
  println("{} {}", LN); // ERROR ZB0016
end.
