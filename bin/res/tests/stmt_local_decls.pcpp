-------------------------------------------------------------------------------
  stmt_local_decls.pcpp - Statement compliance: var / const / type blocks as statements

  A var, const or type block is a statement in every statement list
  (BNF.md sec 5): in a routine or module body, a loop body, a nested
  begin ... end; block and a match arm, where each keyword takes one item
  (`1: var LY: int32 = 5;`). Its names are visible from it to the end of
  its list.

  How to check, from repo\bin:
    pcpp res\tests\stmt_local_decls.pcpp -r
    pcpp res\tests\stmt_local_decls.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    body 3 4
    type 7
    loop 1 2
    block 10
    arm 5
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    stmt_local_decls_err_duplicate.pcpp
      two locals of one name in one list (SM0004)
    stmt_local_decls_err_no_type.pcpp
      a local var with no type (PR0001)
*******************************************************************************/

module exe stmt_local_decls;

var
  LI: int32;
  LK: int32;

begin
  var LA: int32 = 3;
  const KB: int32 = 4;
  println("body {} {}", LA, KB);
  type TSmall = int8;
  var LS: TSmall = 7;
  println("type {}", LS);
  print("loop");
  for LI := 1 to 2 do
    var LD: int32 = LI;
    print(" {}", LD);
  end;
  println("");
  begin
    var LE: int32 = 10;
    println("block {}", LE);
  end;
  LK := 1;
  match LK of
    1:
      var LY: int32 = 5;
      println("arm {}", LY);
  end;
end.
