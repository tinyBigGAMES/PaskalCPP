-------------------------------------------------------------------------------
  expr_conversion.pcpp - Expression compliance: no hidden conversions

  A value converts implicitly only when every value it can hold is exactly
  representable in the target (BNF.md sec 6): integer widening, float32 to
  float64, a constant that fits. Anything that can lose a value needs an
  explicit cast. An opaque C/C++ value is accepted as it is; clang judges it.

  How to check, from repo\bin:
    pcpp res\tests\expr_conversion.pcpp -r
    pcpp res\tests\expr_conversion.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    widen 100 100
    float 1.5
    constant 127
    explicit 232
    argument 0.75
    opaque 4
    opaque into 5
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_conversion_err_narrow.pcpp
      an int32 variable into an int8 (SM0200)
    expr_conversion_err_argument.pcpp
      an int32 argument for an int8 parameter (SM0404)
*******************************************************************************/

module exe expr_conversion;

#include <cmath>

routine Half(AF: float64): float64;
begin
  return AF / 2.0;
end;

var
  LI8: int8 = 100;
  LI32: int32;
  LI64: int64;
  LF32: float32 = 1.5;
  LF64: float64;
  LBig: int32 = 1000;
  LU8: uint8;

begin
  LI32 := LI8;
  LI64 := LI32;
  println("widen {} {}", LI32, LI64);
  LF64 := LF32;
  println("float {}", LF64);
  LI8 := 127;
  println("constant {}", LI8);
  LU8 := uint8(LBig);
  println("explicit {}", LU8);
  println("argument {}", Half(LF32));
  println("opaque {}", std::sqrt(16.0));
  LF64 := std::sqrt(25.0);
  println("opaque into {}", LF64);
end.
