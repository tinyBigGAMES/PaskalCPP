module exe type_array_err_too_large_param;

type
  TBig = array[0..288230376151711743] of int32;

routine Take(AB: TBig): int32; // ERROR SM0277@18: 'TBig' is too large: a type holds at most 1152921504606846975 bytes
begin
  return 0;
end;

begin
end.
