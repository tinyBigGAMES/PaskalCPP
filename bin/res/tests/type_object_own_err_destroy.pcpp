-------------------------------------------------------------------------------
  type_object_own_err_destroy.pcpp - break step of type_object_own.pcpp:
  destroy on an object: the own / ref that holds it frees it (SM0361)

  How to check, from repo\bin:
    pcpp res\tests\type_object_own_err_destroy.pcpp
    pcpp res\tests\type_object_own_err_destroy.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_own_err_destroy;

type
  TPlain = object
    X: int32;
  end;

routine Use(AP: ptr to TPlain);
begin
  destroy(AP); // ERROR SM0361@11: destroy does not free an object
end;

begin
end.
