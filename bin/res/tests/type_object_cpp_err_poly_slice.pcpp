-------------------------------------------------------------------------------
  type_object_cpp_err_poly_slice.pcpp - break step of type_object_cpp.pcpp:
  an object polymorphic through its C++ base assigned to an ancestor by value (SM0428)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_poly_slice.pcpp
    pcpp res\tests\type_object_cpp_err_poly_slice.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_poly_slice;

struct CNode {
  virtual ~CNode() = default;
  virtual int kind() { return 1; }
};

type
  TA = object(CNode)
    N: int32;
  end;
  TB = object(TA)
    M: int32;
  end;

var
  LA: TA;
  LB: TB;
begin
  LA := LB; // ERROR SM0428
  println("{}", LA.N);
end.
