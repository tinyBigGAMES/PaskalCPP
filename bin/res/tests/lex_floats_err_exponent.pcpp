  lex_floats_err_exponent.pcpp - break step of lex_floats.pcpp:
  an exponent with no digits (LX0005)

  How to check, from repo\bin:
    pcpp res\tests\lex_floats_err_exponent.pcpp
    pcpp res\tests\lex_floats_err_exponent.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_floats_err_exponent;

var
  LF: float64;

begin
  LF := 0.0;
  LF := 1.5e; // ERROR LX0005@9: Malformed numeric literal: 1.5e
end.
