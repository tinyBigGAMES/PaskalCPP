-------------------------------------------------------------------------------
  type_object_cpp_err_const_call.pcpp - break step of type_object_cpp.pcpp:
  a const method that calls a method that is not const through self (SM0388)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_const_call.pcpp
    pcpp res\tests\type_object_cpp_err_const_call.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_const_call;

type
  TBox = object
    N: int32;
    method Grow();
    begin
      self.N := self.N + 1;
    end;
    const method Peek(): int32;
    begin
      self.Grow(); // ERROR SM0388
      return self.N;
    end;
  end;

begin
end.
