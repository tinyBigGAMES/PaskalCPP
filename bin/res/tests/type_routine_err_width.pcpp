-------------------------------------------------------------------------------
  type_routine_err_width.pcpp - break step of type_routine.pcpp:
  the : after a routine type's parameters is its return type: a routine-typed field takes no bitfield width (PR0001)

  How to check, from repo\bin:
    pcpp res\tests\type_routine_err_width.pcpp
    pcpp res\tests\type_routine_err_width.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_routine_err_width;

type
  TA = record
    F: routine(AN: int32): 3; // ERROR PR0001@28: expected a type
  end;

begin
end.
