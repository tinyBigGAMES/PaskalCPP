-------------------------------------------------------------------------------
  lex_floats_err_overflow.pcpp - Lexical: a float no float64 holds

  Break step of lex_floats: 1e400 is above the largest float64, LX0006.
*******************************************************************************/

module exe lex_floats_err_overflow;

/*
  @@test
    kind error
  @@end
*/

var
  LF: float64;

begin
  LF := 0.0;
  LF := 1e400; // ERROR LX0006@9: Numeric literal out of range: 1e400
end.
