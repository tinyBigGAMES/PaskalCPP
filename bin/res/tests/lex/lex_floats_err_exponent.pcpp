-------------------------------------------------------------------------------
  lex_floats_err_exponent.pcpp - Lexical: an exponent with no digits

  Break step of lex_floats: an e with no digits after it leaves no valid
  number, LX0005 (the message shows the literal as written).
*******************************************************************************/

module exe lex_floats_err_exponent;

/*
  @@test
    kind error
  @@end
*/

var
  LF: float64;

begin
  LF := 0.0;
  LF := 1.5e; // ERROR LX0005@9: Malformed numeric literal: 1.5e
end.
