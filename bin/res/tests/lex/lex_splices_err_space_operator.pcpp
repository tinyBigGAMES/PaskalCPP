-------------------------------------------------------------------------------
  lex_splices_err_space_operator.pcpp - Lexical: a blank after a splice inside an operator

  Break step of lex_splices: a blank after a splice's backslash inside an
  operator (< + < is <<) is one LX0201, a warning at the backslash: the
  operator still joins and the module builds. The marked line ends in
  the splice, so its marker is a block-comment marker.
  Its bytes are part of the test (see above): edit it with an editor
  that keeps them as they are.
*******************************************************************************/

module exe lex_splices_err_space_operator;

/*
  @@test
    kind build
  @@end
*/

var
  LN: int32;

begin
  LN := /* // WARN LX0201@40 // */ 1 <\ 
< 3;
end.
