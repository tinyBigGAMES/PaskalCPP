  lex_strings_err_char.pcpp - Lexical: an empty character literal

  Break step of lex_strings: '' holds no character, PR0054.
*******************************************************************************/

module exe lex_strings_err_char;

/*
  @@test
    kind error
  @@end
*/

var
  LC: char;

begin
  LC := 'a';
  LC := ''; // ERROR PR0054@9: invalid character literal: empty character constant
end.
