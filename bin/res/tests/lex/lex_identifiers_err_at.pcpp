-------------------------------------------------------------------------------
  lex_identifiers_err_at.pcpp - Lexical: an @ with no directive name

  Break step of lex_identifiers: @ starts a directive, so an @ with no
  name after it is LX0009.
*******************************************************************************/

module exe lex_identifiers_err_at;

/*
  @@test
    kind error
  @@end
*/

begin
  @ // ERROR LX0009@3: '@' must be followed by a directive name
end.
