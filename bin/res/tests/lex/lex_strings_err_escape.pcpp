-------------------------------------------------------------------------------
  lex_strings_err_escape.pcpp - Lexical: an octal escape above 255

  Break step of lex_strings: \400 does not fit a char, PR0009 (the escape
  is decoded the way clang decodes it, and reported the way clang words it).
*******************************************************************************/

module exe lex_strings_err_escape;

/*
  @@test
    kind error
  @@end
*/

begin
  println("{}", "\400"); // ERROR PR0009@17: invalid string literal: octal escape sequence out of range
end.
