-------------------------------------------------------------------------------
  lex_integers_err_octal.pcpp - Lexical: an 8 in an octal literal

  Break step of lex_integers: a leading 0 makes the literal octal, so an 8
  or 9 in it is LX0007 (the hint a plain octal gets is not given then).
*******************************************************************************/

module exe lex_integers_err_octal;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int64;

begin
  LN := 0;
  LN := 08; // ERROR LX0007@9: Invalid digit in octal literal: 08
end.
