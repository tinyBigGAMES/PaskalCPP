-------------------------------------------------------------------------------
  lex_strings_err_delimiter.pcpp - Lexical: a raw string delimiter too long

  Break step of lex_strings: a raw string's delimiter is at most 16
  characters (C++), so a 17-character one is LX0010.
*******************************************************************************/

module exe lex_strings_err_delimiter;

/*
  @@test
    kind error
  @@end
*/

begin
  println(R"abcdefghijklmnopq(x)abcdefghijklmnopq"); // ERROR LX0010@11: Invalid raw string delimiter
end.
