-------------------------------------------------------------------------------
  lex_strings_err_unknown_escape_char.pcpp - Lexical: an unknown escape in a char

  Break step of lex_strings: \q in a character literal is PR0064, a
  warning, reported once. The character is the q, so the program prints q.
*******************************************************************************/

module exe lex_strings_err_unknown_escape_char;

/*
  @@test
    kind run
    expect
    | q
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

begin
  println("{}", '\q'); // WARN PR0064@17: character literal: unknown escape sequence '\q'
end.
