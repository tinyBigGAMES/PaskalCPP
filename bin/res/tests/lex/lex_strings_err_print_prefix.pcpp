-------------------------------------------------------------------------------
  lex_strings_err_print_prefix.pcpp - Lexical: printing a u8 string

  Break step of lex_strings: a u8"..." literal lexes, but its C++ type
  (const char8_t[]) has no std::formatter, so printing it is SM0425, and
  the message names the argument as written.
*******************************************************************************/

module exe lex_strings_err_print_prefix;

/*
  @@test
    kind error
  @@end
*/

begin
  println("{}", u8"abc"); // ERROR SM0425@17: 'u8"abc"' cannot be printed
end.
