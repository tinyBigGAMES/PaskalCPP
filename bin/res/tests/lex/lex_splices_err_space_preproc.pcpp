-------------------------------------------------------------------------------
  lex_splices_err_space_preproc.pcpp - Lexical: a blank after a splice on a # line

  Break step of lex_splices: a blank between a backslash and its newline
  on a # line still makes a splice, LX0201, a warning at the backslash:
  the # line still goes on to the next line (LX_SUM is 1 + 2) and the
  module builds. The marked line ends in the splice, so its marker is a
  block-comment marker.
  Its bytes are part of the test (see above): edit it with an editor
  that keeps them as they are.
*******************************************************************************/

module exe lex_splices_err_space_preproc;

/*
  @@test
    kind build
  @@end
*/

#define LX_SUM 1 /* // WARN LX0201@46 // */ \ 
  + 2

var
  LN: int32;

begin
  LN := LX_SUM;
end.
