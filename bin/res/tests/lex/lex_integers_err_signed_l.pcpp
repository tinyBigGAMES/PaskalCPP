-------------------------------------------------------------------------------
  lex_integers_err_signed_l.pcpp - Lexical: above int64 with the l suffix

  Break step of lex_integers: l (like L, ll and LL) keeps a decimal literal
  signed, so one above int64 is LX0006, and the message puts the u before
  the suffix (ul).
*******************************************************************************/

module exe lex_integers_err_signed_l;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int64;

begin
  LN := 0;
  LN := 9223372036854775808l; // ERROR LX0006@9: write 9223372036854775808ul
end.
