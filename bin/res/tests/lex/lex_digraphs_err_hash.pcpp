-------------------------------------------------------------------------------
  lex_digraphs_err_hash.pcpp - Lexical: a %: not first on its line

  Break step of lex_digraphs: %: is # only as a preprocessor line's start,
  so one after other tokens on its line is LX0008.
*******************************************************************************/

module exe lex_digraphs_err_hash;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 1;
  LN := 2; %: // ERROR LX0008@12: '%:' must be the first token on its line
end.
