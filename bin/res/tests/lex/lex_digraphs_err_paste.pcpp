-------------------------------------------------------------------------------
  lex_digraphs_err_paste.pcpp - Lexical: %:%: after other tokens

  Break step of lex_digraphs: %:%: (##) after other tokens on its line is
  two %: digraphs, and each is LX0008 (a %: must be the first token on its
  line): one mistake, two reports.
*******************************************************************************/

module exe lex_digraphs_err_paste;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int32;

begin
  LN := 1;
  LN := 2; %:%: // ERROR LX0008@12 // ERROR LX0008@14
end.
