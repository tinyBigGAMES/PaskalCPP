-------------------------------------------------------------------------------
  lex_strings_err_unterminated.pcpp - Lexical: a string with no closing quote

  Break step of lex_strings: a string literal ends at its line's end at the
  latest, so one with no closing quote is LX0001, where it starts.
*******************************************************************************/

module exe lex_strings_err_unterminated;

/*
  @@test
    kind error
  @@end
*/

begin
  println("never closed); // ERROR LX0001@11: Unterminated string or character literal
end.
