-------------------------------------------------------------------------------
  lex_strings_prefixes.pcpp - Lexical: the cstring prefixes u8, u and U, on
  plain and raw strings

  BNF.md sec 9: a cstring takes the prefix u8, u, U or L, a raw string the
  same prefixes before R". The prefix decides the code unit (1, 2 and 4
  bytes), so the size of "ab" with its terminating zero is 3, 6 and 12;
  the raw form keeps the same unit. L is the target's wchar_t (2 or 4
  bytes) and has its own tests.
*******************************************************************************/

module exe lex_strings_prefixes;

/*
  @@test
    kind run
    expect
    | plain 3 6 12
    | raw 3 6 12
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

begin
  println("plain {} {} {}", sizeof(u8"ab"), sizeof(u"ab"), sizeof(U"ab"));
  println("raw {} {} {}", sizeof(u8R"(ab)"), sizeof(uR"(ab)"), sizeof(UR"(ab)"));
end.
