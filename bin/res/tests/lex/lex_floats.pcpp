-------------------------------------------------------------------------------
  lex_floats.pcpp - Lexical: float literals

  Float literals follow C++ (BNF.md sec 9): 1.5, 1. and .5; an exponent
  with either letter case and an optional sign (1e3, 2.5e-2, 1.5e+2, 2E2);
  a hex float with its binary exponent (0x1.8p3 is 12, 0x1p-2 is 0.25); a
  suffix (2.5f is a float32); the ' digit separator. 1..5 is not a float:
  it is 1, .. and 5, a range.
*******************************************************************************/

module exe lex_floats;

/*
  @@test
    kind run
    expect
    | 1.5 1 0.5
    | 1000 0.025
    | 150 200
    | hex float 12 0.25
    | float32 2.5
    | separator 1000.5
    | range 5
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

var
  LA: array[1..5] of int32;

begin
  println("{} {} {}", 1.5, 1., .5);
  println("{} {}", 1e3, 2.5e-2);
  println("{} {}", 1.5e+2, 2E2);
  println("hex float {} {}", 0x1.8p3, 0x1p-2);
  println("float32 {}", 2.5f);
  println("separator {}", 1'000.5);
  println("range {}", len(LA));
end.
