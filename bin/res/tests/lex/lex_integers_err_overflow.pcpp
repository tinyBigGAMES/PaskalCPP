-------------------------------------------------------------------------------
  lex_integers_err_overflow.pcpp - Lexical: a literal above uint64

  Break step of lex_integers: one more than the largest uint64 has no type,
  even with a u suffix, LX0006.
*******************************************************************************/

module exe lex_integers_err_overflow;

/*
  @@test
    kind error
  @@end
*/

var
  LN: int64;

begin
  LN := 0;
  LN := 18446744073709551616u; // ERROR LX0006@9: Numeric literal out of range: 18446744073709551616u
end.
