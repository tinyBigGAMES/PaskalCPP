-------------------------------------------------------------------------------
  lex_splices_err_cppstart.pcpp - Lexical: a cppstart block ending in a splice

  Break step of lex_splices: the last line of a cppstart block's C++ ending
  in a splice would join cppend into the C++, LX0014 at the backslash. The
  marked line ends in that splice, so its marker is a block-comment marker.
*******************************************************************************/

module exe lex_splices_err_cppstart;

/*
  @@test
    kind error
  @@end
*/

cppstart source
int GX = 1; /* // ERROR LX0014@41 // */ \
cppend;

begin
  println("{}", 1);
end.
