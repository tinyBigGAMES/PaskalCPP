-------------------------------------------------------------------------------
  lex_strings_err_raw.pcpp - Lexical: a raw string with no closing )"

  Break step of lex_strings: a raw string runs over lines until its )"
  (with its delimiter), so one that never meets it is LX0002, where it
  starts.
*******************************************************************************/

module exe lex_strings_err_raw;

/*
  @@test
    kind error
  @@end
*/

begin
  println(R"(never closed); // ERROR LX0002@11: Unterminated raw string literal
end.
