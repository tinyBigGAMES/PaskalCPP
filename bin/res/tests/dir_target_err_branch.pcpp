-------------------------------------------------------------------------------
  dir_target_err_branch.pcpp - break step of dir_target.pcpp: @target inside
  an @ifdef branch (a target cannot depend on a symbol; it is not applied)

  How to check, from repo\bin:
    pcpp res\tests\dir_target_err_branch.pcpp
    pcpp res\tests\dir_target_err_branch.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe dir_target_err_branch;
@ifdef PASKALCPP
@target "x86_64-windows-gnu"; // ERROR CD0006@1: cannot stand inside a conditional branch
@endif

begin
end.
