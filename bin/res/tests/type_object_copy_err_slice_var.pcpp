-------------------------------------------------------------------------------
  type_object_copy_err_slice_var.pcpp - break step of type_object_copy.pcpp:
  a polymorphic object assigned through a var parameter: it may be a descendant (SM0429)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_slice_var.pcpp
    pcpp res\tests\type_object_copy_err_slice_var.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_slice_var;

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
  end;

routine Reset(var AA: TA);
var
  LB: TA;
begin
  AA := LB; // ERROR SM0429@3: 'AA' may hold a descendant of 'TA' (it is polymorphic)
end;

begin
end.
