-------------------------------------------------------------------------------
  expr_arithmetic_err_min_div.pcpp - break step of expr_arithmetic.pcpp:
  the minimum int32 div -1 (SM0258)

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic_err_min_div.pcpp
    pcpp res\tests\expr_arithmetic_err_min_div.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_arithmetic_err_min_div;

var
  LN: int32;

begin
  LN := (-2147483647 - 1) div -1; // ERROR SM0258: overflows
end.
