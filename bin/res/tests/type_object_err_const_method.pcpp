-------------------------------------------------------------------------------
  type_object_err_const_method.pcpp - break step of type_object.pcpp:
  a method called through a const parameter: a method may change its object, pass it var (SM0426)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_const_method.pcpp
    pcpp res\tests\type_object_err_const_method.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_const_method;

type
  TA = object
    N: int32;
    method Bump();
    begin
      self.N := self.N + 1;
    end;
  end;

routine Touch(const AA: TA);
begin
  AA.Bump(); // ERROR SM0426@3: method 'Bump' may change its object, which is const here: pass it var
end;

begin
end.
