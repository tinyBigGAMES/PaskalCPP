-------------------------------------------------------------------------------
  lsp_definition.pcpp - LSP compliance: go to definition

  F12 (or Ctrl+click) on a name jumps to the name in its declaration.

  How to check: put the cursor on each name a CHECK line names (on the code
  line below it), press F12 and compare where the cursor lands with the
  text after "->".
  Needs lsp_unit.pcpp in the same folder.
*******************************************************************************/

module exe lsp_definition;

/*
  @@test
    kind manual
  @@end
*/

@addmodulepath "$P:res/tests/lsp/fixtures";
// CHECK: lsp_unit (this import) -> opens lsp_unit.pcpp at its module name
import lsp_unit;

type
  TColour = choices(cRed, cGreen, cBlue);

forward routine Twin(const AA: int32): int32;

routine Pick(const AN: int32);
begin
end;

routine Pick(const AS: string);
begin
end;

// The full declaration of the forward above
routine Twin(const AA: int32): int32;
begin
  return AA;
end;

var
  GCount: int32;
  GColour: TColour;

begin
  // CHECK: GCount (the first one) -> its declaration in the var block
  // CHECK: Twin -> the FULL routine (below the Pick routines), not the
  //                forward line
  GCount := Twin(1);

  // CHECK: Pick -> the Pick(const AN: int32) routine only (an overload set:
  //                only that routine takes an int32, so the call is that one)
  Pick(GCount);

  // CHECK: Pick -> a list with BOTH Pick routines (a C++ value: every Pick
  //                takes it, so which one is called is C++'s)
  Pick(cpp("1"));

  // CHECK: GCount (after for) -> its declaration in the var block
  for GCount := 1 to 3 do
    Pick("x");
  end;

  // CHECK: cGreen -> the value cGreen inside choices(...)
  // CHECK: TColour -> the type TColour
  GColour := TColour.cGreen;

  // CHECK: lsp_unit -> opens lsp_unit.pcpp at its module name
  // CHECK: Twice    -> opens lsp_unit.pcpp at the routine Twice
  GCount := lsp_unit.Twice(GCount);

  // CHECK: Twin on the forward line above -> the full routine Twin
end.
