-------------------------------------------------------------------------------
  stmt_repeat_err_condition.pcpp - break step of stmt_repeat.pcpp:
  an int32 until condition: a condition is bool (SM0263)

  How to check, from repo\bin:
    pcpp res\tests\stmt_repeat_err_condition.pcpp
    pcpp res\tests\stmt_repeat_err_condition.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_repeat_err_condition;

var
  LN: int32;

begin
  LN := 1;
  repeat
    LN := 0;
  until LN; // ERROR SM0263@9: a condition is bool
end.
