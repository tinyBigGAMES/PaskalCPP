  intr_len_err_value.pcpp - break step of intr_len.pcpp:
  len named as a value, not called (SM0423)

  How to check, from repo\bin:
    pcpp res\tests\intr_len_err_value.pcpp
    pcpp res\tests\intr_len_err_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_len_err_value;

var
  LN: int64;

begin
  LN := len; // ERROR SM0423@9: 'len' is an intrinsic: it is called
end.
