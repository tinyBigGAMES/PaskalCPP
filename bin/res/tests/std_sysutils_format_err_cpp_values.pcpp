-------------------------------------------------------------------------------
  std_sysutils_format_err_cpp_values.pcpp - break step of
  std_sysutils_format.pcpp: two C++ values with no std::formatter as
  arguments (SM0425 once, at the call: which C++ type has a formatter is
  clang's to know, not PaskalCPP's)

  How to check, from repo\bin:
    pcpp res\tests\std_sysutils_format_err_cpp_values.pcpp
    pcpp res\tests\std_sysutils_format_err_cpp_values.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe std_sysutils_format_err_cpp_values;

import
  SysUtils;

struct CNo {
  int x;
};

struct CAlso {
  int y;
};

var
  LValue: CNo;
  LOther: CAlso;
  LText: string;

begin
  LValue.x := 1;
  LOther.y := 2;
  LText := FormatStr("{} {}", LValue, LOther); // ERROR SM0425@12
  println("{}", LText);
end.
