-------------------------------------------------------------------------------
  expr_relational_err_mixed_sign.pcpp - break step of expr_relational.pcpp:
  an int32 compared with a uint32 (SM0200 at the int32): two numbers compare
  in their common type, here uint32, so -1 < 1 would be false; write
  int64(LA) < LU

  How to check, from repo\bin:
    pcpp res\tests\expr_relational_err_mixed_sign.pcpp
    pcpp res\tests\expr_relational_err_mixed_sign.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_relational_err_mixed_sign;

var
  LA: int32 = -1;
  LU: uint32 = 1;

begin
  if LA < LU then // ERROR SM0200@6: 'int32' does not convert implicitly to 'uint32'
    println("less");
  end;
end.
