  type_object_init_unit.pcpp - a unit type_object_init.pcpp imports: an
  exported object TCounter with an init, a done and a method (declared in
  the unit's header, defined in its source).

  Nothing to check here: type_object_init.pcpp checks it.
*******************************************************************************/

module unit type_object_init_unit;

exported type
  TCounter = object
    Count: int32;
    init(const AStart: int32);
    begin
      self.Count := AStart;
      println("counter starts at {}", self.Count);
    end;
    done;
    begin
      println("counter ends at {}", self.Count);
    end;
    method Step();
    begin
      self.Count := self.Count + 1;
    end;
  end;

end.
