-------------------------------------------------------------------------------
  type_record_err_compare_array.pcpp - break step of type_record.pcpp:
  an array compares element by element, so an array of records has no
  comparison (SM0252); an array of int32 compares

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_compare_array.pcpp
    pcpp res\tests\type_record_err_compare_array.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_compare_array;

type
  TPoint = record
    X: int32;
    Y: int32;
  end;

var
  LA: array[0..1] of TPoint;
  LB: array[0..1] of TPoint;
  LI: array[0..1] of int32;
  LJ: array[0..1] of int32;
  LSame: bool;

begin
  LSame := LI = LJ;
  LSame := LA = LB; // ERROR SM0252@12: cannot compare 'array[0..1] of TPoint'
end.
