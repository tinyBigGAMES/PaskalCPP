-------------------------------------------------------------------------------
  stmt_match_err_label_repeat.pcpp - break step of stmt_match.pcpp:
  a label two arms hold (SM0605)

  How to check, from repo\bin:
    pcpp res\tests\stmt_match_err_label_repeat.pcpp
    pcpp res\tests\stmt_match_err_label_repeat.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_match_err_label_repeat;

var
  LN: int32;

begin
  LN := 1;
  match LN of
    1: println("a");
    2, 1: println("b"); // ERROR SM0605@8: repeats a label of the arm at line
  end;
end.
