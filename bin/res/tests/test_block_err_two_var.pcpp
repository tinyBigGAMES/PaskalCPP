  test_block_err_two_var.pcpp - break step of test_block.pcpp:
  a second var block before a test's begin (PR0025)

  How to check, from repo\bin:
    pcpp res\tests\test_block_err_two_var.pcpp
    pcpp res\tests\test_block_err_two_var.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe test_block_err_two_var;

begin
end.

test "two var blocks"
var
  LA: int32;
var // ERROR PR0025@1: found 'var'
  LB: int32;
begin
  LA := 1;
  LB := 2;
  testAssertEqualInt(3, LA + LB);
end;
