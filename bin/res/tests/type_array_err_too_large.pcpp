-------------------------------------------------------------------------------
  type_array_err_too_large.pcpp - break step of type_array.pcpp:
  no type holds more than 1152921504606846975 bytes: one element more (SM0277)

  How to check, from repo\bin:
    pcpp res\tests\type_array_err_too_large.pcpp
    pcpp res\tests\type_array_err_too_large.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_array_err_too_large;

type
  TA = array[0..1152921504606846975] of uint8; // ERROR SM0277@8: 'array[0..1152921504606846975] of uint8' is too large: a type holds at most 1152921504606846975 bytes

begin
end.
