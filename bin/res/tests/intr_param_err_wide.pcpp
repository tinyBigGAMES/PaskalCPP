  intr_param_err_wide.pcpp - break step of intr_param.pcpp:
  paramstr given an int64 index (SM0409)

  How to check, from repo\bin:
    pcpp res\tests\intr_param_err_wide.pcpp
    pcpp res\tests\intr_param_err_wide.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_param_err_wide;

var
  LN: int64 = 4294967297;

begin
  println("{}", paramstr(LN)); // ERROR SM0409@26: 'paramstr' takes (int32)
end.
