-------------------------------------------------------------------------------
  expr_record_literal.pcpp - Expression compliance: record literals

  T(F: v, G: w) (BNF.md sec 6 record literal) builds a record value: the
  fields it names in declaration order, each once; a field it leaves out
  starts at zero. Literals nest and pass as arguments. A record with a
  C/C++ parent has no record literal (its C++ part is not PaskalCPP's).

  How to check, from repo\bin:
    pcpp res\tests\expr_record_literal.pcpp -r
    pcpp res\tests\expr_record_literal.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    point 3 4
    omitted 0 9
    nested 2 5 diag
    argument 25
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_record_literal_err_cpp_parent.pcpp
      a record literal of a record with a C++ parent (SM0413)
    expr_record_literal_err_no_field.pcpp
      a field the record does not have (SM0414)
    expr_record_literal_err_twice.pcpp
      a field given twice (SM0415)
    expr_record_literal_err_order.pcpp
      fields out of declaration order (SM0416)
*******************************************************************************/

module exe expr_record_literal;

type
  TP = record
    X: int32;
    Y: int32;
  end;
  TLine = record
    A: TP;
    B: TP;
    Tag: string;
  end;

routine Len2(AP: TP): int32;
begin
  return AP.X * AP.X + AP.Y * AP.Y;
end;

var
  LP: TP;
  LL: TLine;

begin
  LP := TP(X: 3, Y: 4);
  println("point {} {}", LP.X, LP.Y);
  LP := TP(Y: 9);
  println("omitted {} {}", LP.X, LP.Y);
  LL := TLine(A: TP(X: 1, Y: 2), B: TP(X: 5, Y: 6), Tag: "diag");
  println("nested {} {} {}", LL.A.Y, LL.B.X, LL.Tag);
  println("argument {}", Len2(TP(X: 3, Y: 4)));
end.
