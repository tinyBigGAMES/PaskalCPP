-------------------------------------------------------------------------------
  lib_runtime_host.pcpp - Build-kind compliance: a PaskalCPP program that links
  lib_runtime (see lib_runtime.pcpp)

  Links lib_runtime by name from each target's folder; the program's own
  runtime serves the lib too, so a raise inside the lib reaches this guard.

  How to check, from repo\bin (lib_runtime.pcpp's two commands first):
    pcpp res\tests\lib_runtime_host.pcpp -r
    pcpp res\tests\lib_runtime_host.pcpp -r -t x86_64-linux-gnu
  EXPECT:
    lib_rt_div(7, 2) = 3
    caught from the lib: Divide by zero
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.
*******************************************************************************/

module exe lib_runtime_host;
@addlibrarypath "$P:output/lib";
@linklibrary "lib_runtime";

routine clink lib_rt_div(AA: int32; AB: int32): int32; external;

begin
  println("lib_rt_div(7, 2) = {}", lib_rt_div(7, 2));
  guard
    println("{}", lib_rt_div(1, 0));
  except
    println("caught from the lib: {}", excmsg());
  end;
end.
