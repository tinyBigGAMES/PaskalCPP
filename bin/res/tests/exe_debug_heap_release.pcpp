-------------------------------------------------------------------------------
  exe_debug_heap_release.pcpp - Build-kind compliance: no heap report in a release build

  The same program as exe_debug_heap.pcpp built with @optimize release_fast:
  the heap is not counted and nothing is reported at shutdown.

  How to check, from repo\bin:
    pcpp res\tests\exe_debug_heap_release.pcpp -r
    pcpp res\tests\exe_debug_heap_release.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    blocks taken
    final
  EXITCODE: 0
*******************************************************************************/

module exe exe_debug_heap_release;
@optimize release_fast;

var
  LKept: ptr;
  LFreed: ptr;

finalize
begin
  println("final");
end;

begin
  LKept := getmem(16);
  LFreed := getmem(32);
  freemem(LFreed);
  println("blocks taken");
end.
