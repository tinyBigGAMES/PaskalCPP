-------------------------------------------------------------------------------
  lex_splices_err_space.pcpp - break step of lex_splices.pcpp:
  a space between the backslash and the newline (LX0201, a warning: still a splice)

  How to check, from repo\bin:
    pcpp res\tests\lex_splices_err_space.pcpp
    pcpp res\tests\lex_splices_err_space.pcpp -t x86_64-linux-gnu
  The marked line reports that warning; nothing else is reported.
*******************************************************************************/

module exe lex_splices_err_space;

var
  LN: int32;
  LValue: int32 = 2;

begin
  LN := /* // WARN LX0201@44 // */ 1 + LVa\ 
lue;
end.
