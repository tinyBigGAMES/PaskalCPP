-------------------------------------------------------------------------------
  lex_integers.pcpp - Lexical compliance: integer literals

  Integer literals follow C++ (BNF.md sec 9): decimal, octal (a leading 0:
  010 is 8, with a hint), hex, binary, a ' digit separator, the standard
  suffixes, and a suffix that is none of them is a C++ user-defined literal
  (3_k calls the operator the mixed C++ declares). A decimal literal above
  int64 needs a u suffix; hex, octal and binary go up to uint64 as they are.

  How to check, from repo\bin:
    pcpp res\tests\lex_integers.pcpp -r
    pcpp res\tests\lex_integers.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    decimal 1234
    octal 8
    hex 255 255
    binary 10
    separators 1000000 65535
    suffixes 7 7 7 7 7
    int64 max 9223372036854775807
    uint64 max 18446744073709551615 18446744073709551615
    udl 3000
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.
  The octal line is marked: its hint is reported on every build.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    lex_integers_err_octal.pcpp
      an 8 in an octal literal (LX0007)
    lex_integers_err_shape.pcpp
      a binary literal with a 2 in it (LX0005)
    lex_integers_err_overflow.pcpp
      a literal above uint64, even with a u suffix (LX0006)
    lex_integers_err_signed.pcpp
      a decimal literal above int64 without u (LX0006, the hint names the u)
    lex_integers_err_signed_l.pcpp
      the same with the signed suffix l (LX0006; L, ll and LL are the same rows)
    lex_integers_err_signed_z.pcpp
      the same with the signed suffix z (LX0006; Z is the same row)
*******************************************************************************/

module exe lex_integers;

long long operator""_k(unsigned long long AValue) { return static_cast<long long>(AValue * 1000); }

begin
  println("decimal {}", 1234);
  println("octal {}", 010); // HINT LX0101@23: Leading zero: 010 is an octal literal
  println("hex {} {}", 0xFF, 0Xff);
  println("binary {}", 0b1010);
  println("separators {} {}", 1'000'000, 0xFF'FF);
  println("suffixes {} {} {} {} {}", 7u, 7l, 7ll, 7z, 7ULL);
  println("int64 max {}", 9223372036854775807);
  println("uint64 max {} {}", 18446744073709551615u, 0xFFFFFFFFFFFFFFFF);
  println("udl {}", 3_k);
end.
