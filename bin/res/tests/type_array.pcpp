-------------------------------------------------------------------------------
  type_array.pcpp - Type compliance: array types

  An array type (BNF.md sec 4: array type) is static, array[lo..hi] of T,
  or dynamic, array of T (array[] of T is the same). Every part of the
  production is used here and what it does is printed:
  - static bounds that are integer constants (a const, a negative low bound,
    a low bound other than 0), char constants (TLetters, indexed by a char)
    or values of one choices type (TNames, indexed by a value); len gives
    the element count, size the bytes; print shows every element;
  - an array of arrays (TGrid, LG[1][2]), an array field and a dynamic
    array field of a record (THolder);
  - a static array is a value: := copies it, a value parameter and a
    return value are copies, = compares element by element; a var
    parameter writes the caller's array, a const one reads it;
  - a dynamic array is sized by setlength (new elements start zeroed),
    also through a var parameter.

  How to check, from repo\bin:
    pcpp res\tests\type_array.pcpp -r
    pcpp res\tests\type_array.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    quad [1, 2, 3, 4] sum 10 len 4 size 16
    copy 1 9 same false
    equal true
    doubled [2, 4, 6, 8] kept 4
    row [5, 10, 15] first 5 last 15
    grid 7 [[0, 0, 0], [0, 0, 7]]
    offset 10 20 len 5
    letters 3 [0, 0, 3, 0, 0]
    names red blue len 3
    dynamic [0, 0, 8] len 3
    open ["x", "y"]
    holder 4 6 len 1
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR comment on its marked line says, and nothing else:
    type_array_err_bounds_family.pcpp   both bounds are of one family
    type_array_err_bounds_float.pcpp    an integer, char or choices one
    type_array_err_bounds_bool.pcpp     (bool is none of them)
    type_array_err_bound_order.pcpp     the low bound is not above the high
    type_array_err_bound_order_char.pcpp  (char bounds too)
    type_array_err_bound_variable.pcpp  a bound is a constant
    type_array_err_single_bound.pcpp    a static array names both bounds
    type_array_err_no_of.pcpp           of comes before the element type
    type_array_err_index_float.pcpp     an index is an integer
    type_array_err_index_char.pcpp      a char-bounded array takes a char
    type_array_err_index_choices.pcpp   a choices-bounded one a value
    type_array_err_index_outside.pcpp   a constant index lies inside the
                                        bounds (not above the high one,
    type_array_err_index_below.pcpp     not below the low one,
    type_array_err_index_outside_char.pcpp  a char index too)
    type_array_err_not_indexable.pcpp   an int32 is no array
    type_array_err_dynamic_to_static.pcpp  a dynamic array is no static one
    type_array_err_length.pcpp          two static arrays of other bounds
                                        are other types
    type_array_err_element.pcpp         and of other element types
    type_array_err_too_large.pcpp       no type holds more than
                                        1152921504606846975 bytes:
                                        one element more,
    type_array_err_too_large_range.pcpp   a full int64 range,
    type_array_err_too_large_element.pcpp  the elements' size together
    type_array_err_too_large_param.pcpp   (where a parameter holds it,
    type_array_err_too_large_deref.pcpp   where an expression reads it)
  An array of records compared is type_record_err_compare_array.pcpp; an
  array of objects, the type_object_* files.
*******************************************************************************/

module exe type_array;

const
  KLast: int32 = 3;

type
  TColor = choices(cRed, cGreen, cBlue);
  TQuad = array[0..KLast] of int32;
  TRow = array[1..3] of int32;
  TGrid = array[0..1] of array[0..2] of int32;
  TOffset = array[-2..2] of int32;
  TLetters = array['A'..'E'] of int32;
  TNames = array[TColor.cRed..TColor.cBlue] of string;
  TList = array of int32;
  TOpen = array[] of string;
  TPoint = record
    X: int32;
    Y: int32;
  end;
  THolder = record
    Cells: array[0..1] of int32;
    Items: array of TPoint;
  end;

routine Sum(const AQ: TQuad): int32;
var
  LI: int32;
  LS: int32 = 0;
begin
  for LI := 0 to KLast do
    LS := LS + AQ[LI];
  end;
  return LS;
end;

routine Fill(var AR: TRow; const AV: int32);
var
  LI: int32;
begin
  for LI := 1 to 3 do
    AR[LI] := AV * LI;
  end;
end;

routine Doubled(AQ: TQuad): TQuad;
var
  LI: int32;
  LOut: TQuad;
begin
  LOut := AQ;
  for LI := 0 to KLast do
    LOut[LI] := LOut[LI] * 2;
  end;
  return LOut;
end;

routine Grow(var AL: TList; const AN: int64);
begin
  setlength(AL, AN);
end;

var
  LQ: TQuad;
  LCopy: TQuad;
  LR: TRow;
  LG: TGrid;
  LO: TOffset;
  LL: TLetters;
  LN: TNames;
  LD: TList;
  LT: TOpen;
  LH: THolder;

begin
  LQ[0] := 1;
  LQ[1] := 2;
  LQ[2] := 3;
  LQ[3] := 4;
  println("quad {} sum {} len {} size {}", LQ, Sum(LQ), len(LQ), size(TQuad));
  LCopy := LQ;
  LCopy[0] := 9;
  println("copy {} {} same {}", LQ[0], LCopy[0], LQ = LCopy);
  LCopy[0] := 1;
  println("equal {}", LQ = LCopy);
  println("doubled {} kept {}", Doubled(LQ), LQ[3]);
  Fill(LR, 5);
  println("row {} first {} last {}", LR, LR[1], LR[3]);
  LG[1][2] := 7;
  println("grid {} {}", LG[1][2], LG);
  LO[-2] := 10;
  LO[2] := 20;
  println("offset {} {} len {}", LO[-2], LO[2], len(LO));
  LL['C'] := 3;
  println("letters {} {}", LL['C'], LL);
  LN[TColor.cRed] := "red";
  LN[TColor.cBlue] := "blue";
  println("names {} {} len {}", LN[TColor.cRed], LN[TColor.cBlue], len(LN));
  Grow(LD, 3);
  LD[2] := 8;
  println("dynamic {} len {}", LD, len(LD));
  setlength(LT, 2);
  LT[0] := "x";
  LT[1] := "y";
  println("open {}", LT);
  LH.Cells[1] := 4;
  setlength(LH.Items, 1);
  LH.Items[0].X := 6;
  println("holder {} {} len {}", LH.Cells[1], LH.Items[0].X, len(LH.Items));
end.
