-------------------------------------------------------------------------------
  dir_addresdata_err_duplicate_lib_dep.pcpp - the library
  dir_addresdata_err_duplicate_lib.pcpp links: it adds the data key "hello",
  which that program adds too. Built on its own, it is fine: nothing to
  check here.

  How to build it, from repo\bin (before the program):
    pcpp res\tests\dir_addresdata_err_duplicate_lib_dep.pcpp
    pcpp res\tests\dir_addresdata_err_duplicate_lib_dep.pcpp -t x86_64-linux-gnu
*******************************************************************************/

module lib dir_addresdata_err_duplicate_lib_dep;
@addresdata "hello" "$P:res/tests/dir_addresdata_hello.txt";

exported routine clink dir_addresdata_dep_add(AA: int32; AB: int32): int32;
begin
  return AA + AB;
end;

end.
