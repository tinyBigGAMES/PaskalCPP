-------------------------------------------------------------------------------
  type_object_property_err_value.pcpp - break step of type_object_property.pcpp:
  a property assignment is a statement (SM0377)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_err_value.pcpp
    pcpp res\tests\type_object_property_err_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_err_value;

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;

var
  LB: TBox;
  LX: int32;
begin
  LX := LB.N := 1; // ERROR SM0377@9: an assignment to property 'N' is a statement
end.
