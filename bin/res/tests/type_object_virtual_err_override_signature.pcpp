-------------------------------------------------------------------------------
  type_object_virtual_err_override_signature.pcpp - break step of type_object_virtual.pcpp:
  an override taking other parameter types than the method it overrides (SM0334)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_override_signature.pcpp
    pcpp res\tests\type_object_virtual_err_override_signature.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_override_signature;

type
  TA = object
    virtual method M(AX: int32);
    begin
    end;
  end;
  TB = object(TA)
    override method M(AX: int64); // ERROR SM0334@21: 'M' must take the parameters and return the type of 'TA.M' it overrides
    begin
    end;
  end;

begin
end.
