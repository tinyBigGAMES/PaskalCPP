  decl_external_err_nolib.pcpp - break step of decl_external.pcpp:
  a library the linker cannot find (no such library anywhere)

  How to check, from repo\bin:
    pcpp res\tests\decl_external_err_nolib.pcpp
    pcpp res\tests\decl_external_err_nolib.pcpp -t x86_64-linux-gnu
  The build fails at the link: the marked line (the library's name) reports
  it; nothing else is reported.
*******************************************************************************/

module exe decl_external_err_nolib;

routine clink decl_external_none(): int32; external "decl_external_nolib"; // ERROR ZB0016@53: decl_external_nolib

begin
  println("{}", decl_external_none());
end.
