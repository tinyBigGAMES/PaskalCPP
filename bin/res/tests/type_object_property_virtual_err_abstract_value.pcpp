  type_object_property_virtual_err_abstract_value.pcpp - break step of type_object_property_virtual.pcpp:
  an object with an abstract accessor is no value (SM0338)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_abstract_value.pcpp
    pcpp res\tests\type_object_property_virtual_err_abstract_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_abstract_value;

type
  TAbs = object
    virtual property A: int32 read abstract;
  end;

var
  LA: TAbs; // ERROR SM0338@7: 'TAbs' is abstract

begin
end.
