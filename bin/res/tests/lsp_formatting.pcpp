-------------------------------------------------------------------------------
  lsp_formatting.pcpp - LSP compliance: Format Document / Format Selection

  This file is laid out badly on purpose. Right-click > Format Document
  (Shift+Alt+F) lays it out in the PaskalCPP style; Format Selection
  formats only the lines selected. Formatting never changes the code, only
  spaces, line breaks and indentation. Format on save is off by default.

  How to check: first do the Format Selection CHECK at the end, then format
  the document and read each CHECK: it says what the lines below it look
  like now. Format a second time: nothing changes. Ctrl+Z brings the
  original back in one step.
*******************************************************************************/

module exe lsp_formatting;

// CHECK: "var" alone on its line, A and B each on their own line two in
var A: int32; B: int32;

// CHECK: TDigits and TRec two in, the fields four in, end two in
type
TDigits = set of 0..63;
TRec = record
X: int32;
      Y: int32;
end;

// CHECK: the table keeps its two lines, both four in (a constant written
//        over several lines keeps its lines)
const
  KDigits: TDigits = [
        0, 1, 2,
   3, 4, 5];

// CHECK: the heading joins onto one line
routine Add(const AX: int32;
            const AY: int32): int32;
begin
// CHECK: this comment and the return two in; one space each side of +
return AX+AY;
end;

// CHECK: over 80 columns: the heading breaks after the third ';', the rest
//        two in
routine Sum(const AW: int32; const AX: int32; const AY: int32; const AZ: int32): int32;
begin
  return AW + AX + AY + AZ;
end;

begin
  // CHECK: two statements, one per line
  A:=1;   B:=2;



  // CHECK: one blank line above this comment, where there were three
  // CHECK: one space each side of := and *, none inside the parentheses,
  //        one after the comma
  A := Add( A,B )*2;
  // CHECK: the extra spaces before := stay (an alignment is kept)
  A     := 1;
  B     := 2;
  // CHECK: the condition joins onto the if's line; A := 0 two further in
  if (A > 1) and
     (B < 9) then
  A := 0;
  end;
  // CHECK: over 80 columns: five lines, one Sum each, each broken after a +,
  //        every line after the first two further in than A
  A := Sum(1000000, 2000000, 3000000, 4000000) + Sum(1000000, 2000000, 3000000, 4000000) + Sum(1000000, 2000000, 3000000, 4000000) + Sum(1000000, 2000000, 3000000, 4000000) + Sum(1000000, 2000000, 3000000, 4000000);
  // CHECK: the C++ between cppstart and cppend is exactly as written
  cppstart source
    int   LUnused  =  1 ;  (void) LUnused ;
  cppend;
  // CHECK (Format Selection, before Format Document): select only the line
  //        below and run Format Selection: it becomes B := A + 1; and
  //        nothing else in the file changes
  B:=A+1;
end.
