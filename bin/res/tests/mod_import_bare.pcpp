-------------------------------------------------------------------------------
  mod_import_bare.pcpp - Module compliance: imported names used bare

  A name the module does not declare is found in its own imports when exactly
  one imported unit exports it (BNF.md sec 1): a type (TSize), a const
  (KDepth), a var (GCalls, also as a for iterator), a routine (Area) and one
  unit's overload set (Describe). The module's own names win (KScale), and so
  does an inner local (GCalls in Local); a name two units export is written
  qualified (KShared); the qualified form always works. Imports are not
  transitive. This file's units: mod_import_bare_a.pcpp and
  mod_import_bare_b.pcpp.

  How to check, from repo\bin:
    pcpp res\tests\mod_import_bare.pcpp -r
    pcpp res\tests\mod_import_bare.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    Area(GSize) = 10
    Describe(1) = int, Describe(true) = bool
    KDepth = 4
    KScale = 10 (own), mod_import_bare_a.KScale = 3
    Local() = 7, GCalls = 1
    for GCalls: 3
    KShared: 1 and 2
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Both targets print the same; the [Heap] line is the debug build's heap report.

  Break it: run the file below the same way; it reports exactly what the
  // ERROR comment on its marked line says, and nothing else:
    mod_import_bare_err_ambiguous.pcpp   KShared bare: two imported units
                                         export it
*******************************************************************************/

module exe mod_import_bare;
import mod_import_bare_a, mod_import_bare_b;

// The module's own const: it wins over mod_import_bare_a.KScale
const
  KScale: int32 = 10;

var
  GSize: TSize;

routine Local(): int32;
var
  // An inner local wins over mod_import_bare_a.GCalls
  GCalls: int32 = 7;
begin
  return GCalls;
end;

begin
  GSize.W := 2;
  GSize.H := 5;
  println("Area(GSize) = {}", Area(GSize));
  println("Describe(1) = {}, Describe(true) = {}", Describe(1), Describe(true));
  println("KDepth = {}", KDepth);
  println("KScale = {} (own), mod_import_bare_a.KScale = {}", KScale, mod_import_bare_a.KScale);
  println("Local() = {}, GCalls = {}", Local(), GCalls);
  for GCalls := 1 to 3 do
  end;
  println("for GCalls: {}", GCalls);
  println("KShared: {} and {}", mod_import_bare_a.KShared, mod_import_bare_b.KShared);
end.
