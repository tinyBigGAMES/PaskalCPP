  test_mode_err_lib_tests.pcpp - break step of test_mode.pcpp:
  a test block in a lib never runs (SM0113, a warning: it still builds)

  How to check, from repo\bin:
    pcpp res\tests\test_mode_err_lib_tests.pcpp
    pcpp res\tests\test_mode_err_lib_tests.pcpp -t x86_64-linux-gnu
  The marked line reports that warning; nothing else is reported.
*******************************************************************************/

module lib test_mode_err_lib_tests;

exported routine Half(AN: int32): int32;
begin
  return AN div 2;
end;

end.

test "never runs" // WARN SM0113@1: test blocks of a dll or lib module never run
begin
  testAssertEqualInt(2, Half(4));
end;
