-------------------------------------------------------------------------------
  expr_varargs_err_local_assign.pcpp - break step of expr_varargs.pcpp:
  a varargs local set from something else than copy() (SM0422)

  How to check, from repo\bin:
    pcpp res\tests\expr_varargs_err_local_assign.pcpp
    pcpp res\tests\expr_varargs_err_local_assign.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_varargs_err_local_assign;

routine V(...);
var
  LCopy: varargs;
begin
  LCopy := varargs.count; // ERROR SM0422@12: set from a copy()
end;

begin
  V(1);
end.
