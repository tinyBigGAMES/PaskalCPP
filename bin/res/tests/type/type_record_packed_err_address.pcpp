-------------------------------------------------------------------------------
  type_record_packed_err_address.pcpp - Type: record packed, address

  Break step of type_record_packed: the address of a field of a packed record
  (SM0270).
*******************************************************************************/

module exe type_record_packed_err_address;

/*
  @@test
    kind error
  @@end
*/

type
  TS = set of 0..15;
  TPk = record packed
    C: int8;
    I: int32;
    S: TS;
  end;

var
  LP: TPk;
  LPI: ptr to int32;

begin
  LPI := address of LP.I; // ERROR SM0270@21: it may be misaligned
end.
