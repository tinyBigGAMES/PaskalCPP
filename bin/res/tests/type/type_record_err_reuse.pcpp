  type_record_err_reuse.pcpp - Type: record, reuse

  Break step of type_record: a field reuses its parent's field name (SM0309).
*******************************************************************************/

module exe type_record_err_reuse;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = record
    A: int32;
  end;
  TR = record(TBase)
    A: int32; // ERROR SM0309@5: 'A' reuses a name of the parent chain
  end;

begin
end.
