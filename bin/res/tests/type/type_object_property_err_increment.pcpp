-------------------------------------------------------------------------------
  type_object_property_err_increment.pcpp - Type: object property, increment

  Break step of type_object_property: a property is no storage: ++ writes in
  place (SM0376).
*******************************************************************************/

module exe type_object_property_err_increment;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;

var
  LB: TBox;
begin
  LB.N++; // ERROR SM0376@3: 'LB.N' is a property, not storage
end.
