module exe type_record_err_anon_overlay_packed;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record
    overlay packed // ERROR PR0033@13: 'packed' is not allowed on an anonymous overlay
      B: int32;
      F: float32;
    end;
  end;

begin
end.
