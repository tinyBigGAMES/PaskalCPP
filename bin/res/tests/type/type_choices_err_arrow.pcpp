-------------------------------------------------------------------------------
  type_choices_err_arrow.pcpp - Type: a value reached with ->

  Break step of type_choices: a type reaches its values with '.', not '->'
  (SM0014).
*******************************************************************************/

module exe type_choices_err_arrow;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC := TColor->cRed; // ERROR SM0014@9: 'TColor' is a module or a type: reach its names with '.'
end.
