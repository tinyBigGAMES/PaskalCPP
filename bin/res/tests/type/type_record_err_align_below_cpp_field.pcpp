-------------------------------------------------------------------------------
  type_record_err_align_below_cpp_field.pcpp - Type: record, align below cpp field

  Break step of type_record: align(4) on a field of a C++ struct holding a
  double: below its natural alignment 8 (SM0311, at the align value; the C++
  layout is judged in the emitted C++).
*******************************************************************************/

module exe type_record_err_align_below_cpp_field;

/*
  @@test
    kind error
  @@end
*/

struct CPoint { double X; };

type
  TR = record align(4) // ERROR SM0311@21: align 4 is below the natural alignment 8 of 'TR', lower it with packed
    P: CPoint;
  end;

var
  V: TR;

begin
  V.P.X := 1.0;
end.
