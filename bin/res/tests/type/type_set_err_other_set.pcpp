-------------------------------------------------------------------------------
  type_set_err_other_set.pcpp - Type: set, other set

  Break step of type_set: two set types are two types: a set of TColor is no
  set of 0..15 (SM0200).
*******************************************************************************/

module exe type_set_err_other_set;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);
  TS = set of 0..15;
  TColors = set of TColor;

var
  LS: TS;
  LC: TColors;
  LB: bool;

begin
  LS := [1];
  LC := [TColor.cRed];
  LS := LC; // ERROR SM0200@9: 'TColors' does not convert implicitly to 'TS'
end.
