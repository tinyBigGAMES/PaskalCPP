  type_object_copy_err_array.pcpp - Type: object copy, array

  Break step of type_object_copy: an array of such objects assigned: each
  element would be copied (SM0427).
*******************************************************************************/

module exe type_object_copy_err_array;

/*
  @@test
    kind error
  @@end
*/

type
  TRes = object
    Id: int32;
    done;
    begin
    end;
  end;

routine Use();
var
  LA: array[0..1] of TRes;
  LB: array[0..1] of TRes;
begin
  LA := LB; // ERROR SM0427@9: 'LB' would be copied here, and 'array[0..1] of TRes' cannot be copied: pass it var / const, return it from a local
end;

begin
end.
