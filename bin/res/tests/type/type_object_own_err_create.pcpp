module exe type_object_own_err_create;

/*
  @@test
    kind error
  @@end
*/

type
  TPlain = object
    X: int32;
  end;

routine Use();
var
  LP: ptr to TPlain;
begin
  create(LP); // ERROR SM0361@10: create does not build an object
end;

begin
end.
