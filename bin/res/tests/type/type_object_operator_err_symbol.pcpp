module exe type_object_operator_err_symbol;

/*
  @@test
    kind error
  @@end
*/

type
  TVec = record
    X: int32;
    Y: int32;
    operator and(const A: TVec; const B: TVec): bool; // ERROR PR0062
    begin
      return A.X = B.X;
    end;
  end;

begin
end.
