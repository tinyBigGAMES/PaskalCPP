module exe type_object_own_err_record;

/*
  @@test
    kind error
  @@end
*/

type
  TPlain = object
    X: int32;
  end;
  TR = record
    R: ref TPlain; // ERROR SM0357@8: field 'R': a record or an overlay holds no object
  end;

begin
end.
