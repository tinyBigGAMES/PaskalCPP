-------------------------------------------------------------------------------
  type_object_virtual_err_abstract_call.pcpp - Type: object virtual, abstract call

  Break step of type_object_virtual: parent.M() of an abstract M: it has no
  body to call (SM0340).
*******************************************************************************/

module exe type_object_virtual_err_abstract_call;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    virtual method M(): int32; abstract;
  end;
  TB = object(TA)
    override method M(): int32;
    begin
      return parent.M(); // ERROR SM0340@14: 'TA.M' is abstract: it has no body to call
    end;
  end;

begin
end.
