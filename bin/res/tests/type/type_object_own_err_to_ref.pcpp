-------------------------------------------------------------------------------
  type_object_own_err_to_ref.pcpp - Type: object own, to ref

  Break step of type_object_own: an own named by a variable given to a ref: it
  would be shared (SM0427).
*******************************************************************************/

module exe type_object_own_err_to_ref;

/*
  @@test
    kind error
  @@end
*/

type
  TPlain = object
    X: int32;
  end;

routine Use();
var
  LA: own TPlain;
  LR: ref TPlain;
begin
  LA := own TPlain;
  LR := LA; // ERROR SM0427@9: an own is the sole owner of its object
end;

begin
end.
