  type_overlay_err_dynarray.pcpp - Type: overlay, dynarray

  Break step of type_overlay: an overlay is plain data: a field holds no
  dynamic array (it owns its elements; SM0313).
*******************************************************************************/

module exe type_overlay_err_dynarray;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    D: array of int32; // ERROR SM0313@5: cannot share an overlay's storage
  end;

begin
end.
