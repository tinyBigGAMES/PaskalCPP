-------------------------------------------------------------------------------
  type_pointer_err_dot_pointer.pcpp - Type: . on a pointer

  Break step of type_pointer: . on a pointer reaches no field, write LP^.X
  or LP->X (SM0250).
*******************************************************************************/

module exe type_pointer_err_dot_pointer;

/*
  @@test
    kind error
  @@end
*/

type
  TPoint = record
    X: int32;
  end;

var
  LP: ptr to TPoint;
  LX: int32;

begin
  LX := LP.X; // ERROR SM0250@9: operator '.' does not take 'ptr to TPoint'
end.
