  type_object_embed_err_record.pcpp - Type: object embed, record

  Break step of type_object_embed: an embed in a record: a record is plain
  data, an object embeds (PR0034).
*******************************************************************************/

module exe type_object_embed_err_record;

/*
  @@test
    kind error
  @@end
*/

type
  TInner = record
    X: int32;
  end;
  TRec = record
    embed I: TInner; // ERROR PR0034@5: 'embed' is not allowed in a record
  end;

begin
end.
