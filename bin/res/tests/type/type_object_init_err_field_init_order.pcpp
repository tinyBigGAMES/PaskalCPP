-------------------------------------------------------------------------------
  type_object_init_err_field_init_order.pcpp - Type: object init, field init order

  Break step of type_object_init: field inits out of declaration order: fields
  are built in declaration order (SM0345).
*******************************************************************************/

module exe type_object_init_err_field_init_order;

/*
  @@test
    kind error
  @@end
*/

type
  TC = object
    init();
    begin
    end;
  end;
  TB = object
    A: TC;
    B: TC;
    init();
    begin
      self.B.init();
      self.A.init(); // ERROR SM0345@7: self.A.init(...) comes after self.B.init(...)
    end;
  end;

begin
end.
