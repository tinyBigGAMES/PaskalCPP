-------------------------------------------------------------------------------
  type_object_property_virtual_err_needs_index.pcpp - Type: object property virtual, needs index

  Break step of type_object_property_virtual: an indexed property is read
  through its index (SM0378).
*******************************************************************************/

module exe type_object_property_virtual_err_needs_index;

/*
  @@test
    kind error
  @@end
*/

type
  TBag = object
    FI: int32;
    property Items[const AI: int32]: int32 read
      begin
        return self.FI + AI;
      end;
  end;

var
  LB: TBag;
  LX: int32;
begin
  LX := LB.Items; // ERROR SM0378@12: property 'Items' is indexed
end.
