  type_set_err_divide.pcpp - Type: set, divide

  Break step of type_set: a / b on two sets: a set takes + - * (union,
  difference, intersection), not / (SM0250).
*******************************************************************************/

module exe type_set_err_divide;

/*
  @@test
    kind error
  @@end
*/

type
  TS = set of 0..15;

var
  LS: TS;

begin
  LS := [1, 2];
  LS := LS / [1]; // ERROR SM0250@9: operator '/' does not take
end.
