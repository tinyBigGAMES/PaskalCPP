-------------------------------------------------------------------------------
  type_pointer_err_untyped_deref.pcpp - Type: ^ on the untyped ptr

  Break step of type_pointer: the untyped ptr points at no type; ^ reads
  through a typed pointer (SM0253).
*******************************************************************************/

module exe type_pointer_err_untyped_deref;

/*
  @@test
    kind error
  @@end
*/

var
  LU: ptr;
  LX: int32;

begin
  LU := nil;
  LX := LU^; // ERROR SM0253@9: 'LU' is an untyped ptr and points at no type: cast it to a typed pointer first (ptr to T(LU))
end.
