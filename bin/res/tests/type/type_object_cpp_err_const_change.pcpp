module exe type_object_cpp_err_const_change;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    N: int32;
    const method Bump(): int32;
    begin
      self.N := self.N + 1; // ERROR SM0387
      return self.N;
    end;
  end;

begin
end.
