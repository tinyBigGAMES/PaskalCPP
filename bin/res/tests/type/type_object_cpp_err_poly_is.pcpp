module exe type_object_cpp_err_poly_is;

/*
  @@test
    kind error
  @@end
*/

struct CPlain {
  int tag = 5;
};

type
  TA = object(CPlain)
    N: int32;
  end;
  TB = object(TA)
    M: int32;
  end;

routine Check(const AA: TA): bool;
begin
  return AA is TB; // ERROR SM0271
end;

var
  LB: TB;
begin
  println("{}", Check(LB));
end.
