-------------------------------------------------------------------------------
  type_object_iface_err_not_interface.pcpp - Type: object iface, not interface

  Break step of type_object_iface: an object named after implements:
  implements names interfaces (SM0362).
*******************************************************************************/

module exe type_object_iface_err_not_interface;

/*
  @@test
    kind error
  @@end
*/

type
  IShape = interface
    method Area(): int32;
  end;
  TPlain = object
    X: int32;
  end;
  TBox = object implements TPlain // ERROR SM0362@28: 'TPlain' is not an interface
  end;

begin
end.
