  type_object_copy_err_argument.pcpp - Type: object copy, argument

  Break step of type_object_copy: such an object passed by value: the argument
  would be copied (SM0427).
*******************************************************************************/

module exe type_object_copy_err_argument;

/*
  @@test
    kind error
  @@end
*/

type
  TRes = object
    Id: int32;
    done;
    begin
    end;
  end;

routine Take(AR: TRes);
begin
end;

routine Use();
var
  LA: TRes;
begin
  Take(LA); // ERROR SM0427@8: 'LA' would be copied here, and 'TRes' cannot be copied: pass it var / const, return it from a local
end;

begin
end.
