  type_object_init_err_no_default.pcpp - Type: object init, no default

  Break step of type_object_init: a variable built without the arguments its
  type's init needs (SM0349).
*******************************************************************************/

module exe type_object_init_err_no_default;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;

var
  GA: TA; // ERROR SM0349@7: 'TA' has no init without arguments: build it with arguments, TA(...)

begin
end.
