-------------------------------------------------------------------------------
  type_object_err_hidden_overload.pcpp - Type: object, hidden overload

  Break step of type_object: TB.Put(string) hides TA.Put(int32): GB.Put(5)
  finds only TB.Put, which takes no int32 (SM0404).
*******************************************************************************/

module exe type_object_err_hidden_overload;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    method Put(AN: int32);
    begin
    end;
  end;
  TB = object(TA)
    method Put(AS: string);
    begin
    end;
  end;

var
  GB: TB;

begin
  GB.Put(5); // ERROR SM0404@10: 'int32' does not convert implicitly to 'string'
end.
