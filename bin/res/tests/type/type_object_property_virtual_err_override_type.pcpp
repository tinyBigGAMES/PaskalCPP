-------------------------------------------------------------------------------
  type_object_property_virtual_err_override_type.pcpp - Type: object property virtual, override type

  Break step of type_object_property_virtual: an override has its base's type
  (SM0334).
*******************************************************************************/

module exe type_object_property_virtual_err_override_type;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = object
    FA: int32;
    virtual property A: int32 read FA; write FA;
  end;
  TKid = object(TBase)
    FB: int64;
    override property A: int64 read FB; // ERROR SM0334@23: must have the type and index of 'TBase.A'
  end;

begin
end.
