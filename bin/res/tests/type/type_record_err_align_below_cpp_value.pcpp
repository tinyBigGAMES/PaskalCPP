-------------------------------------------------------------------------------
  type_record_err_align_below_cpp_value.pcpp - Type: record, align below cpp value

  Break step of type_record: align(cpp("2")) on an int32 field: a value
  written in C++ is judged the same way (SM0311, at the align value).
*******************************************************************************/

module exe type_record_err_align_below_cpp_value;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record align(cpp("2")) // ERROR SM0311@21: align 2 is below the natural alignment 4 of 'TR', lower it with packed
    G: int32;
  end;

var
  V: TR;

begin
  V.G := 1;
end.
