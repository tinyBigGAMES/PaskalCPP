module exe type_object_property_virtual_err_iface_missing;

/*
  @@test
    kind error
  @@end
*/

type
  IA = interface
    property A: int32 read; write;
  end;
  TBox = object implements IA // ERROR SM0364@28: 'TBox' does not implement 'IA.A'
  end;

begin
end.
