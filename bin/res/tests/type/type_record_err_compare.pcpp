-------------------------------------------------------------------------------
  type_record_err_compare.pcpp - Type: record, compare

  Break step of type_record: a record has no comparison: compare its fields
  (SM0252).
*******************************************************************************/

module exe type_record_err_compare;

/*
  @@test
    kind error
  @@end
*/

type
  TPoint = record
    X: int32;
    Y: int32;
  end;

var
  LA: TPoint;
  LB: TPoint;
  LSame: bool;

begin
  LSame := LA = LB; // ERROR SM0252@12: cannot compare 'TPoint'
end.
