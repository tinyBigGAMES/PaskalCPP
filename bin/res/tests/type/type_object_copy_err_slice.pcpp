-------------------------------------------------------------------------------
  type_object_copy_err_slice.pcpp - Type: object copy, slice

  Break step of type_object_copy: a polymorphic object passed by value as its
  parent: it would be cut down (SM0428).
*******************************************************************************/

module exe type_object_copy_err_slice;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    virtual method M();
    begin
    end;
  end;
  TB = object(TA)
    override method M();
    begin
    end;
  end;

routine Take(AA: TA);
begin
end;

routine Use();
var
  LB: TB;
begin
  Take(LB); // ERROR SM0428@8: 'TB' would be cut down to its 'TA' part here
end;

begin
end.
