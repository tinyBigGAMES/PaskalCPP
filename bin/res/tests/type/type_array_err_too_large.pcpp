module exe type_array_err_too_large;

/*
  @@test
    kind error
  @@end
*/

type
  TA = array[0..1152921504606846975] of uint8; // ERROR SM0277@8: 'array[0..1152921504606846975] of uint8' is too large: a type holds at most 1152921504606846975 bytes

begin
end.
