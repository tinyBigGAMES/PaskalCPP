-------------------------------------------------------------------------------
  type_record_packed_err_nested.pcpp - Type: record packed, nested

  Break step of type_record_packed: a record holding a string, as a field of a
  packed record (SM0331).
*******************************************************************************/

module exe type_record_packed_err_nested;

/*
  @@test
    kind error
  @@end
*/

type
  TIn = record
    N: string;
  end;
  TP = record packed
    C: int8;
    R: TIn; // ERROR SM0331@5: holds a string or dynamic array
  end;

begin
end.
