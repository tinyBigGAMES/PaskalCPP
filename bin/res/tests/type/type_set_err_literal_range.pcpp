-------------------------------------------------------------------------------
  type_set_err_literal_range.pcpp - Type: set, literal range

  Break step of type_set: a constant element lies inside the set's range
  (SM0200).
*******************************************************************************/

module exe type_set_err_literal_range;

/*
  @@test
    kind error
  @@end
*/

type
  TS = set of 0..15;

var
  LS: TS;

begin
  LS := [1, 2];
  LS := [20]; // ERROR SM0200@9: does not convert implicitly to 'TS'
end.
