  type_record_err_prefix_packed.pcpp - Type: record, prefix packed

  Break step of type_record: record align(8) packed: packed comes before align
  (PR0032).
*******************************************************************************/

module exe type_record_err_prefix_packed;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record align(8) packed // ERROR PR0032@24: 'packed' is out of order
    B: int32;
  end;

begin
end.
