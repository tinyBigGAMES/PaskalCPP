module exe type_object_property_virtual_err_default_twice;

/*
  @@test
    kind error
  @@end
*/

type
  TBag = object
    FI: int32;
    property A[const AI: int32]: int32 read
      begin
        return AI;
      end;
      default;
    property B[const AI: int32]: int32 read
      begin
        return AI;
      end;
      default; // ERROR SM0379@7: is a second default
  end;

begin
end.
