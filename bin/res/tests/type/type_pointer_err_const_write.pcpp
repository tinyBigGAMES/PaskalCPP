-------------------------------------------------------------------------------
  type_pointer_err_const_write.pcpp - Type: a write through a ptr to const

  Break step of type_pointer: a ptr to const writes nothing through it
  (SM0255).
*******************************************************************************/

module exe type_pointer_err_const_write;

/*
  @@test
    kind error
  @@end
*/

var
  LA: int32;
  LC: ptr to const int32;

begin
  LC := address of LA;
  LC^ := 1; // ERROR SM0255@3: 'LC^' cannot be assigned
end.
