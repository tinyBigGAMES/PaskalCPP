-------------------------------------------------------------------------------
  type_object_property_err_read_change.pcpp - Type: object property, read change

  Break step of type_object_property: a read changes nothing of self (SM0373).
*******************************************************************************/

module exe type_object_property_err_read_change;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    FN: int32;
    property N: int32 read
      begin
        self.FN := 1; // ERROR SM0373@9: the read of 'N' cannot change 'self.FN'
        return self.FN;
      end;
  end;

begin
end.
