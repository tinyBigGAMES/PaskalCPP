-------------------------------------------------------------------------------
  type_choices_err_choices_to_int.pcpp - Type: a value into an integer variable

  Break step of type_choices: a value does not convert to a number
  implicitly, write int32(...) (SM0200).
*******************************************************************************/

module exe type_choices_err_choices_to_int;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LI: int32;

begin
  LI := TColor.cBlue; // ERROR SM0200@9: 'TColor' does not convert implicitly to 'int32'
end.
