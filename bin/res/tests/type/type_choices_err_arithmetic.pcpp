-------------------------------------------------------------------------------
  type_choices_err_arithmetic.pcpp - Type: + on a choice value

  Break step of type_choices: only a comparison or in takes a choice value
  (SM0250).
*******************************************************************************/

module exe type_choices_err_arithmetic;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LI: int32;

begin
  LI := TColor.cRed + 1; // ERROR SM0250@9: operator '+' does not take 'TColor' and 'int32'
end.
