  type_object_is_err_exact.pcpp - Type: object is, exact

  Break step of type_object_is: is on a variable, which holds exactly its type
  (SM0274).
*******************************************************************************/

module exe type_object_is_err_exact;

/*
  @@test
    kind error
  @@end
*/

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;

var
  LShape: TShape;
begin
  println("{}", LShape is TCircle); // ERROR SM0274
end.
