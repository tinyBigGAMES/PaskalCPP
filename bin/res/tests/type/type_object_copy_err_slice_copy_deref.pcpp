-------------------------------------------------------------------------------
  type_object_copy_err_slice_copy_deref.pcpp - Type: object copy, slice copy deref

  Break step of type_object_copy: a polymorphic object copied out of a
  pointer: it may be a descendant (SM0428).
*******************************************************************************/

module exe type_object_copy_err_slice_copy_deref;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
  end;

routine Keep(AP: ptr to TA);
var
  LA: TA;
begin
  LA := AP^; // ERROR SM0428@9: 'AP^' may hold a descendant of 'TA' (it is polymorphic): a copy keeps only its 'TA' part
end;

begin
end.
