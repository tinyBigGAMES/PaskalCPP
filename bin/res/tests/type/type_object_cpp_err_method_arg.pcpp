  type_object_cpp_err_method_arg.pcpp - Type: object cpp, method arg

  Break step of type_object_cpp: a method passed for a routine-type parameter
  (SM0432).
*******************************************************************************/

module exe type_object_cpp_err_method_arg;

/*
  @@test
    kind error
  @@end
*/

type
  TFn = routine(): int32;
  TBox = object
    N: int32;
    method Get(): int32;
    begin
      return self.N;
    end;
  end;

routine Run(const AF: TFn): int32;
begin
  return AF();
end;

var
  LB: TBox;
begin
  println("{}", Run(LB.Get)); // ERROR SM0432
end.
