  type_object_virtual_err_overrides_nothing.pcpp - Type: object virtual, overrides nothing

  Break step of type_object_virtual: override of a plain method: only a
  virtual one is overridden (SM0333).
*******************************************************************************/

module exe type_object_virtual_err_overrides_nothing;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    method M();
    begin
    end;
  end;
  TB = object(TA)
    override method M(); // ERROR SM0333@5: 'M' overrides nothing
    begin
    end;
  end;

begin
end.
