-------------------------------------------------------------------------------
  type_pointer_err_to_integer.pcpp - Type: a pointer into an integer

  Break step of type_pointer: a pointer is no integer: cast it (SM0200).
*******************************************************************************/

module exe type_pointer_err_to_integer;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LI: int64;

begin
  LP := nil;
  LI := LP; // ERROR SM0200@9: 'ptr to int32' does not convert implicitly to 'int64'; write int64(LP)
end.
