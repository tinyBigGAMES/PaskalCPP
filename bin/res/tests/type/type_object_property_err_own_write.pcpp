-------------------------------------------------------------------------------
  type_object_property_err_own_write.pcpp - Type: object property, own write

  Break step of type_object_property: a write assigns its field, never its own
  property (SM0374).
*******************************************************************************/

module exe type_object_property_err_own_write;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write(AValue)
      begin
        self.N := AValue; // ERROR SM0374@14: the write of 'N' assigns the property again, forever
      end;
  end;

begin
end.
