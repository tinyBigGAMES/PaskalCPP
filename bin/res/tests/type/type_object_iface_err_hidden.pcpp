  type_object_iface_err_hidden.pcpp - Type: object iface, hidden

  Break step of type_object_iface: a hidden method fulfilling an interface
  method: it is never hidden (SM0367).
*******************************************************************************/

module exe type_object_iface_err_hidden;

/*
  @@test
    kind error
  @@end
*/

type
  IShape = interface
    method Area(): int32;
  end;
  TBox = object implements IShape // ERROR SM0367@28: an interface member is never hidden
    hidden virtual method Area(): int32;
    begin
      return 1;
    end;
  end;

begin
end.
