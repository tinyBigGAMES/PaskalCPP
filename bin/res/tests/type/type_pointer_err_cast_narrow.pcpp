-------------------------------------------------------------------------------
  type_pointer_err_cast_narrow.pcpp - Type: an int32 cast to a pointer

  Break step of type_pointer: a pointer cast takes an integer of pointer
  width (uint64, int64), not an int32 (SM0265).
*******************************************************************************/

module exe type_pointer_err_cast_narrow;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LI: int32;

begin
  LI := 0;
  LP := ptr to int32(LI); // ERROR SM0265@22: 'int32' cannot be cast to 'ptr to int32': a pointer cast takes a pointer that keeps const, or an integer of pointer width
end.
