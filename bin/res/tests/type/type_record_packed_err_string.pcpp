  type_record_packed_err_string.pcpp - Type: record packed, string

  Break step of type_record_packed: a string field in a packed record: it
  cannot be packed (SM0331).
*******************************************************************************/

module exe type_record_packed_err_string;

/*
  @@test
    kind error
  @@end
*/

type
  TP = record packed
    C: int8;
    S: string; // ERROR SM0331@5: holds a string or dynamic array
  end;

begin
end.
