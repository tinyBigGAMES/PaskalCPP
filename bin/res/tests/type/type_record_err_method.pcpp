  type_record_err_method.pcpp - Type: record, method

  Break step of type_record: a record holds no methods; an object does
  (PR0034).
*******************************************************************************/

module exe type_record_err_method;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record
    B: int32;
    method M(); // ERROR PR0034@5: 'method' is not allowed in a record
    begin
    end;
  end;

begin
end.
