module exe type_object_is_err_target;

/*
  @@test
    kind error
  @@end
*/

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;

routine Check(const AShape: TShape): int32;
begin
  return AShape as int32; // ERROR SM0272
end;

begin
end.
