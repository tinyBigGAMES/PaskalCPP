-------------------------------------------------------------------------------
  type_object_copy_err_parent_init.pcpp - Type: object copy, parent init

  Break step of type_object_copy: parent.init(...) in a copy: the parent part
  is copied by the parent's copy (SM0356).
*******************************************************************************/

module exe type_object_copy_err_parent_init;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
  end;
  TB = object(TA)
    copy(const ASource: TB);
    begin
      parent.init(); // ERROR SM0356@7: parent.init(...) is not written in a copy
    end;
  end;

begin
end.
