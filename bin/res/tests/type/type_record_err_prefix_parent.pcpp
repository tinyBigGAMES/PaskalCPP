module exe type_record_err_prefix_parent;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = record
    A: int32;
  end;
  TR = record packed (TBase) // ERROR PR0032@22: '(' is out of order
    B: int32;
  end;

begin
end.
