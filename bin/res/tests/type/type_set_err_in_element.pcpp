-------------------------------------------------------------------------------
  type_set_err_in_element.pcpp - Type: set, in element

  Break step of type_set: in takes a value of the set's element type (SM0268).
*******************************************************************************/

module exe type_set_err_in_element;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);
  TS = set of 0..15;
  TColors = set of TColor;

var
  LS: TS;
  LC: TColors;
  LB: bool;

begin
  LS := [1];
  LC := [TColor.cRed];
  LB := TColor.cRed in LS; // ERROR SM0268@9: 'in': 'TColor' is not the element type of 'TS'
end.
