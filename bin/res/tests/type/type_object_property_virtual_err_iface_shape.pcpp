  type_object_property_virtual_err_iface_shape.pcpp - Type: object property virtual, iface shape

  Break step of type_object_property_virtual: an interface property's write is
  implemented too (SM0366).
*******************************************************************************/

module exe type_object_property_virtual_err_iface_shape;

/*
  @@test
    kind error
  @@end
*/

type
  IA = interface
    property A: int32 read; write;
  end;
  TBox = object implements IA // ERROR SM0366@28: its type, index or write differ
    FA: int32;
    virtual property A: int32 read FA;
  end;

begin
end.
