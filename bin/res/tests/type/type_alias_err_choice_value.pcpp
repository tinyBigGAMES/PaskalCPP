-------------------------------------------------------------------------------
  type_alias_err_choice_value.pcpp - Type: an alias of a choice value

  Break step of type_alias: cRed is a value of TColor, not a type (SM0013),
  and a visible choice value is never taken as a C/C++ name.
*******************************************************************************/

module exe type_alias_err_choice_value;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen);
  TA = cRed; // ERROR SM0013@8: 'cRed' is not a type

begin
end.
