-------------------------------------------------------------------------------
  type_object_operator.pcpp - Type: operators

  A record or an object declares operators (BNF.md sec 4 operator decl): + - *
  / div mod, the unary minus (- with one operand),
  = <> (a pair), < <= > >= and in, each `operator OP(params): T;` with a
  body. Shown here:
  - several operators of one symbol, picked by their operand types as a
    call is (TVec * int32 scales, TVec * TVec is the dot product);
  - the unary minus, and = / <> (a record that declares them compares);
  - div / mod / < / = / <> on an object (an object compares only through an
    operator its type declares), in on a record (the set operand's side);
  - an object and a record whose parent is a C++ class compare through that
    class's own operator== (clang's: it sees the C++ class);
  - an operator has no self: it is a routine of its type.
*******************************************************************************/

module exe type_object_operator;

/*
  @@test
    kind run
    expect
    | 7 10
    | 11
    | -1 -2
    | false true true
    | 10
    | 50 true
    | true false
    | true false
    | true false
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

struct CSeat { int Seat; bool operator==(const CSeat& AOther) const { return Seat == AOther.Seat; } };

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: TVec; const B: TVec): TVec;
    var
      LR: TVec;
    begin
      LR.X := A.X + B.X;
      LR.Y := A.Y + B.Y;
      return LR;
    end;
    operator *(const A: TVec; const AK: int32): TVec;
    var
      LR: TVec;
    begin
      LR.X := A.X * AK;
      LR.Y := A.Y * AK;
      return LR;
    end;
    operator *(const A: TVec; const B: TVec): int32;
    begin
      return A.X * B.X + A.Y * B.Y;
    end;
    operator -(const A: TVec): TVec;
    var
      LR: TVec;
    begin
      LR.X := -A.X;
      LR.Y := -A.Y;
      return LR;
    end;
    operator =(const A: TVec; const B: TVec): bool;
    begin
      return (A.X = B.X) and (A.Y = B.Y);
    end;
    operator <>(const A: TVec; const B: TVec): bool;
    begin
      return not (A = B);
    end;
  end;
  TMoney = object
    Cents: int64;
    operator div(const A: TMoney; const AN: int64): TMoney;
    var
      LR: TMoney;
    begin
      LR.Cents := A.Cents div AN;
      return LR;
    end;
    operator mod(const A: TMoney; const AN: int64): TMoney;
    var
      LR: TMoney;
    begin
      LR.Cents := A.Cents mod AN;
      return LR;
    end;
    operator <(const A: TMoney; const B: TMoney): bool;
    begin
      return A.Cents < B.Cents;
    end;
    operator =(const A: TMoney; const B: TMoney): bool;
    begin
      return A.Cents = B.Cents;
    end;
    operator <>(const A: TMoney; const B: TMoney): bool;
    begin
      return A.Cents <> B.Cents;
    end;
  end;
  TSpan = record
    Lo: int32;
    Hi: int32;
    operator in(const AV: int32; const AR: TSpan): bool;
    begin
      return (AV >= AR.Lo) and (AV <= AR.Hi);
    end;
  end;
  TSeatObj = object(CSeat)
    Tag: int32;
  end;
  TSeatRec = record(CSeat)
    Tag: int32;
  end;

var
  LA: TVec;
  LB: TVec;
  LC: TVec;
  LM: TMoney;
  LN: TMoney;
  LS: TSpan;
  LQ1: TSeatObj;
  LQ2: TSeatObj;
  LT1: TSeatRec;
  LT2: TSeatRec;
begin
  LA.X := 1;
  LA.Y := 2;
  LB.X := 3;
  LB.Y := 4;
  LC := LA + LB * 2;
  println("{} {}", LC.X, LC.Y);
  println("{}", LA * LB);
  LC := -LA;
  println("{} {}", LC.X, LC.Y);
  println("{} {} {}", LA = LB, LA <> LB, LA = LA);
  LM.Cents := 1050;
  LN := LM div 100;
  println("{}", LN.Cents);
  LN := LM mod 100;
  println("{} {}", LN.Cents, LN < LM);
  println("{} {}", LM = LM, LM <> LM);
  LS.Lo := 1;
  LS.Hi := 6;
  println("{} {}", 5 in LS, 9 in LS);
  LQ1.Seat := 7;
  LQ2.Seat := 7;
  LQ2.Tag := 1;
  LT1.Seat := 1;
  LT2.Seat := 2;
  println("{} {}", LQ1 = LQ2, LT1 = LT2);
end.
