module exe type_object_property_virtual_err_iface_plain;

/*
  @@test
    kind error
  @@end
*/

type
  IA = interface
    property A: int32 read; write;
  end;
  TBox = object implements IA // ERROR SM0365@28: write 'virtual property A'
    FA: int32;
    property A: int32 read FA; write FA;
  end;

begin
end.
