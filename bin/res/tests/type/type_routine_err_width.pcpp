-------------------------------------------------------------------------------
  type_routine_err_width.pcpp - Type: a bitfield width on a routine-typed field

  Break step of type_routine: the : after a routine type's parameters is
  its return type, a routine-typed field takes no bitfield width
  (PR0001).
*******************************************************************************/

module exe type_routine_err_width;

/*
  @@test
    kind error
  @@end
*/

type
  TA = record
    F: routine(AN: int32): 3; // ERROR PR0001@28: expected a type
  end;

begin
end.
