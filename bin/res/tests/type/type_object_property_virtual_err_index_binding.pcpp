module exe type_object_property_virtual_err_index_binding;

/*
  @@test
    kind error
  @@end
*/

type
  TBag = object
    FI: int32;
    property Items[const AI: int32]: int32 read FI; // ERROR PR0061@49: has accessor bodies
  end;

begin
end.
