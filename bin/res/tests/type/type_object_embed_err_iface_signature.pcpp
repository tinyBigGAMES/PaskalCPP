  type_object_embed_err_iface_signature.pcpp - Type: object embed, iface signature

  Break step of type_object_embed: an embedded method whose result differs
  from the interface's (SM0366).
*******************************************************************************/

module exe type_object_embed_err_iface_signature;

/*
  @@test
    kind error
  @@end
*/

type
  INamed = interface
    method Name(): string;
  end;
  TA = object
    method Name(): int32;
    begin
      return 1;
    end;
  end;
  TBox = object implements INamed // ERROR SM0366@28: 'TBox.A.Name' does not implement 'INamed.Name'
    embed A: TA;
  end;

begin
end.
