-------------------------------------------------------------------------------
  type_array_err_index_char.pcpp - Type: array, index char

  Break step of type_array: an array bounded by chars is indexed by a char:
  LA['B'], not LA[1] (SM0261).
*******************************************************************************/

module exe type_array_err_index_char;

/*
  @@test
    kind error
  @@end
*/

var
  LA: array['A'..'E'] of int32;
  LI: int32;

begin
  LI := LA[1]; // ERROR SM0261@12: an index of 'array['A'..'E'] of int32' is a 'char' value, got 'int32'
end.
