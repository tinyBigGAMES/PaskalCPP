-------------------------------------------------------------------------------
  type_object_err_const_method.pcpp - Type: object, const method

  Break step of type_object: a method called through a const parameter: a
  method may change its object, pass it var (SM0426).
*******************************************************************************/

module exe type_object_err_const_method;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    method Bump();
    begin
      self.N := self.N + 1;
    end;
  end;

routine Touch(const AA: TA);
begin
  AA.Bump(); // ERROR SM0426@3: method 'Bump' may change its object, which is const here: pass it var
end;

begin
end.
