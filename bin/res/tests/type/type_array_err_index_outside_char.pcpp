-------------------------------------------------------------------------------
  type_array_err_index_outside_char.pcpp - Type: array, index outside char

  Break step of type_array: a constant char index lies inside the bounds too:
  'F' is past array['A'..'E'] (SM0276).
*******************************************************************************/

module exe type_array_err_index_outside_char;

/*
  @@test
    kind error
  @@end
*/

var
  LA: array['A'..'E'] of int32;

begin
  LA['F'] := 1; // ERROR SM0276@6: index 'F' is outside 'array['A'..'E'] of int32' ('A'..'E')
end.
