-------------------------------------------------------------------------------
  type_object_virtual_err_abstract_value.pcpp - Type: object virtual, abstract value

  Break step of type_object_virtual: a variable of an abstract object: it has
  a method with no body (SM0338).
*******************************************************************************/

module exe type_object_virtual_err_abstract_value;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    virtual method M(); abstract;
  end;

var
  GA: TA; // ERROR SM0338@7: 'TA' is abstract ('TA.M' has no body): it cannot be held by value or created

begin
end.
