-------------------------------------------------------------------------------
  type_record_packed_err_var.pcpp - Type: record packed, var

  Break step of type_record_packed: a field of a packed record passed to a var
  parameter: it may sit below its alignment (SM0270).
*******************************************************************************/

module exe type_record_packed_err_var;

/*
  @@test
    kind error
  @@end
*/

type
  TS = set of 0..15;
  TPk = record packed
    C: int8;
    I: int32;
    S: TS;
  end;

routine Bump(var AN: int32);
begin
  AN := AN + 1;
end;

var
  LP: TPk;

begin
  Bump(LP.I); // ERROR SM0270@8: it may be misaligned
end.
