-------------------------------------------------------------------------------
  type_object_virtual_err_abstract_not_virtual.pcpp - Type: object virtual, abstract not virtual

  Break step of type_object_virtual: abstract on a plain method: an abstract
  method is virtual (SM0337).
*******************************************************************************/

module exe type_object_virtual_err_abstract_not_virtual;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    method M(); abstract; // ERROR SM0337@17: an abstract method is virtual: write 'virtual method M'
  end;

begin
end.
