  type_object_embed_err_iface_hidden.pcpp - Type: object embed, iface hidden

  Break step of type_object_embed: a hidden embedded method fulfilling an
  interface method (SM0367).
*******************************************************************************/

module exe type_object_embed_err_iface_hidden;

/*
  @@test
    kind error
  @@end
*/

type
  INamed = interface
    method Name(): string;
  end;
  TA = object
    hidden method Name(): string;
    begin
      return "a";
    end;
  end;
  TBox = object implements INamed // ERROR SM0367@28: an interface member is never hidden
    embed A: TA;
  end;

begin
end.
