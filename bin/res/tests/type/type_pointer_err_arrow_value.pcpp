-------------------------------------------------------------------------------
  type_pointer_err_arrow_value.pcpp - Type: -> on a record

  Break step of type_pointer: -> reaches a field through a pointer, a record
  is none: write LR.X (SM0250).
*******************************************************************************/

module exe type_pointer_err_arrow_value;

/*
  @@test
    kind error
  @@end
*/

type
  TPoint = record
    X: int32;
  end;

var
  LR: TPoint;
  LX: int32;

begin
  LX := LR->X; // ERROR SM0250@9: operator '->' does not take 'TPoint'
end.
