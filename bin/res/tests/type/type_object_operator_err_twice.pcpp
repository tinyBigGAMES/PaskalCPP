-------------------------------------------------------------------------------
  type_object_operator_err_twice.pcpp - Type: object operator, twice

  Break step of type_object_operator: one symbol declared twice with the same
  operand types (SM0383).
*******************************************************************************/

module exe type_object_operator_err_twice;

/*
  @@test
    kind error
  @@end
*/

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: TVec; const B: TVec): TVec;
    begin
      return A;
    end;
    operator +(const A: TVec; const B: TVec): TVec; // ERROR SM0383
    begin
      return B;
    end;
  end;

begin
end.
