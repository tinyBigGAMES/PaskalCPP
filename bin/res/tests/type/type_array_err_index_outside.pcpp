-------------------------------------------------------------------------------
  type_array_err_index_outside.pcpp - Type: array, index outside

  Break step of type_array: a constant index lies inside the bounds: 4 is past
  array[0..3] (SM0276).
*******************************************************************************/

module exe type_array_err_index_outside;

/*
  @@test
    kind error
  @@end
*/

var
  LA: array[0..3] of int32;

begin
  LA[4] := 1; // ERROR SM0276@6: index 4 is outside 'array[0..3] of int32' (0..3)
end.
