  type_object_init_err_hidden_init.pcpp - Type: object init, hidden init

  Break step of type_object_init: hidden before an init: an init is never
  hidden (PR0058).
*******************************************************************************/

module exe type_object_init_err_hidden_init;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    hidden init(); // ERROR PR0058@5: 'hidden' does not go before init, copy or done
    begin
    end;
  end;

begin
end.
