-------------------------------------------------------------------------------
  type_choices_err_compound.pcpp - Type: += on a choice value

  Break step of type_choices: a choice value has no arithmetic, no compound
  assignment takes one (SM0250).
*******************************************************************************/

module exe type_choices_err_compound;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC += 1; // ERROR SM0250@3: operator '+=' does not take 'TColor' and 'int32'
end.
