  type_object_virtual_err_needs_override.pcpp - Type: object virtual, needs override

  Break step of type_object_virtual: a method named like an ancestor's virtual
  method without override (SM0332).
*******************************************************************************/

module exe type_object_virtual_err_needs_override;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    virtual method M();
    begin
    end;
  end;
  TB = object(TA)
    method M(); // ERROR SM0332@12: 'M' is virtual in 'TA': write 'override method M'
    begin
    end;
  end;

begin
end.
