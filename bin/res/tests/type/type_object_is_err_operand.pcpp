module exe type_object_is_err_operand;

/*
  @@test
    kind error
  @@end
*/

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;
  TPlain = object
    N: int32;
  end;

routine Check(const AP: TPlain): bool;
begin
  return AP is TPlain; // ERROR SM0271
end;

begin
end.
