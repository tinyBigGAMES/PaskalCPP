-------------------------------------------------------------------------------
  type_object_embed_err_hidden.pcpp - Type: object embed, hidden

  Break step of type_object_embed: a hidden member of the embedded type: it
  stays hidden (SM0019).
*******************************************************************************/

module exe type_object_embed_err_hidden;

/*
  @@test
    kind error
  @@end
*/

type
  TCounter = object
    hidden H: int32;
  end;
  TBox = object
    embed C: TCounter;
    method Put();
    begin
      self.H := 1; // ERROR SM0019@12: 'H' is hidden in 'TCounter'
    end;
  end;

begin
end.
