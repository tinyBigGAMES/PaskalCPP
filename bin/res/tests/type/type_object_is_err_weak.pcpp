module exe type_object_is_err_weak;

/*
  @@test
    kind error
  @@end
*/

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;

var
  LR: ref TShape;
  LW: weak TShape;
begin
  LR := ref TCircle;
  LW := LR;
  println("{}", LW is TCircle); // ERROR SM0275
end.
