-------------------------------------------------------------------------------
  type_overlay_err_duplicate.pcpp - Type: overlay, duplicate

  Break step of type_overlay: an anonymous record's field reuses a name of the
  overlay: its fields are the overlay's own (SM0004).
*******************************************************************************/

module exe type_overlay_err_duplicate;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    record
      A: int16; // ERROR SM0004@7: 'A' is already declared in this scope
      B: int16;
    end;
  end;

begin
end.
