module exe type_object_copy_err_record;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
  end;
  TR = record
    A: TA; // ERROR SM0357@8: field 'A': a record or an overlay holds no object
  end;

begin
end.
