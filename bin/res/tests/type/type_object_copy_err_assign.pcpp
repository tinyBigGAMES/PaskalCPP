-------------------------------------------------------------------------------
  type_object_copy_err_assign.pcpp - Type: object copy, assign

  Break step of type_object_copy: an object with a done and no copy
  initialized from a variable: it cannot be copied (SM0427).
*******************************************************************************/

module exe type_object_copy_err_assign;

/*
  @@test
    kind error
  @@end
*/

type
  TRes = object
    Id: int32;
    done;
    begin
    end;
  end;

routine Use();
var
  LA: TRes;
  LB: TRes = LA; // ERROR SM0427@14: 'LA' would be copied here, and 'TRes' cannot be copied: pass it var / const, return it from a local
begin
end;

begin
end.
