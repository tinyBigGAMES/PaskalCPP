  type_object_err_hidden_outside.pcpp - Type: object, hidden outside

  Break step of type_object: a hidden field read in the main block (SM0019).
*******************************************************************************/

module exe type_object_err_hidden_outside;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    hidden N: int32;
  end;

var
  GA: TA;

begin
  println("{}", GA.N); // ERROR SM0019@20: 'N' is hidden in 'TA': only the methods of 'TA' and of its descendants reach it
end.
