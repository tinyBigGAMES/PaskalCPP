module exe type_array_err_too_large_element;

/*
  @@test
    kind error
  @@end
*/

var
  LA: array[0..288230376151711743] of int32; // ERROR SM0277@7: 'array[0..288230376151711743] of int32' is too large: a type holds at most 1152921504606846975 bytes

begin
end.
