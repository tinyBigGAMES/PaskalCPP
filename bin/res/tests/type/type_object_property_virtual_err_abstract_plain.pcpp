module exe type_object_property_virtual_err_abstract_plain;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    property A: int32 read abstract; // ERROR SM0337@28: an abstract accessor is virtual: write 'virtual property A'
  end;

begin
end.
