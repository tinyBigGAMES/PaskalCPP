-------------------------------------------------------------------------------
  type_overlay_err_record_string.pcpp - Type: overlay, record string

  Break step of type_overlay: an overlay is plain data: a field holds no
  record that holds a string (the record is fine on its own; SM0313).
*******************************************************************************/

module exe type_overlay_err_record_string;

/*
  @@test
    kind error
  @@end
*/

type
  TNamed = record
    Id: int32;
    Title: string;
  end;
  TV = overlay
    A: int32;
    R: TNamed; // ERROR SM0313@5: cannot share an overlay's storage
  end;

begin
end.
