module exe type_object_own_err_weak_new;

/*
  @@test
    kind error
  @@end
*/

type
  TPlain = object
    X: int32;
  end;

routine Use();
var
  LW: weak TPlain;
begin
  LW := weak TPlain; // ERROR SM0359@9: 'weak TPlain' builds nothing
end;

begin
end.
