module exe type_object_err_method_dup;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    method Put(AN: int32);
    begin
    end;
    method Put(AS: string); // ERROR SM0004@5: 'Put' is already declared in this scope
    begin
    end;
  end;

begin
end.
