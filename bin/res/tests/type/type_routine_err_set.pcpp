-------------------------------------------------------------------------------
  type_routine_err_set.pcpp - Type: an overload set with no member of the routine type

  Break step of type_routine: assigned to a routine variable, an overload
  set gives the member of its type, and here it has none (SM0200).
*******************************************************************************/

module exe type_routine_err_set;

/*
  @@test
    kind error
  @@end
*/

routine Over(AN: int32): int32;
begin
  return AN;
end;

routine Over(const AS: string): int32;
begin
  return 0;
end;

var
  LF: routine(AN: float64): int32;

begin
  LF := Over; // ERROR SM0200@9: has no member of type
end.
