-------------------------------------------------------------------------------
  type_record_ext_err_literal_field.pcpp - Type: record ext, literal field

  Break step of type_record_ext: a record literal on an extension names the
  fields of its chain only (SM0414).
*******************************************************************************/

module exe type_record_ext_err_literal_field;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

var
  LE: TExt;

begin
  LE := TExt(A: 1, C: 2); // ERROR SM0414@20
end.
