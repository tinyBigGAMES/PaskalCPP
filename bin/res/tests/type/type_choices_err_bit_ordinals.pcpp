-------------------------------------------------------------------------------
  type_choices_err_bit_ordinals.pcpp - Type: a choices bitfield too narrow for its numbers

  Break step of type_choices: a choices bitfield holds every number as a
  signed value; 2 bits hold -2 .. 1 and cBlue is 2 (SM0316).
*******************************************************************************/

module exe type_choices_err_bit_ordinals;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

  TS = record
    Col: TColor : 2; // ERROR SM0316@19: does not hold the ordinals of 'TColor' as signed values
  end;

begin
end.
