-------------------------------------------------------------------------------
  type_object_err_parent_arrow.pcpp - Type: object, parent arrow

  Break step of type_object: parent->Z: parent is no pointer; write parent.Z
  (SM0016).
*******************************************************************************/

module exe type_object_err_parent_arrow;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    Z: int32;
  end;
  TB = object(TA)
    method GetZ(): int32;
    begin
      return parent->Z; // ERROR SM0016@14: 'parent' reaches the parent's members
    end;
  end;

begin
end.
