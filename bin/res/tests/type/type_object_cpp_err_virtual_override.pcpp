-------------------------------------------------------------------------------
  type_object_cpp_err_virtual_override.pcpp - Type: object cpp, virtual override

  Break step of type_object_cpp: virtual (not override) on a method matching a
  C++ virtual (SM0332).
*******************************************************************************/

module exe type_object_cpp_err_virtual_override;

/*
  @@test
    kind error
  @@end
*/

struct CShape {
  virtual ~CShape() = default;
  virtual int area() { return 0; }
};

type
  TSquare = object(CShape)
    S: int32;
    virtual method area(): int32; // ERROR SM0332
    begin
      return self.S;
    end;
  end;

var
  LS: TSquare;
begin
  println("{}", LS.area());
end.
