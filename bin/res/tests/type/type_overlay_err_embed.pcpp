  type_overlay_err_embed.pcpp - Type: overlay, embed

  Break step of type_overlay: an overlay holds no embeds; an object does
  (PR0034).
*******************************************************************************/

module exe type_overlay_err_embed;

/*
  @@test
    kind error
  @@end
*/

type
  TInner = record
    X: int16;
  end;
  TV = overlay
    embed E: TInner; // ERROR PR0034@5: 'embed' is not allowed in an overlay
    B: int32;
  end;

begin
end.
