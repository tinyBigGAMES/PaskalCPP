module exe type_object_cpp_err_override_const;

/*
  @@test
    kind error
  @@end
*/

struct CGauge {
  virtual ~CGauge() = default;
  virtual int corners() const { return 0; }
  int plain() { return 0; }
};

type
  TDial = object(CGauge)
    N: int32;
    override method corners(): int32; // ERROR SM0334
    begin
      return self.N;
    end;
  end;

var
  LD: TDial;
begin
  println("{}", LD.N);
end.
