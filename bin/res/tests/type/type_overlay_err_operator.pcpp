-------------------------------------------------------------------------------
  type_overlay_err_operator.pcpp - Type: overlay, operator

  Break step of type_overlay: an overlay declares no operators; a record does
  (PR0034).
*******************************************************************************/

module exe type_overlay_err_operator;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    operator +(const AL: TV; const AR: TV): TV; // ERROR PR0034@5: 'operator' is not allowed in an overlay
    begin
      return AL;
    end;
  end;

begin
end.
