  type_pointer_err_cast_no_to.pcpp - Type: ptr(x) as a pointer cast

  Break step of type_pointer: a pointer cast is ptr to T(x); ptr(x) names no
  type (PR0001).
*******************************************************************************/

module exe type_pointer_err_cast_no_to;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LU: ptr;

begin
  LU := nil;
  LP := ptr(LU); // ERROR PR0001@12: found '('
end.
