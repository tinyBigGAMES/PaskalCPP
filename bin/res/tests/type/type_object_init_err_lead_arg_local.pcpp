-------------------------------------------------------------------------------
  type_object_init_err_lead_arg_local.pcpp - Type: object init, lead arg local

  Break step of type_object_init: parent.init(...) given a local of the init:
  it runs before the locals exist (SM0346).
*******************************************************************************/

module exe type_object_init_err_lead_arg_local;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;
  TB = object(TA)
    init();
    var
      LN: int32;
    begin
      parent.init(LN); // ERROR SM0346@19: 'LN' does not exist yet
    end;
  end;

begin
end.
