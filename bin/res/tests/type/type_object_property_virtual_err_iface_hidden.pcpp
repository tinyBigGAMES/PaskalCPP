-------------------------------------------------------------------------------
  type_object_property_virtual_err_iface_hidden.pcpp - Type: object property virtual, iface hidden

  Break step of type_object_property_virtual: an interface property is never
  hidden (SM0367).
*******************************************************************************/

module exe type_object_property_virtual_err_iface_hidden;

/*
  @@test
    kind error
  @@end
*/

type
  IA = interface
    property A: int32 read; write;
  end;
  TBox = object implements IA // ERROR SM0367@28: an interface member is never hidden
    FA: int32;
    hidden virtual property A: int32 read FA; write FA;
  end;

begin
end.
