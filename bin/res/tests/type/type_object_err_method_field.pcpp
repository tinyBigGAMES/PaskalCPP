-------------------------------------------------------------------------------
  type_object_err_method_field.pcpp - Type: object, method field

  Break step of type_object: a method named like a parent field: a method
  reuses only a parent METHOD's name (SM0309).
*******************************************************************************/

module exe type_object_err_method_field;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    X: int32;
  end;
  TB = object(TA)
    method X(): int32; // ERROR SM0309@5: 'X' reuses a name of the parent chain
    begin
      return 1;
    end;
  end;

begin
end.
