-------------------------------------------------------------------------------
  type_routine_err_procedure_value.pcpp - Type: a procedure value's call used as a value

  Break step of type_routine: a routine value whose type has no return
  type gives no value (SM0406).
*******************************************************************************/

module exe type_routine_err_procedure_value;

/*
  @@test
    kind error
  @@end
*/

var
  LP: routine(AN: int32);
  LN: int32;

begin
  LP := nil;
  LN := LP(1); // ERROR SM0406@9: calls a procedure
end.
