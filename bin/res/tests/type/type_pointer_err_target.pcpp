-------------------------------------------------------------------------------
  type_pointer_err_target.pcpp - Type: a ptr to int32 into a ptr to int64

  Break step of type_pointer: two typed pointers to different types do not
  convert: cast it (SM0200).
*******************************************************************************/

module exe type_pointer_err_target;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LW: ptr to int64;

begin
  LP := nil;
  LW := LP; // ERROR SM0200@9: 'ptr to int32' does not convert implicitly to 'ptr to int64'; write ptr to int64(LP)
end.
