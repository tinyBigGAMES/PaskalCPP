-------------------------------------------------------------------------------
  type_record_err_align_below.pcpp - Type: record, align below

  Break step of type_record: align(2) on an int32 field: below the natural
  alignment 4; every field is a PaskalCPP type, so PaskalCPP knows the layout
  (SM0311, at the align value).
*******************************************************************************/

module exe type_record_err_align_below;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record align(2) // ERROR SM0311@21: align 2 is below the natural alignment 4 of 'TR', lower it with packed
    B: int32;
  end;

begin
end.
