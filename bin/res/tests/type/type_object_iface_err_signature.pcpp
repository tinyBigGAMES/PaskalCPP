  type_object_iface_err_signature.pcpp - Type: object iface, signature

  Break step of type_object_iface: a method whose result differs from the
  interface's (SM0366).
*******************************************************************************/

module exe type_object_iface_err_signature;

/*
  @@test
    kind error
  @@end
*/

type
  IShape = interface
    method Area(): int32;
  end;
  TBox = object implements IShape // ERROR SM0366@28: 'TBox.Area' does not implement 'IShape.Area'
    virtual method Area(): int64;
    begin
      return 1;
    end;
  end;

begin
end.
