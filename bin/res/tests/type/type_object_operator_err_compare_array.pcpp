module exe type_object_operator_err_compare_array;

/*
  @@test
    kind error
  @@end
*/

type
  TTicket = object
    Seat: int32;
  end;

var
  LA: array[0..1] of TTicket;
  LB: array[0..1] of TTicket;
  LE: bool;
begin
  LE := LA <> LB; // ERROR SM0252
end.
