  type_object_copy_err_by_name.pcpp - Type: object copy, by name

  Break step of type_object_copy: copy called by name: it runs when an object
  is copied (SM0342).
*******************************************************************************/

module exe type_object_copy_err_by_name;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    method Again();
    begin
      self.copy(); // ERROR SM0342@12: copy runs when an object is copied
    end;
  end;

begin
end.
