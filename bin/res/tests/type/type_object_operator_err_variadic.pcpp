module exe type_object_operator_err_variadic;

/*
  @@test
    kind error
  @@end
*/

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(const A: TVec; ...): TVec; // ERROR PR0062
    begin
      return A;
    end;
  end;

begin
end.
