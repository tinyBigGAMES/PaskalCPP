  type_object_embed_err_bare.pcpp - Type: object embed, bare

  Break step of type_object_embed: an embed's member named bare in a method:
  write self.Count (SM0018).
*******************************************************************************/

module exe type_object_embed_err_bare;

/*
  @@test
    kind error
  @@end
*/

type
  TCounter = object
    Count: int32;
  end;
  TBox = object
    embed C: TCounter;
    method Put();
    begin
      Count := 1; // ERROR SM0018@7: write self.Count
    end;
  end;

begin
end.
