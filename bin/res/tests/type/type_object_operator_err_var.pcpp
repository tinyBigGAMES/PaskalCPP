module exe type_object_operator_err_var;

/*
  @@test
    kind error
  @@end
*/

type
  TVec = record
    X: int32;
    Y: int32;
    operator +(var A: TVec; const B: TVec): TVec; // ERROR SM0384
    begin
      return B;
    end;
  end;

begin
end.
