-------------------------------------------------------------------------------
  type_record_err_align_cpp_max.pcpp - Type: record, align cpp max

  Break step of type_record: align(cpp("16384")): at most 8192 on every
  target, a C++ value too (SM0312).
*******************************************************************************/

module exe type_record_err_align_cpp_max;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record align(cpp("16384")) // ERROR SM0312@21: align 16384 exceeds 8192
    G: int32;
  end;

var
  V: TR;

begin
  V.G := 1;
end.
