-------------------------------------------------------------------------------
  type_pointer_err_untyped.pcpp - Type: the untyped ptr into a ptr to T

  Break step of type_pointer: the untyped ptr is no ptr to T: cast it
  (SM0200).
*******************************************************************************/

module exe type_pointer_err_untyped;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LU: ptr;

begin
  LU := nil;
  LP := LU; // ERROR SM0200@9: 'ptr' does not convert implicitly to 'ptr to int32'; write ptr to int32(LU)
end.
