-------------------------------------------------------------------------------
  type_record_err_bit_store_literal.pcpp - Type: record, bit store literal

  Break step of type_record: a record literal's field is a store too: TR(B: 7)
  into int32 : 3 (SM0200).
*******************************************************************************/

module exe type_record_err_bit_store_literal;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record
    B: int32 : 3;
    U: uint8 : 2;
  end;

var
  LR: TR;

begin
  LR := TR(B: 7); // ERROR SM0200@15: 7 does not fit in 'int32 : 3' (-4..3)
end.
