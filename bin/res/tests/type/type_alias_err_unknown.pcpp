-------------------------------------------------------------------------------
  type_alias_err_unknown.pcpp - Type: an alias of a name PaskalCPP does not know

  Break step of type_alias: TNope is taken as a C/C++ type, so clang
  reports it (ZB0016); the program is never started.
*******************************************************************************/

module exe type_alias_err_unknown;

/*
  @@test
    kind error
  @@end
*/

type
  TA = TNope; // ERROR ZB0016@8: unknown type name 'TNope'

begin
end.
