-------------------------------------------------------------------------------
  type_object.pcpp - Type: object types and methods

  An object (BNF.md sec 4: object type, method decl) is a value type with
  fields and methods; a method's body is written in the type. Shown here:
  - a parent in parentheses: one of this module (TPoint = object(TBase)),
    a grandparent chain (TPoint3), an imported unit's object, qualified
    (object(type_object_unit.TShape)), and a C++ struct declared plain in
    this file (object(CCounter): its members are C++'s, reached as written);
  - inside a method its members (inherited ones too) are reached through
    self: self.X, self.Show(); a bare name is a local, a parameter or a
    module name, never a member (a bare member name is an error: write
    self.X). A parameter X and the field self.X are two things; the member
    self.Value() and the module routine Value() are two things;
  - a hidden member (hidden X: T; hidden method M) is reached only by the
    methods of its type and of its descendants; a descendant reaches it
    through self, parent.X or a value of its own type (TSecretChild);
  - self is the object itself: read, passed, returned (a copy) and
    assigned (self := AOther);
  - parent.<member> reaches the parent's member: parent.Show() calls the
    one the child's Show hides, parent.Z := 1 sets the inherited field;
  - a method may reuse a parent METHOD's name: it hides every parent
    method of that name (TPoint.Put(string) hides TBase.Put(int32), and
    parent.Put reaches it); a method call is not virtual, so TBase.Twice
    calls TBase.Show even on a TPoint (twice 2);
  - a method sees a method declared after it in the same object, takes
    var blocks, and runs on a copy, a local, a pointer (^. and ->).
*******************************************************************************/

module exe type_object;

/*
  @@test
    kind run
    expect
    | move 12 23 1
    | show 36 twice 2
    | put 40
    | copy 12 100 sum 124
    | ptr 13 38
    | grandparent 10
    | later 10 member 18 module 100
    | clone 9 10 same true
    | assign self 9
    | local 2 2
    | unit parent 49 40
    | C++ parent 19 7 14
    | hidden 22
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/type/fixtures";

import type_object_unit;

struct CCounter {
  int k = 7;
  int twice() const { return k * 2; }
};

routine Value(): int32;
begin
  return 100;
end;

type
  TBase = object
    Z: int32;
    method Show(): int32;
    begin
      return self.Z;
    end;
    method Twice(): int32;
    begin
      // Binds to TBase.Show: a method call is not virtual
      return self.Show() * 2;
    end;
    method Put(AN: int32): int32;
    begin
      return AN;
    end;
  end;
  TPoint = object(TBase)
    X: int32;
    Y: int32;
    method Move(const ADX: int32; const ADY: int32);
    begin
      self.X := self.X + ADX;
      self.Y := self.Y + ADY;
    end;
    method Show(): int32;
    begin
      return parent.Show() + self.X + self.Y;
    end;
    method SetX(X: int32);
    begin
      // The parameter X and the field self.X are two things
      self.X := X;
    end;
    method SetZ(const AV: int32);
    begin
      parent.Z := AV;
    end;
    method Put(AS: string): int32;
    begin
      // Hides every TBase.Put: parent.Put reaches the parent's
      return parent.Put(int32(len(AS))) * 10;
    end;
    method Sum(): int32;
    var
      LTotal: int32;
    begin
      LTotal := self.X + self.Y + self.Z;
      return LTotal;
    end;
  end;
  TPoint3 = object(TPoint)
    W: int32;
    method Show(): int32;
    begin
      // parent.Show is TPoint's, which calls TBase's in turn
      return parent.Show() + self.W;
    end;
  end;
  TCounter = object
    N: int32;
    method Bump();
    begin
      self.N := self.N + 1;
    end;
    method First(): int32;
    begin
      // A method declared later in the same object is visible here
      return self.Second() + 1;
    end;
    method Second(): int32;
    begin
      return self.N;
    end;
    method Value(): int32;
    begin
      return self.N * 2;
    end;
    method Doubled(): int32;
    begin
      // self.Value() is the member, not the module routine Value
      return self.Value();
    end;
    method Same(const AC: TCounter): bool;
    begin
      return AC.N = self.N;
    end;
    method Clone(): TCounter;
    begin
      return self;
    end;
    method CopyFrom(const AOther: TCounter);
    begin
      self := AOther;
    end;
    method IsSelf(): bool;
    begin
      return self.Same(self);
    end;
  end;
  TSquare = object(type_object_unit.TShape)
    Size: int32;
    method Area(): int32;
    begin
      return self.Size * self.Size + self.Describe();
    end;
  end;
  TCppChild = object(CCounter)
    X: int32;
    method Total(): int32;
    begin
      return self.X + self.twice();
    end;
  end;
  TSecret = object
    hidden Code: int32;
    hidden method Mix(): int32;
    begin
      return self.Code * 3;
    end;
    method Seed(const AV: int32);
    begin
      self.Code := AV;
    end;
  end;
  TSecretChild = object(TSecret)
    method Reveal(const AOther: TSecretChild): int32;
    begin
      // A descendant reaches hidden members through self, parent. and its own type
      return self.Mix() + parent.Code + AOther.Code;
    end;
  end;

routine CountTwice(): int32;
var
  LC: TCounter;
begin
  LC.Bump();
  LC.Bump();
  return LC.N;
end;

var
  GP: TPoint;
  GQ: TPoint;
  GR: TPoint3;
  GPtr: ptr to TPoint;
  GC: TCounter;
  GD: TCounter;
  GS: TSquare;
  GK: TCppChild;
  GT: TSecretChild;
  GU: TSecretChild;

begin
  GP.SetZ(1);
  GP.X := 2;
  GP.Y := 3;
  GP.Move(10, 20);
  println("move {} {} {}", GP.X, GP.Y, GP.Z);
  println("show {} twice {}", GP.Show(), GP.Twice());
  println("put {}", GP.Put("four"));
  GQ := GP;
  GQ.SetX(100);
  println("copy {} {} sum {}", GP.X, GQ.X, GQ.Sum());
  GPtr := address of GP;
  GPtr^.Move(1, 1);
  println("ptr {} {}", GPtr^.X, GPtr->Show());
  GR.Z := 1;
  GR.X := 2;
  GR.Y := 3;
  GR.W := 4;
  println("grandparent {}", GR.Show());
  GC.N := 9;
  println("later {} member {} module {}", GC.First(), GC.Doubled(), Value());
  GD := GC.Clone();
  GD.Bump();
  println("clone {} {} same {}", GC.N, GD.N, GC.IsSelf());
  GD.CopyFrom(GC);
  println("assign self {}", GD.N);
  println("local {} {}", CountTwice(), CountTwice());
  GS.Sides := 4;
  GS.Size := 3;
  println("unit parent {} {}", GS.Area(), GS.Describe());
  GK.X := 5;
  println("C++ parent {} {} {}", GK.Total(), GK.k, GK.twice());
  GT.Seed(5);
  GU.Seed(2);
  println("hidden {}", GT.Reveal(GU));
end.
