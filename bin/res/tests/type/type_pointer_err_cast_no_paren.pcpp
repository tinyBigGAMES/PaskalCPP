-------------------------------------------------------------------------------
  type_pointer_err_cast_no_paren.pcpp - Type: a pointer cast without parentheses

  Break step of type_pointer: a pointer cast takes its value in parentheses
  (PR0001).
*******************************************************************************/

module exe type_pointer_err_cast_no_paren;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LU: ptr;

begin
  LU := nil;
  LP := ptr to int32 LU; // ERROR PR0001@22: expected '(', found 'LU'
end.
