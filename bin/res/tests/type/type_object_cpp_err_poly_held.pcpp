  type_object_cpp_err_poly_held.pcpp - Type: object cpp, poly held

  Break step of type_object_cpp: a copy from a const parameter whose object is
  polymorphic through its C++ base (SM0428).
*******************************************************************************/

module exe type_object_cpp_err_poly_held;

/*
  @@test
    kind error
  @@end
*/

struct CNode {
  virtual ~CNode() = default;
  virtual int kind() { return 1; }
};

type
  TA = object(CNode)
    N: int32;
  end;
  TB = object(TA)
    M: int32;
  end;

routine Keep(const AA: TA): int32;
var
  LC: TA;
begin
  LC := AA; // ERROR SM0428
  return LC.N;
end;

var
  LB: TB;
begin
  println("{}", Keep(LB));
end.
