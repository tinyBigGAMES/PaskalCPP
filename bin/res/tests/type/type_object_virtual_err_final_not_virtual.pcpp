  type_object_virtual_err_final_not_virtual.pcpp - Type: object virtual, final not virtual

  Break step of type_object_virtual: final on a plain method: final closes a
  virtual one (SM0336).
*******************************************************************************/

module exe type_object_virtual_err_final_not_virtual;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    final method M(); // ERROR SM0336@5: 'final' closes a virtual method
    begin
    end;
  end;

begin
end.
