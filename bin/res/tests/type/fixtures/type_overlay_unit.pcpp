  type_overlay_unit.pcpp - Type fixture: a unit type_overlay.pcpp imports: an
  exported overlay (TPixel) that type_overlay.pcpp uses qualified.

  Nothing to check here: type_overlay.pcpp checks it.
*******************************************************************************/

module unit type_overlay_unit;

exported type
  TPixel = overlay
    Value: uint32;
    record
      R: uint8;
      G: uint8;
      B: uint8;
      A: uint8;
    end;
  end;

end.
