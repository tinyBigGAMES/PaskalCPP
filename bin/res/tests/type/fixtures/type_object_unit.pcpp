  type_object_unit.pcpp - Type fixture: a unit type_object.pcpp imports: an
  exported object TShape with a field and a method, a parent for an importer's
  object.

  Nothing to check here: type_object.pcpp checks it.
*******************************************************************************/

module unit type_object_unit;

exported type
  TShape = object
    Sides: int32;
    method Describe(): int32;
    begin
      return self.Sides * 10;
    end;
  end;

end.
