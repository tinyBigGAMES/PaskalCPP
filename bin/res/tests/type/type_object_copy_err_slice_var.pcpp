  type_object_copy_err_slice_var.pcpp - Type: object copy, slice var

  Break step of type_object_copy: a polymorphic object assigned through a var
  parameter: it may be a descendant (SM0429).
*******************************************************************************/

module exe type_object_copy_err_slice_var;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
  end;

routine Reset(var AA: TA);
var
  LB: TA;
begin
  AA := LB; // ERROR SM0429@3: 'AA' may hold a descendant of 'TA' (it is polymorphic)
end;

begin
end.
