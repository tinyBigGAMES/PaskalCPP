-------------------------------------------------------------------------------
  type_object_operator_err_compare_less.pcpp - Type: object operator, compare less

  Break step of type_object_operator: objects compared with < by a type that
  declares only = and <> (SM0252).
*******************************************************************************/

module exe type_object_operator_err_compare_less;

/*
  @@test
    kind error
  @@end
*/

type
  TTicket = object
    Seat: int32;
    operator =(const A: TTicket; const B: TTicket): bool;
    begin
      return A.Seat = B.Seat;
    end;
    operator <>(const A: TTicket; const B: TTicket): bool;
    begin
      return A.Seat <> B.Seat;
    end;
  end;

var
  LA: TTicket;
  LB: TTicket;
  LE: bool;
begin
  LE := LA < LB; // ERROR SM0252
end.
