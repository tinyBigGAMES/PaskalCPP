module exe type_object_err_method_field_dup;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    Put: int32;
    method Put(); // ERROR SM0004@5: 'Put' is already declared in this scope
    begin
    end;
  end;

begin
end.
