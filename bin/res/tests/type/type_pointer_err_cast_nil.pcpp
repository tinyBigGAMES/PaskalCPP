-------------------------------------------------------------------------------
  type_pointer_err_cast_nil.pcpp - Type: nil cast to a pointer

  Break step of type_pointer: nil needs no cast, it converts to every
  pointer (SM0265).
*******************************************************************************/

module exe type_pointer_err_cast_nil;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;

begin
  LP := ptr to int32(nil); // ERROR SM0265@22: 'nil' cannot be cast to 'ptr to int32': a pointer cast takes a pointer that keeps const, or an integer of pointer width
end.
