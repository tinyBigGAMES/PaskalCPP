  type_object_own_err_copy.pcpp - Type: object own, copy

  Break step of type_object_own: an own copied from a variable: an own is the
  sole owner (SM0427).
*******************************************************************************/

module exe type_object_own_err_copy;

/*
  @@test
    kind error
  @@end
*/

type
  TPlain = object
    X: int32;
  end;

routine Use();
var
  LA: own TPlain;
  LB: own TPlain;
begin
  LA := own TPlain;
  LB := LA; // ERROR SM0427@9: an own is the sole owner of its object
end;

begin
end.
