-------------------------------------------------------------------------------
  type_object_property_err_own_read.pcpp - Type: object property, own read

  Break step of type_object_property: a read reads its field, never its own
  property (SM0374).
*******************************************************************************/

module exe type_object_property_err_own_read;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    FN: int32;
    property N: int32 read
      begin
        return self.N; // ERROR SM0374@21: the read of 'N' reads the property again, forever
      end;
  end;

begin
end.
