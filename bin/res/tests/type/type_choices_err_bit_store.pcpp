-------------------------------------------------------------------------------
  type_choices_err_bit_store.pcpp - Type: a value a choices bitfield cannot hold

  Break step of type_choices: TColor : 3 holds -4 .. 3, (TColor)4 does not
  fit (SM0200).
*******************************************************************************/

module exe type_choices_err_bit_store;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

  TS = record
    Col: TColor : 3;
  end;

var
  LS: TS;

begin
  LS.Col := (TColor)4; // ERROR SM0200@13: 4 does not fit in 'TColor : 3' (-4..3)
end.
