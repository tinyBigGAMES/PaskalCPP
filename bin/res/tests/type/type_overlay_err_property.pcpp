  type_overlay_err_property.pcpp - Type: overlay, property

  Break step of type_overlay: an overlay holds no properties; an object does
  (PR0034).
*******************************************************************************/

module exe type_overlay_err_property;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    property P: int32 read A; // ERROR PR0034@5: 'property' is not allowed in an overlay
  end;

begin
end.
