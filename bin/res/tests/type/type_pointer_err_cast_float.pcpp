-------------------------------------------------------------------------------
  type_pointer_err_cast_float.pcpp - Type: a float cast to a pointer

  Break step of type_pointer: a pointer cast takes a pointer or an integer,
  not a float (SM0265).
*******************************************************************************/

module exe type_pointer_err_cast_float;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LF: float64;

begin
  LF := 1.0;
  LP := ptr to int32(LF); // ERROR SM0265@22: 'float64' cannot be cast to 'ptr to int32': a pointer cast takes a pointer that keeps const, or an integer of pointer width
end.
