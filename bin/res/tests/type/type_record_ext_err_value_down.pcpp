-------------------------------------------------------------------------------
  type_record_ext_err_value_down.pcpp - Type: record ext, value down

  Break step of type_record_ext: a TBase value does not convert to its
  extension TExt (SM0200).
*******************************************************************************/

module exe type_record_ext_err_value_down;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

var
  LB: TBase;
  LE: TExt;

begin
  LE := LB; // ERROR SM0200@9: does not convert implicitly
end.
