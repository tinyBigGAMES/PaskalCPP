-------------------------------------------------------------------------------
  type_object_property_err_var_arg.pcpp - Type: object property, var arg

  Break step of type_object_property: a property is no variable for a var
  parameter (SM0405).
*******************************************************************************/

module exe type_object_property_err_var_arg;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;

routine Bump(var AN: int32);
begin
  AN := AN + 1;
end;

var
  LB: TBox;
begin
  Bump(LB.N); // ERROR SM0405@8
end.
