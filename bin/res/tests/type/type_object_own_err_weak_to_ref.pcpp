module exe type_object_own_err_weak_to_ref;

/*
  @@test
    kind error
  @@end
*/

type
  TPlain = object
    X: int32;
  end;

routine Use(const AW: weak TPlain);
var
  LR: ref TPlain;
begin
  LR := AW; // ERROR SM0200@9: 'weak TPlain' does not convert implicitly to 'ref TPlain'
end;

begin
end.
