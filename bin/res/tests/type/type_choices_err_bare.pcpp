-------------------------------------------------------------------------------
  type_choices_err_bare.pcpp - Type: a value named bare

  Break step of type_choices: a value is reached through its type
  (SM0015).
*******************************************************************************/

module exe type_choices_err_bare;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC := cRed; // ERROR SM0015@9: 'cRed' is a choice value: write TColor.cRed
end.
