-------------------------------------------------------------------------------
  type_record_err_too_large.pcpp - Type: record, too large

  Break step of type_record: no type holds more than 1152921504606846975
  bytes: two fields of 2^59 bytes are 2^60 (SM0277, at the record's name).
*******************************************************************************/

module exe type_record_err_too_large;

/*
  @@test
    kind error
  @@end
*/

type
  TBig = record // ERROR SM0277@3: 'TBig' is too large: a type holds at most 1152921504606846975 bytes
    A: array[0..576460752303423487] of uint8;
    B: array[0..576460752303423487] of uint8;
  end;

var
  LB: TBig;

begin
end.
