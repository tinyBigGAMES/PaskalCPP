  type_record_err_anon_record.pcpp - Type: record, anon record

  Break step of type_record: an anonymous record goes inside an overlay, not
  straight in a record (PR0034).
*******************************************************************************/

module exe type_record_err_anon_record;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record
    record // ERROR PR0034@5: 'record' is not allowed in a record
      B: int32;
    end;
  end;

begin
end.
