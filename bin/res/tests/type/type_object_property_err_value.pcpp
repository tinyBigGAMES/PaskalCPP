-------------------------------------------------------------------------------
  type_object_property_err_value.pcpp - Type: object property, value

  Break step of type_object_property: a property assignment is a statement
  (SM0377).
*******************************************************************************/

module exe type_object_property_err_value;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;

var
  LB: TBox;
  LX: int32;
begin
  LX := LB.N := 1; // ERROR SM0377@9: an assignment to property 'N' is a statement
end.
