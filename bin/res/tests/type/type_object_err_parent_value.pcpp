-------------------------------------------------------------------------------
  type_object_err_parent_value.pcpp - Type: object, parent value

  Break step of type_object: parent as a value: parent only reaches the
  parent's members, write parent.<member> (SM0016).
*******************************************************************************/

module exe type_object_err_parent_value;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    Z: int32;
  end;
  TB = object(TA)
    method Copy(): TA;
    begin
      return parent; // ERROR SM0016@14: 'parent' reaches the parent's members
    end;
  end;

begin
end.
