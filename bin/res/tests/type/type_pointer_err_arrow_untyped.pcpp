  type_pointer_err_arrow_untyped.pcpp - Type: -> on the untyped ptr

  Break step of type_pointer: nor is the untyped ptr a way to a field, it
  points at no record (SM0250).
*******************************************************************************/

module exe type_pointer_err_arrow_untyped;

/*
  @@test
    kind error
  @@end
*/

var
  LU: ptr;
  LX: int32;

begin
  LX := LU->X; // ERROR SM0250@9: operator '->' does not take 'ptr'
end.
