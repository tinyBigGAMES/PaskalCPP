module exe type_record_err_parent_object;

/*
  @@test
    kind error
  @@end
*/

type
  TO = object
    A: int32;
  end;
  TR = record(TO) // ERROR SM0308@15: 'TO' cannot be the parent of a record
    B: int32;
  end;

begin
end.
