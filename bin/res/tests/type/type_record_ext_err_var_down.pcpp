-------------------------------------------------------------------------------
  type_record_ext_err_var_down.pcpp - Type: record ext, var down

  Break step of type_record_ext: a var TExt parameter takes no TBase variable:
  only an extension passes to its base (SM0405).
*******************************************************************************/

module exe type_record_ext_err_var_down;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

routine SetB(var AE: TExt);
begin
  AE.B := 1;
end;

var
  LB: TBase;

begin
  SetB(LB); // ERROR SM0405@8
end.
