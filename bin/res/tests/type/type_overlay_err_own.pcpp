-------------------------------------------------------------------------------
  type_overlay_err_own.pcpp - Type: overlay, own

  Break step of type_overlay: an overlay is plain data: it holds no own of an
  object (SM0357).
*******************************************************************************/

module exe type_overlay_err_own;

/*
  @@test
    kind error
  @@end
*/

type
  TO = object
    N: int32;
  end;
  TV = overlay
    A: int32;
    O: own TO; // ERROR SM0357@8: a record or an overlay holds no object
  end;

begin
end.
