  type_overlay_err_cpp_ctor.pcpp - Type: overlay, cpp ctor

  Break step of type_overlay: a C++ type that builds itself (a constructor)
  cannot share an overlay's storage (SM0313, judged in the emitted C++).
*******************************************************************************/

module exe type_overlay_err_cpp_ctor;

/*
  @@test
    kind error
  @@end
*/

struct CName { CName() : Len(0) {} int Len; };

type
  TV = overlay
    A: int32;
    N: CName; // ERROR SM0313@5: is not plain data
  end;

var
  V: TV;

begin
  V.A := 1;
end.
