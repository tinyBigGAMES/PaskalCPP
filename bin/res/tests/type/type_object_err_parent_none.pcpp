module exe type_object_err_parent_none;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    Z: int32;
    method Show(): int32;
    begin
      return parent.Show(); // ERROR SM0012@14: parent: 'TA' has no parent type
    end;
  end;

begin
end.
