-------------------------------------------------------------------------------
  type_record_err_align_cpp_packed.pcpp - Type: record, align cpp packed

  Break step of type_record: record packed align(cpp("6")): a packed record
  checks its C++ align value too (SM0310).
*******************************************************************************/

module exe type_record_err_align_cpp_packed;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record packed align(cpp("6")) // ERROR SM0310@28: align 6 is not a power of two
    G: int32;
  end;

var
  V: TR;

begin
  V.G := 1;
end.
