  type_object_embed_err_hidden_embed.pcpp - Type: object embed, hidden embed

  Break step of type_object_embed: a member reached through a hidden embed
  outside its methods (SM0019).
*******************************************************************************/

module exe type_object_embed_err_hidden_embed;

/*
  @@test
    kind error
  @@end
*/

type
  TCounter = object
    Count: int32;
  end;
  TBox = object
    hidden embed C: TCounter;
  end;

routine Use();
var
  LB: TBox;
begin
  LB.Count := 1; // ERROR SM0019@6: 'C' is hidden in 'TBox'
end;

begin
end.
