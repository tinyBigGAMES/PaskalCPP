module exe type_record_err_compare_overlay;

/*
  @@test
    kind error
  @@end
*/

type
  TBits = overlay
    Whole: uint32;
    Low: uint16;
  end;

var
  LA: TBits;
  LB: TBits;

begin
  if LA <> LB then // ERROR SM0252@6: cannot compare 'TBits'
  end;
end.
