  type_object_embed_err_shared_iface.pcpp - Type: object embed, shared iface

  Break step of type_object_embed: an interface method two embeds have:
  declare it (SM0370).
*******************************************************************************/

module exe type_object_embed_err_shared_iface;

/*
  @@test
    kind error
  @@end
*/

type
  INamed = interface
    method Name(): string;
  end;
  TA = object
    method Name(): string;
    begin
      return "a";
    end;
  end;
  TB = object
    method Name(): string;
    begin
      return "b";
    end;
  end;
  TBoth = object implements INamed // ERROR SM0370@29: two embeds, 'A' and 'B', have it
    embed A: TA;
    embed B: TB;
  end;

begin
end.
