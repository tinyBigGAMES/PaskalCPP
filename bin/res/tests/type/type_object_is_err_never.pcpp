module exe type_object_is_err_never;

/*
  @@test
    kind error
  @@end
*/

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
  end;
  TSquare = object(TShape)
    S: int32;
  end;

routine Check(const AC: TCircle): bool;
begin
  return AC is TSquare; // ERROR SM0273
end;

begin
end.
