module exe type_object_operator_err_compare;

/*
  @@test
    kind error
  @@end
*/

type
  TTicket = object
    Seat: int32;
  end;

var
  LA: TTicket;
  LB: TTicket;
  LE: bool;
begin
  LE := LA = LB; // ERROR SM0252
end.
