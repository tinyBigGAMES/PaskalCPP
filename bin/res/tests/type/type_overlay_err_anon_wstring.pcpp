-------------------------------------------------------------------------------
  type_overlay_err_anon_wstring.pcpp - Type: overlay, anon wstring

  Break step of type_overlay: an anonymous record in an overlay shares the
  overlay's storage: it holds no wstring (SM0313).
*******************************************************************************/

module exe type_overlay_err_anon_wstring;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    record
      W: wstring; // ERROR SM0313@7: cannot share an overlay's storage
      N: int16;
    end;
  end;

begin
end.
