-------------------------------------------------------------------------------
  type_choices_err_no_value.pcpp - Type: a value its type does not have

  Break step of type_choices: the type has no value of that name (SM0010).
*******************************************************************************/

module exe type_choices_err_no_value;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC := TColor.cPink; // ERROR SM0010@9: choices 'TColor' has no value 'cPink'
end.
