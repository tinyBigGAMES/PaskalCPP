-------------------------------------------------------------------------------
  type_object_virtual_err_override_signature.pcpp - Type: object virtual, override signature

  Break step of type_object_virtual: an override taking other parameter types
  than the method it overrides (SM0334).
*******************************************************************************/

module exe type_object_virtual_err_override_signature;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    virtual method M(AX: int32);
    begin
    end;
  end;
  TB = object(TA)
    override method M(AX: int64); // ERROR SM0334@21: 'M' must take the parameters and return the type of 'TA.M' it overrides
    begin
    end;
  end;

begin
end.
