module exe type_object_err_parent_choices;

/*
  @@test
    kind error
  @@end
*/

type
  TC = choices(cA, cB);
  TO = object(TC) // ERROR SM0308@15: 'TC' cannot be the parent of an object
    X: int32;
  end;

begin
end.
