module exe type_object_iface_err_value;

/*
  @@test
    kind error
  @@end
*/

type
  IShape = interface
    method Area(): int32;
  end;

routine Use();
var
  LV: IShape; // ERROR SM0338@7: 'IShape' is an interface
begin
end;

begin
end.
