-------------------------------------------------------------------------------
  type_object_init_err_init_by_name.pcpp - Type: object init, init by name

  Break step of type_object_init: init called by name: it runs when an object
  is built (SM0342).
*******************************************************************************/

module exe type_object_init_err_init_by_name;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    method Reset();
    begin
      self.init(); // ERROR SM0342@12: init runs when an object is built: it is never called
    end;
  end;

begin
end.
