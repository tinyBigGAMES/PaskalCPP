-------------------------------------------------------------------------------
  type_overlay_err_nested_record.pcpp - Type: overlay, nested record

  Break step of type_overlay: an anonymous record goes inside an overlay, not
  inside an anonymous record (PR0034).
*******************************************************************************/

module exe type_overlay_err_nested_record;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    record
      B: int32;
      record // ERROR PR0034@7: 'record' is not allowed in an anonymous record
        C: int32;
      end;
    end;
  end;

begin
end.
