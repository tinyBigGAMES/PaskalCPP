-------------------------------------------------------------------------------
  type_object_init_err_virtual_call.pcpp - Type: object init, virtual call

  Break step of type_object_init: a virtual method called in an init: the
  object is not its own type yet (SM0348).
*******************************************************************************/

module exe type_object_init_err_virtual_call;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    init();
    begin
      self.N := self.Size(); // ERROR SM0348@17: 'Size' is virtual
    end;
    virtual method Size(): int32;
    begin
      return 1;
    end;
  end;

begin
end.
