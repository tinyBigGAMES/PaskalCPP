  type_record_err_align_max.pcpp - Type: record, align max

  Break step of type_record: align(16384): at most 8192 on every target
  (SM0312).
*******************************************************************************/

module exe type_record_err_align_max;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record align(16384) // ERROR SM0312@21: align 16384 exceeds 8192
    B: int32;
  end;

begin
end.
