  type_object_iface_err_repeat.pcpp - Type: object iface, repeat

  Break step of type_object_iface: an interface repeating its parent's method
  (SM0368).
*******************************************************************************/

module exe type_object_iface_err_repeat;

/*
  @@test
    kind error
  @@end
*/

type
  IShape = interface
    method Area(): int32;
  end;
  IShape2 = interface(IShape)
    method Area(): int32; // ERROR SM0368@12: method 'Area' of interface 'IShape2' is already declared by its parent 'IShape'
  end;

begin
end.
