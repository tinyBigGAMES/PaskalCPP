-------------------------------------------------------------------------------
  type_object_embed.pcpp - Type: embed

  embed F: T; in an object holds a T (a field: it is built, copied and
  freed as one) whose members are reached on the object too (BNF.md
  sec 4 object type, embed decl). Shown here:
  - the object's own members and inherited ones win: TWidget.Count is its
    own field, the embedded counter's is self.C.Count;
  - a name the chain does not declare is an embed's: self.Bump is C's
    (C embedded by the parent TBase), self.X is P's (a record extension:
    X is its parent TPoint's field), reached on a variable too (LW.Bump);
  - embeds nest: TDeep embeds a TWidget, so LD.Bump is W.C.Bump and LD.X
    is W.P.X; the nearest depth wins, two embeds at one depth having a
    name is an error at the use (name one, as self.A.X);
  - an embed fulfils an interface: TWidget implements INamed with C's
    Name (a call through the interface runs it; C's method needs no
    virtual: the object forwards to it);
  - an embedded type's hidden members stay hidden, and a hidden embed
    is reached only where a hidden field is.
*******************************************************************************/

module exe type_object_embed;

/*
  @@test
    kind run
    expect
    | 2 9 5 6 counter
    | 3
    | named counter
    | 10 7 counter
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

type
  TCounter = object
    Count: int32;
    method Bump(const AStep: int32);
    begin
      self.Count := self.Count + AStep;
    end;
    method Name(): string;
    begin
      return "counter";
    end;
  end;
  TPoint = record
    X: int32;
    Y: int32;
  end;
  TPoint3 = record(TPoint)
    Z: int32;
  end;
  INamed = interface
    method Name(): string;
  end;
  TBase = object
    embed C: TCounter;
  end;
  TWidget = object(TBase) implements INamed
    embed P: TPoint3;
    Count: int32;
    method Show();
    begin
      self.Bump(2);
      self.X := 5;
      self.Z := 6;
      self.Count := 9;
      println("{} {} {} {} {}", self.C.Count, self.Count, self.X, self.Z, self.Name());
    end;
  end;
  TDeep = object
    embed W: TWidget;
  end;

routine Named(var AName: INamed);
begin
  println("named {}", AName.Name());
end;

var
  LW: TWidget;
  LD: TDeep;
begin
  LW.Show();
  LW.Bump(1);
  println("{}", LW.C.Count);
  Named(LW);
  LD.Bump(10);
  LD.X := 7;
  println("{} {} {}", LD.W.C.Count, LD.W.P.X, LD.Name());
end.
