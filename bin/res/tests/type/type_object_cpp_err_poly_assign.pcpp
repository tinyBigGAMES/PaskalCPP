  type_object_cpp_err_poly_assign.pcpp - Type: object cpp, poly assign

  Break step of type_object_cpp: an assignment into a var parameter whose
  object is polymorphic through its C++ base (SM0429).
*******************************************************************************/

module exe type_object_cpp_err_poly_assign;

/*
  @@test
    kind error
  @@end
*/

struct CNode {
  virtual ~CNode() = default;
  virtual int kind() { return 1; }
};

type
  TA = object(CNode)
    N: int32;
  end;
  TB = object(TA)
    M: int32;
  end;

routine Reset(var AA: TA);
var
  LC: TA;
begin
  AA := LC; // ERROR SM0429
end;

var
  LB: TB;
begin
  Reset(LB);
  println("{}", LB.N);
end.
