-------------------------------------------------------------------------------
  type_object_property_virtual_err_needs_override.pcpp - Type: object property virtual, needs override

  Break step of type_object_property_virtual: a parent's virtual property is
  continued by override (SM0332).
*******************************************************************************/

module exe type_object_property_virtual_err_needs_override;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = object
    FA: int32;
    virtual property A: int32 read FA; write FA;
  end;
  TKid = object(TBase)
    property A: int32 read FA; // ERROR SM0332@14: 'A' is virtual in 'TBase': write 'override property A'
  end;

begin
end.
