module exe type_object_iface_err_missing;

/*
  @@test
    kind error
  @@end
*/

type
  IShape = interface
    method Area(): int32;
  end;
  TBox = object implements IShape // ERROR SM0364@28: 'TBox' does not implement 'IShape.Area'
    X: int32;
  end;

begin
end.
