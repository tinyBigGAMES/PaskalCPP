-------------------------------------------------------------------------------
  type_object_copy_err_slice_copy_param.pcpp - Type: object copy, slice copy param

  Break step of type_object_copy: a const parameter of a polymorphic object
  returned by value: it may be a descendant (SM0428).
*******************************************************************************/

module exe type_object_copy_err_slice_copy_param;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
  end;

routine Keep(const AB: TA): TA;
begin
  return AB; // ERROR SM0428@10: 'AB' may hold a descendant of 'TA' (it is polymorphic): a copy keeps only its 'TA' part
end;

begin
end.
