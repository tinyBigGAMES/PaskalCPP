module exe type_array_err_index_float;

/*
  @@test
    kind error
  @@end
*/

var
  LA: array[0..3] of int32;
  LI: int32;

begin
  LI := LA[1.5]; // ERROR SM0261@12: an index is an integer, got 'float64'
end.
