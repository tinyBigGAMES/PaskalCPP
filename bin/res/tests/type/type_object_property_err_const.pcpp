  type_object_property_err_const.pcpp - Type: object property, const

  Break step of type_object_property: a const object has no write (SM0255).
*******************************************************************************/

module exe type_object_property_err_const;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;

routine Put(const AB: TBox);
begin
  AB.N := 1; // ERROR SM0255@3: 'AB.N' cannot be assigned
end;

begin
end.
