module exe type_record_err_parent_alias;

/*
  @@test
    kind error
  @@end
*/

type
  TInt = int32;
  TR = record(TInt) // ERROR SM0308@15: 'TInt' cannot be the parent of a record
    B: int32;
  end;

begin
end.
