module exe type_object_init_err_no_init_takes;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;

var
  GA: TA("five"); // ERROR SM0351@9: no init of 'TA' takes

begin
end.
