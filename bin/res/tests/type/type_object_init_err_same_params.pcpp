-------------------------------------------------------------------------------
  type_object_init_err_same_params.pcpp - Type: object init, same params

  Break step of type_object_init: two inits with the same parameter types:
  inits overload by parameter types (SM0324).
*******************************************************************************/

module exe type_object_init_err_same_params;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    init(const AX: int32);
    begin
    end;
    init(AY: int32); // ERROR SM0324@5: 'init' is already declared with these parameter types
    begin
    end;
  end;

begin
end.
