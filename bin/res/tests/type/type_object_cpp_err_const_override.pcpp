module exe type_object_cpp_err_const_override;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = object
    virtual const method Size(): int32;
    begin
      return 1;
    end;
  end;
  TKid = object(TBase)
    override method Size(): int32; // ERROR SM0389
    begin
      return 2;
    end;
  end;

begin
end.
