-------------------------------------------------------------------------------
  type_object_copy_err_slice_self.pcpp - Type: object copy, slice self

  Break step of type_object_copy: self of a polymorphic object assigned: a
  method runs on a descendant too (SM0429).
*******************************************************************************/

module exe type_object_copy_err_slice_self;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
    method Reset();
    var
      LB: TA;
    begin
      self := LB; // ERROR SM0429@7: 'self' may hold a descendant of 'TA' (it is polymorphic)
    end;
  end;

begin
end.
