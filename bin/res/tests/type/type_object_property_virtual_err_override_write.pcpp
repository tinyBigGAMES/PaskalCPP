-------------------------------------------------------------------------------
  type_object_property_virtual_err_override_write.pcpp - Type: object property virtual, override write

  Break step of type_object_property_virtual: an override writes only where
  its base does (SM0334).
*******************************************************************************/

module exe type_object_property_virtual_err_override_write;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = object
    FA: int32;
    virtual property A: int32 read FA;
  end;
  TKid = object(TBase)
    override property A: int32 read FA; write FA; // ERROR SM0334@41: it overrides has none
  end;

begin
end.
