  type_object_cpp_err_const_call.pcpp - Type: object cpp, const call

  Break step of type_object_cpp: a const method that calls a method that is
  not const through self (SM0388).
*******************************************************************************/

module exe type_object_cpp_err_const_call;

/*
  @@test
    kind error
  @@end
*/

type
  TBox = object
    N: int32;
    method Grow();
    begin
      self.N := self.N + 1;
    end;
    const method Peek(): int32;
    begin
      self.Grow(); // ERROR SM0388
      return self.N;
    end;
  end;

begin
end.
