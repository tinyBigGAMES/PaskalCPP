-------------------------------------------------------------------------------
  type_object_own_err_destroy.pcpp - Type: object own, destroy

  Break step of type_object_own: destroy on an object: the own / ref that
  holds it frees it (SM0361).
*******************************************************************************/

module exe type_object_own_err_destroy;

/*
  @@test
    kind error
  @@end
*/

type
  TPlain = object
    X: int32;
  end;

routine Use(AP: ptr to TPlain);
begin
  destroy(AP); // ERROR SM0361@11: destroy does not free an object
end;

begin
end.
