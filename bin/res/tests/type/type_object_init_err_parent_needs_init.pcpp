-------------------------------------------------------------------------------
  type_object_init_err_parent_needs_init.pcpp - Type: object init, parent needs init

  Break step of type_object_init: an init that does not begin with
  parent.init(...) when the parent's init takes arguments (SM0347).
*******************************************************************************/

module exe type_object_init_err_parent_needs_init;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;
  TB = object(TA)
    init(); // ERROR SM0347@5: 'TA' has no init without arguments: begin every init of 'TB' with parent.init(...)
    begin
    end;
  end;

begin
end.
