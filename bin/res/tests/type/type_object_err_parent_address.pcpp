-------------------------------------------------------------------------------
  type_object_err_parent_address.pcpp - Type: object, parent address

  Break step of type_object: address of parent: parent only reaches the
  parent's members (SM0016).
*******************************************************************************/

module exe type_object_err_parent_address;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    Z: int32;
  end;
  TB = object(TA)
    method Where(): ptr to TA;
    begin
      return address of parent; // ERROR SM0016@25: 'parent' reaches the parent's members
    end;
  end;

begin
end.
