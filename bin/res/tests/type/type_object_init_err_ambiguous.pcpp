module exe type_object_init_err_ambiguous;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    K: int64;
    init(const AX: int64);
    begin
      self.K := AX;
    end;
    init(const AY: int32);
    begin
      self.K := AY;
    end;
  end;

var
  GS: int16 = 1;
  GA: TA(GS); // ERROR SM0352@9: fit more than one init of 'TA'

begin
end.
