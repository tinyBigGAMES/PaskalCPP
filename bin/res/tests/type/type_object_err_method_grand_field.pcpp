-------------------------------------------------------------------------------
  type_object_err_method_grand_field.pcpp - Type: object, method grand field

  Break step of type_object: a method named like a grandparent's field: the
  whole parent chain counts (SM0309).
*******************************************************************************/

module exe type_object_err_method_grand_field;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    X: int32;
  end;
  TB = object(TA)
    Y: int32;
  end;
  TC = object(TB)
    method X(); // ERROR SM0309@5: 'X' reuses a name of the parent chain
    begin
    end;
  end;

begin
end.
