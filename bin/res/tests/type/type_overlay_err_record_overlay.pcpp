-------------------------------------------------------------------------------
  type_overlay_err_record_overlay.pcpp - Type: overlay, record overlay

  Break step of type_overlay: a record's anonymous overlay is an overlay too:
  its fields hold no string (SM0313).
*******************************************************************************/

module exe type_overlay_err_record_overlay;

/*
  @@test
    kind error
  @@end
*/

type
  TR = record
    K: int32;
    overlay
      I: int64;
      S: string; // ERROR SM0313@7: cannot share an overlay's storage
    end;
  end;

begin
end.
