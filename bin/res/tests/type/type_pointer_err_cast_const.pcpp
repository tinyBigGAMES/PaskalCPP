-------------------------------------------------------------------------------
  type_pointer_err_cast_const.pcpp - Type: a pointer cast that drops const

  Break step of type_pointer: a pointer cast keeps const, no cast makes a
  ptr to const a ptr to T (SM0265).
*******************************************************************************/

module exe type_pointer_err_cast_const;

/*
  @@test
    kind error
  @@end
*/

var
  LP: ptr to int32;
  LC: ptr to const int32;

begin
  LC := nil;
  LP := ptr to int32(LC); // ERROR SM0265@22: 'ptr to const int32' cannot be cast to 'ptr to int32': a pointer cast takes a pointer that keeps const, or an integer of pointer width
end.
