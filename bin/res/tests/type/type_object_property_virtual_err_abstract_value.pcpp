  type_object_property_virtual_err_abstract_value.pcpp - Type: object property virtual, abstract value

  Break step of type_object_property_virtual: an object with an abstract
  accessor is no value (SM0338).
*******************************************************************************/

module exe type_object_property_virtual_err_abstract_value;

/*
  @@test
    kind error
  @@end
*/

type
  TAbs = object
    virtual property A: int32 read abstract;
  end;

var
  LA: TAbs; // ERROR SM0338@7: 'TAbs' is abstract

begin
end.
