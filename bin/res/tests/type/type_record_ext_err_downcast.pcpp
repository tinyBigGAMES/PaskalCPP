-------------------------------------------------------------------------------
  type_record_ext_err_downcast.pcpp - Type: record ext, downcast

  Break step of type_record_ext: a ptr to TBase does not become a ptr to TExt
  by itself: a downcast is written ptr to TExt(P) (SM0200).
*******************************************************************************/

module exe type_record_ext_err_downcast;

/*
  @@test
    kind error
  @@end
*/

type
  TBase = record
    A: int32;
  end;
  TExt = record(TBase)
    B: int32;
  end;

var
  LB: TBase;
  LPB: ptr to TBase;
  LPE: ptr to TExt;

begin
  LPB := address of LB;
  LPE := LPB; // ERROR SM0200@10: does not convert implicitly
end.
