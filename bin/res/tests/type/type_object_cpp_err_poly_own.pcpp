module exe type_object_cpp_err_poly_own;

/*
  @@test
    kind error
  @@end
*/

struct CPlain {
  int tag = 5;
};

type
  TA = object(CPlain)
    N: int32;
  end;
  TB = object(TA)
    M: int32;
  end;

var
  LO: own TA;
begin
  LO := own TB; // ERROR SM0200
  println("{}", LO.N);
end.
