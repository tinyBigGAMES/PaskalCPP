module exe type_object_cpp_err_method_address;

/*
  @@test
    kind error
  @@end
*/

type
  TFn = routine(): int32;
  TBox = object
    N: int32;
    method Get(): int32;
    begin
      return self.N;
    end;
  end;

var
  LB: TBox;
  LP: ptr;
begin
  LP := address of LB.Get; // ERROR SM0432
end.
