-------------------------------------------------------------------------------
  type_choices_err_int_to_choices.pcpp - Type: a number into a choices variable

  Break step of type_choices: a number does not convert to a value
  implicitly, write (TColor)1 (SM0200).
*******************************************************************************/

module exe type_choices_err_int_to_choices;

/*
  @@test
    kind error
  @@end
*/

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;

begin
  LC := 1; // ERROR SM0200@9: does not convert implicitly to 'TColor'
end.
