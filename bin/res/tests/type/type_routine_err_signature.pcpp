-------------------------------------------------------------------------------
  type_routine_err_signature.pcpp - Type: a routine of another signature into a routine-typed field

  Break step of type_routine: a routine whose parameter is int64 into a
  field of type routine(AN: int32): int32 (SM0200).
*******************************************************************************/

module exe type_routine_err_signature;

/*
  @@test
    kind error
  @@end
*/

type
  TOps = record
    F: routine(AN: int32): int32;
  end;

routine Double(AN: int32): int32;
begin
  return AN * 2;
end;

routine Wrong(AN: int64): int32;
begin
  return 0;
end;

var
  LOps: TOps;

begin
  LOps.F := Wrong; // ERROR SM0200@13: does not convert implicitly
end.
