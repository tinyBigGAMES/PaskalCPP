-------------------------------------------------------------------------------
  type_pointer_err_deref_value.pcpp - Type: ^ on a value

  Break step of type_pointer: ^ reads through a pointer, an int32 is none
  (SM0250).
*******************************************************************************/

module exe type_pointer_err_deref_value;

/*
  @@test
    kind error
  @@end
*/

var
  LV: int32;
  LX: int32;

begin
  LX := LV^; // ERROR SM0250@9: operator '^' does not take 'int32'
end.
