module exe type_overlay_err_anon_overlay;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    overlay // ERROR PR0034@5: 'overlay' is not allowed in an overlay
      B: int32;
      F: float32;
    end;
  end;

begin
end.
