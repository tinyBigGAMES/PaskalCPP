-------------------------------------------------------------------------------
  type_overlay_err_packed_string.pcpp - Type: overlay, packed string

  Break step of type_overlay: a packed anonymous record in an overlay shares
  the overlay's storage: it holds no string, packed or not (SM0313).
*******************************************************************************/

module exe type_overlay_err_packed_string;

/*
  @@test
    kind error
  @@end
*/

type
  TV = overlay
    A: int32;
    record packed
      S: string; // ERROR SM0313@7: cannot share an overlay's storage
      N: int8;
    end;
  end;

begin
end.
