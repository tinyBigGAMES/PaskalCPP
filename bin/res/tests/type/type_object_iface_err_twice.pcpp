-------------------------------------------------------------------------------
  type_object_iface_err_twice.pcpp - Type: object iface, twice

  Break step of type_object_iface: an interface named twice after implements
  (SM0363).
*******************************************************************************/

module exe type_object_iface_err_twice;

/*
  @@test
    kind error
  @@end
*/

type
  IShape = interface
    method Area(): int32;
  end;
  TBox = object implements IShape, IShape // ERROR SM0363@36: 'IShape' is named twice after implements of 'TBox'
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;

begin
end.
