  type_object_err_bare_method.pcpp - Type: object, bare method

  Break step of type_object: a method called bare in a method: write
  self.Show() (SM0018).
*******************************************************************************/

module exe type_object_err_bare_method;

/*
  @@test
    kind error
  @@end
*/

type
  TA = object
    method Show();
    begin
    end;
    method Twice();
    begin
      Show(); // ERROR SM0018@7: 'Show' is a member of 'TA': write self.Show
    end;
  end;

begin
end.
