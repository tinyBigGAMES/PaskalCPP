-------------------------------------------------------------------------------
  type_array_err_too_large_deref.pcpp - Type: array, too large deref

  Break step of type_array: no type holds more than 1152921504606846975 bytes:
  where an expression reads such a type, it is reported at the expression
  (SM0277).
*******************************************************************************/

module exe type_array_err_too_large_deref;

/*
  @@test
    kind error
  @@end
*/

type
  TBig = array[0..288230376151711743] of int32;
  TP = ptr to TBig;

var
  LP: TP;
  LX: int32;

begin
  LP := nil;
  LX := LP^[0]; // ERROR SM0277@9: 'TBig' is too large: a type holds at most 1152921504606846975 bytes
end.
