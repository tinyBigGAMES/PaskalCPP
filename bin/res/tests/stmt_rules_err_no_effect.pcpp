-------------------------------------------------------------------------------
  stmt_rules_err_no_effect.pcpp - break step of stmt_rules.pcpp:
  an expression statement that has no effect (SM0613)

  How to check, from repo\bin:
    pcpp res\tests\stmt_rules_err_no_effect.pcpp
    pcpp res\tests\stmt_rules_err_no_effect.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_rules_err_no_effect;

var
  LN: int32;

begin
  LN := 1;
  LN + 1; // ERROR SM0613@3: has no effect
end.
