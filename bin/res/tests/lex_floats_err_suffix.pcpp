-------------------------------------------------------------------------------
  lex_floats_err_suffix.pcpp - break step of lex_floats.pcpp:
  a standard C++23 float suffix the bundled clang does not take (LX0005;
  f32, f64, f128, their capitals, bf16 and BF16 are the same rows)

  How to check, from repo\bin:
    pcpp res\tests\lex_floats_err_suffix.pcpp
    pcpp res\tests\lex_floats_err_suffix.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe lex_floats_err_suffix;

var
  LF: float64;

begin
  LF := 0.0;
  LF := 1.5f32; // ERROR LX0005@9: Malformed numeric literal: 1.5f32
end.
