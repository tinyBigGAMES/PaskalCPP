-------------------------------------------------------------------------------
  dbg_dll_host.pcpp - Debugger compliance: the host of dbg_dll

  The host exe for dbg_dll.pcpp (see its steps). It runs in its own folder
  (output\dbg_host\bin), loads ..\..\bin\dbg_dll.dll
  (repo\bin\output\bin, where dbg_dll builds) and calls DllAdd.

  How to build, from repo\bin:
    pcpp res\tests\dbg_dll_host.pcpp

  Keys (REPL word = editor key):
    c = F5 (continue)   n = F10 (over)   s = F11 (into)
    finish = Shift+F11 (out)   q = Shift+F5 (stop)
    b N = click the gutter left of line N
    bt = the CALL STACK   f N = click CALL STACK row N (0 = top)
    locals = the VARIABLES pane   p X = a WATCH row for X (hover is the same)
    the program's output and keyboard = the console the REPL runs in /
    the editor's TERMINAL tab

  Nothing to check here: debug dbg_dll.pcpp.
*******************************************************************************/

module exe dbg_dll_host;
@outputpath "$P:output/dbg_host";

#include <windows.h>
#include <cstdio>

begin
  cppstart source
  HMODULE LLib = LoadLibraryW(L"..\\..\\bin\\dbg_dll.dll");
  using TDllAdd = int32_t (*)(int32_t, int32_t);
  TDllAdd LAdd = LLib ? reinterpret_cast<TDllAdd>(GetProcAddress(LLib, "DllAdd")) : nullptr;
  std::printf("host got %d\n", LAdd ? LAdd(2, 3) : -1);
  std::fflush(stdout);
  cppend;
end.
