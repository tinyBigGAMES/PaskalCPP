-------------------------------------------------------------------------------
  type_object_property_virtual_err_override_final.pcpp - break step of type_object_property_virtual.pcpp:
  a final property is not overridden (SM0335)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_override_final.pcpp
    pcpp res\tests\type_object_property_virtual_err_override_final.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_override_final;

type
  TBase = object
    FA: int32;
    virtual final property A: int32 read FA;
  end;
  TKid = object(TBase)
    override property A: int32 read FA; // ERROR SM0335@5: 'TBase.A' is final
  end;

begin
end.
