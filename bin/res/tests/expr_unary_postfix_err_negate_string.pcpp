-------------------------------------------------------------------------------
  expr_unary_postfix_err_negate_string.pcpp - break step of expr_unary_postfix.pcpp:
  unary minus on a string (SM0250)

  How to check, from repo\bin:
    pcpp res\tests\expr_unary_postfix_err_negate_string.pcpp
    pcpp res\tests\expr_unary_postfix_err_negate_string.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_unary_postfix_err_negate_string;

var
  LS: string;

begin
  LS := "a";
  LS := -LS; // ERROR SM0250@9: does not take 'string'
end.
