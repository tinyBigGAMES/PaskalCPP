  type_pointer_err_integer.pcpp - break step of type_pointer.pcpp:
  0 is no pointer: the null pointer is nil (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_integer.pcpp
    pcpp res\tests\type_pointer_err_integer.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_integer;

var
  LP: ptr to int32;

begin
  LP := 0; // ERROR SM0200@9: 'int32' does not convert implicitly to 'ptr to int32'
end.
