-------------------------------------------------------------------------------
  type_overlay_err_string.pcpp - break step of type_overlay.pcpp:
  an overlay is plain data: a field holds no string (it owns its text; SM0313)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_string.pcpp
    pcpp res\tests\type_overlay_err_string.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_string;

type
  TV = overlay
    A: int32;
    S: string; // ERROR SM0313@5: cannot share an overlay's storage
  end;

begin
end.
