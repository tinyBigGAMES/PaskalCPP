-------------------------------------------------------------------------------
  type_pointer_err_cast_const.pcpp - break step of type_pointer.pcpp:
  a pointer cast keeps const: no cast makes a ptr to const a ptr to T (SM0265)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_cast_const.pcpp
    pcpp res\tests\type_pointer_err_cast_const.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_cast_const;

var
  LP: ptr to int32;
  LC: ptr to const int32;

begin
  LC := nil;
  LP := ptr to int32(LC); // ERROR SM0265@22: 'ptr to const int32' cannot be cast to 'ptr to int32': a pointer cast takes a pointer that keeps const, or an integer of pointer width
end.
