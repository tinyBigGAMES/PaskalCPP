-------------------------------------------------------------------------------
  type_routine_err_count_variadic.pcpp - break step of type_routine.pcpp:
  a routine value whose type ends in ... called without its fixed argument (SM0401, F51)

  How to check, from repo\bin:
    pcpp res\tests\type_routine_err_count_variadic.pcpp
    pcpp res\tests\type_routine_err_count_variadic.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_routine_err_count_variadic;

var
  LV: routine(AN: int32; ...): int32;
  LN: int32;

begin
  LV := nil;
  LN := LV(); // ERROR SM0401@9: takes at least 1 argument(s), 0 given
end.
