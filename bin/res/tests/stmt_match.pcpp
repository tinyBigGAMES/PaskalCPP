-------------------------------------------------------------------------------
  stmt_match.pcpp - Statement compliance: match

  match S of label[, label]: ...; [else ...] end; (BNF.md sec 5): S is an
  integer, char, wchar or a choice; a label is a constant or a range a..b,
  an arm holds a list of labels; else takes every other value. A match on a
  choice that names every value needs no else. leave ends the match.

  How to check, from repo\bin:
    pcpp res\tests\stmt_match.pcpp -r
    pcpp res\tests\stmt_match.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    1 one
    3 two or three
    5 four to six
    9 other
    q letter
    7 digit
    k wide letter
    green
    left before after
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    stmt_match_err_subject.pcpp
      a string subject (SM0603)
    stmt_match_err_label_range.pcpp
      a label outside the subject's type: it never matches (SM0604)
    stmt_match_err_label_repeat.pcpp
      a label two arms hold (SM0605)
    stmt_match_err_not_covered.pcpp
      a choice match with a value no arm names and no else (SM0606, warning)
    stmt_match_err_label_constant.pcpp
      a variable as a label: a label is a constant (SM0202)
    stmt_match_err_label_reversed.pcpp
      a range label whose low bound exceeds its high bound (SM0267)
*******************************************************************************/

module exe stmt_match;

type
  TColor = choices(cRed, cGreen, cBlue);

routine Name(AN: int32): string;
var
  LR: string;
begin
  match AN of
    1: LR := "one";
    2, 3: LR := "two or three";
    4..6: LR := "four to six";
  else
    LR := "other";
  end;
  return LR;
end;

routine Kind(AC: char): string;
var
  LR: string;
begin
  match AC of
    'a'..'z': LR := "letter";
    '0'..'9': LR := "digit";
  else
    LR := "other";
  end;
  return LR;
end;

routine WideKind(AW: wchar): string;
var
  LR: string;
begin
  match AW of
    L'a'..L'z': LR := "wide letter";
  else
    LR := "wide other";
  end;
  return LR;
end;

var
  LK: TColor;
  LN: int32;

begin
  println("1 {}", Name(1));
  println("3 {}", Name(3));
  println("5 {}", Name(5));
  println("9 {}", Name(9));
  println("q {}", Kind('q'));
  println("7 {}", Kind('7'));
  println("k {}", WideKind(L'k'));
  LK := TColor.cGreen;
  match LK of
    TColor.cRed: println("red");
    TColor.cGreen: println("green");
    TColor.cBlue: println("blue");
  end;
  LN := 1;
  print("left before");
  match LN of
    1:
      leave;
      println(" never");
  end;
  println(" after");
end.
