-------------------------------------------------------------------------------
  expr_record_literal_err_twice.pcpp - break step of expr_record_literal.pcpp:
  a field given twice (SM0415)

  How to check, from repo\bin:
    pcpp res\tests\expr_record_literal_err_twice.pcpp
    pcpp res\tests\expr_record_literal_err_twice.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_record_literal_err_twice;

type
  TP = record
    X: int32;
  end;

var
  LP: TP;

begin
  LP := TP(X: 1, X: 2); // ERROR SM0415@18: field 'X' is given twice
end.
