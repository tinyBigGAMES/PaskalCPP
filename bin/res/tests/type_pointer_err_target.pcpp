-------------------------------------------------------------------------------
  type_pointer_err_target.pcpp - break step of type_pointer.pcpp:
  a ptr to int32 is no ptr to int64: cast it (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_pointer_err_target.pcpp
    pcpp res\tests\type_pointer_err_target.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_pointer_err_target;

var
  LP: ptr to int32;
  LW: ptr to int64;

begin
  LP := nil;
  LW := LP; // ERROR SM0200@9: 'ptr to int32' does not convert implicitly to 'ptr to int64'; write ptr to int64(LP)
end.
