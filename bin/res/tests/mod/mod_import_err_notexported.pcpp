module exe mod_import_err_notexported;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_a;

begin
  println("{}", mod_import_a.Add(2, 3)); // ERROR SM0006@17
end.
