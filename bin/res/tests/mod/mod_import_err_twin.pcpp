  mod_import_err_twin.pcpp - Module: two files that are the same module

  Break step of mod_import: mod_twin_u is found in fixtures\ (this file's
  import) and, as another file, in fixtures\twin\ (mod_twin_v's own folder,
  searched first for its imports). One name is one module in a build.
*******************************************************************************/

module exe mod_import_err_twin;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
@addmodulepath "$P:res/tests/mod/fixtures/twin";
import mod_twin_u, mod_twin_v;

begin
end.
