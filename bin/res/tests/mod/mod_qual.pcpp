-------------------------------------------------------------------------------
  mod_qual.pcpp - Module: qualified names

  <module>.<name> reaches what a unit exports: a var, a routine, a type
  (a variable's type), a choices value (<module>.<type>.<value>).
*******************************************************************************/

module exe mod_qual;

/*
  @@test
    kind run
    expect
    | G = 1
    | F(5) = 5
    | X = 7
    | GCol is Green
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_qual_unit;

var
  GPt: mod_qual_unit.TPt;
  GCol: mod_qual_unit.TCol = mod_qual_unit.TCol.Green;

begin
  GPt.X := 7;
  println("G = {}", mod_qual_unit.G);
  println("F(5) = {}", mod_qual_unit.F(5));
  println("X = {}", GPt.X);
  if GCol = mod_qual_unit.TCol.Green then
    println("GCol is Green");
  end;
end.
