  mod_dotted_err_parts.pcpp - Module: a nested type after a dotted unit

  Break step of mod_dotted_prefix: mod_dotted.Lib is the unit (the longest
  imported prefix) and two parts follow it; there are no nested types, so
  one part must name the unit's type (as mod_qual_err_parts).
*******************************************************************************/

module exe mod_dotted_err_parts;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_dotted.Lib;

var
  GX: mod_dotted.Lib.TOuter.TInner; // ERROR SM0008@7

begin
end.
