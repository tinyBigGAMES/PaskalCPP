-------------------------------------------------------------------------------
  mod_import_private.pcpp - Module: exported declarations that name private constants

  The unit's KTwice and TRow are exported; KSize, which they name, is not.
  The importer uses them: what an exported declaration names is built in,
  though the importer cannot name it itself.
*******************************************************************************/

module exe mod_import_private;

/*
  @@test
    kind run
    expect
    | KTwice = 6
    | len(TRow) = 3
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_private_unit;

var
  GRow: mod_import_private_unit.TRow;

begin
  println("KTwice = {}", mod_import_private_unit.KTwice);
  println("len(TRow) = {}", len(GRow));
end.
