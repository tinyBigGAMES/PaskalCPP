  mod_import_err_own_module.pcpp - Module: the module's own name as a qualifier

  Break step of mod_import: a qualifier names an imported unit; the
  module's own declarations are reached without it.
*******************************************************************************/

module exe mod_import_err_own_module;

/*
  @@test
    kind error
  @@end
*/

const
  KCount: int32 = 3;

begin
  println("{}", mod_import_err_own_module.KCount); // ERROR SM0007@17: is this module's own name
end.
