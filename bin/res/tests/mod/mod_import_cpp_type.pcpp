-------------------------------------------------------------------------------
  mod_import_cpp_type.pcpp - Module: a C type spelled as its unit

  A unit's name is a unit only before '.'; in a type position the name is
  the C/C++ type its header declares (as stb_vorbis declares stb_vorbis),
  as a value and as a pointer target. Unit:
  fixtures\mod_import_cpp_type_u.
*******************************************************************************/

module exe mod_import_cpp_type;

/*
  @@test
    kind run
    expect
    | value 5
    | through a pointer 7
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import
  mod_import_cpp_type_u;

var
  LValue: mod_import_cpp_type_u;
  LPtr: ptr to mod_import_cpp_type_u;

begin
  LValue.count := 5;
  println("value {}", LValue.count);
  LPtr := address of LValue;
  LPtr^.count := 7;
  println("through a pointer {}", LValue.count);
end.
