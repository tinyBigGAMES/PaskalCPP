module exe mod_import_err_noname;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_a;

begin
  println("{}", mod_import_a.Product(2, 3)); // ERROR SM0005@17
end.
