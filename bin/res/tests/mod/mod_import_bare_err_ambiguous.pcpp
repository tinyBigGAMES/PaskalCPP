  mod_import_bare_err_ambiguous.pcpp - Module: a bare name two imports export

  Break step of mod_import_bare: KShared named bare while mod_import_bare_a
  and mod_import_bare_b both export it. No import order decides: the name
  is written qualified (SM0020).
*******************************************************************************/

module exe mod_import_bare_err_ambiguous;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_bare_a, mod_import_bare_b;

begin
  println("{}", KShared); // ERROR SM0020@17
end.
