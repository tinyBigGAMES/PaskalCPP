-------------------------------------------------------------------------------
  mod_dotted_err_value.pcpp - Module: a dotted unit used as a value

  Break step of mod_dotted_prefix: mod_dotted.Lib names the unit (the whole
  chain is an import's name), and a unit is no value, as an undotted unit
  is not; it is reported, never left to C++.
*******************************************************************************/

module exe mod_dotted_err_value;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_dotted.Lib;

begin
  println("{}", mod_dotted.Lib); // ERROR SM0269@17
end.
