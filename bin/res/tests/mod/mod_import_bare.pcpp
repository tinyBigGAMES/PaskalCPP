-------------------------------------------------------------------------------
  mod_import_bare.pcpp - Module: imported names used bare

  A name the module does not declare is found in its imports when exactly
  one imported unit exports it (BNF.md sec 1): a type (TSize), a const
  (KDepth), a var (GCalls, also as a for iterator), a routine (Area) and
  one unit's overload set (Describe). The module's own names win (KScale),
  and so does an inner local (GCalls in Local); a name two units export is
  written qualified (KShared); the qualified form always works. Units:
  fixtures\mod_import_bare_a and mod_import_bare_b.
*******************************************************************************/

module exe mod_import_bare;

/*
  @@test
    kind run
    expect
    | Area(GSize) = 10
    | Describe(1) = int, Describe(true) = bool
    | KDepth = 4
    | KScale = 10 (own), mod_import_bare_a.KScale = 3
    | Local() = 7, GCalls = 1
    | for GCalls: 3
    | KShared: 1 and 2
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_bare_a, mod_import_bare_b;

// The module's own const: it wins over mod_import_bare_a.KScale
const
  KScale: int32 = 10;

var
  GSize: TSize;

routine Local(): int32;
var
  // An inner local wins over mod_import_bare_a.GCalls
  GCalls: int32 = 7;
begin
  return GCalls;
end;

begin
  GSize.W := 2;
  GSize.H := 5;
  println("Area(GSize) = {}", Area(GSize));
  println("Describe(1) = {}, Describe(true) = {}", Describe(1), Describe(true));
  println("KDepth = {}", KDepth);
  println("KScale = {} (own), mod_import_bare_a.KScale = {}", KScale, mod_import_bare_a.KScale);
  println("Local() = {}, GCalls = {}", Local(), GCalls);
  for GCalls := 1 to 3 do
  end;
  println("for GCalls: {}", GCalls);
  println("KShared: {} and {}", mod_import_bare_a.KShared, mod_import_bare_b.KShared);
end.
