  mod_import_err_transitive.pcpp - Module: imports are not transitive

  Break step of mod_import: this file imports mod_import_b only;
  mod_import_b imports mod_import_a, but that does not make mod_import_a
  this file's import.
*******************************************************************************/

module exe mod_import_err_transitive;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_b;

var
  GPair: mod_import_a.TPair; // ERROR SM0007@10

begin
end.
