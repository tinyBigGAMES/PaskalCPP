module exe mod_dotted_err_unknown_type;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_dotted.Lib, mod_dotted.Lib.Core;

var
  GX: mod_dotted.Lib.Core.TNope; // ERROR SM0005@7

begin
end.
