-------------------------------------------------------------------------------
  mod_import.pcpp - Module: the import clause

  import <unit>, <unit>; (BNF.md sec 1): one clause, after the directive
  prologue, naming PaskalCPP units only. A unit is found as <name>.pcpp in
  the importing file's folder, then in the module paths (here
  @addmodulepath names fixtures\, where mod_import_a and mod_import_b
  live; the folder order is dir_addmodulepath's). Exported names are
  reached qualified (mod_import_a.Sum, mod_import_a.TPair); a unit imported
  twice (mod_import_a, also imported by mod_import_b) is one unit; clause
  order is free.
*******************************************************************************/

module exe mod_import;

/*
  @@test
    kind run
    expect
    | mod_import_a.Sum(GPair) = 5
    | mod_import_b.Triple(4) = 12
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_b, mod_import_a;

var
  GPair: mod_import_a.TPair;

begin
  GPair.First := 2;
  GPair.Second := 3;
  println("mod_import_a.Sum(GPair) = {}", mod_import_a.Sum(GPair));
  println("mod_import_b.Triple(4) = {}", mod_import_b.Triple(4));
end.
