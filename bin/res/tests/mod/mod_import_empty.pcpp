  mod_import_empty.pcpp - Module: importing an empty unit

  A unit may declare nothing; importing it builds (its emitted header and
  source are empty modules).
*******************************************************************************/

module exe mod_import_empty;

/*
  @@test
    kind run
    expect
    | imports an empty unit
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_import_empty_unit;

begin
  println("imports an empty unit");
end.
