module unit mod_qual_unit;

exported type
  TPt = record
    X: int32;
  end;

exported var
  G: int32 = 1;

var
  H: int32 = 2;

exported routine F(const AX: int32): int32;
begin
  return AX;
end;

exported type
  TCol = choices(Red, Green);

end.
