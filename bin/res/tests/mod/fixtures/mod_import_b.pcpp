-------------------------------------------------------------------------------
  mod_import_b.pcpp - Module fixture: a unit mod_import imports

  It imports mod_import_a itself, so mod_import reaches mod_import_a twice
  (one unit), and mod_import_err_transitive tries to use mod_import_a
  through it.
*******************************************************************************/

module unit mod_import_b;
import mod_import_a;

exported routine Triple(const AX: int32): int32;
var
  LPair: mod_import_a.TPair;
begin
  LPair.First := AX;
  LPair.Second := AX * 2;
  return mod_import_a.Sum(LPair);
end;

end.
