module unit mod_import_bare_a;

exported type
  TSize = record
    W: int32;
    H: int32;
  end;

exported const
  KScale: int32 = 3;
  KDepth: int32 = 4;
  KShared: int32 = 1;

exported var
  GCalls: int32 = 0;

exported routine Area(const ASize: TSize): int32;
begin
  GCalls += 1;
  return ASize.W * ASize.H;
end;

exported routine Describe(const AN: int32): string;
begin
  return "int";
end;

exported routine Describe(const AB: bool): string;
begin
  return "bool";
end;

end.
