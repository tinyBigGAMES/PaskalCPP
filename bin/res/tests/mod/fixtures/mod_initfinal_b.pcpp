  mod_initfinal_b.pcpp - Module fixture: a unit mod_initfinal and mod_initfinal_a import

  Its initialize leaves early with return; (the line after it must never
  print).
*******************************************************************************/

module unit mod_initfinal_b;

initialize
var
  LDone: bool;
begin
  println("1. mod_initfinal_b initialize");
  LDone := true;
  if LDone then
    return;
  end;
  println("mod_initfinal_b initialize did not return early");
end;

finalize
begin
  println("7. mod_initfinal_b finalize");
end;

end.
