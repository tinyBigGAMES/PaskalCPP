-------------------------------------------------------------------------------
  mod_import_a.pcpp - Module fixture: a unit mod_import and mod_import_b import

  An exported type and routine, and one routine it does not export (Add,
  which mod_import_err_notexported tries to reach).
*******************************************************************************/

module unit mod_import_a;

exported type
  TPair = record
    First: int32;
    Second: int32;
  end;

routine Add(const AX: int32; const AY: int32): int32;
begin
  return AX + AY;
end;

exported routine Sum(const APair: TPair): int32;
begin
  return Add(APair.First, APair.Second);
end;

end.
