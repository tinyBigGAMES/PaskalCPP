-------------------------------------------------------------------------------
  mod_import_named_index.pcpp - Module: a unit named index

  A module name the C library also uses (a header index.h, a function) builds
  and is reached qualified: the emitted names cannot collide.
*******************************************************************************/

module exe mod_import_named_index;

/*
  @@test
    kind run
    expect
    | index.Twice(4) = 8
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import index;

begin
  println("index.Twice(4) = {}", index.Twice(4));
end.
