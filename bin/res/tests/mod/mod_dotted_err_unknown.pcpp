-------------------------------------------------------------------------------
  mod_dotted_err_unknown.pcpp - Module: a name a dotted unit does not declare

  Break step of mod_dotted_prefix: mod_dotted.Lib is the unit (the longest
  imported prefix) and it declares no Thrice; the message names the unit
  by its whole dotted name.
*******************************************************************************/

module exe mod_dotted_err_unknown;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$P:res/tests/mod/fixtures";
import mod_dotted.Lib;

begin
  println("{}", mod_dotted.Lib.Thrice(2)); // ERROR SM0005@17
end.
