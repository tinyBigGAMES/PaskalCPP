-------------------------------------------------------------------------------
  type_object_property_err_bare.pcpp - break step of type_object_property.pcpp:
  a property named bare in a method: write self.N (SM0018)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_err_bare.pcpp
    pcpp res\tests\type_object_property_err_bare.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_err_bare;

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write FN;
    method Put();
    begin
      N := 1; // ERROR SM0018@7: write self.N
    end;
  end;

begin
end.
