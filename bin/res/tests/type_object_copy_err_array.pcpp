-------------------------------------------------------------------------------
  type_object_copy_err_array.pcpp - break step of type_object_copy.pcpp:
  an array of such objects assigned: each element would be copied (SM0427)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_array.pcpp
    pcpp res\tests\type_object_copy_err_array.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_array;

type
  TRes = object
    Id: int32;
    done;
    begin
    end;
  end;

routine Use();
var
  LA: array[0..1] of TRes;
  LB: array[0..1] of TRes;
begin
  LA := LB; // ERROR SM0427@9: 'LB' would be copied here, and 'array[0..1] of TRes' cannot be copied: pass it var / const, return it from a local
end;

begin
end.
