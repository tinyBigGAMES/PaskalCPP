  dir_predefined_unit.pcpp - the unit dir_predefined.pcpp imports: its own
  BUILD_ symbol is BUILD_UNIT (the predefined symbols are per file).

  Nothing to check here: dir_predefined.pcpp checks it.
*******************************************************************************/

module unit dir_predefined_unit;

exported routine ShowKind();
begin
@ifdef BUILD_UNIT
  println("in the unit, BUILD_UNIT: defined");
@else
  println("in the unit, BUILD_UNIT: not defined");
@endif
@ifdef BUILD_EXE
  println("in the unit, BUILD_EXE: defined");
@else
  println("in the unit, BUILD_EXE: not defined");
@endif
end;

end.
