  decl_variadic_err_clink_count.pcpp - break step of decl_variadic.pcpp:
  varargs.count in a clink variadic (a C caller passes no count)

  How to check, from repo\bin:
    pcpp res\tests\decl_variadic_err_clink_count.pcpp
    pcpp res\tests\decl_variadic_err_clink_count.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_variadic_err_clink_count;

routine clink CCount(AN: int32; ...): int32;
begin
  return varargs.count; // ERROR SM0418@10
end;

begin
  println("{}", CCount(1, 2));
end.
