-------------------------------------------------------------------------------
  type_record_err_align_cpp_packed.pcpp - break step of type_record.pcpp:
  record packed align(cpp("6")): a packed record checks its C++ align value too (SM0310)

  How to check, from repo\bin:
  (the compiler judges it in the emitted C++: the build runs, the program is
  never started)
    pcpp res\tests\type_record_err_align_cpp_packed.pcpp
    pcpp res\tests\type_record_err_align_cpp_packed.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_align_cpp_packed;

type
  TR = record packed align(cpp("6")) // ERROR SM0310@28: align 6 is not a power of two
    G: int32;
  end;

var
  V: TR;

begin
  V.G := 1;
end.
