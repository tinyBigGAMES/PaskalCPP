-------------------------------------------------------------------------------
  type_alias_err_unknown.pcpp - break step of type_alias.pcpp:
  TA = TNope: a name PaskalCPP does not know is a C/C++ type, so clang reports it (ZB0016)

  How to check, from repo\bin:
  (clang reports it: the build runs, the program is never started)
    pcpp res\tests\type_alias_err_unknown.pcpp
    pcpp res\tests\type_alias_err_unknown.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_alias_err_unknown;

type
  TA = TNope; // ERROR ZB0016@8: unknown type name 'TNope'

begin
end.
