-------------------------------------------------------------------------------
  expr_varargs_err_local_shape.pcpp - break step of expr_varargs.pcpp:
  a varargs local's next given a value, not a type (SM0409)

  How to check, from repo\bin:
    pcpp res\tests\expr_varargs_err_local_shape.pcpp
    pcpp res\tests\expr_varargs_err_local_shape.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_varargs_err_local_shape;

routine V(...);
var
  LCopy: varargs;
begin
  LCopy := varargs.copy();
  println("{}", LCopy.next(1)); // ERROR SM0409@17: takes (a type)
end;

begin
  V(1);
end.
