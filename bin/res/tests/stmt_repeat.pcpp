-------------------------------------------------------------------------------
  stmt_repeat.pcpp - Statement compliance: repeat

  repeat ... until C; (BNF.md sec 5): the body runs first and the loop
  ends when the bool C is true, so the body runs at least once.

  How to check, from repo\bin:
    pcpp res\tests\stmt_repeat.pcpp -r
    pcpp res\tests\stmt_repeat.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    count 4
    once 1
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    stmt_repeat_err_condition.pcpp
      an int32 until condition: a condition is bool (SM0263)
*******************************************************************************/

module exe stmt_repeat;

var
  LI: int32;

begin
  LI := 0;
  repeat
    LI += 1;
  until LI = 4;
  println("count {}", LI);
  LI := 0;
  repeat
    LI += 1;
  until true;
  println("once {}", LI);
end.
