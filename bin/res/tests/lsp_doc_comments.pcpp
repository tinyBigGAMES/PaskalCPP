-------------------------------------------------------------------------------
  lsp_doc_comments.pcpp - LSP compliance: /// doc comments in hover

  `///` lines directly above a declaration are its documentation: Markdown,
  plus tags at a line's start:
    @param Name text   @returns text   @raises text   @see Name
    @deprecated text   @since text     @example (code lines follow)
  Hover shows them under the declaration's code box. `//` and `////` are
  plain comments, never documentation; a blank line ends a doc block.

  How to check: hover each name a CHECK line names (in the body at the end)
  and compare with the text after "->".
*******************************************************************************/

module exe lsp_doc_comments;

import lsp_unit;

/// Clamps a value to a range.
///
/// Values below `AMin` give `AMin`; values above `AMax` give **AMax**.
/// @param AValue the value to clamp
/// @param AMin   lower bound (inclusive)
/// @param AMax   upper bound (inclusive); must not be
///   below `AMin`
/// @returns the clamped value
/// @raises nothing
/// @since 0.1
/// @see Wrap
/// @deprecated use Wrap where a cycle is wanted
/// @example
///   LX := Clamp(15, 0, 10);  // 10
///   LY := Clamp(-3, 0, 10);  // 0
routine Clamp(const AValue: int32; const AMin: int32; const AMax: int32): int32;
begin
  if AValue < AMin then
    return AMin;
  end;
  if AValue > AMax then
    return AMax;
  end;
  return AValue;
end;

/// Wraps a value into `0 .. ASize - 1`.
routine Wrap(const AValue: int32; const ASize: int32): int32;
begin
  return AValue mod ASize;
end;

type
  /// A colour channel set.
  TRgb = record
    /// Red, 0 .. 255.
    R: uint8;
    G: uint8;
    B: uint8;
  end;

  /// Traffic light states.
  TLight = choices(
    /// Stop.
    lRed,
    lAmber,
    /// Go.
    lGreen);

var
  /// The current colour.
  GColour: TRgb;
  // A plain comment: not documentation.
  GPlain: int32;
  //// Four slashes: not documentation either.
  GFour: int32;
  /// Detached by the blank line below: documents nothing.

  GDetached: int32;
  GLight: TLight;

begin
  // CHECK: Clamp -> its code box, then in this order: "Deprecated: use Wrap
  //        where a cycle is wanted", the two summary paragraphs (AMin in
  //        code style, AMax bold), Parameters (AValue, AMin, AMax: its text
  //        joined into one line), Returns, Raises, Since 0.1, See also Wrap,
  //        Example as a PaskalCPP code block (two lines, indent removed)
  GPlain := Clamp(15, 0, 10);

  // CHECK: Wrap -> "Wraps a value into 0 .. ASize - 1." (the range in code)
  GFour := Wrap(GPlain, 4);

  // CHECK: GColour -> "The current colour."   R -> "Red, 0 .. 255."
  // CHECK: G -> no documentation (the line above it is a field, not ///)
  GColour.R := 1;
  GColour.G := 2;

  // CHECK: TLight -> "Traffic light states."   lRed -> "Stop."
  //        lAmber -> no documentation           lGreen -> "Go."
  GLight := TLight.lRed;
  GLight := TLight.lAmber;
  GLight := TLight.lGreen;

  // CHECK: GPlain, GFour, GDetached -> no documentation
  GDetached := GPlain + GFour;

  // CHECK: Twice -> its doc from lsp_unit.pcpp, Parameters (AX) and Returns
  GDetached := lsp_unit.Twice(GDetached);
end.
