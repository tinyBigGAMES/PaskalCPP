  lib_resdata_lib.pcpp - Build kind: a lib that adds a data entry (dep)

  @addresdata in a lib: the entry is built into the lib and reaches the
  program that links it (lib_resdata).
*******************************************************************************/

module lib lib_resdata_lib;

/*
  @@test
    kind dep
  @@end
*/

@addresdata "lib_resdata/hello" "$P:res/tests/dir/fixtures/dir_addresdata_hello.txt";

exported routine clink lib_resdata_value(): int32;
begin
  return 1;
end;

end.
