-------------------------------------------------------------------------------
  lib_runtime_lib.pcpp - Build kind: a lib that uses the runtime (dep)

  This lib's code calls into the PaskalCPP runtime (div: checked, raises on
  a zero divisor), so its build also builds pcpp_runtime: a second static
  library of the same zig build, installed beside the lib in output\lib
  (pcpp_runtime.lib on Windows, libpcpp_runtime.a on Linux), for a consumer
  built by another toolchain. A PaskalCPP program that links the lib brings
  its own runtime and never links pcpp_runtime. lib_runtime checks what this
  build leaves.
*******************************************************************************/

module lib lib_runtime_lib;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink lib_runtime_lib_div(AA: int32; AB: int32): int32;
begin
  return AA div AB;
end;

end.
