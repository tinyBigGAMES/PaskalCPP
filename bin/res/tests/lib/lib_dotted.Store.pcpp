  lib_dotted.Store.pcpp - Build kind: a static lib with a dotted name (dep)

  The whole dotted name is the library's: lib_dotted.Store.lib on Windows,
  liblib_dotted.Store.a on Linux. lib_dotted links it by that name.
*******************************************************************************/

module lib lib_dotted.Store;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink lib_dotted_add(AA: int32; AB: int32): int32;
begin
  return AA + AB;
end;

end.
