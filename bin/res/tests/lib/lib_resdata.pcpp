-------------------------------------------------------------------------------
  lib_resdata.pcpp - Build kind: a program that links a lib with a data entry

  The program adds its own entry beside the lib's: both build into one
  program (two keys, no conflict).
*******************************************************************************/

module exe lib_resdata;

/*
  @@test
    kind run
    deps lib_resdata_lib
    expect
    | linked
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addlibrarypath "$P:output/lib";
@linklibrary "lib_resdata_lib";
@addresdata "lib_resdata/own" "$P:res/tests/dir/fixtures/dir_addresdata_hello.txt";

routine clink lib_resdata_value(): int32; external;

begin
  if lib_resdata_value() = 1 then
    println("linked");
  end;
end.
