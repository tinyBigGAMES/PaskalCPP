module lib lib_hooks_lib;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink lib_hooks_value(): int32;
begin
  return 9;
end;

initialize
begin
  println("lib initialize");
end;

finalize
begin
  println("lib finalize");
end;

end.
