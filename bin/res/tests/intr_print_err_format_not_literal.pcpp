-------------------------------------------------------------------------------
  intr_print_err_format_not_literal.pcpp - break step of intr_print.pcpp:
  a string variable as the format string (SM0500)

  How to check, from repo\bin:
    pcpp res\tests\intr_print_err_format_not_literal.pcpp
    pcpp res\tests\intr_print_err_format_not_literal.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_print_err_format_not_literal;

var
  LFormat: string;
  LN: int32;

begin
  LFormat := "{}";
  LN := 1;
  println(LFormat, LN); // ERROR SM0500@11
end.
