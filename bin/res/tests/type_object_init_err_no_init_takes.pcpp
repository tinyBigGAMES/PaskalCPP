-------------------------------------------------------------------------------
  type_object_init_err_no_init_takes.pcpp - break step of type_object_init.pcpp:
  arguments no init of the type takes (SM0351)

  How to check, from repo\bin:
    pcpp res\tests\type_object_init_err_no_init_takes.pcpp
    pcpp res\tests\type_object_init_err_no_init_takes.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_init_err_no_init_takes;

type
  TA = object
    N: int32;
    init(const AN: int32);
    begin
      self.N := AN;
    end;
  end;

var
  GA: TA("five"); // ERROR SM0351@9: no init of 'TA' takes

begin
end.
