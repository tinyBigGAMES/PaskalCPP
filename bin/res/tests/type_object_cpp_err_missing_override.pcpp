-------------------------------------------------------------------------------
  type_object_cpp_err_missing_override.pcpp - break step of type_object_cpp.pcpp:
  a method matching a C++ virtual without override (SM0332)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_missing_override.pcpp
    pcpp res\tests\type_object_cpp_err_missing_override.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_missing_override;

struct CShape {
  virtual ~CShape() = default;
  virtual int area() { return 0; }
};

type
  TSquare = object(CShape)
    S: int32;
    method area(): int32; // ERROR SM0332
    begin
      return self.S;
    end;
  end;

var
  LS: TSquare;
begin
  println("{}", LS.area());
end.
