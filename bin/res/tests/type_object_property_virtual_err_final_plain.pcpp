  type_object_property_virtual_err_final_plain.pcpp - break step of type_object_property_virtual.pcpp:
  final closes a virtual property (SM0336)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_final_plain.pcpp
    pcpp res\tests\type_object_property_virtual_err_final_plain.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_final_plain;

type
  TBox = object
    FA: int32;
    final property A: int32 read FA; // ERROR SM0336@5: 'final' closes a virtual property
  end;

begin
end.
