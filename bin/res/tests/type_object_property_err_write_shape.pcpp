-------------------------------------------------------------------------------
  type_object_property_err_write_shape.pcpp - break step of type_object_property.pcpp:
  write(AValue) needs a body (PR0061)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_err_write_shape.pcpp
    pcpp res\tests\type_object_property_err_write_shape.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_err_write_shape;

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write(AValue); // ERROR PR0061@45: the write of 'N' takes a field name or a value name and a body
  end;

begin
end.
