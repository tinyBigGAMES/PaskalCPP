-------------------------------------------------------------------------------
  type_record_err_anon_record.pcpp - break step of type_record.pcpp:
  an anonymous record goes inside an overlay, not straight in a record (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_record_err_anon_record.pcpp
    pcpp res\tests\type_record_err_anon_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_record_err_anon_record;

type
  TR = record
    record // ERROR PR0034@5: 'record' is not allowed in a record
      B: int32;
    end;
  end;

begin
end.
