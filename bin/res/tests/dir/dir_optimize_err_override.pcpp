-------------------------------------------------------------------------------
  dir_optimize_err_override.pcpp - pcpp: an -opt level that does not exist

  A cli test: pcpp runs itself with the args (in the suite's output root,
  -o "$P:output" so the build lands there), on the fixture named; its
  output and exit code are the check. Break step of dir_optimize_override: CMP0001, nothing built.
*******************************************************************************/

module exe dir_optimize_err_override;

/*
  @@test
    kind cli
    args "--no-banner <DIR>/fixtures/dir_cli_fast.pcpp -opt quick -o $P:output"
    exitcode 1
    expect
    | Compiling <DIR>/fixtures/dir_cli_fast.pcpp
    | [ERROR] CMP0001: bad value 'quick' for option optimize (expected debug, safe, fast, small)
    | Failed.
  @@end
*/

begin
end.
