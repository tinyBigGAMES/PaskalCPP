module exe dir_addresdata_err_two;

/*
  @@test
    kind error
  @@end
*/

@addresdata "" "$P:res/tests/dir/fixtures/dir_addresdata_missing.txt"; // ERROR SM0119@13 // ERROR SM0105@16

begin
end.
