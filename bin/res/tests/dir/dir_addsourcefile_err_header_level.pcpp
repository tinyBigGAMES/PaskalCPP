  dir_addsourcefile_err_header_level.pcpp - pcpp: one header line, a warning in C and an error in C++

  A cli test: pcpp runs itself with the args (in the suite's output root,
  -o "$P:output" so the build lands there), on the fixture named; its
  output and exit code are the check. Break step of dir_addsourcefile_header: the C unit warns, the C++
  unit fails, on the same line: two facts, two reports.
*******************************************************************************/

module exe dir_addsourcefile_err_header_level;

/*
  @@test
    kind cli
    args "--no-banner <DIR>/fixtures/dir_cli_shared_level.pcpp -o $P:output"
    exitcode 1
    expect
    | Compiling <DIR>/fixtures/dir_cli_shared_level.pcpp
    | Target platform: x86_64-windows-gnu
    | Optimize level: debug
    | Subsystem: Console
    | Saving build file...
    | Building dir_cli_shared_level...
    | [WARN] <DIR>/fixtures/dir_cli_shared_level.h(23,14) ZB0016: initializing 'char *' with an expression of type 'const char *' discards qualifiers
    |   <DIR>/fixtures/dir_cli_shared_level_c.c(22,10): Note: in file included from <DIR>/fixtures/dir_cli_shared_level_c.c:22:
    | Build failed with exit code 1.
    | [ERROR] <DIR>/fixtures/dir_cli_shared_level.h(23,14) ZB0016: cannot initialize a variable of type 'char *' with an rvalue of type 'const char *'
    |   <DIR>/fixtures/dir_cli_shared_level.cpp(22,10): Note: in file included from <DIR>/fixtures/dir_cli_shared_level.cpp:22:
    | Failed.
  @@end
*/

begin
end.
