  dir_subsystem_err_dll.pcpp - Directive: @subsystem gui on a dll

  Break step of dir_subsystem: gui on a module that is not an exe is a
  warning (the setting is not used, the build goes on), on both targets.
*******************************************************************************/

module dll dir_subsystem_err_dll;

/*
  @@test
    kind build
  @@end
*/

@subsystem gui; // WARN SM0103@1: a module that is not an exe

end.
