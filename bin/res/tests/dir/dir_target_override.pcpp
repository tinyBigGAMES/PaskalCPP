-------------------------------------------------------------------------------
  dir_target_override.pcpp - pcpp: -t over @target

  A cli test: pcpp runs itself with the args (in the suite's output root,
  -o "$P:output" so the build lands there), on the fixture named; its
  output and exit code are the check. pcpp -t is an override: it wins over every @target of the build, the
  imported unit's too (no CD0012 mismatch), so the build is for Linux.
*******************************************************************************/

module exe dir_target_override;

/*
  @@test
    kind cli
    args "--no-banner <DIR>/fixtures/dir_cli_target.pcpp -t x86_64-linux-gnu -o $P:output"
    exitcode 0
    expect
    | Compiling <DIR>/fixtures/dir_cli_target.pcpp
    | [HINT] <DIR>/fixtures/dir_cli_target.pcpp(24,1) SM0108: dir_cli_target: built for Linux
    | Target platform: x86_64-linux-gnu
    | Optimize level: debug
    | Saving build file...
    | Building dir_cli_target...
    | Build succeeded.
    | Output: <OUT>/bin/dir_cli_target
  @@end
*/

begin
end.
