-------------------------------------------------------------------------------
  dir_addsourcefile_asm.pcpp - Directive: @addsourcefile of an assembly file

  A .S file is preprocessed, then assembled: fixtures\dir_addsourcefile_asm.S
  gives a preprocessor warning (reported at its own line, the build goes
  on) and a function the program calls through a clink external routine.
*******************************************************************************/

module exe dir_addsourcefile_asm;

/*
  @@test
    kind run
    expect
    | from assembly: 7
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addsourcefile "$P:res/tests/dir/fixtures/dir_addsourcefile_asm.S";

routine clink dir_asf_asm_seven(): int32; external;

begin
  println("from assembly: {}", dir_asf_asm_seven());
end.
