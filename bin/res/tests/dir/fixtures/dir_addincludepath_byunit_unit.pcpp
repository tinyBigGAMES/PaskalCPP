module unit dir_addincludepath_byunit_unit;
@addincludepath "$P:res/tests/dir/fixtures";

#include "dir_addincludepath.h"

exported routine FromUnit(): int32;
begin
  return cpp("dir_addincludepath_value() + 1");
end;

end.
