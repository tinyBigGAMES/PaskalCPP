-------------------------------------------------------------------------------
  dir_cli_target.pcpp - Directive fixture: a program and its unit that
  name Windows; a hint says which target the build is for (the
  dir_target_* cli tests build it).
*******************************************************************************/

module exe dir_cli_target;
@target "x86_64-windows-gnu";
@ifdef TARGET_LINUX
@message hint "dir_cli_target: built for Linux";
@endif
@ifdef TARGET_WINDOWS
@message hint "dir_cli_target: built for Windows";
@endif
import dir_cli_target_unit;

begin
end.
