-------------------------------------------------------------------------------
  dir_target_linux_unit.pcpp - Directive fixture: the unit dir_target_linux
  imports; it has no @target, so it builds for the main module's target and
  prints it.
*******************************************************************************/

module unit dir_target_linux_unit;

exported routine ShowTarget();
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  println("in the unit: x86_64-windows-gnu");
@endif
@ifdef TARGET_X86_64_LINUX_GNU
  println("in the unit: x86_64-linux-gnu");
@endif
end;

end.
