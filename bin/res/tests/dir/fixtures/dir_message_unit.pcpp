  dir_message_unit.pcpp - Directive fixture: the unit dir_message imports;
  an @message in a unit's prologue and one in a routine body report in the
  one build (two of dir_message's seven reports).
*******************************************************************************/

module unit dir_message_unit;
@message hint "dir_message_unit: from a unit's prologue"; // HINT SM0108@1: from a unit's prologue

exported routine Value(): int32;
begin
  @message warn "dir_message_unit: from a unit's body"; // WARN SM0108@3: from a unit's body
  return 7;
end;

end.
