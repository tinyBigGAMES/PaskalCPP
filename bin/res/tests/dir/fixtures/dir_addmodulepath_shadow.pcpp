-------------------------------------------------------------------------------
  dir_addmodulepath_shadow.pcpp - Directive fixture: the fixtures\ copy of a unit
  that also sits beside dir_addmodulepath: the importer's own folder is
  searched first, so this copy is never found (Folder() = 2 would show it
  was).
*******************************************************************************/

module unit dir_addmodulepath_shadow;

exported routine Folder(): int32;
begin
  return 2;
end;

end.
