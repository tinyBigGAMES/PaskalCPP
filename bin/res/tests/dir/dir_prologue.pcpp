-------------------------------------------------------------------------------
  dir_prologue.pcpp - Directive: where build directives stand

  BNF.md sec 1 / 2: build directives stand only in the directive prologue,
  right after module ...; and before the import clause. A single-valued
  directive (@optimize, @subsystem, ...) is given at most once; the list
  directives (@cppdefine, @linklibrary, @add..., @copydll, @cppundef)
  accumulate. In an imported unit the main-module-only directives (@optimize,
  @subsystem, @target, @addverinfo, @unitTestMode, @vi*, @exeicon,
  @addmodulepath) are errors, the list directives add to the one build, and
  @breakpoint / @message are allowed. This exe gives two @cppdefine (both
  reach the emitted C++), and the unit fixtures\dir_prologue_unit it imports
  adds a third.
*******************************************************************************/

module exe dir_prologue;

/*
  @@test
    kind run
    expect
    | DIR_PRO_A + DIR_PRO_B = 3
    | DIR_PRO_FROM_UNIT = 5
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@cppdefine "DIR_PRO_A" "1";
@cppdefine "DIR_PRO_B" "2";
@addmodulepath "$P:res/tests/dir/fixtures";
import dir_prologue_unit;

begin
  println("DIR_PRO_A + DIR_PRO_B = {}", cpp("DIR_PRO_A + DIR_PRO_B"));
  println("DIR_PRO_FROM_UNIT = {}", cpp("DIR_PRO_FROM_UNIT"));
end.
