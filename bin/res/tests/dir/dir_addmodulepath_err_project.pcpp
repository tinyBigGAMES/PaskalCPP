-------------------------------------------------------------------------------
  dir_addmodulepath_err_project.pcpp - Directive: a $R: path in a build with no project

  Break step of dir_addmodulepath: $R: names the project root (the folder
  holding project.toml), and this file has no project.toml above it, so the
  path names nothing. Every path directive resolves through one routine, so
  this row stands for all of them.
*******************************************************************************/

module exe dir_addmodulepath_err_project;

/*
  @@test
    kind error
  @@end
*/

@addmodulepath "$R:src"; // ERROR PR0065@16: has no project

begin
end.
