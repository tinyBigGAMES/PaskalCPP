-------------------------------------------------------------------------------
  dir_copydll_dll.pcpp - Directive fixture: the dll dir_copydll copies
  beside itself with @copydll and loads at run time (a dep test: built in
  each consumer cell before it, never tallied).
*******************************************************************************/

module dll dir_copydll_dll;

/*
  @@test
    kind dep
  @@end
*/

exported routine clink dir_copydll_twice(AN: int32): int32;
begin
  return AN * 2;
end;

end.
