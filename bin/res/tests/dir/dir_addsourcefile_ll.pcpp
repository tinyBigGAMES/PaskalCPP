-------------------------------------------------------------------------------
  dir_addsourcefile_ll.pcpp - Directive: @addsourcefile of an LLVM IR file

  A .ll file is LLVM IR, compiled as it is (no C / C++ language flags):
  fixtures\dir_addsourcefile_ll_<os>.ll defines a function the program
  calls. IR names its target triple, so there is one file per target.
*******************************************************************************/

module exe dir_addsourcefile_ll;

/*
  @@test
    kind run
    expect
    | from LLVM IR: 9
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@ifdef TARGET_WINDOWS
@addsourcefile "$P:res/tests/dir/fixtures/dir_addsourcefile_ll_windows.ll";
@else
@addsourcefile "$P:res/tests/dir/fixtures/dir_addsourcefile_ll_linux.ll";
@endif

routine clink dir_asf_ll_nine(): int32; external;

begin
  println("from LLVM IR: {}", dir_asf_ll_nine());
end.
