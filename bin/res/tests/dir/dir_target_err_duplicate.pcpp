-------------------------------------------------------------------------------
  dir_target_err_duplicate.pcpp - Directive: @target given twice

  Break step of dir_target: the second is reported, even naming the same
  target; the first applies (so the test runs in its cell).
*******************************************************************************/

module exe dir_target_err_duplicate;

/*
  @@test
    kind error
    targets x86_64-windows-gnu
  @@end
*/

@target "x86_64-windows-gnu";
@target "x86_64-windows-gnu"; // ERROR CD0008@1: is given more than once

begin
end.
