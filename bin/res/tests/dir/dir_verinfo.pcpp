-------------------------------------------------------------------------------
  dir_verinfo.pcpp - Directive: @addverinfo and the @vi* directives

  @addverinfo on | off; stamps version info into the built program (exact
  case; off is the default). The @vi* directives give its values: @vimajor,
  @viminor, @vipatch (0..65535 each; the file version is
  major.minor.patch.0), @viproductname, @videscription, @vifilename,
  @vicompanyname, @vicopyright (BNF.md sec 2). A @vi* without @addverinfo on
  has no effect (a warning). Version info is a Windows resource: on a lib or
  a target that is not Windows, @addverinfo on is a warning and is not used.
  All of them are main module only, at most once each. This program reads
  its own version info back through the Windows version API and prints
  every value the stamp wrote (Windows only; Explorer's Properties, Details
  shows the same values for output\bin\dir_verinfo.exe).
*******************************************************************************/

module exe dir_verinfo;

/*
  @@test
    kind run
    targets x86_64-windows-gnu
    expect
    | fixed file version: 1.2.3.0
    | FileVersion: 1.2.3.0
    | ProductVersion: 1.2.3.0
    | ProductName: PaskalCPP Compliance
    | FileDescription: dir_verinfo test program
    | OriginalFilename: dir_verinfo.exe
    | InternalName: dir_verinfo
    | CompanyName: tinyBigGAMES LLC
    | LegalCopyright: Copyright 2026 tinyBigGAMES LLC
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addverinfo on;
@vimajor 1;
@viminor 2;
@vipatch 3;
@viproductname "PaskalCPP Compliance";
@videscription "dir_verinfo test program";
@vifilename "dir_verinfo.exe";
@vicompanyname "tinyBigGAMES LLC";
@vicopyright "Copyright 2026 tinyBigGAMES LLC";
@linklibrary "version";

#include <windows.h>
#include <string>

// This program's own version info block ("" when it has none)
static std::string dir_verinfo_block()
{
  char LPath[MAX_PATH];
  DWORD LLen = GetModuleFileNameA(nullptr, LPath, MAX_PATH);
  if ((LLen == 0) || (LLen == MAX_PATH))
    return "";
  DWORD LHandle = 0;
  DWORD LSize = GetFileVersionInfoSizeA(LPath, &LHandle);
  if (LSize == 0)
    return "";
  std::string LData(LSize, '\0');
  if (!GetFileVersionInfoA(LPath, 0, LSize, LData.data()))
    return "";
  return LData;
}

// The fixed part's file version, major.minor.build.revision
static std::string dir_verinfo_fixed()
{
  std::string LData = dir_verinfo_block();
  VS_FIXEDFILEINFO* LFixed = nullptr;
  UINT LFixedLen = 0;
  if (LData.empty() ||
      !VerQueryValueA(LData.data(), "\\", reinterpret_cast<LPVOID*>(&LFixed), &LFixedLen) ||
      (LFixedLen < sizeof(VS_FIXEDFILEINFO)))
    return "(none)";
  return std::to_string(HIWORD(LFixed->dwFileVersionMS)) + "." +
    std::to_string(LOWORD(LFixed->dwFileVersionMS)) + "." +
    std::to_string(HIWORD(LFixed->dwFileVersionLS)) + "." +
    std::to_string(LOWORD(LFixed->dwFileVersionLS));
}

// "<key>: <value>" for row AIndex of the string table the stamp writes
static std::string dir_verinfo_line(int AIndex)
{
  static const char* const LKeys[] = {
    "FileVersion", "ProductVersion", "ProductName", "FileDescription",
    "OriginalFilename", "InternalName", "CompanyName", "LegalCopyright"
  };
  std::string LData = dir_verinfo_block();
  std::string LQuery = std::string("\\StringFileInfo\\040904B0\\") + LKeys[AIndex];
  char* LValue = nullptr;
  UINT LValueLen = 0;
  if (LData.empty() ||
      !VerQueryValueA(LData.data(), LQuery.c_str(), reinterpret_cast<LPVOID*>(&LValue), &LValueLen) ||
      (LValueLen == 0))
    return std::string(LKeys[AIndex]) + ": (none)";
  return std::string(LKeys[AIndex]) + ": " + LValue;
}

begin
  println("fixed file version: {}", cpp("dir_verinfo_fixed()"));
  println("{}", cpp("dir_verinfo_line(0)"));
  println("{}", cpp("dir_verinfo_line(1)"));
  println("{}", cpp("dir_verinfo_line(2)"));
  println("{}", cpp("dir_verinfo_line(3)"));
  println("{}", cpp("dir_verinfo_line(4)"));
  println("{}", cpp("dir_verinfo_line(5)"));
  println("{}", cpp("dir_verinfo_line(6)"));
  println("{}", cpp("dir_verinfo_line(7)"));
end.
