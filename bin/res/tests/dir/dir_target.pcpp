-------------------------------------------------------------------------------
  dir_target.pcpp - Directive: @target

  @target "<triple>"; names the target a program is built for: an LLVM
  triple, arch-vendor-os-env, or arch-os-env, the same target with LLVM's
  vendor for its OS (BNF.md sec 2). Only the two official targets are
  accepted: x86_64-pc-windows-gnu and x86_64-unknown-linux-gnu. It stands in
  the directive prologue, outside any @ifdef branch, before the first
  conditional directive, at most once. Only the main module's @target
  applies: an imported module may name the same target (in any spelling) and
  otherwise builds for the main module's. This file names Windows in four
  parts; the unit fixtures\dir_target_unit it imports names it in three (the
  same target: no report). A -t on pcpp's command line wins over every
  @target, so the test runs only in the cell its @target names.
*******************************************************************************/

module exe dir_target;

/*
  @@test
    kind run
    targets x86_64-windows-gnu
    expect
    | PaskalCPP builds for: x86_64-windows-gnu
    | clang compiles for: _WIN32
    | in the unit: x86_64-windows-gnu
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@target "x86_64-pc-windows-gnu";
@addmodulepath "$P:res/tests/dir/fixtures";
import dir_target_unit;

// The OS macro clang defines for the target it compiles for
static const char* dir_target_os()
{
  return ""
#ifdef _WIN32
  " _WIN32"
#endif
#ifdef __linux__
  " __linux__"
#endif
  ;
}

begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  println("PaskalCPP builds for: x86_64-windows-gnu");
@endif
@ifdef TARGET_X86_64_LINUX_GNU
  println("PaskalCPP builds for: x86_64-linux-gnu");
@endif
  println("clang compiles for:{}", cpp("dir_target_os()"));
  dir_target_unit.ShowTarget();
end.
