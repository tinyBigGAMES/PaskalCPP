-------------------------------------------------------------------------------
  dir_addincludepath.pcpp - Directive: @addincludepath

  @addincludepath "<folder>"; adds a folder where the C/C++ compiler looks
  for #include files, for every translation unit of the build (BNF.md sec
  2). The folder must exist. @addincludepath may be given more than once
  (each folder is searched; one folder named again, in any spelling, is the
  same folder) and in an imported unit too: a unit adds to the one build
  (dir_addincludepath_byunit). This program adds fixtures\ twice, in two
  spellings, and includes fixtures\dir_addincludepath.h: the #include is
  found through the path alone. It prints what the header defines.
*******************************************************************************/

module exe dir_addincludepath;

/*
  @@test
    kind run
    expect
    | dir_addincludepath_value() = 30
    | DIR_ADDINCLUDEPATH_TWICE(21) = 42
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@addincludepath "$P:res/tests/dir/fixtures";
@addincludepath "$P:res\\tests\\dir\\fixtures\\";

#include "dir_addincludepath.h"

begin
  println("dir_addincludepath_value() = {}", cpp("dir_addincludepath_value()"));
  println("DIR_ADDINCLUDEPATH_TWICE(21) = {}", cpp("DIR_ADDINCLUDEPATH_TWICE(21)"));
end.
