-------------------------------------------------------------------------------
  dir_verinfo_err_range.pcpp - Directive: @vimajor past 65535

  Break step of dir_verinfo: a version part is 16 bits. Windows only: on
  Linux @addverinfo on is a warning of its own (dir_verinfo_err_linux).
*******************************************************************************/

module exe dir_verinfo_err_range;

/*
  @@test
    kind error
    targets x86_64-windows-gnu
  @@end
*/

@addverinfo on;
@vimajor 70000; // ERROR SM0101@10: @vimajor takes 0..65535, got 70000

begin
end.
