-------------------------------------------------------------------------------
  dir_optimize_safe.pcpp - Directive: @optimize safe

  @optimize <level>; sets the build's optimize level, one of debug, safe,
  fast, small, exact case (BNF.md sec 2; the default is debug). A module
  gives @optimize once, so each level is its own file: dir_optimize (small),
  dir_optimize_debug, dir_optimize_safe, dir_optimize_fast. Each prints the
  macros clang sees, which tell the levels apart: debug defines PCPP_DEBUG
  (the runtime's heap report), safe __OPTIMIZE__, fast __OPTIMIZE__ and
  NDEBUG, small __OPTIMIZE__, __OPTIMIZE_SIZE__ and NDEBUG. Only a debug
  build prints the [Heap] report. The safe level: optimized, asserts kept.
*******************************************************************************/

module exe dir_optimize_safe;

/*
  @@test
    kind run
    opt safe
    expect
    | clang sees: __OPTIMIZE__
  @@end
*/

@optimize safe;

// The macros clang defines at this level, in a fixed order
static const char* dir_optimize_flags()
{
  return ""
#ifdef __OPTIMIZE__
  " __OPTIMIZE__"
#endif
#ifdef __OPTIMIZE_SIZE__
  " __OPTIMIZE_SIZE__"
#endif
#ifdef NDEBUG
  " NDEBUG"
#endif
#ifdef PCPP_DEBUG
  " PCPP_DEBUG"
#endif
  ;
}

begin
  println("clang sees:{}", cpp("dir_optimize_flags()"));
end.
