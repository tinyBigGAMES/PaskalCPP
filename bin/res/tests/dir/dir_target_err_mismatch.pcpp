-------------------------------------------------------------------------------
  dir_target_err_mismatch.pcpp - Directive: a unit naming another target

  Break step of dir_target: the imported unit
  fixtures\dir_target_err_mismatch_unit names Linux while this main module
  names Windows. Only the main module's @target applies; the unit's is
  reported, at its marked line.
*******************************************************************************/

module exe dir_target_err_mismatch;

/*
  @@test
    kind error
    targets x86_64-windows-gnu
  @@end
*/

@target "x86_64-pc-windows-gnu";
@addmodulepath "$P:res/tests/dir/fixtures";
import dir_target_err_mismatch_unit;

begin
end.
