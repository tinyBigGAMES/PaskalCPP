module exe dir_addsourcefile_err_mixed;

/*
  @@test
    kind error
  @@end
*/

@addsourcefile "$P:res/tests/dir/fixtures/dir_addsourcefile_err_clang_cpp.C";
@addsourcefile "$P:res/tests/dir/fixtures/dir_addsourcefile_err_asm.S";

begin
end.
