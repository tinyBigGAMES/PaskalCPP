-------------------------------------------------------------------------------
  dir_exeicon.pcpp - Directive: @exeicon (Windows)

  @exeicon "<path>"; stamps an .ico file into the built program as its icon
  (BNF.md sec 2). The path must name an existing file; it resolves once, as
  every path directive ($P: = the folder pcpp.exe is in; a plain relative
  path = the current folder). An icon belongs to an executable: on a dll or
  a lib it is a warning and is not used. On Windows it is stamped as the
  exe's icon resource; on a target that is not Windows the compiler builds
  its largest image in as the built-in data entry "pcpp/exeicon"
  (dir_exeicon_linux). Main module only, at most once. This program stamps
  res\assets\icons\paskalcpp.ico (13 images) and reads its own icon
  resources back: one icon group holding the file's images, in the file's
  order, each width x height / bits per pixel (Explorer shows
  output\bin\dir_exeicon.exe with the PaskalCPP icon).
*******************************************************************************/

module exe dir_exeicon;

/*
  @@test
    kind run
    targets x86_64-windows-gnu
    expect
    | icon groups: 1
    | images in the group: 13
    | sizes: 32x32/4 16x16/4 48x48/8 32x32/8 16x16/8 256x256/32 64x64/32 48x48/32 40x40/32 32x32/32 24x24/32 20x20/32 16x16/32
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

@exeicon "$P:res/assets/icons/paskalcpp.ico";

#include <windows.h>
#include <string>

// What this program's own icon resources hold
struct dir_exeicon_scan
{
  int Groups = 0;
  int Count = 0;
  std::string Sizes;
};

// One RT_GROUP_ICON resource: counted; the first one's entries are read
// (GRPICONDIR: 6 bytes, then 14 bytes per GRPICONDIRENTRY; width 0 = 256)
static BOOL CALLBACK dir_exeicon_group(HMODULE AModule, LPCSTR AType, LPSTR AName, LONG_PTR AParam)
{
  dir_exeicon_scan* LScan = reinterpret_cast<dir_exeicon_scan*>(AParam);
  LScan->Groups++;
  if (LScan->Groups > 1)
    return TRUE;
  HRSRC LRes = FindResourceA(AModule, AName, AType);
  if (LRes == nullptr)
    return TRUE;
  HGLOBAL LMem = LoadResource(AModule, LRes);
  const BYTE* LData = (LMem != nullptr) ? static_cast<const BYTE*>(LockResource(LMem)) : nullptr;
  DWORD LSize = SizeofResource(AModule, LRes);
  if ((LData == nullptr) || (LSize < 6))
    return TRUE;
  WORD LCount = *reinterpret_cast<const WORD*>(LData + 4);
  if (LSize < 6 + DWORD(LCount) * 14)
    return TRUE;
  LScan->Count = LCount;
  for (WORD LI = 0; LI < LCount; LI++)
  {
    const BYTE* LEntry = LData + 6 + LI * 14;
    int LWidth = (LEntry[0] != 0) ? LEntry[0] : 256;
    int LHeight = (LEntry[1] != 0) ? LEntry[1] : 256;
    WORD LBits = *reinterpret_cast<const WORD*>(LEntry + 6);
    if (!LScan->Sizes.empty())
      LScan->Sizes += " ";
    LScan->Sizes += std::to_string(LWidth) + "x" + std::to_string(LHeight) + "/" +
      std::to_string(LBits);
  }
  return TRUE;
}

static const dir_exeicon_scan& dir_exeicon_icons()
{
  static dir_exeicon_scan LScan;
  static bool LDone = false;
  if (!LDone)
  {
    LDone = true;
    // 14 = RT_GROUP_ICON (RT_ICON + 11), spelled for the A API
    EnumResourceNamesA(nullptr, MAKEINTRESOURCEA(14), dir_exeicon_group,
      reinterpret_cast<LONG_PTR>(&LScan));
  }
  return LScan;
}

static int dir_exeicon_groups() { return dir_exeicon_icons().Groups; }
static int dir_exeicon_count() { return dir_exeicon_icons().Count; }
static std::string dir_exeicon_sizes() { return dir_exeicon_icons().Sizes; }

begin
  println("icon groups: {}", dir_exeicon_groups());
  println("images in the group: {}", dir_exeicon_count());
  println("sizes: {}", dir_exeicon_sizes());
end.
