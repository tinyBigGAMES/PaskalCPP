module exe dir_addresdata_err_reserved;

/*
  @@test
    kind error
  @@end
*/

@addresdata "pcpp/hello" "$P:res/tests/dir/fixtures/dir_addresdata_hello.txt"; // ERROR SM0120@13

begin
end.
