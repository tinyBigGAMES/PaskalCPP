-------------------------------------------------------------------------------
  dir_addsourcefile_err_noext.pcpp - Directive: @addsourcefile of a name without an extension

  Break step of dir_addsourcefile: the name is checked before the file is
  looked for, so a folder (no extension) is SM0114, not a missing file.
*******************************************************************************/

module exe dir_addsourcefile_err_noext;

/*
  @@test
    kind error
  @@end
*/

@addsourcefile "$P:res/tests/dir/fixtures"; // ERROR SM0114@16

begin
end.
