-------------------------------------------------------------------------------
  dir_target_defaults.pcpp - pcpp: --defaults: the source's @target wins

  A cli test: pcpp runs itself with the args (in the suite's output root,
  -o "$P:output" so the build lands there), on the fixture named; its
  output and exit code are the check. A default -t never replaces a @target: the build stays Windows.
*******************************************************************************/

module exe dir_target_defaults;

/*
  @@test
    kind cli
    args "--no-banner <DIR>/fixtures/dir_cli_target.pcpp --defaults -t x86_64-linux-gnu -o $P:output"
    exitcode 0
    expect
    | Compiling <DIR>/fixtures/dir_cli_target.pcpp
    | [HINT] <DIR>/fixtures/dir_cli_target.pcpp(27,1) SM0108: dir_cli_target: built for Windows
    | Target platform: x86_64-windows-gnu
    | Optimize level: debug
    | Subsystem: Console
    | Saving build file...
    | Building dir_cli_target...
    | Build succeeded.
    | Output: <OUT>/bin/dir_cli_target.exe
  @@end
*/

begin
end.
