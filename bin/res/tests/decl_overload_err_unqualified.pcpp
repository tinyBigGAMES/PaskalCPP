-------------------------------------------------------------------------------
  decl_overload_err_unqualified.pcpp - break step of decl_overload.pcpp:
  an import's Show(string) does not join this module's Show(int32): only the module's own is seen

  How to check, from repo\bin:
    pcpp res\tests\decl_overload_err_unqualified.pcpp
    pcpp res\tests\decl_overload_err_unqualified.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_overload_err_unqualified;

import decl_overload_unit;

routine Show(AN: int32): string;
begin
  return "own int32";
end;

var
  LS: string;

begin
  LS := Show("x"); // ERROR SM0404@14
end.
