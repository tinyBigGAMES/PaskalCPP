-------------------------------------------------------------------------------
  type_overlay_err_embed.pcpp - break step of type_overlay.pcpp:
  an overlay holds no embeds; an object does (PR0034)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_embed.pcpp
    pcpp res\tests\type_overlay_err_embed.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_embed;

type
  TInner = record
    X: int16;
  end;
  TV = overlay
    embed E: TInner; // ERROR PR0034@5: 'embed' is not allowed in an overlay
    B: int32;
  end;

begin
end.
