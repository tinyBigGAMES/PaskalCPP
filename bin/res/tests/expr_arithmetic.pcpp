-------------------------------------------------------------------------------
  expr_arithmetic.pcpp - Expression compliance: arithmetic

  + - * / div mod % (BNF.md sec 6): / is always real division (7 / 2 =
  3.5), div and mod are integer division and remainder (% is mod), unary -
  and + apply to numbers. A constant expression is folded and judged: an
  overflow, a division by a zero constant and the minimum div -1 are errors.
  A result has the type C++ computes it in (int8 + int8 is int32, / of two
  integers float64) and no operand converts hiddenly to it; a char, wchar
  or bool is no number. A narrower store or a mixed pair is written with a
  cast (the casts line).

  How to check, from repo\bin:
    pcpp res\tests\expr_arithmetic.pcpp -r
    pcpp res\tests\expr_arithmetic.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    ints 9 5 14
    divide 3.5
    div mod 3 1 1
    negative -3 -1
    unary -7 7
    float 3.75
    casts 9 4.5 98
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    expr_arithmetic_err_operands.pcpp
      a string times an int32 (SM0250)
    expr_arithmetic_err_overflow.pcpp
      a constant that overflows int32 (SM0256)
    expr_arithmetic_err_div_zero.pcpp
      div by a zero constant (SM0257)
    expr_arithmetic_err_min_div.pcpp
      the minimum int32 div -1 (SM0258)
    expr_arithmetic_err_into_narrow.pcpp
      the int32 sum of two int8 values stored into an int8 (SM0200)
    expr_arithmetic_err_mixed_sign.pcpp
      an int32 added to a uint32 (SM0200)
    expr_arithmetic_err_div_int64.pcpp
      an int64 divided with / (SM0200)
    expr_arithmetic_err_compound.pcpp
      an int32 added into an int8 with += (SM0200)
    expr_arithmetic_err_div_assign.pcpp
      /= on an int32 (SM0250)
    expr_arithmetic_err_char.pcpp
      a char plus an int32 (SM0250)
*******************************************************************************/

module exe expr_arithmetic;

var
  LA: int32 = 7;
  LB: int32 = 2;
  LF: float64 = 1.5;
  LN: int8 = 4;
  LBig: int64 = 9;
  LC: char = 'a';

begin
  println("ints {} {} {}", LA + LB, LA - LB, LA * LB);
  println("divide {}", LA / LB);
  println("div mod {} {} {}", LA div LB, LA mod LB, LA % LB);
  println("negative {} {}", -LA div LB, -LA mod LB);
  println("unary {} {}", -LA, +LA);
  println("float {}", LF * 2.5);
  LN := int8(LN + 5);
  LN += 0;
  println("casts {} {} {}", LN, float64(LBig) / 2, int32(LC) + 1);
end.
