-------------------------------------------------------------------------------
  type_object_embed_err_shared_iface.pcpp - break step of type_object_embed.pcpp:
  an interface method two embeds have: declare it (SM0370)

  How to check, from repo\bin:
    pcpp res\tests\type_object_embed_err_shared_iface.pcpp
    pcpp res\tests\type_object_embed_err_shared_iface.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_embed_err_shared_iface;

type
  INamed = interface
    method Name(): string;
  end;
  TA = object
    method Name(): string;
    begin
      return "a";
    end;
  end;
  TB = object
    method Name(): string;
    begin
      return "b";
    end;
  end;
  TBoth = object implements INamed // ERROR SM0370@29: two embeds, 'A' and 'B', have it
    embed A: TA;
    embed B: TB;
  end;

begin
end.
