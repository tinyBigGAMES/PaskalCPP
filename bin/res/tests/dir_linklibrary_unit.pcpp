-------------------------------------------------------------------------------
  dir_linklibrary_unit.pcpp - the unit dir_linklibrary.pcpp imports: its own
  @linklibrary names lib_plain (from where lib_plain.pcpp's commands build
  it), which adds to the one build of the program.

  Nothing to check here: dir_linklibrary.pcpp checks it.
*******************************************************************************/

module unit dir_linklibrary_unit;
@addlibrarypath "$P:output/lib";
@linklibrary "lib_plain";

routine clink lib_plain_add(AA: int32; AB: int32): int32; external;

exported routine Add(AA: int32; AB: int32): int32;
begin
  return lib_plain_add(AA, AB);
end;

end.
