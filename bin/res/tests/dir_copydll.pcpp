-------------------------------------------------------------------------------
  dir_copydll.pcpp - Directive compliance: @copydll

  @copydll "<path>"; copies a file beside the built program before the build
  (BNF.md sec 2), so a library the program loads is found next to it. The
  path must name an existing file; it resolves once, as every path directive
  ($P: = the folder pcpp.exe is in). @copydll may be given more than once
  (each file is copied; the same file twice is one copy) and in an imported
  unit too.

  This program copies the dll dir_copydll_dll.pcpp builds (a different file
  per target, chosen by @ifdef), then loads it at run time by its full path
  in the program's own folder and calls its routine: the call works only if
  the copy is there.

  How to check, from repo\bin (build the dll first, its header has the
  commands):
    pcpp res\tests\dir_copydll_dll.pcpp
    pcpp res\tests\dir_copydll.pcpp -r
    pcpp res\tests\dir_copydll_dll.pcpp -t x86_64-linux-gnu
    pcpp res\tests\dir_copydll.pcpp -r -t x86_64-linux-gnu   (runs in WSL)
  EXPECT:
    dir_copydll_twice(21) from the copied library = 42
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  Two [Heap] lines: the program's and the debug dll's own (a dll has its own
  heap and its own report, at its shutdown).
  CHECK: output\bin holds dir_copydll_dll.dll beside dir_copydll.exe
  (libdir_copydll_dll.so beside dir_copydll on Linux).

  Break it: run each file below the same way, without -r; each reports
  exactly what the // ERROR / WARN / HINT comment on its marked line says,
  and nothing else:
    dir_copydll_err_missing.pcpp  a file that does not exist
    dir_copydll_err_path.pcpp     a path no file can have (a '<' in it)
*******************************************************************************/

module exe dir_copydll;
@ifdef TARGET_X86_64_LINUX_GNU
@copydll "$P:output/dir_copydll_dll_linux/bin/libdir_copydll_dll.so";
@linklibrary "dl";
@else
@copydll "$P:output/dir_copydll_dll/bin/dir_copydll_dll.dll";
@endif

#include <string>
#ifdef _WIN32
#include <windows.h>
#else
#include <dlfcn.h>
#include <unistd.h>
#include <climits>
#endif

// The folder this program's own file is in, with its trailing separator
static std::string dir_copydll_folder()
{
#ifdef _WIN32
  char LPath[MAX_PATH];
  DWORD LLen = GetModuleFileNameA(nullptr, LPath, MAX_PATH);
  if ((LLen == 0) || (LLen == MAX_PATH))
    return "";
  std::string LText(LPath, LLen);
  return LText.substr(0, LText.find_last_of("\\/") + 1);
#else
  char LPath[PATH_MAX];
  ssize_t LLen = readlink("/proc/self/exe", LPath, sizeof(LPath) - 1);
  if (LLen <= 0)
    return "";
  std::string LText(LPath, size_t(LLen));
  return LText.substr(0, LText.find_last_of('/') + 1);
#endif
}

typedef int (*dir_copydll_twice_fn)(int);

// Loads the copied library from this program's folder (by its full path,
// never a search) and calls its routine: -1 = not there, -2 = no routine
static int dir_copydll_call(int AValue)
{
#ifdef _WIN32
  HMODULE LLib = LoadLibraryA((dir_copydll_folder() + "dir_copydll_dll.dll").c_str());
  if (LLib == nullptr)
    return -1;
  dir_copydll_twice_fn LFn = reinterpret_cast<dir_copydll_twice_fn>(
    reinterpret_cast<void*>(GetProcAddress(LLib, "dir_copydll_twice")));
#else
  void* LLib = dlopen((dir_copydll_folder() + "libdir_copydll_dll.so").c_str(), RTLD_NOW);
  if (LLib == nullptr)
    return -1;
  dir_copydll_twice_fn LFn = reinterpret_cast<dir_copydll_twice_fn>(dlsym(LLib, "dir_copydll_twice"));
#endif
  if (LFn == nullptr)
    return -2;
  return LFn(AValue);
}

begin
  println("dir_copydll_twice(21) from the copied library = {}", cpp("dir_copydll_call(21)"));
end.
