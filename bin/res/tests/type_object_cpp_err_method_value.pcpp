-------------------------------------------------------------------------------
  type_object_cpp_err_method_value.pcpp - break step of type_object_cpp.pcpp:
  a method assigned to a routine variable (SM0432)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_method_value.pcpp
    pcpp res\tests\type_object_cpp_err_method_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_method_value;

type
  TFn = routine(): int32;
  TBox = object
    N: int32;
    method Get(): int32;
    begin
      return self.N;
    end;
  end;

var
  LB: TBox;
  LF: TFn;
begin
  LF := LB.Get; // ERROR SM0432
end.
