-------------------------------------------------------------------------------
  expr_bitwise_err_shift_count.pcpp - break step of expr_bitwise.pcpp:
  a constant shift count of 32 on an int32 (SM0259)

  How to check, from repo\bin:
    pcpp res\tests\expr_bitwise_err_shift_count.pcpp
    pcpp res\tests\expr_bitwise_err_shift_count.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe expr_bitwise_err_shift_count;

var
  LN: int32;

begin
  LN := 1 shl 32; // ERROR SM0259@15: shift count 32 outside 0..31
end.
