-------------------------------------------------------------------------------
  type_object_property_err_const.pcpp - break step of type_object_property.pcpp:
  a const object has no write (SM0255)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_err_const.pcpp
    pcpp res\tests\type_object_property_err_const.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_err_const;

type
  TBox = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;

routine Put(const AB: TBox);
begin
  AB.N := 1; // ERROR SM0255@3: 'AB.N' cannot be assigned
end;

begin
end.
