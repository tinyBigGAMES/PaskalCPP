  stmt_match_err_subject.pcpp - break step of stmt_match.pcpp:
  a string subject (SM0603)

  How to check, from repo\bin:
    pcpp res\tests\stmt_match_err_subject.pcpp
    pcpp res\tests\stmt_match_err_subject.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe stmt_match_err_subject;

var
  LS: string;

begin
  LS := "a";
  match LS of // ERROR SM0603@9: a match subject is
    1: println("one");
  end;
end.
