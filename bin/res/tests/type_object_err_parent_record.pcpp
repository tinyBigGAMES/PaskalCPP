-------------------------------------------------------------------------------
  type_object_err_parent_record.pcpp - break step of type_object.pcpp:
  a record as an object's parent (SM0308)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_parent_record.pcpp
    pcpp res\tests\type_object_err_parent_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_parent_record;

type
  TR = record
    Z: int32;
  end;
  TO = object(TR) // ERROR SM0308@15: 'TR' cannot be the parent of an object
    X: int32;
  end;

begin
end.
