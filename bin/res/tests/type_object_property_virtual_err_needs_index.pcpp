-------------------------------------------------------------------------------
  type_object_property_virtual_err_needs_index.pcpp - break step of type_object_property_virtual.pcpp:
  an indexed property is read through its index (SM0378)

  How to check, from repo\bin:
    pcpp res\tests\type_object_property_virtual_err_needs_index.pcpp
    pcpp res\tests\type_object_property_virtual_err_needs_index.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_property_virtual_err_needs_index;

type
  TBag = object
    FI: int32;
    property Items[const AI: int32]: int32 read
      begin
        return self.FI + AI;
      end;
  end;

var
  LB: TBag;
  LX: int32;
begin
  LX := LB.Items; // ERROR SM0378@12: property 'Items' is indexed
end.
