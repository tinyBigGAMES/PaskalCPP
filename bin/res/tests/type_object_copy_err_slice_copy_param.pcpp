-------------------------------------------------------------------------------
  type_object_copy_err_slice_copy_param.pcpp - break step of type_object_copy.pcpp:
  a const parameter of a polymorphic object returned by value: it may be a descendant (SM0428)

  How to check, from repo\bin:
    pcpp res\tests\type_object_copy_err_slice_copy_param.pcpp
    pcpp res\tests\type_object_copy_err_slice_copy_param.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_copy_err_slice_copy_param;

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
  end;

routine Keep(const AB: TA): TA;
begin
  return AB; // ERROR SM0428@10: 'AB' may hold a descendant of 'TA' (it is polymorphic): a copy keeps only its 'TA' part
end;

begin
end.
