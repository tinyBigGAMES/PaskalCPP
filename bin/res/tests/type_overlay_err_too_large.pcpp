-------------------------------------------------------------------------------
  type_overlay_err_too_large.pcpp - break step of type_overlay.pcpp:
  no type holds more than 1152921504606846975 bytes: a field of exactly that many beside an int64 rounds the overlay up past it (SM0277, at the overlay's name, judged in the emitted C++)

  How to check, from repo\bin:
    pcpp res\tests\type_overlay_err_too_large.pcpp
    pcpp res\tests\type_overlay_err_too_large.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_overlay_err_too_large;

type
  TV = overlay // ERROR SM0277@3: 'TV' is too large: a type holds at most 1152921504606846975 bytes
    A: array[0..1152921504606846974] of uint8;
    B: int64;
  end;

var
  LV: TV;

begin
end.
