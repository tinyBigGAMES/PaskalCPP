-------------------------------------------------------------------------------
  type_routine_err_procedure_value.pcpp - break step of type_routine.pcpp:
  the call of a routine value whose type has no return type used as a value (SM0406)

  How to check, from repo\bin:
    pcpp res\tests\type_routine_err_procedure_value.pcpp
    pcpp res\tests\type_routine_err_procedure_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_routine_err_procedure_value;

var
  LP: routine(AN: int32);
  LN: int32;

begin
  LP := nil;
  LN := LP(1); // ERROR SM0406@9: calls a procedure
end.
