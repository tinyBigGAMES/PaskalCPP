-------------------------------------------------------------------------------
  dir_verinfo_err_range.pcpp - break step of dir_verinfo.pcpp: @vimajor past
  65535 (a version part is 16 bits)

  How to check, from repo\bin (Windows only: on Linux @addverinfo on is a
  warning of its own, dir_verinfo_err_linux.pcpp):
    pcpp res\tests\dir_verinfo_err_range.pcpp
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe dir_verinfo_err_range;
@addverinfo on;
@vimajor 70000; // ERROR SM0101@10: @vimajor takes 0..65535, got 70000

begin
end.
