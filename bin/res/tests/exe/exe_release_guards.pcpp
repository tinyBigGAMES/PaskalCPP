-------------------------------------------------------------------------------
  exe_release_guards.pcpp - Build-kind compliance: a guard catches a nil
  access in a release build

  Built with @optimize fast: a write and a read through a nil pointer the
  optimizer can see, directly and through a routine, are still real accesses,
  so each guard catches exception 3 as a debug build does and the program
  goes on. The same program at safe: exe_release_guards_safe.pcpp.
*******************************************************************************/

module exe exe_release_guards;

/*
  @@test
    kind run
    opt fast
    expect
    | nil write: 3 Access violation
    | nil write through a routine: 3 Access violation
    | nil read: 3 Access violation
    | done
  @@end
*/

@optimize fast;

routine Write(AP: ptr to int32);
begin
  AP^ := 1;
end;

var
  LP: ptr to int32;
  LN: int32;

begin
  LP := nil;
  guard
    LP^ := 1;
  except
    println("nil write: {} {}", exccode(), excmsg());
  end;
  guard
    Write(LP);
  except
    println("nil write through a routine: {} {}", exccode(), excmsg());
  end;
  guard
    LN := LP^;
    println("read {}", LN);
  except
    println("nil read: {} {}", exccode(), excmsg());
  end;
  println("done");
end.
