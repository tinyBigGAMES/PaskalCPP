  exe_cli_dotted_bare.pcpp - Build-kind compliance: pcpp -r on a dotted main
  module given without '.pcpp'

  '.pcpp' is appended to the whole argument: the last part (Main) is never
  taken for an extension and replaced. This file itself is never compiled.
*******************************************************************************/

module exe exe_cli_dotted_bare;

/*
  @@test
    kind cli
    args "--no-banner <DIR>/fixtures/exe_cli_dotted.Main -r -o $P:output"
    exitcode 0
    expect
    | Compiling <DIR>/fixtures/exe_cli_dotted.Main.pcpp
    | Target platform: x86_64-windows-gnu
    | Optimize level: debug
    | Subsystem: Console
    | Saving build file...
    | Building exe_cli_dotted.Main...
    | Build succeeded.
    | Output: <OUT>/bin/exe_cli_dotted.Main.exe
    | Running exe_cli_dotted.Main.exe...
    | exe_cli_dotted.Main runs
    | [Heap] Allocs: 0, Frees: 0, Leaked: 0
  @@end
*/

begin
end.
