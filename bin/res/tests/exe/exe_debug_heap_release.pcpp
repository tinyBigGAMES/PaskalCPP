-------------------------------------------------------------------------------
  exe_debug_heap_release.pcpp - Build-kind compliance: no heap report in a
  release build

  The same program as exe_debug_heap.pcpp built with @optimize fast:
  the heap is not counted and nothing is reported at shutdown.
*******************************************************************************/

module exe exe_debug_heap_release;

/*
  @@test
    kind run
    opt fast
    expect
    | blocks taken
    | final
  @@end
*/

@optimize fast;

var
  LKept: ptr;
  LFreed: ptr;

finalize
begin
  println("final");
end;

begin
  LKept := getmem(16);
  LFreed := getmem(32);
  freemem(LFreed);
  println("blocks taken");
end.
