  exe_cli_dotted_err_suffix.pcpp - Build-kind compliance: an argument ending
  in another suffix

  '.pcpp' is appended, never swapped in for the last part: the fixture
  exe_cli_dotted.Main.pcpp exists, but 'exe_cli_dotted.txt' names
  exe_cli_dotted.txt.pcpp, which does not (exit 2, that path named). This
  file itself is never compiled.
*******************************************************************************/

module exe exe_cli_dotted_err_suffix;

/*
  @@test
    kind cli
    args "--no-banner <DIR>/fixtures/exe_cli_dotted.txt"
    exitcode 2
    expect
    | Error: Source file not found: <DIR>/fixtures/exe_cli_dotted.txt.pcpp
  @@end
*/

begin
end.
