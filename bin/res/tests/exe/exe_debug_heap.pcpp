-------------------------------------------------------------------------------
  exe_debug_heap.pcpp - Build-kind compliance: the debug heap report

  A debug build (the default) counts every getmem and freemem and prints
  [Heap] Allocs, Frees and Leaked at shutdown, after finalize: here one
  block is freed and one is not. A release build prints no report:
  exe_debug_heap_release.
*******************************************************************************/

module exe exe_debug_heap;

/*
  @@test
    kind run
    expect
    | blocks taken
    | final
    | [Heap] Allocs: 2, Frees: 1, Leaked: 1
  @@end
*/

var
  LKept: ptr;
  LFreed: ptr;

finalize
begin
  println("final");
end;

begin
  LKept := getmem(16);
  LFreed := getmem(32);
  freemem(LFreed);
  println("blocks taken");
end.
