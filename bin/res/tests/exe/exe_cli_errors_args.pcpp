module exe exe_cli_errors_args;

/*
  @@test
    kind cli
    args "--no-banner <DIR>/fixtures/exe_cli_hello.pcpp -o $P:output -- one two"
    exitcode 2
    expect
    | Error: -- (program arguments) is used with -r or -d only
    | 
    | Run pcpp -h to see available options
  @@end
*/

begin
end.
