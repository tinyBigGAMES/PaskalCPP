  exe_cli_errors.pcpp - Build-kind compliance: an unknown option

  An option pcpp does not know is a usage error: exit 2, and the hint to run
  pcpp -h. This file itself is never compiled.
*******************************************************************************/

module exe exe_cli_errors;

/*
  @@test
    kind cli
    args "--no-banner --bogus"
    exitcode 2
    expect
    | Error: Unknown flag: --bogus
    | 
    | Run pcpp -h to see available options
  @@end
*/

begin
end.
