-------------------------------------------------------------------------------
  dir_addresdata_err_duplicate_lib.pcpp - break step of dir_addresdata.pcpp:
  a key a separately built library also adds. The library
  dir_addresdata_err_duplicate_lib_dep.pcpp was built on its own, so this
  build cannot see its directives; both entries land in this one program, which
  has one key space. The linker finds the key twice and PaskalCPP reports it
  as SM0121 at this file's directive, with a note at the @linklibrary of the
  library that holds the key too. Same on both targets.

  How to check, from repo\bin (the library's two commands first):
    pcpp res\tests\dir_addresdata_err_duplicate_lib.pcpp
    pcpp res\tests\dir_addresdata_err_duplicate_lib.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe dir_addresdata_err_duplicate_lib;
@addlibrarypath "$P:output/lib";
@linklibrary "dir_addresdata_err_duplicate_lib_dep";
@addresdata "hello" "$P:res/tests/dir_addresdata_hello.txt"; // ERROR SM0121@13

routine clink dir_addresdata_dep_add(AA: int32; AB: int32): int32; external;

begin
  println("{}", dir_addresdata_dep_add(1, 2));
end.
