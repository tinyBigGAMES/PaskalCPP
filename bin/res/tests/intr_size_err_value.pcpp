-------------------------------------------------------------------------------
  intr_size_err_value.pcpp - break step of intr_size.pcpp:
  size of a variable (SM0410)

  How to check, from repo\bin:
    pcpp res\tests\intr_size_err_value.pcpp
    pcpp res\tests\intr_size_err_value.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_size_err_value;

var
  LN: int64;

begin
  LN := 1;
  LN := size(LN); // ERROR SM0410@14: size needs a type, got the value 'LN'
end.
