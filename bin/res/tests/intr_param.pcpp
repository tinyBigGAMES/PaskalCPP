-------------------------------------------------------------------------------
  intr_param.pcpp - Intrinsic compliance: paramcount and paramstr

  paramcount() is the number of program arguments, paramstr(I) argument I
  (1-based; 0 is the program itself); out of range it is "" (BNF.md sec 7).
  The arguments come after -- on the command line.

  How to check, from repo\bin:
    pcpp res\tests\intr_param.pcpp -r -- one two
    pcpp res\tests\intr_param.pcpp -r -t x86_64-linux-gnu -- one two   (runs in WSL)
  EXPECT:
    count 2
    param 1 one
    param 2 two
    out of range ''
    [Heap] Allocs: 0, Frees: 0, Leaked: 0
  EXITCODE: 0
  The [Heap] line is the debug build's heap report.

  Break it: run each file below the same way, without -r; each reports
  exactly what the // comment on its marked line says, and nothing else:
    intr_param_err_string.pcpp
      paramstr given a string (SM0409)
    intr_param_err_value.pcpp
      paramcount named as a value, not called (SM0423)
    intr_param_err_wide.pcpp
      paramstr given an int64 index (SM0409)
*******************************************************************************/

module exe intr_param;

var
  LI: int32;

begin
  println("count {}", paramcount());
  LI := 1;
  while LI <= paramcount() do
    println("param {} {}", LI, paramstr(LI));
    LI := LI + 1;
  end;
  println("out of range '{}'", paramstr(9));
end.
