-------------------------------------------------------------------------------
  type_object_operator_err_compare_less.pcpp - break step of type_object_operator.pcpp:
  objects compared with < by a type that declares only = and <> (SM0252)

  How to check, from repo\bin:
    pcpp res\tests\type_object_operator_err_compare_less.pcpp
    pcpp res\tests\type_object_operator_err_compare_less.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_operator_err_compare_less;

type
  TTicket = object
    Seat: int32;
    operator =(const A: TTicket; const B: TTicket): bool;
    begin
      return A.Seat = B.Seat;
    end;
    operator <>(const A: TTicket; const B: TTicket): bool;
    begin
      return A.Seat <> B.Seat;
    end;
  end;

var
  LA: TTicket;
  LB: TTicket;
  LE: bool;
begin
  LE := LA < LB; // ERROR SM0252
end.
