-------------------------------------------------------------------------------
  type_choices_err_past_max.pcpp - break step of type_choices.pcpp:
  no value follows the largest int64: it would have no number (SM0256)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_past_max.pcpp
    pcpp res\tests\type_choices_err_past_max.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_past_max;

type
  TB = choices(bTop = 9223372036854775807, bPast); // ERROR SM0256@44: constant overflows 'int64'

begin
end.
