-------------------------------------------------------------------------------
  intr_print_err_record.pcpp - break step of intr_print.pcpp:
  a record printed (SM0425)

  How to check, from repo\bin:
    pcpp res\tests\intr_print_err_record.pcpp
    pcpp res\tests\intr_print_err_record.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe intr_print_err_record;

type
  TP = record
    X: int32;
  end;

var
  LR: TP;

begin
  println("{}", LR); // ERROR SM0425@17: 'TP' cannot be printed
end.
