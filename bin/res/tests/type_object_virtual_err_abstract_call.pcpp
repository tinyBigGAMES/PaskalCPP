-------------------------------------------------------------------------------
  type_object_virtual_err_abstract_call.pcpp - break step of type_object_virtual.pcpp:
  parent.M() of an abstract M: it has no body to call (SM0340)

  How to check, from repo\bin:
    pcpp res\tests\type_object_virtual_err_abstract_call.pcpp
    pcpp res\tests\type_object_virtual_err_abstract_call.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_virtual_err_abstract_call;

type
  TA = object
    virtual method M(): int32; abstract;
  end;
  TB = object(TA)
    override method M(): int32;
    begin
      return parent.M(); // ERROR SM0340@14: 'TA.M' is abstract: it has no body to call
    end;
  end;

begin
end.
