-------------------------------------------------------------------------------
  type_object_err_parent_none.pcpp - break step of type_object.pcpp:
  parent in an object that names no parent type (SM0012)

  How to check, from repo\bin:
    pcpp res\tests\type_object_err_parent_none.pcpp
    pcpp res\tests\type_object_err_parent_none.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_err_parent_none;

type
  TA = object
    Z: int32;
    method Show(): int32;
    begin
      return parent.Show(); // ERROR SM0012@14: parent: 'TA' has no parent type
    end;
  end;

begin
end.
