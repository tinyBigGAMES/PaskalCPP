-------------------------------------------------------------------------------
  type_object_cpp_err_override_plain.pcpp - break step of type_object_cpp.pcpp:
  override of a C++ method that is not virtual (SM0333)

  How to check, from repo\bin:
    pcpp res\tests\type_object_cpp_err_override_plain.pcpp
    pcpp res\tests\type_object_cpp_err_override_plain.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_object_cpp_err_override_plain;

struct CGauge {
  virtual ~CGauge() = default;
  virtual int corners() const { return 0; }
  int plain() { return 0; }
};

type
  TDial = object(CGauge)
    N: int32;
    override method plain(): int32; // ERROR SM0333
    begin
      return self.N;
    end;
  end;

var
  LD: TDial;
begin
  println("{}", LD.N);
end.
