-------------------------------------------------------------------------------
  type_choices_err_choices_to_int.pcpp - break step of type_choices.pcpp:
  a value does not convert to a number implicitly: write int32(...) (SM0200)

  How to check, from repo\bin:
    pcpp res\tests\type_choices_err_choices_to_int.pcpp
    pcpp res\tests\type_choices_err_choices_to_int.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_choices_err_choices_to_int;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LI: int32;

begin
  LI := TColor.cBlue; // ERROR SM0200@9: 'TColor' does not convert implicitly to 'int32'
end.
