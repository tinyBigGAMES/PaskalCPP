  decl_var_err_external_local.pcpp - break step of decl_var.pcpp:
  an external variable in a routine's var block

  How to check, from repo\bin:
    pcpp res\tests\decl_var_err_external_local.pcpp
    pcpp res\tests\decl_var_err_external_local.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe decl_var_err_external_local;

routine Use(): int32;
var
  decl_var_counter: int32; external; // ERROR SM0302@3
begin
  return decl_var_counter;
end;

begin
  println("{}", Use());
end.
