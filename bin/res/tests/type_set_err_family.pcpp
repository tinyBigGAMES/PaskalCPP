-------------------------------------------------------------------------------
  type_set_err_family.pcpp - break step of type_set.pcpp:
  both range bounds are of one family: 0 and a char are not (SM0320)

  How to check, from repo\bin:
    pcpp res\tests\type_set_err_family.pcpp
    pcpp res\tests\type_set_err_family.pcpp -t x86_64-linux-gnu
  The marked line reports that code; nothing else is reported.
*******************************************************************************/

module exe type_set_err_family;

type
  TA = set of 0..'z'; // ERROR SM0320@8: set range bounds are of different ordinal families

begin
end.
